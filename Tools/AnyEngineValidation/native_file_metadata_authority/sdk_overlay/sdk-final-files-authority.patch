+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	var delivered atomic.Int32
+	registry := fanout.New[privateFileMetadata]()
+	unsub := registry.Add(func(privateFileMetadata) {
+		if gate.Admit() {
