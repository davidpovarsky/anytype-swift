+package claims
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/stretchr/testify/require"
+)
+
+type operationReadView struct {
+	*objectSnapshotView
+	objects map[string]*anyenc.Value
+	graph   map[string]map[string]*anyenc.Value
+}
+
+func (v *operationReadView) SpaceObjects(filter any, limit int) ([]*anyenc.Value, error) {
+	id := filter.(map[string]any)["id"].(string)
+	if row := v.objects[id]; row != nil {
+		return []*anyenc.Value{row}, nil
+	}
+	return nil, nil
+}
+func (v *operationReadView) Lookup(objectID, dataset, id string) (*anyenc.Value, error) {
+	if v.lookupError != nil {
+		return nil, v.lookupError
+	}
+	if dataset == "editor_blocks" {
+		return v.graph[objectID][id], nil
+	}
+	return v.objectSnapshotView.Lookup(objectID, dataset, id)
+}
+func operationReadFixture(t *testing.T, ops ...Operation) *operationReadView {
+	t.Helper()
+	var history []Claim
+	for _, op := range ops {
+		history = append(history, fixtureClaim(t, op))
+	}
+	v := &operationReadView{objectSnapshotView: newObjectSnapshotView(t, history), objects: map[string]*anyenc.Value{}, graph: map[string]map[string]*anyenc.Value{}}
+	for _, op := range ops {
+		row, err := anyenc.ParseJson(fmt.Sprintf(`{"id":%q,"spaceId":%q,"any":{"type":"page"},"_applySeq":1}`, op.Target.ObjectID, op.SpaceID))
+		require.NoError(t, err)
+		v.objects[op.Target.ObjectID] = row
+		v.graph[op.Target.ObjectID] = map[string]*anyenc.Value{}
+		if op.Target.BlockID != "" {
+			block, err := anyenc.ParseJson(fmt.Sprintf(`{"id":%q,"nav":{"parentId":""}}`, op.Target.BlockID))
+			require.NoError(t, err)
+			v.graph[op.Target.ObjectID][op.Target.BlockID] = block
+		}
+	}
+	return v
+}
+func readOperationFixture(ctx context.Context, v *operationReadView, op Operation) (*AuthorizedOperationRead, error) {
+	return readAuthorizedOperation(ctx, op.SpaceID, "native-carrier", op.OperationID, func(_ []string, read func(handler.NativeReadView) error) error { return read(v) })
+}
+
+func TestAuthorizedOperationReadTwoSnapshotsHoldCompleteCrossTargetClosure(t *testing.T) {
+	a := fixtureOperation(1, "exact original bytes")
+	b := a
+	b.Target = Target{ObjectID: "other-document"}
+	b.Payload = []byte("different canonical variant")
+	v := operationReadFixture(t, b, a)
+	calls := 0
+	result, err := readAuthorizedOperation(context.Background(), a.SpaceID, "native-carrier", a.OperationID, func(ids []string, read func(handler.NativeReadView) error) error {
+		calls++
+		if calls == 1 {
+			require.Equal(t, []string{"native-carrier"}, ids)
+		} else {
+			require.Equal(t, []string{"native-carrier", "disposable-document", "other-document"}, ids)
+		}
+		return read(v)
+	})
+	require.NoError(t, err)
+	require.Equal(t, 2, calls)
+	require.Len(t, result.Variants, 2)
+	byID := map[string]Operation{fixtureClaim(t, a).RecordID(): a, fixtureClaim(t, b).RecordID(): b}
+	last := ""
+	for _, variant := range result.Variants {
+		row, err := anyenc.ParseJson(string(variant.Record))
+		require.NoError(t, err)
+		id := row.GetString("id")
+		require.Greater(t, id, last)
+		last = id
+		original := byID[id]
+		exact, err := original.CanonicalBytes()
+		require.NoError(t, err)
+		require.Equal(t, exact, variant.CanonicalBytes)
+		require.Equal(t, original.AuthorID, row.GetString("creator"))
+		require.NotEmpty(t, row.GetString("nativeChangeId"))
+		require.NotEmpty(t, row.GetString("nativeACLHeadId"))
+	}
+	require.Equal(t, "ready-local-snapshot", result.Readiness.State)
+	require.Len(t, result.Readiness.Generation, 64)
+}
+
+func TestAuthorizedOperationReadNoPartialPayloadAfterTargetLossClosureRaceOrCommitFailure(t *testing.T) {
+	a := fixtureOperation(1, "private first target")
+	b := a
+	b.Target.ObjectID = "other-document"
+	b.Payload = []byte("private conflict")
+	for _, scenario := range []string{"lost-target", "changed-closure", "denied-snapshot", "failed-transaction", "cancelled"} {
+		t.Run(scenario, func(t *testing.T) {
+			v := operationReadFixture(t, a, b)
+			calls := 0
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			failure := errors.New("native authority refused")
+			result, err := readAuthorizedOperation(ctx, a.SpaceID, "native-carrier", a.OperationID, func(_ []string, read func(handler.NativeReadView) error) error {
+				calls++
+				if calls == 2 {
+					switch scenario {
+					case "lost-target":
+						delete(v.objects, b.Target.ObjectID)
+					case "changed-closure":
+						v.rows = v.rows[:1]
+					case "denied-snapshot":
+						return failure
+					case "cancelled":
+						cancel()
+					}
+				}
+				err := read(v)
+				if calls == 2 && scenario == "failed-transaction" {
+					return failure
+				}
+				return err
+			})
+			require.Error(t, err)
+			require.Nil(t, result)
+		})
+	}
+}
+
+func TestAuthorizedOperationReadDistinguishesLocalAbsenceFromUnavailableHistory(t *testing.T) {
+	op := fixtureOperation(1, "payload")
+	v := operationReadFixture(t)
+	result, err := readOperationFixture(context.Background(), v, op)
+	require.NoError(t, err)
+	require.Empty(t, result.Variants)
+	require.Len(t, result.Readiness.Generation, 64)
+	for _, nativeError := range []error{space.ErrObjectNotFound, space.ErrObjectDeleted} {
+		result, err := readAuthorizedOperation(context.Background(), op.SpaceID, "native-carrier", op.OperationID, func(_ []string, _ func(handler.NativeReadView) error) error { return nativeError })
+		require.ErrorIs(t, err, ErrOperationHistoryUnavailable)
+		require.Nil(t, result)
+	}
+	calls := 0
+	result, err = readAuthorizedOperation(context.Background(), op.SpaceID, "native-carrier", op.OperationID, func(_ []string, read func(handler.NativeReadView) error) error {
+		calls++
+		if calls == 2 {
+			return space.ErrObjectNotFound
+		}
+		return read(v)
+	})
+	require.ErrorIs(t, err, ErrOperationTargetStateUnavailable)
+	require.Nil(t, result)
+}
+
+func TestAuthorizedOperationReadUnreachableIsNotDeletionAndMalformedPathFailsClosed(t *testing.T) {
+	op := fixtureOperation(1, "retained history")
+	for _, scenario := range []string{"live", "missing-block", "missing-parent", "tombstone", "cycle", "wrong-id", "invalid-parent", "malformed-deletion", "numeric-deletion", "deleted-object", "wrong-space", "ineligible-object"} {
+		t.Run(scenario, func(t *testing.T) {
+			v := operationReadFixture(t, op)
+			block := v.graph[op.Target.ObjectID][op.Target.BlockID]
+			arena := &anyenc.Arena{}
+			switch scenario {
+			case "missing-block":
+				delete(v.graph[op.Target.ObjectID], op.Target.BlockID)
+			case "missing-parent":
+				block.Get("nav").Set("parentId", arena.NewString("missing-parent"))
+			case "tombstone":
+				block.Set("_deletedAt", arena.NewDateTimeMillis(1000))
+			case "cycle":
+				block.Get("nav").Set("parentId", arena.NewString(op.Target.BlockID))
+			case "wrong-id":
+				block.Set("id", arena.NewString("wrong"))
+			case "invalid-parent":
+				block.Get("nav").Set("parentId", arena.NewNull())
+			case "malformed-deletion":
+				block.Set("_deletedAt", arena.NewString("bad"))
+			case "numeric-deletion":
+				block.Set("_deletedAt", arena.NewNumberInt(1000))
+			case "deleted-object":
+				v.objects[op.Target.ObjectID].Set("_deletedAt", arena.NewNumberInt(1))
+			case "wrong-space":
+				v.objects[op.Target.ObjectID].Set("spaceId", arena.NewString("other-space"))
+			case "ineligible-object":
+				v.objects[op.Target.ObjectID].Get("any").Set("type", arena.NewString("file"))
+			}
+			result, err := readOperationFixture(context.Background(), v, op)
+			switch scenario {
+			case "live":
+				require.NoError(t, err)
+				require.Equal(t, OperationLiveBlock, result.Variants[0].Reachability)
+			case "missing-block", "missing-parent", "tombstone":
+				require.NoError(t, err)
+				require.Equal(t, OperationUnreachableBlock, result.Variants[0].Reachability)
+				canonical, err := op.CanonicalBytes()
+				require.NoError(t, err)
+				require.Equal(t, canonical, result.Variants[0].CanonicalBytes)
+			default:
+				require.ErrorIs(t, err, ErrOperationTargetStateUnavailable)
+				require.Nil(t, result)
+			}
+		})
+	}
+}
+
+func TestAuthorizedOperationReadRejectsOversizedClosureAndForgedProvenance(t *testing.T) {
+	op := fixtureOperation(1, "private")
+	v := operationReadFixture(t, op)
+	v.rows[0].Set("creator", (&anyenc.Arena{}).NewString("forged"))
+	result, err := readOperationFixture(context.Background(), v, op)
+	require.ErrorIs(t, err, ErrOperationHistoryInvalid)
+	require.Nil(t, result)
+	v = operationReadFixture(t)
+	for i := 0; i <= MaxVariants; i++ {
+		next := op
+		next.Payload = []byte(fmt.Sprint(i))
+		v.rows = append(v.rows, storedFixtureClaim(t, fixtureClaim(t, next)))
+	}
+	result, err = readOperationFixture(context.Background(), v, op)
+	require.ErrorIs(t, err, ErrReadLimit)
+	require.Nil(t, result)
+	v = operationReadFixture(t, op)
+	v.rows = nil
+	for i := 0; i < 40; i++ {
+		next := op
+		next.Payload = []byte(fmt.Sprint(i) + strings.Repeat("x", 60000))
+		v.rows = append(v.rows, storedFixtureClaim(t, fixtureClaim(t, next)))
+	}
+	result, err = readOperationFixture(context.Background(), v, op)
+	require.ErrorIs(t, err, ErrReadLimit)
+	require.Nil(t, result)
+}
