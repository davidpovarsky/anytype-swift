+	raw, _ := json.Marshal(api.BlockPatchRequest{IfVersion: before.Version, IfStartedAt: d.startedAt.Format(time.RFC3339Nano)})
+	res := doJSON(t, e, http.MethodPatch, path+"/blocks/"+b.Id, string(raw))
+	if res.Code != http.StatusOK {
+		t.Fatalf("noop: %d %s", res.Code, res.Body.String())
+	}
+	var receipt api.BlockConditionalPatchResponse
+	if err := json.Unmarshal(res.Body.Bytes(), &receipt); err != nil {
+		t.Fatal(err)
