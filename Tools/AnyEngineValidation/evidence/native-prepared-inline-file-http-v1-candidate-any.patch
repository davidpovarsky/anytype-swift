new file mode 100644
index 0000000000000000000000000000000000000000..11460ea47c9089ee590eefcb03e0dda5d0e02781
--- /dev/null
+++ b/internal/server/handlers_pinkha_operation_read.go
@@ -0,0 +1,100 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/labstack/echo/v4"
+
+	"github.com/anyproto/any/internal/api"
+	"github.com/anyproto/any/internal/bundles"
+	"github.com/anyproto/any/internal/pinkha/claims"
+)
+
+func (d *deps) pinkhaAuthorizedOperation(c echo.Context) error {
+	operationID := c.Param("operationId")
+	if claims.ValidateAuthorizedOperationID(operationID) != nil || hasBody(c.Request()) || len(c.QueryParams()) != 0 {
+		return writeError(c, http.StatusBadRequest, "pinkha.invalid_request", "read requires one canonical operation ID and no caller authority", nil)
+	}
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	root, err := pinkhaRoot(c, sp)
+	if err != nil {
+		return pinkhaOperationReadError(c, err, sp.Id())
+	}
+	result, err := claims.ReadAuthorizedOperation(c.Request().Context(), sp, root, operationID)
+	if err != nil {
+		return pinkhaOperationReadError(c, err, sp.Id())
+	}
+	body, err := encodePinkhaOperationRead(result)
+	if err != nil {
+		return pinkhaOperationReadError(c, err, sp.Id())
+	}
+	if err := c.Request().Context().Err(); err != nil {
+		return pinkhaOperationReadError(c, err, sp.Id())
+	}
+	return c.Blob(http.StatusOK, echo.MIMEApplicationJSONCharsetUTF8, body)
+}
+
+func encodePinkhaOperationRead(result *claims.AuthorizedOperationRead) ([]byte, error) {
+	if result == nil {
+		return nil, claims.ErrOperationHistoryInvalid
+	}
+	response := api.PinkhaOperationRead{
+		Contract: claims.ContractID, ReadContract: claims.AuthorizedOperationReadContract,
+		Version: 1, Scope: claims.AuthorizedOperationReadScope, SpaceID: result.SpaceID,
+		RootObjectID: result.RootID, Dataset: claims.Dataset, OperationID: result.OperationID,
+		Complete: true, Outcome: "found", Variants: []api.PinkhaOperationReadVariant{},
+		Readiness: api.PinkhaOperationReadReadiness{Version: result.Readiness.Version,
+			State: result.Readiness.State, Generation: result.Readiness.Generation},
+	}
+	if len(result.Variants) == 0 {
+		response.Outcome = "absentInVerifiedLocalSnapshot"
+	}
+	if len(result.Variants) > claims.MaxVariants {
+		return nil, claims.ErrReadLimit
+	}
+	for _, variant := range result.Variants {
+		response.Variants = append(response.Variants, api.PinkhaOperationReadVariant{
+			Record: variant.Record, CanonicalBytes: variant.CanonicalBytes,
+			Reachability: string(variant.Reachability),
+		})
+	}
+	// Bound the actual full encoded response, including duplicated metadata,
+	// Base64 expansion and formatting. No bytes are written before this check.
+	body, err := json.MarshalIndent(response, "", "  ")
+	if err != nil {
+		return nil, err
+	}
+	body = append(body, '\n')
+	if len(body) > claims.MaxAuthorizedOperationReadBytes {
+		return nil, claims.ErrReadLimit
+	}
+	return body, nil
+}
+
+func pinkhaOperationReadError(c echo.Context, err error, spaceID string) error {
+	switch {
+	case errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		return sdkOpError(c, err, nil)
+	case errors.Is(err, list.ErrInsufficientPermissions), errors.Is(err, space.ErrReadOnlySpace):
+		return writeError(c, http.StatusForbidden, "pinkha.permission_denied", "current native authority does not permit this read", nil)
+	case errors.Is(err, claims.ErrOperationTargetStateUnavailable):
+		return writeError(c, http.StatusConflict, "pinkha.target_state_unavailable", "complete target authority is unavailable; no operation payload was released", nil)
+	case errors.Is(err, claims.ErrOperationHistoryUnavailable), errors.Is(err, bundles.ErrNotInstalled),
+		errors.Is(err, bundles.ErrRootNotLocal), errors.Is(err, bundles.ErrRegistryNotSynced),
+		errors.Is(err, space.ErrBundleUnknown), errors.Is(err, space.ErrBundleRootNotSynced),
+		errors.Is(err, space.ErrObjectNotFound), errors.Is(err, space.ErrObjectDeleted):
+		return writeError(c, http.StatusConflict, "pinkha.history_unavailable", "verified native history is unavailable; no global absence was established", nil)
+	case errors.Is(err, claims.ErrOperationHistoryInvalid):
+		return writeError(c, http.StatusInternalServerError, "pinkha.history_invalid", "native operation history failed verification", nil)
+	default:
+		return pinkhaReadError(c, err, spaceID)
+	}
+}
