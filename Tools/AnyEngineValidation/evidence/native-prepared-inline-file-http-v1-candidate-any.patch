+)
+
+func inlineHTTPHash(data []byte) string {
+	value := sha256.Sum256(data)
+	return hex.EncodeToString(value[:])
+}
+
+func inlineHTTPBytes(size int) []byte {
+	value := make([]byte, size)
+	for index := range value {
+		value[index] = byte(index % 256)
+	}
+	return value
+}
+
+func inlineHTTPFixture(t *testing.T) (*deps, *echo.Echo, space.Space, string, api.MigrationInlineFileCapabilities) {
+	t.Helper()
+	configured, err := os.ReadFile(stagingPath)
+	require.NoError(t, err, "the explicit isolated local nodeconf is required; a skipped native fixture is not evidence")
+	local, err := os.ReadFile("../pinkha/migrationnative/testdata/local.yml")
+	require.NoError(t, err)
+	require.Equal(t, local, configured, "the fixture must not join a different network")
+	d, teardown := newTestDeps(t)
+	t.Cleanup(teardown)
+	router := buildEcho(d)
+	spaceID, owner := setupBlocksFixture(t, router)
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	sp, err := d.sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	response := doJSON(t, router, http.MethodGet, "/v1/spaces/"+spaceID+"/pinkha/migration/inline-file/capabilities", "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var capability api.MigrationInlineFileCapabilities
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &capability))
+	require.Equal(t, space.PreparedMigrationContract, capability.Contract)
+	require.Equal(t, spaceID, capability.SpaceID)
+	require.NotEmpty(t, capability.AccountID)
+	require.NotEmpty(t, capability.StoreID)
+	require.Equal(t, 1, capability.InlineFile)
+	require.Equal(t, 4095, capability.MaximumInlineBytes)
+	require.Zero(t, capability.File)
+	require.False(t, capability.NetworkVerified)
+	return d, router, sp, owner, capability
+}
+
+func inlineHTTPRequest(t *testing.T, capability api.MigrationInlineFileCapabilities, source string, raw []byte) (string, string) {
+	t.Helper()
+	id := inlineHTTPHash([]byte(source))
+	request := api.MigrationPrepareRequest{
+		Contract: capability.Contract, StoreID: capability.StoreID,
+		PlanID: strings.Repeat("a", 64), PlanSHA256: strings.Repeat("b", 64), SourceKey: source,
+		SpecBase64: base64.StdEncoding.EncodeToString(raw), SpecSHA256: inlineHTTPHash(raw),
+	}
+	body, err := json.Marshal(request)
+	require.NoError(t, err)
+	return id, string(body)
+}
+
+func inlineHTTPCommit(t *testing.T, router http.Handler, base string, original space.MigrationInlineFileReceipt) space.MigrationInlineFileReceipt {
+	t.Helper()
+	body, err := json.Marshal(space.MigrationCommit{Contract: original.Contract, StoreID: original.StoreID,
+		PlanID: original.PlanID, PlanSHA256: original.PlanSHA256, Fingerprint: original.Fingerprint})
+	require.NoError(t, err)
+	response := doJSON(t, router, http.MethodPost, base+"/intents/"+original.IntentID+"/inline-file/commit", string(body))
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var result space.MigrationInlineFileReceipt
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &result))
+	require.Equal(t, original.Fingerprint, result.Fingerprint)
+	require.Equal(t, original.ObjectID, result.ObjectID)
+	require.Equal(t, original.ChangeID, result.ChangeID)
+	require.Equal(t, original.FileID, result.FileID)
+	require.Equal(t, original.RecordIDs, result.RecordIDs)
+	require.Equal(t, original.SpecSHA256, result.SpecSHA256)
+	return result
+}
+
+type inlineHTTPEvent struct {
+	status  space.FileStatus
+	receipt space.MigrationInlineFileReceipt
+	info    space.FileInfo
+	content []byte
+	err     error
+}
+
+func inlineHTTPSubscribe(sp space.Space, intents *sync.Map) (<-chan inlineHTTPEvent, func()) {
+	events := make(chan inlineHTTPEvent, 32)
+	native := sp.Files().(space.PreparedInlineFileService)
+	stop := sp.Files().SubscribeStatus(func(status space.FileStatus) {
+		event := inlineHTTPEvent{status: status}
+		ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+		defer cancel()
+		if intents != nil {
+			intent, present := intents.Load(status.FileId)
+			if !present {
+				event.err = fmt.Errorf("published unregistered file")
+			} else {
+				event.receipt, event.err = native.MigrationInlineFileStatus(ctx, intent.(string))
+			}
+		}
+		if event.err == nil {
+			event.info, event.err = sp.Files().Get(ctx, status.FileId)
+		}
+		if event.err == nil {
+			var reader space.FileReader
+			reader, event.err = sp.Files().Open(ctx, status.FileId, "")
+			if event.err == nil {
+				event.content, event.err = io.ReadAll(reader)
+				closeErr := reader.Close()
+				if event.err == nil {
+					event.err = closeErr
+				}
+			}
+		}
+		events <- event
+	})
+	return events, stop
+}
+
+func inlineHTTPNoEvent(t *testing.T, events <-chan inlineHTTPEvent) {
+	t.Helper()
+	select {
+	case event := <-events:
+		t.Fatalf("unexpected file status event: %+v", event)
+	case <-time.After(100 * time.Millisecond):
+	}
+}
+
+func TestPreparedInlineFileHTTPStrictInput(t *testing.T) {
+	base := map[string]any{"ownerObjectId": "ordinary-owner", "name": "", "mime": "",
+		"content": "", "contentSHA256": inlineHTTPHash(nil)}
+	for _, size := range []int{0, 4095} {
+		body := inlineHTTPBytes(size)
+		value := map[string]any{"ownerObjectId": "ordinary-owner", "name": "", "mime": "",
+			"content": base64.StdEncoding.EncodeToString(body), "contentSHA256": inlineHTTPHash(body)}
+		raw, err := json.Marshal(value)
+		require.NoError(t, err)
+		spec, err := migrationInlineFileSpec(raw)
+		require.NoError(t, err)
+		require.Equal(t, body, spec.Content)
+	}
+	cases := []struct {
+		name, field string
+		value       any
+	}{
+		{"missing-content", "content", nil},
+		{"null-content", "content", json.RawMessage("null")},
+		{"wrong-content-type", "content", 123},
+		{"noncanonical-content", "content", "AB=="},
+		{"content-whitespace", "content", "\n"},
+		{"oversize4096", "content", base64.StdEncoding.EncodeToString(inlineHTTPBytes(4096))},
+		{"oversize4097", "content", base64.StdEncoding.EncodeToString(inlineHTTPBytes(4097))},
+		{"changed-content-hash", "contentSHA256", strings.Repeat("0", 64)},
+		{"uppercase-content-hash", "contentSHA256", strings.ToUpper(inlineHTTPHash(nil))},
+		{"long-owner", "ownerObjectId", strings.Repeat("x", 257)},
+		{"empty-owner", "ownerObjectId", ""},
+		{"long-utf8-name", "name", strings.Repeat("א", 513)},
+		{"nul-name", "name", "a\x00b"},
+		{"long-mime", "mime", strings.Repeat("x", 256)},
+		{"nul-mime", "mime", "a\x00b"},
+		{"unknown-envelope", "rawChange", "not caller-signed bytes"},
+		{"full-tier-root", "rootCid", "not an inline file"},
+		{"variant", "variant", "thumb"},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			value := make(map[string]any)
+			for k, v := range base {
+				value[k] = v
+			}
+			if test.value == nil {
+				delete(value, test.field)
+			} else {
+				value[test.field] = test.value
+			}
+			raw, err := json.Marshal(value)
+			require.NoError(t, err)
+			_, err = migrationInlineFileSpec(raw)
+			require.Error(t, err)
+		})
+	}
+	raw, err := json.Marshal(base)
+	require.NoError(t, err)
+	for _, malformed := range []string{
+		strings.Replace(string(raw), `"name":""`, `"name":"","name":"duplicate"`, 1),
+		strings.Replace(string(raw), `"name":""`, `"Name":""`, 1),
+		string(raw) + " {}",
+	} {
+		_, err := migrationInlineFileSpec([]byte(malformed))
+		require.Error(t, err)
+	}
+}
+
+func TestPreparedInlineFileHTTPNativeLifecycleAndPublication(t *testing.T) {
+	_, router, sp, owner, capability := inlineHTTPFixture(t)
+	base := "/v1/spaces/" + capability.SpaceID + "/pinkha/migration"
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+	var intents sync.Map
+	events, unsubscribe := inlineHTTPSubscribe(sp, &intents)
+	defer unsubscribe()
+
+	for index, size := range []int{4095, 0} {
+		body := inlineHTTPBytes(size)
+		name, mime := "קובץ 🧪.bin", "application/octet-stream"
+		if size == 0 {
+			name, mime = "", ""
+		}
+		spec := space.MigrationInlineFileSpec{OwnerObjectID: owner, Name: name, Mime: mime,
+			Content: body, ContentSHA256: inlineHTTPHash(body)}
+		raw, err := json.Marshal(spec)
+		require.NoError(t, err)
+		intentID, request := inlineHTTPRequest(t, capability, fmt.Sprintf("http/inline/lifecycle/%d", size), raw)
+		response := doJSON(t, router, http.MethodPut, base+"/intents/"+intentID+"/inline-file/prepare", request)
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		var prepared space.MigrationInlineFileReceipt
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &prepared))
+		require.Equal(t, intentID, prepared.IntentID)
+		require.Equal(t, "inlineFile", prepared.Kind)
+		require.Equal(t, owner, prepared.OwnerObjectID)
+		require.Equal(t, capability.SpaceID, prepared.SpaceID)
+		require.Equal(t, capability.StoreID, prepared.StoreID)
+		require.Equal(t, capability.AccountID, prepared.AccountID)
+		require.Equal(t, inlineHTTPHash(raw), prepared.SpecSHA256)
+		require.Equal(t, []string{prepared.FileID}, prepared.RecordIDs)
+		require.NotEmpty(t, prepared.ObjectID)
+		require.NotEqual(t, owner, prepared.ObjectID)
+		require.NotEmpty(t, prepared.ChangeID)
+		require.Len(t, prepared.Fingerprint, 64)
+		require.Equal(t, "prepared", prepared.Outcome)
+		intents.Store(prepared.FileID, intentID)
+		inlineHTTPNoEvent(t, events)
+		_, err = sp.Files().Get(ctx, prepared.FileID)
+		require.Error(t, err, "preparation must not expose a file row")
+
+		if index == 0 {
+			require.Equal(t, "file-prepared", prepared.Stage)
+			wrong := space.MigrationCommit{Contract: prepared.Contract, StoreID: prepared.StoreID,
+				PlanID: prepared.PlanID, PlanSHA256: prepared.PlanSHA256, Fingerprint: strings.Repeat("0", 64)}
+			wrongBody, err := json.Marshal(wrong)
+			require.NoError(t, err)
+			refused := doJSON(t, router, http.MethodPost, base+"/intents/"+intentID+"/inline-file/commit", string(wrongBody))
+			require.Equal(t, http.StatusConflict, refused.Code, refused.Body.String())
+			require.Contains(t, refused.Body.String(), "pinkha.migration_collision")
+			inlineHTTPNoEvent(t, events)
+			root := inlineHTTPCommit(t, router, base, prepared)
+			require.Equal(t, "file-root-committed", root.Stage)
+			require.Equal(t, "prepared", root.Outcome)
+			inlineHTTPNoEvent(t, events)
+			_, err = sp.Files().Get(ctx, prepared.FileID)
+			require.Error(t, err, "root commit must not expose a file row")
+		} else {
+			require.Equal(t, "file-root-committed", prepared.Stage)
+		}
+		completed := inlineHTTPCommit(t, router, base, prepared)
+		require.Equal(t, "complete", completed.Stage)
+		require.Equal(t, "committed", completed.Outcome)
+		select {
+		case event := <-events:
+			require.NoError(t, event.err, "subscription must reenter status/Get/Open after durable commit")
+			require.Equal(t, prepared.FileID, event.status.FileId)
+			require.Equal(t, owner, event.status.ObjectId)
+			require.Equal(t, space.FileStateDurable, event.status.State)
+			require.True(t, event.status.Cached)
+			require.Equal(t, completed, event.receipt)
+			require.Equal(t, name, event.info.Name)
+			require.Equal(t, mime, event.info.Mime)
+			require.Equal(t, int64(size), event.info.Size)
+			require.Equal(t, body, event.content)
+			require.Equal(t, completed.ContentSHA256, inlineHTTPHash(event.content))
+		case <-time.After(5 * time.Second):
+			t.Fatal("durable row commit did not produce a reentrant local file status event")
+		}
+		content := doJSON(t, router, http.MethodGet, "/v1/spaces/"+capability.SpaceID+"/files/"+prepared.FileID+"/content", "")
+		require.Equal(t, http.StatusOK, content.Code, content.Body.String())
+		require.True(t, bytes.Equal(body, content.Body.Bytes()), "ordinary HTTP content must equal the exact plaintext bytes")
+		require.Equal(t, completed, inlineHTTPCommit(t, router, base, prepared), "retry reconciles the existing row")
+		response = doJSON(t, router, http.MethodGet, base+"/intents/"+intentID+"/inline-file", "")
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		var current space.MigrationInlineFileReceipt
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &current))
+		require.Equal(t, completed, current)
+		inlineHTTPNoEvent(t, events)
+	}
+}
+
+func TestPreparedInlineFileHTTPRefusesBeforeNativeReservation(t *testing.T) {
+	_, router, sp, owner, capability := inlineHTTPFixture(t)
+	base := "/v1/spaces/" + capability.SpaceID + "/pinkha/migration"
+	var intents sync.Map
+	events, unsubscribe := inlineHTTPSubscribe(sp, &intents)
+	defer unsubscribe()
+	for _, size := range []int{4096, 4097} {
+		body := inlineHTTPBytes(size)
+		raw, err := json.Marshal(space.MigrationInlineFileSpec{OwnerObjectID: owner, Name: "oversize",
+			Mime: "", Content: body, ContentSHA256: inlineHTTPHash(body)})
+		require.NoError(t, err)
+		id, request := inlineHTTPRequest(t, capability, fmt.Sprintf("http/inline/refused/%d", size), raw)
+		response := doJSON(t, router, http.MethodPut, base+"/intents/"+id+"/inline-file/prepare", request)
+		require.Equal(t, http.StatusBadRequest, response.Code, response.Body.String())
+		require.Contains(t, response.Body.String(), "request.invalid_field")
+		status := doJSON(t, router, http.MethodGet, base+"/intents/"+id+"/inline-file", "")
+		require.Equal(t, http.StatusNotFound, status.Code, status.Body.String())
+		require.Contains(t, status.Body.String(), "pinkha.migration_not_found")
+	}
+	inlineHTTPNoEvent(t, events)
+	response := doJSON(t, router, http.MethodGet, base+"/capabilities", "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var general space.MigrationCapabilities
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &general))
+	require.Zero(t, general.File)
