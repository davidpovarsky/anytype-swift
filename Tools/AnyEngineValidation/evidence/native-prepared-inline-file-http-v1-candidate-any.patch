+package server
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any/internal/api"
+	"github.com/labstack/echo/v4"
+)
+
+func registerPinkhaMigrationInlineFileRoutes(v1 *echo.Group, d *deps) {
+	v1.GET("/spaces/:spaceId/pinkha/migration/inline-file/capabilities", d.pinkhaMigrationInlineFileCapabilities)
+	v1.PUT("/spaces/:spaceId/pinkha/migration/intents/:intentId/inline-file/prepare", d.pinkhaMigrationInlineFilePrepare)
+	v1.GET("/spaces/:spaceId/pinkha/migration/intents/:intentId/inline-file", d.pinkhaMigrationInlineFileStatus)
+	v1.POST("/spaces/:spaceId/pinkha/migration/intents/:intentId/inline-file/commit", d.pinkhaMigrationInlineFileCommit)
+}
+
+func migrationInlineFileService(sp space.Space) (space.PreparedInlineFileService, error) {
+	native, ok := sp.Files().(space.PreparedInlineFileService)
+	if !ok {
+		return nil, space.ErrCurrentWriterUnavailable
+	}
+	return native, nil
+}
+
+func (d *deps) pinkhaMigrationInlineFileCapabilities(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	if _, err := migrationInlineFileService(sp); err != nil {
+		return migrationError(c, err)
+	}
+	native, err := migrationService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	base, err := native.MigrationCapabilities(c.Request().Context())
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, api.MigrationInlineFileCapabilities{
+		Contract: base.Contract, StoreID: base.StoreID, AccountID: base.AccountID, SpaceID: base.SpaceID,
+		InlineFile: 1, MaximumInlineBytes: api.MigrationInlineFileMaximumBytes, File: 0, NetworkVerified: false,
+	})
+}
+
+func migrationInlineFileSpec(raw []byte) (space.MigrationInlineFileSpec, error) {
+	var wire api.MigrationInlineFileSpec
+	if err := strictMigrationJSON(raw, &wire); err != nil {
+		return space.MigrationInlineFileSpec{}, err
+	}
+	if wire.OwnerObjectID == nil || wire.Name == nil || wire.Mime == nil || wire.Content == nil || wire.ContentSHA256 == nil {
+		return space.MigrationInlineFileSpec{}, fmt.Errorf("inline file requires every explicit typed field")
+	}
+	if *wire.OwnerObjectID == "" || len(*wire.OwnerObjectID) > 256 ||
+		!utf8.ValidString(*wire.Name) || !utf8.ValidString(*wire.Mime) ||
+		len(*wire.Name) > 1024 || len(*wire.Mime) > 255 ||
+		strings.ContainsRune(*wire.Name, 0) || strings.ContainsRune(*wire.Mime, 0) ||
+		len(*wire.Content) > base64.StdEncoding.EncodedLen(api.MigrationInlineFileMaximumBytes) {
+		return space.MigrationInlineFileSpec{}, fmt.Errorf("inline file identity, metadata or size is outside the supported bounds")
+	}
+	content, err := base64.StdEncoding.Strict().DecodeString(*wire.Content)
+	if err != nil || len(content) > api.MigrationInlineFileMaximumBytes ||
+		base64.StdEncoding.EncodeToString(content) != *wire.Content {
+		return space.MigrationInlineFileSpec{}, fmt.Errorf("inline file content encoding differs")
+	}
+	hash := sha256.Sum256(content)
+	if hex.EncodeToString(hash[:]) != *wire.ContentSHA256 {
+		return space.MigrationInlineFileSpec{}, fmt.Errorf("inline file content digest differs")
+	}
+	return space.MigrationInlineFileSpec{OwnerObjectID: *wire.OwnerObjectID, Name: *wire.Name,
+		Mime: *wire.Mime, Content: content, ContentSHA256: *wire.ContentSHA256}, nil
+}
+
+func (d *deps) pinkhaMigrationInlineFilePrepare(c echo.Context) error {
+	input, raw, err := migrationInput(c)
+	if err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	spec, err := migrationInlineFileSpec(raw)
+	if err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationInlineFileService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.PrepareMigrationInlineFile(c.Request().Context(), input, spec)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationInlineFileStatus(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationInlineFileService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.MigrationInlineFileStatus(c.Request().Context(), c.Param("intentId"))
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationInlineFileCommit(c echo.Context) error {
+	var request space.MigrationCommit
+	if err := readMigrationJSON(c, &request); err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	request.IntentID = c.Param("intentId")
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationInlineFileService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.CommitMigrationInlineFile(c.Request().Context(), request)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
diff --git a/internal/server/handlers_pinkha_migration_inline_file_bridge_test.go b/internal/server/handlers_pinkha_migration_inline_file_bridge_test.go
