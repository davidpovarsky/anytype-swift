+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativeExactSequence")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page"}`)
+	version, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	run := d.startedAt.Format(time.RFC3339Nano)
+	path := "/v1/spaces/" + sp.Id + "/pinkha/properties/" + oid + "/set/any"
+	for _, raw := range []string{`null`, `"1"`, `0`, `-1`, `1.0`, `1e0`, `18446744073709551616`, `true`, `[]`} {
