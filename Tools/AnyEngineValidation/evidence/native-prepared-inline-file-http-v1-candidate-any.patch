+type seedProvider struct{ account, device []byte }
+
+func (p *seedProvider) AccountKey(context.Context) ([]byte, error) { return p.account, nil }
+func (p *seedProvider) DeviceKey(context.Context) ([]byte, error)  { return p.device, nil }
+func newSeeds(t *testing.T) *seedProvider {
+	t.Helper()
+	_, account, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	_, device, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	return &seedProvider{account: account, device: device}
+}
+
+// Same pinned SDK e2e/local.yml and dead-loopback rewrite as the upstream P2P
+// fixture. No staging service, Docker daemon, or user's account is contacted.
+func localNetwork(t *testing.T) []byte {
+	t.Helper()
+	yaml, err := os.ReadFile("testdata/local.yml")
+	require.NoError(t, err)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	port := listener.Addr().(*net.TCPAddr).Port
+	require.NoError(t, listener.Close())
+	return regexp.MustCompile(`127\.0\.0\.1:\d+`).ReplaceAll(yaml, []byte("127.0.0.1:"+strconv.Itoa(port)))
+}
+
+func nativeConfig(directory string, network []byte) config.Config {
+	disabled := false
+	return config.Config{Storage: config.Storage{DataDir: directory, Topology: config.StorageShared}, Network: config.Network{NodeConfYAML: network}, P2P: config.P2P{Enabled: &disabled},
+		Types:       []handler.Type{dataview.NewType(), page.NewType()},
+		Collections: []handler.Collection{miniapp.NewCollection(), bin.NewCollection()},
+		Modules:     []handler.Module{editor.NewModule(), chat.NewModule(), claims.NewModule()}}
+}
+
+func nativeInput(t *testing.T, capabilities space.MigrationCapabilities, source string, spec any) space.MigrationInput {
+	t.Helper()
+	raw, err := json.Marshal(spec)
+	require.NoError(t, err)
+	digest := sha256.Sum256(raw)
+	intent := sha256.Sum256([]byte(source))
+	return space.MigrationInput{Contract: space.PreparedMigrationContract, StoreID: capabilities.StoreID, PlanID: strings.Repeat("a", 64), PlanSHA256: strings.Repeat("b", 64), IntentID: hex.EncodeToString(intent[:]), SourceKey: source, SpecSHA256: hex.EncodeToString(digest[:]), SourceSpec: raw}
+}
+
+func commitOf(input space.MigrationInput, prepared space.MigrationReceipt) space.MigrationCommit {
+	return space.MigrationCommit{Contract: input.Contract, StoreID: input.StoreID, PlanID: input.PlanID, PlanSHA256: input.PlanSHA256, IntentID: input.IntentID, Fingerprint: prepared.Fingerprint}
+}
+
+func advanceObject(t *testing.T, ctx context.Context, native space.PreparedMigrationService, input space.MigrationInput, original space.MigrationReceipt, stage string) space.MigrationReceipt {
+	t.Helper()
+	result, err := native.CommitMigration(ctx, commitOf(input, original))
+	require.NoError(t, err)
+	require.Equal(t, stage, result.Stage)
+	require.Equal(t, original.Fingerprint, result.Fingerprint, "object stages must retain the native operation fingerprint")
+	require.Equal(t, original.SpecSHA256, result.SpecSHA256)
+	require.Equal(t, original.ObjectID, result.ObjectID)
+	return result
+}
+
+func TestPreparedMigrationProductionSDKRestartAndReadback(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Minute)
+	defer cancel()
+	cfg, provider := nativeConfig(t.TempDir(), localNetwork(t)), newSeeds(t)
+	var sdk *anysyncsdk.SDK
+	open := func() {
+		var err error
+		sdk, err = anysyncsdk.Open(ctx, cfg, provider)
+		require.NoError(t, err)
+	}
+	closeSDK := func() { require.NoError(t, sdk.Close()); sdk = nil }
+	t.Cleanup(func() {
+		if sdk != nil {
+			_ = sdk.Close()
+		}
+	})
+	open()
+	sp, err := sdk.Spaces().Create(ctx, space.CreateRequest{Name: "disposable prepared migration"})
+	require.NoError(t, err)
+	spaceID := sp.Id()
+	native, ok := sp.Objects().(space.PreparedMigrationService)
+	require.True(t, ok)
+	capabilities, err := native.MigrationCapabilities(ctx)
+	require.NoError(t, err)
+	require.Equal(t, 0, capabilities.File)
+	require.False(t, capabilities.NetworkVerified)
+	opts := space.CreateObjectOpts{Type: "page", InitialProperties: map[string]map[string]any{"any": {"name": "migrated source page"}}}
+	objectInput := nativeInput(t, capabilities, "source/object/one", map[string]any{"type": "page", "initialProperties": opts.InitialProperties})
+	root, err := native.PrepareMigrationObject(ctx, objectInput, opts)
+	require.NoError(t, err)
+	require.Equal(t, "root-prepared", root.Stage)
+	require.Equal(t, "prepared", root.Outcome)
+	_, err = sp.Objects().Get(ctx, root.ObjectID)
+	require.Error(t, err, "prepare must not create the root")
+	closeSDK()
+
+	// Real SDK/native and projection databases are closed and reopened under
+	// the same native account/device. The first preparation reply is discarded.
+	open()
+	sp, err = sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	native = sp.Objects().(space.PreparedMigrationService)
+	capabilitiesAgain, err := native.MigrationCapabilities(ctx)
+	require.NoError(t, err)
+	require.Equal(t, capabilities, capabilitiesAgain)
+	recoveredRoot, err := native.PrepareMigrationObject(ctx, objectInput, opts)
+	require.NoError(t, err)
+	require.Equal(t, root.ObjectID, recoveredRoot.ObjectID)
+	require.Equal(t, root.Fingerprint, recoveredRoot.Fingerprint)
+	rootCommitted := advanceObject(t, ctx, native, objectInput, recoveredRoot, "root-committed")
+	require.Equal(t, "prepared", rootCommitted.Outcome)
+	require.Equal(t, root.ChangeID, rootCommitted.ChangeID)
+	closeSDK()
+	open()
+	sp, err = sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	native = sp.Objects().(space.PreparedMigrationService)
+	rootStatus, err := native.MigrationStatus(ctx, objectInput.IntentID)
+	require.NoError(t, err)
+	require.Equal(t, rootCommitted, rootStatus, "root-only reply loss must recover its same durable native stage")
+	bootstrap := advanceObject(t, ctx, native, objectInput, root, "bootstrap-prepared")
+	require.Equal(t, "prepared", bootstrap.Outcome)
+	require.NotEqual(t, root.ChangeID, bootstrap.ChangeID)
+	// Bootstrap signed bytes are now durable, but its record is not applied.
+	rootOnly, err := sp.Objects().Get(ctx, root.ObjectID)
+	require.NoError(t, err)
+	require.Empty(t, rootOnly.GetString("any", "name"))
+	closeSDK()
+	open()
+	sp, err = sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	native = sp.Objects().(space.PreparedMigrationService)
+	bootstrapStatus, err := native.MigrationStatus(ctx, objectInput.IntentID)
+	require.NoError(t, err)
+	require.Equal(t, bootstrap, bootstrapStatus, "bootstrap reservation must survive actual SDK/store restart")
+	objectDone := advanceObject(t, ctx, native, objectInput, root, "complete")
+	require.Equal(t, "complete", objectDone.Stage)
+	require.Equal(t, "committed", objectDone.Outcome)
+	require.Equal(t, bootstrap.ChangeID, objectDone.ChangeID)
+	require.Equal(t, root.ObjectID, objectDone.ObjectID)
+	require.Equal(t, []string{root.ObjectID}, objectDone.RecordIDs)
+	closeSDK()
+	open()
+	sp, err = sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	native = sp.Objects().(space.PreparedMigrationService)
+	objectRecovered, err := native.CommitMigration(ctx, commitOf(objectInput, root))
+	require.NoError(t, err)
+	require.Equal(t, objectDone, objectRecovered, "complete bootstrap lost-ACK recovery must append no replacement")
+	properties, err := sp.Properties().Get(ctx, root.ObjectID)
+	require.NoError(t, err)
+	require.Equal(t, "page", properties.GetString("any", "type"))
+	require.Equal(t, "migrated source page", properties.GetString("any", "name"))
+
+	blockSpec := map[string]any{"objectId": root.ObjectID, "dataset": "editor_blocks", "type": "paragraph", "text": "native migration פנחא", "nav": map[string]any{"parentId": "", "pos": "m"}}
+	blockInput := nativeInput(t, capabilities, "source/block/one", blockSpec)
+	block, err := editor.PrepareMigration(ctx, sp, blockInput, root.ObjectID, "editor_blocks", editor.CreateInput{Type: "paragraph", Text: "native migration פנחא", Pos: "m"})
+	require.NoError(t, err)
+	require.Equal(t, "block-prepared", block.Stage)
+	require.Len(t, block.RecordIDs, 1)
+	before, err := editor.List(ctx, sp, root.ObjectID, "editor_blocks")
+	require.NoError(t, err)
+	require.Empty(t, before)
+	closeSDK()
+	open()
+	sp, err = sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	native = sp.Objects().(space.PreparedMigrationService)
+	blockRecovered, err := native.MigrationStatus(ctx, blockInput.IntentID)
+	require.NoError(t, err)
+	require.Equal(t, block.ChangeID, blockRecovered.ChangeID)
+	require.Equal(t, block.RecordIDs, blockRecovered.RecordIDs)
+	blockDone, err := native.CommitMigration(ctx, commitOf(blockInput, blockRecovered))
+	require.NoError(t, err)
+	require.Equal(t, "committed", blockDone.Outcome)
+	closeSDK()
+	open()
+	sp, err = sdk.Spaces().Get(ctx, spaceID)
+	require.NoError(t, err)
+	native = sp.Objects().(space.PreparedMigrationService)
+	blockRetry, err := native.CommitMigration(ctx, commitOf(blockInput, blockRecovered))
+	require.NoError(t, err)
+	require.Equal(t, blockDone, blockRetry, "committed-before-ACK restart must preserve exact native IDs")
+	blocks, err := editor.List(ctx, sp, root.ObjectID, "editor_blocks")
+	require.NoError(t, err)
+	require.Len(t, blocks, 1)
+	require.Equal(t, block.RecordIDs[0], blocks[0].Id)
+	require.Equal(t, "native migration פנחא", blocks[0].Text)
+	// The object's own bootstrap intent remains intact after its body is filled.
+	objectRetry, err := native.CommitMigration(ctx, commitOf(objectInput, root))
+	require.NoError(t, err)
+	require.Equal(t, "committed", objectRetry.Outcome)
+	require.Equal(t, objectDone.ChangeID, objectRetry.ChangeID)
+	// A later block delete is an explicit terminal outcome, never a new create.
+	_, err = editor.Delete(ctx, sp, root.ObjectID, "editor_blocks", block.RecordIDs[0])
+	require.NoError(t, err)
+	deleted, err := native.CommitMigration(ctx, commitOf(blockInput, block))
+	require.NoError(t, err)
+	require.Equal(t, "committed_deleted", deleted.Outcome)
+	blocks, err = editor.List(ctx, sp, root.ObjectID, "editor_blocks")
+	require.NoError(t, err)
+	require.Empty(t, blocks)
+	closeSDK()
+}
diff --git a/internal/pinkha/migrationnative/peer_test.go b/internal/pinkha/migrationnative/peer_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..91eb432a26572378ad69c46e51754635e36d4600
--- /dev/null
+++ b/internal/pinkha/migrationnative/peer_test.go
@@ -0,0 +1,199 @@
+package migrationnative
+
+import (
+	"context"
+	"crypto/ed25519"
+	"crypto/rand"
+	"net"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	anysyncsdk "github.com/anyproto/any-sync-sdk"
+	"github.com/anyproto/any-sync-sdk/config"
+	sdkp2p "github.com/anyproto/any-sync-sdk/p2p"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any/internal/editor"
+	"github.com/stretchr/testify/require"
+)
+
+// Discovery-only adaptation of SDK854df54 e2e/p2p_test.go (Git blob
+// 547af9a811aaf3f96aa9666e6b6805523c80cf77). Transport, native storage,
+// head exchange, incoming verification and materialization remain real.
+// Two SDKs share this process, but not a store, journal or device key.
+type migrationLAN struct {
+	mu    sync.Mutex
+	peers map[string]sdkp2p.Announcement
+	subs  map[int]func(sdkp2p.DiscoveredPeer)
+	next  int
+}
+
+func (l *migrationLAN) announce(a sdkp2p.Announcement) {
+	l.mu.Lock()
+	l.peers[a.PeerId] = a
+	subs := make([]func(sdkp2p.DiscoveredPeer), 0, len(l.subs))
+	for _, fn := range l.subs {
+		subs = append(subs, fn)
+	}
+	l.mu.Unlock()
+	for _, fn := range subs {
+		fn(discoverMigrationPeer(a))
+	}
+}
+
+func (l *migrationLAN) subscribe(fn func(sdkp2p.DiscoveredPeer)) func() {
+	l.mu.Lock()
+	id := l.next
+	l.next++
+	l.subs[id] = fn
+	peers := make([]sdkp2p.Announcement, 0, len(l.peers))
+	for _, peer := range l.peers {
+		peers = append(peers, peer)
+	}
+	l.mu.Unlock()
+	for _, peer := range peers {
+		fn(discoverMigrationPeer(peer))
+	}
+	return func() { l.mu.Lock(); delete(l.subs, id); l.mu.Unlock() }
+}
+
+func discoverMigrationPeer(a sdkp2p.Announcement) sdkp2p.DiscoveredPeer {
+	return sdkp2p.DiscoveredPeer{PeerId: a.PeerId, Addrs: []string{net.JoinHostPort("127.0.0.1", strconv.Itoa(a.Port))}}
+}
+
+type migrationLANDriver struct{ lan *migrationLAN }
+
+func (d migrationLANDriver) Announce(ctx context.Context, a sdkp2p.Announcement) error {
+	d.lan.announce(a)
+	<-ctx.Done()
+	return nil
+}
+func (d migrationLANDriver) Browse(ctx context.Context, _ string, found func(sdkp2p.DiscoveredPeer), _ func(string)) error {
+	unsubscribe := d.lan.subscribe(found)
+	defer unsubscribe()
+	<-ctx.Done()
+	return nil
+}
+
+func waitMigration(ctx context.Context, deadline time.Duration, check func() bool) bool {
+	end := time.Now().Add(deadline)
+	for time.Now().Before(end) {
+		if ctx.Err() != nil {
+			return false
+		}
+		if check() {
+			return true
+		}
+		select {
+		case <-ctx.Done():
+			return false
+		case <-time.After(150 * time.Millisecond):
+		}
+	}
+	return false
+}
+
+func TestPreparedMigrationNativeLocalPeerDelivery(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Minute)
+	defer cancel()
+	lan := &migrationLAN{peers: map[string]sdkp2p.Announcement{}, subs: map[int]func(sdkp2p.DiscoveredPeer){}}
+	sdkp2p.SetDriverFactory(func() sdkp2p.Driver { return migrationLANDriver{lan} })
+	t.Cleanup(func() { sdkp2p.SetDriverFactory(nil) })
+	providerA := newSeeds(t)
+	_, keyB, err := ed25519.GenerateKey(rand.Reader)
+	require.NoError(t, err)
+	providerB := &seedProvider{account: providerA.account, device: keyB}
+	network := localNetwork(t)
+	newConfig := func() config.Config { cfg := nativeConfig(t.TempDir(), network); cfg.P2P = config.P2P{}; return cfg }
+	sdkA, err := anysyncsdk.Open(ctx, newConfig(), providerA)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sdkA.Close() })
+	spA, err := sdkA.Spaces().Create(ctx, space.CreateRequest{Name: "disposable prepared peer delivery"})
+	require.NoError(t, err)
+	nativeA := spA.Objects().(space.PreparedMigrationService)
+	capabilities, err := nativeA.MigrationCapabilities(ctx)
+	require.NoError(t, err)
+	opts := space.CreateObjectOpts{Type: "page", InitialProperties: map[string]map[string]any{"any": {"name": "native prepared root"}}}
+	objectInput := nativeInput(t, capabilities, "peer/source/object", map[string]any{"type": "page", "initialProperties": opts.InitialProperties})
+	object, err := nativeA.PrepareMigrationObject(ctx, objectInput, opts)
+	require.NoError(t, err)
+	advanceObject(t, ctx, nativeA, objectInput, object, "root-committed")
+	advanceObject(t, ctx, nativeA, objectInput, object, "bootstrap-prepared")
+	objectDone := advanceObject(t, ctx, nativeA, objectInput, object, "complete")
+	require.Equal(t, "committed", objectDone.Outcome)
+
+	// Empty B learns the Space and prepared root/bootstrap through ordinary
+	// native discovery/head sync. No ledger, DAG bytes, directory or projection
+	// is copied to B, and B never calls a prepare/commit or record mutation API.
+	sdkB, err := anysyncsdk.Open(ctx, newConfig(), providerB)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sdkB.Close() })
+	require.Equal(t, sdkA.Account().Id(), sdkB.Account().Id())
+	require.NotEqual(t, sdkA.P2PStatus().PeerId, sdkB.P2PStatus().PeerId)
+	require.True(t, waitMigration(ctx, 30*time.Second, func() bool { return len(sdkA.P2PStatus().Peers) > 0 && len(sdkB.P2PStatus().Peers) > 0 }), "no real loopback peer handshake")
+	spaceID := spA.Id()
+	require.True(t, waitMigration(ctx, 60*time.Second, func() bool {
+		_ = sdkB.Spaces().SyncSpaceList(ctx)
+		spaces, err := sdkB.Spaces().List(ctx)
+		if err != nil {
+			return false
+		}
+		for _, entry := range spaces {
+			if entry.Id == spaceID {
+				return true
+			}
+		}
+		return false
+	}), "prepared source Space never reached peer")
+	var spB space.Space
+	require.True(t, waitMigration(ctx, 30*time.Second, func() bool {
+		spB, err = sdkB.Spaces().Get(ctx, spaceID)
+		return err == nil
+	}), "destination Space was listed but not yet locally ready: %v", err)
+	require.True(t, waitMigration(ctx, 45*time.Second, func() bool {
+		_ = spB.SyncHeads(ctx)
+		row, err := spB.Properties().Get(ctx, object.ObjectID)
+		return err == nil && row != nil && row.GetString("any", "name") == "native prepared root"
+	}), "prepared root/bootstrap did not arrive through head sync")
+	rootRow, err := spB.History().RecordAt(ctx, object.ObjectID, "objects", object.ObjectID, objectDone.ChangeID)
+	require.NoError(t, err)
+	require.NotNil(t, rootRow)
+	require.Equal(t, "native prepared root", rootRow.GetString("any", "name"))
+	before, err := editor.List(ctx, spB, object.ObjectID, "editor_blocks")
+	require.NoError(t, err)
+	require.Empty(t, before)
+
+	blockSpec := map[string]any{"objectId": object.ObjectID, "dataset": "editor_blocks", "type": "paragraph", "text": "prepared peer delivery", "nav": map[string]any{"parentId": "", "pos": "m"}}
+	blockInput := nativeInput(t, capabilities, "peer/source/block", blockSpec)
+	prepared, err := editor.PrepareMigration(ctx, spA, blockInput, object.ObjectID, "editor_blocks", editor.CreateInput{Type: "paragraph", Text: "prepared peer delivery", Pos: "m"})
+	require.NoError(t, err)
+	committed, err := nativeA.CommitMigration(ctx, commitOf(blockInput, prepared))
+	require.NoError(t, err)
+	require.Equal(t, "committed", committed.Outcome)
+	var received []editor.Block
+	require.True(t, waitMigration(ctx, 45*time.Second, func() bool {
+		_ = spB.SyncHeads(ctx)
+		received, err = editor.List(ctx, spB, object.ObjectID, "editor_blocks")
+		return err == nil && len(received) == 1 && received[0].Id == prepared.RecordIDs[0] && received[0].Text == "prepared peer delivery"
+	}), "prepared append failed ordinary peer materialization")
+	historical, err := spB.History().RecordAt(ctx, object.ObjectID, "editor_blocks", prepared.RecordIDs[0], prepared.ChangeID)
+	require.NoError(t, err)
+	require.NotNil(t, historical)
+	require.Equal(t, "prepared peer delivery", historical.GetString("text"))
+	onA, err := editor.Get(ctx, spA, object.ObjectID, "editor_blocks", prepared.RecordIDs[0])
+	require.NoError(t, err)
+	require.Equal(t, onA.Ver, received[0].Ver, "native creation versions must agree across peers")
+	retry, err := nativeA.CommitMigration(ctx, commitOf(blockInput, prepared))
+	require.NoError(t, err)
+	require.Equal(t, committed, retry)
+	_ = spB.SyncHeads(ctx)
+	received, err = editor.List(ctx, spB, object.ObjectID, "editor_blocks")
+	require.NoError(t, err)
+	require.Len(t, received, 1)
+	for _, sdk := range []*anysyncsdk.SDK{sdkA, sdkB} {
+		require.True(t, waitMigration(ctx, 15*time.Second, func() bool { return sdk.Spaces().Status(spaceID).LocalPeers >= 1 }))
+		require.Zero(t, sdk.Spaces().Status(spaceID).NetworkPeers)
+	}
+	t.Logf("local_peer_evidence object=%s bootstrap=%s block=%s record=%s distinct_devices=2 destination_migration_api_calls=0 network_peers=0", object.ObjectID, objectDone.ChangeID, prepared.ChangeID, prepared.RecordIDs[0])
+}
