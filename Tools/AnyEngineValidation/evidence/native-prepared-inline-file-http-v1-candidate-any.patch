index 0000000000000000000000000000000000000000..5f9858aea69cbb777de1e586ca1fc5c9f6edc47a
--- /dev/null
+++ b/internal/server/handlers_pinkha_migration.go
@@ -0,0 +1,294 @@
+package server
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"reflect"
+	"slices"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any/internal/api"
+	"github.com/anyproto/any/internal/editor"
+	"github.com/labstack/echo/v4"
+)
+
+const migrationSpecLimit = 1 << 20
+const migrationWireLimit = 2 << 20
+
+func registerPinkhaMigrationRoutes(v1 *echo.Group, d *deps) {
+	registerPinkhaMigrationInlineFileRoutes(v1, d)
+	v1.GET("/spaces/:spaceId/pinkha/migration/capabilities", d.pinkhaMigrationCapabilities)
+	v1.PUT("/spaces/:spaceId/pinkha/migration/intents/:intentId/object/prepare", d.pinkhaMigrationObjectPrepare)
+	v1.PUT("/spaces/:spaceId/pinkha/migration/intents/:intentId/block/prepare", d.pinkhaMigrationBlockPrepare)
+	v1.POST("/spaces/:spaceId/pinkha/migration/intents/:intentId/commit", d.pinkhaMigrationCommit)
+	v1.GET("/spaces/:spaceId/pinkha/migration/intents/:intentId", d.pinkhaMigrationStatus)
+}
+
+func migrationService(sp space.Space) (space.PreparedMigrationService, error) {
+	native, ok := sp.Objects().(space.PreparedMigrationService)
+	if !ok {
+		return nil, space.ErrCurrentWriterUnavailable
+	}
+	return native, nil
+}
+
+func migrationError(c echo.Context, err error) error {
+	switch {
+	case errors.Is(err, space.ErrMigrationCollision):
+		return writeError(c, http.StatusConflict, "pinkha.migration_collision", "immutable migration plan or intent differs", nil)
+	case errors.Is(err, space.ErrMigrationScope):
+		return writeError(c, http.StatusConflict, "pinkha.migration_scope_changed", "migration destination or request binding differs", nil)
+	case errors.Is(err, space.ErrMigrationObsolete):
+		return writeError(c, http.StatusConflict, "pinkha.migration_obsolete", "prepared native envelope is obsolete; no replacement was allocated", nil)
+	case errors.Is(err, space.ErrMigrationNotFound):
+		return writeError(c, http.StatusNotFound, "pinkha.migration_not_found", "native migration preparation was not found", nil)
+	default:
+		return sdkOpError(c, err, map[string]any{"intentId": c.Param("intentId"), "reconcile": "native-status"})
+	}
+}
+
+func (d *deps) pinkhaMigrationCapabilities(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.MigrationCapabilities(c.Request().Context())
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func readMigrationJSON(c echo.Context, value any) error {
+	raw, err := io.ReadAll(io.LimitReader(c.Request().Body, migrationWireLimit+1))
+	if err != nil || len(raw) == 0 || len(raw) > migrationWireLimit {
+		return fmt.Errorf("invalid migration JSON size")
+	}
+	return strictMigrationJSON(raw, value)
+}
+
+// Reject duplicate keys at every object depth before typed decoding. A digest
+// is meaningful only when every consumer agrees which value the bytes denote.
+func strictMigrationJSON(raw []byte, value any) error {
+	if !utf8.Valid(raw) {
+		return fmt.Errorf("migration specification is not UTF-8")
+	}
+	if err := space.ValidatePreparedMigrationNumbers(raw); err != nil {
+		return err
+	}
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.UseNumber()
+	var walk func(int) error
+	walk = func(depth int) error {
+		if depth > 64 {
+			return fmt.Errorf("migration JSON depth")
+		}
+		token, err := d.Token()
+		if err != nil {
+			return err
+		}
+		delim, compound := token.(json.Delim)
+		if !compound {
+			return nil
+		}
+		switch delim {
+		case '{':
+			seen := map[string]bool{}
+			for d.More() {
+				key, err := d.Token()
+				if err != nil {
+					return err
+				}
+				name, ok := key.(string)
+				if !ok || seen[name] {
+					return fmt.Errorf("duplicate migration JSON key")
+				}
+				seen[name] = true
+				if err := walk(depth + 1); err != nil {
+					return err
+				}
+			}
+		case '[':
+			for d.More() {
+				if err := walk(depth + 1); err != nil {
+					return err
+				}
+			}
+		default:
+			return fmt.Errorf("invalid migration JSON delimiter")
+		}
+		_, err = d.Token()
+		return err
+	}
+	if err := walk(0); err != nil {
+		return err
+	}
+	if _, err := d.Token(); err != io.EOF {
+		return fmt.Errorf("migration JSON trailing data")
+	}
+	if err := migrationExactFields(raw, reflect.TypeOf(value)); err != nil {
+		return err
+	}
+	typed := json.NewDecoder(bytes.NewReader(raw))
+	typed.DisallowUnknownFields()
+	typed.UseNumber()
+	if err := typed.Decode(value); err != nil {
+		return err
+	}
+	return nil
+}
+
+// encoding/json otherwise accepts case-insensitive aliases, so "Type" and
+// "type" could both select the same field despite distinct JSON keys. Typed
+// protocol fields are exact; caller property/style dictionary keys stay data.
+func migrationExactFields(raw []byte, target reflect.Type) error {
+	for target.Kind() == reflect.Pointer {
+		target = target.Elem()
+	}
+	if target.Kind() != reflect.Struct {
+		return nil
+	}
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &object); err != nil || object == nil {
+		return fmt.Errorf("migration typed value must be an object")
+	}
+	fields := map[string]reflect.Type{}
+	for i := 0; i < target.NumField(); i++ {
+		field := target.Field(i)
+		if field.PkgPath != "" {
+			continue
+		}
+		name := strings.Split(field.Tag.Get("json"), ",")[0]
+		if name == "-" {
+			continue
+		}
+		if name == "" {
+			name = field.Name
+		}
+		fields[name] = field.Type
+	}
+	for name, value := range object {
+		kind, ok := fields[name]
+		if !ok {
+			return fmt.Errorf("unknown migration field %q", name)
+		}
+		if err := migrationExactFields(value, kind); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func migrationInput(c echo.Context) (space.MigrationInput, []byte, error) {
+	var request api.MigrationPrepareRequest
+	if err := readMigrationJSON(c, &request); err != nil {
+		return space.MigrationInput{}, nil, err
+	}
+	spec, err := base64.StdEncoding.Strict().DecodeString(request.SpecBase64)
+	if err != nil || len(spec) == 0 || len(spec) > migrationSpecLimit || base64.StdEncoding.EncodeToString(spec) != request.SpecBase64 {
+		return space.MigrationInput{}, nil, fmt.Errorf("invalid migration specification encoding")
+	}
+	hash := sha256.Sum256(spec)
+	if request.Contract != space.PreparedMigrationContract || hex.EncodeToString(hash[:]) != request.SpecSHA256 {
+		return space.MigrationInput{}, nil, fmt.Errorf("migration specification digest differs")
+	}
+	input := space.MigrationInput{Contract: request.Contract, StoreID: request.StoreID, PlanID: request.PlanID, PlanSHA256: request.PlanSHA256, IntentID: c.Param("intentId"), SourceKey: request.SourceKey, SpecSHA256: request.SpecSHA256, SourceSpec: spec}
+	return input, spec, nil
+}
+
+func (d *deps) pinkhaMigrationObjectPrepare(c echo.Context) error {
+	input, raw, err := migrationInput(c)
+	if err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	var spec api.MigrationObjectSpec
+	if err := strictMigrationJSON(raw, &spec); err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.PrepareMigrationObject(c.Request().Context(), input, space.CreateObjectOpts{Type: spec.Type, Collections: spec.Collections, InitialProperties: spec.InitialProperties})
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationBlockPrepare(c echo.Context) error {
+	input, raw, err := migrationInput(c)
+	if err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	var spec api.MigrationBlockSpec
+	if err := strictMigrationJSON(raw, &spec); err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	if spec.ObjectID == "" || spec.Dataset != "editor_blocks" || !slices.Contains([]string{"paragraph", "heading", "quote", "code", "list_item", "check_list_item"}, spec.Type) || spec.Nav.Pos == "" {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", "prepared block requires explicit object, dataset, supported type and position", nil)
+	}
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	result, err := editor.PrepareMigration(c.Request().Context(), sp, input, spec.ObjectID, spec.Dataset, editor.CreateInput{Type: spec.Type, Style: spec.Style, Text: spec.Text, ParentId: spec.Nav.ParentId, Pos: spec.Nav.Pos})
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationCommit(c echo.Context) error {
+	var request space.MigrationCommit
+	if err := readMigrationJSON(c, &request); err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	request.IntentID = c.Param("intentId")
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.CommitMigration(c.Request().Context(), request)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationStatus(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.MigrationStatus(c.Request().Context(), c.Param("intentId"))
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
