+func TestPinkhaCurrentWriterObjectAndBlockCreateNativeRoundTrip(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sid, stock := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + sid
+	response := doJSON(t, e, http.MethodPost, base+"/pinkha/objects", `{"type":"page","initialProperties":{"any":{"name":"Fresh fenced native page"}}}`)
+	require.Equal(t, http.StatusCreated, response.Code, response.Body.String())
+	var created api.ObjectsCreateResponse
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &created))
+	require.NotEmpty(t, created.ObjectId)
+	require.NotEqual(t, stock, created.ObjectId)
+	get := doJSON(t, e, http.MethodGet, base+"/objects/"+created.ObjectId, "")
+	require.Equal(t, http.StatusOK, get.Code, get.Body.String())
+	require.Contains(t, get.Body.String(), "Fresh fenced native page")
+	blockPath := base + "/pinkha/objects/" + created.ObjectId + "/editor/editor_blocks/blocks"
+	added := doJSON(t, e, http.MethodPost, blockPath, `{"type":"paragraph","text":"native creation","style":{"future":{"keep":true}}}`)
+	require.Equal(t, http.StatusCreated, added.Code, added.Body.String())
+	receipt := decodeModifyResult(t, added.Body.Bytes())
+	require.Len(t, receipt.RecordIds, 1)
+	require.NotEmpty(t, receipt.VersionId)
+	rows := blocksList(t, e, base+"/objects/"+created.ObjectId).Records
+	require.Len(t, rows, 1)
+	require.Equal(t, receipt.RecordIds[0], rows[0].Id)
+	require.Equal(t, "native creation", rows[0].Text)
+	require.NotNil(t, rows[0].Style["future"])
+	// The ordinary route retains its allocation and response contract.
+	ordinary := blocksCreate(t, e, base+"/objects/"+stock, `{"type":"paragraph","text":"ordinary route"}`)
+	require.NotEmpty(t, ordinary.Id)
+	deleted := doJSON(t, e, http.MethodDelete, base+"/objects/"+created.ObjectId, "")
+	require.Equal(t, http.StatusNoContent, deleted.Code, deleted.Body.String())
+	refused := doJSON(t, e, http.MethodPost, blockPath, `{"type":"paragraph","text":"must not resurrect"}`)
+	require.Contains(t, []int{http.StatusGone, http.StatusNotFound}, refused.Code, refused.Body.String())
+}
+
+func TestPinkhaCurrentWriterCreateRejectsCopyAndMalformedRequests(t *testing.T) {
+	d, teardown := newTestDeps(t)
