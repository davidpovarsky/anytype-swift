+		require.Equal(t, http.StatusBadRequest, res.Code, res.Body.String())
+		require.NotContains(t, res.Body.String(), "pinkha.object_create_uncertain")
+	}
+}
+
+func TestPinkhaCurrentWriterCreationUncertaintyPreservesOnlyMetadata(t *testing.T) {
+	e := echo.New()
+	response := httptest.NewRecorder()
+	c := e.NewContext(httptest.NewRequest(http.MethodPost, "/native", nil), response)
+	cause := errors.New("sensitive internal diagnostic must not be returned")
+	require.NoError(t, pinkhaObjectCreateError(c, cause, "synthetic-space", space.CurrentWriterCreateResult{ObjectID: "synthetic-known-root", CreationStage: "root-stored", Cleanup: "not-attempted", Outcome: "uncertain"}))
+	require.Equal(t, http.StatusServiceUnavailable, response.Code)
