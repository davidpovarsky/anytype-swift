+}
+
+func TestPinkhaDocumentPolicyCustomCanonicalTypesAndBodyRetention(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativeDefinitionPolicy")
+	base := "/v1/spaces/" + sp.Id
+	pinkhaInstallForPolicy(t, e, sp.Id)
+	custom := installModuleType(t, e, sp.Id, "editor")
+	plain := plainType(t, e, sp.Id)
+	readType := func(id string) claims.DocumentTypeProof {
+		result := doJSON(t, e, http.MethodGet, base+"/pinkha/document-types/"+id, "")
+		require.Equal(t, 200, result.Code, result.Body.String())
+		var proof claims.DocumentTypeProof
+		require.NoError(t, json.Unmarshal(result.Body.Bytes(), &proof))
+		require.Equal(t, claims.DocumentPolicy, proof.Policy)
+		require.Len(t, proof.Readiness.Generation, 64)
+		return proof
+	}
+	require.True(t, readType("page").Eligible)
+	require.True(t, readType(custom).Eligible)
+	require.False(t, readType(plain).Eligible, "a layout label alone does not create a native editor")
+	created := doJSON(t, e, http.MethodPost, base+"/pinkha/objects", `{"type":"`+custom+`","initialProperties":{"any":{"name":"Custom native document","description":"retain this"}}}`)
+	require.Equal(t, http.StatusCreated, created.Code, created.Body.String())
+	var object api.ObjectsCreateResponse
+	require.NoError(t, json.Unmarshal(created.Body.Bytes(), &object))
+	block := doJSON(t, e, http.MethodPost, base+"/pinkha/objects/"+object.ObjectId+"/editor/editor_blocks/blocks", `{"type":"paragraph","text":"canonical body","style":{"future":{"untouched":true}}}`)
+	require.Equal(t, http.StatusCreated, block.Code, block.Body.String())
+	blockID := decodeModifyResult(t, block.Body.Bytes()).RecordIds[0]
+	targetPath := base + "/pinkha/document-targets/" + object.ObjectId
+	target := doJSON(t, e, http.MethodGet, targetPath, "")
+	require.Equal(t, 200, target.Code, target.Body.String())
+	var proof claims.DocumentTargetProof
+	require.NoError(t, json.Unmarshal(target.Body.Bytes(), &proof))
+	require.True(t, proof.Eligible)
+	require.True(t, proof.CanWrite)
+	require.Equal(t, custom, proof.TypeID)
+	scoped := doJSON(t, e, http.MethodGet, base+"/pinkha/objects/"+object.ObjectId+"/claims", "")
+	require.Equal(t, 200, scoped.Code, scoped.Body.String())
+	require.Contains(t, scoped.Body.String(), `"complete":true`)
+	run := d.startedAt.Format(time.RFC3339Nano)
+	change := pinkhaSetCurrentProperty(t, e, sp.Id, object.ObjectId, "any", run, map[string]any{"type": "page"})
+	require.Equal(t, 200, change.Code, change.Body.String())
+	rows := blocksList(t, e, base+"/objects/"+object.ObjectId).Records
+	require.Len(t, rows, 1)
+	require.Equal(t, blockID, rows[0].Id)
+	require.Equal(t, "canonical body", rows[0].Text)
+	require.NotNil(t, rows[0].Style["future"])
+	_, properties := pinkhaPropertiesSnapshot(t, e, sp.Id, object.ObjectId)
+	require.Equal(t, "retain this", properties["any"].(map[string]any)["description"])
+	change = pinkhaSetCurrentProperty(t, e, sp.Id, object.ObjectId, "any", run, map[string]any{"type": custom})
+	require.Equal(t, 200, change.Code, change.Body.String())
+	var datasets api.TypeDatasetsListResponse
+	decodeGet(t, e, base+"/types/"+custom+"/datasets", &datasets)
+	require.Len(t, datasets.Datasets, 1)
+	removed := doJSON(t, e, http.MethodDelete, base+"/types/"+custom+"/datasets/"+datasets.Datasets[0].Id, "")
+	require.Equal(t, 204, removed.Code, removed.Body.String())
+	require.False(t, readType(custom).Eligible)
+	invalid := doJSON(t, e, http.MethodGet, targetPath, "")
+	require.Equal(t, 409, invalid.Code, invalid.Body.String())
+	require.Contains(t, invalid.Body.String(), "pinkha.document_ineligible")
+	invalid = doJSON(t, e, http.MethodGet, base+"/pinkha/objects/"+object.ObjectId+"/claims", "")
+	require.GreaterOrEqual(t, invalid.Code, 400)
+	require.NotContains(t, invalid.Body.String(), `"records"`)
+	invalid = doJSON(t, e, http.MethodPost, base+"/pinkha/objects/"+object.ObjectId+"/editor/editor_blocks/blocks", `{"type":"paragraph","text":"must refuse removed editor"}`)
+	require.GreaterOrEqual(t, invalid.Code, 400)
+	restore := pinkhaSetCurrentProperty(t, e, sp.Id, object.ObjectId, "any", run, map[string]any{"type": "page"})
+	require.Equal(t, 200, restore.Code, restore.Body.String())
+	rows = blocksList(t, e, base+"/objects/"+object.ObjectId).Records
