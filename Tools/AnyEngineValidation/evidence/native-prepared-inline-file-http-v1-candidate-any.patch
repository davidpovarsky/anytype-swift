+package server
+
+import "github.com/labstack/echo/v4"
+
+// The embedded mobile host owns a private managed-mode token. Every /v1 data,
+// metadata and stream request must carry it; loopback is not an identity proof.
+// The existing constant-time verifier also refuses an accidentally empty token.
+// Stock desktop and explicit standalone semantics remain unchanged.
+func (d *deps) pinkhaMobileManagedGateway(next echo.HandlerFunc) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		if pinkhaMobileBuild && d.cfg.Managed() && !d.requireControl(c) {
+			return nil
+		}
+		return next(c)
+	}
+}
+
+func (d *deps) pinkhaMobileManagedGatewayVersion() int {
+	if pinkhaMobileBuild && d.cfg.Managed() {
+		return 1
+	}
+	return 0
+}
