+	"github.com/stretchr/testify/require"
+)
+
+func pinkhaReadTypeProof(t *testing.T, e http.Handler, base, typeID string) claims.DocumentTypeProof {
+	t.Helper()
+	response := doJSON(t, e, http.MethodGet, base+"/pinkha/document-types/"+typeID, "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var proof claims.DocumentTypeProof
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &proof))
+	require.Equal(t, claims.ContractID, proof.Contract)
+	require.Equal(t, 1, proof.Version)
+	require.Equal(t, claims.DocumentPolicy, proof.Policy)
+	require.Equal(t, "ready-local-snapshot", proof.Readiness.State)
+	require.Len(t, proof.Readiness.Generation, 64)
+	return proof
+}
+
+func pinkhaReadTargetProof(t *testing.T, e http.Handler, base, objectID string) claims.DocumentTargetProof {
+	t.Helper()
+	response := doJSON(t, e, http.MethodGet, base+"/pinkha/document-targets/"+objectID, "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var proof claims.DocumentTargetProof
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &proof))
+	require.True(t, proof.Eligible)
+	require.True(t, proof.CanWrite)
+	require.Equal(t, objectID, proof.ObjectID)
+	require.Equal(t, "ready-local-snapshot", proof.Readiness.State)
+	require.Len(t, proof.Readiness.Generation, 64)
+	return proof
+}
+
+func TestPinkhaDocumentMetadataWorksBeforeClaimsInstallation(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "UninstalledDocumentMetadata")
+	base := "/v1/spaces/" + sp.Id
+	assertUninstalled := func() {
+		response := doJSON(t, e, http.MethodGet, base+"/pinkha/claims", "")
+		require.Equal(t, http.StatusNotFound, response.Code, response.Body.String())
+	}
+	assertUninstalled()
+	require.True(t, pinkhaReadTypeProof(t, e, base, "page").Eligible)
+	custom := installModuleType(t, e, sp.Id, "editor")
+	require.True(t, pinkhaReadTypeProof(t, e, base, custom).Eligible)
+	for _, typeID := range []string{"page", custom} {
+		created := doJSON(t, e, http.MethodPost, base+"/pinkha/objects", `{"type":"`+typeID+`","initialProperties":{"any":{"name":"Uninstalled ordinary document"}}}`)
+		require.Equal(t, http.StatusCreated, created.Code, created.Body.String())
+		var object api.ObjectsCreateResponse
+		require.NoError(t, json.Unmarshal(created.Body.Bytes(), &object))
+		proof := pinkhaReadTargetProof(t, e, base, object.ObjectId)
+		require.Equal(t, typeID, proof.TypeID)
+		block := doJSON(t, e, http.MethodPost, base+"/pinkha/objects/"+object.ObjectId+"/editor/editor_blocks/blocks", `{"type":"paragraph","text":"usable before Torah install"}`)
+		require.Equal(t, http.StatusCreated, block.Code, block.Body.String())
+		require.Len(t, decodeModifyResult(t, block.Body.Bytes()).RecordIds, 1)
+		require.NotEqual(t, proof.Readiness.Generation, pinkhaReadTargetProof(t, e, base, object.ObjectId).Readiness.Generation)
+	}
+	assertUninstalled() // Metadata reads neither install nor create the claims carrier.
+}
+
+func TestPinkhaDocumentMetadataGenerationExcludesUnrelatedClaims(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "DocumentMetadataDependencies")
+	base := "/v1/spaces/" + sp.Id
+	custom := installModuleType(t, e, sp.Id, "editor")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"`+custom+`"}`)
+	other := mustCreateObject(t, e, sp.Id, `{"type":"page"}`)
+	initialTarget := pinkhaReadTargetProof(t, e, base, oid)
+	initialType := pinkhaReadTypeProof(t, e, base, custom)
+	initialPage := pinkhaReadTypeProof(t, e, base, "page")
+	install := doJSON(t, e, http.MethodPost, base+"/pinkha/install", "")
+	require.Equal(t, 200, install.Code, install.Body.String())
+	var installed struct {
+		RootObjectID string `json:"rootObjectId"`
+	}
+	require.NoError(t, json.Unmarshal(install.Body.Bytes(), &installed))
+	require.NotEmpty(t, installed.RootObjectID)
+	require.Equal(t, initialTarget.Readiness, pinkhaReadTargetProof(t, e, base, oid).Readiness, "unrelated carrier installation is not a document change")
+	payload, err := json.Marshal(map[string]any{"version": 2, "records": []any{map[string]any{"spaceId": sp.Id, "objectId": other, "item": map[string]any{"id": "independent-context", "kind": "ref", "role": "context", "providerID": "sefaria", "externalID": "Genesis.1.1", "canonicalKey": "Genesis 1:1"}}}})
+	require.NoError(t, err)
+	claim, err := claims.Make(claims.Operation{Version: 1, SpaceID: sp.Id, OperationID: "00000000000000000000000000000007", AuthorID: d.account, Kind: claims.Add, Target: claims.Target{ObjectID: other}, Source: claims.Source{ProviderID: "sefaria", CanonicalRef: "Genesis 1:1"}, Payload: payload})
+	require.NoError(t, err)
+	body, err := json.Marshal(map[string]any{"objectId": installed.RootObjectID, "dataset": claims.Dataset, "records": []any{map[string]any{"id": claim.RecordID(), "upsert": true, "ops": []any{map[string]any{"type": "$set", "value": claims.EncodeRecord(claim)}}}}})
+	require.NoError(t, err)
+	written := doJSON(t, e, http.MethodPost, base+"/modify", string(body))
+	require.Equal(t, http.StatusOK, written.Code, written.Body.String())
+	result := decodeModifyResult(t, written.Body.Bytes())
+	require.NotEmpty(t, result.ChangeId)
+	require.Empty(t, result.Rejections)
+	require.Equal(t, initialTarget.Readiness, pinkhaReadTargetProof(t, e, base, oid).Readiness, "an unrelated signed claim must not invalidate this document proof")
+	require.Equal(t, initialType.Readiness, pinkhaReadTypeProof(t, e, base, custom).Readiness)
+	require.Equal(t, initialPage.Readiness, pinkhaReadTypeProof(t, e, base, "page").Readiness)
+	block := doJSON(t, e, http.MethodPost, base+"/pinkha/objects/"+oid+"/editor/editor_blocks/blocks", `{"type":"paragraph","text":"this document changed"}`)
+	require.Equal(t, http.StatusCreated, block.Code, block.Body.String())
+	require.NotEqual(t, initialTarget.Readiness, pinkhaReadTargetProof(t, e, base, oid).Readiness, "the actual native target tree remains bound")
+	require.Equal(t, initialType.Readiness, pinkhaReadTypeProof(t, e, base, custom).Readiness)
+	var datasets api.TypeDatasetsListResponse
+	decodeGet(t, e, base+"/types/"+custom+"/datasets", &datasets)
+	require.Len(t, datasets.Datasets, 1)
+	removed := doJSON(t, e, http.MethodDelete, base+"/types/"+custom+"/datasets/"+datasets.Datasets[0].Id, "")
+	require.Equal(t, http.StatusNoContent, removed.Code, removed.Body.String())
+	current := pinkhaReadTypeProof(t, e, base, custom)
+	require.False(t, current.Eligible)
+	require.NotEqual(t, initialType.Readiness, current.Readiness, "the actual dynamic definition remains bound")
+	ineligible := doJSON(t, e, http.MethodGet, base+"/pinkha/document-targets/"+oid, "")
+	require.Equal(t, http.StatusConflict, ineligible.Code, ineligible.Body.String())
+}
+
+func TestPinkhaDocumentMetadataEmptyNativeSnapshotCannotReadRows(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	info := createSpaceInfo(t, e, "StaticPolicyNativeBoundary")
+	oid := mustCreateObject(t, e, info.Id, `{"type":"page"}`)
+	sp, err := d.sdk.Spaces().Get(context.Background(), info.Id)
+	require.NoError(t, err)
+	called := false
+	err = sdkspace.NativeReadSnapshot(context.Background(), sp, nil, func(view handler.NativeReadView) error {
+		called = true
+		require.True(t, view.CanWrite())
+		require.NotEmpty(t, view.ReadStamp().ACLHeadID)
+		require.Empty(t, view.ReadStamp().TreeHeads)
+		definitions, ok := view.(handler.NativeTypeDefinitionView)
+		require.True(t, ok)
+		eligible, err := definitions.TypeDeclaresDataset("page", "editor", "editor_blocks", true)
+		require.NoError(t, err)
+		require.True(t, eligible)
+		_, err = view.Lookup(oid, "objects", oid)
+		require.Error(t, err, "no object dependency was declared")
+		_, err = view.Query(oid, "objects", nil, 1)
+		require.Error(t, err)
+		_, err = view.SpaceObjects(nil, 1)
+		require.Error(t, err, "an immutable-Type proof is not a Space row read capability")
+		return nil
+	})
+	require.NoError(t, err)
+	require.True(t, called)
+}
