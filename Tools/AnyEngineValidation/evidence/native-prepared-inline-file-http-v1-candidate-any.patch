@@ -0,0 +1,29 @@
+package server
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/any/internal/pinkha/claims"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPinkhaPresentationBoundsPreserveFutureOpaqueKeys(t *testing.T) {
+	check := func(value any) *descriptorViolation {
+		return validatePinkhaPresentationPatch(claims.PropertyPresentationCollection, map[string]any{claims.PropertyPresentationHiddenProperty: value})
+	}
+	require.Nil(t, check([]string{"property:v1:3:any:4:name", "derived:v1:pinkha-torah-native-v1:pinkhaSources", "future:v17:opaque:שלום"}))
+	require.Nil(t, check(nil))
+	require.Nil(t, check([]string{}))
+	for _, value := range []any{"wrong shape", []any{true}, []string{""}, []string{"duplicate", "duplicate"}, []string{strings.Repeat("א", 2049)}, []string{"bad\x00key"}} {
+		require.NotNil(t, check(value))
+	}
+	max := make([]string, claims.PropertyPresentationMaxKeys)
+	for i := range max {
+		max[i] = fmt.Sprintf("future:%d", i)
+	}
+	require.Nil(t, check(max))
+	require.NotNil(t, check(append(max, "overflow")))
+	require.Nil(t, validatePinkhaPresentationPatch("unrelated-owner", map[string]any{"hiddenProperties": "unrelated value"}))
+}
