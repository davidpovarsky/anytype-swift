+package server
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Test snapshots already decode this small synthetic native counter as a
+// float64. Refuse rounding instead of manufacturing a different capture.
+func pinkhaCapturedSequence(t *testing.T, record map[string]any) uint64 {
+	t.Helper()
+	value, ok := record["_applySeq"].(float64)
+	if !ok || value <= 0 || value >= 1<<53 || value != float64(uint64(value)) {
+		t.Fatal("invalid exact native test sequence")
+	}
+	return uint64(value)
+}
+func pinkhaNoopBody(t *testing.T, version json.RawMessage, sequence uint64, run string) string {
+	t.Helper()
+	raw, err := json.Marshal(map[string]any{"patch": map[string]any{}, "ifVersion": version, "ifApplySeq": sequence, "ifStartedAt": run})
+	require.NoError(t, err)
+	return string(raw)
+}
+
+func TestPinkhaPropertyConditionalNoopKeepsMetadataAndStockRejection(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativeConditionalNoop")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"unchanged","description":"preserved"}}}`)
+	version, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	sequence := pinkhaCapturedSequence(t, before)
+	path := "/v1/spaces/" + sp.Id + "/pinkha/properties/" + oid + "/set/any"
+	body := pinkhaNoopBody(t, version, sequence, d.startedAt.Format(time.RFC3339Nano))
+	for range 2 {
+		result := doJSON(t, e, http.MethodPost, path, body)
+		require.Equal(t, 200, result.Code, result.Body.String())
+		var receipt struct {
+			ChangeID        string   `json:"changeId"`
+			VersionID       string   `json:"versionId"`
+			ApplySeq        uint64   `json:"applySeq"`
+			RecordIDs       []string `json:"recordIds"`
+			EngineStartedAt string   `json:"engineStartedAt"`
+		}
+		require.NoError(t, json.Unmarshal(result.Body.Bytes(), &receipt))
+		var wire map[string]json.RawMessage
+		require.NoError(t, json.Unmarshal(result.Body.Bytes(), &wire))
+		require.NotContains(t, wire, "applySeq", "a no-op has no new accepted sequence")
+		require.NotContains(t, wire, "propertiesVersion", "a no-op must not manufacture a write receipt")
+		require.Empty(t, receipt.ChangeID)
+		require.Empty(t, receipt.VersionID)
+		require.Zero(t, receipt.ApplySeq)
+		require.Equal(t, []string{oid}, receipt.RecordIDs)
+		require.Equal(t, d.startedAt.Format(time.RFC3339Nano), receipt.EngineStartedAt)
+		_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+		require.Equal(t, before, after, "no-op must not add history or advance record metadata")
+	}
+	stock := doJSON(t, e, http.MethodPost, "/v1/spaces/"+sp.Id+"/properties/"+oid+"/set/any", `{"patch":{}}`)
+	require.Equal(t, 400, stock.Code)
+}
+
+func TestPinkhaPropertyConditionalNoopRejectsABAAndWrongRun(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativeNoopABA")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"A"}}}`)
+	initial, captured := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	oldSeq := pinkhaCapturedSequence(t, captured)
+	path := "/v1/spaces/" + sp.Id + "/pinkha/properties/" + oid + "/set/any"
+	run := d.startedAt.Format(time.RFC3339Nano)
+	b := doJSON(t, e, http.MethodPost, path, pinkhaPropertyBody(initial, run, "B", oldSeq))
+	require.Equal(t, 200, b.Code, b.Body.String())
+	mid, midRow := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	a := doJSON(t, e, http.MethodPost, path, pinkhaPropertyBody(mid, run, "A", pinkhaCapturedSequence(t, midRow)))
+	require.Equal(t, 200, a.Code, a.Body.String())
+	current, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	currentSeq := pinkhaCapturedSequence(t, before)
+	require.Greater(t, currentSeq, oldSeq)
+	for _, test := range []struct{ name, body string }{
+		{"stale full capture", pinkhaNoopBody(t, initial, oldSeq, run)},
+		{"equal current version with old sequence", pinkhaNoopBody(t, current, oldSeq, run)},
+		{"wrong original run", pinkhaNoopBody(t, current, currentSeq, "2000-01-01T00:00:00Z")},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			result := doJSON(t, e, http.MethodPost, path, test.body)
+			require.Equal(t, 409, result.Code, result.Body.String())
+			_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+			require.Equal(t, before, after)
+		})
+	}
+}
+
+func TestPinkhaPropertyConditionalNoopRequiresCurrentOwnerAndCollections(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativeNoopOwners")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"retain"}}}`)
+	run := d.startedAt.Format(time.RFC3339Nano)
+	base := "/v1/spaces/" + sp.Id
+	for _, owner := range []string{"missing-native-owner", "bin"} {
+		t.Run(owner, func(t *testing.T) {
+			version, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+			result := doJSON(t, e, http.MethodPost, base+"/pinkha/properties/"+oid+"/set/"+owner, pinkhaNoopBody(t, version, pinkhaCapturedSequence(t, before), run))
+			require.GreaterOrEqual(t, result.Code, 400, result.Body.String())
+			_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+			require.Equal(t, before, after)
+		})
+	}
+	collection := mustCreateCollection(t, e, sp.Id, `{"name":"Noop current collection","xKey":"noop_current_collection"}`)
+	attached := pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, map[string]any{"collections": []string{collection}})
+	require.Equal(t, 200, attached.Code, attached.Body.String())
+	liveVersion, live := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	accepted := doJSON(t, e, http.MethodPost, base+"/pinkha/properties/"+oid+"/set/"+collection, pinkhaNoopBody(t, liveVersion, pinkhaCapturedSequence(t, live), run))
+	require.Equal(t, 200, accepted.Code, accepted.Body.String())
+	removed := doJSON(t, e, http.MethodDelete, base+"/collections/"+collection, "")
+	require.Equal(t, 204, removed.Code, removed.Body.String())
+	version, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	for _, owner := range []string{"any", collection} {
+		t.Run("removed attached definition through "+owner, func(t *testing.T) {
+			result := doJSON(t, e, http.MethodPost, base+"/pinkha/properties/"+oid+"/set/"+owner, pinkhaNoopBody(t, version, pinkhaCapturedSequence(t, before), run))
+			require.GreaterOrEqual(t, result.Code, 400, result.Body.String())
