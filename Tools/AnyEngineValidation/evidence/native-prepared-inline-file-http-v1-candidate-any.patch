+	"github.com/labstack/echo/v4"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPinkhaAuthorizedOperationReadNativeLiveUnreachableAndUnavailable(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "AuthorizedOperationNativeRead")
+	base := "/v1/spaces/" + sp.Id
+	operationID := strings.Repeat("1", 32)
+	readPath := base + "/pinkha/operations/" + operationID
+	missing := doJSON(t, e, http.MethodGet, readPath, "")
+	require.Equal(t, 409, missing.Code, missing.Body.String())
+	require.Contains(t, missing.Body.String(), "pinkha.history_unavailable")
+	require.NotContains(t, missing.Body.String(), "absentInVerifiedLocalSnapshot")
+	stillMissing := doJSON(t, e, http.MethodGet, base+"/pinkha/claims", "")
+	require.Equal(t, 404, stillMissing.Code)
+	installed := doJSON(t, e, http.MethodPost, base+"/pinkha/install", "")
+	require.Equal(t, 200, installed.Code, installed.Body.String())
+	var installation map[string]any
+	require.NoError(t, json.Unmarshal(installed.Body.Bytes(), &installation))
+	root := installation["rootObjectId"].(string)
+	read := func() api.PinkhaOperationRead {
+		response := doJSON(t, e, http.MethodGet, readPath, "")
+		require.Equal(t, 200, response.Code, response.Body.String())
+		var value api.PinkhaOperationRead
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &value))
+		require.Equal(t, claims.AuthorizedOperationReadContract, value.ReadContract)
+		require.Equal(t, sp.Id, value.SpaceID)
+		require.Equal(t, root, value.RootObjectID)
+		require.True(t, value.Complete)
+		require.Len(t, value.Readiness.Generation, 64)
+		return value
+	}
+	absent := read()
+	require.Equal(t, "absentInVerifiedLocalSnapshot", absent.Outcome)
+	require.Empty(t, absent.Variants)
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page"}`)
+	created := doJSON(t, e, http.MethodPost, base+"/pinkha/objects/"+oid+"/editor/editor_blocks/blocks", `{"type":"paragraph","text":"authorized target"}`)
+	require.Equal(t, 201, created.Code, created.Body.String())
+	blockID := decodeModifyResult(t, created.Body.Bytes()).RecordIds[0]
+	op := claims.Operation{Version: 1, SpaceID: sp.Id, OperationID: operationID, AuthorID: d.account, Kind: claims.Add,
+		Target: claims.Target{ObjectID: oid, BlockID: blockID}, Source: claims.Source{ProviderID: "sefaria", CanonicalRef: "Genesis.1.1"}, Payload: []byte("exact retained canonical payload"), Observed: []string{}}
+	claim, err := claims.Make(op)
+	require.NoError(t, err)
+	body, err := json.Marshal(map[string]any{"objectId": root, "dataset": claims.Dataset, "records": []any{map[string]any{"id": claim.RecordID(), "upsert": true, "ops": []any{map[string]any{"type": "$set", "value": claims.EncodeRecord(claim)}}}}})
+	require.NoError(t, err)
+	written := doJSON(t, e, http.MethodPost, base+"/modify", string(body))
+	require.Equal(t, 200, written.Code, written.Body.String())
+	writeResult := decodeModifyResult(t, written.Body.Bytes())
+	require.Empty(t, writeResult.Rejections)
+	require.NotEmpty(t, writeResult.ChangeId)
+	canonical, err := op.CanonicalBytes()
+	require.NoError(t, err)
+	live := read()
+	require.Equal(t, "found", live.Outcome)
+	require.Len(t, live.Variants, 1)
+	require.Equal(t, canonical, live.Variants[0].CanonicalBytes)
+	require.Equal(t, "liveBlock", live.Variants[0].Reachability)
+	var record map[string]any
+	require.NoError(t, json.Unmarshal(live.Variants[0].Record, &record))
+	require.Equal(t, claim.RecordID(), record["id"])
+	require.Equal(t, d.account, record["creator"])
+	require.Equal(t, writeResult.ChangeId, record["nativeChangeId"])
+	require.NotEmpty(t, record["nativeACLHeadId"])
+	removed := doJSON(t, e, http.MethodDelete, base+"/objects/"+oid+"/editor/editor_blocks/blocks/"+blockID, "")
+	require.Equal(t, 200, removed.Code, removed.Body.String())
+	deleteResult := decodeModifyResult(t, removed.Body.Bytes())
+	require.NotEmpty(t, deleteResult.ChangeId)
+	require.Contains(t, deleteResult.RecordIds, blockID)
+	orphan := read()
+	require.Equal(t, "unreachableBlock", orphan.Variants[0].Reachability)
+	require.Equal(t, canonical, orphan.Variants[0].CanonicalBytes)
+	require.JSONEq(t, string(live.Variants[0].Record), string(orphan.Variants[0].Record))
+	require.NotEqual(t, live.Readiness.Generation, orphan.Readiness.Generation)
+	deleted := doJSON(t, e, http.MethodDelete, base+"/objects/"+oid, "")
+	require.Equal(t, 204, deleted.Code, deleted.Body.String())
+	unavailable := doJSON(t, e, http.MethodGet, readPath, "")
+	require.Equal(t, 409, unavailable.Code, unavailable.Body.String())
+	require.Contains(t, unavailable.Body.String(), "pinkha.target_state_unavailable")
+	for _, private := range []string{"canonicalBytes", "variants", claim.RecordID(), op.Source.CanonicalRef} {
+		require.NotContains(t, unavailable.Body.String(), private)
+	}
+	invalid := doJSON(t, e, http.MethodGet, readPath+"?currentACL=owner", "")
+	require.Equal(t, 400, invalid.Code)
+}
+
+func TestPinkhaAuthorizedOperationReadEncodedLimitAndDeniedResponseReleaseNoPayload(t *testing.T) {
+	result := &claims.AuthorizedOperationRead{SpaceID: "space", RootID: "root", OperationID: strings.Repeat("1", 32),
+		Variants: []claims.AuthorizedOperationVariant{{Record: json.RawMessage(`{"id":"private-claim"}`), CanonicalBytes: bytes.Repeat([]byte{1}, 3*1024*1024), Reachability: claims.OperationLiveDocument}}}
+	body, err := encodePinkhaOperationRead(result)
+	require.ErrorIs(t, err, claims.ErrReadLimit)
+	require.Nil(t, body)
+	e := echo.New()
+	recorder := httptest.NewRecorder()
+	c := e.NewContext(httptest.NewRequest(http.MethodGet, "/", nil), recorder)
+	require.NoError(t, pinkhaOperationReadError(c, list.ErrInsufficientPermissions, "private-space"))
+	require.Equal(t, 403, recorder.Code)
+	require.Contains(t, recorder.Body.String(), "pinkha.permission_denied")
+	require.NotContains(t, recorder.Body.String(), "private-space")
+	require.NotContains(t, recorder.Body.String(), "variants")
+}
diff --git a/internal/server/handlers_pinkha_property_cas_test.go b/internal/server/handlers_pinkha_property_cas_test.go
