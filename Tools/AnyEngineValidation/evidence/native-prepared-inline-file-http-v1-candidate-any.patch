+	version, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	prepared, err := json.Marshal(map[string]any{"patch": map[string]any{property.PropId: "prepared plain text"}, "ifVersion": version, "ifApplySeq": pinkhaCapturedSequence(t, before), "ifStartedAt": d.startedAt.Format(time.RFC3339Nano)})
+	require.NoError(t, err)
+	changed := doJSON(t, e, http.MethodPatch, base+"/types/"+custom+"/properties/"+property.PropId, `{"set":{"xFormat.type":"url"}}`)
+	require.Equal(t, 204, changed.Code, changed.Body.String())
+	result := doJSON(t, e, http.MethodPost, base+"/pinkha/properties/"+oid+"/set/"+custom, string(prepared))
+	require.Equal(t, 400, result.Code, result.Body.String())
+	require.Contains(t, result.Body.String(), "property.format_violation")
+	_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	require.Equal(t, before, after, "definition changes are distinct from object versions, but must still refuse the stale value before append")
+	valid := pinkhaSetCurrentProperty(t, e, sp.Id, oid, custom, d.startedAt.Format(time.RFC3339Nano), map[string]any{property.PropId: "https://example.invalid/source"})
+	require.Equal(t, 200, valid.Code, valid.Body.String())
+	removed := doJSON(t, e, http.MethodDelete, base+"/types/"+custom+"/properties/"+property.PropId, "")
+	require.Equal(t, 204, removed.Code, removed.Body.String())
+	_, before = pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	result = pinkhaSetCurrentProperty(t, e, sp.Id, oid, custom, d.startedAt.Format(time.RFC3339Nano), map[string]any{property.PropId: "https://example.invalid/new"})
+	require.GreaterOrEqual(t, result.Code, 400, result.Body.String())
+	_, after = pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	require.Equal(t, before, after, "removed property definitions cannot authorize new native values")
+}
+
+func TestPinkhaDefinitionDocumentPickerRefusesRemovedDestinationEditor(t *testing.T) {
