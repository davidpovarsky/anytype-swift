diff --git a/internal/editor/migration_prepared.go b/internal/editor/migration_prepared.go
new file mode 100644
index 0000000000000000000000000000000000000000..ca36bd401bffaaea60cebdec09140e259c9e0ba7
--- /dev/null
+++ b/internal/editor/migration_prepared.go
@@ -0,0 +1,22 @@
+package editor
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+// PrepareMigration uses the same pure batch builder as Create. It deliberately
+// requires an explicit position so a retry cannot choose a different sibling
+// ordering. Native SDK code reserves/signs the operation and assigns its ID.
+func PrepareMigration(ctx context.Context, sp space.Space, binding space.MigrationInput, objectID, collection string, in CreateInput) (space.MigrationReceipt, error) {
+	if objectID == "" || collection != "editor_blocks" || in.Type == "" || in.Pos == "" {
+		return space.MigrationReceipt{}, fmt.Errorf("blocks: prepared migration requires object, editor_blocks, type and position")
+	}
+	native, ok := sp.Objects().(space.PreparedMigrationService)
+	if !ok {
+		return space.MigrationReceipt{}, space.ErrCurrentWriterUnavailable
+	}
+	return native.PrepareMigrationBlock(ctx, binding, createBatch(objectID, collection, in))
+}
diff --git a/internal/editor/pinkha_patch.go b/internal/editor/pinkha_patch.go
new file mode 100644
index 0000000000000000000000000000000000000000..e1303336dc64eed30d7776afff5e79bbdfecf599
--- /dev/null
+++ b/internal/editor/pinkha_patch.go
@@ -0,0 +1,58 @@
+package editor
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+)
+
+var ErrInvalidConditionalPatch = errors.New("blocks: invalid conditional patch")
+
+// ValidateConditionalPatch uses the SAME native field validators as replay,
+// but runs the entire patch before a DAG write. An invalid sibling op must
+// not cause a valid text edit to land behind an error response.
+// Ancestor/descendant and repeated paths are refused to avoid map-order effects.
+func ValidateConditionalPatch(in PatchInput) error {
+	paths := make([]string, 0, len(in.Set)+len(in.Unset))
+	invalid := func(err error) error { return errors.Join(ErrInvalidConditionalPatch, err) }
+	for path, raw := range in.Set {
+		if path == "" {
+			return invalid(errors.New("empty set path"))
+		}
+		payload, err := anyenc.ParseJson(string(raw))
+		if err != nil {
+			return invalid(err)
+		}
+		op := handler.Op{Type: handler.OpSet, Path: strings.Split(path, "."), Payload: payload}
+		if err := validateSet(&op); err != nil {
+			return invalid(err)
+		}
+		paths = append(paths, path)
+	}
+	for _, path := range in.Unset {
+		if path == "" {
+			return invalid(errors.New("empty unset path"))
+		}
+		op := handler.Op{Type: handler.OpUnset, Path: strings.Split(path, ".")}
+		if err := validateUnset(&op); err != nil {
+			return invalid(err)
+		}
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	for i, path := range paths {
+		for _, segment := range strings.Split(path, ".") {
+			if segment == "" {
+				return invalid(errors.New("empty path segment"))
+			}
+		}
+		if i > 0 && (path == paths[i-1] || strings.HasPrefix(path, paths[i-1]+".")) {
+			return invalid(fmt.Errorf("overlapping paths: %q", path))
+		}
+	}
+	return nil
+}
diff --git a/internal/markdown/pinkha_version.go b/internal/markdown/pinkha_version.go
