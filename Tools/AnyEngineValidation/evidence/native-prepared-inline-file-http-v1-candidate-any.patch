@@ -0,0 +1,37 @@
+package server
+
+import (
+	"errors"
+	"net/http"
+
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any/internal/pinkha/claims"
+	"github.com/labstack/echo/v4"
+)
+
+func (d *deps) pinkhaDocumentType(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	proof, err := claims.ReadDocumentType(c.Request().Context(), sp, c.Param("typeId"))
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	return c.JSON(http.StatusOK, proof)
+}
+
+func (d *deps) pinkhaDocumentTarget(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	proof, err := claims.ReadDocumentTarget(c.Request().Context(), sp, c.Param("objectId"))
+	if errors.Is(err, handler.ErrValidation) {
+		return writeError(c, http.StatusConflict, "pinkha.document_ineligible", "object does not currently satisfy the native document policy", nil)
+	}
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	return c.JSON(http.StatusOK, proof)
+}
