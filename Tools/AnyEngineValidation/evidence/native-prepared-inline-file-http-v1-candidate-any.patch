index 0000000000000000000000000000000000000000..d9d9cafed8428abb8b01090a2264871768b6a55d
--- /dev/null
+++ b/internal/server/pinkha_property_validated.go
@@ -0,0 +1,42 @@
+package server
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+// This error contains only the existing descriptor policy's field/format
+// metadata. It never retains a supplied property value or document content.
+type pinkhaPropertyDescriptorError struct{ violation *descriptorViolation }
+
+func (e *pinkhaPropertyDescriptorError) Error() string {
+	return "property value does not fit its current locked descriptor"
+}
+
+func pinkhaValidatePropertyDescriptors(defs []space.PropertyDef, patch map[string]any) error {
+	if violation := validateDescriptorValues(defs, patch); violation != nil {
+		return &pinkhaPropertyDescriptorError{violation: violation}
+	}
+	return nil
+}
+
+func pinkhaSetPropertiesValidated(ctx context.Context, sp space.Space,
+	objectID, ownerID string, patch map[string]any, sequence uint64) (space.ModifyResult, error) {
+	// The SDK loads dependencies before entering its ordered tree locks, then
+	// supplies current property definitions under the same lock set that
+	// protects membership, target versions and the final signed append.
+	// This callback performs no HTTP lookup, tree load or schema mutation.
+	var requirements []space.TypeDatasetRequirement
+	if ownerID == "any" {
+		if _, changingType := patch["type"]; changingType {
+			requirements = []space.TypeDatasetRequirement{{Module: "editor", Dataset: "editor_blocks", Canonical: true}}
+		}
+	}
+	return space.SetConditionalValidated(ctx, sp, objectID, ownerID, patch, sequence,
+		func(defs []space.PropertyDef) error {
+			if violation := validatePinkhaPresentationPatch(ownerID, patch); violation != nil {
+				return &pinkhaPropertyDescriptorError{violation: violation}
+			}
+			return pinkhaValidatePropertyDescriptors(defs, patch)
+		}, requirements...)
+}
diff --git a/internal/server/pinkha_property_validated_test.go b/internal/server/pinkha_property_validated_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..afe376f85b30bbe7e39fe27fb2a75f059e72dbba
--- /dev/null
+++ b/internal/server/pinkha_property_validated_test.go
@@ -0,0 +1,31 @@
+package server
+
+import (
+	"errors"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/valyala/fastjson"
+	"testing"
+)
+
+func TestPinkhaDescriptorCallbackUsesLatestLockedDefinition(t *testing.T) {
+	patch := map[string]any{"field": fastjson.MustParse(`"plain text"`)}
+	before := []space.PropertyDef{{Id: "field", XFormat: map[string]any{"type": "text"}}}
+	if err := pinkhaValidatePropertyDescriptors(before, patch); err != nil {
+		t.Fatal(err)
+	}
+	// A concurrent descriptor change makes the original value invalid while
+	// kind stays string. The callback must use the locked current definition.
+	after := []space.PropertyDef{{Id: "field", XFormat: map[string]any{"type": "url"}}}
+	err := pinkhaValidatePropertyDescriptors(after, patch)
+	var violation *pinkhaPropertyDescriptorError
+	if !errors.As(err, &violation) || violation.violation.PropId != "field" {
+		t.Fatalf("latest descriptor was not enforced: %v", err)
+	}
+	if err := pinkhaValidatePropertyDescriptors(after,
+		map[string]any{"field": fastjson.MustParse(`"https://example.invalid/source"`)}); err != nil {
+		t.Fatalf("valid value refused: %v", err)
+	}
+	if err := pinkhaValidatePropertyDescriptors(after, map[string]any{"field": nil}); err != nil {
+		t.Fatalf("explicit unset refused: %v", err)
+	}
+}
