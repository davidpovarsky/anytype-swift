+
+func TestPreparedMigrationStrictSourceSpec(t *testing.T) {
+	for _, raw := range []string{`{"type":"page","type":"file"}`, `{"type":"page","Type":"file"}`, `{"Type":"page"}`, `{"type":"page","initialProperties":{"any":{"name":"a","name":"b"}}}`, `{"type":"page","rawChange":"not a native entry point"}`, `{"type":"page"} {"type":"file"}`} {
+		var spec api.MigrationObjectSpec
+		require.Error(t, strictMigrationJSON([]byte(raw), &spec), raw)
+	}
+	var spec api.MigrationObjectSpec
+	require.Error(t, strictMigrationJSON([]byte(`{"type":"page","initialProperties":{"any":{"number":9007199254740993}}}`), &spec))
+	require.NoError(t, strictMigrationJSON([]byte(`{"type":"page","initialProperties":{"any":{"name":"native פנחא","number":9007199254740992}}}`), &spec))
+	require.Equal(t, json.Number("9007199254740992"), spec.InitialProperties["any"]["number"])
+	var block api.MigrationBlockSpec
+	require.Error(t, strictMigrationJSON([]byte(`{"objectId":"object","dataset":"editor_blocks","type":"paragraph","nav":{"ParentId":"","pos":"m"}}`), &block))
+}
+
+func TestPreparedMigrationSpecBase64ExactDigest(t *testing.T) {
+	spec := []byte("{ \"type\": \"page\", \"initialProperties\": {} }")
+	hash := sha256.Sum256(spec)
+	request := api.MigrationPrepareRequest{Contract: space.PreparedMigrationContract, StoreID: strings.Repeat("a", 64), PlanID: strings.Repeat("b", 64), PlanSHA256: strings.Repeat("c", 64), SourceKey: "source/object", SpecBase64: base64.StdEncoding.EncodeToString(spec), SpecSHA256: hex.EncodeToString(hash[:])}
+	for _, corrupt := range []bool{false, true} {
+		copy := request
+		if corrupt {
+			copy.SpecSHA256 = strings.Repeat("0", 64)
+		}
+		body, err := json.Marshal(copy)
+		require.NoError(t, err)
+		e := echo.New()
+		c := e.NewContext(httptest.NewRequest(http.MethodPut, "/", strings.NewReader(string(body))), httptest.NewRecorder())
+		c.SetParamNames("intentId")
+		c.SetParamValues(strings.Repeat("d", 64))
+		input, decoded, err := migrationInput(c)
+		if corrupt {
+			require.Error(t, err)
+			continue
+		}
+		require.NoError(t, err)
+		require.Equal(t, spec, decoded)
+		require.Equal(t, spec, input.SourceSpec)
+		require.Equal(t, request.SpecSHA256, input.SpecSHA256)
+	}
+}
+
+func TestPreparedMigrationHTTPNativeRoundTrip(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	spaceID, _ := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + spaceID
+	migration := base + "/pinkha/migration"
+	response := doJSON(t, e, http.MethodGet, migration+"/capabilities", "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var capability space.MigrationCapabilities
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &capability))
+	require.Equal(t, spaceID, capability.SpaceID)
+	require.Equal(t, space.PreparedMigrationContract, capability.Contract)
+	require.Equal(t, 1, capability.Object)
+	require.Equal(t, 1, capability.EditorBlock)
+	require.NotEmpty(t, capability.AccountID)
+	require.Zero(t, capability.File)
+	require.False(t, capability.NetworkVerified)
+	prepare := func(source, kind string, spec any) space.MigrationReceipt {
+		raw, err := json.MarshalIndent(spec, "", "  ")
+		require.NoError(t, err)
+		digest, intent := sha256.Sum256(raw), sha256.Sum256([]byte(source))
+		request := api.MigrationPrepareRequest{Contract: space.PreparedMigrationContract, StoreID: capability.StoreID, PlanID: strings.Repeat("a", 64), PlanSHA256: strings.Repeat("b", 64), SourceKey: source, SpecBase64: base64.StdEncoding.EncodeToString(raw), SpecSHA256: hex.EncodeToString(digest[:])}
+		body, err := json.Marshal(request)
+		require.NoError(t, err)
+		response := doJSON(t, e, http.MethodPut, migration+"/intents/"+hex.EncodeToString(intent[:])+"/"+kind+"/prepare", string(body))
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		var receipt space.MigrationReceipt
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &receipt))
+		require.Equal(t, request.SpecSHA256, receipt.SpecSHA256)
+		require.Equal(t, capability.AccountID, receipt.AccountID)
+		require.Equal(t, capability.StoreID, receipt.StoreID)
+		return receipt
+	}
+	commit := func(original space.MigrationReceipt) space.MigrationReceipt {
+		body, err := json.Marshal(space.MigrationCommit{Contract: original.Contract, StoreID: original.StoreID, PlanID: original.PlanID, PlanSHA256: original.PlanSHA256, Fingerprint: original.Fingerprint})
+		require.NoError(t, err)
+		response := doJSON(t, e, http.MethodPost, migration+"/intents/"+original.IntentID+"/commit", string(body))
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		var result space.MigrationReceipt
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &result))
+		require.Equal(t, original.Fingerprint, result.Fingerprint)
+		require.Equal(t, original.ObjectID, result.ObjectID)
+		return result
+	}
+	object := prepare("http/source/object", "object", map[string]any{"type": "page", "initialProperties": map[string]any{"any": map[string]any{"name": "HTTP prepared native page"}}})
+	require.Equal(t, "root-prepared", object.Stage)
+	for _, stage := range []string{"root-committed", "bootstrap-prepared", "complete"} {
+		require.Equal(t, stage, commit(object).Stage)
+	}
+	response = doJSON(t, e, http.MethodGet, base+"/objects/"+object.ObjectID, "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	require.Contains(t, response.Body.String(), "HTTP prepared native page")
+	block := prepare("http/source/block", "block", map[string]any{"objectId": object.ObjectID, "dataset": "editor_blocks", "type": "paragraph", "text": "HTTP native body", "style": map[string]any{"future": map[string]any{"retained": true}}, "nav": map[string]any{"parentId": "", "pos": "m"}})
+	require.Equal(t, "block-prepared", block.Stage)
+	created := commit(block)
+	require.Equal(t, "complete", created.Stage)
+	require.Equal(t, "committed", created.Outcome)
+	require.Equal(t, created, commit(block), "HTTP retry must recover the same native creation")
+	rows := blocksList(t, e, base+"/objects/"+object.ObjectID).Records
+	require.Len(t, rows, 1)
+	require.Equal(t, block.RecordIDs[0], rows[0].Id)
+	require.Equal(t, "HTTP native body", rows[0].Text)
+	require.NotNil(t, rows[0].Style["future"])
+	response = doJSON(t, e, http.MethodGet, migration+"/intents/"+block.IntentID, "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var status space.MigrationReceipt
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &status))
+	require.Equal(t, created, status)
+}
