+}
+
+func TestPinkhaDefinitionMembershipRefusesWrongSlotsAndDeletedOwners(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativeDefinitionMembership")
+	base := "/v1/spaces/" + sp.Id
+	run := d.startedAt.Format(time.RFC3339Nano)
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"stable"}}}`)
+	custom := installModuleType(t, e, sp.Id, "editor")
+	collection := mustCreateCollection(t, e, sp.Id, `{"name":"Research","xKey":"native_research"}`)
+	attach := pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, map[string]any{"collections": []string{collection}})
+	require.Equal(t, 200, attach.Code, attach.Body.String())
+	_, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	for _, patch := range []map[string]any{{"type": collection}, {"collections": []string{custom}}, {"type": "type"}, {"collections": []string{"__type__"}}} {
+		result := pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, patch)
+		require.GreaterOrEqual(t, result.Code, 400, result.Body.String())
+		_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+		require.Equal(t, before, after)
+	}
+	removed := doJSON(t, e, http.MethodDelete, base+"/collections/"+collection, "")
+	require.Equal(t, 204, removed.Code, removed.Body.String())
+	result := pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, map[string]any{"collections": []string{collection}})
+	require.GreaterOrEqual(t, result.Code, 400, result.Body.String())
+	// An orphan group is retained; an unrelated ordinary value remains editable.
+	result = pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, map[string]any{"description": "orphan metadata retained"})
+	require.Equal(t, 200, result.Code, result.Body.String())
+	_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	require.Equal(t, []any{collection}, after["any"].(map[string]any)["collections"])
+	result = pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, map[string]any{"collections": []string{}})
+	require.Equal(t, 200, result.Code, result.Body.String())
+}
+
+func TestPinkhaPresentationRegisteredSchemaAndVisibilityPreservesValues(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "NativePropertyPresentation")
+	base := "/v1/spaces/" + sp.Id
+	owner := claims.PropertyPresentationCollection
+	run := d.startedAt.Format(time.RFC3339Nano)
+	info := doJSON(t, e, http.MethodGet, base+"/collections/"+owner, "")
+	require.Equal(t, 200, info.Code, info.Body.String())
+	require.Contains(t, info.Body.String(), `"builtIn":true`)
+	require.Contains(t, info.Body.String(), `"hidden":true`)
+	var properties api.PropertiesListResponse
+	decodeGet(t, e, base+"/collections/"+owner+"/properties", &properties)
+	require.Len(t, properties.Properties, 1)
+	require.Equal(t, claims.PropertyPresentationHiddenProperty, properties.Properties[0].Id)
+	require.Equal(t, "array", properties.Properties[0].Kind)
+	require.Equal(t, "synced", properties.Properties[0].Scope)
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"value stays","description":"also stays"}}}`)
+	attached := pinkhaSetCurrentProperty(t, e, sp.Id, oid, "any", run, map[string]any{"collections": []string{owner}})
+	require.Equal(t, 200, attached.Code, attached.Body.String())
+	keys := []string{"property:v1:3:any:4:name", "derived:v1:pinkha-torah-native-v1:pinkhaSources", "future:v99:opaque:שלום"}
+	hidden := pinkhaSetCurrentProperty(t, e, sp.Id, oid, owner, run, map[string]any{claims.PropertyPresentationHiddenProperty: keys})
+	require.Equal(t, 200, hidden.Code, hidden.Body.String())
+	_, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	require.Equal(t, "value stays", before["any"].(map[string]any)["name"])
+	refused := pinkhaSetCurrentProperty(t, e, sp.Id, oid, owner, run, map[string]any{claims.PropertyPresentationHiddenProperty: []string{keys[0], keys[0]}})
+	require.Equal(t, 400, refused.Code, refused.Body.String())
+	require.Contains(t, refused.Body.String(), "property.format_violation")
+	_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	require.Equal(t, before, after)
+	shown := pinkhaSetCurrentProperty(t, e, sp.Id, oid, owner, run, map[string]any{claims.PropertyPresentationHiddenProperty: keys[1:]})
+	require.Equal(t, 200, shown.Code, shown.Body.String())
+	_, after = pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	require.Equal(t, []any{keys[1], keys[2]}, after[owner].(map[string]any)[claims.PropertyPresentationHiddenProperty])
+	require.Equal(t, "value stays", after["any"].(map[string]any)["name"])
+	require.Equal(t, "also stays", after["any"].(map[string]any)["description"])
+}
+
+func TestPinkhaDefinitionDescriptorChangeRefusesPreparedValue(t *testing.T) {
