index 0000000000000000000000000000000000000000..100d48c4afedfd289b1a2e6efde24a796629c794
--- /dev/null
+++ b/internal/server/handlers_pinkha_migration_inline_file_bridge_test.go
@@ -0,0 +1,182 @@
+//go:build pinkha_inline_http_bridge
+
+package server
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/stretchr/testify/require"
+)
+
+const inlineHTTPBridgeProtocol = "pinkha-native-inline-file-http-v1"
+
+type inlineHTTPBridgeObservation struct {
+	Label         string `json:"label"`
+	IntentID      string `json:"intentId"`
+	SpecBase64    string `json:"specBase64"`
+	SpecSHA256    string `json:"specSHA256"`
+	OwnerObjectID string `json:"ownerObjectId"`
+	ObjectID      string `json:"objectId"`
+	ChangeID      string `json:"changeId"`
+	FileID        string `json:"fileId"`
+	Fingerprint   string `json:"fingerprint"`
+	ContentSHA256 string `json:"contentSHA256"`
+	Size          int64  `json:"size"`
+}
+
+func TestPreparedInlineFileHTTPBridge(t *testing.T) {
+	handshakePath, resultPath := os.Getenv("PINKHA_INLINE_FILE_HANDSHAKE"), os.Getenv("PINKHA_INLINE_FILE_RESULT")
+	require.True(t, filepath.IsAbs(handshakePath) && filepath.IsAbs(resultPath) && handshakePath != resultPath,
+		"separately selected bridge requires two explicit owned evidence paths")
+	for _, path := range []string{handshakePath, resultPath} {
+		_, err := os.Lstat(path)
+		require.True(t, os.IsNotExist(err), "refuse stale bridge evidence")
+	}
+	_, router, sp, owner, capability := inlineHTTPFixture(t)
+	events, unsubscribe := inlineHTTPSubscribe(sp, nil)
+	defer unsubscribe()
+	server := httptest.NewServer(router)
+	defer server.Close()
+	nonceBytes := make([]byte, 16)
+	_, err := rand.Read(nonceBytes)
+	require.NoError(t, err)
+	nonce := hex.EncodeToString(nonceBytes)
+	handshake := map[string]any{"protocol": inlineHTTPBridgeProtocol, "nonce": nonce, "baseURL": server.URL,
+		"accountId": capability.AccountID, "spaceId": capability.SpaceID, "ownerObjectId": owner}
+	raw, err := json.MarshalIndent(handshake, "", "  ")
+	require.NoError(t, err)
+	temporary, err := os.CreateTemp(filepath.Dir(handshakePath), ".inline-file-handshake-")
+	require.NoError(t, err)
+	defer os.Remove(temporary.Name())
+	_, err = temporary.Write(raw)
+	require.NoError(t, err)
+	require.NoError(t, temporary.Close())
+	require.NoError(t, os.Link(temporary.Name(), handshakePath), "publish complete handshake without replacing any prior file")
+	t.Log("owned loopback native HTTP bridge is ready")
+
+	var client struct {
+		Protocol     string                        `json:"protocol"`
+		Nonce        string                        `json:"nonce"`
+		Completed    bool                          `json:"completed"`
+		Observations []inlineHTTPBridgeObservation `json:"observations"`
+	}
+	deadline := time.NewTimer(5 * time.Minute)
+	defer deadline.Stop()
+	tick := time.NewTicker(100 * time.Millisecond)
+	defer tick.Stop()
+wait:
+	for {
+		select {
+		case <-deadline.C:
+			t.Fatal("Swift HTTP bridge did not produce its nonce-bound result within five minutes")
+		case <-tick.C:
+			info, err := os.Lstat(resultPath)
+			if os.IsNotExist(err) {
+				continue
+			}
+			require.NoError(t, err)
+			require.True(t, info.Mode().IsRegular() && info.Size() <= 65536, "bounded original client result required")
+			raw, err := os.ReadFile(resultPath)
+			require.NoError(t, err)
+			require.NoError(t, json.Unmarshal(raw, &client))
+			break wait
+		}
+	}
+	require.Equal(t, inlineHTTPBridgeProtocol, client.Protocol)
+	require.Equal(t, nonce, client.Nonce)
+	require.True(t, client.Completed, "client reported failure; its original result is retained")
+	require.Len(t, client.Observations, 2)
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	native := sp.Files().(space.PreparedInlineFileService)
+	expected := make(map[string]inlineHTTPBridgeObservation)
+	labels := make(map[string]bool)
+	for _, observed := range client.Observations {
+		size := 0
+		name, mime := "", ""
+		switch observed.Label {
+		case "empty":
+		case "maximum":
+			size, name, mime = 4095, "\u05e7\u05d5\u05d1\u05e5 \U0001f9ea.bin", "application/octet-stream"
+		default:
+			t.Fatalf("unknown client case %q", observed.Label)
+		}
+		require.False(t, labels[observed.Label], "client repeated a case")
+		labels[observed.Label] = true
+		require.NotContains(t, expected, observed.FileID, "distinct source files must retain distinct native IDs")
+		expected[observed.FileID] = observed
+		body := inlineHTTPBytes(size)
+		require.Equal(t, int64(size), observed.Size)
+		require.Equal(t, inlineHTTPHash(body), observed.ContentSHA256)
+		require.Equal(t, owner, observed.OwnerObjectID)
+		source, err := base64.StdEncoding.Strict().DecodeString(observed.SpecBase64)
+		require.NoError(t, err)
+		require.Equal(t, base64.StdEncoding.EncodeToString(source), observed.SpecBase64)
+		require.Equal(t, inlineHTTPHash(source), observed.SpecSHA256)
+		var spec space.MigrationInlineFileSpec
+		require.NoError(t, json.Unmarshal(source, &spec))
+		require.Equal(t, owner, spec.OwnerObjectID)
+		require.Equal(t, name, spec.Name)
+		require.Equal(t, mime, spec.Mime)
+		require.Equal(t, body, spec.Content)
+		require.Equal(t, observed.ContentSHA256, spec.ContentSHA256)
+		current, err := native.MigrationInlineFileStatus(ctx, observed.IntentID)
+		require.NoError(t, err)
+		require.Equal(t, "complete", current.Stage)
+		require.Equal(t, "committed", current.Outcome)
+		require.Equal(t, capability.AccountID, current.AccountID)
+		require.Equal(t, capability.SpaceID, current.SpaceID)
+		require.Equal(t, capability.StoreID, current.StoreID)
+		require.Equal(t, owner, current.OwnerObjectID)
+		require.Equal(t, observed.ObjectID, current.ObjectID)
+		require.Equal(t, observed.ChangeID, current.ChangeID)
+		require.Equal(t, observed.FileID, current.FileID)
+		require.Equal(t, []string{observed.FileID}, current.RecordIDs)
+		require.Equal(t, observed.Fingerprint, current.Fingerprint)
+		require.Equal(t, observed.SpecSHA256, current.SpecSHA256)
+		require.Equal(t, observed.ContentSHA256, current.ContentSHA256)
+		require.Equal(t, observed.Size, current.Size)
+		info, err := sp.Files().Get(ctx, observed.FileID)
+		require.NoError(t, err)
+		require.Equal(t, name, info.Name)
+		require.Equal(t, mime, info.Mime)
+		require.Equal(t, int64(size), info.Size)
+		reader, err := sp.Files().Open(ctx, observed.FileID, "")
+		require.NoError(t, err)
+		content, err := io.ReadAll(reader)
+		require.NoError(t, err)
+		require.NoError(t, reader.Close())
+		require.Equal(t, body, content)
+		require.Equal(t, observed.ContentSHA256, inlineHTTPHash(content))
+	}
+	seen := make(map[string]bool)
+	for len(seen) < 2 {
+		select {
+		case event := <-events:
+			observed, exists := expected[event.status.FileId]
+			require.True(t, exists, "unrequested file status was published")
+			require.False(t, seen[event.status.FileId], "retry published an extra local transition")
+			seen[event.status.FileId] = true
+			require.NoError(t, event.err, "callback must read original committed file bytes")
+			require.Equal(t, owner, event.status.ObjectId)
+			require.Equal(t, space.FileStateDurable, event.status.State)
+			require.True(t, event.status.Cached)
+			require.Equal(t, observed.ContentSHA256, inlineHTTPHash(event.content))
+		case <-time.After(5 * time.Second):
+			t.Fatal("missing durable local status event for a real Swift-created native file")
+		}
+	}
+	inlineHTTPNoEvent(t, events)
+	t.Log("verified two real Swift-created native files, exact source specifications, plaintext streams and two local durable status events")
+}
