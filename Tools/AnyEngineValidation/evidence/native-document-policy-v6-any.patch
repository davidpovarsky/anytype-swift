+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/any/internal/api"
+	"github.com/anyproto/any/internal/config"
+)
+
+func gatewayRequest(e http.Handler, method, path, body, token string) *httptest.ResponseRecorder {
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	if token != "" {
+		req.Header.Set(api.ControlTokenHeader, token)
+	}
+	res := httptest.NewRecorder()
+	e.ServeHTTP(res, req)
+	return res
+}
+
+// Run both normally and with -tags mobile. The mobile build verifies the
+// actual router middleware against an authorized native account and data; the
+// desktop build verifies unchanged ordinary loopback behavior.
+func TestPinkhaMobileManagedGateway(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	d.cfg.Mode = config.ModeManaged
+	d.controlToken = strings.Repeat("a", 64)
+	e := buildEcho(d)
+	for _, route := range []struct{ method, path, body string }{
+		{"GET", "/v1/health", ""}, {"GET", "/v1/auth", ""}, {"GET", "/v1/spaces", ""},
+		{"POST", "/v1/spaces", "{\"name\":\"must not be created without token\"}"},
+		{"POST", "/v1/spaces/disposable/query", "{}"}, {"POST", "/v1/spaces/disposable/query/subscribe", "{}"},
+		{"GET", "/v1/spaces/disposable/pinkha/claims/subscribe", ""},
+		{"GET", "/v1/spaces/disposable/pinkha/objects/document/claims/subscribe", ""},
+		{"GET", "/v1/spaces/disposable/files/file/content", ""}, {"GET", "/v1/pinkha/capabilities", ""},
+	} {
+		if !pinkhaMobileBuild && route.method != "GET" {
+			continue
+		}
+		for _, token := range []string{"", strings.Repeat("b", 64)} {
+			res := gatewayRequest(e, route.method, route.path, route.body, token)
+			if pinkhaMobileBuild && res.Code != http.StatusForbidden {
+				t.Fatalf("mobile request bypassed token gate: %s %s status=%d", route.method, route.path, res.Code)
+			}
+			if !pinkhaMobileBuild && route.path == "/v1/spaces" && res.Code != http.StatusOK {
+				t.Fatalf("desktop data behavior changed: %d", res.Code)
+			}
+		}
+	}
+	for _, path := range []string{"/v1/health", "/v1/auth", "/v1/spaces", "/v1/pinkha/capabilities"} {
+		if res := gatewayRequest(e, "GET", path, "", d.controlToken); res.Code != http.StatusOK {
+			t.Fatalf("host token not accepted: %s status=%d", path, res.Code)
+		}
+	}
+	if pinkhaMobileBuild {
+		if d.pinkhaMobileManagedGatewayVersion() != 1 {
+			t.Fatal("mobile capability missing")
+		}
+		d.controlToken = ""
+		if res := gatewayRequest(e, "GET", "/v1/spaces", "", ""); res.Code != http.StatusForbidden {
+			t.Fatal("empty managed token failed open")
+		}
+	} else if d.pinkhaMobileManagedGatewayVersion() != 0 {
+		t.Fatal("desktop incorrectly advertises mobile boundary")
+	}
+}
+
+func TestPinkhaMobileGatewayPreservesStandalone(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	if d.cfg.Managed() {
+		t.Fatal("fixture unexpectedly managed")
+	}
+	if d.pinkhaMobileManagedGatewayVersion() != 0 {
+		t.Fatal("standalone advertises managed token boundary")
+	}
+	if res := gatewayRequest(buildEcho(d), "GET", "/v1/spaces", "", ""); res.Code != http.StatusOK {
+		t.Fatalf("standalone behavior changed: %d", res.Code)
+	}
+}
