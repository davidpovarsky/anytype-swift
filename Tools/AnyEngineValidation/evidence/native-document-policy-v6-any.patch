@@ -0,0 +1,31 @@
+package server
+
+import (
+	"errors"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/valyala/fastjson"
+	"testing"
+)
+
+func TestPinkhaDescriptorCallbackUsesLatestLockedDefinition(t *testing.T) {
+	patch := map[string]any{"field": fastjson.MustParse(`"plain text"`)}
+	before := []space.PropertyDef{{Id: "field", XFormat: map[string]any{"type": "text"}}}
+	if err := pinkhaValidatePropertyDescriptors(before, patch); err != nil {
+		t.Fatal(err)
+	}
+	// A concurrent descriptor change makes the original value invalid while
+	// kind stays string. The callback must use the locked current definition.
+	after := []space.PropertyDef{{Id: "field", XFormat: map[string]any{"type": "url"}}}
+	err := pinkhaValidatePropertyDescriptors(after, patch)
+	var violation *pinkhaPropertyDescriptorError
+	if !errors.As(err, &violation) || violation.violation.PropId != "field" {
+		t.Fatalf("latest descriptor was not enforced: %v", err)
+	}
+	if err := pinkhaValidatePropertyDescriptors(after,
+		map[string]any{"field": fastjson.MustParse(`"https://example.invalid/source"`)}); err != nil {
+		t.Fatalf("valid value refused: %v", err)
+	}
+	if err := pinkhaValidatePropertyDescriptors(after, map[string]any{"field": nil}); err != nil {
+		t.Fatalf("explicit unset refused: %v", err)
+	}
+}
