new file mode 100644
index 0000000..c5185c3
--- /dev/null
+++ b/internal/server/pinkha_presentation.go
@@ -0,0 +1,65 @@
+package server
+
+import (
+	"encoding/json"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/anyproto/any/internal/pinkha/claims"
+	"github.com/valyala/fastjson"
+)
+
+// Called by the dedicated property route's final native validation callback.
+// Bounds are enforced without parsing key grammar: future opaque versioned keys
+// must survive a Hide/Show mutation of an unrelated known property.
+func validatePinkhaPresentationPatch(ownerID string, patch map[string]any) *descriptorViolation {
+	if ownerID != claims.PropertyPresentationCollection {
+		return nil
+	}
+	raw, present := patch[claims.PropertyPresentationHiddenProperty]
+	if !present || raw == nil {
+		return nil
+	}
+	fail := func(reason string) *descriptorViolation {
+		return &descriptorViolation{PropId: claims.PropertyPresentationHiddenProperty, Slug: claims.PropertyPresentationFormat, Reason: reason}
+	}
+	var value *fastjson.Value
+	if v, ok := raw.(*fastjson.Value); ok {
+		value = v
+	} else {
+		encoded, err := json.Marshal(raw)
+		if err != nil {
+			return fail("visibility value must be a JSON string array")
+		}
+		v, err := fastjson.ParseBytes(encoded)
+		if err != nil {
+			return fail("visibility value must be a JSON string array")
+		}
+		value = v
+	}
+	if value == nil || value.Type() == fastjson.TypeNull {
+		return nil
+	}
+	if value.Type() != fastjson.TypeArray {
+		return fail("visibility value must be a string array")
+	}
+	values := value.GetArray()
+	if len(values) > claims.PropertyPresentationMaxKeys {
+		return fail("too many visibility keys")
+	}
+	seen := map[string]bool{}
+	for _, item := range values {
+		if item.Type() != fastjson.TypeString {
+			return fail("visibility keys must be strings")
+		}
+		key := string(item.GetStringBytes())
+		if len(key) < 1 || len(key) > claims.PropertyPresentationMaxKeyBytes || !utf8.ValidString(key) || strings.ContainsRune(key, 0) {
+			return fail("visibility key exceeds its byte or encoding bound")
+		}
+		if seen[key] {
+			return fail("visibility keys must be unique")
+		}
+		seen[key] = true
+	}
+	return nil
+}
