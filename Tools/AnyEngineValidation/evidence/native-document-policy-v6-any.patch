+package server
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/anyproto/any/internal/api"
+)
+
+func TestPinkhaBlockCASRetainsIdentityAndRefusesStaleState(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sid, oid := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + sid + "/objects/" + oid
+	path := base + "/editor/editor_blocks"
+	parent := blocksCreate(t, e, base, `{"type":"paragraph","text":"שלום","style":{"future":{"keep":true},"pinkhaWritingDirection":"rightToLeft"}}`)
+	child := blocksCreate(t, e, base, fmt.Sprintf(`{"type":"paragraph","text":"child","nav":{"parentId":%q}}`, parent.Id))
+	before := getMarkdownDoc(t, e, path+"/markdown")
+	request := api.BlockPatchRequest{Set: map[string]json.RawMessage{"text": json.RawMessage(`"שלום חדש"`),
+		"style.pinkhaTextAlignment": json.RawMessage(`"right"`)},
+		IfVersion: before.Version, IfStartedAt: d.startedAt.Format(time.RFC3339Nano)}
+	raw, _ := json.Marshal(request)
+	res := doJSON(t, e, http.MethodPatch, path+"/blocks/"+parent.Id, string(raw))
+	if res.Code != http.StatusOK {
+		t.Fatalf("conditional patch: %d %s", res.Code, res.Body.String())
+	}
+	var receipt api.BlockConditionalPatchResponse
+	if err := json.Unmarshal(res.Body.Bytes(), &receipt); err != nil {
+		t.Fatal(err)
+	}
+	if receipt.VersionId == "" || receipt.EditorVersion == "" ||
+		receipt.EditorVersion == before.Version || len(receipt.RecordIds) != 1 || receipt.RecordIds[0] != parent.Id {
+		t.Fatalf("missing exact native receipt: %+v", receipt)
+	}
+	rows := blocksList(t, e, base).Records
+	if len(rows) != 2 {
+		t.Fatalf("block identity loss: %+v", rows)
+	}
+	for _, b := range rows {
+		if b.Id == parent.Id && (b.Text != "שלום חדש" || b.Style["future"] == nil ||
+			b.Style["pinkhaWritingDirection"] != "rightToLeft" || b.Style["pinkhaTextAlignment"] != "right") {
+			t.Fatalf("patch lost block data: %+v", b)
+		}
+		if b.Id == child.Id && b.Nav.ParentId != parent.Id {
+			t.Fatal("child detached")
+		}
+	}
+	current := getMarkdownDoc(t, e, path+"/markdown")
+	stale := doJSON(t, e, http.MethodPatch, path+"/blocks/"+parent.Id, string(raw))
+	if stale.Code != http.StatusConflict {
+		t.Fatalf("stale patch: %d %s", stale.Code, stale.Body.String())
+	}
+	if after := getMarkdownDoc(t, e, path+"/markdown"); after != current {
+		t.Fatal("stale patch wrote")
+	}
+}
+
+func TestPinkhaBlockCASEngineRunAndWholePatchPreflight(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sid, oid := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + sid + "/objects/" + oid
+	path := base + "/editor/editor_blocks"
+	b := blocksCreate(t, e, base, `{"type":"paragraph","text":"original","style":{"keep":true}}`)
+	doc := getMarkdownDoc(t, e, path+"/markdown")
+	cases := []struct {
+		name             string
+		set              map[string]json.RawMessage
+		unset            []string
+		version, started string
+		code             int
+	}{
+		{"different run", map[string]json.RawMessage{"text": json.RawMessage(`"bad"`)}, nil,
+			doc.Version, "2000-01-01T00:00:00Z", http.StatusConflict},
+		{"missing run", map[string]json.RawMessage{"text": json.RawMessage(`"bad"`)}, nil,
+			doc.Version, "", http.StatusBadRequest},
+		{"missing version", map[string]json.RawMessage{"text": json.RawMessage(`"bad"`)}, nil,
+			"", d.startedAt.Format(time.RFC3339Nano), http.StatusBadRequest},
+		{"mixed valid invalid", map[string]json.RawMessage{"text": json.RawMessage(`"bad"`), "id": json.RawMessage(`"forged"`)}, nil,
+			doc.Version, d.startedAt.Format(time.RFC3339Nano), http.StatusBadRequest},
+		{"overlapping paths", map[string]json.RawMessage{"style": json.RawMessage(`{}`), "style.keep": json.RawMessage(`false`)}, nil,
+			doc.Version, d.startedAt.Format(time.RFC3339Nano), http.StatusBadRequest},
+		{"set unset same path", map[string]json.RawMessage{"text": json.RawMessage(`"bad"`)}, []string{"text"},
+			doc.Version, d.startedAt.Format(time.RFC3339Nano), http.StatusBadRequest},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			raw, _ := json.Marshal(api.BlockPatchRequest{Set: tc.set, Unset: tc.unset, IfVersion: tc.version, IfStartedAt: tc.started})
+			res := doJSON(t, e, http.MethodPatch, path+"/blocks/"+b.Id, string(raw))
+			if res.Code != tc.code {
+				t.Fatalf("status %d, want %d: %s", res.Code, tc.code, res.Body.String())
+			}
+			if after := getMarkdownDoc(t, e, path+"/markdown"); after != doc {
+				t.Fatal("refused patch changed native state")
+			}
+		})
+	}
+}
+
+func TestPinkhaBlockCASConcurrentEditsHaveOneWinner(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sid, oid := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + sid + "/objects/" + oid
+	path := base + "/editor/editor_blocks"
+	b := blocksCreate(t, e, base, `{"type":"paragraph","text":"original"}`)
+	doc := getMarkdownDoc(t, e, path+"/markdown")
+	const count = 4
+	codes := make(chan int, count)
+	for i := range count {
+		go func() {
+			raw, _ := json.Marshal(api.BlockPatchRequest{
+				Set:       map[string]json.RawMessage{"text": json.RawMessage(fmt.Sprintf("%q", fmt.Sprintf("writer %d", i)))},
+				IfVersion: doc.Version, IfStartedAt: d.startedAt.Format(time.RFC3339Nano)})
+			codes <- doJSON(t, e, http.MethodPatch, path+"/blocks/"+b.Id, string(raw)).Code
+		}()
+	}
+	successes, conflicts := 0, 0
+	for range count {
+		switch code := <-codes; code {
+		case http.StatusOK:
+			successes++
+		case http.StatusConflict:
+			conflicts++
+		default:
+			t.Errorf("unexpected status %d", code)
+		}
+	}
+	if successes != 1 || conflicts != count-1 {
+		t.Fatalf("writes=%d conflicts=%d", successes, conflicts)
+	}
+	rows := blocksList(t, e, base).Records
+	if len(rows) != 1 || rows[0].Id != b.Id {
+		t.Fatal("concurrent edits recreated the block")
+	}
+}
+
+func TestPinkhaBlockCASIncludesUnrenderedAndDeletedChildren(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sid, oid := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + sid + "/objects/" + oid
+	path := base + "/editor/editor_blocks"
+	parent := blocksCreate(t, e, base, `{"type":"paragraph","text":"parent"}`)
+	child := blocksCreate(t, e, base, fmt.Sprintf(`{"type":"paragraph","text":"child","nav":{"parentId":%q}}`, parent.Id))
+	before := getMarkdownDoc(t, e, path+"/markdown")
+	res := doJSON(t, e, http.MethodDelete, path+"/blocks/"+child.Id, "")
+	if res.Code != http.StatusOK {
+		t.Fatalf("delete child: %d", res.Code)
+	}
+	raw, _ := json.Marshal(api.BlockPatchRequest{Set: map[string]json.RawMessage{"text": json.RawMessage(`"overwrite"`)},
+		IfVersion: before.Version, IfStartedAt: d.startedAt.Format(time.RFC3339Nano)})
+	res = doJSON(t, e, http.MethodPatch, path+"/blocks/"+parent.Id, string(raw))
+	if res.Code != http.StatusConflict {
+		t.Fatalf("deleted nested block did not invalidate patch: %d %s", res.Code, res.Body.String())
+	}
+	after := getMarkdownDoc(t, e, path+"/markdown")
+	if after.Content != before.Content || after.Version == before.Version {
+		t.Fatal("nested delete version proof failed")
+	}
+}
+
+func TestPinkhaBlockCASNoopAndLegacyPatch(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sid, oid := setupBlocksFixture(t, e)
+	base := "/v1/spaces/" + sid + "/objects/" + oid
+	path := base + "/editor/editor_blocks"
+	b := blocksCreate(t, e, base, `{"type":"paragraph","text":"original"}`)
+	before := getMarkdownDoc(t, e, path+"/markdown")
+	raw, _ := json.Marshal(api.BlockPatchRequest{IfVersion: before.Version, IfStartedAt: d.startedAt.Format(time.RFC3339Nano)})
+	res := doJSON(t, e, http.MethodPatch, path+"/blocks/"+b.Id, string(raw))
+	if res.Code != http.StatusOK {
+		t.Fatalf("noop: %d %s", res.Code, res.Body.String())
+	}
+	var receipt api.BlockConditionalPatchResponse
+	if err := json.Unmarshal(res.Body.Bytes(), &receipt); err != nil {
+		t.Fatal(err)
+	}
+	if receipt.VersionId != "" || receipt.EditorVersion != before.Version {
+		t.Fatalf("noop receipt: %+v", receipt)
+	}
+	res = doJSON(t, e, http.MethodPatch, path+"/blocks/"+b.Id, `{"set":{"text":"legacy client"}}`)
+	if res.Code != http.StatusOK {
+		t.Fatalf("legacy patch changed: %d %s", res.Code, res.Body.String())
+	}
+}
