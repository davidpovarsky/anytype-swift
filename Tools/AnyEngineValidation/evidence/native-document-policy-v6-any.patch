+++ b/internal/pinkha/claims/presentation.go
@@ -0,0 +1,17 @@
+package claims
+
+import "github.com/anyproto/any-sync-sdk/handler"
+
+const (
+	PropertyPresentationCollection     = "pinkha_presentation_v1"
+	PropertyPresentationHiddenProperty = "hiddenProperties"
+	PropertyPresentationMaxKeys        = 512
+	PropertyPresentationMaxKeyBytes    = 4096
+	PropertyPresentationFormat         = "pinkha-property-visibility-v1"
+)
+
+// Visibility stores exact opaque presentation keys, never another copy of
+// canonical values or derived Torah properties. Hiding preserves those values.
+func NewPresentationCollection() handler.Collection {
+	return handler.Collection{Id: PropertyPresentationCollection, Name: "Property presentation", Hidden: true, Properties: []handler.PropertyDecl{{Id: PropertyPresentationHiddenProperty, Name: "Hidden properties", Kind: handler.PropertyKindArray, Scope: handler.ScopeSynced, XFormat: map[string]any{"type": PropertyPresentationFormat}}}}
+}
diff --git a/internal/pinkha/claims/read.go b/internal/pinkha/claims/read.go
new file mode 100644
index 0000000..8d088cd
--- /dev/null
+++ b/internal/pinkha/claims/read.go
@@ -0,0 +1,246 @@
+package claims
+
+import (
+	"context"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+// TargetSnapshot is rebuilt from signed immutable claims and native target
+// state. It is not a second association store or a client-maintained cache.
+type TargetSnapshot struct {
+	Contract  string             `json:"contract"`
+	Target    Target             `json:"target"`
+	Operation Projection         `json:"operations"`
+	Semantic  SemanticProjection `json:"semantic"`
+	Readiness Readiness          `json:"readiness"`
+}
+
+func readTarget(view handler.LocalReadView, rootID string, target Target, limit int) (Projection, error) {
+	rows, err := view.Query(rootID, Dataset, map[string]any{"targetObjectId": target.ObjectID, "targetBlockId": target.BlockID}, limit+1)
+	if err != nil {
+		return Projection{}, err
+	}
+	if len(rows) > limit {
+		return Projection{}, ErrReadLimit
+	}
+	seen := map[string]bool{}
+	complete := []Claim{}
+	for _, row := range rows {
+		c, err := ClaimFromStored(row)
+		if err != nil {
+			return Projection{}, err
+		}
+		key := operationKey(c.Operation.SpaceID, c.Operation.OperationID)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		variants, err := view.Query(rootID, Dataset, map[string]any{"logicalKey": key}, MaxVariants+1)
+		if err != nil {
+			return Projection{}, err
+		}
+		if len(variants) > MaxVariants {
+			return Projection{}, ErrReadLimit
+		}
+		for _, v := range variants {
+			c, err := ClaimFromStored(v)
+			if err != nil {
+				return Projection{}, err
+			}
+			complete = append(complete, c)
+		}
+	}
+	return Fold(target, complete), nil
+}
+
+func nativeTargetRow(view handler.NativeReadView, spaceID string, target Target) (*anyenc.Value, error) {
+	row, err := nativeTargetRowForDiscovery(view, spaceID, target)
+	if err != nil {
+		return nil, err
+	}
+	if err := validateDocumentType(view, row.GetString("any", "type")); err != nil {
+		return nil, err
+	}
+	return row, nil
+}
+
+// Only the first discovery pass uses this metadata-only filter. No result is
+// published until the second pass holds each target/type and validates policy.
+func nativeTargetRowForDiscovery(view handler.NativeReadView, spaceID string, target Target) (*anyenc.Value, error) {
+	rows, err := view.SpaceObjects(map[string]any{"id": target.ObjectID}, 2)
+	if err != nil {
+		return nil, err
+	}
+	if len(rows) != 1 {
+		return nil, reject("native target unavailable")
+	}
+	if err := validateTargetRow(spaceID, target, rows[0]); err != nil {
+		return nil, err
+	}
+	return rows[0], nil
+}
+
+func ReadTarget(ctx context.Context, sp space.Space, rootID string, target Target, limit int) (TargetSnapshot, error) {
+	if !validText(target.ObjectID, true, 1024) || !validText(target.BlockID, false, 1024) || limit < 1 || limit > 10000 {
+		return TargetSnapshot{}, ErrInvalid
+	}
+	result := TargetSnapshot{Contract: ContractID, Target: target}
+	dependencies := []string{rootID, target.ObjectID}
+	err := space.NativeReadSnapshot(ctx, sp, dependencies, func(view handler.NativeReadView) error {
+		row, err := nativeTargetRow(view, sp.Id(), target)
+		if err != nil {
+			return err
+		}
+		if target.BlockID != "" {
+			if err := validateTarget(sp.Id(), target, view); err != nil {
+				return err
+			}
+		}
+		p, err := readTarget(view, rootID, target, limit)
+		if err != nil {
+			return err
+		}
+		result.Operation = p
+		result.Semantic = SemanticFold(p)
+		result.Readiness = readiness(view, result.Semantic.Coverage, row.String())
+		return nil
+	})
+	return result, err
+}
+
+type SourceResult struct {
+	Contract                 string    `json:"contract"`
+	Field                    string    `json:"field"`
+	Identity                 string    `json:"identity"`
+	ObjectIDs                []string  `json:"objectIds"`
+	ConflictedObjectIDs      []string  `json:"conflictedObjectIds"`
+	Coverage                 string    `json:"coverage"`
+	UnsupportedClaimsPresent bool      `json:"unsupportedClaimsPresent"`
+	Readiness                Readiness `json:"readiness"`
+}
+
+// FindSource uses native per-claim indexes to find candidates, then expands
+// only their target/operation groups in the same ACL-fenced SQLite snapshot.
+// All candidate native target trees are held during the final read so a native
+// deletion cannot be mistaken for a still-live projection row.
+// A Space may hold arbitrarily many unrelated claims; bounds apply to matches
+// and each target, never silently truncate the Space or return a partial page.
+func FindSource(ctx context.Context, sp space.Space, rootID, field, identity string, limit int) (SourceResult, error) {
+	if field != SourcesIndexKey && field != TopicsIndexKey && field != WordsIndexKey {
+		return SourceResult{}, ErrInvalid
+	}
+	if !validText(identity, true, 4096) || limit < 1 || limit > 1000 {
+		return SourceResult{}, ErrInvalid
+	}
+	out := SourceResult{Contract: ContractID, Field: field, Identity: identity, ObjectIDs: []string{}, ConflictedObjectIDs: []string{}, Coverage: "complete"}
+	dependencies := []string{rootID}
+	declared := map[string]bool{rootID: true}
+	err := space.NativeReadSnapshot(ctx, sp, []string{rootID}, func(view handler.NativeReadView) error {
+		rows, err := view.Query(rootID, Dataset, map[string]any{field: identity}, 10001)
+		if err != nil {
+			return err
+		}
+		if len(rows) > 10000 {
+			return ErrReadLimit
+		}
+		for _, row := range rows {
+			c, err := ClaimFromStored(row)
+			if err != nil {
+				return err
+			}
+			target := c.Operation.Target
+			if target.BlockID != "" || declared[target.ObjectID] {
+				continue
+			}
+			if _, err := nativeTargetRowForDiscovery(view, sp.Id(), target); errors.Is(err, handler.ErrValidation) {
+				continue
+			} else if err != nil {
+				return err
+			}
+			if len(dependencies) > limit {
+				return ErrReadLimit
+			}
+			declared[target.ObjectID] = true
+			dependencies = append(dependencies, target.ObjectID)
+		}
+		return nil
+	})
+	if err != nil {
+		return SourceResult{}, err
+	}
+	err = space.NativeReadSnapshot(ctx, sp, dependencies, func(view handler.NativeReadView) error {
+		unknown, err := view.Query(rootID, Dataset, map[string]any{SemanticStatusKey: map[string]any{"$in": []string{"unsupported-opaque", "invalid-semantic-payload"}}}, 1)
+		if err != nil {
+			return err
+		}
+		out.UnsupportedClaimsPresent = len(unknown) > 0
+		if out.UnsupportedClaimsPresent {
+			out.Coverage = "incomplete-unsupported-payload"
+		}
+		candidates, err := view.Query(rootID, Dataset, map[string]any{field: identity}, 10001)
+		if err != nil {
+			return err
+		}
+		if len(candidates) > 10000 {
+			return ErrReadLimit
+		}
+		seen := map[string]bool{}
+		inputRows := map[string]string{}
+		for _, row := range candidates {
+			c, err := ClaimFromStored(row)
+			if err != nil {
+				return err
+			}
+			target := c.Operation.Target
+			if target.BlockID != "" || seen[target.ObjectID] {
+				continue
+			}
+			seen[target.ObjectID] = true
+			if len(seen) > limit {
+				return ErrReadLimit
+			}
+			targetRow, err := nativeTargetRow(view, sp.Id(), target)
+			if errors.Is(err, handler.ErrValidation) {
+				inputRows[target.ObjectID] = "ineligible"
+				continue
+			}
+			if err != nil {
+				return err
+			}
+			if !declared[target.ObjectID] {
+				return ErrSnapshotChanged
+			}
+			inputRows[target.ObjectID] = targetRow.String()
+			p, err := readTarget(view, rootID, target, 10000)
+			if err != nil {
+				return err
+			}
+			s := SemanticFold(p)
+			if len(p.Conflicts) > 0 || len(p.PendingObserved) > 0 || len(s.ConflictingClaimIDs) > 0 {
+				out.ConflictedObjectIDs = append(out.ConflictedObjectIDs, target.ObjectID)
+				out.Coverage = "incomplete-conflict-or-pending"
+				continue
+			}
+			values := s.Sources
+			if field == TopicsIndexKey {
+				values = s.Topics
+			}
+			if field == WordsIndexKey {
+				values = s.Words
+			}
+			if slices.Contains(values, identity) {
+				out.ObjectIDs = append(out.ObjectIDs, target.ObjectID)
+			}
+		}
+		out.Readiness = readiness(view, out.Coverage, inputRows)
+		return nil
+	})
+	slices.Sort(out.ObjectIDs)
+	slices.Sort(out.ConflictedObjectIDs)
+	return out, err
+}
diff --git a/internal/pinkha/claims/record.go b/internal/pinkha/claims/record.go
new file mode 100644
index 0000000..0acc680
--- /dev/null
+++ b/internal/pinkha/claims/record.go
@@ -0,0 +1,152 @@
+package claims
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"io"
+	"slices"
+	"strings"
+)
+
+// Record is the closed, flat Any dataset wire format. Creator is not accepted
+// from a caller: the native apply handler derives it from the signed envelope.
+type Record struct {
+	Version        uint32   `json:"version"`
+	OperationID    string   `json:"operationId"`
+	SpaceID        string   `json:"spaceId"`
+	AuthorID       string   `json:"authorId"`
+	Kind           Kind     `json:"kind"`
+	TargetObjectID string   `json:"targetObjectId"`
+	TargetBlockID  string   `json:"targetBlockId"`
+	ProviderID     string   `json:"providerId"`
+	CanonicalRef   string   `json:"canonicalRef"`
+	Payload        string   `json:"payload"`
+	Observed       []string `json:"observed"`
+	LogicalKey     string   `json:"logicalKey"`
+	ContentHash    string   `json:"contentHash"`
+}
+
+// RecordID is Any's slash-free spelling of the existing physical claim ID.
+func (c Claim) RecordID() string { return strings.ReplaceAll(c.ID, "/", "") }
+
+func Make(op Operation) (Claim, error) {
+	c, _, err := makeClaim(op)
+	return c, err
+}
+
+func EncodeRecord(c Claim) Record {
+	op := c.Operation
+	return Record{Version: op.Version, OperationID: op.OperationID,
+		SpaceID: op.SpaceID, AuthorID: op.AuthorID, Kind: op.Kind,
+		TargetObjectID: op.Target.ObjectID, TargetBlockID: op.Target.BlockID,
+		ProviderID: op.Source.ProviderID, CanonicalRef: op.Source.CanonicalRef,
+		Payload:  base64.StdEncoding.EncodeToString(op.Payload),
+		Observed: normalizedObserved(op.Observed), LogicalKey: operationKey(op.SpaceID, op.OperationID),
+		ContentHash: c.Digest}
+}
+
+func DecodeRecord(id string, raw []byte) (Claim, error) {
+	if len(raw) > MaxWireBytes || !validHex(id, 64) {
+		return Claim{}, ErrInvalid
+	}
+	var r Record
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&r); err != nil {
+		return Claim{}, errors.Join(ErrInvalid, err)
+	}
+	var trailing any
+	if d.Decode(&trailing) != io.EOF {
+		return Claim{}, ErrInvalid
+	}
+	return r.Claim(id)
+}
+
+func (r Record) Claim(id string) (Claim, error) {
+	payload, err := base64.StdEncoding.DecodeString(r.Payload)
+	if err != nil || r.Observed == nil || base64.StdEncoding.EncodeToString(payload) != r.Payload ||
+		!slices.Equal(r.Observed, normalizedObserved(r.Observed)) {
+		return Claim{}, ErrInvalid
+	}
+	c, err := Make(Operation{Version: r.Version, SpaceID: r.SpaceID,
+		OperationID: r.OperationID, AuthorID: r.AuthorID, Kind: r.Kind,
+		Target:  Target{ObjectID: r.TargetObjectID, BlockID: r.TargetBlockID},
+		Source:  Source{ProviderID: r.ProviderID, CanonicalRef: r.CanonicalRef},
+		Payload: payload, Observed: r.Observed})
+	if err != nil {
+		return Claim{}, err
+	}
+	if c.RecordID() != id || c.Digest != r.ContentHash || operationKey(r.SpaceID, r.OperationID) != r.LogicalKey {
+		return Claim{}, ErrInvalid
+	}
+	return c, nil
+}
+
+// Fold applies the same order-independent semantics as the original store:
+// quarantine every variant of a colliding logical operation BEFORE processing
+// predecessors, then suppress only observed physical IDs at the same target.
+// Callers must supply complete variant sets for every candidate logical key.
+func Fold(target Target, candidates []Claim) Projection {
+	groups := make(map[string][]Claim)
+	seen := make(map[string]bool)
+	for _, c := range candidates {
+		if seen[c.ID] {
+			continue
+		}
+		seen[c.ID] = true
+		key := operationKey(c.Operation.SpaceID, c.Operation.OperationID)
+		groups[key] = append(groups[key], c)
+	}
+	result := Projection{Live: []Claim{}, Conflicts: []Conflict{}, PendingObserved: []string{}}
+	active := make(map[string]Claim)
+	for key, variants := range groups {
+		if len(variants) > 1 {
+			slices.SortFunc(variants, func(a, b Claim) int { return strings.Compare(a.ID, b.ID) })
+			result.Conflicts = append(result.Conflicts, Conflict{LogicalKey: key, Variants: variants})
+			continue
+		}
+		if variants[0].Operation.Target == target {
+			active[variants[0].ID] = variants[0]
+		}
+	}
+	removed, pending := map[string]bool{}, map[string]bool{}
+	for _, c := range active {
+		for _, id := range c.Operation.Observed {
+			if predecessor, ok := active[id]; ok && predecessor.Operation.Target == target {
+				removed[id] = true
+			} else {
+				pending[id] = true
+			}
+		}
+	}
+	for _, c := range active {
+		if c.Operation.Kind != Remove && !removed[c.ID] {
+			result.Live = append(result.Live, c)
+		}
+	}
+	for id := range pending {
+		result.PendingObserved = append(result.PendingObserved, id)
+	}
+	slices.SortFunc(result.Live, func(a, b Claim) int {
+		if x := strings.Compare(a.Operation.OperationID, b.Operation.OperationID); x != 0 {
+			return x
+		}
+		return strings.Compare(a.ID, b.ID)
+	})
+	slices.SortFunc(result.Conflicts, func(a, b Conflict) int { return strings.Compare(a.LogicalKey, b.LogicalKey) })
+	slices.Sort(result.PendingObserved)
+	return result
+}
+
+type Conflict struct {
+	LogicalKey string  `json:"logicalKey"`
+	Variants   []Claim `json:"variants"`
+}
+
+type Projection struct {
+	Live            []Claim    `json:"live"`
+	Conflicts       []Conflict `json:"conflicts"`
+	PendingObserved []string   `json:"pendingObserved"`
+}
diff --git a/internal/pinkha/claims/related.go b/internal/pinkha/claims/related.go
new file mode 100644
index 0000000..3071b5f
--- /dev/null
+++ b/internal/pinkha/claims/related.go
@@ -0,0 +1,194 @@
+package claims
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+var ErrSnapshotChanged = errors.New("native related candidates changed while loading target trees")
+
+type Readiness struct {
+	Version    int    `json:"version"`
+	State      string `json:"state"`
+	Generation string `json:"generation"`
+}
+
+func readiness(view handler.NativeReadView, coverage string, inputs any) Readiness {
+	raw, _ := json.Marshal(struct {
+		Contract string
+		Stamp    handler.NativeReadStamp
+		Inputs   any
+	}{ContractID, view.ReadStamp(), inputs})
+	h := sha256.Sum256(raw)
+	state := "ready-local-snapshot"
+	if coverage != "complete" {
+		state = "incomplete"
+	}
+	return Readiness{Version: 1, State: state, Generation: hex.EncodeToString(h[:])}
+}
+
+type RelatedTarget struct {
+	SpaceID             string   `json:"spaceId"`
+	ObjectID            string   `json:"objectId"`
+	BlockID             string   `json:"blockId,omitempty"`
+	ContextItemIDs      []string `json:"contextItemIds"`
+	SourceQuoteItemIDs  []string `json:"sourceQuoteItemIds"`
+	CanSafelyUnlink     bool     `json:"canSafelyUnlink"`
+	SemanticInputSHA256 string   `json:"semanticInputSHA256"`
+}
+
+type RelatedResult struct {
+	Contract                 string          `json:"contract"`
+	Version                  int             `json:"version"`
+	Identity                 string          `json:"identity"`
+	Coverage                 string          `json:"coverage"`
+	Readiness                Readiness       `json:"readiness"`
+	Targets                  []RelatedTarget `json:"targets"`
+	ConflictingTargets       []Target        `json:"conflictingTargets"`
+	UnsupportedClaimsPresent bool            `json:"unsupportedClaimsPresent"`
+}
+
+func targetKey(t Target) string {
+	return strconv.Itoa(len(t.ObjectID)) + ":" + t.ObjectID + "|" + strconv.Itoa(len(t.BlockID)) + ":" + t.BlockID
+}
+
+func relatedCandidates(view handler.NativeReadView, rootID, identity string, limit int) ([]Target, error) {
+	rows, err := view.Query(rootID, Dataset, map[string]any{RelatedIndexKey: identity}, 10001)
+	if err != nil {
+		return nil, err
+	}
+	if len(rows) > 10000 {
+		return nil, ErrReadLimit
+	}
+	seen := map[string]Target{}
+	for _, row := range rows {
+		c, err := ClaimFromStored(row)
+		if err != nil {
+			return nil, err
+		}
+		seen[targetKey(c.Operation.Target)] = c.Operation.Target
+	}
+	if len(seen) > limit {
+		return nil, ErrReadLimit
+	}
+	out := make([]Target, 0, len(seen))
+	for _, target := range seen {
+		out = append(out, target)
+	}
+	slices.SortFunc(out, func(a, b Target) int { return strings.Compare(targetKey(a), targetKey(b)) })
+	return out, nil
+}
+
+// FindRelated uses a first indexed read only to declare dependency trees. It
+// then repeats all candidate/fold/target checks in one current-ACL snapshot with
+// those trees held. A new candidate appearing in between refuses explicitly;
+// callers retry, and no incomplete candidate list is reported as ready.
+func FindRelated(ctx context.Context, sp space.Space, rootID, identity string, limit int) (RelatedResult, error) {
+	if !validText(identity, true, 4096) || limit < 1 || limit > 1000 {
+		return RelatedResult{}, ErrInvalid
+	}
+	dependencies := []string{rootID}
+	declared := map[string]bool{rootID: true}
+	err := space.NativeReadSnapshot(ctx, sp, []string{rootID}, func(view handler.NativeReadView) error {
+		candidates, err := relatedCandidates(view, rootID, identity, limit)
+		if err != nil {
+			return err
+		}
+		for _, target := range candidates {
+			if _, err := nativeTargetRowForDiscovery(view, sp.Id(), target); errors.Is(err, handler.ErrValidation) {
+				continue
+			} else if err != nil {
+				return err
+			}
+			if !declared[target.ObjectID] {
+				declared[target.ObjectID] = true
+				dependencies = append(dependencies, target.ObjectID)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return RelatedResult{}, err
+	}
+	out := RelatedResult{Contract: ContractID, Version: 1, Identity: identity, Coverage: "complete", Targets: []RelatedTarget{}, ConflictingTargets: []Target{}}
+	err = space.NativeReadSnapshot(ctx, sp, dependencies, func(view handler.NativeReadView) error {
+		unknown, err := view.Query(rootID, Dataset, map[string]any{SemanticStatusKey: map[string]any{"$in": []string{"unsupported-opaque", "invalid-semantic-payload"}}}, 1)
+		if err != nil {
+			return err
+		}
+		out.UnsupportedClaimsPresent = len(unknown) > 0
+		if out.UnsupportedClaimsPresent {
+			out.Coverage = "incomplete-unsupported-payload"
+		}
+		candidates, err := relatedCandidates(view, rootID, identity, limit)
+		if err != nil {
+			return err
+		}
+		inputRows := map[string]string{}
+		for _, target := range candidates {
+			row, err := nativeTargetRow(view, sp.Id(), target)
+			if errors.Is(err, handler.ErrValidation) {
+				inputRows[targetKey(target)] = "ineligible"
+				continue
+			}
+			if err != nil {
+				return err
+			}
+			if !declared[target.ObjectID] {
+				return ErrSnapshotChanged
+			}
+			inputRows[targetKey(target)] = row.String()
+			if err := validateBlockPath(target, view); errors.Is(err, handler.ErrValidation) {
+				inputRows[targetKey(target)] += "|ineligible-block"
+				continue
+			} else if err != nil {
+				return err
+			}
+			p, err := readTarget(view, rootID, target, 10000)
+			if err != nil {
+				return err
+			}
+			semantic := SemanticFold(p)
+			if len(p.Conflicts) > 0 || len(p.PendingObserved) > 0 || len(semantic.ConflictingClaimIDs) > 0 {
+				out.ConflictingTargets = append(out.ConflictingTargets, target)
+				out.Coverage = "incomplete-conflict-or-pending"
+				continue
+			}
+			result := RelatedTarget{SpaceID: sp.Id(), ObjectID: target.ObjectID, BlockID: target.BlockID,
+				ContextItemIDs: []string{}, SourceQuoteItemIDs: []string{}, SemanticInputSHA256: semantic.InputSHA256}
+			for _, c := range p.Live {
+				b, err := bind(c)
+				if err != nil {
+					continue
+				}
+				if b.RelatedIdentity != identity {
+					continue
+				}
+				if b.Role == "context" {
+					result.ContextItemIDs = append(result.ContextItemIDs, b.ItemID)
+				} else if b.Role == "sourceQuote" {
+					result.SourceQuoteItemIDs = append(result.SourceQuoteItemIDs, b.ItemID)
+				}
+			}
+			if len(result.ContextItemIDs)+len(result.SourceQuoteItemIDs) == 0 {
+				continue
+			}
+			slices.Sort(result.ContextItemIDs)
+			slices.Sort(result.SourceQuoteItemIDs)
+			result.CanSafelyUnlink = target.BlockID == "" && len(result.SourceQuoteItemIDs) == 0 && len(result.ContextItemIDs) > 0 && view.CanWrite()
+			out.Targets = append(out.Targets, result)
+		}
+		out.Readiness = readiness(view, out.Coverage, inputRows)
+		return nil
+	})
+	return out, err
+}
diff --git a/internal/pinkha/claims/semantic.go b/internal/pinkha/claims/semantic.go
new file mode 100644
index 0000000..4467bf9
--- /dev/null
+++ b/internal/pinkha/claims/semantic.go
@@ -0,0 +1,135 @@
+package claims
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any/internal/pinkha/derived"
+)
+
+const (
+	SemanticStatusKey = "pinkhaSemanticStatus"
+	SourcesIndexKey   = "pinkhaSources"
+	TopicsIndexKey    = "pinkhaTopics"
+	WordsIndexKey     = "pinkhaWords"
+	RelatedIndexKey   = "pinkhaRelatedSource"
+	SemanticVersion   = 1
+)
+
+func bind(c Claim) (derived.BoundClaim, error) {
+	op := c.Operation
+	return derived.BindClaim(derived.ClaimBinding{SpaceID: op.SpaceID, ObjectID: op.Target.ObjectID,
+		BlockID: op.Target.BlockID, ProviderID: op.Source.ProviderID, CanonicalRef: op.Source.CanonicalRef}, op.Payload)
+}
+
+func SemanticIndex(c Claim) (string, derived.Projection) {
+	empty := derived.Projection{Sources: []string{}, Topics: []string{}, Words: []string{}}
+	if c.Operation.Kind == Remove {
+		return "remove", empty
+	}
+	b, err := bind(c)
+	if errors.Is(err, derived.ErrUnsupported) {
+		return "unsupported-opaque", empty
+	}
+	if err != nil {
+		return "invalid-semantic-payload", empty
+	}
+	if !b.DocumentContext {
+		return "valid-non-document-context", b.Projection
+	}
+	return "valid-document-context", b.Projection
+}
+
+type SemanticProjection struct {
+	Version             int                             `json:"version"`
+	Coverage            string                          `json:"coverage"`
+	InputSHA256         string                          `json:"inputSHA256"`
+	Sources             []string                        `json:"sources"`
+	Topics              []string                        `json:"topics"`
+	Words               []string                        `json:"words"`
+	Labels              map[string]derived.DisplayLabel `json:"labels"`
+	Records             []json.RawMessage               `json:"records"`
+	ConflictingClaimIDs []string                        `json:"conflictingClaimIds"`
+	UnsupportedClaimIDs []string                        `json:"unsupportedClaimIds"`
+}
+
+// SemanticFold runs only after the native operation fold. No two distinct live
+// claims are silently deduplicated by equal payload: repeated context identity
+// is a conflict. The original operation-level exact retry already has one ID.
+func SemanticFold(p Projection) SemanticProjection {
+	out := SemanticProjection{Version: SemanticVersion, Coverage: "complete",
+		Sources: []string{}, Topics: []string{}, Words: []string{},
+		Labels: map[string]derived.DisplayLabel{}, Records: []json.RawMessage{},
+		ConflictingClaimIDs: []string{}, UnsupportedClaimIDs: []string{}}
+	bound := map[string]derived.BoundClaim{}
+	semanticGroups, stableGroups := map[string][]string{}, map[string][]string{}
+	ids := make([]string, 0, len(p.Live))
+	for _, c := range p.Live {
+		ids = append(ids, c.ID)
+		b, err := bind(c)
+		if err != nil {
+			out.UnsupportedClaimIDs = append(out.UnsupportedClaimIDs, c.ID)
+			continue
+		}
+		bound[c.ID] = b
+		out.Records = append(out.Records, b.Record)
+		semanticGroups[b.SemanticIdentity] = append(semanticGroups[b.SemanticIdentity], c.ID)
+		stableGroups[b.StableID] = append(stableGroups[b.StableID], c.ID)
+	}
+	conflicted := map[string]bool{}
+	for _, group := range semanticGroups {
+		if len(group) > 1 {
+			for _, id := range group {
+				conflicted[id] = true
+			}
+		}
+	}
+	for _, group := range stableGroups {
+		identities := map[string]bool{}
+		for _, id := range group {
+			identities[bound[id].SemanticIdentity] = true
+		}
+		if len(identities) > 1 {
+			for _, id := range group {
+				conflicted[id] = true
+			}
+		}
+	}
+	for id, b := range bound {
+		if conflicted[id] {
+			continue
+		}
+		out.Sources = append(out.Sources, b.Projection.Sources...)
+		out.Topics = append(out.Topics, b.Projection.Topics...)
+		out.Words = append(out.Words, b.Projection.Words...)
+		for key, label := range b.Projection.Labels {
+			out.Labels[key] = label
+		}
+	}
+	for id := range conflicted {
+		out.ConflictingClaimIDs = append(out.ConflictingClaimIDs, id)
+	}
+	for _, values := range [][]string{out.Sources, out.Topics, out.Words, out.ConflictingClaimIDs, out.UnsupportedClaimIDs, ids} {
+		slices.Sort(values)
+	}
+	if len(out.UnsupportedClaimIDs) > 0 {
+		out.Coverage = "incomplete-unsupported-payload"
+	}
+	if len(out.ConflictingClaimIDs) > 0 || len(p.Conflicts) > 0 || len(p.PendingObserved) > 0 {
+		out.Coverage = "incomplete-conflict-or-pending"
+	}
+	// This hash is explicitly over the native live IDs + conflict/pending sets,
+	// not a claim that the original old canonical document blob was rewritten.
+	raw, _ := json.Marshal(struct {
+		Version   int
+		Live      []string
+		Conflicts []Conflict
+		Pending   []string
+	}{SemanticVersion, ids, p.Conflicts, p.PendingObserved})
+	h := sha256.Sum256(raw)
+	out.InputSHA256 = hex.EncodeToString(h[:])
+	return out
+}
diff --git a/internal/pinkha/claims/semantic_test.go b/internal/pinkha/claims/semantic_test.go
new file mode 100644
index 0000000..b59577b
--- /dev/null
+++ b/internal/pinkha/claims/semantic_test.go
@@ -0,0 +1,108 @@
+package claims
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/anyproto/any/internal/pinkha/derived"
+	"github.com/stretchr/testify/require"
+)
+
+func semanticClaim(t *testing.T, n int, kind, role, block, id, ref string) Claim {
+	t.Helper()
+	record := map[string]any{"spaceId": "disposable-space", "objectId": "disposable-document",
+		"item":              map[string]any{"id": id, "kind": kind, "role": role, "providerID": "sefaria", "canonicalKey": ref, "externalID": ref, "labelHe": "מקור", "futureItemField": map[string]any{"kept": true}},
+		"futureRecordField": 17}
+	if block != "" {
+		record["blockId"] = block
+	}
+	raw, err := json.Marshal(map[string]any{"version": 2, "records": []any{record}, "futureEnvelopeField": "preserved"})
+	require.NoError(t, err)
+	op := fixtureOperation(n, string(raw))
+	op.Target.BlockID = block
+	op.Source.CanonicalRef = ref
+	return fixtureClaim(t, op)
+}
+
+func TestNativeSemanticBindingPreservesUnknownFieldsAndOriginalBytes(t *testing.T) {
+	c := semanticClaim(t, 1, "ref", "context", "", "context", "Genesis 1:1")
+	before := append([]byte(nil), c.Operation.Payload...)
+	b, err := bind(c)
+	require.NoError(t, err)
+	require.Equal(t, before, c.Operation.Payload)
+	require.Contains(t, string(b.Record), "futureRecordField")
+	require.Contains(t, string(b.Record), "futureItemField")
+	require.Equal(t, []string{derived.Identity(derived.Ref, "sefaria", "Genesis 1:1", "")}, b.Projection.Sources)
+	for _, change := range []func(*Operation){
+		func(o *Operation) { o.SpaceID = "wrong-space" }, func(o *Operation) { o.Target.ObjectID = "wrong-object" },
+		func(o *Operation) { o.Target.BlockID = "wrong-block" }, func(o *Operation) { o.Source.ProviderID = "wrong-provider" }, func(o *Operation) { o.Source.CanonicalRef = "wrong-ref" },
+	} {
+		op := c.Operation
+		change(&op)
+		_, err := bind(fixtureClaim(t, op))
+		require.ErrorIs(t, err, derived.ErrBinding)
+	}
+}
+
+func TestOnlyDocumentContextProducesNativePropertyIndexes(t *testing.T) {
+	for _, kind := range []string{"ref", "topic", "word"} {
+		t.Run(kind, func(t *testing.T) {
+			c := semanticClaim(t, 1, kind, "context", "", "context", "source")
+			status, p := SemanticIndex(c)
+			require.Equal(t, "valid-document-context", status)
+			require.Equal(t, 1, len(p.Sources)+len(p.Topics)+len(p.Words))
+		})
+	}
+	for i, tc := range []struct{ role, block, ref string }{{"sourceQuote", "", "Genesis 1:1"}, {"context", "stable-block", "Genesis 1:1"}, {"context", "", "anytype-note:local"}} {
+		status, p := SemanticIndex(semanticClaim(t, i+1, "ref", tc.role, tc.block, "context", tc.ref))
+		require.Equal(t, "valid-non-document-context", status)
+		require.Empty(t, p.Sources)
+		require.Empty(t, p.Topics)
+		require.Empty(t, p.Words)
+	}
+	status, _ := SemanticIndex(fixtureClaim(t, fixtureOperation(12, "opaque old T2 bytes")))
+	require.Equal(t, "unsupported-opaque", status)
+}
+
+func TestNativeSemanticConflictsNeverDeduplicateDistinctClaims(t *testing.T) {
+	a := semanticClaim(t, 1, "ref", "context", "", "same-id", "Genesis 1:1")
+	b := semanticClaim(t, 2, "ref", "context", "", "different-id", "Genesis 1:1")
+	p := SemanticFold(Fold(a.Operation.Target, []Claim{a, b}))
+	require.Len(t, p.ConflictingClaimIDs, 2)
+	require.Empty(t, p.Sources)
+	identical := a.Operation
+	identical.OperationID = fmt.Sprintf("%032x", 3)
+	p = SemanticFold(Fold(a.Operation.Target, []Claim{a, fixtureClaim(t, identical)}))
+	require.Len(t, p.ConflictingClaimIDs, 2)
+	c := semanticClaim(t, 4, "topic", "context", "", "same-id", "different-topic")
+	p = SemanticFold(Fold(a.Operation.Target, []Claim{a, c}))
+	require.Len(t, p.ConflictingClaimIDs, 2)
+	qa := semanticClaim(t, 5, "ref", "sourceQuote", "", "quote-a", "Genesis 1:1")
+	qb := semanticClaim(t, 6, "ref", "sourceQuote", "", "quote-b", "Genesis 1:1")
+	p = SemanticFold(Fold(a.Operation.Target, []Claim{qa, qb}))
+	require.Empty(t, p.ConflictingClaimIDs)
+	require.Len(t, p.Records, 2)
+	require.Empty(t, p.Sources)
+}
+
+func TestExternalOnlyInternalNoteNeverBecomesDocumentSource(t *testing.T) {
+	c := semanticClaim(t, 1, "ref", "context", "", "internal-note", "anytype-note:synthetic")
+	var envelope map[string]any
+	require.NoError(t, json.Unmarshal(c.Operation.Payload, &envelope))
+	record := envelope["records"].([]any)[0].(map[string]any)
+	record["item"].(map[string]any)["canonicalKey"] = ""
+	raw, err := json.Marshal(envelope)
+	require.NoError(t, err)
+	op := c.Operation
+	op.Payload = raw
+	c = fixtureClaim(t, op)
+	status, p := SemanticIndex(c)
+	require.Equal(t, "valid-non-document-context", status)
+	require.Empty(t, p.Sources)
+	require.Empty(t, p.Topics)
+	require.Empty(t, p.Words)
+	b, err := bind(c)
+	require.NoError(t, err)
+	require.Empty(t, b.RelatedIdentity)
+}
diff --git a/internal/pinkha/claims/snapshot.go b/internal/pinkha/claims/snapshot.go
new file mode 100644
index 0000000..a6f452b
--- /dev/null
+++ b/internal/pinkha/claims/snapshot.go
@@ -0,0 +1,81 @@
+package claims
+
+import (
+	"context"
+	"encoding/json"
+	"slices"
+	"strings"
+
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+const MaxSnapshotRecords = 10000
+const MaxSnapshotBytes = 16 * 1024 * 1024
+
+// WorkspaceSnapshot contains the entire canonical native claim history in one
+// current-authority snapshot, including all logical variants and predecessors.
+// Complete is true only on success. Bounds never return a partial record list.
+// Target eligibility and semantic projection are separate native read routes.
+type WorkspaceSnapshot struct {
+	Contract     string            `json:"contract"`
+	SpaceID      string            `json:"spaceId"`
+	RootObjectID string            `json:"rootObjectId"`
+	Dataset      string            `json:"dataset"`
+	Complete     bool              `json:"complete"`
+	Limit        int               `json:"limit"`
+	Records      []json.RawMessage `json:"records"`
+	Readiness    Readiness         `json:"readiness"`
+}
+
+// ReadWorkspaceSnapshot returns nil only when a caller supplied exactly the
+// generation just revalidated under current ACL and the native tree lock.
+// Subscriptions use this to coalesce state notifications without scanning all
+// immutable claims on every heartbeat. A new connection always supplies "".
+func ReadWorkspaceSnapshot(ctx context.Context, sp space.Space, rootID string, limit int, previous string) (*WorkspaceSnapshot, error) {
+	if limit < 1 || limit > MaxSnapshotRecords {
+		return nil, ErrInvalid
+	}
+	var result *WorkspaceSnapshot
+	err := space.NativeReadSnapshot(ctx, sp, []string{rootID}, func(view handler.NativeReadView) error {
+		ready := readiness(view, "complete", nil)
+		if previous != "" && previous == ready.Generation {
+			return nil
+		}
+		rows, err := view.Query(rootID, Dataset, nil, limit+1)
+		if err != nil {
+			return err
+		}
+		if len(rows) > limit {
+			return ErrReadLimit
+		}
+		records := make([]json.RawMessage, 0, len(rows))
+		size := 0
+		for _, row := range rows {
+			claim, err := ClaimFromStored(row)
+			if err != nil {
+				return err
+			}
+			if claim.Operation.SpaceID != sp.Id() {
+				return ErrInvalid
+			}
+			raw := json.RawMessage(row.String())
+			size += len(raw)
+			if size > MaxSnapshotBytes {
+				return ErrReadLimit
+			}
+			records = append(records, raw)
+		}
+		slices.SortFunc(records, func(a, b json.RawMessage) int { return strings.Compare(string(a), string(b)) })
+		result = &WorkspaceSnapshot{Contract: ContractID, SpaceID: sp.Id(), RootObjectID: rootID, Dataset: Dataset, Complete: true, Limit: limit, Records: records, Readiness: ready}
+		encoded, err := json.Marshal(result)
+		if err != nil {
+			return err
+		}
+		if len(encoded) > MaxSnapshotBytes {
+			return ErrReadLimit
+		}
+		return nil
+	})
+	return result, err
+}
diff --git a/internal/pinkha/derived/bound_claim.go b/internal/pinkha/derived/bound_claim.go
new file mode 100644
index 0000000..3028be6
--- /dev/null
+++ b/internal/pinkha/derived/bound_claim.go
@@ -0,0 +1,102 @@
+package derived
+
+import (
+	"encoding/json"
+	"strings"
+	"unicode/utf8"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+// ClaimBinding is the already hash-validated native operation's scope. Persisted
+// identifiers are compared exactly here; NFC belongs only to collection identity.
+type ClaimBinding struct {
+	SpaceID, ObjectID, BlockID, ProviderID, CanonicalRef string
+}
+
+type BoundClaim struct {
+	Projection       Projection
+	StableID         string
+	SemanticIdentity string
+	Record           json.RawMessage
+	DocumentContext  bool
+	ItemID           string
+	Kind             Kind
+	Role             string
+	RelatedIdentity  string
+}
+
+// BindClaim accepts the bridge's one-record v2 envelope. Unknown fields remain
+// in Record and the original operation bytes; they are never rewritten. Opaque
+// old T2 payloads remain valid operations but have no semantic projection.
+func BindClaim(b ClaimBinding, raw []byte) (BoundClaim, error) {
+	if len(raw) == 0 || !utf8.Valid(raw) {
+		return BoundClaim{}, ErrUnsupported
+	}
+	envelope, err := object(raw)
+	if err != nil {
+		return BoundClaim{}, ErrUnsupported
+	}
+	var version int
+	if err := required(envelope, "version", &version); err != nil || version != 2 {
+		return BoundClaim{}, ErrUnsupported
+	}
+	var records []json.RawMessage
+	if err := required(envelope, "records", &records); err != nil || len(records) != 1 {
+		return BoundClaim{}, ErrMalformed
+	}
+	record, err := object(records[0])
+	if err != nil {
+		return BoundClaim{}, err
+	}
+	var spaceID, objectID, blockID string
+	if err := required(record, "spaceId", &spaceID); err != nil {
+		return BoundClaim{}, err
+	}
+	if err := required(record, "objectId", &objectID); err != nil {
+		return BoundClaim{}, err
+	}
+	if r := record["blockId"]; r != nil && string(r) != "null" {
+		if json.Unmarshal(r, &blockID) != nil || blockID == "" {
+			return BoundClaim{}, ErrMalformed
+		}
+	}
+	if spaceID != b.SpaceID || objectID != b.ObjectID || blockID != b.BlockID {
+		return BoundClaim{}, ErrBinding
+	}
+	it, err := decodeItem(record["item"])
+	if err != nil {
+		return BoundClaim{}, err
+	}
+	ref := it.CanonicalKey
+	if ref == "" {
+		ref = it.ExternalID
+	}
+	if it.ProviderID != b.ProviderID || ref != b.CanonicalRef {
+		return BoundClaim{}, ErrBinding
+	}
+	p, err := Project(Binding{SpaceID: b.SpaceID, CanonicalKey: "native.claimPayload", Generation: "1"},
+		Input{SpaceID: b.SpaceID, ObjectID: b.ObjectID, TypeID: "page", IsDocument: true, Raw: raw})
+	if err != nil {
+		return BoundClaim{}, err
+	}
+	semantic := it.Role + "|" + Identity(it.Kind, it.ProviderID, it.CanonicalKey, it.ExternalID)
+	if it.Role == "sourceQuote" {
+		semantic += "|quote:" + norm.NFC.String(it.ID)
+	}
+	related := ""
+	if it.Kind == Ref && !strings.HasPrefix(ref, "anytype-note:") {
+		related = Identity(it.Kind, it.ProviderID, it.CanonicalKey, it.ExternalID)
+	}
+	documentContext := blockID == "" && it.Role == "context" && !strings.HasPrefix(ref, "anytype-note:")
+	if !documentContext {
+		p.Sources = []string{}
+		p.Topics = []string{}
+		p.Words = []string{}
+		p.Labels = map[string]DisplayLabel{}
+	}
+	return BoundClaim{Projection: p, StableID: norm.NFC.String(it.ID), SemanticIdentity: semantic,
+		Record: append(json.RawMessage(nil), records[0]...),
+		ItemID: it.ID, Kind: it.Kind, Role: it.Role, RelatedIdentity: related,
+		DocumentContext: documentContext}, nil
+}
diff --git a/internal/pinkha/derived/projection.go b/internal/pinkha/derived/projection.go
new file mode 100644
index 0000000..41465e6
--- /dev/null
+++ b/internal/pinkha/derived/projection.go
@@ -0,0 +1,288 @@
+// Package torahderived implements the read-only canonical projection shared by
+// the native Heart indexer and its Swift/Go compatibility fixtures.
+package derived
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+type Kind string
+
+const (
+	Ref   Kind = "ref"
+	Topic Kind = "topic"
+	Word  Kind = "word"
+)
+
+var ErrMalformed = errors.New("malformed canonical data")
+var ErrUnsupported = errors.New("unsupported canonical version")
+var ErrBinding = errors.New("invalid Space binding")
+var ErrIneligible = errors.New("ineligible document")
+
+// Binding contains validated native identifiers, never human display names.
+type Binding struct {
+	SpaceID      string
+	CanonicalKey string
+	Generation   string
+}
+
+type Input struct {
+	SpaceID    string
+	ObjectID   string
+	TypeID     string
+	IsDocument bool
+	IsTemplate bool
+	IsDeleted  bool
+	IsArchived bool
+	Raw        []byte
+}
+
+type Projection struct {
+	Sources         []string                `json:"sources"`
+	Topics          []string                `json:"topics"`
+	Words           []string                `json:"words"`
+	CanonicalSHA256 string                  `json:"canonicalSHA256"`
+	Labels          map[string]DisplayLabel `json:"labels,omitempty"`
+}
+
+// Display labels are a rebuildable local cache, never synced association data.
+type DisplayLabel struct {
+	Hebrew  string `json:"he"`
+	English string `json:"en,omitempty"`
+}
+
+// Identity matches Swift's NFC identity and length-prefixes UTF-8 bytes.
+// The version prefix allows a future local rebuild without rewriting user data.
+func Identity(kind Kind, provider, canonical, external string) string {
+	if canonical == "" {
+		canonical = external
+	}
+	parts := []string{string(kind), provider, canonical}
+	for i, part := range parts {
+		part = norm.NFC.String(part)
+		parts[i] = fmt.Sprintf("%d:%s", len(part), part)
+	}
+	return "torah1|" + strings.Join(parts, "|")
+}
+
+func (b Binding) Validate() error {
+	if b.SpaceID == "" || b.CanonicalKey == "" || b.Generation == "" || IsLocalKey(b.CanonicalKey) {
+		return ErrBinding
+	}
+	return nil
+}
+
+func Project(b Binding, in Input) (Projection, error) {
+	if err := b.Validate(); err != nil {
+		return Projection{}, err
+	}
+	if !exact(b.SpaceID, in.SpaceID) || in.ObjectID == "" || in.TypeID == "" || !in.IsDocument || in.IsTemplate || in.IsDeleted || in.IsArchived {
+		return Projection{}, ErrIneligible
+	}
+	hash := sha256.Sum256(in.Raw)
+	result := Projection{Sources: []string{}, Topics: []string{}, Words: []string{}, Labels: map[string]DisplayLabel{}, CanonicalSHA256: hex.EncodeToString(hash[:])}
+	// The current repository treats absent or empty native longText as no links.
+	if len(in.Raw) == 0 {
+		return result, nil
+	}
+	if !utf8.Valid(in.Raw) {
+		return Projection{}, ErrMalformed
+	}
+	envelope, err := object(in.Raw)
+	if err != nil {
+		return Projection{}, err
+	}
+	var version int
+	if err = required(envelope, "version", &version); err != nil {
+		return Projection{}, err
+	}
+	var records []record
+	switch version {
+	case 1:
+		var items []json.RawMessage
+		if err = required(envelope, "items", &items); err != nil {
+			return Projection{}, err
+		}
+		for _, item := range items {
+			records = append(records, record{SpaceID: in.SpaceID, ObjectID: in.ObjectID, Item: item})
+		}
+	case 2:
+		var rawRecords []json.RawMessage
+		if err = required(envelope, "records", &rawRecords); err != nil {
+			return Projection{}, err
+		}
+		for _, raw := range rawRecords {
+			fields, e := object(raw)
+			if e != nil {
+				return Projection{}, e
+			}
+			var r record
+			if e = required(fields, "spaceId", &r.SpaceID); e != nil {
+				return Projection{}, e
+			}
+			if e = required(fields, "objectId", &r.ObjectID); e != nil {
+				return Projection{}, e
+			}
+			if v := fields["blockId"]; v != nil && string(v) != "null" {
+				var block string
+				if e = json.Unmarshal(v, &block); e != nil {
+					return Projection{}, ErrMalformed
+				}
+				r.BlockID = &block
+			}
+			if e = required(fields, "item", &r.Item); e != nil {
+				return Projection{}, e
+			}
+			records = append(records, r)
+		}
+	default:
+		return Projection{}, fmt.Errorf("%w: %d", ErrUnsupported, version)
+	}
+	ids, identities := map[string]bool{}, map[string]bool{}
+	for _, r := range records {
+		item, err := decodeItem(r.Item)
+		if err != nil {
+			return Projection{}, err
+		}
+		if !exact(r.SpaceID, in.SpaceID) || !exact(r.ObjectID, in.ObjectID) || r.BlockID != nil || item.Role != "context" || strings.HasPrefix(item.CanonicalKey, "anytype-note:") {
+			continue
+		}
+		identity := Identity(item.Kind, item.ProviderID, item.CanonicalKey, item.ExternalID)
+		id := norm.NFC.String(item.ID)
+		if ids[id] || identities[identity] {
+			continue
+		}
+		ids[id], identities[identity] = true, true
+		result.Labels[identity] = DisplayLabel{Hebrew: item.LabelHe, English: item.LabelEn}
+		switch item.Kind {
+		case Ref:
+			result.Sources = append(result.Sources, identity)
+		case Topic:
+			result.Topics = append(result.Topics, identity)
+		case Word:
+			result.Words = append(result.Words, identity)
+		}
+	}
+	sort.Strings(result.Sources)
+	sort.Strings(result.Topics)
+	sort.Strings(result.Words)
+	return result, nil
+}
+
+type record struct {
+	SpaceID  string
+	ObjectID string
+	BlockID  *string
+	Item     json.RawMessage
+}
+
+type item struct {
+	ID           string
+	Kind         Kind
+	Role         string
+	ProviderID   string
+	CanonicalKey string
+	ExternalID   string
+	LabelHe      string
+	LabelEn      string
+}
+
+func decodeItem(raw json.RawMessage) (item, error) {
+	fields, err := object(raw)
+	if err != nil {
+		return item{}, err
+	}
+	var value item
+	for _, f := range []struct {
+		name   string
+		target any
+	}{
+		{"id", &value.ID}, {"kind", &value.Kind}, {"role", &value.Role},
+		{"providerID", &value.ProviderID}, {"canonicalKey", &value.CanonicalKey},
+		{"externalID", &value.ExternalID}, {"labelHe", &value.LabelHe},
+	} {
+		if err := required(fields, f.name, f.target); err != nil {
+			return item{}, err
+		}
+	}
+	if value.Kind != Ref && value.Kind != Topic && value.Kind != Word {
+		return item{}, ErrMalformed
+	}
+	if value.Role == "source_quote" {
+		value.Role = "sourceQuote"
+	}
+	if value.Role != "context" && value.Role != "sourceQuote" {
+		return item{}, ErrMalformed
+	}
+	if value.ID == "" || value.ProviderID == "" || (value.CanonicalKey == "" && value.ExternalID == "") {
+		return item{}, ErrMalformed
+	}
+	// Validate the known optional fields as Swift's existing codec does. They
+	// never participate in identity, but invalid typed data must fail closed.
+	for _, key := range []string{"labelEn", "rawInput", "providerPayload"} {
+		if raw := fields[key]; raw != nil && string(raw) != "null" {
+			var text string
+			if json.Unmarshal(raw, &text) != nil {
+				return item{}, ErrMalformed
+			}
+			if key == "labelEn" {
+				value.LabelEn = text
+			}
+		}
+	}
+	for _, key := range []string{"createdAt", "updatedAt"} {
+		if raw := fields[key]; raw != nil && string(raw) != "null" {
+			var timestamp string
+			if json.Unmarshal(raw, &timestamp) != nil {
+				return item{}, ErrMalformed
+			}
+			if _, err := time.Parse(time.RFC3339Nano, timestamp); err != nil {
+				return item{}, ErrMalformed
+			}
+		}
+	}
+	if raw := fields["customMetadata"]; raw != nil && string(raw) != "null" {
+		var metadata map[string]json.RawMessage
+		if json.Unmarshal(raw, &metadata) != nil {
+			return item{}, ErrMalformed
+		}
+		for _, rawValue := range metadata {
+			var text string
+			if string(rawValue) == "null" || json.Unmarshal(rawValue, &text) != nil {
+				return item{}, ErrMalformed
+			}
+		}
+	}
+	return value, nil
+}
+
+func object(raw []byte) (map[string]json.RawMessage, error) {
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil || fields == nil {
+		return nil, ErrMalformed
+	}
+	return fields, nil
+}
+
+func required(fields map[string]json.RawMessage, key string, value any) error {
+	raw, exists := fields[key]
+	if !exists || string(raw) == "null" {
+		return ErrMalformed
+	}
+	if err := json.Unmarshal(raw, value); err != nil {
+		return ErrMalformed
+	}
+	return nil
+}
+
+func exact(a, b string) bool { return norm.NFC.String(a) == norm.NFC.String(b) }
diff --git a/internal/pinkha/derived/properties.go b/internal/pinkha/derived/properties.go
new file mode 100644
index 0000000..47f8583
