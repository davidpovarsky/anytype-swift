+package handler
+
+import "github.com/anyproto/any-sync-sdk/internal/crdt"
+
+// GuardedHandler and LocalReadView are native extension contracts, not wire
+// options. Only compiled handlers can request a guarded commit.
+type GuardedHandler = crdt.GuardedHandler
+type LocalReadView = crdt.LocalReadView
+type NativeReadView = crdt.NativeReadView
+type NativeReadStamp = crdt.NativeReadStamp
+
+// Re-export the existing batch preflight signature so embedders can implement
+// it without importing an internal package.
+type RecordGetter = crdt.RecordGetter
+type LocalPreValidatorMulti = crdt.LocalPreValidatorMulti
diff --git a/internal/commitguard/guard.go b/internal/commitguard/guard.go
new file mode 100644
index 0000000..7543991
--- /dev/null
+++ b/internal/commitguard/guard.go
@@ -0,0 +1,228 @@
+package commitguard
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/util/crypto"
+)
+
+var (
+	ErrNativeCommitGuard = errors.New("guarded local append requires its native commit guard")
+	ErrNativeACLChanged  = errors.New("signed ACL head changed before native commit")
+)
+
+// nativeCommitTree enforces the private one-call token for SDK guarded writes.
+// Ordinary SDK datasets keep their upstream append route. Incoming AddRawChanges
+// keeps historical signature/ACL validation; it is not a new local request.
+type nativeCommitTree struct {
+	objecttree.ObjectTree
+	storage *nativeCommitStorage
+}
+
+type nativeCommitStorage struct {
+	objecttree.Storage
+	acl    list.AclList
+	header *treechangeproto.RawTreeChangeWithId
+}
+
+type nativeCommitContextKey struct{}
+
+// All fields belong to one synchronous append while its tree lock is held.
+// No token, author, ACL head or guard callback is accepted from an RPC request.
+type Guard struct {
+	storage   *nativeCommitStorage
+	author    crypto.PubKey
+	used      bool
+	active    bool
+	attempted bool
+	prepared  *objecttree.StorageChange
+	committed *objecttree.StorageChange
+}
+
+func boundNativeCommitStorage(tree objecttree.ObjectTree) (*nativeCommitStorage, error) {
+	if tree == nil {
+		return nil, ErrNativeCommitGuard
+	}
+	storage, ok := tree.Storage().(*nativeCommitStorage)
+	if !ok || storage == nil || storage.acl == nil || storage.header == nil ||
+		storage.Id() != tree.Id() || storage.acl != tree.AclList() ||
+		storage.header.Id != tree.Header().Id || !bytes.Equal(storage.header.RawChange, tree.Header().RawChange) {
+		return nil, ErrNativeCommitGuard
+	}
+	return storage, nil
+}
+
+func Context(ctx context.Context, tree objecttree.ObjectTree, author crypto.PubKey) (context.Context, *Guard, error) {
+	storage, err := boundNativeCommitStorage(tree)
+	if ctx == nil || err != nil || author == nil {
+		return nil, nil, ErrNativeCommitGuard
+	}
+	guard := &Guard{storage: storage, author: author}
+	return context.WithValue(ctx, nativeCommitContextKey{}, guard), guard, nil
+}
+
+// CheckCurrentWrite is the authority linearization point for an exact retry
+// which appends nothing. The caller still holds all target/carrier tree locks.
+func CheckCurrentWrite(ctx context.Context, tree objecttree.ObjectTree, author crypto.PubKey) error {
+	storage, err := boundNativeCommitStorage(tree)
+	if err != nil || ctx == nil || author == nil {
+		return ErrNativeCommitGuard
+	}
+	storage.acl.RLock()
+	defer storage.acl.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !storage.acl.AclState().Permissions(author).CanWrite() {
+		return list.ErrInsufficientPermissions
+	}
+	return nil
+}
+
+func nativeGuard(ctx context.Context) *Guard {
+	if ctx == nil {
+		return nil
+	}
+	guard, _ := ctx.Value(nativeCommitContextKey{}).(*Guard)
+	return guard
+}
+
+func copyNativeStorageChange(change objecttree.StorageChange) *objecttree.StorageChange {
+	change.RawChange = bytes.Clone(change.RawChange)
+	change.PrevIds = slices.Clone(change.PrevIds)
+	return &change
+}
+
+func (t *nativeCommitTree) AddContent(ctx context.Context, content objecttree.SignableChangeContent) (objecttree.AddResult, error) {
+	return t.AddContentWithValidator(ctx, content, nil)
+}
+
+func (t *nativeCommitTree) AddContentWithValidator(ctx context.Context, content objecttree.SignableChangeContent, validate objecttree.ChangeValidator) (objecttree.AddResult, error) {
+	guard := nativeGuard(ctx)
+	if guard == nil {
+		return t.ObjectTree.AddContentWithValidator(ctx, content, validate)
+	}
+	if guard.storage != t.storage || guard.used || content.Key == nil ||
+		!content.Key.GetPublic().Equals(guard.author) {
+		return objecttree.AddResult{}, ErrNativeCommitGuard
+	}
+	if err := ctx.Err(); err != nil {
+		return objecttree.AddResult{}, err
+	}
+	guard.used, guard.active = true, true
+	defer func() { guard.active = false }()
+	return t.ObjectTree.AddContentWithValidator(ctx, content, func(change objecttree.StorageChange) error {
+		if guard.prepared != nil {
+			return ErrNativeCommitGuard
+		}
+		guard.prepared = copyNativeStorageChange(change)
+		if validate != nil {
+			return validate(change)
+		}
+		return nil
+	})
+}
+
+func (t *nativeCommitTree) AddRawChanges(ctx context.Context, changes objecttree.RawChangesPayload) (objecttree.AddResult, error) {
+	if nativeGuard(ctx) != nil {
+		return objecttree.AddResult{}, ErrNativeCommitGuard
+	}
+	return t.ObjectTree.AddRawChanges(ctx, changes)
+}
+
+func (t *nativeCommitTree) AddRawChangesWithUpdater(ctx context.Context, changes objecttree.RawChangesPayload, update objecttree.Updater) (objecttree.AddResult, error) {
+	if nativeGuard(ctx) != nil {
+		return objecttree.AddResult{}, ErrNativeCommitGuard
+	}
+	return t.ObjectTree.AddRawChangesWithUpdater(ctx, changes, update)
+}
+
+func (s *nativeCommitStorage) AddAll(ctx context.Context, changes []objecttree.StorageChange, heads []string, snapshot string) error {
+	guard := nativeGuard(ctx)
+	if guard == nil {
+		// Remote/deferred-storage replay has already passed the unchanged native
+		// historical verifier. A later revocation must not erase valid history.
+		return s.Storage.AddAll(ctx, changes, heads, snapshot)
+	}
+	if guard.storage != s || !guard.active || guard.attempted || guard.prepared == nil ||
+		len(changes) != 1 || len(heads) != 1 || heads[0] != guard.prepared.Id || snapshot != s.header.Id {
+		return ErrNativeCommitGuard
+	}
+	expected, actual := guard.prepared, changes[0]
+	if actual.Id != expected.Id || actual.OrderId != expected.OrderId ||
+		actual.SnapshotId != expected.SnapshotId || actual.SnapshotCounter != expected.SnapshotCounter ||
+		actual.ChangeSize != expected.ChangeSize || !bytes.Equal(actual.RawChange, expected.RawChange) ||
+		!slices.Equal(actual.PrevIds, expected.PrevIds) {
+		return ErrNativeCommitGuard
+	}
+	guard.attempted = true
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	change, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), s.header).Unmarshall(actual.RawTreeChangeWithId(), true)
+	if err != nil {
+		return err
+	}
+	if change.Identity == nil || !change.Identity.Equals(guard.author) || change.IsSnapshot || change.ReadKeyId == "" {
+		return ErrNativeCommitGuard
+	}
+
+	// prepareBuilderContent and validateTree have released their own ACL locks.
+	// Hold this final read lock only across the real native storage transaction,
+	// never across SyncTree head-update construction, broadcast or projection.
+	s.acl.RLock()
+	defer s.acl.RUnlock()
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if !s.acl.AclState().Permissions(guard.author).CanWrite() {
+		return list.ErrInsufficientPermissions
+	}
+	head := s.acl.Head()
+	if head == nil || change.AclHeadId != head.Id {
+		return errors.Join(ErrNativeACLChanged, list.ErrInsufficientPermissions)
+	}
+	if err = s.Storage.AddAll(ctx, changes, heads, snapshot); err != nil {
+		return err
+	}
+	// AddAll returns only after its deferred tx.Commit succeeds. The underlying
+	// store has also assigned AddSeq in this slice. This is the durable witness
+	// even if SyncTree later returns an error while creating its head update.
+	guard.committed = copyNativeStorageChange(changes[0])
+	return nil
+}
+
+func (s *nativeCommitStorage) AddAllNoError(ctx context.Context, changes []objecttree.StorageChange, heads []string, snapshot string) error {
+	if nativeGuard(ctx) != nil {
+		return ErrNativeCommitGuard
+	}
+	return s.Storage.AddAllNoError(ctx, changes, heads, snapshot)
+}
+
+// Builder preserves AnySync's normal signature and historical ACL validation.
+// Only a native guarded local call takes the final ACL/storage fence; incoming
+// historical changes are not judged against a later current ACL.
+func Builder(validate func(*objecttree.Change, list.AclList) error) objecttree.BuildObjectTreeFunc {
+	return func(storage objecttree.Storage, acl list.AclList) (objecttree.ObjectTree, error) {
+		root, err := storage.Root(context.Background())
+		if err != nil {
+			return nil, err
+		}
+		guarded := &nativeCommitStorage{Storage: storage, acl: acl, header: root.RawTreeChangeWithId()}
+		build := objecttree.BuildObjectTree
+		if validate != nil {
+			build = objecttree.BuildObjectTreeWithContentValidator(validate)
+		}
+		tree, err := build(guarded, acl)
+		if err != nil {
+			return nil, err
+		}
+		return &nativeCommitTree{ObjectTree: tree, storage: guarded}, nil
+	}
+}
diff --git a/internal/commitguard/guard_test.go b/internal/commitguard/guard_test.go
new file mode 100644
index 0000000..b44d334
--- /dev/null
+++ b/internal/commitguard/guard_test.go
@@ -0,0 +1,237 @@
+package commitguard
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"testing"
+
+	anystore "github.com/anyproto/any-store"
+	"github.com/anyproto/any-sync/commonspace/object/accountdata"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/acl/recordverifier"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/commonspace/spacepayloads"
+	"github.com/anyproto/any-sync/commonspace/spacestorage"
+	"github.com/anyproto/any-sync/consensus/consensusproto"
+	"github.com/anyproto/any-sync/util/cidutil"
+	"github.com/anyproto/any-sync/util/crypto"
+	"github.com/stretchr/testify/require"
+)
+
+// The fence tests use real signed ACL records, real encrypted native tree
+// changes and real AnyStore transactions. They do not replace permission maps
+// or simulate a durable append with an in-memory record collection.
+type fixture struct {
+	keys  *accountdata.AccountKeys
+	db    anystore.DB
+	space spacestorage.SpaceStorage
+	acl   list.AclList
+	tree  objecttree.ObjectTree
+}
+
+func newFixture(t *testing.T) *fixture {
+	t.Helper()
+	ctx := context.Background()
+	keys, err := accountdata.NewRandom()
+	require.NoError(t, err)
+	master, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	payload, err := spacepayloads.StoragePayloadForSpaceCreate(spacepayloads.SpaceCreatePayload{
+		SigningKey: keys.SignKey, SpaceType: "space", ReplicationKey: 10, MasterKey: master,
+		ReadKey: crypto.NewAES(), MetadataKey: metadata, Metadata: []byte("disposable native commit fence")})
+	require.NoError(t, err)
+	db, err := anystore.Open(ctx, filepath.Join(t.TempDir(), "native.db"), &anystore.Config{ReadConnections: 2})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	sp, err := spacestorage.Create(ctx, db, payload)
+	require.NoError(t, err)
+	as, err := sp.AclStorage()
+	require.NoError(t, err)
+	acl, err := list.BuildAclListWithIdentity(keys, as, recordverifier.NewValidateFull())
+	require.NoError(t, err)
+	root, err := objecttree.DeriveObjectTreeRoot(objecttree.ObjectTreeDerivePayload{SpaceId: sp.Id(), ChangeType: "pinkha-fence-test", ChangePayload: []byte("canonical-test-carrier"), IsEncrypted: true}, nil)
+	require.NoError(t, err)
+	storage, err := sp.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{RootRawChange: root, Heads: []string{root.Id}})
+	require.NoError(t, err)
+	tree, err := Builder(nil)(storage, acl)
+	require.NoError(t, err)
+	tree.Lock()
+	t.Cleanup(func() { tree.Unlock(); require.NoError(t, tree.Close()) })
+	return &fixture{keys: keys, db: db, space: sp, acl: acl, tree: tree}
+}
+
+func aclRecord(t *testing.T, acl list.AclList, build func() (*consensusproto.RawRecord, error)) {
+	t.Helper()
+	acl.Lock()
+	defer acl.Unlock()
+	rec, err := build()
+	require.NoError(t, err)
+	raw, err := rec.MarshalVT()
+	require.NoError(t, err)
+	id, err := cidutil.NewCidFromBytes(raw)
+	require.NoError(t, err)
+	require.NoError(t, acl.AddRawRecord(&consensusproto.RawRecordWithId{Id: id, Payload: raw}))
+}
+
+func (f *fixture) addWriter(t *testing.T) crypto.PrivKey {
+	t.Helper()
+	member, err := accountdata.NewRandom()
+	require.NoError(t, err)
+	aclRecord(t, f.acl, func() (*consensusproto.RawRecord, error) {
+		return f.acl.RecordBuilder().BuildAccountsAdd(list.AccountsAddPayload{Additions: []list.AccountAdd{{Identity: member.SignKey.GetPublic(), Permissions: list.AclPermissionsWriter, Metadata: []byte("synthetic writer")}}})
+	})
+	return member.SignKey
+}
+
+func (f *fixture) remove(t *testing.T, key crypto.PrivKey) {
+	t.Helper()
+	metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	aclRecord(t, f.acl, func() (*consensusproto.RawRecord, error) {
+		return f.acl.RecordBuilder().BuildAccountRemove(list.AccountRemovePayload{Identities: []crypto.PubKey{key.GetPublic()}, Change: list.ReadKeyChangePayload{MetadataKey: metadata, ReadKey: crypto.NewAES()}})
+	})
+}
+
+func TestActualACLFinalCommitFence(t *testing.T) {
+	for _, mode := range []string{"revocation", "head advance", "cancellation"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newFixture(t)
+			writer := f.addWriter(t)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			guarded, guard, err := Context(ctx, f.tree, writer.GetPublic())
+			require.NoError(t, err)
+			var prepared string
+			_, err = f.tree.AddContentWithValidator(guarded, objecttree.SignableChangeContent{Key: writer, Data: []byte("valid encrypted synthetic operation"), ShouldBeEncrypted: true}, func(change objecttree.StorageChange) error {
+				prepared = change.Id
+				switch mode {
+				case "revocation":
+					f.remove(t, writer)
+				case "head advance":
+					_ = f.addWriter(t)
+				case "cancellation":
+					cancel()
+				}
+				return nil
+			})
+			switch mode {
+			case "cancellation":
+				require.ErrorIs(t, err, context.Canceled)
+			case "head advance":
+				require.ErrorIs(t, err, ErrNativeACLChanged)
+			default:
+				require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+			}
+			require.NotEmpty(t, prepared)
+			require.Nil(t, guard.committed)
+			has, readErr := f.tree.Storage().Has(context.Background(), prepared)
+			require.NoError(t, readErr)
+			require.False(t, has)
+		})
+	}
+}
+
+type observingStorage struct {
+	objecttree.Storage
+	before, after func()
+}
+
+func (s *observingStorage) AddAll(ctx context.Context, ch []objecttree.StorageChange, heads []string, snapshot string) error {
+	s.before()
+	err := s.Storage.AddAll(ctx, ch, heads, snapshot)
+	s.after()
+	return err
+}
+
+func aclUnlocked(t *testing.T, acl list.AclList) bool {
+	t.Helper()
+	locker, ok := acl.(interface{ TryLock() bool })
+	require.True(t, ok)
+	if locker.TryLock() {
+		acl.Unlock()
+		return true
+	}
+	return false
+}
+
+func TestACLHeldThroughRealCommitAndReleasedAfter(t *testing.T) {
+	f := newFixture(t)
+	storage, err := boundNativeCommitStorage(f.tree)
+	require.NoError(t, err)
+	before, after := false, false
+	storage.Storage = &observingStorage{Storage: storage.Storage, before: func() { before = true; require.False(t, aclUnlocked(t, f.acl)) }, after: func() { after = true; require.False(t, aclUnlocked(t, f.acl)) }}
+	ctx, guard, err := Context(context.Background(), f.tree, f.keys.SignKey.GetPublic())
+	require.NoError(t, err)
+	result, err := f.tree.AddContent(ctx, objecttree.SignableChangeContent{Key: f.keys.SignKey, Data: []byte("signed and durable"), ShouldBeEncrypted: true})
+	require.NoError(t, err)
+	require.True(t, before && after)
+	require.True(t, aclUnlocked(t, f.acl))
+	require.NotNil(t, guard.committed)
+	require.Len(t, result.Added, 1)
+	stored, err := storage.Get(context.Background(), result.Added[0].Id)
+	require.NoError(t, err)
+	require.Equal(t, guard.committed.RawChange, stored.RawChange)
+	_, err = f.tree.AddContent(ctx, objecttree.SignableChangeContent{Key: f.keys.SignKey, Data: []byte("token reuse"), ShouldBeEncrypted: true})
+	require.ErrorIs(t, err, ErrNativeCommitGuard)
+}
+
+func TestExactRetryRequiresCurrentWriter(t *testing.T) {
+	f := newFixture(t)
+	writer := f.addWriter(t)
+	require.NoError(t, CheckCurrentWrite(context.Background(), f.tree, writer.GetPublic()))
+	f.remove(t, writer)
+	require.ErrorIs(t, CheckCurrentWrite(context.Background(), f.tree, writer.GetPublic()), list.ErrInsufficientPermissions)
+	f.acl.RLock()
+	hadRead := f.acl.AclState().HadReadPermissions(writer.GetPublic())
+	f.acl.RUnlock()
+	require.True(t, hadRead)
+}
+
+func TestHistoricalReplaySurvivesLaterRevocation(t *testing.T) {
+	f := newFixture(t)
+	writer := f.addWriter(t)
+	ctx, _, err := Context(context.Background(), f.tree, writer.GetPublic())
+	require.NoError(t, err)
+	result, err := f.tree.AddContent(ctx, objecttree.SignableChangeContent{Key: writer, Data: []byte("authorized historical operation"), ShouldBeEncrypted: true})
+	require.NoError(t, err)
+	require.Len(t, result.Added, 1)
+	raw := result.Added[0].RawTreeChangeWithId()
+	f.remove(t, writer)
+	// Rebuild from the actual signed history against the advanced ACL. The
+	// native verifier uses the signed historical head, not current permissions.
+	storage, err := boundNativeCommitStorage(f.tree)
+	require.NoError(t, err)
+	rebuilt, err := Builder(nil)(storage.Storage, f.acl)
+	require.NoError(t, err)
+	rebuilt.Lock()
+	defer rebuilt.Unlock()
+	ch, err := rebuilt.GetChange(raw.Id)
+	require.NoError(t, err)
+	require.True(t, ch.Identity.Equals(writer.GetPublic()))
+	require.NotEqual(t, f.acl.Head().Id, ch.AclHeadId)
+}
+
+func TestIntrinsicValidatorRejectsBeforeNativeStorage(t *testing.T) {
+	f := newFixture(t)
+	storage, err := boundNativeCommitStorage(f.tree)
+	require.NoError(t, err)
+	rejected := errors.New("synthetic native intrinsic refusal")
+	tree, err := Builder(func(ch *objecttree.Change, _ list.AclList) error {
+		if ch.Id == f.tree.Header().Id {
+			return nil
+		}
+		return rejected
+	})(storage.Storage, f.acl)
+	require.NoError(t, err)
+	tree.Lock()
+	defer tree.Unlock()
+	ctx, guard, err := Context(context.Background(), tree, f.keys.SignKey.GetPublic())
+	require.NoError(t, err)
+	_, err = tree.AddContent(ctx, objecttree.SignableChangeContent{Key: f.keys.SignKey, Data: []byte("rejected before history"), ShouldBeEncrypted: true})
+	require.ErrorIs(t, err, rejected)
+	require.Nil(t, guard.committed)
+}
diff --git a/internal/crdt/localguard.go b/internal/crdt/localguard.go
new file mode 100644
index 0000000..3856df7
--- /dev/null
+++ b/internal/crdt/localguard.go
@@ -0,0 +1,121 @@
+package crdt
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-store/v2/query"
+	"github.com/anyproto/any-sync-sdk/internal/anyencx"
+)
+
+// LocalReadView exists only while the SDK holds the writer's tree and every
+// declared dependency tree. Reads are restricted to those objects, in this
+// Space. A read error is never treated as an absent record.
+type LocalReadView interface {
+	Lookup(objectId, dataset, id string) (*anyenc.Value, error)
+	Query(objectId, dataset string, filter any, limit int) ([]*anyenc.Value, error)
+}
+
+// NativeReadView adds read-only access to the Space's shared native object
+// projection. It is exposed only inside the current-ACL-fenced read transaction,
+// never as a cross-object write precondition.
+type NativeReadView interface {
+	LocalReadView
+	SpaceObjects(filter any, limit int) ([]*anyenc.Value, error)
+	CanWrite() bool
+	ReadStamp() NativeReadStamp
+}
+
+type NativeReadStamp struct {
+	ACLHeadID string              `json:"aclHeadId"`
+	TreeHeads map[string][]string `json:"treeHeads"`
+}
+
+// GuardedHandler is opt-in native domain behavior. Validation of signed remote
+// data MUST be intrinsic and arrival-order independent. Local validation may
+// inspect mutable target state because the SDK holds those targets' tree locks
+// until the durable append and local apply finish. The root seed restricts the
+// behavior to one canonical derived carrier per Space.
+type GuardedHandler interface {
+	GuardRootSeed() []byte
+	ValidateNative(ch *Change) error
+	LocalTargets(ch *Change) ([]string, error)
+	ValidateLocal(ch *Change, view LocalReadView) error
+}
+
+func (c *Controller) LocalGuard(dataset string) GuardedHandler {
+	if c == nil {
+		return nil
+	}
+	g, _ := c.handlers[dataset].(GuardedHandler)
+	return g
+}
+
+func (c *Controller) NativeGuards() map[string]GuardedHandler {
+	result := make(map[string]GuardedHandler)
+	for dataset, h := range c.handlers {
+		if g, ok := h.(GuardedHandler); ok {
+			result[dataset] = g
+		}
+	}
+	return result
+}
+
+// GuardQuery is bounded and object-scoped even for shared collections. It is
+// called under the object's tree lock; every local write, inbound apply, purge
+// and close takes that same lock.
+func (c *Controller) GuardQuery(ctx context.Context, dataset string, filter any, limit int) ([]*anyenc.Value, error) {
+	return c.guardQuery(ctx, dataset, filter, limit, false)
+}
+
+func (c *Controller) GuardSpaceObjects(ctx context.Context, filter any, limit int) ([]*anyenc.Value, error) {
+	if !c.IsShared("objects") {
+		return nil, ErrValidation
+	}
+	return c.guardQuery(ctx, "objects", filter, limit, true)
+}
+
+func (c *Controller) guardQuery(ctx context.Context, dataset string, filter any, limit int, spaceObjects bool) ([]*anyenc.Value, error) {
+	if limit < 1 || limit > 10001 {
+		return nil, fmt.Errorf("%w: guard query limit", ErrValidation)
+	}
+	f, err := query.ParseCondition(filter)
+	if err != nil {
+		return nil, err
+	}
+	if c.IsKeyed(dataset) {
+		f = query.And{f, KeyedRows(c.objectId)}
+	} else if c.IsShared(dataset) && !spaceObjects {
+		own, err := query.ParseCondition(map[string]any{"id": c.objectId})
+		if err != nil {
+			return nil, err
+		}
+		f = query.And{f, own}
+	}
+	coll, err := c.PeekCollection(ctx, dataset)
+	if err != nil {
+		return nil, err
+	}
+	if coll == nil {
+		return []*anyenc.Value{}, nil
+	}
+	it, err := coll.Find(f).Limit(uint(limit)).Iter(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer it.Close()
+	result := make([]*anyenc.Value, 0)
+	for it.Next() {
+		doc, err := it.Doc()
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, anyencx.Clone(doc.Value()))
+	}
+	if err := it.Err(); err != nil {
+		return nil, errors.Join(ErrValidation, err)
+	}
+	return result, nil
+}
