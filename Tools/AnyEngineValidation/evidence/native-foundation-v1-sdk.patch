+package spaceimpl
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/internal/properties"
+	"github.com/anyproto/any-sync-sdk/internal/schema"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+func (p *propertiesAPI) SetConditional(ctx context.Context, objectId, typeId string, patch map[string]any, expectedApplySeq uint64) (space.ModifyResult, error) {
+	if objectId == "" || typeId == "" || len(patch) == 0 {
+		return space.ModifyResult{}, fmt.Errorf("%w: objectId, ownerId and nonempty patch required", crdt.ErrValidation)
+	}
+	route, _, err := resolveRoute(p.parent.store.Registry(), typeId, patch)
+	if err != nil {
+		return space.ModifyResult{}, err
+	}
+	if route != schema.ScopeSynced {
+		return space.ModifyResult{}, fmt.Errorf("%w: SetConditional supports synced properties only", crdt.ErrValidation)
+	}
+	arena := &anyenc.Arena{}
+	ops, err := patchOps(arena, typeId, patch)
+	if err != nil {
+		return space.ModifyResult{}, err
+	}
+	dataVersion, err := dataVersionForType(ctx, p.parent.store.Registry(), typeId)
+	if err != nil {
+		return space.ModifyResult{}, err
+	}
+	obj, err := p.parent.store.Get(ctx, objectId)
+	if err != nil {
+		return space.ModifyResult{}, err
+	}
+	ch := crdt.Change{Dataset: properties.Dataset, DataVersion: dataVersion, Records: []crdt.RecordChange{{Id: objectId, Ops: ops}}}
+	result, err := p.parent.localWriteRetryObjectIf(ctx, obj, objectId, ch, expectedApplySeq)
+	if err != nil {
+		return space.ModifyResult{}, err
+	}
+	return modifyResultFromWrite(result), nil
+}
+
+func (s *spaceImpl) localWriteRetryObjectIf(ctx context.Context, obj *object.Object, objectId string, ch crdt.Change, seq uint64) (object.WriteResult, error) {
+	result, err := obj.LocalWriteIfObject(ctx, ch, seq)
+	if !errors.Is(err, object.ErrClosed) {
+		return result, wrapSlotErr(err)
+	}
+	fresh, err := s.store.Get(ctx, objectId)
+	if err != nil {
+		return object.WriteResult{}, err
+	}
+	result, err = fresh.LocalWriteIfObject(ctx, ch, seq)
+	return result, wrapSlotErr(err)
+}
+
+func checkObjectConditionalBatch(batch space.ModifyBatch) error {
+	if batch.IfObjectUnchangedSince == nil {
+		return nil
+	}
+	if batch.IfUnchangedSince != nil || (batch.Scope != 0 && batch.Scope != space.ScopeSynced) || batch.Dataset != properties.Dataset || len(batch.Records) != 1 || batch.Records[0].Id != batch.ObjectId || batch.Records[0].Upsert {
+		return fmt.Errorf("%w: IfObjectUnchangedSince requires one explicit non-upsert objects row in synced scope and no other precondition", crdt.ErrValidation)
+	}
+	return nil
+}
