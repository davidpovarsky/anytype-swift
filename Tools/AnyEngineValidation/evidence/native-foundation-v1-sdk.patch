@@ -0,0 +1,38 @@
+package object
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+)
+
+// LocalWriteLocker acquires the carrier and all declared dependency trees in
+// stable ID order. It is called before this Object takes its normal tree lock.
+type LocalWriteLocker func(context.Context, *Object, *crdt.Change) (crdt.LocalReadView, func(), error)
+
+// GuardReadyLocked checks and catches up a dependency while its tree is held.
+// An applied-but-unprojected change must not become a false absence check.
+func (o *Object) GuardReadyLocked(ctx context.Context) error {
+	if o.tree == nil {
+		return ErrTreeNotSet
+	}
+	if o.closed {
+		return ErrClosed
+	}
+	if o.deleted {
+		return ErrDeleted
+	}
+	// SyncTree.Delete completes its underlying native deletion before Store's
+	// later MarkDeleted updates this wrapper. GetChange checks the tree's own
+	// deletion flag, closing that otherwise observable authority window.
+	root := o.tree.Root()
+	if root == nil {
+		return ErrTreeNotSet
+	}
+	if _, err := o.tree.GetChange(root.Id); err != nil {
+		return err
+	}
+	if o.applyGap {
+		return o.replayLocked(ctx, o.tree)
+	}
+	return nil
+}
