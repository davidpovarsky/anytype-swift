+)
+
+func TestObjectConditionalModifyShapeGuards(t *testing.T) {
+	seq := uint64(7)
+	valid := func() space.ModifyBatch {
+		return space.ModifyBatch{ObjectId: "target", Dataset: "objects", Records: []space.RecordModify{{Id: "target", Ops: []space.Op{{Type: space.OpSet, Path: "any.name", Value: "x"}}}}, IfObjectUnchangedSince: &seq}
+	}
+	require.NoError(t, checkObjectConditionalBatch(valid()))
+	for _, mode := range []string{"local", "other dataset", "foreign row", "empty id", "upsert", "two records", "two conditions"} {
+		t.Run(mode, func(t *testing.T) {
+			b := valid()
+			switch mode {
+			case "local":
+				b.Scope = space.ScopeLocal
+			case "other dataset":
+				b.Dataset = "blocks"
+			case "foreign row":
+				b.Records[0].Id = "other"
+			case "empty id":
+				b.Records[0].Id = ""
+			case "upsert":
+				b.Records[0].Upsert = true
+			case "two records":
+				b.Records = append(b.Records, b.Records[0])
+			case "two conditions":
+				b.IfUnchangedSince = &seq
+			}
+			_, err := (&spaceImpl{}).Modify(context.Background(), b)
+			require.ErrorIs(t, err, crdt.ErrValidation)
+		})
+	}
+	_, err := (&spaceImpl{}).ModifyMany(context.Background(), []space.ModifyBatch{valid()})
+	require.ErrorIs(t, err, crdt.ErrValidation)
+}
