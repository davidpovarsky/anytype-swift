diff --git a/space/snapshot.go b/space/snapshot.go
new file mode 100644
index 0000000..a26e743
--- /dev/null
+++ b/space/snapshot.go
@@ -0,0 +1,22 @@
+package space
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+)
+
+var ErrNativeReadRequired = crdt.ErrNativeReadRequired
+
+// NativeReadSnapshot returns a current-ACL-fenced native view over explicitly
+// declared objects. Every read uses one SQLite snapshot while target trees are
+// held; the callback cannot load objects or write. Unsupported backends refuse.
+func NativeReadSnapshot(ctx context.Context, sp Space, objectIDs []string, read func(handler.NativeReadView) error) error {
+	r, ok := sp.(interface {
+		NativeReadSnapshot(context.Context, []string, func(handler.NativeReadView) error) error
+	})
+	if !ok {
+		return ErrUnsupported
+	}
+	return r.NativeReadSnapshot(ctx, objectIDs, read)
+}
