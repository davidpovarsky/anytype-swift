+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/commonspace/spacepayloads"
+	"github.com/anyproto/any-sync/commonspace/spacestorage"
+	"github.com/anyproto/any-sync/util/crypto"
+	"github.com/stretchr/testify/require"
+)
+
+func TestGuardRejectsUnderlyingDeletionBeforeWrapperIsMarked(t *testing.T) {
+	ctx := context.Background()
+	keys, err := accountdata.NewRandom()
+	require.NoError(t, err)
+	master, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	payload, err := spacepayloads.StoragePayloadForSpaceCreate(spacepayloads.SpaceCreatePayload{SigningKey: keys.SignKey, SpaceType: "space", ReplicationKey: 10, MasterKey: master, ReadKey: crypto.NewAES(), MetadataKey: metadata, Metadata: []byte("native deletion interleaving fixture")})
+	require.NoError(t, err)
+	db, err := anystore.Open(ctx, filepath.Join(t.TempDir(), "native.db"), &anystore.Config{ReadConnections: 2})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	sp, err := spacestorage.Create(ctx, db, payload)
+	require.NoError(t, err)
+	as, err := sp.AclStorage()
+	require.NoError(t, err)
+	acl, err := list.BuildAclListWithIdentity(keys, as, recordverifier.NewValidateFull())
+	require.NoError(t, err)
+	_, root, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), nil).BuildRoot(objecttree.InitialContent{PrivKey: keys.SignKey, AclHeadId: payload.AclWithId.Id, SpaceId: sp.Id(), ChangeType: "native-delete-target", Seed: []byte("disposable-target")})
+	require.NoError(t, err)
+	storage, err := sp.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{RootRawChange: root, Heads: []string{root.Id}})
+	require.NoError(t, err)
+	tree, err := objecttree.BuildObjectTree(storage, acl)
+	require.NoError(t, err)
+	tree.Lock()
+	t.Cleanup(func() { tree.Unlock(); _ = tree.Close() })
+	wrapped := &Object{tree: tree}
+	require.NoError(t, wrapped.GuardReadyLocked(ctx))
+	// This is the real native tombstone, before the SDK's separate MarkDeleted
+	// call. The wrapper deliberately still reports deleted=false.
+	require.NoError(t, tree.Delete())
+	require.False(t, wrapped.deleted)
+	require.Error(t, wrapped.GuardReadyLocked(ctx), "native deletion must invalidate the target before any carrier append")
+}
