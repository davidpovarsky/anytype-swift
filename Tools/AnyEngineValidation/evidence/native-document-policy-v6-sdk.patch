+)
+
+func TestNativeCurrentWriterBootstrapAndBlockCreationFinalFence(t *testing.T) {
+	for _, dataset := range []string{"objects", "editor_blocks"} {
+		t.Run(dataset, func(t *testing.T) {
+			for _, mode := range []string{"revocation", "head advance", "cancellation"} {
+				t.Run(mode, func(t *testing.T) {
+					o := newObjectRowCASFixture(t)
+					writer := blockAddWriter(t, o)
+					o.signKey = writer
+					var ch crdt.Change
+					if dataset == "objects" {
+						ch = casChange(t, o, "fresh bootstrap", true)
+					} else {
+						ch = conditionalBlockChange(t, "fresh block", true)
+					}
+					before := append([]string(nil), o.tree.Heads()...)
+					ctx, cancel := context.WithCancel(context.Background())
+					defer cancel()
+					prepared := ""
+					o.tree = &blockCommitInterceptor{ObjectTree: o.tree, prepared: func(change objecttree.StorageChange) error {
+						prepared = change.Id
+						switch mode {
+						case "revocation":
+							blockRemoveWriter(t, o, writer)
+						case "head advance":
+							_ = blockAddWriter(t, o)
+						case "cancellation":
+							cancel()
+						}
+						return nil
+					}}
+					_, err := o.LocalWriteCurrentWriter(ctx, ch)
+					switch mode {
+					case "revocation":
+						require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+					case "head advance":
+						require.ErrorIs(t, err, commitguard.ErrNativeACLChanged)
+					case "cancellation":
+						require.ErrorIs(t, err, context.Canceled)
+					}
+					require.NotEmpty(t, prepared)
+					require.Equal(t, before, o.tree.Heads())
+					stored, readErr := o.tree.Storage().Has(context.Background(), prepared)
+					require.NoError(t, readErr)
+					require.False(t, stored)
+					row, readErr := o.ctrl.GuardLookup(context.Background(), dataset, ch.Records[0].Id)
+					require.NoError(t, readErr)
+					require.Nil(t, row)
+				})
+			}
+		})
+	}
+}
+
+func TestNativeCurrentWriterBlockCreationRejectsNativeTombstoneWindow(t *testing.T) {
+	o := newObjectRowCASFixture(t)
+	o.tree.Lock()
+	err := o.tree.Delete()
+	o.tree.Unlock()
+	require.NoError(t, err)
+	require.False(t, o.deleted, "native delete precedes SDK callback")
+	_, err = o.LocalWriteCurrentWriter(context.Background(), conditionalBlockChange(t, "must not resurrect target", true))
+	require.Error(t, err)
+}
+
+func TestNativeCurrentWriterBootstrapAndBlockCreationSuccess(t *testing.T) {
+	o := newObjectRowCASFixture(t)
+	ctx := context.Background()
+	seeded, err := o.LocalWriteCurrentWriter(ctx, casChange(t, o, "ordinary object", true))
+	require.NoError(t, err)
+	require.NotEmpty(t, seeded.ChangeId)
+	added, err := o.LocalWriteCurrentWriter(ctx, conditionalBlockChange(t, "ordinary block", true))
+	require.NoError(t, err)
+	require.NotEmpty(t, added.ChangeId)
+	require.Equal(t, "ordinary object", o.ctrl.Get(ctx, "objects", o.Id()).GetString("name"))
+	require.Equal(t, "ordinary block", o.ctrl.Get(ctx, "editor_blocks", "stable-native-block").GetString("text"))
+}
diff --git a/internal/object/current_writer.go b/internal/object/current_writer.go
new file mode 100644
index 0000000..2007d8e
--- /dev/null
+++ b/internal/object/current_writer.go
@@ -0,0 +1,45 @@
+package object
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+)
+
+// currentWriterNoop is called only after the caller has taken the native tree
+// lock, caught up its projection, checked the dataset sequence and run local
+// validation. An empty patch must not bypass authority or append a fake edit.
+func (o *Object) currentWriterNoop(ctx context.Context, ch crdt.Change) (WriteResult, bool, error) {
+	if len(ch.Records) == 0 {
+		return WriteResult{}, false, crdt.ErrValidation
+	}
+	for _, record := range ch.Records {
+		if len(record.Ops) != 0 {
+			return WriteResult{}, false, nil
+		}
+	}
+	ids := make([]string, 0, len(ch.Records))
+	for _, record := range ch.Records {
+		if record.Id == "" || record.Upsert {
+			return WriteResult{}, true, crdt.ErrValidation
+		}
+		row, err := o.ctrl.Lookup(ctx, ch.Dataset, record.Id)
+		if err != nil {
+			return WriteResult{}, true, err
+		}
+		if row == nil || row.Get(crdt.DeletedAtField) != nil {
+			return WriteResult{}, true, fmt.Errorf("%w: conditional empty patch requires an existing record", crdt.ErrValidation)
+		}
+		ids = append(ids, record.Id)
+	}
+	if o.signKey == nil {
+		return WriteResult{}, true, commitguard.ErrNativeCommitGuard
+	}
+	if err := commitguard.CheckCurrentWrite(ctx, o.tree, o.signKey.GetPublic()); err != nil {
+		return WriteResult{}, true, err
+	}
+	o.ctrl.StoreIds(ch.Dataset, ids)
+	return WriteResult{RecordIds: ids}, true, nil
+}
