+package spaceobjects
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	nativeStore "github.com/anyproto/any-store"
+	projectionStore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/internal/schema"
+	"github.com/anyproto/any-sync-sdk/internal/types"
+	"github.com/anyproto/any-sync/commonspace/object/accountdata"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/acl/recordverifier"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/synctree/updatelistener"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/commonspace/spacepayloads"
+	"github.com/anyproto/any-sync/commonspace/spacestorage"
+	"github.com/anyproto/any-sync/util/crypto"
+	"github.com/stretchr/testify/require"
+)
+
+type definitionLockTracker struct {
+	objecttree.ObjectTree
+	held atomic.Int32
+}
+
+func (t *definitionLockTracker) Lock()   { t.ObjectTree.Lock(); t.held.Add(1) }
+func (t *definitionLockTracker) Unlock() { t.held.Add(-1); t.ObjectTree.Unlock() }
+
+type definitionStorageObserver struct {
+	objecttree.Storage
+	observe func()
+}
+
+func (s *definitionStorageObserver) AddAll(ctx context.Context, changes []objecttree.StorageChange, heads []string, snapshot string) error {
+	s.observe()
+	err := s.Storage.AddAll(ctx, changes, heads, snapshot)
+	s.observe()
+	return err
+}
+
+type definitionFixture struct {
+	store         *Store
+	objects       map[string]*object.Object
+	trackers      map[string]*definitionLockTracker
+	target, owner *object.Object
+	beforeStorage func()
+}
+
+func newDefinitionFixture(t *testing.T) *definitionFixture {
+	t.Helper()
+	ctx := context.Background()
+	keys, err := accountdata.NewRandom()
+	require.NoError(t, err)
+	master, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	payload, err := spacepayloads.StoragePayloadForSpaceCreate(spacepayloads.SpaceCreatePayload{SigningKey: keys.SignKey, SpaceType: "space", ReplicationKey: 10, MasterKey: master, ReadKey: crypto.NewAES(), MetadataKey: metadata, Metadata: []byte("native definition fence fixture")})
+	require.NoError(t, err)
+	native, err := nativeStore.Open(ctx, filepath.Join(t.TempDir(), "native.db"), &nativeStore.Config{ReadConnections: 2})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, native.Close()) })
+	sp, err := spacestorage.Create(ctx, native, payload)
+	require.NoError(t, err)
+	as, err := sp.AclStorage()
+	require.NoError(t, err)
+	acl, err := list.BuildAclListWithIdentity(keys, as, recordverifier.NewValidateFull())
+	require.NoError(t, err)
+	db, err := projectionStore.Open(ctx, filepath.Join(t.TempDir(), "projection.db"), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	shared, err := db.Collection(ctx, "objects")
+	require.NoError(t, err)
+	f := &definitionFixture{store: &Store{spaceId: sp.Id(), db: db, moduleInfos: types.NewModules(types.ModuleInfo{Name: "editor", Canonical: "editor_blocks"})}, objects: map[string]*object.Object{}, trackers: map[string]*definitionLockTracker{}}
+	makeObject := func(seed string) *object.Object {
+		_, root, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), nil).BuildRoot(objecttree.InitialContent{PrivKey: keys.SignKey, AclHeadId: payload.AclWithId.Id, SpaceId: sp.Id(), ChangeType: "object", Seed: []byte(seed)})
+		require.NoError(t, err)
+		storage, err := sp.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{RootRawChange: root, Heads: []string{root.Id}})
+		require.NoError(t, err)
+		observed := &definitionStorageObserver{Storage: storage, observe: func() {
+			if f.beforeStorage != nil {
+				f.beforeStorage()
+			}
+		}}
+		tree, err := commitguard.Builder(nil)(observed, acl)
+		require.NoError(t, err)
+		tracker := &definitionLockTracker{ObjectTree: tree}
+		f.trackers[root.Id] = tracker
+		controller, err := crdt.NewControllerWithShared(ctx, root.Id, db, crdt.SharedCollections{"objects": shared}, crdt.HandlerReg{Name: "objects", Handler: crdt.DefaultHandler{}, Schema: schema.Dataset{Dynamic: true}}, crdt.HandlerReg{Name: "datasets", Handler: crdt.DefaultHandler{}, Schema: schema.Dataset{Dynamic: true}}, crdt.HandlerReg{Name: "editor_blocks", Handler: crdt.DefaultHandler{}, Schema: schema.Dataset{Dynamic: true}})
+		require.NoError(t, err)
+		controller.SetApplySeqAllocator(crdt.NewApplySeqAllocator(nil))
+		obj, err := object.New(object.Config{SpaceId: sp.Id(), SignKey: keys.SignKey, Controller: controller, LockLocalWrite: func(ctx context.Context, carrier *object.Object, ch *crdt.Change) (crdt.LocalReadView, func(), error) {
+			return f.store.lockPreparedNativeObjects(ctx, f.objects, carrier)
+		}}, func(updatelistener.UpdateListener) (objecttree.ObjectTree, error) { return tracker, nil })
+		require.NoError(t, err)
+		f.objects[obj.Id()] = obj
+		t.Cleanup(func() { require.NoError(t, tree.Close()) })
+		return obj
+	}
+	f.owner = makeObject("custom document type")
+	f.target = makeObject("ordinary document")
+	seed := func(obj *object.Object, dataset, id string, value *anyenc.Value) {
+		_, err := obj.LocalWrite(ctx, crdt.Change{Dataset: dataset, DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: id, Upsert: true, Ops: []crdt.Op{{Type: crdt.OpSet, Payload: value}}}}})
+		require.NoError(t, err)
+	}
+	arena := &anyenc.Arena{}
+	row := func(typeID string) *anyenc.Value {
+		v := arena.NewObject()
+		v.Set("spaceId", arena.NewString(sp.Id()))
+		a := arena.NewObject()
+		a.Set("type", arena.NewString(typeID))
+		v.Set("any", a)
+		return v
+	}
+	seed(f.owner, "objects", f.owner.Id(), row("__type__"))
+	seed(f.target, "objects", f.target.Id(), row(f.owner.Id()))
+	seed(f.owner, "datasets", "body", anyenc.MustParseJson(`{"def":"part","key":"body"}`))
+	seed(f.owner, "datasets", "canonical", anyenc.MustParseJson(`{"def":"dataset","key":"editor_blocks","module":"editor","shared":true,"part":"body"}`))
+	return f
+}
+
+func TestNativeDefinitionPolicyUsesCompiledCanonicalModule(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	check := func() bool {
+		view, unlock, err := f.store.lockPreparedNativeObjects(ctx, f.objects, f.target)
+		require.NoError(t, err)
+		defer unlock()
+		yes, err := view.(crdt.NativeTypeDefinitionView).TypeDeclaresDataset(f.owner.Id(), "editor", "editor_blocks", true)
+		require.NoError(t, err)
+		return yes
+	}
+	require.True(t, check())
+	_, err := f.owner.LocalWrite(ctx, crdt.Change{Dataset: "datasets", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: "canonical", Ops: []crdt.Op{{Type: crdt.OpSet, Path: []string{"shared"}, Payload: anyenc.MustParseJson(`false`)}}}}})
+	require.NoError(t, err)
+	require.False(t, check(), "a namespaced dataset is not the canonical body")
+	_, err = f.owner.LocalWrite(ctx, crdt.Change{Dataset: "datasets", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: "canonical", Ops: []crdt.Op{{Type: crdt.OpDelete}}}}})
+	require.NoError(t, err)
+	require.False(t, check(), "a removed module declaration is not eligible")
+}
+
+func TestNativeDefinitionCallbackAndActualAppendKeepOwnerLocked(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	callback := false
+	storageChecks := 0
+	assertLocks := func() {
+		for _, tracker := range f.trackers {
+			require.EqualValues(t, 1, tracker.held.Load())
+		}
+	}
+	f.beforeStorage = func() { assertLocks(); storageChecks++ }
+	change := crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", NativeObjectPolicy: true, NativeDefinitionOwners: []string{f.owner.Id()}, Records: []crdt.RecordChange{{Id: f.target.Id(), Ops: []crdt.Op{{Type: crdt.OpSet, Payload: anyenc.MustParseJson(`{"any.name":"protected"}`)}}}}}
+	change.NativeDefinitionValidation = func() error { assertLocks(); callback = true; return nil }
+	result, err := f.target.LocalWriteCurrentWriter(ctx, change)
+	require.NoError(t, err)
+	require.NotEmpty(t, result.ChangeId)
+	require.True(t, callback)
+	require.Equal(t, 2, storageChecks)
+	for _, tracker := range f.trackers {
+		require.Zero(t, tracker.held.Load())
+	}
+	before := append([]string(nil), f.target.Tree().Heads()...)
+	refused := errors.New("current descriptor refuses value")
+	change.NativeDefinitionValidation = func() error { assertLocks(); return refused }
+	_, err = f.target.LocalWriteCurrentWriter(ctx, change)
+	require.ErrorIs(t, err, refused)
+	require.Equal(t, before, f.target.Tree().Heads())
+	require.Equal(t, 2, storageChecks)
+}
+
+func TestNativeDefinitionDeletionBeforeSDKCallbackRefusesAppend(t *testing.T) {
+	f := newDefinitionFixture(t)
+	f.owner.Tree().Lock()
+	err := f.owner.Tree().Delete()
+	f.owner.Tree().Unlock()
+	require.NoError(t, err)
+	before := append([]string(nil), f.target.Tree().Heads()...)
+	_, err = f.target.LocalWriteCurrentWriter(context.Background(), crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", NativeObjectPolicy: true, Records: []crdt.RecordChange{{Id: f.target.Id(), Ops: []crdt.Op{{Type: crdt.OpSet, Payload: anyenc.MustParseJson(`{"any.name":"must not commit"}`)}}}}})
+	require.Error(t, err)
+	require.Equal(t, before, f.target.Tree().Heads())
+}
+
+func TestNativeDefinitionRequiredDocumentDatasetCannotRaceTypePicker(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	view, unlock, err := f.store.lockPreparedNativeObjects(ctx, f.objects, f.target)
+	require.NoError(t, err)
+	eligible, err := view.(crdt.NativeTypeDefinitionView).TypeDeclaresDataset(f.owner.Id(), "editor", "editor_blocks", true)
+	unlock()
+	require.NoError(t, err)
+	require.True(t, eligible, "the picker initially proved an eligible destination")
+	_, err = f.owner.LocalWrite(ctx, crdt.Change{Dataset: "datasets", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: "canonical", Ops: []crdt.Op{{Type: crdt.OpDelete}}}}})
+	require.NoError(t, err)
+	arena := &anyenc.Arena{}
+	payload := arena.NewObject()
+	payload.Set("any.type", arena.NewString(f.owner.Id()))
+	before := append([]string(nil), f.target.Tree().Heads()...)
+	callback := false
+	_, err = f.target.LocalWriteCurrentWriter(ctx, crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", NativeObjectPolicy: true,
+		NativeTypeDatasets:         []crdt.NativeTypeDatasetRequirement{{Module: "editor", Dataset: "editor_blocks", Canonical: true}},
+		NativeDefinitionValidation: func() error { callback = true; return nil },
+		Records:                    []crdt.RecordChange{{Id: f.target.Id(), Ops: []crdt.Op{{Type: crdt.OpSet, Payload: payload}}}}})
+	require.ErrorIs(t, err, crdt.ErrPreconditionFailed)
+	require.False(t, callback)
+	require.Equal(t, before, f.target.Tree().Heads(), "the same Type ID is still live, but its missing editor must refuse before append")
+}
