+package spaceimpl
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+func checkCurrentWriterBatch(batch space.ModifyBatch) error {
+	if !batch.RequireCurrentWriterFence {
+		return nil
+	}
+	if batch.IfUnchangedSince == nil || batch.IfObjectUnchangedSince != nil ||
+		(batch.Scope != 0 && batch.Scope != space.ScopeSynced) || batch.Dataset == "objects" || len(batch.Records) == 0 {
+		return fmt.Errorf("%w: current writer fence requires a conditional synced dataset batch", crdt.ErrValidation)
+	}
+	return nil
+}
+
+func (s *spaceImpl) localWriteRetryCurrentWriter(ctx context.Context, obj *object.Object, objectID string, ch crdt.Change, seq *uint64) (object.WriteResult, error) {
+	result, err := obj.LocalWriteIfCurrentWriter(ctx, ch, seq)
+	if !errors.Is(err, object.ErrClosed) {
+		return result, wrapSlotErr(err)
+	}
+	fresh, err := s.store.Get(ctx, objectID)
+	if err != nil {
+		return object.WriteResult{}, err
+	}
+	result, err = fresh.LocalWriteIfCurrentWriter(ctx, ch, seq)
+	return result, wrapSlotErr(err)
+}
+
+func (s *spaceImpl) localWriteRetryNativeWriter(ctx context.Context, obj *object.Object, objectID string, ch crdt.Change) (object.WriteResult, error) {
+	result, err := obj.LocalWriteCurrentWriter(ctx, ch)
+	if !errors.Is(err, object.ErrClosed) {
+		return result, wrapSlotErr(err)
+	}
+	fresh, err := s.store.Get(ctx, objectID)
+	if err != nil {
+		return object.WriteResult{}, err
+	}
+	result, err = fresh.LocalWriteCurrentWriter(ctx, ch)
+	return result, wrapSlotErr(err)
+}
