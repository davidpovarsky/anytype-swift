+package object
+
+import (
+	"context"
+	"testing"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync/commonspace/object/accountdata"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/consensus/consensusproto"
+	"github.com/anyproto/any-sync/util/cidutil"
+	"github.com/anyproto/any-sync/util/crypto"
+	"github.com/stretchr/testify/require"
+)
+
+func conditionalBlockChange(t *testing.T, text string, upsert bool) crdt.Change {
+	t.Helper()
+	return crdt.Change{Dataset: "editor_blocks", DataVersion: "block-fence-v1", Records: []crdt.RecordChange{{Id: "stable-native-block", Upsert: upsert, Ops: []crdt.Op{recordOp(t, "text", text)}}}}
+}
+
+func blockACLRecord(t *testing.T, acl list.AclList, build func() (*consensusproto.RawRecord, error)) {
+	t.Helper()
+	acl.Lock()
+	defer acl.Unlock()
+	record, err := build()
+	require.NoError(t, err)
+	raw, err := record.MarshalVT()
+	require.NoError(t, err)
+	id, err := cidutil.NewCidFromBytes(raw)
+	require.NoError(t, err)
+	require.NoError(t, acl.AddRawRecord(&consensusproto.RawRecordWithId{Id: id, Payload: raw}))
+}
+
+func blockAddWriter(t *testing.T, o *Object) crypto.PrivKey {
+	t.Helper()
+	member, err := accountdata.NewRandom()
+	require.NoError(t, err)
+	acl := o.tree.AclList()
+	blockACLRecord(t, acl, func() (*consensusproto.RawRecord, error) {
+		return acl.RecordBuilder().BuildAccountsAdd(list.AccountsAddPayload{Additions: []list.AccountAdd{{Identity: member.SignKey.GetPublic(), Permissions: list.AclPermissionsWriter, Metadata: []byte("synthetic block writer")}}})
+	})
+	return member.SignKey
+}
+
+func blockRemoveWriter(t *testing.T, o *Object, key crypto.PrivKey) {
+	t.Helper()
+	metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	acl := o.tree.AclList()
+	blockACLRecord(t, acl, func() (*consensusproto.RawRecord, error) {
+		return acl.RecordBuilder().BuildAccountRemove(list.AccountRemovePayload{Identities: []crypto.PubKey{key.GetPublic()}, Change: list.ReadKeyChangePayload{MetadataKey: metadata, ReadKey: crypto.NewAES()}})
+	})
+}
+
+// This test-only interceptor runs after real any-sync signing/encryption and
+// before its real AnyStore append. The object and storage remain native; the
+// interceptor is not an in-memory substitute for permission or commit logic.
+type blockCommitInterceptor struct {
+	objecttree.ObjectTree
+	prepared func(objecttree.StorageChange) error
+}
+
+func (t *blockCommitInterceptor) AddContent(ctx context.Context, content objecttree.SignableChangeContent) (objecttree.AddResult, error) {
+	return t.ObjectTree.AddContentWithValidator(ctx, content, t.prepared)
+}
+
+func TestNativeConditionalBlockFinalWriterFence(t *testing.T) {
+	for _, mode := range []string{"revocation", "head advance", "cancellation"} {
+		t.Run(mode, func(t *testing.T) {
+			o := newObjectRowCASFixture(t)
+			writer := blockAddWriter(t, o)
+			o.signKey = writer
+			seed, err := o.LocalWrite(context.Background(), conditionalBlockChange(t, "before", true))
+			require.NoError(t, err)
+			before := append([]string(nil), o.tree.Heads()...)
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			prepared := ""
+			o.tree = &blockCommitInterceptor{ObjectTree: o.tree, prepared: func(change objecttree.StorageChange) error {
+				prepared = change.Id
+				switch mode {
+				case "revocation":
+					blockRemoveWriter(t, o, writer)
+				case "head advance":
+					_ = blockAddWriter(t, o)
+				case "cancellation":
+					cancel()
+				}
+				return nil
+			}}
+			_, err = o.LocalWriteIfCurrentWriter(ctx, conditionalBlockChange(t, "must never commit", false), &seed.ApplySeq)
+			switch mode {
+			case "revocation":
+				require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+			case "head advance":
+				require.ErrorIs(t, err, commitguard.ErrNativeACLChanged)
+			case "cancellation":
+				require.ErrorIs(t, err, context.Canceled)
+			}
+			require.NotEmpty(t, prepared)
+			require.Equal(t, before, o.tree.Heads())
+			stored, readErr := o.tree.Storage().Has(context.Background(), prepared)
+			require.NoError(t, readErr)
+			require.False(t, stored)
+			require.Equal(t, "before", o.ctrl.Get(context.Background(), "editor_blocks", "stable-native-block").GetString("text"))
+		})
+	}
+}
+
+func TestNativeConditionalBlockEmptyPatchChecksSequenceAndWriter(t *testing.T) {
+	ctx := context.Background()
+	o := newObjectRowCASFixture(t)
+	writer := blockAddWriter(t, o)
+	o.signKey = writer
+	seed, err := o.LocalWrite(ctx, conditionalBlockChange(t, "before", true))
+	require.NoError(t, err)
+	empty := conditionalBlockChange(t, "", false)
+	empty.Records[0].Ops = nil
+	heads := append([]string(nil), o.tree.Heads()...)
+	noop, err := o.LocalWriteIfCurrentWriter(ctx, empty, &seed.ApplySeq)
+	require.NoError(t, err)
+	require.Equal(t, []string{"stable-native-block"}, noop.RecordIds)
+	require.Empty(t, noop.ChangeId)
+	require.Empty(t, noop.VersionId)
+	require.Zero(t, noop.ApplySeq)
+	require.Equal(t, heads, o.tree.Heads())
+	next, err := o.LocalWriteIfCurrentWriter(ctx, conditionalBlockChange(t, "after", false), &seed.ApplySeq)
+	require.NoError(t, err)
+	_, err = o.LocalWriteIfCurrentWriter(ctx, empty, &seed.ApplySeq)
+	require.ErrorIs(t, err, crdt.ErrPreconditionFailed)
+	heads = append([]string(nil), o.tree.Heads()...)
+	blockRemoveWriter(t, o, writer)
+	_, err = o.LocalWriteIfCurrentWriter(ctx, empty, &next.ApplySeq)
+	require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+	require.Equal(t, heads, o.tree.Heads())
+}
+
+func TestNativeConditionalBlockRefusesDeletedTreeBeforeSDKCallback(t *testing.T) {
+	ctx := context.Background()
+	o := newObjectRowCASFixture(t)
+	seed, err := o.LocalWrite(ctx, conditionalBlockChange(t, "before", true))
+	require.NoError(t, err)
+	o.tree.Lock()
+	err = o.tree.Delete()
+	o.tree.Unlock()
+	require.NoError(t, err)
+	require.False(t, o.deleted, "exercise the window before the SDK MarkDeleted callback")
+	_, err = o.LocalWriteIfCurrentWriter(ctx, conditionalBlockChange(t, "must never commit", false), &seed.ApplySeq)
+	require.Error(t, err)
+}
