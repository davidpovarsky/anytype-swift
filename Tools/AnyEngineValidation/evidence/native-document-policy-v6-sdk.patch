+
+// This fixture uses actual signed/encrypted native history and both real
+// stores. A fake AddContent cannot establish the conditional storage fence.
+func newObjectRowCASFixture(t *testing.T) *Object {
+	t.Helper()
+	ctx := context.Background()
+	keys, err := accountdata.NewRandom()
+	require.NoError(t, err)
+	master, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+	require.NoError(t, err)
+	payload, err := spacepayloads.StoragePayloadForSpaceCreate(spacepayloads.SpaceCreatePayload{SigningKey: keys.SignKey, SpaceType: "space", ReplicationKey: 10, MasterKey: master, ReadKey: crypto.NewAES(), MetadataKey: metadata, Metadata: []byte("disposable objects CAS fixture")})
+	require.NoError(t, err)
+	native, err := nativeStore.Open(ctx, filepath.Join(t.TempDir(), "native.db"), &nativeStore.Config{ReadConnections: 2})
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, native.Close()) })
+	sp, err := spacestorage.Create(ctx, native, payload)
+	require.NoError(t, err)
+	as, err := sp.AclStorage()
+	require.NoError(t, err)
+	acl, err := list.BuildAclListWithIdentity(keys, as, recordverifier.NewValidateFull())
+	require.NoError(t, err)
+	_, root, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), nil).BuildRoot(objecttree.InitialContent{PrivKey: keys.SignKey, AclHeadId: payload.AclWithId.Id, SpaceId: sp.Id(), ChangeType: "object-row-cas", Seed: []byte("disposable ordinary page")})
+	require.NoError(t, err)
+	storage, err := sp.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{RootRawChange: root, Heads: []string{root.Id}})
+	require.NoError(t, err)
+	tree, err := commitguard.Builder(nil)(storage, acl)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, tree.Close()) })
+	db, err := projectionStore.Open(ctx, filepath.Join(t.TempDir(), "projection.db"), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, db.Close()) })
+	coll, err := db.Collection(ctx, "objects")
+	require.NoError(t, err)
+	ctrl, err := crdt.NewControllerWithShared(ctx, tree.Id(), db, crdt.SharedCollections{"objects": coll}, crdt.HandlerReg{Name: "objects", Handler: crdt.DefaultHandler{}, Schema: schema.Dataset{Dynamic: true}}, crdt.HandlerReg{Name: "editor_blocks", Handler: crdt.DefaultHandler{}, Schema: schema.Dataset{Dynamic: true}})
+	require.NoError(t, err)
+	ctrl.SetApplySeqAllocator(crdt.NewApplySeqAllocator(nil))
+	return &Object{signKey: keys.SignKey, codec: NewCodec(), ctrl: ctrl, spaceId: sp.Id(), tree: tree}
+}
+
+func casChange(t *testing.T, o *Object, value string, upsert bool) crdt.Change {
+	t.Helper()
+	return crdt.Change{Dataset: "objects", DataVersion: "cas-fixture-v1", Records: []crdt.RecordChange{{Id: o.Id(), Upsert: upsert, Ops: []crdt.Op{recordOp(t, "name", value)}}}}
+}
+
+func TestNativeObjectRowCASRejectsABAAndFutureStamp(t *testing.T) {
+	ctx := context.Background()
+	o := newObjectRowCASFixture(t)
+	a, err := o.LocalWrite(ctx, casChange(t, o, "A", true))
+	require.NoError(t, err)
+	require.NotZero(t, a.ApplySeq)
+	b, err := o.LocalWriteIfObject(ctx, casChange(t, o, "B", false), a.ApplySeq)
+	require.NoError(t, err)
+	again, err := o.LocalWriteIfObject(ctx, casChange(t, o, "A", false), b.ApplySeq)
+	require.NoError(t, err)
+	require.Equal(t, "A", o.ctrl.Get(ctx, "objects", o.Id()).GetString("name"))
+	before := append([]string(nil), o.tree.Heads()...)
+	for _, seq := range []uint64{a.ApplySeq, again.ApplySeq + 1, 0} {
+		_, err = o.LocalWriteIfObject(ctx, casChange(t, o, "must not commit", false), seq)
+		require.ErrorIs(t, err, crdt.ErrPreconditionFailed)
+		require.Equal(t, before, o.tree.Heads())
+	}
+	require.Equal(t, "A", o.ctrl.Get(ctx, "objects", o.Id()).GetString("name"))
+}
+
+func TestNativeObjectRowCASFourCompetingWriters(t *testing.T) {
+	ctx := context.Background()
+	o := newObjectRowCASFixture(t)
+	first, err := o.LocalWrite(ctx, casChange(t, o, "initial", true))
+	require.NoError(t, err)
+	start := make(chan struct{})
+	results := make(chan error, 4)
+	var group sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		change := casChange(t, o, fmt.Sprintf("writer-%d", i), false)
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			<-start
+			_, err := o.LocalWriteIfObject(ctx, change, first.ApplySeq)
+			results <- err
+		}()
+	}
+	close(start)
+	group.Wait()
+	close(results)
+	success, stale := 0, 0
+	for err := range results {
+		if err == nil {
+			success++
+		} else {
+			require.ErrorIs(t, err, crdt.ErrPreconditionFailed)
+			stale++
+		}
+	}
+	require.Equal(t, 1, success)
+	require.Equal(t, 3, stale)
+	// Seed + one winner, with no signed changes from the three stale calls.
+	require.Equal(t, first.ApplySeq+1, uint64(o.ctrl.Get(ctx, "objects", o.Id()).GetInt(crdt.ApplySeqField)))
+}
+
+func TestNativeObjectRowCASMissingRowAndIdentityGuards(t *testing.T) {
+	ctx := context.Background()
+	o := newObjectRowCASFixture(t)
+	_, err := o.LocalWriteIfObject(ctx, casChange(t, o, "missing", false), 1)
+	require.ErrorIs(t, err, crdt.ErrPreconditionFailed)
+	seed, err := o.LocalWrite(ctx, casChange(t, o, "seed", true))
+	require.NoError(t, err)
+	before := append([]string(nil), o.tree.Heads()...)
+	for _, mode := range []string{"foreign row", "upsert", "two rows", "other dataset", "delete"} {
+		ch := casChange(t, o, "refused", false)
+		switch mode {
+		case "foreign row":
+			ch.Records[0].Id = "foreign"
+		case "upsert":
+			ch.Records[0].Upsert = true
+		case "two rows":
+			ch.Records = append(ch.Records, ch.Records[0])
+		case "other dataset":
+			ch.Dataset = "other"
+		case "delete":
+			ch.Records[0].Ops = []crdt.Op{{Type: crdt.OpDelete}}
+		}
+		_, err = o.LocalWriteIfObject(ctx, ch, seed.ApplySeq)
+		require.ErrorIs(t, err, crdt.ErrValidation, mode)
+		require.Equal(t, before, o.tree.Heads())
+	}
+}
