+)
+
+func pinkhaPropertiesSnapshot(t *testing.T, e http.Handler, sid, oid string) (json.RawMessage, map[string]any) {
+	t.Helper()
+	result := doJSON(t, e, http.MethodGet, "/v1/spaces/"+sid+"/properties/"+oid, "")
+	if result.Code != http.StatusOK {
+		t.Fatalf("property read: %d %s", result.Code, result.Body.String())
+	}
+	var response struct {
+		Record map[string]json.RawMessage `json:"record"`
+	}
+	if err := json.Unmarshal(result.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	version := response.Record["_ver"]
+	var record map[string]any
+	raw, _ := json.Marshal(response.Record)
+	if err := json.Unmarshal(raw, &record); err != nil {
+		t.Fatal(err)
+	}
+	if len(version) == 0 || response.Record["_applySeq"] == nil {
+		t.Fatal("missing native property metadata")
+	}
+	return append(json.RawMessage(nil), version...), record
+}
+
+func pinkhaPropertyBody(version json.RawMessage, run string, title string) string {
+	raw, _ := json.Marshal(map[string]any{
+		"patch": map[string]any{"name": title}, "ifVersion": version, "ifStartedAt": run,
+	})
+	return string(raw)
+}
+
+func TestPinkhaPropertyCASVersionAndABA(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "PinkhaPropertiesABA")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"A","description":"keep"}}}`)
+	path := "/v1/spaces/" + sp.Id + "/pinkha/properties/" + oid + "/set/any"
+	old, _ := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	body := pinkhaPropertyBody(old, d.startedAt.Format(time.RFC3339Nano), "B")
+	first := doJSON(t, e, http.MethodPost, path, body)
+	if first.Code != http.StatusOK {
+		t.Fatalf("conditional write: %d %s", first.Code, first.Body.String())
+	}
+	var receipt struct {
+		VersionID         string          `json:"versionId"`
+		EngineStartedAt   string          `json:"engineStartedAt"`
+		PropertiesVersion json.RawMessage `json:"propertiesVersion"`
+	}
+	if err := json.Unmarshal(first.Body.Bytes(), &receipt); err != nil {
+		t.Fatal(err)
+	}
+	if receipt.VersionID == "" || receipt.EngineStartedAt != d.startedAt.Format(time.RFC3339Nano) || len(receipt.PropertiesVersion) == 0 {
+		t.Fatalf("missing bound receipt: %s", first.Body.String())
+	}
+	back := doJSON(t, e, http.MethodPost, "/v1/spaces/"+sp.Id+"/properties/"+oid+"/set/any",
+		`{"patch":{"name":"A"}}`)
+	if back.Code != http.StatusOK {
+		t.Fatalf("native restore: %d %s", back.Code, back.Body.String())
+	}
+	_, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	stale := doJSON(t, e, http.MethodPost, path, body)
+	if stale.Code != http.StatusConflict {
+		t.Fatalf("ABA accepted: %d %s", stale.Code, stale.Body.String())
+	}
+	_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	if !reflect.DeepEqual(before, after) {
+		t.Fatal("stale request mutated the object")
+	}
+	any := after["any"].(map[string]any)
+	if any["name"] != "A" || any["description"] != "keep" {
+		t.Fatal("unrelated properties lost")
+	}
+}
+
+func TestPinkhaPropertyCASConcurrentHasOneWinner(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "PinkhaPropertiesRace")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"initial"}}}`)
+	version, _ := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	path := "/v1/spaces/" + sp.Id + "/pinkha/properties/" + oid + "/set/any"
+	codes := make(chan int, 4)
+	for i := range 4 {
+		go func() {
+			body := pinkhaPropertyBody(version, d.startedAt.Format(time.RFC3339Nano), fmt.Sprintf("writer-%d", i))
+			codes <- doJSON(t, e, http.MethodPost, path, body).Code
+		}()
+	}
+	success, conflict := 0, 0
+	for range 4 {
+		switch code := <-codes; code {
+		case http.StatusOK:
+			success++
+		case http.StatusConflict:
+			conflict++
+		default:
+			t.Fatalf("unexpected status %d", code)
+		}
+	}
+	if success != 1 || conflict != 3 {
+		t.Fatalf("race: success=%d conflict=%d", success, conflict)
+	}
+}
+
+func TestPinkhaPropertyCASMalformedGuardsNeverWrite(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "PinkhaPropertiesGuards")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"original"}}}`)
+	version, before := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	run := d.startedAt.Format(time.RFC3339Nano)
+	valid := map[string]any{}
+	if err := json.Unmarshal([]byte(pinkhaPropertyBody(version, run, "bad")), &valid); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name   string
+		modify func(map[string]any)
+		code   int
+	}{
+		{"missing run", func(v map[string]any) { delete(v, "ifStartedAt") }, 400},
+		{"wrong run", func(v map[string]any) { v["ifStartedAt"] = "2000-01-01T00:00:00Z" }, 409},
+		{"missing version", func(v map[string]any) { delete(v, "ifVersion") }, 400},
+		{"numeric version", func(v map[string]any) { v["ifVersion"] = map[string]any{"name": 1} }, 400},
+		{"empty version", func(v map[string]any) { v["ifVersion"] = map[string]any{} }, 400},
+		{"unknown field", func(v map[string]any) { v["ifUnchanged"] = true }, 400},
+	}
+	path := "/v1/spaces/" + sp.Id + "/pinkha/properties/" + oid + "/set/any"
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			value := map[string]any{}
+			for key, item := range valid {
+				value[key] = item
+			}
+			test.modify(value)
+			raw, _ := json.Marshal(value)
+			result := doJSON(t, e, http.MethodPost, path, string(raw))
+			if result.Code != test.code {
+				t.Fatalf("status %d want %d: %s", result.Code, test.code, result.Body.String())
+			}
+			_, after := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+			if !reflect.DeepEqual(before, after) {
+				t.Fatal("invalid condition wrote")
+			}
+		})
+	}
+}
+
+func TestPinkhaPropertyCASDeletedTargetCannotReappear(t *testing.T) {
+	d, teardown := newTestDeps(t)
+	defer teardown()
+	e := buildEcho(d)
+	sp := createSpaceInfo(t, e, "PinkhaPropertiesDeleted")
+	oid := mustCreateObject(t, e, sp.Id, `{"type":"page","initialProperties":{"any":{"name":"original"}}}`)
+	version, _ := pinkhaPropertiesSnapshot(t, e, sp.Id, oid)
+	removed := doJSON(t, e, http.MethodDelete, "/v1/spaces/"+sp.Id+"/objects/"+oid, "")
+	if removed.Code != http.StatusOK && removed.Code != http.StatusNoContent {
+		t.Fatalf("delete %d", removed.Code)
+	}
+	result := doJSON(t, e, http.MethodPost, "/v1/spaces/"+sp.Id+"/pinkha/properties/"+oid+"/set/any",
+		pinkhaPropertyBody(version, d.startedAt.Format(time.RFC3339Nano), "resurrected"))
+	if result.Code < 400 {
+		t.Fatalf("deleted target accepted: %d %s", result.Code, result.Body.String())
+	}
+	read := doJSON(t, e, http.MethodGet, "/v1/spaces/"+sp.Id+"/objects/"+oid, "")
+	if read.Code < 400 {
+		t.Fatal("deleted target reappeared")
+	}
+}
