diff --git a/internal/editor/pinkha_patch.go b/internal/editor/pinkha_patch.go
new file mode 100644
index 0000000..e130333
--- /dev/null
+++ b/internal/editor/pinkha_patch.go
@@ -0,0 +1,58 @@
+package editor
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+)
+
+var ErrInvalidConditionalPatch = errors.New("blocks: invalid conditional patch")
+
+// ValidateConditionalPatch uses the SAME native field validators as replay,
+// but runs the entire patch before a DAG write. An invalid sibling op must
+// not cause a valid text edit to land behind an error response.
+// Ancestor/descendant and repeated paths are refused to avoid map-order effects.
+func ValidateConditionalPatch(in PatchInput) error {
+	paths := make([]string, 0, len(in.Set)+len(in.Unset))
+	invalid := func(err error) error { return errors.Join(ErrInvalidConditionalPatch, err) }
+	for path, raw := range in.Set {
+		if path == "" {
+			return invalid(errors.New("empty set path"))
+		}
+		payload, err := anyenc.ParseJson(string(raw))
+		if err != nil {
+			return invalid(err)
+		}
+		op := handler.Op{Type: handler.OpSet, Path: strings.Split(path, "."), Payload: payload}
+		if err := validateSet(&op); err != nil {
+			return invalid(err)
+		}
+		paths = append(paths, path)
+	}
+	for _, path := range in.Unset {
+		if path == "" {
+			return invalid(errors.New("empty unset path"))
+		}
+		op := handler.Op{Type: handler.OpUnset, Path: strings.Split(path, ".")}
+		if err := validateUnset(&op); err != nil {
+			return invalid(err)
+		}
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	for i, path := range paths {
+		for _, segment := range strings.Split(path, ".") {
+			if segment == "" {
+				return invalid(errors.New("empty path segment"))
+			}
+		}
+		if i > 0 && (path == paths[i-1] || strings.HasPrefix(path, paths[i-1]+".")) {
+			return invalid(fmt.Errorf("overlapping paths: %q", path))
+		}
+	}
+	return nil
+}
