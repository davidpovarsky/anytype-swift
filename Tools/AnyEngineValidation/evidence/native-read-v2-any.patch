+package markdown
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+// GetWithSequence returns the body version and exact write precondition from
+// ONE tombstone-inclusive native query. Callers must also bind the server run.
+func GetWithSequence(ctx context.Context, sp space.Space, objectID, collection string) (Document, uint64, error) {
+	gen, err := sp.Changes().Generation(ctx)
+	if err != nil {
+		return Document{}, 0, err
+	}
+	doc, _, seq, err := readDocument(ctx, sp, objectID, collection, gen)
+	return doc, seq, err
+}
diff --git a/internal/pinkha/claims/contract_test.go b/internal/pinkha/claims/contract_test.go
new file mode 100644
index 0000000..390fd8d
--- /dev/null
+++ b/internal/pinkha/claims/contract_test.go
@@ -0,0 +1,128 @@
+package claims
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/stretchr/testify/require"
+)
+
+func fixtureOperation(n int, payload string) Operation {
+	return Operation{Version: 1, SpaceID: "disposable-space", OperationID: fmt.Sprintf("%032x", n),
+		AuthorID: "disposable-account", Kind: Add,
+		Target: Target{ObjectID: "disposable-document", BlockID: "stable-block"},
+		Source: Source{ProviderID: "sefaria", CanonicalRef: "Genesis.1.1"}, Payload: []byte(payload), Observed: []string{}}
+}
+
+func fixtureClaim(t *testing.T, op Operation) Claim {
+	t.Helper()
+	c, err := Make(op)
+	require.NoError(t, err)
+	return c
+}
+
+func fixtureChange(t *testing.T, op Operation) handler.Change {
+	t.Helper()
+	c := fixtureClaim(t, op)
+	raw, err := json.Marshal(EncodeRecord(c))
+	require.NoError(t, err)
+	v, err := anyenc.ParseJson(string(raw))
+	require.NoError(t, err)
+	return handler.Change{SpaceId: op.SpaceID, ObjectId: "native-carrier", Dataset: Dataset,
+		DataVersion: DataVersion, ChangeId: "native-signed-change", ACLHeadId: "native-acl-head",
+		Creator: op.AuthorID, ObjectDerived: true, ObjectRootPayload: RootSeed(),
+		Records: []handler.RecordChange{{Id: c.RecordID(), Upsert: true,
+			Ops: []handler.Op{{Type: handler.OpSet, Payload: v}}}}}
+}
+
+func TestCanonicalBytesRemainHeartAndSwiftCompatible(t *testing.T) {
+	c := fixtureClaim(t, fixtureOperation(1, "א<>&\n"))
+	require.Equal(t, "89344c7ac74f7d5df8ef2a94f9592a7ed86a9dccc47084f8ce27d98080c29263/3652b732b88752a35184fcf1af80f8d3e499fb5e5e4132a8064e6236a54cd589", c.ID)
+	canonical, err := c.Operation.CanonicalBytes()
+	require.NoError(t, err)
+	require.Len(t, canonical, 188)
+	raw, err := json.Marshal(EncodeRecord(c))
+	require.NoError(t, err)
+	decoded, err := DecodeRecord(c.RecordID(), raw)
+	require.NoError(t, err)
+	require.Equal(t, c, decoded)
+	_, err = DecodeRecord(c.RecordID(), append(raw, []byte(" {}")...))
+	require.Error(t, err)
+}
+
+func TestSignedNativeEnvelopeRejectsForgedIdentityAndPayload(t *testing.T) {
+	h := NativeHandler{}
+	valid := fixtureChange(t, fixtureOperation(1, "opaque"))
+	require.NoError(t, h.ValidateNative(&valid))
+	cases := map[string]func(*handler.Change){
+		"wrong signer":                     func(ch *handler.Change) { ch.Creator = "other-account" },
+		"wrong space":                      func(ch *handler.Change) { ch.SpaceId = "other-space" },
+		"other derived carrier":            func(ch *handler.Change) { ch.ObjectRootPayload = []byte("builtin:bundleRoot:other") },
+		"ordinary created carrier":         func(ch *handler.Change) { ch.ObjectDerived = false },
+		"missing ACL provenance":           func(ch *handler.Change) { ch.ACLHeadId = "" },
+		"missing change provenance":        func(ch *handler.Change) { ch.ChangeId = "" },
+		"future protocol":                  func(ch *handler.Change) { ch.DataVersion = "unknown" },
+		"foreign record id":                func(ch *handler.Change) { ch.Records[0].Id = strings.Repeat("0", 128) },
+		"edit instead of immutable append": func(ch *handler.Change) { ch.Records[0].Upsert = false },
+		"partial field write":              func(ch *handler.Change) { ch.Records[0].Ops[0].Path = []string{"payload"} },
+		"null observed":                    func(ch *handler.Change) { ch.Records[0].Ops[0].Payload.Set("observed", (&anyenc.Arena{}).NewNull()) },
+		"null target block": func(ch *handler.Change) {
+			ch.Records[0].Ops[0].Payload.Set("targetBlockId", (&anyenc.Arena{}).NewNull())
+		},
+		"missing observed": func(ch *handler.Change) { ch.Records[0].Ops[0].Payload.Del("observed") },
+		"delete":           func(ch *handler.Change) { ch.Records[0].Ops[0].Type = handler.OpDelete },
+	}
+	for name, change := range cases {
+		t.Run(name, func(t *testing.T) {
+			ch := fixtureChange(t, fixtureOperation(1, "opaque"))
+			change(&ch)
+			require.Error(t, h.ValidateNative(&ch))
+		})
+	}
+	c := fixtureClaim(t, fixtureOperation(1, "opaque"))
+	r := EncodeRecord(c)
+	r.Payload = "Zm9yZ2Vk"
+	raw, err := json.Marshal(r)
+	require.NoError(t, err)
+	_, err = DecodeRecord(c.RecordID(), raw)
+	require.Error(t, err, "hash must bind the actual payload")
+}
+
+func TestProjectionQuarantinesCrossTargetCollisionBeforeRemove(t *testing.T) {
+	old := fixtureClaim(t, fixtureOperation(1, "old"))
+	remove := fixtureOperation(2, "")
+	remove.Kind = Remove
+	remove.Source = Source{}
+	remove.Observed = []string{old.ID}
+	removeClaim := fixtureClaim(t, remove)
+	variant := fixtureOperation(2, "different target")
+	variant.Target.ObjectID = "another-document"
+	variantClaim := fixtureClaim(t, variant)
+	for _, order := range [][]Claim{{old, removeClaim, variantClaim}, {variantClaim, removeClaim, old}} {
+		p := Fold(old.Operation.Target, order)
+		require.Equal(t, []Claim{old}, p.Live)
+		require.Len(t, p.Conflicts, 1)
+	}
+}
+
+func TestObservedRemovePreservesConcurrentAddsAndBothReplacements(t *testing.T) {
+	old := fixtureClaim(t, fixtureOperation(1, "old"))
+	newAdd := fixtureClaim(t, fixtureOperation(2, "unseen"))
+	a := fixtureOperation(3, "replacement A")
+	a.Kind = Replace
+	a.Observed = []string{old.ID}
+	b := fixtureOperation(4, "replacement B")
+	b.Kind = Replace
+	b.Observed = []string{old.ID}
+	p := Fold(old.Operation.Target, []Claim{fixtureClaim(t, b), old, newAdd, fixtureClaim(t, a)})
+	require.Len(t, p.Live, 3)
+	for _, c := range p.Live {
+		require.NotEqual(t, old.ID, c.ID)
+	}
+	missing := Fold(old.Operation.Target, []Claim{fixtureClaim(t, a)})
+	require.Equal(t, []string{old.ID}, missing.PendingObserved)
+}
diff --git a/internal/pinkha/claims/module.go b/internal/pinkha/claims/module.go
new file mode 100644
index 0000000..c4f96a4
--- /dev/null
+++ b/internal/pinkha/claims/module.go
@@ -0,0 +1,362 @@
+package claims
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+)
+
+const (
+	ModuleName  = "pinkha_torah_native"
+	Dataset     = "pinkha_torah_claims_v1"
+	DataVersion = "pinkha-torah-native-claims-v1"
+	BundleID    = "pinkha/torah-native/v1"
+	ContractID  = "pinkha-torah-native-v1"
+)
+
+// The canonical carrier is a derived bundle root. Its immutable native root
+// seed, not a mutable name/registry winner, binds the operation domain.
+func RootSeed() []byte { return []byte("builtin:bundleRoot:" + BundleID) }
+
+func NewModule() handler.Module {
+	return handler.Module{Name: ModuleName, Canonical: Dataset, CanonicalOnly: true,
+		Reserved: true, NoCopy: true, DataVersion: DataVersion, HandlerVersion: 1,
+		New: func(handler.ModuleInstance) handler.Dataset {
+			return handler.Dataset{Handler: NativeHandler{}, Schema: DatasetSchema(),
+				Indexes: []anystore.IndexInfo{
+					{Name: "pinkha_operation", Fields: []string{"logicalKey"}},
+					{Name: "pinkha_target", Fields: []string{"targetObjectId", "targetBlockId"}},
+					{Name: "pinkha_sources", Fields: []string{SourcesIndexKey}},
+					{Name: "pinkha_topics", Fields: []string{TopicsIndexKey}},
+					{Name: "pinkha_words", Fields: []string{WordsIndexKey}},
+					{Name: "pinkha_semantic_status", Fields: []string{SemanticStatusKey}},
+					{Name: "pinkha_related_source", Fields: []string{RelatedIndexKey}},
+				}, DisableFilteredReplay: true}
+		}}
+}
+
+func DatasetSchema() handler.Schema {
+	str := func() *handler.FieldShape { return handler.Leaf(handler.PropertyKindString) }
+	fields := []handler.Field{{Id: "version", Schema: handler.Leaf(handler.PropertyKindNumber), Scope: handler.ScopeSynced, Required: true}}
+	for _, key := range []string{"operationId", "spaceId", "authorId", "kind", "targetObjectId", "targetBlockId", "providerId", "canonicalRef", "payload", "logicalKey", "contentHash"} {
+		fields = append(fields, handler.Field{Id: key, Schema: str(), Scope: handler.ScopeSynced, Required: true})
+	}
+	observedShape := handler.Leaf(handler.PropertyKindArray)
+	observedShape.Items = str()
+	fields = append(fields, handler.Field{Id: "observed", Schema: observedShape, Scope: handler.ScopeSynced, Required: true})
+	for _, key := range []string{"creator", "nativeChangeId", "nativeACLHeadId"} {
+		fields = append(fields, handler.Field{Id: key, Schema: str(), Scope: handler.ScopeDerived})
+	}
+	fields = append(fields, handler.Field{Id: SemanticStatusKey, Schema: str(), Scope: handler.ScopeDerived})
+	fields = append(fields, handler.Field{Id: RelatedIndexKey, Schema: str(), Scope: handler.ScopeDerived})
+	for _, key := range []string{SourcesIndexKey, TopicsIndexKey, WordsIndexKey} {
+		shape := handler.Leaf(handler.PropertyKindArray)
+		shape.Items = str()
+		fields = append(fields, handler.Field{Id: key, Schema: shape, Scope: handler.ScopeDerived})
+	}
+	return handler.Schema{Fields: fields, IdRule: handler.IdUser, IdPattern: "^[a-f0-9]{128}$", IdMaxLen: 128, DeleteBy: handler.DeleteByNone}
+}
+
+type NativeHandler struct{ handler.DefaultHandler }
+
+var _ handler.GuardedHandler = NativeHandler{}
+
+func (NativeHandler) GuardRootSeed() []byte { return RootSeed() }
+
+func reject(reason string) error { return fmt.Errorf("%w: pinkha %s", handler.ErrValidation, reason) }
+
+func recordClaim(rec *handler.RecordChange) (Claim, error) {
+	if rec == nil || !rec.Upsert || len(rec.Ops) != 1 {
+		return Claim{}, reject("immutable create required")
+	}
+	op := rec.Ops[0]
+	if op.Type != handler.OpSet || len(op.Path) != 0 || op.Payload == nil || op.Payload.Type() != anyenc.TypeObject {
+		return Claim{}, reject("one complete record set required")
+	}
+	for _, key := range []string{"version", "operationId", "spaceId", "authorId", "kind", "targetObjectId", "targetBlockId", "providerId", "canonicalRef", "payload", "observed", "logicalKey", "contentHash"} {
+		value := op.Payload.Get(key)
+		if value == nil {
+			return Claim{}, reject("incomplete immutable record")
+		}
+		expected := anyenc.TypeString
+		if key == "version" {
+			expected = anyenc.TypeNumber
+		}
+		if key == "observed" {
+			expected = anyenc.TypeArray
+		}
+		if value.Type() != expected {
+			return Claim{}, reject("invalid immutable field type")
+		}
+	}
+	raw := []byte(op.Payload.String())
+	c, err := DecodeRecord(rec.Id, raw)
+	if err != nil {
+		return Claim{}, errors.Join(handler.ErrValidation, err)
+	}
+	return c, nil
+}
+
+func validateEnvelope(ch *handler.Change, requireSigned bool) ([]Claim, error) {
+	if ch == nil || ch.Dataset != Dataset || ch.DataVersion != DataVersion ||
+		!ch.ObjectDerived || !bytes.Equal(ch.ObjectRootPayload, RootSeed()) ||
+		ch.SpaceId == "" || ch.Creator == "" || len(ch.Records) == 0 || len(ch.Records) > 256 {
+		return nil, reject("native carrier or protocol mismatch")
+	}
+	if requireSigned && (ch.ChangeId == "" || ch.ACLHeadId == "") {
+		return nil, reject("signed provenance missing")
+	}
+	claims := make([]Claim, 0, len(ch.Records))
+	seen := make(map[string]bool)
+	for i := range ch.Records {
+		c, err := recordClaim(&ch.Records[i])
+		if err != nil {
+			return nil, err
+		}
+		if c.Operation.SpaceID != ch.SpaceId || c.Operation.AuthorID != ch.Creator {
+			return nil, reject("native Space or author mismatch")
+		}
+		if seen[c.ID] {
+			return nil, reject("duplicate record in batch")
+		}
+		seen[c.ID] = true
+		claims = append(claims, c)
+	}
+	return claims, nil
+}
+
+// ValidateNative is called by the AnySync tree content validator before storage
+// and by the apply handler. It deliberately does not read mutable replica state.
+func (NativeHandler) ValidateNative(ch *handler.Change) error {
+	_, err := validateEnvelope(ch, true)
+	return err
+}
+
+func (NativeHandler) LocalTargets(ch *handler.Change) ([]string, error) {
+	if ch == nil || len(ch.Records) == 0 || len(ch.Records) > 256 {
+		return nil, reject("batch bound")
+	}
+	ids := []string{}
+	for i := range ch.Records {
+		c, err := recordClaim(&ch.Records[i])
+		if err != nil {
+			return nil, err
+		}
+		ids = append(ids, c.Operation.Target.ObjectID)
+	}
+	slices.Sort(ids)
+	return slices.Compact(ids), nil
+}
+
+func (NativeHandler) ValidateLocal(ch *handler.Change, view handler.LocalReadView) error {
+	claims, err := validateEnvelope(ch, false)
+	if err != nil {
+		return err
+	}
+	if view == nil {
+		return reject("native target fence unavailable")
+	}
+	batchKeys := map[string]string{}
+	present := 0
+	for _, c := range claims {
+		key := operationKey(c.Operation.SpaceID, c.Operation.OperationID)
+		if previous, ok := batchKeys[key]; ok && previous != c.ID {
+			return reject("ordered operation collision")
+		}
+		batchKeys[key] = c.ID
+		variants, err := view.Query(ch.ObjectId, Dataset, map[string]any{"logicalKey": key}, MaxVariants+1)
+		if err != nil {
+			return err
+		}
+		if len(variants) > MaxVariants {
+			return ErrReadLimit
+		}
+		if len(variants) == 1 {
+			present++
+		}
+		for _, v := range variants {
+			old, err := ClaimFromStored(v)
+			if err != nil {
+				return err
+			}
+			if old.ID != c.ID {
+				return reject("ordered operation collision")
+			}
+		}
+		for _, id := range c.Operation.Observed {
+			stored, err := view.Lookup(ch.ObjectId, Dataset, id[:64]+id[65:])
+			if err != nil {
+				return err
+			}
+			if stored == nil {
+				return reject("unobserved predecessor")
+			}
+			old, err := ClaimFromStored(stored)
+			if err != nil {
+				return err
+			}
+			if old.Operation.SpaceID != c.Operation.SpaceID || old.Operation.Target != c.Operation.Target {
+				return reject("predecessor target mismatch")
+			}
+		}
+		if err := validateTarget(ch.SpaceId, c.Operation.Target, view); err != nil {
+			return err
+		}
+	}
+	if present > 0 && present != len(claims) {
+		return reject("mixed retry and new batch; submit separately")
+	}
+	ch.NativeAlreadyApplied = present == len(claims)
+	return nil
+}
+
+func (NativeHandler) BeforeCreate(ctx *handler.ChangeCtx, rec *handler.RecordChange, sink *handler.Sink) error {
+	if ctx == nil || ctx.Change == nil || sink == nil {
+		return reject("missing native context")
+	}
+	if _, err := validateEnvelope(ctx.Change, true); err != nil {
+		return err
+	}
+	c, err := recordClaim(rec)
+	if err != nil {
+		return err
+	}
+	a := &anyenc.Arena{}
+	for key, value := range map[string]string{"creator": ctx.Change.Creator, "nativeChangeId": ctx.Change.ChangeId, "nativeACLHeadId": ctx.Change.ACLHeadId} {
+		sink.Derive(handler.Op{Type: handler.OpSet, Path: []string{key}, Payload: a.NewString(value)})
+	}
+	status, projection := SemanticIndex(c)
+	sink.Derive(handler.Op{Type: handler.OpSet, Path: []string{SemanticStatusKey}, Payload: a.NewString(status)})
+	related := ""
+	if c.Operation.Kind != Remove {
+		if b, err := bind(c); err == nil {
+			related = b.RelatedIdentity
+		}
+	}
+	sink.Derive(handler.Op{Type: handler.OpSet, Path: []string{RelatedIndexKey}, Payload: a.NewString(related)})
+	for key, values := range map[string][]string{SourcesIndexKey: projection.Sources, TopicsIndexKey: projection.Topics, WordsIndexKey: projection.Words} {
+		raw, err := json.Marshal(values)
+		if err != nil {
+			return err
+		}
+		value, err := anyenc.ParseJson(string(raw))
+		if err != nil {
+			return err
+		}
+		sink.Derive(handler.Op{Type: handler.OpSet, Path: []string{key}, Payload: value})
+	}
+	return nil
+}
+
+func (NativeHandler) BeforeModify(ctx *handler.ChangeCtx, rec *handler.RecordChange, op *handler.Op, sink *handler.Sink) error {
+	// The controller invokes BeforeModify for the payload's fields after its
+	// successful BeforeCreate. Only that creating change may set them.
+	if ctx == nil || ctx.Change == nil || ctx.Before == nil ||
+		ctx.Before.GetString("_ver", "id") != string(ctx.Change.VersionId) {
+		return reject("immutable claim")
+	}
+	_, err := recordClaim(rec)
+	return err
+}
+
+func (NativeHandler) BeforeDelete(*handler.ChangeCtx, *handler.RecordChange, *handler.Sink) error {
+	return reject("append an observed remove")
+}
+
+func ClaimFromStored(v *anyenc.Value) (Claim, error) {
+	if v == nil || v.Get("_deletedAt") != nil {
+		return Claim{}, reject("missing immutable record")
+	}
+	obj, err := v.Object()
+	if err != nil {
+		return Claim{}, err
+	}
+	fields := make(map[string]json.RawMessage)
+	obj.Visit(func(key []byte, value *anyenc.Value) {
+		switch string(key) {
+		case "version", "operationId", "spaceId", "authorId", "kind", "targetObjectId", "targetBlockId", "providerId", "canonicalRef", "payload", "observed", "logicalKey", "contentHash":
+			fields[string(key)] = []byte(value.String())
+		}
+	})
+	raw, err := json.Marshal(fields)
+	if err != nil {
+		return Claim{}, err
+	}
+	if len(fields) != 13 {
+		return Claim{}, reject("incomplete stored immutable record")
+	}
+	c, err := DecodeRecord(v.GetString("id"), raw)
+	if err != nil {
+		return Claim{}, err
+	}
+	if v.GetString("creator") != c.Operation.AuthorID || v.GetString("nativeChangeId") == "" || v.GetString("nativeACLHeadId") == "" {
+		return Claim{}, reject("stored native provenance mismatch")
+	}
+	return c, nil
+}
+
+func validateTarget(spaceID string, target Target, view handler.LocalReadView) error {
+	row, err := view.Lookup(target.ObjectID, "objects", target.ObjectID)
+	if err != nil {
+		return err
+	}
+	if err := validateTargetRow(spaceID, target, row); err != nil {
+		return err
+	}
+	return validateBlockPath(target, view)
+}
+
+func validateTargetRow(spaceID string, target Target, row *anyenc.Value) error {
+	if row == nil || row.Get("_deletedAt") != nil || row.GetString("id") != target.ObjectID || row.GetString("spaceId") != spaceID {
+		return reject("native target missing or foreign")
+	}
+	// Native contract v1 accepts the built-in document type, whose editor
+	// membership is compiled and immutable. Custom roles need a verified native
+	// schema policy; a nonempty type string is never enough.
+	if row.GetString("any", "type") != "page" {
+		return reject("unsupported document type")
+	}
+	if collections := row.Get("any", "collections"); collections != nil {
+		if collections.Type() != anyenc.TypeArray {
+			return reject("invalid target membership")
+		}
+		for _, value := range collections.GetArray() {
+			if value.Type() != anyenc.TypeString {
+				return reject("invalid target membership")
+			}
+			if value.GetString() == "bin" || value.GetString() == "template" {
+				return reject("ineligible document")
+			}
+		}
+	}
+	return nil
+}
+
+func validateBlockPath(target Target, view handler.LocalReadView) error {
+	seen := map[string]bool{}
+	for id := target.BlockID; id != ""; {
+		if seen[id] || len(seen) >= 256 {
+			return reject("cyclic or unbounded block path")
+		}
+		seen[id] = true
+		block, err := view.Lookup(target.ObjectID, "editor_blocks", id)
+		if err != nil {
+			return err
+		}
+		if block == nil || block.Get("_deletedAt") != nil || block.GetString("id") != id {
+			return reject("orphaned block")
+		}
+		parent := block.Get("nav", "parentId")
+		if parent == nil || parent.Type() != anyenc.TypeString {
+			return reject("invalid block parent")
+		}
+		id = parent.GetString()
+	}
+	return nil
+}
diff --git a/internal/pinkha/claims/operation.go b/internal/pinkha/claims/operation.go
new file mode 100644
index 0000000..db28bc7
--- /dev/null
+++ b/internal/pinkha/claims/operation.go
@@ -0,0 +1,214 @@
+// Package claims preserves Pinkha T2 immutable operation identity in the Any engine.
+// Canonical bytes remain compatible with the existing Go and Swift implementations.
+package claims
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+const (
+	Version            = 1
+	MaxPayloadBytes    = 64 * 1024
+	MaxObservedClaims  = 256
+	MaxVariants        = 256
+	MaxWireBytes       = 256 * 1024
+	CollectionName     = "_pinkha_torah_claims_v1"
+	receiptsCollection = "_pinkha_torah_receipts_v1"
+)
+
+var (
+	ErrInvalid            = errors.New("invalid torah operation")
+	ErrUnsupportedVersion = errors.New("unsupported torah operation version")
+	ErrReadLimit          = errors.New("torah operation read limit exceeded")
+)
+
+type Kind string
+
+const (
+	Add     Kind = "add"
+	Remove  Kind = "remove"
+	Replace Kind = "replace"
+)
+
+type Target struct {
+	ObjectID string `json:"objectId"`
+	BlockID  string `json:"blockId"`
+}
+
+type Source struct {
+	ProviderID   string `json:"providerId"`
+	CanonicalRef string `json:"canonicalRef"`
+}
+
+// Operation uses a fixed binary envelope for content identity. Payload is opaque
+// bytes, not a JSON value: callers must reuse the exact bytes on retry. Semantic
+// provider/schema validation belongs to the future native host, not this store.
+type Operation struct {
+	Version     uint32   `json:"version"`
+	SpaceID     string   `json:"spaceId"`
+	OperationID string   `json:"operationId"`
+	AuthorID    string   `json:"authorId"`
+	Kind        Kind     `json:"kind"`
+	Target      Target   `json:"target"`
+	Source      Source   `json:"source"`
+	Payload     []byte   `json:"payload"`
+	Observed    []string `json:"observed"`
+}
+
+type wireClaim struct {
+	Operation Operation `json:"operation"`
+	Digest    string    `json:"digest"`
+}
+
+// Claim is immutable content. Native replay provenance is stored separately,
+// because retries may carry another ACL head without changing operation bytes.
+type Claim struct {
+	ID        string    `json:"id"`
+	Digest    string    `json:"digest"`
+	Operation Operation `json:"operation"`
+}
+
+func validText(value string, required bool, limit int) bool {
+	return (!required || len(value) != 0) && len(value) <= limit &&
+		utf8.ValidString(value) && !strings.ContainsRune(value, 0)
+}
+
+func validHex(value string, size int) bool {
+	if len(value) != size*2 || value != strings.ToLower(value) {
+		return false
+	}
+	_, err := hex.DecodeString(value)
+	return err == nil
+}
+
+func validClaimID(value string) bool {
+	return len(value) == 129 && value[64] == '/' &&
+		validHex(value[:64], 32) && validHex(value[65:], 32)
+}
+
+// CanonicalBytes returns domain/version/length-prefixed bytes in fixed field
+// order. No Unicode normalization or JSON interpretation is performed. Observed
+// claim IDs are a set: input order and duplicate references do not change identity.
+func (op Operation) CanonicalBytes() ([]byte, error) {
+	if op.Version != Version {
+		return nil, ErrUnsupportedVersion
+	}
+	if !validText(op.SpaceID, true, 1024) || !validHex(op.OperationID, 16) ||
+		!validText(op.AuthorID, true, 1024) ||
+		!validText(op.Target.ObjectID, true, 1024) || !validText(op.Target.BlockID, false, 1024) ||
+		!validText(op.Source.ProviderID, false, 256) || !validText(op.Source.CanonicalRef, false, 4096) ||
+		len(op.Payload) > MaxPayloadBytes || len(op.Observed) > MaxObservedClaims {
+		return nil, ErrInvalid
+	}
+	switch op.Kind {
+	case Add:
+		if len(op.Observed) != 0 || len(op.Payload) == 0 || op.Source.ProviderID == "" || op.Source.CanonicalRef == "" {
+			return nil, ErrInvalid
+		}
+	case Remove:
+		if len(op.Observed) == 0 || len(op.Payload) != 0 || op.Source != (Source{}) {
+			return nil, ErrInvalid
+		}
+	case Replace:
+		if len(op.Observed) == 0 || len(op.Payload) == 0 || op.Source.ProviderID == "" || op.Source.CanonicalRef == "" {
+			return nil, ErrInvalid
+		}
+	default:
+		return nil, ErrInvalid
+	}
+	observed := normalizedObserved(op.Observed)
+	for _, id := range observed {
+		if !validClaimID(id) {
+			return nil, ErrInvalid
+		}
+	}
+	buf := bytes.NewBufferString("pinkha-t2-operation\x00")
+	_ = binary.Write(buf, binary.BigEndian, op.Version)
+	for _, value := range []string{op.SpaceID, op.OperationID, op.AuthorID, string(op.Kind),
+		op.Target.ObjectID, op.Target.BlockID, op.Source.ProviderID, op.Source.CanonicalRef} {
+		putBytes(buf, []byte(value))
+	}
+	putBytes(buf, op.Payload)
+	_ = binary.Write(buf, binary.BigEndian, uint32(len(observed)))
+	for _, id := range observed {
+		putBytes(buf, []byte(id))
+	}
+	return buf.Bytes(), nil
+}
+
+func normalizedObserved(ids []string) []string {
+	result := append([]string{}, ids...)
+	sort.Strings(result)
+	unique := result[:0]
+	for _, id := range result {
+		if len(unique) == 0 || unique[len(unique)-1] != id {
+			unique = append(unique, id)
+		}
+	}
+	return unique
+}
+
+func putBytes(buf *bytes.Buffer, value []byte) {
+	_ = binary.Write(buf, binary.BigEndian, uint32(len(value)))
+	_, _ = buf.Write(value)
+}
+
+func operationKey(spaceID, operationID string) string {
+	buf := bytes.NewBufferString("pinkha-t2-operation-key-v1\x00")
+	putBytes(buf, []byte(spaceID))
+	putBytes(buf, []byte(operationID))
+	digest := sha256.Sum256(buf.Bytes())
+	return hex.EncodeToString(digest[:])
+}
+
+func makeClaim(op Operation) (Claim, []byte, error) {
+	canonical, err := op.CanonicalBytes()
+	if err != nil {
+		return Claim{}, nil, err
+	}
+	// Own caller slices, including for results returned after a write.
+	op.Payload = append([]byte{}, op.Payload...)
+	op.Observed = normalizedObserved(op.Observed)
+	digest := sha256.Sum256(canonical)
+	hexDigest := hex.EncodeToString(digest[:])
+	claim := Claim{ID: operationKey(op.SpaceID, op.OperationID) + "/" + hexDigest, Digest: hexDigest, Operation: op}
+	wire, err := json.Marshal(wireClaim{Operation: op, Digest: hexDigest})
+	return claim, wire, err
+}
+
+// DecodeClaim accepts only the canonical typed JSON emitted by EncodeClaim.
+// Duplicate keys, unknown fields, whitespace variants and noncanonical base64
+// are rejected by exact re-encoding, before StoreState changes are persisted.
+func DecodeClaim(id, value string) (Claim, error) {
+	if len(value) > MaxWireBytes {
+		return Claim{}, ErrInvalid
+	}
+	var wire wireClaim
+	decoder := json.NewDecoder(strings.NewReader(value))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&wire); err != nil {
+		return Claim{}, fmt.Errorf("decode claim: %w: %w", ErrInvalid, err)
+	}
+	claim, canonicalJSON, err := makeClaim(wire.Operation)
+	if err != nil {
+		return Claim{}, err
+	}
+	if claim.ID != id || wire.Digest != claim.Digest || !bytes.Equal([]byte(value), canonicalJSON) {
+		return Claim{}, ErrInvalid
+	}
+	return claim, nil
+}
+
+func EncodeClaim(op Operation) (id, value string, err error) {
+	claim, wire, err := makeClaim(op)
+	return claim.ID, string(wire), err
+}
diff --git a/internal/pinkha/claims/read.go b/internal/pinkha/claims/read.go
new file mode 100644
index 0000000..bc5bdc6
--- /dev/null
+++ b/internal/pinkha/claims/read.go
@@ -0,0 +1,233 @@
+package claims
+
+import (
+	"context"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+// TargetSnapshot is rebuilt from signed immutable claims and native target
+// state. It is not a second association store or a client-maintained cache.
+type TargetSnapshot struct {
+	Contract  string             `json:"contract"`
+	Target    Target             `json:"target"`
+	Operation Projection         `json:"operations"`
+	Semantic  SemanticProjection `json:"semantic"`
+	Readiness Readiness          `json:"readiness"`
+}
+
+func readTarget(view handler.LocalReadView, rootID string, target Target, limit int) (Projection, error) {
+	rows, err := view.Query(rootID, Dataset, map[string]any{"targetObjectId": target.ObjectID, "targetBlockId": target.BlockID}, limit+1)
+	if err != nil {
+		return Projection{}, err
+	}
+	if len(rows) > limit {
+		return Projection{}, ErrReadLimit
+	}
+	seen := map[string]bool{}
+	complete := []Claim{}
+	for _, row := range rows {
+		c, err := ClaimFromStored(row)
+		if err != nil {
+			return Projection{}, err
+		}
+		key := operationKey(c.Operation.SpaceID, c.Operation.OperationID)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		variants, err := view.Query(rootID, Dataset, map[string]any{"logicalKey": key}, MaxVariants+1)
+		if err != nil {
+			return Projection{}, err
+		}
+		if len(variants) > MaxVariants {
+			return Projection{}, ErrReadLimit
+		}
+		for _, v := range variants {
+			c, err := ClaimFromStored(v)
+			if err != nil {
+				return Projection{}, err
+			}
+			complete = append(complete, c)
+		}
+	}
+	return Fold(target, complete), nil
+}
+
+func nativeTargetRow(view handler.NativeReadView, spaceID string, target Target) (*anyenc.Value, error) {
+	rows, err := view.SpaceObjects(map[string]any{"id": target.ObjectID}, 2)
+	if err != nil {
+		return nil, err
+	}
+	if len(rows) != 1 {
+		return nil, reject("native target unavailable")
+	}
+	if err := validateTargetRow(spaceID, target, rows[0]); err != nil {
+		return nil, err
+	}
+	return rows[0], nil
+}
+
+func ReadTarget(ctx context.Context, sp space.Space, rootID string, target Target, limit int) (TargetSnapshot, error) {
+	if !validText(target.ObjectID, true, 1024) || !validText(target.BlockID, false, 1024) || limit < 1 || limit > 10000 {
+		return TargetSnapshot{}, ErrInvalid
+	}
+	result := TargetSnapshot{Contract: ContractID, Target: target}
+	dependencies := []string{rootID, target.ObjectID}
+	err := space.NativeReadSnapshot(ctx, sp, dependencies, func(view handler.NativeReadView) error {
+		row, err := nativeTargetRow(view, sp.Id(), target)
+		if err != nil {
+			return err
+		}
+		if target.BlockID != "" {
+			if err := validateTarget(sp.Id(), target, view); err != nil {
+				return err
+			}
+		}
+		p, err := readTarget(view, rootID, target, limit)
+		if err != nil {
+			return err
+		}
+		result.Operation = p
+		result.Semantic = SemanticFold(p)
+		result.Readiness = readiness(view, result.Semantic.Coverage, row.String())
+		return nil
+	})
+	return result, err
+}
+
+type SourceResult struct {
+	Contract                 string    `json:"contract"`
+	Field                    string    `json:"field"`
+	Identity                 string    `json:"identity"`
+	ObjectIDs                []string  `json:"objectIds"`
+	ConflictedObjectIDs      []string  `json:"conflictedObjectIds"`
+	Coverage                 string    `json:"coverage"`
+	UnsupportedClaimsPresent bool      `json:"unsupportedClaimsPresent"`
+	Readiness                Readiness `json:"readiness"`
+}
+
+// FindSource uses native per-claim indexes to find candidates, then expands
+// only their target/operation groups in the same ACL-fenced SQLite snapshot.
+// All candidate native target trees are held during the final read so a native
+// deletion cannot be mistaken for a still-live projection row.
+// A Space may hold arbitrarily many unrelated claims; bounds apply to matches
+// and each target, never silently truncate the Space or return a partial page.
+func FindSource(ctx context.Context, sp space.Space, rootID, field, identity string, limit int) (SourceResult, error) {
+	if field != SourcesIndexKey && field != TopicsIndexKey && field != WordsIndexKey {
+		return SourceResult{}, ErrInvalid
+	}
+	if !validText(identity, true, 4096) || limit < 1 || limit > 1000 {
+		return SourceResult{}, ErrInvalid
+	}
+	out := SourceResult{Contract: ContractID, Field: field, Identity: identity, ObjectIDs: []string{}, ConflictedObjectIDs: []string{}, Coverage: "complete"}
+	dependencies := []string{rootID}
+	declared := map[string]bool{rootID: true}
+	err := space.NativeReadSnapshot(ctx, sp, []string{rootID}, func(view handler.NativeReadView) error {
+		rows, err := view.Query(rootID, Dataset, map[string]any{field: identity}, 10001)
+		if err != nil {
+			return err
+		}
+		if len(rows) > 10000 {
+			return ErrReadLimit
+		}
+		for _, row := range rows {
+			c, err := ClaimFromStored(row)
+			if err != nil {
+				return err
+			}
+			target := c.Operation.Target
+			if target.BlockID != "" || declared[target.ObjectID] {
+				continue
+			}
+			if _, err := nativeTargetRow(view, sp.Id(), target); errors.Is(err, handler.ErrValidation) {
+				continue
+			} else if err != nil {
+				return err
+			}
+			if len(dependencies) > limit {
+				return ErrReadLimit
+			}
+			declared[target.ObjectID] = true
+			dependencies = append(dependencies, target.ObjectID)
+		}
+		return nil
+	})
+	if err != nil {
+		return SourceResult{}, err
+	}
+	err = space.NativeReadSnapshot(ctx, sp, dependencies, func(view handler.NativeReadView) error {
+		unknown, err := view.Query(rootID, Dataset, map[string]any{SemanticStatusKey: map[string]any{"$in": []string{"unsupported-opaque", "invalid-semantic-payload"}}}, 1)
+		if err != nil {
+			return err
+		}
+		out.UnsupportedClaimsPresent = len(unknown) > 0
+		if out.UnsupportedClaimsPresent {
+			out.Coverage = "incomplete-unsupported-payload"
+		}
+		candidates, err := view.Query(rootID, Dataset, map[string]any{field: identity}, 10001)
+		if err != nil {
+			return err
+		}
+		if len(candidates) > 10000 {
+			return ErrReadLimit
+		}
+		seen := map[string]bool{}
+		inputRows := map[string]string{}
+		for _, row := range candidates {
+			c, err := ClaimFromStored(row)
+			if err != nil {
+				return err
+			}
+			target := c.Operation.Target
+			if target.BlockID != "" || seen[target.ObjectID] {
+				continue
+			}
+			seen[target.ObjectID] = true
+			if len(seen) > limit {
+				return ErrReadLimit
+			}
+			targetRow, err := nativeTargetRow(view, sp.Id(), target)
+			if errors.Is(err, handler.ErrValidation) {
+				inputRows[target.ObjectID] = "ineligible"
+				continue
+			}
+			if err != nil {
+				return err
+			}
+			if !declared[target.ObjectID] {
+				return ErrSnapshotChanged
+			}
+			inputRows[target.ObjectID] = targetRow.String()
+			p, err := readTarget(view, rootID, target, 10000)
+			if err != nil {
+				return err
+			}
+			s := SemanticFold(p)
+			if len(p.Conflicts) > 0 || len(p.PendingObserved) > 0 || len(s.ConflictingClaimIDs) > 0 {
+				out.ConflictedObjectIDs = append(out.ConflictedObjectIDs, target.ObjectID)
+				out.Coverage = "incomplete-conflict-or-pending"
+				continue
+			}
+			values := s.Sources
+			if field == TopicsIndexKey {
+				values = s.Topics
+			}
+			if field == WordsIndexKey {
+				values = s.Words
+			}
+			if slices.Contains(values, identity) {
+				out.ObjectIDs = append(out.ObjectIDs, target.ObjectID)
+			}
+		}
+		out.Readiness = readiness(view, out.Coverage, inputRows)
+		return nil
+	})
+	slices.Sort(out.ObjectIDs)
+	slices.Sort(out.ConflictedObjectIDs)
+	return out, err
+}
diff --git a/internal/pinkha/claims/record.go b/internal/pinkha/claims/record.go
new file mode 100644
index 0000000..0acc680
--- /dev/null
+++ b/internal/pinkha/claims/record.go
@@ -0,0 +1,152 @@
+package claims
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"io"
+	"slices"
+	"strings"
+)
+
+// Record is the closed, flat Any dataset wire format. Creator is not accepted
+// from a caller: the native apply handler derives it from the signed envelope.
+type Record struct {
+	Version        uint32   `json:"version"`
+	OperationID    string   `json:"operationId"`
+	SpaceID        string   `json:"spaceId"`
+	AuthorID       string   `json:"authorId"`
+	Kind           Kind     `json:"kind"`
+	TargetObjectID string   `json:"targetObjectId"`
+	TargetBlockID  string   `json:"targetBlockId"`
+	ProviderID     string   `json:"providerId"`
+	CanonicalRef   string   `json:"canonicalRef"`
+	Payload        string   `json:"payload"`
+	Observed       []string `json:"observed"`
+	LogicalKey     string   `json:"logicalKey"`
+	ContentHash    string   `json:"contentHash"`
+}
+
+// RecordID is Any's slash-free spelling of the existing physical claim ID.
+func (c Claim) RecordID() string { return strings.ReplaceAll(c.ID, "/", "") }
+
+func Make(op Operation) (Claim, error) {
+	c, _, err := makeClaim(op)
+	return c, err
+}
+
+func EncodeRecord(c Claim) Record {
+	op := c.Operation
+	return Record{Version: op.Version, OperationID: op.OperationID,
+		SpaceID: op.SpaceID, AuthorID: op.AuthorID, Kind: op.Kind,
+		TargetObjectID: op.Target.ObjectID, TargetBlockID: op.Target.BlockID,
+		ProviderID: op.Source.ProviderID, CanonicalRef: op.Source.CanonicalRef,
+		Payload:  base64.StdEncoding.EncodeToString(op.Payload),
+		Observed: normalizedObserved(op.Observed), LogicalKey: operationKey(op.SpaceID, op.OperationID),
+		ContentHash: c.Digest}
+}
+
+func DecodeRecord(id string, raw []byte) (Claim, error) {
+	if len(raw) > MaxWireBytes || !validHex(id, 64) {
+		return Claim{}, ErrInvalid
+	}
+	var r Record
+	d := json.NewDecoder(bytes.NewReader(raw))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&r); err != nil {
+		return Claim{}, errors.Join(ErrInvalid, err)
+	}
+	var trailing any
+	if d.Decode(&trailing) != io.EOF {
+		return Claim{}, ErrInvalid
+	}
+	return r.Claim(id)
+}
+
+func (r Record) Claim(id string) (Claim, error) {
+	payload, err := base64.StdEncoding.DecodeString(r.Payload)
+	if err != nil || r.Observed == nil || base64.StdEncoding.EncodeToString(payload) != r.Payload ||
+		!slices.Equal(r.Observed, normalizedObserved(r.Observed)) {
+		return Claim{}, ErrInvalid
+	}
+	c, err := Make(Operation{Version: r.Version, SpaceID: r.SpaceID,
+		OperationID: r.OperationID, AuthorID: r.AuthorID, Kind: r.Kind,
+		Target:  Target{ObjectID: r.TargetObjectID, BlockID: r.TargetBlockID},
+		Source:  Source{ProviderID: r.ProviderID, CanonicalRef: r.CanonicalRef},
+		Payload: payload, Observed: r.Observed})
+	if err != nil {
+		return Claim{}, err
+	}
+	if c.RecordID() != id || c.Digest != r.ContentHash || operationKey(r.SpaceID, r.OperationID) != r.LogicalKey {
+		return Claim{}, ErrInvalid
+	}
+	return c, nil
+}
+
+// Fold applies the same order-independent semantics as the original store:
+// quarantine every variant of a colliding logical operation BEFORE processing
+// predecessors, then suppress only observed physical IDs at the same target.
+// Callers must supply complete variant sets for every candidate logical key.
+func Fold(target Target, candidates []Claim) Projection {
+	groups := make(map[string][]Claim)
+	seen := make(map[string]bool)
+	for _, c := range candidates {
+		if seen[c.ID] {
+			continue
+		}
+		seen[c.ID] = true
+		key := operationKey(c.Operation.SpaceID, c.Operation.OperationID)
+		groups[key] = append(groups[key], c)
+	}
+	result := Projection{Live: []Claim{}, Conflicts: []Conflict{}, PendingObserved: []string{}}
+	active := make(map[string]Claim)
+	for key, variants := range groups {
+		if len(variants) > 1 {
+			slices.SortFunc(variants, func(a, b Claim) int { return strings.Compare(a.ID, b.ID) })
+			result.Conflicts = append(result.Conflicts, Conflict{LogicalKey: key, Variants: variants})
+			continue
+		}
+		if variants[0].Operation.Target == target {
+			active[variants[0].ID] = variants[0]
+		}
+	}
+	removed, pending := map[string]bool{}, map[string]bool{}
+	for _, c := range active {
+		for _, id := range c.Operation.Observed {
+			if predecessor, ok := active[id]; ok && predecessor.Operation.Target == target {
+				removed[id] = true
+			} else {
+				pending[id] = true
+			}
+		}
+	}
+	for _, c := range active {
+		if c.Operation.Kind != Remove && !removed[c.ID] {
+			result.Live = append(result.Live, c)
+		}
+	}
+	for id := range pending {
+		result.PendingObserved = append(result.PendingObserved, id)
+	}
+	slices.SortFunc(result.Live, func(a, b Claim) int {
+		if x := strings.Compare(a.Operation.OperationID, b.Operation.OperationID); x != 0 {
+			return x
+		}
+		return strings.Compare(a.ID, b.ID)
+	})
+	slices.SortFunc(result.Conflicts, func(a, b Conflict) int { return strings.Compare(a.LogicalKey, b.LogicalKey) })
+	slices.Sort(result.PendingObserved)
+	return result
+}
+
+type Conflict struct {
+	LogicalKey string  `json:"logicalKey"`
+	Variants   []Claim `json:"variants"`
+}
+
+type Projection struct {
+	Live            []Claim    `json:"live"`
+	Conflicts       []Conflict `json:"conflicts"`
+	PendingObserved []string   `json:"pendingObserved"`
+}
diff --git a/internal/pinkha/claims/related.go b/internal/pinkha/claims/related.go
new file mode 100644
index 0000000..242ed2c
--- /dev/null
+++ b/internal/pinkha/claims/related.go
@@ -0,0 +1,194 @@
+package claims
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/anyproto/any-sync-sdk/handler"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+var ErrSnapshotChanged = errors.New("native related candidates changed while loading target trees")
+
+type Readiness struct {
+	Version    int    `json:"version"`
+	State      string `json:"state"`
+	Generation string `json:"generation"`
+}
+
+func readiness(view handler.NativeReadView, coverage string, inputs any) Readiness {
+	raw, _ := json.Marshal(struct {
+		Contract string
+		Stamp    handler.NativeReadStamp
+		Inputs   any
+	}{ContractID, view.ReadStamp(), inputs})
+	h := sha256.Sum256(raw)
+	state := "ready-local-snapshot"
+	if coverage != "complete" {
+		state = "incomplete"
+	}
+	return Readiness{Version: 1, State: state, Generation: hex.EncodeToString(h[:])}
+}
+
+type RelatedTarget struct {
+	SpaceID             string   `json:"spaceId"`
+	ObjectID            string   `json:"objectId"`
+	BlockID             string   `json:"blockId,omitempty"`
+	ContextItemIDs      []string `json:"contextItemIds"`
+	SourceQuoteItemIDs  []string `json:"sourceQuoteItemIds"`
+	CanSafelyUnlink     bool     `json:"canSafelyUnlink"`
+	SemanticInputSHA256 string   `json:"semanticInputSHA256"`
+}
+
+type RelatedResult struct {
+	Contract                 string          `json:"contract"`
+	Version                  int             `json:"version"`
+	Identity                 string          `json:"identity"`
+	Coverage                 string          `json:"coverage"`
+	Readiness                Readiness       `json:"readiness"`
+	Targets                  []RelatedTarget `json:"targets"`
+	ConflictingTargets       []Target        `json:"conflictingTargets"`
+	UnsupportedClaimsPresent bool            `json:"unsupportedClaimsPresent"`
+}
+
+func targetKey(t Target) string {
+	return strconv.Itoa(len(t.ObjectID)) + ":" + t.ObjectID + "|" + strconv.Itoa(len(t.BlockID)) + ":" + t.BlockID
+}
+
+func relatedCandidates(view handler.NativeReadView, rootID, identity string, limit int) ([]Target, error) {
+	rows, err := view.Query(rootID, Dataset, map[string]any{RelatedIndexKey: identity}, 10001)
+	if err != nil {
+		return nil, err
+	}
+	if len(rows) > 10000 {
+		return nil, ErrReadLimit
+	}
+	seen := map[string]Target{}
+	for _, row := range rows {
+		c, err := ClaimFromStored(row)
+		if err != nil {
+			return nil, err
+		}
+		seen[targetKey(c.Operation.Target)] = c.Operation.Target
+	}
+	if len(seen) > limit {
+		return nil, ErrReadLimit
+	}
+	out := make([]Target, 0, len(seen))
+	for _, target := range seen {
+		out = append(out, target)
+	}
+	slices.SortFunc(out, func(a, b Target) int { return strings.Compare(targetKey(a), targetKey(b)) })
+	return out, nil
+}
+
+// FindRelated uses a first indexed read only to declare dependency trees. It
+// then repeats all candidate/fold/target checks in one current-ACL snapshot with
+// those trees held. A new candidate appearing in between refuses explicitly;
+// callers retry, and no incomplete candidate list is reported as ready.
+func FindRelated(ctx context.Context, sp space.Space, rootID, identity string, limit int) (RelatedResult, error) {
+	if !validText(identity, true, 4096) || limit < 1 || limit > 1000 {
+		return RelatedResult{}, ErrInvalid
+	}
+	dependencies := []string{rootID}
+	declared := map[string]bool{rootID: true}
+	err := space.NativeReadSnapshot(ctx, sp, []string{rootID}, func(view handler.NativeReadView) error {
+		candidates, err := relatedCandidates(view, rootID, identity, limit)
+		if err != nil {
+			return err
+		}
+		for _, target := range candidates {
+			if _, err := nativeTargetRow(view, sp.Id(), target); errors.Is(err, handler.ErrValidation) {
+				continue
+			} else if err != nil {
+				return err
+			}
+			if !declared[target.ObjectID] {
+				declared[target.ObjectID] = true
+				dependencies = append(dependencies, target.ObjectID)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return RelatedResult{}, err
+	}
+	out := RelatedResult{Contract: ContractID, Version: 1, Identity: identity, Coverage: "complete", Targets: []RelatedTarget{}, ConflictingTargets: []Target{}}
+	err = space.NativeReadSnapshot(ctx, sp, dependencies, func(view handler.NativeReadView) error {
+		unknown, err := view.Query(rootID, Dataset, map[string]any{SemanticStatusKey: map[string]any{"$in": []string{"unsupported-opaque", "invalid-semantic-payload"}}}, 1)
+		if err != nil {
+			return err
+		}
+		out.UnsupportedClaimsPresent = len(unknown) > 0
+		if out.UnsupportedClaimsPresent {
+			out.Coverage = "incomplete-unsupported-payload"
+		}
+		candidates, err := relatedCandidates(view, rootID, identity, limit)
+		if err != nil {
+			return err
+		}
+		inputRows := map[string]string{}
+		for _, target := range candidates {
+			row, err := nativeTargetRow(view, sp.Id(), target)
+			if errors.Is(err, handler.ErrValidation) {
+				inputRows[targetKey(target)] = "ineligible"
+				continue
+			}
+			if err != nil {
+				return err
+			}
+			if !declared[target.ObjectID] {
+				return ErrSnapshotChanged
+			}
+			inputRows[targetKey(target)] = row.String()
+			if err := validateBlockPath(target, view); errors.Is(err, handler.ErrValidation) {
+				inputRows[targetKey(target)] += "|ineligible-block"
+				continue
+			} else if err != nil {
+				return err
+			}
+			p, err := readTarget(view, rootID, target, 10000)
+			if err != nil {
+				return err
+			}
+			semantic := SemanticFold(p)
+			if len(p.Conflicts) > 0 || len(p.PendingObserved) > 0 || len(semantic.ConflictingClaimIDs) > 0 {
+				out.ConflictingTargets = append(out.ConflictingTargets, target)
+				out.Coverage = "incomplete-conflict-or-pending"
+				continue
+			}
+			result := RelatedTarget{SpaceID: sp.Id(), ObjectID: target.ObjectID, BlockID: target.BlockID,
+				ContextItemIDs: []string{}, SourceQuoteItemIDs: []string{}, SemanticInputSHA256: semantic.InputSHA256}
+			for _, c := range p.Live {
+				b, err := bind(c)
+				if err != nil {
+					continue
+				}
+				if b.RelatedIdentity != identity {
+					continue
+				}
+				if b.Role == "context" {
+					result.ContextItemIDs = append(result.ContextItemIDs, b.ItemID)
+				} else if b.Role == "sourceQuote" {
+					result.SourceQuoteItemIDs = append(result.SourceQuoteItemIDs, b.ItemID)
+				}
+			}
+			if len(result.ContextItemIDs)+len(result.SourceQuoteItemIDs) == 0 {
+				continue
+			}
+			slices.Sort(result.ContextItemIDs)
+			slices.Sort(result.SourceQuoteItemIDs)
+			result.CanSafelyUnlink = target.BlockID == "" && len(result.SourceQuoteItemIDs) == 0 && len(result.ContextItemIDs) > 0 && view.CanWrite()
+			out.Targets = append(out.Targets, result)
+		}
+		out.Readiness = readiness(view, out.Coverage, inputRows)
+		return nil
+	})
+	return out, err
+}
diff --git a/internal/pinkha/claims/semantic.go b/internal/pinkha/claims/semantic.go
new file mode 100644
index 0000000..4467bf9
--- /dev/null
+++ b/internal/pinkha/claims/semantic.go
@@ -0,0 +1,135 @@
+package claims
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any/internal/pinkha/derived"
+)
+
+const (
+	SemanticStatusKey = "pinkhaSemanticStatus"
+	SourcesIndexKey   = "pinkhaSources"
+	TopicsIndexKey    = "pinkhaTopics"
+	WordsIndexKey     = "pinkhaWords"
+	RelatedIndexKey   = "pinkhaRelatedSource"
+	SemanticVersion   = 1
+)
+
+func bind(c Claim) (derived.BoundClaim, error) {
+	op := c.Operation
+	return derived.BindClaim(derived.ClaimBinding{SpaceID: op.SpaceID, ObjectID: op.Target.ObjectID,
+		BlockID: op.Target.BlockID, ProviderID: op.Source.ProviderID, CanonicalRef: op.Source.CanonicalRef}, op.Payload)
+}
+
+func SemanticIndex(c Claim) (string, derived.Projection) {
+	empty := derived.Projection{Sources: []string{}, Topics: []string{}, Words: []string{}}
+	if c.Operation.Kind == Remove {
+		return "remove", empty
+	}
+	b, err := bind(c)
+	if errors.Is(err, derived.ErrUnsupported) {
+		return "unsupported-opaque", empty
+	}
+	if err != nil {
+		return "invalid-semantic-payload", empty
+	}
+	if !b.DocumentContext {
+		return "valid-non-document-context", b.Projection
+	}
+	return "valid-document-context", b.Projection
+}
+
+type SemanticProjection struct {
+	Version             int                             `json:"version"`
+	Coverage            string                          `json:"coverage"`
+	InputSHA256         string                          `json:"inputSHA256"`
+	Sources             []string                        `json:"sources"`
+	Topics              []string                        `json:"topics"`
+	Words               []string                        `json:"words"`
+	Labels              map[string]derived.DisplayLabel `json:"labels"`
+	Records             []json.RawMessage               `json:"records"`
+	ConflictingClaimIDs []string                        `json:"conflictingClaimIds"`
+	UnsupportedClaimIDs []string                        `json:"unsupportedClaimIds"`
+}
+
+// SemanticFold runs only after the native operation fold. No two distinct live
+// claims are silently deduplicated by equal payload: repeated context identity
+// is a conflict. The original operation-level exact retry already has one ID.
+func SemanticFold(p Projection) SemanticProjection {
+	out := SemanticProjection{Version: SemanticVersion, Coverage: "complete",
+		Sources: []string{}, Topics: []string{}, Words: []string{},
+		Labels: map[string]derived.DisplayLabel{}, Records: []json.RawMessage{},
+		ConflictingClaimIDs: []string{}, UnsupportedClaimIDs: []string{}}
+	bound := map[string]derived.BoundClaim{}
+	semanticGroups, stableGroups := map[string][]string{}, map[string][]string{}
+	ids := make([]string, 0, len(p.Live))
+	for _, c := range p.Live {
+		ids = append(ids, c.ID)
+		b, err := bind(c)
+		if err != nil {
+			out.UnsupportedClaimIDs = append(out.UnsupportedClaimIDs, c.ID)
+			continue
+		}
+		bound[c.ID] = b
+		out.Records = append(out.Records, b.Record)
+		semanticGroups[b.SemanticIdentity] = append(semanticGroups[b.SemanticIdentity], c.ID)
+		stableGroups[b.StableID] = append(stableGroups[b.StableID], c.ID)
+	}
+	conflicted := map[string]bool{}
+	for _, group := range semanticGroups {
+		if len(group) > 1 {
+			for _, id := range group {
+				conflicted[id] = true
+			}
+		}
+	}
+	for _, group := range stableGroups {
+		identities := map[string]bool{}
+		for _, id := range group {
+			identities[bound[id].SemanticIdentity] = true
+		}
+		if len(identities) > 1 {
+			for _, id := range group {
+				conflicted[id] = true
+			}
+		}
+	}
+	for id, b := range bound {
+		if conflicted[id] {
+			continue
+		}
+		out.Sources = append(out.Sources, b.Projection.Sources...)
+		out.Topics = append(out.Topics, b.Projection.Topics...)
+		out.Words = append(out.Words, b.Projection.Words...)
+		for key, label := range b.Projection.Labels {
+			out.Labels[key] = label
+		}
+	}
+	for id := range conflicted {
+		out.ConflictingClaimIDs = append(out.ConflictingClaimIDs, id)
+	}
+	for _, values := range [][]string{out.Sources, out.Topics, out.Words, out.ConflictingClaimIDs, out.UnsupportedClaimIDs, ids} {
+		slices.Sort(values)
+	}
+	if len(out.UnsupportedClaimIDs) > 0 {
+		out.Coverage = "incomplete-unsupported-payload"
+	}
+	if len(out.ConflictingClaimIDs) > 0 || len(p.Conflicts) > 0 || len(p.PendingObserved) > 0 {
+		out.Coverage = "incomplete-conflict-or-pending"
+	}
+	// This hash is explicitly over the native live IDs + conflict/pending sets,
+	// not a claim that the original old canonical document blob was rewritten.
+	raw, _ := json.Marshal(struct {
+		Version   int
+		Live      []string
+		Conflicts []Conflict
+		Pending   []string
+	}{SemanticVersion, ids, p.Conflicts, p.PendingObserved})
+	h := sha256.Sum256(raw)
+	out.InputSHA256 = hex.EncodeToString(h[:])
+	return out
+}
diff --git a/internal/pinkha/claims/semantic_test.go b/internal/pinkha/claims/semantic_test.go
new file mode 100644
index 0000000..b59577b
