+package server
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any/internal/pinkha/claims"
+	"github.com/labstack/echo/v4"
+)
+
+func (d *deps) pinkhaClaimsSnapshot(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	limit, err := pinkhaLimit(c, claims.MaxSnapshotRecords, claims.MaxSnapshotRecords)
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	root, err := pinkhaRoot(c, sp)
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	snapshot, err := claims.ReadWorkspaceSnapshot(c.Request().Context(), sp, root, limit, "")
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	return c.JSON(http.StatusOK, snapshot)
+}
+
+// The stream carries complete state snapshots, not an operation event log.
+// Registering the native change notification before the initial fenced read
+// closes the snapshot/watch race. A bounded dirty flag coalesces updates; a
+// heartbeat rechecks current ACL and native heads even if a notification was
+// missed. Each emission is independently fenced and complete.
+func (d *deps) pinkhaClaimsWatch(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	limit, err := pinkhaLimit(c, claims.MaxSnapshotRecords, claims.MaxSnapshotRecords)
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	root, err := pinkhaRoot(c, sp)
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	ctx, cancelContext := mergeCtx(c.Request().Context(), d.shutdownCtx)
+	defer cancelContext()
+	dirty := make(chan struct{}, 1)
+	cancel := sp.Changes().Subscribe(func(ch space.ObjectChange) {
+		if ch.ObjectId == root {
+			select {
+			case dirty <- struct{}{}:
+			default:
+			}
+		}
+	})
+	defer cancel()
+	initial, err := claims.ReadWorkspaceSnapshot(ctx, sp, root, limit, "")
+	if err != nil {
+		return pinkhaReadError(c, err, sp.Id())
+	}
+	w := c.Response()
+	w.Header().Set(echo.HeaderContentType, "text/event-stream")
+	w.Header().Set(echo.HeaderCacheControl, "no-cache")
+	w.Header().Set("X-Accel-Buffering", "no")
+	w.WriteHeader(http.StatusOK)
+	emit := func(snapshot *claims.WorkspaceSnapshot) error {
+		if err := writeSSEEvent(w, "snapshot", snapshot.Readiness.Generation, snapshot); err != nil {
+			return err
+		}
+		flush(w)
+		return nil
+	}
+	if err := emit(initial); err != nil {
+		return err
+	}
+	generation := initial.Readiness.Generation
+	heartbeat := time.NewTicker(time.Second)
+	defer heartbeat.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return nil
+		case <-dirty:
+		case <-heartbeat.C:
+		}
+		snapshot, err := claims.ReadWorkspaceSnapshot(ctx, sp, root, limit, generation)
+		if err != nil {
+			// No canonical payload on a failed authority/overflow check.
+			_ = writeSSEEvent(w, "error", "", map[string]any{"code": "pinkha.snapshot_unavailable", "complete": false})
+			flush(w)
+			return nil
+		}
+		if snapshot == nil {
+			if _, err := w.Write([]byte(": authority rechecked\n\n")); err != nil {
+				return err
+			}
+			flush(w)
+			continue
+		}
+		if err := emit(snapshot); err != nil {
+			return err
+		}
+		generation = snapshot.Readiness.Generation
+	}
+}
