+++ b/internal/pinkha/claims/semantic_test.go
@@ -0,0 +1,108 @@
+package claims
+
+import (
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/anyproto/any/internal/pinkha/derived"
+	"github.com/stretchr/testify/require"
+)
+
+func semanticClaim(t *testing.T, n int, kind, role, block, id, ref string) Claim {
+	t.Helper()
+	record := map[string]any{"spaceId": "disposable-space", "objectId": "disposable-document",
+		"item":              map[string]any{"id": id, "kind": kind, "role": role, "providerID": "sefaria", "canonicalKey": ref, "externalID": ref, "labelHe": "מקור", "futureItemField": map[string]any{"kept": true}},
+		"futureRecordField": 17}
+	if block != "" {
+		record["blockId"] = block
+	}
+	raw, err := json.Marshal(map[string]any{"version": 2, "records": []any{record}, "futureEnvelopeField": "preserved"})
+	require.NoError(t, err)
+	op := fixtureOperation(n, string(raw))
+	op.Target.BlockID = block
+	op.Source.CanonicalRef = ref
+	return fixtureClaim(t, op)
+}
+
+func TestNativeSemanticBindingPreservesUnknownFieldsAndOriginalBytes(t *testing.T) {
+	c := semanticClaim(t, 1, "ref", "context", "", "context", "Genesis 1:1")
+	before := append([]byte(nil), c.Operation.Payload...)
+	b, err := bind(c)
+	require.NoError(t, err)
+	require.Equal(t, before, c.Operation.Payload)
+	require.Contains(t, string(b.Record), "futureRecordField")
+	require.Contains(t, string(b.Record), "futureItemField")
+	require.Equal(t, []string{derived.Identity(derived.Ref, "sefaria", "Genesis 1:1", "")}, b.Projection.Sources)
+	for _, change := range []func(*Operation){
+		func(o *Operation) { o.SpaceID = "wrong-space" }, func(o *Operation) { o.Target.ObjectID = "wrong-object" },
+		func(o *Operation) { o.Target.BlockID = "wrong-block" }, func(o *Operation) { o.Source.ProviderID = "wrong-provider" }, func(o *Operation) { o.Source.CanonicalRef = "wrong-ref" },
+	} {
+		op := c.Operation
+		change(&op)
+		_, err := bind(fixtureClaim(t, op))
+		require.ErrorIs(t, err, derived.ErrBinding)
+	}
+}
+
+func TestOnlyDocumentContextProducesNativePropertyIndexes(t *testing.T) {
+	for _, kind := range []string{"ref", "topic", "word"} {
+		t.Run(kind, func(t *testing.T) {
+			c := semanticClaim(t, 1, kind, "context", "", "context", "source")
+			status, p := SemanticIndex(c)
+			require.Equal(t, "valid-document-context", status)
+			require.Equal(t, 1, len(p.Sources)+len(p.Topics)+len(p.Words))
+		})
+	}
+	for i, tc := range []struct{ role, block, ref string }{{"sourceQuote", "", "Genesis 1:1"}, {"context", "stable-block", "Genesis 1:1"}, {"context", "", "anytype-note:local"}} {
+		status, p := SemanticIndex(semanticClaim(t, i+1, "ref", tc.role, tc.block, "context", tc.ref))
+		require.Equal(t, "valid-non-document-context", status)
+		require.Empty(t, p.Sources)
+		require.Empty(t, p.Topics)
+		require.Empty(t, p.Words)
+	}
+	status, _ := SemanticIndex(fixtureClaim(t, fixtureOperation(12, "opaque old T2 bytes")))
+	require.Equal(t, "unsupported-opaque", status)
+}
+
+func TestNativeSemanticConflictsNeverDeduplicateDistinctClaims(t *testing.T) {
+	a := semanticClaim(t, 1, "ref", "context", "", "same-id", "Genesis 1:1")
+	b := semanticClaim(t, 2, "ref", "context", "", "different-id", "Genesis 1:1")
+	p := SemanticFold(Fold(a.Operation.Target, []Claim{a, b}))
+	require.Len(t, p.ConflictingClaimIDs, 2)
+	require.Empty(t, p.Sources)
+	identical := a.Operation
+	identical.OperationID = fmt.Sprintf("%032x", 3)
+	p = SemanticFold(Fold(a.Operation.Target, []Claim{a, fixtureClaim(t, identical)}))
+	require.Len(t, p.ConflictingClaimIDs, 2)
+	c := semanticClaim(t, 4, "topic", "context", "", "same-id", "different-topic")
+	p = SemanticFold(Fold(a.Operation.Target, []Claim{a, c}))
+	require.Len(t, p.ConflictingClaimIDs, 2)
+	qa := semanticClaim(t, 5, "ref", "sourceQuote", "", "quote-a", "Genesis 1:1")
+	qb := semanticClaim(t, 6, "ref", "sourceQuote", "", "quote-b", "Genesis 1:1")
+	p = SemanticFold(Fold(a.Operation.Target, []Claim{qa, qb}))
+	require.Empty(t, p.ConflictingClaimIDs)
+	require.Len(t, p.Records, 2)
+	require.Empty(t, p.Sources)
+}
+
+func TestExternalOnlyInternalNoteNeverBecomesDocumentSource(t *testing.T) {
+	c := semanticClaim(t, 1, "ref", "context", "", "internal-note", "anytype-note:synthetic")
+	var envelope map[string]any
+	require.NoError(t, json.Unmarshal(c.Operation.Payload, &envelope))
+	record := envelope["records"].([]any)[0].(map[string]any)
+	record["item"].(map[string]any)["canonicalKey"] = ""
+	raw, err := json.Marshal(envelope)
+	require.NoError(t, err)
+	op := c.Operation
+	op.Payload = raw
+	c = fixtureClaim(t, op)
+	status, p := SemanticIndex(c)
+	require.Equal(t, "valid-non-document-context", status)
+	require.Empty(t, p.Sources)
+	require.Empty(t, p.Topics)
+	require.Empty(t, p.Words)
+	b, err := bind(c)
+	require.NoError(t, err)
+	require.Empty(t, b.RelatedIdentity)
+}
