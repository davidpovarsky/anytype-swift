diff --git a/internal/files/store/migration_prepared_pin.go b/internal/files/store/migration_prepared_pin.go
new file mode 100644
index 0000000..0e71d95
--- /dev/null
+++ b/internal/files/store/migration_prepared_pin.go
@@ -0,0 +1,182 @@
+package store
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/ipfs/go-cid"
+)
+
+// ErrPreparedPayloadPinned protects the only local copy of an uncommitted
+// migration payload. These pins have no age-based expiry: unlike ordinary
+// attach markers, a prepared operation may legitimately wait for a commit.
+var ErrPreparedPayloadPinned = errors.New("filestore: prepared migration payload is pinned")
+
+func preparedPinPrefix(spaceID string) string     { return "migration-prepared/" + spaceID + "/" }
+func preparedAdoptedPrefix(spaceID string) string { return "migration-adopted/" + spaceID + "/" }
+
+func preparedPinKey(spaceID string, root cid.Cid) string {
+	return preparedPinPrefix(spaceID) + root.String()
+}
+
+func (s *Store) PreparedPayloadAdopted(ctx context.Context, spaceID string, root cid.Cid, fileID, intentID, fingerprint string) (bool, error) {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil || fileID == "" {
+		return false, ErrPreparedPayloadPinned
+	}
+	got, found, err := s.GetKV(ctx, preparedAdoptedPrefix(spaceID)+root.String()+"/"+fileID)
+	if err != nil || !found {
+		return false, err
+	}
+	if got != want {
+		return false, ErrPreparedPayloadPinned
+	}
+	pinned, err := s.PreparedPayloadPinned(ctx, spaceID, root)
+	return !pinned, err
+}
+
+// All callers first establish refs, content metadata and the queue job in the
+// same local database. Checkpoint those writes before releasing the only-copy
+// pin, then checkpoint the release before acknowledging local completion.
+func (s *Store) CompletePreparedPayloadAdoption(ctx context.Context, spaceID string, root cid.Cid, fileID, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil || fileID == "" {
+		return ErrPreparedPayloadPinned
+	}
+	if err = s.SetKV(ctx, preparedAdoptedPrefix(spaceID)+root.String()+"/"+fileID, want); err != nil {
+		return err
+	}
+	if err = s.FlushPreparedPayload(ctx, spaceID, root, intentID, fingerprint); err != nil {
+		return err
+	}
+	if err = s.ReleasePreparedPayload(ctx, spaceID, root, intentID, fingerprint); err != nil {
+		return err
+	}
+	return s.db.Flush(ctx, 0, anystore.FlushModeCheckpointFull)
+}
+
+func preparedPinValue(intentID, fingerprint string) (string, error) {
+	for _, v := range []string{intentID, fingerprint} {
+		b, err := hex.DecodeString(v)
+		if err != nil || len(b) != 32 || hex.EncodeToString(b) != v {
+			return "", ErrPreparedPayloadPinned
+		}
+	}
+	return intentID + ":" + fingerprint, nil
+}
+
+// PinPreparedPayload is called before finalizing the new CAR. The same row
+// lock fences Offload/Delete, so neither GC nor an explicit cache eviction
+// can pass a no-pin check concurrently with preparation.
+func (s *Store) PinPreparedPayload(ctx context.Context, spaceID string, root cid.Cid, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil || !root.Defined() || spaceID == "" || spaceID == "." || spaceID == ".." || strings.ContainsAny(spaceID, "/\\\x00") {
+		return ErrPreparedPayloadPinned
+	}
+	return s.withRow(rowId(spaceID, root), func(_ *rowState) error {
+		tx, err := s.db.WriteTx(ctx)
+		if err != nil {
+			return err
+		}
+		defer tx.Rollback()
+		tc := tx.Context()
+		old, found, err := s.GetKV(tc, preparedPinKey(spaceID, root))
+		if err != nil {
+			return err
+		}
+		if found && old != want {
+			return ErrPreparedPayloadPinned
+		}
+		if err = s.SetKV(tc, preparedPinKey(spaceID, root), want); err != nil {
+			return err
+		}
+		return tx.Commit()
+	})
+}
+
+func (s *Store) PreparedPayloadPinned(ctx context.Context, spaceID string, root cid.Cid) (bool, error) {
+	_, found, err := s.GetKV(ctx, preparedPinKey(spaceID, root))
+	return found, err
+}
+
+// Release is scoped to the exact original intent and normalized fingerprint.
+// A caller cannot release another migration's reservation, even for one root.
+func (s *Store) ReleasePreparedPayload(ctx context.Context, spaceID string, root cid.Cid, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil {
+		return err
+	}
+	return s.withRow(rowId(spaceID, root), func(_ *rowState) error {
+		old, found, err := s.GetKV(ctx, preparedPinKey(spaceID, root))
+		if err != nil {
+			return err
+		}
+		if !found {
+			return nil
+		}
+		if old != want {
+			return ErrPreparedPayloadPinned
+		}
+		return s.DeleteKV(ctx, preparedPinKey(spaceID, root))
+	})
+}
+
+// FlushPreparedPayload persists the CAR, its directory chain and the pin/row
+// database before a prepared native row may acknowledge this payload.
+func (s *Store) FlushPreparedPayload(ctx context.Context, spaceID string, root cid.Cid, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil {
+		return err
+	}
+	return s.withRow(rowId(spaceID, root), func(_ *rowState) error {
+		old, found, err := s.GetKV(ctx, preparedPinKey(spaceID, root))
+		if err != nil {
+			return err
+		}
+		if !found || old != want {
+			return ErrPreparedPayloadPinned
+		}
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+		path := s.carPath(spaceID, root)
+		f, err := os.OpenFile(path, os.O_RDWR, 0)
+		if err != nil {
+			return err
+		}
+		err = errors.Join(f.Sync(), f.Close())
+		if err != nil {
+			return err
+		}
+		stop, err := filepath.Abs(s.root)
+		if err != nil {
+			return err
+		}
+		for dir := filepath.Dir(path); ; dir = filepath.Dir(dir) {
+			absolute, err := filepath.Abs(dir)
+			if err != nil {
+				return err
+			}
+			if absolute != stop && !strings.HasPrefix(absolute, stop+string(os.PathSeparator)) {
+				return ErrPreparedPayloadPinned
+			}
+			d, err := os.Open(dir)
+			if err != nil {
+				return err
+			}
+			err = errors.Join(d.Sync(), d.Close())
+			if err != nil {
+				return err
+			}
+			if absolute == stop {
+				break
+			}
+		}
+		return s.db.Flush(ctx, 0, anystore.FlushModeCheckpointFull)
+	})
+}
diff --git a/internal/files/store/store.go b/internal/files/store/store.go
index 3cf0b7b..ad25fd0 100644
--- a/internal/files/store/store.go
+++ b/internal/files/store/store.go
@@ -317,6 +317,11 @@ func (s *Store) RemoveRef(ctx context.Context, spaceId string, root cid.Cid, fil
 func (s *Store) Offload(ctx context.Context, spaceId string, root cid.Cid) error {
 	id := rowId(spaceId, root)
 	return s.withRow(id, func(rs *rowState) error {
+		if pinned, err := s.PreparedPayloadPinned(ctx, spaceId, root); err != nil {
+			return err
+		} else if pinned {
