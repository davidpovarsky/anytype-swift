+)
+
+type intrinsicGuard struct {
+	spaceID, author string
+	calls           int
+}
+
+func (g *intrinsicGuard) GuardRootSeed() []byte { return []byte("test-native-carrier") }
+func (g *intrinsicGuard) LocalTargets(*crdt.Change) ([]string, error) {
+	panic("inbound must not ask for mutable local targets")
+}
+func (g *intrinsicGuard) ValidateLocal(*crdt.Change, crdt.LocalReadView) error {
+	panic("inbound must not run arrival-dependent local checks")
+}
+func (g *intrinsicGuard) ValidateNative(ch *crdt.Change) error {
+	g.calls++
+	if !ch.ObjectDerived || !bytes.Equal(ch.ObjectRootPayload, g.GuardRootSeed()) || ch.SpaceId != g.spaceID || ch.Creator != g.author || ch.ChangeId == "" || ch.ACLHeadId == "" || len(ch.Records) != 1 || len(ch.Records[0].Ops) != 1 || ch.Records[0].Ops[0].Payload.GetString("author") != ch.Creator {
+		return errors.New("test native intrinsic identity mismatch")
+	}
+	return nil
+}
+
+func TestRealSignedRemoteChangesUseIntrinsicGuardBeforeStorage(t *testing.T) {
+	for _, mode := range []string{"valid", "forged inner author", "disguised outer dataset", "wrong root seed", "oversized canonical envelope", "malformed canonical envelope"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := context.Background()
+			keys, err := accountdata.NewRandom()
+			require.NoError(t, err)
+			master, _, err := crypto.GenerateRandomEd25519KeyPair()
+			require.NoError(t, err)
+			metadata, _, err := crypto.GenerateRandomEd25519KeyPair()
+			require.NoError(t, err)
+			payload, err := spacepayloads.StoragePayloadForSpaceCreate(spacepayloads.SpaceCreatePayload{SigningKey: keys.SignKey, SpaceType: "space", ReplicationKey: 10, MasterKey: master, ReadKey: crypto.NewAES(), MetadataKey: metadata, Metadata: []byte("disposable native ingest fixture")})
+			require.NoError(t, err)
+			open := func(name string) (anystore.DB, spacestorage.SpaceStorage) {
+				db, err := anystore.Open(ctx, filepath.Join(t.TempDir(), name), &anystore.Config{ReadConnections: 2})
+				require.NoError(t, err)
+				t.Cleanup(func() { require.NoError(t, db.Close()) })
+				sp, err := spacestorage.Create(ctx, db, payload)
+				require.NoError(t, err)
+				return db, sp
+			}
+			_, writerSpace := open("writer.db")
+			_, receiverSpace := open("receiver.db")
+			aclStorage, err := writerSpace.AclStorage()
+			require.NoError(t, err)
+			acl, err := list.BuildAclListWithIdentity(keys, aclStorage, recordverifier.NewValidateFull())
+			require.NoError(t, err)
+			g := &intrinsicGuard{spaceID: writerSpace.Id(), author: keys.SignKey.GetPublic().Account()}
+			seed := g.GuardRootSeed()
+			if mode == "wrong root seed" {
+				seed = []byte("another-carrier")
+			}
+			root, err := objecttree.DeriveObjectTreeRoot(objecttree.ObjectTreeDerivePayload{SpaceId: writerSpace.Id(), ChangeType: "native-ingest-test", ChangePayload: seed, IsEncrypted: true}, nil)
+			require.NoError(t, err)
+			create := func(sp spacestorage.SpaceStorage) objecttree.Storage {
+				st, err := sp.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{RootRawChange: root, Heads: []string{root.Id}})
+				require.NoError(t, err)
+				return st
+			}
+			writer, err := objecttree.BuildObjectTree(create(writerSpace), acl)
+			require.NoError(t, err)
+			store := &Store{spaceId: writerSpace.Id()}
+			receiver, err := store.guardedTreeBuilder(map[string]crdt.GuardedHandler{"test_guard": g})(create(receiverSpace), acl)
+			require.NoError(t, err)
+			writer.Lock()
+			receiver.Lock()
+			t.Cleanup(func() {
+				receiver.Unlock()
+				require.NoError(t, receiver.Close())
+				writer.Unlock()
+				require.NoError(t, writer.Close())
+			})
+			a := &anyenc.Arena{}
+			fields := a.NewObject()
+			author := g.author
+			if mode == "forged inner author" || mode == "disguised outer dataset" {
+				author = "forged-account"
+			}
+			fields.Set("author", a.NewString(author))
+			data, err := object.NewCodec().Encode(&crdt.Change{Dataset: "test_guard", DataVersion: "test-v1", Records: []crdt.RecordChange{{Id: "claim", Upsert: true, Ops: []crdt.Op{{Type: crdt.OpSet, Payload: fields}}}}})
+			require.NoError(t, err)
+			if mode == "oversized canonical envelope" {
+				data = bytes.Repeat([]byte("x"), 2*1024*1024+1)
+			}
+			if mode == "malformed canonical envelope" {
+				data = []byte("not SDK wire data")
+			}
+			outer := "test_guard"
+			if mode == "disguised outer dataset" {
+				outer = "objects"
+			}
+			created, err := writer.AddContent(ctx, objecttree.SignableChangeContent{Key: keys.SignKey, Data: data, DataType: outer, ShouldBeEncrypted: true})
+			require.NoError(t, err)
+			require.Len(t, created.Added, 1)
+			raw := created.Added[0].RawTreeChangeWithId()
+			_, err = receiver.AddRawChanges(ctx, objecttree.RawChangesPayload{NewHeads: []string{raw.Id}, RawChanges: []*treechangeproto.RawTreeChangeWithId{raw}})
+			has, readErr := receiver.Storage().Has(ctx, raw.Id)
+			require.NoError(t, readErr)
+			if mode == "valid" {
+				require.NoError(t, err)
+				require.True(t, has)
+				require.Greater(t, g.calls, 0)
+			} else {
+				require.Error(t, err)
+				require.False(t, has, "rejected signed operation must not become native history")
+			}
+		})
+	}
+}
