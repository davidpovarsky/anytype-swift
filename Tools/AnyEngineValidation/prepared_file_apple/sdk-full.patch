+++ b/internal/object/current_writer.go
@@ -0,0 +1,45 @@
+package object
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+)
+
+// currentWriterNoop is called only after the caller has taken the native tree
+// lock, caught up its projection, checked the dataset sequence and run local
+// validation. An empty patch must not bypass authority or append a fake edit.
+func (o *Object) currentWriterNoop(ctx context.Context, ch crdt.Change) (WriteResult, bool, error) {
+	if len(ch.Records) == 0 {
+		return WriteResult{}, false, crdt.ErrValidation
+	}
+	for _, record := range ch.Records {
+		if len(record.Ops) != 0 {
+			return WriteResult{}, false, nil
+		}
+	}
+	ids := make([]string, 0, len(ch.Records))
+	for _, record := range ch.Records {
+		if record.Id == "" || record.Upsert {
+			return WriteResult{}, true, crdt.ErrValidation
+		}
+		row, err := o.ctrl.Lookup(ctx, ch.Dataset, record.Id)
+		if err != nil {
+			return WriteResult{}, true, err
+		}
+		if row == nil || row.Get(crdt.DeletedAtField) != nil {
+			return WriteResult{}, true, fmt.Errorf("%w: conditional empty patch requires an existing record", crdt.ErrValidation)
+		}
+		ids = append(ids, record.Id)
+	}
+	if o.signKey == nil {
+		return WriteResult{}, true, commitguard.ErrNativeCommitGuard
+	}
+	if err := commitguard.CheckCurrentWrite(ctx, o.tree, o.signKey.GetPublic()); err != nil {
+		return WriteResult{}, true, err
+	}
+	o.ctrl.StoreIds(ch.Dataset, ids)
+	return WriteResult{RecordIds: ids}, true, nil
+}
