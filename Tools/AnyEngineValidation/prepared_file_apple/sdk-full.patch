+	"github.com/stretchr/testify/require"
+)
+
+// Policy semantics are tested separately against the actual native store.
+// This test-only view isolates the real native signed-tree/ACL no-op boundary.
+type noopPolicyView struct{ o *Object }
+
+func (v noopPolicyView) Lookup(objectID, dataset, id string) (*anyenc.Value, error) {
+	if objectID != v.o.Id() {
+		return nil, crdt.ErrValidation
+	}
+	return v.o.ctrl.GuardLookup(context.Background(), dataset, id)
+}
+func (v noopPolicyView) Query(objectID, dataset string, filter any, limit int) ([]*anyenc.Value, error) {
+	if objectID != v.o.Id() {
+		return nil, crdt.ErrValidation
+	}
+	return v.o.ctrl.GuardQuery(context.Background(), dataset, filter, limit)
+}
+func (v noopPolicyView) ValidateNativeObjectChange(ch *crdt.Change) error { return nil }
+
+func objectConditionalNoop(o *Object) crdt.Change {
+	return crdt.Change{Dataset: "objects", DataVersion: "cas-fixture-v1", NativeObjectPolicy: true,
+		NativeConditionalNoop: true, NativeDefinitionOwners: []string{"any"},
+		Records: []crdt.RecordChange{{Id: o.Id()}}}
+}
+func installNoopPolicyFixture(o *Object) {
+	o.lockLocalWrite = func(ctx context.Context, carrier *Object, change *crdt.Change) (crdt.LocalReadView, func(), error) {
+		o.tree.Lock()
+		return noopPolicyView{o: o}, o.tree.Unlock, nil
+	}
+}
+
+func TestNativeConditionalPropertyNoopChecksCurrentSignerAfterValidation(t *testing.T) {
+	for _, mode := range []string{"revoked writer", "cancelled request", "missing signer"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			o := newObjectRowCASFixture(t)
+			writer := blockAddWriter(t, o)
+			o.signKey = writer
+			seed, err := o.LocalWrite(ctx, casChange(t, o, "before", true))
+			require.NoError(t, err)
+			installNoopPolicyFixture(o)
+			heads := append([]string(nil), o.tree.Heads()...)
+			version := o.ctrl.Get(ctx, "objects", o.Id()).Get("_ver").String()
+			called := false
+			ch := objectConditionalNoop(o)
+			ch.NativeDefinitionValidation = func() error {
+				called = true
+				switch mode {
+				case "revoked writer":
+					blockRemoveWriter(t, o, writer)
+				case "cancelled request":
+					cancel()
+				case "missing signer":
+					o.signKey = nil
+				}
+				return nil
+			}
+			_, err = o.LocalWriteIfObject(ctx, ch, seed.ApplySeq)
+			require.Error(t, err)
+			if mode == "revoked writer" {
+				require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+			}
+			if mode == "cancelled request" {
+				require.ErrorIs(t, err, context.Canceled)
+			}
+			require.True(t, called)
+			require.Equal(t, heads, o.tree.Heads())
+			require.Equal(t, version, o.ctrl.Get(context.Background(), "objects", o.Id()).Get("_ver").String())
+		})
+	}
+}
+
+func TestNativeConditionalPropertyNoopDoesNotLeakToWireOrGenericWrites(t *testing.T) {
+	ctx := context.Background()
+	o := newObjectRowCASFixture(t)
+	seed, err := o.LocalWrite(ctx, casChange(t, o, "before", true))
+	require.NoError(t, err)
+	ch := objectConditionalNoop(o)
+	codec := NewCodec()
+	encoded, err := codec.Encode(&ch)
+	require.NoError(t, err)
+	retained := append([]byte(nil), encoded...)
+	ch.NativeConditionalNoop = false
+	ordinary, err := codec.Encode(&ch)
+	require.NoError(t, err)
+	require.Equal(t, ordinary, retained)
+	decoded, err := codec.Decode(retained)
+	require.NoError(t, err)
+	require.False(t, decoded.NativeConditionalNoop)
+	ch.NativeConditionalNoop = true
+	raw, err := json.Marshal(ch)
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), "NativeConditionalNoop")
+	heads := append([]string(nil), o.tree.Heads()...)
+	_, err = o.LocalWrite(ctx, ch)
+	require.ErrorIs(t, err, crdt.ErrValidation)
+	_, err = o.LocalWriteCurrentWriter(ctx, ch)
+	require.ErrorIs(t, err, crdt.ErrValidation)
+	for _, mode := range []string{"operations", "owner missing", "policy missing"} {
+		malformed := objectConditionalNoop(o)
+		switch mode {
+		case "operations":
+			malformed.Records[0].Ops = []crdt.Op{recordOp(t, "name", "bad")}
+		case "owner missing":
+			malformed.NativeDefinitionOwners = nil
+		case "policy missing":
+			malformed.NativeObjectPolicy = false
+		}
+		_, err = o.LocalWriteIfObject(ctx, malformed, seed.ApplySeq)
+		require.ErrorIs(t, err, crdt.ErrValidation, mode)
+	}
+	require.Equal(t, heads, o.tree.Heads())
+}
