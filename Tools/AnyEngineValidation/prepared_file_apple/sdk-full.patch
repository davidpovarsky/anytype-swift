+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/util/crypto"
+)
+
+type lockedReadView struct {
+	ctx     context.Context
+	objects map[string]*object.Object
+	store   *Store
+	carrier *object.Object
+}
+
+func (v lockedReadView) Lookup(objectId, dataset, id string) (*anyenc.Value, error) {
+	o := v.objects[objectId]
+	if o == nil {
+		return nil, errors.New("native guard: undeclared object dependency")
+	}
+	if o.Controller().IsShared(dataset) && id != objectId {
+		return nil, errors.New("native guard: foreign shared row")
+	}
+	return o.Controller().GuardLookup(v.ctx, dataset, id)
+}
+
+// PreparedHeads snapshots the exact carrier/definition envelope while every
+// member tree is locked. This is private SDK state, never a replicated field.
+func (v lockedReadView) PreparedHeads() map[string][]string {
+	heads := make(map[string][]string, len(v.objects))
+	for id, obj := range v.objects {
+		heads[id] = append([]string(nil), obj.Tree().Heads()...)
+		sort.Strings(heads[id])
+	}
+	return heads
+}
+
+func (v lockedReadView) Query(objectId, dataset string, filter any, limit int) ([]*anyenc.Value, error) {
+	o := v.objects[objectId]
+	if o == nil {
+		return nil, errors.New("native guard: undeclared object dependency")
+	}
+	return o.Controller().GuardQuery(v.ctx, dataset, filter, limit)
+}
+
+func (s *Store) lockLocalWrite(ctx context.Context, carrier *object.Object, ch *crdt.Change) (crdt.LocalReadView, func(), error) {
+	g := carrier.Controller().LocalGuard(ch.Dataset)
+	if g == nil && !ch.NativeObjectPolicy {
+		return nil, nil, errors.New("native guard: no handler")
+	}
+	var ids []string
+	var err error
+	if g != nil {
+		ids, err = g.LocalTargets(ch)
+		if err != nil {
+			return nil, nil, err
+		}
+	}
+	if len(ids) > 256 {
+		return nil, nil, errors.New("native guard: dependency limit")
+	}
+	objects := map[string]*object.Object{carrier.Id(): carrier}
+	for _, id := range ids {
+		if id == "" {
+			return nil, nil, errors.New("native guard: empty target")
+		}
+		if objects[id] != nil {
+			continue
+		}
+		o, err := s.Get(ctx, id)
+		if err != nil {
+			return nil, nil, err
+		}
+		objects[id] = o
+	}
+	if err := s.preloadNativeDefinitions(ctx, objects, carrier, ch); err != nil {
+		return nil, nil, err
+	}
+	return s.lockPreparedNativeObjects(ctx, objects, carrier)
+}
+
+func (s *Store) lockPreparedNativeObjects(ctx context.Context, objects map[string]*object.Object, carrier *object.Object) (crdt.LocalReadView, func(), error) {
+	order := make([]string, 0, len(objects))
+	for id := range objects {
+		order = append(order, id)
+	}
+	sort.Strings(order)
+	locked := make([]*object.Object, 0, len(order))
+	unlock := func() {
+		for i := len(locked) - 1; i >= 0; i-- {
+			locked[i].Tree().Unlock()
+		}
+	}
+	for _, id := range order {
+		o := objects[id]
+		if err := ctx.Err(); err != nil {
+			unlock()
+			return nil, nil, err
+		}
+		if o.Tree() == nil {
+			unlock()
+			return nil, nil, object.ErrTreeNotSet
+		}
+		o.Tree().Lock()
+		locked = append(locked, o)
+		if err := o.GuardReadyLocked(ctx); err != nil {
+			unlock()
+			return nil, nil, err
+		}
+	}
+	return lockedReadView{ctx: ctx, objects: objects, store: s, carrier: carrier}, unlock, nil
+}
+
+// guardedTreeBuilder keeps AnySync's cryptographic/historical ACL verifier and
+// adds the compiled module's intrinsic validator BEFORE native tree storage.
+// It never evaluates mutable targets or predecessor arrival order on replay.
+func (s *Store) guardedTreeBuilder(guards map[string]crdt.GuardedHandler) objecttree.BuildObjectTreeFunc {
+	return func(storage objecttree.Storage, acl list.AclList) (objecttree.ObjectTree, error) {
+		header, err := storage.Root(context.Background())
+		if err != nil {
+			return nil, err
+		}
+		rawRoot := header.RawTreeChangeWithId()
+		root, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), rawRoot).Unmarshall(rawRoot, true)
+		if err != nil {
+			return nil, err
+		}
+		info, _ := root.Model.(*treechangeproto.TreeChangeInfo)
+		var seed []byte
+		if info != nil {
+			seed = info.ChangePayload
+		}
+		isCarrier := false
+		for _, g := range guards {
+			isCarrier = isCarrier || (root.IsDerived && bytes.Equal(seed, g.GuardRootSeed()))
+		}
+		validate := func(raw *objecttree.Change, acl list.AclList) error {
+			if raw.Id == rawRoot.Id {
+				return nil
+			}
+			_, namedGuard := guards[raw.DataType]
+			// A bounded read of other SDK changes also detects a forged outer
+			// DataType that attempts to hide a guarded inner dataset.
+			if len(raw.Data) > 2*1024*1024 {
+				if isCarrier || namedGuard {
+					return errors.New("native guard: change exceeds wire bound")
+				}
+				return nil
+			}
+			data := raw.Data
+			if raw.ReadKeyId != "" {
+				keys, ok := acl.AclState().Keys()[raw.ReadKeyId]
+				if !ok || keys.ReadKey == nil {
+					return list.ErrNoReadKey
+				}
+				rawKey, err := keys.ReadKey.Raw()
+				if err != nil {
+					return err
+				}
+				key, err := crypto.NewKeyDeriver(fmt.Sprintf(crypto.AnysyncTreePath, storage.Id())).DeriveKey(rawKey)
+				if err != nil {
+					return err
+				}
+				data, err = key.Decrypt(raw.Data)
+				if err != nil {
+					return err
+				}
+			}
+			decoded, err := object.NewCodec().Decode(data)
+			if err != nil {
+				if isCarrier || namedGuard {
+					return err
+				}
+				return nil
+			}
+			g := guards[decoded.Dataset]
+			if g == nil {
+				return nil
+			}
+			if raw.ReadKeyId == "" || raw.Identity == nil || raw.IsSnapshot {
+				return errors.New("native guard: signed encrypted operation required")
+			}
+			decoded.SpaceId, decoded.ObjectId = s.spaceId, storage.Id()
+			decoded.ChangeId, decoded.Creator, decoded.ACLHeadId = raw.Id, raw.Identity.Account(), raw.AclHeadId
+			decoded.ObjectDerived, decoded.ObjectRootPayload = root.IsDerived, append([]byte(nil), seed...)
+			return g.ValidateNative(&decoded)
+		}
+		return commitguard.Builder(validate)(storage, acl)
+	}
+}
+
+// NativeReadSnapshot holds all declared native objects, then current ACL, then
+// a single projection transaction. The callback receives only already-loaded
+// controller reads: it cannot reenter object loading or acquire locks in the
+// opposite order. The order matches native writes (trees -> ACL -> storage).
+func (s *Store) NativeReadSnapshot(ctx context.Context, ids []string, read func(crdt.NativeReadView) error) (err error) {
+	if read == nil || len(ids) > 1001 || s.signKey == nil {
+		return errors.New("native snapshot: invalid dependencies")
+	}
+	generation, err := s.Generation(ctx)
+	if err != nil {
+		return err
+	}
+	handle, err := s.app.GetSpace(ctx, s.spaceId)
+	if err != nil {
+		return err
+	}
+	acl := handle.Inner().Acl()
+	if acl == nil {
+		return list.ErrInsufficientPermissions
+	}
+	objects := make(map[string]*object.Object)
+	for _, id := range ids {
+		if id == "" {
+			return errors.New("native snapshot: empty dependency")
+		}
+		if objects[id] != nil {
+			continue
+		}
+		o, err := s.Get(ctx, id)
+		if err != nil {
+			return err
+		}
+		objects[id] = o
+	}
+	if err := s.preloadNativeDefinitions(ctx, objects, nil, nil); err != nil {
+		return err
+	}
+	order := make([]string, 0, len(objects))
+	for id := range objects {
+		order = append(order, id)
+	}
+	sort.Strings(order)
+	locked := make([]*object.Object, 0, len(order))
+	defer func() {
+		for i := len(locked) - 1; i >= 0; i-- {
+			locked[i].Tree().Unlock()
+		}
+	}()
+	for _, id := range order {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		o := objects[id]
+		if o.Tree() == nil {
+			return object.ErrTreeNotSet
+		}
+		o.Tree().Lock()
+		locked = append(locked, o)
+		if err := o.GuardReadyLocked(ctx); err != nil {
+			return err
+		}
+	}
+	acl.RLock()
+	defer acl.RUnlock()
+	permission := acl.AclState().Permissions(s.signKey.GetPublic())
+	switch permission {
+	case list.AclPermissionsReader, list.AclPermissionsWriter, list.AclPermissionsAdmin, list.AclPermissionsOwner:
+	default:
+		return list.ErrInsufficientPermissions
+	}
+	tx, err := s.db.ReadTx(ctx)
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, tx.Commit()) }()
+	stamp := crdt.NativeReadStamp{StoreGeneration: generation, TreeHeads: map[string][]string{}}
+	if head := acl.Head(); head != nil {
+		stamp.ACLHeadID = head.Id
+	}
+	for id, o := range objects {
+		stamp.TreeHeads[id] = append([]string(nil), o.Tree().Heads()...)
+		sort.Strings(stamp.TreeHeads[id])
+	}
+	// Immutable compiled-Type metadata needs only current Space ACL, not an
+	// unrelated carrier tree. An empty dependency set cannot read object rows.
+	var controller *crdt.Controller
+	if len(order) > 0 {
+		controller = objects[order[0]].Controller()
+	}
+	return read(snapshotReadView{lockedReadView: lockedReadView{ctx: tx.Context(), objects: objects, store: s}, controller: controller, canWrite: permission.CanWrite() && s.CheckWrite() == nil, stamp: stamp})
+}
+
+// Only the native read scope can see arbitrary object rows, all from the same
+// transaction and Space. It cannot materialize a tree or mutate its projection.
+type snapshotReadView struct {
+	lockedReadView
+	controller *crdt.Controller
+	canWrite   bool
+	stamp      crdt.NativeReadStamp
+}
+
+func (v snapshotReadView) SpaceObjects(filter any, limit int) ([]*anyenc.Value, error) {
+	if v.controller == nil {
+		return nil, crdt.ErrValidation
+	}
+	return v.controller.GuardSpaceObjects(v.ctx, filter, limit)
+}
+func (v snapshotReadView) CanWrite() bool                  { return v.canWrite }
+func (v snapshotReadView) ReadStamp() crdt.NativeReadStamp { return v.stamp }
+
+// Guarded canonical datasets are served only through NativeReadSnapshot.
+// Generic queries, subscriptions and history cannot preserve current authority
+// after returning an unrestricted collection, iterator or historical view.
+func (s *Store) RequiresNativeDatasetRead(dataset string) bool {
+	if s == nil {
+		return false
+	}
+	for _, reg := range s.canonicalRegs {
+		if reg.Name == dataset {
+			_, guarded := reg.Handler.(crdt.GuardedHandler)
+			return guarded
+		}
+	}
+	return false
+}
+
+func (s *Store) RefuseNativeCarrierHistory(ctx context.Context, objectID string) error {
+	if s == nil {
+		return nil
+	}
+	var guards []crdt.GuardedHandler
+	for _, reg := range s.canonicalRegs {
+		if g, ok := reg.Handler.(crdt.GuardedHandler); ok {
+			guards = append(guards, g)
+		}
+	}
+	if len(guards) == 0 {
+		return nil
+	}
+	obj, err := s.Get(ctx, objectID)
+	if err != nil {
+		return err
+	}
+	if obj.Tree() == nil {
+		return object.ErrTreeNotSet
+	}
+	obj.Tree().Lock()
+	defer obj.Tree().Unlock()
+	if err := obj.GuardReadyLocked(ctx); err != nil {
+		return err
+	}
+	if !obj.Tree().IsDerived() {
+		return nil
+	}
+	info := obj.Tree().ChangeInfo()
+	if info == nil {
+		return nil
+	}
+	for _, g := range guards {
+		if bytes.Equal(info.ChangePayload, g.GuardRootSeed()) {
+			return crdt.ErrNativeReadRequired
+		}
+	}
+	return nil
+}
diff --git a/internal/spaceobjects/migration_file.go b/internal/spaceobjects/migration_file.go
new file mode 100644
index 0000000..8fb6659
--- /dev/null
+++ b/internal/spaceobjects/migration_file.go
@@ -0,0 +1,193 @@
+package spaceobjects
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"slices"
+	"time"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/internal/payloads"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/util/crypto"
+)
+
+func (s *Store) PrepareMigrationFile(ctx context.Context, journal *migrationintent.Store, proposed *migrationintent.File, spec migrationintent.FileSpec) (*migrationintent.File, error) {
+	if journal == nil || proposed == nil || spec.Validate() != nil {
+		return nil, migrationintent.ErrScope
+	}
+	root, err := commitguard.InlineFileRoot(s.spaceId, spec.OwnerObjectID)
+	if err != nil {
+		return nil, err
+	}
+	var result *migrationintent.File
+	err = s.withInlineFileObjects(ctx, spec.OwnerObjectID, root.Id, func(owner, carrier *object.Object) error {
+		heads := []string{root.Id}
+		if carrier != nil {
+			if !bytes.Equal(carrier.Tree().Header().RawChange, root.RawChange) {
+				return migrationintent.ErrCollision
+			}
+			heads = slices.Clone(carrier.Tree().Heads())
+		}
+		acl := owner.Tree().AclList()
+		var raw *treechangeproto.RawTreeChangeWithId
+		entry := *proposed
+		entry.ObjectID, entry.RootRaw, entry.OwnerObjectID = root.Id, bytes.Clone(root.RawChange), spec.OwnerObjectID
+		entry.ContentSHA256, entry.Size, entry.Timestamp = spec.ContentSHA256, spec.Size, time.Now().Unix()
+		// No registration, append, watcher or publish callback is invoked here.
+		err := func() error {
+			acl.RLock()
+			defer acl.RUnlock()
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			if !acl.AclState().Permissions(s.signKey.GetPublic()).CanWrite() {
+				return list.ErrInsufficientPermissions
+			}
+			if acl.Head() == nil {
+				return commitguard.ErrNativeCommitGuard
+			}
+			entry.ReadKeyID, entry.ACLHeadID = acl.AclState().CurrentReadKeyId(), acl.Head().Id
+			readKey, err := acl.AclState().CurrentReadKey()
+			if err != nil {
+				return err
+			}
+			key, err := payloads.DeriveEncKey(readKey)
+			if err != nil {
+				return err
+			}
+			entry.Payload, err = object.BuildMigrationFilePayload(spec, entry.Staged, entry.ReadKeyID, key)
+			if err != nil {
+				return err
+			}
+			_, raw, err = objecttree.NewChangeBuilder(crypto.NewKeyStorage(), root).Build(objecttree.BuilderContent{
+				TreeHeadIds: heads, AclHeadId: entry.ACLHeadID, SnapshotBaseId: root.Id,
+				Unencrypted: true, PrivKey: s.signKey, Content: entry.Payload, Timestamp: entry.Timestamp, DataType: payloads.Dataset,
+			})
+			return err
+		}()
+		if err != nil {
+			return err
+		}
+		entry.ChangeID, entry.Raw = raw.Id, bytes.Clone(raw.RawChange)
+		ch, err := object.NewCodec().Decode(entry.Payload)
+		if err != nil {
+			return err
+		}
+		ch.ChangeId = entry.ChangeID
+		entry.RecordIDs, err = crdt.ResolveRecordIds(ch)
+		if err != nil {
+			return err
+		}
+		entry.Dependencies = map[string][]string{spec.OwnerObjectID: slices.Clone(owner.Tree().Heads()), root.Id: heads}
+		if _, err = object.CheckMigrationFile(ctx, acl, s.signKey.GetPublic(), &entry, true); err != nil {
+			return err
+		}
+		if carrier != nil {
+			row, err := carrier.Controller().GuardLookup(ctx, payloads.Dataset, entry.RecordIDs[0])
+			if err != nil {
+				return err
+			}
+			if row != nil {
+				return migrationintent.ErrCollision
+			}
+		}
+		result, err = journal.ReserveFile(ctx, &entry)
+		return err
+	})
+	return result, err
+}
+
+// MigrationFileState advances at most one native durable stage. Native
+// CID/history and materialized row determine recovery; a host receipt does not.
+func (s *Store) MigrationFileState(ctx context.Context, e *migrationintent.File, commit bool) (stage, outcome string, err error) {
+	if e == nil {
+		return "", "", migrationintent.ErrCorrupt
+	}
+	stage, outcome = "file-prepared", "prepared"
+	err = s.withInlineFileObjects(ctx, e.OwnerObjectID, e.ObjectID, func(owner, carrier *object.Object) error {
+		if carrier != nil {
+			stage = "file-root-committed"
+			var err error
+			outcome, err = carrier.MigrationFileLocked(ctx, e, false)
+			if err != nil {
+				return err
+			}
+			if outcome != "prepared" {
+				if outcome == "committed" || outcome == "committed_deleted" || outcome == "committed_modified" {
+					stage = "file-row-committed"
+				}
+				return nil
+			}
+		} else {
+			if _, err := object.CheckMigrationFile(ctx, owner.Tree().AclList(), s.signKey.GetPublic(), e, true); err != nil {
+				return err
+			}
+		}
+		if !inlineSameHeads(owner.Tree().Heads(), e.Dependencies[e.OwnerObjectID]) {
+			return migrationintent.ErrObsolete
+		}
+		if !commit {
+			return nil
+		}
+		if carrier != nil {
+			outcome, err = carrier.MigrationFileLocked(ctx, e, true)
+			if err == nil && outcome != "obsolete" {
+				stage = "file-row-committed"
+			}
+			return err
+		}
+		if !inlineSameHeads(e.Dependencies[e.ObjectID], []string{e.ObjectID}) {
+			return migrationintent.ErrObsolete
+		}
+		if _, err := s.CheckDeriveParent(ctx, e.ObjectID, e.OwnerObjectID); err != nil {
+			return err
+		}
+		handle, err := s.app.GetSpace(ctx, s.spaceId)
+		if err != nil {
+			return err
+		}
+		err = commitguard.StorePreparedFileRoot(ctx, handle.Inner().Storage(), owner.Tree().AclList(), s.signKey.GetPublic(),
+			&treechangeproto.RawTreeChangeWithId{Id: e.ObjectID, RawChange: e.RootRaw}, &treechangeproto.RawTreeChangeWithId{Id: e.ChangeID, RawChange: e.Raw}, object.MigrationFileProof(e))
+		if errors.Is(err, treestorage.ErrTreeExists) {
+			return migrationintent.ErrObsolete
+		}
+		if err != nil {
+			return err
+		}
+		stage = "file-root-committed"
+		return nil
+	})
+	if errors.Is(err, migrationintent.ErrObsolete) || errors.Is(err, commitguard.ErrNativeACLChanged) {
+		return stage, "obsolete", nil
+	}
+	return stage, outcome, err
+}
+
+// Adoption runs while the same live owner/carrier native locks still protect
+// the exact original row. Queue wake-up is asynchronous and appends no row here.
+func (s *Store) AdoptMigrationFile(ctx context.Context, e *migrationintent.File, adopt func() error) error {
+	if e == nil || adopt == nil {
+		return migrationintent.ErrScope
+	}
+	return s.withInlineFileObjects(ctx, e.OwnerObjectID, e.ObjectID, func(owner, carrier *object.Object) error {
+		if carrier == nil {
+			return migrationintent.ErrObsolete
+		}
+		state, err := carrier.MigrationFileLocked(ctx, e, false)
+		if err != nil {
+			return err
+		}
+		if state != "committed" {
+			return migrationintent.ErrObsolete
+		}
+		return adopt()
+	})
+}
diff --git a/internal/spaceobjects/migration_inline_file.go b/internal/spaceobjects/migration_inline_file.go
new file mode 100644
index 0000000..3c8782a
--- /dev/null
+++ b/internal/spaceobjects/migration_inline_file.go
@@ -0,0 +1,255 @@
+package spaceobjects
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"slices"
+	"time"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/internal/payloads"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/util/crypto"
+)
+
+func inlineSameHeads(a, b []string) bool {
+	a, b = slices.Clone(a), slices.Clone(b)
+	slices.Sort(a)
+	slices.Sort(b)
+	return slices.Equal(a, b)
+}
+
+// Load before taking any tree lock, then lock owner/carrier in native stable
+// ID order. An ordinary attach may create a missing carrier concurrently;
+// that race refuses and is reconciled on the next explicit call.
+func (s *Store) withInlineFileObjects(ctx context.Context, ownerID, payloadID string, action func(*object.Object, *object.Object) error) error {
+	if err := s.CheckMigrationWriter(ctx); err != nil {
+		return err
+	}
+	head, err := s.TreeEntry(ctx, ownerID)
+	if err != nil {
+		return err
+	}
+	if !head.Present || head.Deleted || head.Derived {
+		return migrationintent.ErrObsolete
+	}
+	owner, err := s.Get(ctx, ownerID)
+	if err != nil {
+		return err
+	}
+	root, err := parseVerifiedRoot(owner.Tree().Header())
+	if err != nil {
+		return err
+	}
+	if root.IsDerived || root.ChangeType != "object" {
+		return commitguard.ErrNativeCommitGuard
+	}
+	objects := map[string]*object.Object{ownerID: owner}
+	carrierHead, err := s.TreeEntry(ctx, payloadID)
+	if err != nil {
+		return err
+	}
+	if carrierHead.Deleted {
+		return migrationintent.ErrObsolete
+	}
+	var carrier *object.Object
+	if carrierHead.Present {
+		carrier, err = s.Get(ctx, payloadID)
+		if err != nil {
+			return err
+		}
+		objects[payloadID] = carrier
+	}
+	_, unlock, err := s.lockPreparedNativeObjects(ctx, objects, carrier)
+	if err != nil {
+		return err
+	}
+	defer unlock()
+	// Loading or waiting for a native tree lock may overlap a settings-tree
+	// deletion being queued. That head status precedes the tree's own deleted
+	// flag and materialized-row purge, so re-read the actual owner entry here.
+	currentOwner, err := s.TreeEntry(ctx, ownerID)
+	if err != nil {
+		return err
+	}
+	if !currentOwner.Present || currentOwner.Deleted || currentOwner.Derived {
+		return migrationintent.ErrObsolete
+	}
+	if err = commitguard.CheckCurrentWrite(ctx, owner.Tree(), s.signKey.GetPublic()); err != nil {
+		return err
+	}
+	row, err := owner.Controller().GuardLookup(ctx, "objects", ownerID)
+	if err != nil {
+		return err
+	}
+	if row == nil || row.Get(crdt.DeletedAtField) != nil {
+		return migrationintent.ErrObsolete
+	}
+	current, err := s.TreeEntry(ctx, payloadID)
+	if err != nil {
+		return err
+	}
+	if current.Deleted || current.Present != carrierHead.Present {
+		return migrationintent.ErrObsolete
+	}
+	return action(owner, carrier)
+}
+
+func (s *Store) PrepareMigrationInlineFile(ctx context.Context, journal *migrationintent.Store, proposed *migrationintent.InlineFile, spec migrationintent.InlineFileSpec) (*migrationintent.InlineFile, error) {
+	if journal == nil || proposed == nil || spec.Validate() != nil {
+		return nil, migrationintent.ErrScope
+	}
+	root, err := commitguard.InlineFileRoot(s.spaceId, spec.OwnerObjectID)
+	if err != nil {
+		return nil, err
+	}
+	var result *migrationintent.InlineFile
+	err = s.withInlineFileObjects(ctx, spec.OwnerObjectID, root.Id, func(owner, carrier *object.Object) error {
+		heads := []string{root.Id}
+		if carrier != nil {
+			if !bytes.Equal(carrier.Tree().Header().RawChange, root.RawChange) {
+				return migrationintent.ErrCollision
+			}
+			heads = slices.Clone(carrier.Tree().Heads())
+		}
+		acl := owner.Tree().AclList()
+		var raw *treechangeproto.RawTreeChangeWithId
+		entry := *proposed
+		entry.ObjectID, entry.RootRaw, entry.OwnerObjectID = root.Id, bytes.Clone(root.RawChange), spec.OwnerObjectID
+		entry.ContentSHA256, entry.Size, entry.Timestamp = spec.ContentSHA256, int64(len(spec.Content)), time.Now().Unix()
+		// No registration, append, watcher or publish callback is invoked here.
+		err := func() error {
+			acl.RLock()
+			defer acl.RUnlock()
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			if !acl.AclState().Permissions(s.signKey.GetPublic()).CanWrite() {
+				return list.ErrInsufficientPermissions
+			}
+			if acl.Head() == nil {
+				return commitguard.ErrNativeCommitGuard
+			}
+			entry.ReadKeyID, entry.ACLHeadID = acl.AclState().CurrentReadKeyId(), acl.Head().Id
+			readKey, err := acl.AclState().CurrentReadKey()
+			if err != nil {
+				return err
+			}
+			key, err := payloads.DeriveEncKey(readKey)
+			if err != nil {
+				return err
+			}
+			entry.Payload, err = object.BuildMigrationInlinePayload(spec, entry.ReadKeyID, key)
+			if err != nil {
+				return err
+			}
+			_, raw, err = objecttree.NewChangeBuilder(crypto.NewKeyStorage(), root).Build(objecttree.BuilderContent{
+				TreeHeadIds: heads, AclHeadId: entry.ACLHeadID, SnapshotBaseId: root.Id,
+				Unencrypted: true, PrivKey: s.signKey, Content: entry.Payload, Timestamp: entry.Timestamp, DataType: payloads.Dataset,
+			})
+			return err
+		}()
+		if err != nil {
+			return err
+		}
+		entry.ChangeID, entry.Raw = raw.Id, bytes.Clone(raw.RawChange)
+		ch, err := object.NewCodec().Decode(entry.Payload)
+		if err != nil {
+			return err
+		}
+		ch.ChangeId = entry.ChangeID
+		entry.RecordIDs, err = crdt.ResolveRecordIds(ch)
+		if err != nil {
+			return err
+		}
+		entry.Dependencies = map[string][]string{spec.OwnerObjectID: slices.Clone(owner.Tree().Heads()), root.Id: heads}
+		if _, err = object.CheckMigrationInlineFile(ctx, acl, s.signKey.GetPublic(), &entry, true); err != nil {
+			return err
+		}
+		if carrier != nil {
+			row, err := carrier.Controller().GuardLookup(ctx, payloads.Dataset, entry.RecordIDs[0])
+			if err != nil {
+				return err
+			}
+			if row != nil {
+				return migrationintent.ErrCollision
+			}
+		}
+		result, err = journal.ReserveInlineFile(ctx, &entry)
+		return err
+	})
+	return result, err
+}
+
+// MigrationInlineFileState advances at most one native durable stage. Native
+// CID/history and materialized row determine recovery; a host receipt does not.
+func (s *Store) MigrationInlineFileState(ctx context.Context, e *migrationintent.InlineFile, commit bool) (stage, outcome string, err error) {
+	if e == nil {
+		return "", "", migrationintent.ErrCorrupt
+	}
+	stage, outcome = "file-prepared", "prepared"
+	err = s.withInlineFileObjects(ctx, e.OwnerObjectID, e.ObjectID, func(owner, carrier *object.Object) error {
+		if carrier != nil {
+			stage = "file-root-committed"
+			var err error
+			outcome, err = carrier.MigrationInlineFileLocked(ctx, e, false)
+			if err != nil {
+				return err
+			}
+			if outcome != "prepared" {
+				if outcome == "committed" || outcome == "committed_deleted" || outcome == "committed_modified" {
+					stage = "complete"
+				}
+				return nil
+			}
+		} else {
+			if _, err := object.CheckMigrationInlineFile(ctx, owner.Tree().AclList(), s.signKey.GetPublic(), e, true); err != nil {
+				return err
+			}
+		}
+		if !inlineSameHeads(owner.Tree().Heads(), e.Dependencies[e.OwnerObjectID]) {
+			return migrationintent.ErrObsolete
+		}
+		if !commit {
+			return nil
+		}
+		if carrier != nil {
+			outcome, err = carrier.MigrationInlineFileLocked(ctx, e, true)
+			if err == nil && outcome != "obsolete" {
+				stage = "complete"
+			}
+			return err
+		}
+		if !inlineSameHeads(e.Dependencies[e.ObjectID], []string{e.ObjectID}) {
+			return migrationintent.ErrObsolete
+		}
+		if _, err := s.CheckDeriveParent(ctx, e.ObjectID, e.OwnerObjectID); err != nil {
+			return err
+		}
+		handle, err := s.app.GetSpace(ctx, s.spaceId)
+		if err != nil {
+			return err
+		}
+		err = commitguard.StorePreparedInlineRoot(ctx, handle.Inner().Storage(), owner.Tree().AclList(), s.signKey.GetPublic(),
+			&treechangeproto.RawTreeChangeWithId{Id: e.ObjectID, RawChange: e.RootRaw}, &treechangeproto.RawTreeChangeWithId{Id: e.ChangeID, RawChange: e.Raw}, object.MigrationInlineProof(e))
+		if errors.Is(err, treestorage.ErrTreeExists) {
+			return migrationintent.ErrObsolete
+		}
+		if err != nil {
+			return err
+		}
+		stage = "file-root-committed"
+		return nil
+	})
+	if errors.Is(err, migrationintent.ErrObsolete) || errors.Is(err, commitguard.ErrNativeACLChanged) {
+		return stage, "obsolete", nil
+	}
+	return stage, outcome, err
+}
diff --git a/internal/spaceobjects/migration_prepared.go b/internal/spaceobjects/migration_prepared.go
new file mode 100644
index 0000000..cda1e27
--- /dev/null
+++ b/internal/spaceobjects/migration_prepared.go
@@ -0,0 +1,218 @@
+package spaceobjects
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"errors"
+	"slices"
+	"time"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+)
+
+func (s *Store) LockMigration() func() { s.migrationMu.Lock(); return s.migrationMu.Unlock }
+
+// Root creation has no carrier yet. Lock its declared Type/collection owners
+// in the same native order used by object writes, retaining their heads across
+// both root reservation and the actual root storage transaction.
+func (s *Store) WithMigrationDefinitions(ctx context.Context, typeID string, collections, owners []string, expected map[string][]string, action func(map[string][]string) error) error {
+	if typeID == "" || len(owners) > 2048 {
+		return crdt.ErrValidation
+	}
+	objects := map[string]*object.Object{}
+	for _, id := range owners {
+		if id == "" {
+			return crdt.ErrValidation
+		}
+		if s.staticOwnerKind(id) != "" || objects[id] != nil {
+			continue
+		}
+		obj, err := s.Get(ctx, id)
+		if err != nil {
+			return err
+		}
+		objects[id] = obj
+	}
+	view, unlock, err := s.lockPreparedNativeObjects(ctx, objects, nil)
+	if err != nil {
+		return err
+	}
+	defer unlock()
+	native := view.(lockedReadView)
+	kind, err := native.definitionKind(typeID)
+	if err != nil {
+		return err
+	}
+	if kind != "type" {
+		return crdt.ErrValidation
+	}
+	for _, id := range collections {
+		kind, err := native.definitionKind(id)
+		if err != nil {
+			return err
+		}
+		if kind != "collection" {
+			return crdt.ErrValidation
+		}
+	}
+	for _, id := range owners {
+		if _, err := native.definitionKind(id); err != nil {
+			return err
+		}
+	}
+	heads := native.PreparedHeads()
+	if expected != nil {
+		if len(expected) != len(heads) {
+			return migrationintent.ErrObsolete
+		}
+		for id, old := range expected {
+			current, ok := heads[id]
+			left, right := slices.Clone(old), slices.Clone(current)
+			slices.Sort(left)
+			slices.Sort(right)
+			if !ok || !slices.Equal(left, right) {
+				return migrationintent.ErrObsolete
+			}
+		}
+	}
+	return action(heads)
+}
+
+func (s *Store) MigrationJournal(ctx context.Context) (*migrationintent.Store, error) {
+	if err := s.CheckMigrationWriter(ctx); err != nil {
+		return nil, err
+	}
+	return migrationintent.Open(ctx, s.db, s.signKey.GetPublic().Account(), s.spaceId)
+}
+
+func (s *Store) CheckMigrationWriter(ctx context.Context) error {
+	if s.signKey == nil {
+		return commitguard.ErrNativeCommitGuard
+	}
+	if err := s.CheckWrite(); err != nil {
+		return err
+	}
+	handle, err := s.app.GetSpace(ctx, s.spaceId)
+	if err != nil {
+		return err
+	}
+	acl := handle.Inner().Acl()
+	acl.RLock()
+	defer acl.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !acl.AclState().Permissions(s.signKey.GetPublic()).CanWrite() {
+		return list.ErrInsufficientPermissions
+	}
+	return nil
+}
+
+func (s *Store) PrepareMigrationRoot(ctx context.Context, journal *migrationintent.Store, entry *migrationintent.Prepared) (*migrationintent.Prepared, error) {
+	if err := s.CheckMigrationWriter(ctx); err != nil {
+		return nil, err
+	}
+	if journal == nil || entry == nil || entry.Kind != "object" || entry.Stage != "root" {
+		return nil, migrationintent.ErrScope
+	}
+	if old, err := journal.Load(ctx, entry.Binding.IntentID, "root"); err == nil {
+		if old.Binding != entry.Binding || old.Fingerprint != entry.Fingerprint {
+			return nil, migrationintent.ErrCollision
+		}
+		return old, nil
+	} else if !errors.Is(err, migrationintent.ErrNotFound) {
+		return nil, err
+	}
+	handle, err := s.app.GetSpace(ctx, s.spaceId)
+	if err != nil {
+		return nil, err
+	}
+	seed := make([]byte, 32)
+	if _, err := rand.Read(seed); err != nil {
+		return nil, err
+	}
+	payload, err := handle.Inner().TreeBuilder().CreateTree(ctx, objecttree.ObjectTreeCreatePayload{PrivKey: s.signKey, ChangeType: "object", SpaceId: s.spaceId, IsEncrypted: true, Seed: seed, Timestamp: time.Now().Unix()})
+	if err != nil {
+		return nil, err
+	}
+	copy := *entry
+	copy.ObjectID, copy.ChangeID, copy.Raw = payload.RootRawChange.Id, payload.RootRawChange.Id, bytes.Clone(payload.RootRawChange.RawChange)
+	// No tree registration or append has happened. Reserve includes a required
+	// native database checkpoint and must succeed before CommitMigrationRoot.
+	return journal.Reserve(ctx, &copy)
+}
+
+// MigrationRootState looks up the known immutable ID, never a name or a host
+// acknowledgement. A purged/deleted tree always halts; it is not re-created.
+func (s *Store) MigrationRootState(ctx context.Context, entry *migrationintent.Prepared) (string, error) {
+	if err := s.CheckMigrationWriter(ctx); err != nil {
+		return "", err
+	}
+	head, err := s.TreeEntry(ctx, entry.ObjectID)
+	if err != nil {
+		return "", err
+	}
+	if head.Deleted {
+		return "deleted", nil
+	}
+	handle, err := s.app.GetSpace(ctx, s.spaceId)
+	if err != nil {
+		return "", err
+	}
+	if !head.Present {
+		err := commitguard.CheckPreparedRoot(ctx, handle.Inner().Storage(), handle.Inner().Acl(), s.signKey.GetPublic(), &treechangeproto.RawTreeChangeWithId{Id: entry.ChangeID, RawChange: entry.Raw})
+		if errors.Is(err, commitguard.ErrNativeACLChanged) {
+			return "obsolete", nil
+		}
+		if err != nil {
+			return "", err
+		}
+		return "prepared", nil
+	}
+	storage, err := handle.Inner().Storage().TreeStorage(ctx, entry.ObjectID)
+	if err != nil {
+		return "", err
+	}
+	root, err := storage.Root(ctx)
+	if err != nil {
+		return "", err
+	}
+	if root.Id != entry.ObjectID || !bytes.Equal(root.RawChange, entry.Raw) {
+		return "", migrationintent.ErrCollision
+	}
+	return "committed", nil
+}
+
+func (s *Store) CommitMigrationRoot(ctx context.Context, entry *migrationintent.Prepared) error {
+	state, err := s.MigrationRootState(ctx, entry)
+	if err != nil {
+		return err
+	}
+	if state == "deleted" || state == "obsolete" {
+		return migrationintent.ErrObsolete
+	}
+	if state == "committed" {
+		return nil
+	}
+	handle, err := s.app.GetSpace(ctx, s.spaceId)
+	if err != nil {
+		return err
+	}
+	raw := &treechangeproto.RawTreeChangeWithId{Id: entry.ChangeID, RawChange: bytes.Clone(entry.Raw)}
+	_, _, err = commitguard.StoreCurrentRoot(ctx, handle.Inner().Storage(), handle.Inner().Acl(), s.signKey.GetPublic(), treestorage.TreeStorageCreatePayload{RootRawChange: raw, Changes: []*treechangeproto.RawTreeChangeWithId{raw}, Heads: []string{raw.Id}})
+	if errors.Is(err, treestorage.ErrTreeExists) {
+		state, readErr := s.MigrationRootState(ctx, entry)
+		if readErr == nil && state == "committed" {
+			return nil
+		}
+	}
+	return err
+}
