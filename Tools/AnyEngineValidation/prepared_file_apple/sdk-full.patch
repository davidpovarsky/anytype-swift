+// Empty patches are a narrowly opted-in validated conditional operation.
+// Neither stock Set nor the unvalidated conditional API may adopt that lane.
+func TestNativeConditionalPropertyNoopRequiresValidatedAPI(t *testing.T) {
+	p := &propertiesAPI{}
+	_, err := p.Set(context.Background(), "existing-object", "any", map[string]any{})
+	require.Error(t, err)
+	_, err = p.SetConditional(context.Background(), "existing-object", "any", map[string]any{}, 1)
+	require.ErrorIs(t, err, crdt.ErrValidation)
+}
