+	if _, err := second.Load(context.Background(), entry.Binding.IntentID, "root"); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("cross-Space metadata leaked: %v", err)
+	}
+	if err := second.Check(entry.Binding); !errors.Is(err, ErrScope) {
+		t.Fatal("old Space binding was adopted")
+	}
+}
+
+type failingCheckpointDB struct {
+	anystore.DB
+	calls int
+}
+
+func (db *failingCheckpointDB) Flush(context.Context, time.Duration, anystore.FlushMode) error {
+	db.calls++
+	return errors.New("injected checkpoint failure")
+}
+
+func TestPreparedIntentRefusesWithoutDurabilityBarrier(t *testing.T) {
+	db, err := anystore.Open(context.Background(), filepath.Join(t.TempDir(), "unsafe.db"), &anystore.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	failed := &failingCheckpointDB{DB: db}
+	s, err := Open(context.Background(), failed, "native-account", "native-space")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = s.Reserve(context.Background(), entryFor(t, s, "not authorized for append")); err == nil {
+		t.Fatal("reservation succeeded without required durability barrier")
+	}
+	if err = s.EnsureDurable(context.Background()); err == nil || failed.calls != 2 {
+		t.Fatal("commit admission omitted its independent barrier")
+	}
+}
