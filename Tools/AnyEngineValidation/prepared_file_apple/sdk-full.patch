+package commitguard
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/stretchr/testify/require"
+)
+
+func prepareNativeBytes(t *testing.T, f *fixture) *treechangeproto.RawTreeChangeWithId {
+	t.Helper()
+	raw, err := f.tree.PrepareChange(objecttree.SignableChangeContent{Key: f.keys.SignKey, Data: []byte("prepared exact encrypted bytes"), ShouldBeEncrypted: true, DataType: "prepared-test"})
+	require.NoError(t, err)
+	has, err := f.tree.Storage().Has(context.Background(), raw.Id)
+	require.NoError(t, err)
+	require.False(t, has)
+	return raw
+}
+
+func TestPreparedRawNativeDurableStoragePrecedesUpdater(t *testing.T) {
+	f := newFixture(t)
+	f.tree.SetDeferredUpdater(true)
+	raw := prepareNativeBytes(t, f)
+	ctx, guard, err := PreparedContext(context.Background(), f.tree, f.keys.SignKey.GetPublic(), raw)
+	require.NoError(t, err)
+	callbacks := 0
+	res, err := f.tree.AddRawChangesWithUpdater(ctx, objecttree.RawChangesPayload{NewHeads: []string{raw.Id}, RawChanges: []*treechangeproto.RawTreeChangeWithId{raw}}, func(tree objecttree.ObjectTree, _ objecttree.Mode) error {
+		callbacks++
+		stored, err := tree.Storage().Get(context.Background(), raw.Id)
+		require.NoError(t, err)
+		require.True(t, bytes.Equal(stored.RawChange, raw.RawChange))
+		require.NotNil(t, guard.committed, "updater must run after actual native transaction returns")
+		return nil
+	})
+	require.NoError(t, err)
+	require.Len(t, res.Added, 1)
+	require.Equal(t, 1, callbacks)
+	require.Equal(t, raw.Id, guard.committed.Id)
+}
+
+func TestPreparedRawRefusesMissingDeferredUpdaterAndModeConfusion(t *testing.T) {
+	for _, mode := range []string{"missing deferred", "ordinary token", "prepared AddContent", "changed bytes"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newFixture(t)
+			raw := prepareNativeBytes(t, f)
+			if mode != "missing deferred" {
+				f.tree.SetDeferredUpdater(true)
+			}
+			ctx, _, err := PreparedContext(context.Background(), f.tree, f.keys.SignKey.GetPublic(), raw)
+			require.NoError(t, err)
+			if mode == "ordinary token" {
+				ctx, _, err = Context(context.Background(), f.tree, f.keys.SignKey.GetPublic())
+				require.NoError(t, err)
+			}
+			if mode == "prepared AddContent" {
+				_, err = f.tree.AddContent(ctx, objecttree.SignableChangeContent{Key: f.keys.SignKey, Data: []byte("replacement"), ShouldBeEncrypted: true})
+			} else {
+				payload := &treechangeproto.RawTreeChangeWithId{Id: raw.Id, RawChange: bytes.Clone(raw.RawChange)}
+				if mode == "changed bytes" {
+					payload.RawChange[0] ^= 1
+				}
+				_, err = f.tree.AddRawChanges(ctx, objecttree.RawChangesPayload{NewHeads: []string{raw.Id}, RawChanges: []*treechangeproto.RawTreeChangeWithId{payload}})
+			}
+			require.ErrorIs(t, err, ErrNativeCommitGuard)
+			has, readErr := f.tree.Storage().Has(context.Background(), raw.Id)
+			require.NoError(t, readErr)
+			require.False(t, has)
+		})
+	}
+}
+
+func TestPreparedRawCurrentACLRecheckedAtNativeAppend(t *testing.T) {
+	f := newFixture(t)
+	f.tree.SetDeferredUpdater(true)
+	raw := prepareNativeBytes(t, f)
+	ctx, guard, err := PreparedContext(context.Background(), f.tree, f.keys.SignKey.GetPublic(), raw)
+	require.NoError(t, err)
+	_ = f.addWriter(t) // author remains owner; only the signed ACL envelope is obsolete.
+	before := append([]string(nil), f.tree.Heads()...)
+	_, err = f.tree.AddRawChanges(ctx, objecttree.RawChangesPayload{NewHeads: []string{raw.Id}, RawChanges: []*treechangeproto.RawTreeChangeWithId{raw}})
+	require.ErrorIs(t, err, ErrNativeACLChanged)
+	require.Nil(t, guard.committed)
+	require.Equal(t, before, f.tree.Heads())
+	has, readErr := f.tree.Storage().Has(context.Background(), raw.Id)
+	require.NoError(t, readErr)
+	require.False(t, has)
+}
+
+func TestPreparedRawRevokedWriterCannotAppendOrRecoverAsAuthorized(t *testing.T) {
+	for _, committed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "before append", true: "after committed ACK loss"}[committed], func(t *testing.T) {
+			f := newFixture(t)
+			f.tree.SetDeferredUpdater(true)
+			writer := f.addWriter(t)
+			raw, err := f.tree.PrepareChange(objecttree.SignableChangeContent{Key: writer, Data: []byte("prepared writer operation"), ShouldBeEncrypted: true, DataType: "prepared-test"})
+			require.NoError(t, err)
+			ctx, _, err := PreparedContext(context.Background(), f.tree, writer.GetPublic(), raw)
+			require.NoError(t, err)
+			payload := objecttree.RawChangesPayload{NewHeads: []string{raw.Id}, RawChanges: []*treechangeproto.RawTreeChangeWithId{raw}}
+			if committed {
+				_, err = f.tree.AddRawChanges(ctx, payload)
+				require.NoError(t, err)
+			}
+			f.remove(t, writer)
+			heads := append([]string(nil), f.tree.Heads()...)
+			if !committed {
+				_, err = f.tree.AddRawChanges(ctx, payload)
+				require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+			}
+			// This is also the mandatory current-writer fence used by exact
+			// native-history reconciliation before a no-op success is returned.
+			require.ErrorIs(t, CheckCurrentWrite(context.Background(), f.tree, writer.GetPublic()), list.ErrInsufficientPermissions)
+			_, _, err = PreparedContext(context.Background(), f.tree, writer.GetPublic(), raw)
+			require.ErrorIs(t, err, list.ErrInsufficientPermissions)
+			require.Equal(t, heads, f.tree.Heads())
+			has, err := f.tree.Storage().Has(context.Background(), raw.Id)
+			require.NoError(t, err)
+			require.Equal(t, committed, has)
+		})
+	}
+}
+
+type lostPreparedAckStorage struct{ objecttree.Storage }
+
+func (s lostPreparedAckStorage) AddAll(ctx context.Context, changes []objecttree.StorageChange, heads []string, snapshot string) error {
+	if err := s.Storage.AddAll(ctx, changes, heads, snapshot); err != nil {
+		return err
+	}
+	return errors.New("injected lost ACK after actual native commit")
+}
+
+func TestPreparedRawLostAckRecoversExactNativeHistory(t *testing.T) {
+	f := newFixture(t)
+	wrapped := f.tree.(*nativeCommitTree).storage
+	wrapped.Storage = lostPreparedAckStorage{wrapped.Storage}
+	f.tree.SetDeferredUpdater(true)
+	raw := prepareNativeBytes(t, f)
+	ctx, _, err := PreparedContext(context.Background(), f.tree, f.keys.SignKey.GetPublic(), raw)
+	require.NoError(t, err)
+	_, err = f.tree.AddRawChanges(ctx, objecttree.RawChangesPayload{NewHeads: []string{raw.Id}, RawChanges: []*treechangeproto.RawTreeChangeWithId{raw}})
+	require.ErrorContains(t, err, "lost ACK")
+	stored, err := wrapped.Storage.Get(context.Background(), raw.Id)
+	require.NoError(t, err)
+	require.True(t, bytes.Equal(stored.RawChange, raw.RawChange))
+	require.NotZero(t, stored.AddSeq)
+	require.Equal(t, []string{raw.Id}, f.tree.Heads(), "rollback rebuild must recover the actually committed DAG")
+}
