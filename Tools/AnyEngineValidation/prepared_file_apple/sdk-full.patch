@@ -0,0 +1,159 @@
+package upload
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-sync-sdk/internal/files/store"
+	"github.com/ipfs/go-cid"
+	"github.com/stretchr/testify/require"
+)
+
+func preparedDigest(content []byte) string {
+	h := sha256.Sum256(content)
+	return hex.EncodeToString(h[:])
+}
+
+func TestMigrationPreparedFileStagesActualCARWithoutPublishingAndPinsBytes(t *testing.T) {
+	ctx := context.Background()
+	broker := &fakeBroker{}
+	s, st := newService(t, broker)
+	s.memSpool = 64 // Force the streaming spill path with a real multi-block CAR.
+	content := testContent(2 << 20)
+	prepared, err := s.StageMigrationFile(ctx, spaceId, strings.Repeat("1", 64), strings.Repeat("2", 64), int64(len(content)), preparedDigest(content), bytes.NewReader(content))
+	require.NoError(t, err)
+	require.NoError(t, s.VerifyMigrationFile(ctx, spaceId, prepared))
+	root, err := cid.Decode(prepared.RootCID)
+	require.NoError(t, err)
+	info, err := st.Info(ctx, spaceId, root)
+	require.NoError(t, err)
+	require.Greater(t, info.Sections, 1)
+	require.Empty(t, info.Refs, "no native file identity has been published")
+	_, dedup, err := st.LookupContent(ctx, spaceId, sha256Bytes(content))
+	require.NoError(t, err)
+	require.False(t, dedup)
+	require.Zero(t, broker.uploads)
+	require.Zero(t, broker.signs)
+	require.ErrorIs(t, st.Offload(ctx, spaceId, root), store.ErrPreparedPayloadPinned)
+	require.ErrorIs(t, st.Delete(ctx, spaceId, root), store.ErrPreparedPayloadPinned)
+	require.ErrorIs(t, st.ReleasePreparedPayload(ctx, spaceId, root, strings.Repeat("3", 64), prepared.Fingerprint), store.ErrPreparedPayloadPinned)
+	require.NoError(t, s.VerifyMigrationFile(ctx, spaceId, prepared))
+	changed := prepared
+	changed.Key = bytes.Clone(prepared.Key)
+	changed.Key[0] ^= 1
+	require.Error(t, s.VerifyMigrationFile(ctx, spaceId, changed))
+	require.Error(t, s.VerifyMigrationFile(ctx, "other-space", prepared))
+}
+
+func sha256Bytes(b []byte) []byte { h := sha256.Sum256(b); return h[:] }
+
+type readCounter struct {
+	reader io.Reader
+	bytes  int
+	calls  int
+}
+
+func (r *readCounter) Read(b []byte) (int, error) {
+	r.calls++
+	n, err := r.reader.Read(b)
+	r.bytes += n
+	return n, err
+}
+
+func TestMigrationPreparedFileRejectsBoundsHashAndCancellationBeforePublication(t *testing.T) {
+	ctx := context.Background()
+	s, st := newService(t, &fakeBroker{})
+	content := testContent(4096)
+	for _, size := range []int64{-1, 4095, PreparedFileMaximumBytes + 1} {
+		reader := &readCounter{reader: bytes.NewReader(content)}
+		_, err := s.StageMigrationFile(ctx, spaceId, strings.Repeat("1", 64), strings.Repeat("2", 64), size, preparedDigest(content), reader)
+		require.ErrorIs(t, err, ErrPreparedFileContent)
+		require.Zero(t, reader.calls)
+	}
+	for _, bad := range [][]byte{content[:4095], append(bytes.Clone(content), 7), testContent(4097)[:4096]} {
+		_, err := s.StageMigrationFile(ctx, spaceId, strings.Repeat("1", 64), strings.Repeat("2", 64), 4096, preparedDigest(content), bytes.NewReader(bad))
+		require.ErrorIs(t, err, ErrPreparedFileContent)
+	}
+	canceled, cancel := context.WithCancel(ctx)
+	cancel()
+	reader := &readCounter{reader: bytes.NewReader(content)}
+	_, err := s.StageMigrationFile(canceled, spaceId, strings.Repeat("1", 64), strings.Repeat("2", 64), 4096, preparedDigest(content), reader)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Zero(t, reader.calls)
+	info, err := st.ListSpace(ctx, spaceId)
+	require.NoError(t, err)
+	require.Empty(t, info)
+}
+
+func TestMigrationPreparedFileSurvivesActualStoreCloseAndReopen(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	dbPath, filesPath := filepath.Join(dir, "metadata.db"), filepath.Join(dir, "files")
+	db, err := anystore.Open(ctx, dbPath, nil)
+	require.NoError(t, err)
+	st, err := store.New(ctx, filesPath, db)
+	require.NoError(t, err)
+	s := New(st, nil)
+	content := testContent(4096)
+	prepared, err := s.StageMigrationFile(ctx, spaceId, strings.Repeat("a", 64), strings.Repeat("b", 64), 4096, preparedDigest(content), bytes.NewReader(content))
+	require.NoError(t, err)
+	require.NoError(t, db.Close())
+	db2, err := anystore.Open(ctx, dbPath, nil)
+	require.NoError(t, err)
+	defer db2.Close()
+	st2, err := store.New(ctx, filesPath, db2)
+	require.NoError(t, err)
+	s2 := New(st2, nil)
+	require.NoError(t, s2.VerifyMigrationFile(ctx, spaceId, prepared))
+	root, _ := cid.Decode(prepared.RootCID)
+	require.ErrorIs(t, st2.Delete(ctx, spaceId, root), store.ErrPreparedPayloadPinned)
+	require.NoError(t, st2.ReleasePreparedPayload(ctx, spaceId, root, prepared.IntentID, prepared.Fingerprint))
+	require.NoError(t, st2.Delete(ctx, spaceId, root))
+	require.Error(t, s2.VerifyMigrationFile(ctx, spaceId, prepared))
+}
+
+type preparedQueue struct {
+	fail  bool
+	calls int
+}
+
+func (q *preparedQueue) Enqueue(context.Context, string, string, string) error {
+	q.calls++
+	if q.fail {
+		return errors.New("queue unavailable")
+	}
+	return nil
+}
+
+func TestMigrationPreparedFileKeepsPinThroughFailedAdoptionAndRetriesSameRoot(t *testing.T) {
+	ctx := context.Background()
+	s, st := newService(t, &fakeBroker{})
+	content := testContent(16384)
+	prepared, err := s.StageMigrationFile(ctx, spaceId, strings.Repeat("a", 64), strings.Repeat("b", 64), int64(len(content)), preparedDigest(content), bytes.NewReader(content))
+	require.NoError(t, err)
+	queue := &preparedQueue{fail: true}
+	s.SetQueue(queue)
+	root, _ := cid.Decode(prepared.RootCID)
+	require.Error(t, s.AdoptMigrationFile(ctx, spaceId, "owner", "reserved-file-id", prepared))
+	require.ErrorIs(t, st.Offload(ctx, spaceId, root), store.ErrPreparedPayloadPinned)
+	queue.fail = false
+	require.NoError(t, s.AdoptMigrationFile(ctx, spaceId, "owner", "reserved-file-id", prepared))
+	require.NoError(t, s.AdoptMigrationFile(ctx, spaceId, "owner", "reserved-file-id", prepared))
+	info, err := st.Info(ctx, spaceId, root)
+	require.NoError(t, err)
+	require.Equal(t, []string{"reserved-file-id"}, info.Refs)
+	infos, err := st.ListSpace(ctx, spaceId)
+	require.NoError(t, err)
+	require.Len(t, infos, 1)
+	pinned, err := st.PreparedPayloadPinned(ctx, spaceId, root)
+	require.NoError(t, err)
+	require.False(t, pinned)
+}
diff --git a/internal/migrationintent/file.go b/internal/migrationintent/file.go
new file mode 100644
index 0000000..a3c57b5
--- /dev/null
+++ b/internal/migrationintent/file.go
@@ -0,0 +1,248 @@
+package migrationintent
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"unicode/utf8"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-sync-sdk/internal/payloads"
+)
+
+// The random file key is reserved before the first body read. A crash during
+// staging therefore reuses the same key, verified plaintext and content root,
+// rather than orphaning a succession of unrelated encrypted copies.
+type FileDraft struct {
+	Prepared
+	Key []byte `json:"key"`
+}
+
+func (s *Store) validateFileDraft(d *FileDraft) error {
+	if d == nil || d.Kind != FileKind || d.Stage != "file-draft" || len(d.Key) != 32 {
+		return ErrCorrupt
+	}
+	fp, err := s.FileFingerprint(d.Binding, d.Spec, d.SourceSpec)
+	if err != nil || fp != d.Fingerprint || d.SpecSHA256 != Digest(d.SourceSpec) {
+		return ErrCorrupt
+	}
+	return nil
+}
+
+func (s *Store) LoadFileDraft(ctx context.Context, intentID string) (*FileDraft, error) {
+	if !validHex(intentID) {
+		return nil, ErrScope
+	}
+	var d FileDraft
+	if err := s.read(ctx, "intent/"+intentID+"/file-draft", &d); err != nil {
+		return nil, err
+	}
+	if d.Binding.IntentID != intentID {
+		return nil, ErrCorrupt
+	}
+	if err := s.validateFileDraft(&d); err != nil {
+		return nil, err
+	}
+	if err := s.checkBindings(ctx, &d.Prepared); err != nil {
+		return nil, err
+	}
+	return &d, nil
+}
+
+func (s *Store) ReserveFileDraft(ctx context.Context, input Prepared) (*FileDraft, error) {
+	input.Kind, input.Stage = FileKind, "file-draft"
+	d := &FileDraft{Prepared: input, Key: make([]byte, 32)}
+	if _, err := rand.Read(d.Key); err != nil {
+		return nil, err
+	}
+	if err := s.validateFileDraft(d); err != nil {
+		return nil, err
+	}
+	tx, err := s.db.WriteTx(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	tc := tx.Context()
+	if err = s.bindPlan(tc, d.Binding); err != nil {
+		return nil, err
+	}
+	if err = s.bindIntent(tc, &d.Prepared); err != nil {
+		return nil, err
+	}
+	if err = s.insert(tc, "intent/"+d.Binding.IntentID+"/file-draft", d); err != nil && !errors.Is(err, anystore.ErrDocExists) {
+		return nil, err
+	}
+	stored, err := s.LoadFileDraft(tc, d.Binding.IntentID)
+	if err != nil {
+		return nil, err
+	}
+	if stored.Binding != d.Binding || stored.Fingerprint != d.Fingerprint {
+		return nil, ErrCollision
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	if err = s.EnsureDurable(ctx); err != nil {
+		return nil, err
+	}
+	return stored, nil
+}
+
+const FileKind = "file"
+const fileStage = "file"
+
+// FileSpec describes one ordinary full-tier original. The separately streamed
+// body must match this size and digest before any native file row is reserved.
+type FileSpec struct {
+	OwnerObjectID string `json:"ownerObjectId"`
+	Name          string `json:"name"`
+	Mime          string `json:"mime"`
+	Size          int64  `json:"size"`
+	ContentSHA256 string `json:"contentSHA256"`
+}
+
+func (s FileSpec) Validate() error {
+	if s.OwnerObjectID == "" || len(s.OwnerObjectID) > 256 ||
+		!utf8.ValidString(s.Name) || !utf8.ValidString(s.Mime) ||
+		len(s.Name) > 1024 || len(s.Mime) > 255 || strings.ContainsRune(s.Name, 0) || strings.ContainsRune(s.Mime, 0) ||
+		s.Size < payloads.InlineMaxSize || s.Size > FileMaximumBytes || !validHex(s.ContentSHA256) {
+		return ErrScope
+	}
+	return nil
+}
+
+// File reserves the exact deterministic native derived root AND its
+// first signed file row atomically. Neither root registration nor row append
+// is allowed before this immutable entry and its checkpoint succeed.
+type File struct {
+	Prepared
+	RootRaw       []byte      `json:"rootRaw"`
+	OwnerObjectID string      `json:"ownerObjectId"`
+	ReadKeyID     string      `json:"readKeyId"`
+	ACLHeadID     string      `json:"aclHeadId"`
+	ContentSHA256 string      `json:"contentSHA256"`
+	Size          int64       `json:"size"`
+	Staged        FilePayload `json:"staged"`
+}
+
+func (s *Store) FileFingerprint(binding Binding, spec, sourceSpec []byte) (string, error) {
+	if err := s.Check(binding); err != nil {
+		return "", err
+	}
+	var input FileSpec
+	if len(spec) == 0 || len(spec) > 32<<10 || json.Unmarshal(spec, &input) != nil || input.Validate() != nil ||
+		len(sourceSpec) == 0 || len(sourceSpec) > 1<<20 || !json.Valid(sourceSpec) || ValidateNumbers(sourceSpec) != nil {
+		return "", ErrCorrupt
+	}
+	h := sha256.New()
+	for _, v := range []string{Contract, binding.AccountID, binding.SpaceID, binding.StoreID, binding.PlanID, binding.PlanSHA256, binding.IntentID, binding.SourceKey, FileKind, Digest(spec), Digest(sourceSpec)} {
+		var n [8]byte
+		binary.BigEndian.PutUint64(n[:], uint64(len(v)))
+		h.Write(n[:])
+		h.Write([]byte(v))
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func fileKey(intentID string) (string, error) {
+	if !validHex(intentID) {
+		return "", ErrScope
+	}
+	// Distinct from root/bootstrap/block; the shared intent identity still
+	// rejects reuse of this same intent ID by any other kind in either order.
+	return "intent/" + intentID + "/" + fileStage, nil
+}
+
+func (s *Store) validateFile(e *File) error {
+	if e == nil || s.Check(e.Binding) != nil || e.Kind != FileKind || e.Stage != fileStage ||
+		len(e.RootRaw) == 0 || len(e.RootRaw) > 16<<10 || len(e.Raw) == 0 || len(e.Raw) > 32<<10 ||
+		len(e.Payload) == 0 || len(e.Payload) > 24<<10 || e.ObjectID == "" || e.ChangeID == "" ||
+		e.OwnerObjectID == "" || e.ReadKeyID == "" || e.ACLHeadID == "" || e.Timestamp <= 0 ||
+		len(e.RecordIDs) != 1 || e.RecordIDs[0] == "" || len(e.Dependencies) != 2 ||
+		len(e.Dependencies[e.OwnerObjectID]) == 0 || len(e.Dependencies[e.ObjectID]) == 0 {
+		return ErrCorrupt
+	}
+	var spec FileSpec
+	if json.Unmarshal(e.Spec, &spec) != nil || spec.Validate() != nil || spec.OwnerObjectID != e.OwnerObjectID ||
+		spec.ContentSHA256 != e.ContentSHA256 || spec.Size != e.Size || e.Staged.Validate() != nil || e.Staged.Size != e.Size || e.Staged.SHA256 != e.ContentSHA256 || e.Staged.IntentID != e.Binding.IntentID || e.Staged.Fingerprint != e.Fingerprint {
+		return ErrCorrupt
+	}
+	fp, err := s.FileFingerprint(e.Binding, e.Spec, e.SourceSpec)
+	if err != nil || fp != e.Fingerprint || e.SpecSHA256 != Digest(e.SourceSpec) {
+		return ErrCorrupt
+	}
+	return nil
+}
+
+func (s *Store) LoadFile(ctx context.Context, intentID string) (*File, error) {
+	key, err := fileKey(intentID)
+	if err != nil {
+		return nil, err
+	}
+	var e File
+	if err = s.read(ctx, key, &e); err != nil {
+		return nil, err
+	}
+	if e.Binding.IntentID != intentID {
+		return nil, ErrCorrupt
+	}
+	if err = s.validateFile(&e); err != nil {
+		return nil, err
+	}
+	if err = s.checkBindings(ctx, &e.Prepared); err != nil {
+		return nil, err
+	}
+	return &e, nil
+}
+
+func (s *Store) ReserveFile(ctx context.Context, proposed *File) (*File, error) {
+	if err := s.validateFile(proposed); err != nil {
+		return nil, err
+	}
+	draft, err := s.LoadFileDraft(ctx, proposed.Binding.IntentID)
+	if err != nil {
+		return nil, err
+	}
+	if draft.Binding != proposed.Binding || draft.Fingerprint != proposed.Fingerprint || !bytes.Equal(draft.Key, proposed.Staged.Key) {
+		return nil, ErrCollision
+	}
+	tx, err := s.db.WriteTx(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	txCtx := tx.Context()
+	if err = s.bindPlan(txCtx, proposed.Binding); err != nil {
+		return nil, err
+	}
+	if err = s.bindIntent(txCtx, &proposed.Prepared); err != nil {
+		return nil, err
+	}
+	key, _ := fileKey(proposed.Binding.IntentID)
+	if err = s.insert(txCtx, key, proposed); err != nil && !errors.Is(err, anystore.ErrDocExists) {
+		return nil, err
+	}
+	stored, err := s.LoadFile(txCtx, proposed.Binding.IntentID)
+	if err != nil {
+		return nil, err
+	}
+	if stored.Binding != proposed.Binding || stored.Fingerprint != proposed.Fingerprint ||
+		!bytes.Equal(stored.Spec, proposed.Spec) || !bytes.Equal(stored.SourceSpec, proposed.SourceSpec) {
+		return nil, ErrCollision
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	if err = s.EnsureDurable(ctx); err != nil {
+		return nil, fmt.Errorf("file prepared durability: %w", err)
+	}
+	return stored, nil
+}
diff --git a/internal/migrationintent/file_payload.go b/internal/migrationintent/file_payload.go
new file mode 100644
index 0000000..da0cfaa
--- /dev/null
+++ b/internal/migrationintent/file_payload.go
@@ -0,0 +1,36 @@
+package migrationintent
+
+import (
+	"encoding/hex"
+	"errors"
+	"github.com/anyproto/any-sync-sdk/internal/payloads"
+	"github.com/ipfs/go-cid"
+)
+
+const FileMaximumBytes int64 = 512 << 20
+
+var ErrFileContent = errors.New("fileupload: prepared file content differs from its specification")
+
+type FilePayload struct {
+	RootCID     string `json:"rootCid"`
+	Key         []byte `json:"key"`
+	Size        int64  `json:"size"`
+	SHA256      string `json:"sha256"`
+	IntentID    string `json:"intentId"`
+	Fingerprint string `json:"fingerprint"`
+}
+
+func (p FilePayload) Validate() error {
+	root, err := cid.Decode(p.RootCID)
+	if err != nil || !root.Defined() || root.String() != p.RootCID || len(p.Key) != 32 ||
+		p.Size < payloads.InlineMaxSize || p.Size > FileMaximumBytes {
+		return ErrFileContent
+	}
+	for _, value := range []string{p.SHA256, p.IntentID, p.Fingerprint} {
+		raw, err := hex.DecodeString(value)
+		if err != nil || len(raw) != 32 || hex.EncodeToString(raw) != value {
+			return ErrFileContent
+		}
+	}
+	return nil
+}
diff --git a/internal/migrationintent/inline_file.go b/internal/migrationintent/inline_file.go
new file mode 100644
index 0000000..be45a63
--- /dev/null
+++ b/internal/migrationintent/inline_file.go
@@ -0,0 +1,161 @@
+package migrationintent
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"unicode/utf8"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-sync-sdk/internal/payloads"
+)
+
+const InlineFileKind = "inlineFile"
+const inlineFileStage = "inline-file"
+
+// InlineFileSpec contains only ordinary input, never keys or signed bytes.
+// The existing payloads tier is strictly smaller than 4096 bytes. Keeping
+// this native limit here rejects an oversize request before DAG preparation.
+type InlineFileSpec struct {
+	OwnerObjectID string `json:"ownerObjectId"`
+	Name          string `json:"name"`
+	Mime          string `json:"mime"`
+	Content       []byte `json:"content"`
+	ContentSHA256 string `json:"contentSHA256"`
+}
+
+func (s InlineFileSpec) Validate() error {
+	if s.OwnerObjectID == "" || len(s.OwnerObjectID) > 256 ||
+		!utf8.ValidString(s.Name) || !utf8.ValidString(s.Mime) ||
+		len(s.Name) > 1024 || len(s.Mime) > 255 || strings.ContainsRune(s.Name, 0) || strings.ContainsRune(s.Mime, 0) ||
+		len(s.Content) >= payloads.InlineMaxSize || s.ContentSHA256 != Digest(s.Content) {
+		return ErrScope
+	}
+	return nil
+}
+
+// InlineFile reserves the exact deterministic native derived root AND its
+// first signed file row atomically. Neither root registration nor row append
+// is allowed before this immutable entry and its checkpoint succeed.
+type InlineFile struct {
+	Prepared
+	RootRaw       []byte `json:"rootRaw"`
+	OwnerObjectID string `json:"ownerObjectId"`
+	ReadKeyID     string `json:"readKeyId"`
+	ACLHeadID     string `json:"aclHeadId"`
+	ContentSHA256 string `json:"contentSHA256"`
+	Size          int64  `json:"size"`
+}
+
+func (s *Store) InlineFileFingerprint(binding Binding, spec, sourceSpec []byte) (string, error) {
+	if err := s.Check(binding); err != nil {
+		return "", err
+	}
+	var input InlineFileSpec
+	if len(spec) == 0 || len(spec) > 32<<10 || json.Unmarshal(spec, &input) != nil || input.Validate() != nil ||
+		len(sourceSpec) == 0 || len(sourceSpec) > 1<<20 || !json.Valid(sourceSpec) || ValidateNumbers(sourceSpec) != nil {
+		return "", ErrCorrupt
+	}
+	h := sha256.New()
+	for _, v := range []string{Contract, binding.AccountID, binding.SpaceID, binding.StoreID, binding.PlanID, binding.PlanSHA256, binding.IntentID, binding.SourceKey, InlineFileKind, Digest(spec), Digest(sourceSpec)} {
+		var n [8]byte
+		binary.BigEndian.PutUint64(n[:], uint64(len(v)))
+		h.Write(n[:])
+		h.Write([]byte(v))
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func inlineFileKey(intentID string) (string, error) {
+	if !validHex(intentID) {
+		return "", ErrScope
+	}
+	// Distinct from root/bootstrap/block; the shared intent identity still
+	// rejects reuse of this same intent ID by any other kind in either order.
+	return "intent/" + intentID + "/" + inlineFileStage, nil
+}
+
+func (s *Store) validateInlineFile(e *InlineFile) error {
+	if e == nil || s.Check(e.Binding) != nil || e.Kind != InlineFileKind || e.Stage != inlineFileStage ||
+		len(e.RootRaw) == 0 || len(e.RootRaw) > 16<<10 || len(e.Raw) == 0 || len(e.Raw) > 32<<10 ||
+		len(e.Payload) == 0 || len(e.Payload) > 24<<10 || e.ObjectID == "" || e.ChangeID == "" ||
+		e.OwnerObjectID == "" || e.ReadKeyID == "" || e.ACLHeadID == "" || e.Timestamp <= 0 ||
+		len(e.RecordIDs) != 1 || e.RecordIDs[0] == "" || len(e.Dependencies) != 2 ||
+		len(e.Dependencies[e.OwnerObjectID]) == 0 || len(e.Dependencies[e.ObjectID]) == 0 {
+		return ErrCorrupt
+	}
+	var spec InlineFileSpec
+	if json.Unmarshal(e.Spec, &spec) != nil || spec.Validate() != nil || spec.OwnerObjectID != e.OwnerObjectID ||
+		spec.ContentSHA256 != e.ContentSHA256 || int64(len(spec.Content)) != e.Size {
+		return ErrCorrupt
+	}
+	fp, err := s.InlineFileFingerprint(e.Binding, e.Spec, e.SourceSpec)
+	if err != nil || fp != e.Fingerprint || e.SpecSHA256 != Digest(e.SourceSpec) {
+		return ErrCorrupt
+	}
+	return nil
+}
+
+func (s *Store) LoadInlineFile(ctx context.Context, intentID string) (*InlineFile, error) {
+	key, err := inlineFileKey(intentID)
+	if err != nil {
+		return nil, err
+	}
+	var e InlineFile
+	if err = s.read(ctx, key, &e); err != nil {
+		return nil, err
+	}
+	if e.Binding.IntentID != intentID {
+		return nil, ErrCorrupt
+	}
+	if err = s.validateInlineFile(&e); err != nil {
+		return nil, err
+	}
+	if err = s.checkBindings(ctx, &e.Prepared); err != nil {
+		return nil, err
+	}
+	return &e, nil
+}
+
+func (s *Store) ReserveInlineFile(ctx context.Context, proposed *InlineFile) (*InlineFile, error) {
+	if err := s.validateInlineFile(proposed); err != nil {
+		return nil, err
+	}
+	tx, err := s.db.WriteTx(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	txCtx := tx.Context()
+	if err = s.bindPlan(txCtx, proposed.Binding); err != nil {
+		return nil, err
+	}
+	if err = s.bindIntent(txCtx, &proposed.Prepared); err != nil {
+		return nil, err
+	}
+	key, _ := inlineFileKey(proposed.Binding.IntentID)
+	if err = s.insert(txCtx, key, proposed); err != nil && !errors.Is(err, anystore.ErrDocExists) {
+		return nil, err
+	}
+	stored, err := s.LoadInlineFile(txCtx, proposed.Binding.IntentID)
+	if err != nil {
+		return nil, err
+	}
+	if stored.Binding != proposed.Binding || stored.Fingerprint != proposed.Fingerprint ||
+		!bytes.Equal(stored.Spec, proposed.Spec) || !bytes.Equal(stored.SourceSpec, proposed.SourceSpec) {
+		return nil, ErrCollision
+	}
+	if err = tx.Commit(); err != nil {
+		return nil, err
+	}
+	if err = s.EnsureDurable(ctx); err != nil {
+		return nil, fmt.Errorf("inline file prepared durability: %w", err)
+	}
+	return stored, nil
+}
diff --git a/internal/migrationintent/inline_file_test.go b/internal/migrationintent/inline_file_test.go
new file mode 100644
index 0000000..ba699dc
--- /dev/null
+++ b/internal/migrationintent/inline_file_test.go
@@ -0,0 +1,166 @@
+package migrationintent
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/stretchr/testify/require"
+)
+
+// These are ledger-only opaque envelopes; actual signed native bytes are
+// independently exercised by commitguard and the production SDK fixture.
+func inlineEntry(t *testing.T, s *Store, suffix string) *InlineFile {
+	t.Helper()
+	base := entryFor(t, s, "signed row "+suffix)
+	spec := InlineFileSpec{OwnerObjectID: "owner", Name: "source.txt", Mime: "text/plain", Content: []byte("durable inline bytes"), ContentSHA256: Digest([]byte("durable inline bytes"))}
+	base.Spec, _ = json.Marshal(spec)
+	base.SourceSpec = bytes.Clone(base.Spec)
+	base.SpecSHA256 = Digest(base.SourceSpec)
+	base.Kind, base.Stage, base.ObjectID, base.ChangeID = InlineFileKind, inlineFileStage, "payload-root", "row-change"
+	base.Payload, base.Timestamp, base.RecordIDs = []byte("sealed native row"), 1, []string{"file-id"}
+	base.Dependencies = map[string][]string{"owner": {"owner-head"}, "payload-root": {"payload-root"}}
+	base.Fingerprint, _ = s.InlineFileFingerprint(base.Binding, base.Spec, base.SourceSpec)
+	return &InlineFile{Prepared: *base, RootRaw: []byte("native derived root " + suffix), OwnerObjectID: "owner", ReadKeyID: "read-key", ACLHeadID: "acl-head", ContentSHA256: spec.ContentSHA256, Size: int64(len(spec.Content))}
+}
+
+func TestPreparedInlineLedgerConcurrentRootRowReservationAndRestart(t *testing.T) {
+	ctx := context.Background()
+	path := filepath.Join(t.TempDir(), "projection.db")
+	db, s := openTestStore(t, path)
+	var wg sync.WaitGroup
+	results := make(chan *InlineFile, 8)
+	errs := make(chan error, 8)
+	for i := range 8 {
+		e := inlineEntry(t, s, string(rune('a'+i)))
+		wg.Add(1)
+		go func() { defer wg.Done(); got, err := s.ReserveInlineFile(ctx, e); results <- got; errs <- err }()
+	}
+	wg.Wait()
+	close(results)
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			require.ErrorIs(t, err, anystore.ErrBusy)
+		}
+	}
+	var first *InlineFile
+	for got := range results {
+		if got != nil {
+			if first != nil {
+				require.Equal(t, first, got)
+			}
+			first = got
+		}
+	}
+	selected, err := s.ReserveInlineFile(ctx, inlineEntry(t, s, "late loser"))
+	require.NoError(t, err)
+	if first != nil {
+		require.Equal(t, first, selected)
+	}
+	require.NoError(t, db.Close())
+	db, reopened := openTestStore(t, path)
+	defer db.Close()
+	recovered, err := reopened.ReserveInlineFile(ctx, inlineEntry(t, reopened, "after restart loser"))
+	require.NoError(t, err)
+	require.Equal(t, selected, recovered, "root and row must be recovered as one exact immutable preparation")
+}
+
+func TestPreparedInlineLedgerCrossKindIntentAndStageIsolation(t *testing.T) {
+	for _, originalKind := range []string{"object", "editorBlock", InlineFileKind} {
+		t.Run(originalKind, func(t *testing.T) {
+			db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+			defer db.Close()
+			ctx := context.Background()
+			file := inlineEntry(t, s, "first")
+			ordinary := entryFor(t, s, "ordinary")
+			if originalKind == "editorBlock" {
+				ordinary.Kind, ordinary.Stage = "editorBlock", "block"
+				ordinary.Fingerprint, _ = s.Fingerprint(ordinary.Binding, ordinary.Kind, ordinary.Spec, ordinary.SourceSpec)
+			}
+			if originalKind == InlineFileKind {
+				_, err := s.ReserveInlineFile(ctx, file)
+				require.NoError(t, err)
+				_, err = s.Reserve(ctx, ordinary)
+				require.ErrorIs(t, err, ErrCollision)
+				_, err = s.Load(ctx, file.Binding.IntentID, "root")
+				require.ErrorIs(t, err, ErrNotFound)
+			} else {
+				_, err := s.Reserve(ctx, ordinary)
+				require.NoError(t, err)
+				_, err = s.ReserveInlineFile(ctx, file)
+				require.ErrorIs(t, err, ErrCollision)
+				_, err = s.LoadInlineFile(ctx, ordinary.Binding.IntentID)
+				require.ErrorIs(t, err, ErrNotFound)
+			}
+			// The original kind-inclusive source entity contract is preserved:
+			// a file payload may share its logical source key with its object.
+			file.Binding.IntentID = strings.Repeat("e", 64)
+			file.Fingerprint, _ = s.InlineFileFingerprint(file.Binding, file.Spec, file.SourceSpec)
+			if originalKind != InlineFileKind {
+				_, err := s.ReserveInlineFile(ctx, file)
+				require.NoError(t, err)
+			}
+		})
+	}
+}
+
+func TestPreparedInlineLedgerImmutablePlanSpecAndEntity(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+	defer db.Close()
+	ctx := context.Background()
+	_, err := s.ReserveInlineFile(ctx, inlineEntry(t, s, "selected"))
+	require.NoError(t, err)
+	for _, mode := range []string{"plan", "spec", "alternate-intent"} {
+		e := inlineEntry(t, s, "loser")
+		switch mode {
+		case "plan":
+			e.Binding.PlanSHA256 = strings.Repeat("f", 64)
+			e.Binding.IntentID = strings.Repeat("e", 64)
+			e.Binding.SourceKey = "new/source"
+		case "spec":
+			var spec InlineFileSpec
+			require.NoError(t, json.Unmarshal(e.Spec, &spec))
+			spec.Name = "changed"
+			e.Spec, _ = json.Marshal(spec)
+		case "alternate-intent":
+			e.Binding.IntentID = strings.Repeat("e", 64)
+		}
+		e.Fingerprint, _ = s.InlineFileFingerprint(e.Binding, e.Spec, e.SourceSpec)
+		_, err := s.ReserveInlineFile(ctx, e)
+		require.ErrorIs(t, err, ErrCollision, mode)
+	}
+	_, err = s.LoadInlineFile(ctx, strings.Repeat("e", 64))
+	require.ErrorIs(t, err, ErrNotFound)
+}
+
+func TestPreparedInlineLedgerCheckpointFailureAdmitsNoPreparation(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+	defer db.Close()
+	failed := &failingCheckpointDB{DB: db}
+	s.db = failed
+	got, err := s.ReserveInlineFile(context.Background(), inlineEntry(t, s, "reserved but not admitted"))
+	require.Nil(t, got)
+	require.ErrorContains(t, err, "checkpoint failure")
+	require.Error(t, s.EnsureDurable(context.Background()))
+	require.Equal(t, 2, failed.calls)
+}
+
+func TestPreparedInlineNativeStrictTierBoundary(t *testing.T) {
+	for _, size := range []int{0, 4095, 4096, 4097} {
+		bytes := bytes.Repeat([]byte{0xa5}, size)
+		spec := InlineFileSpec{OwnerObjectID: "owner", Content: bytes, ContentSHA256: Digest(bytes)}
+		err := spec.Validate()
+		if size < 4096 {
+			require.NoError(t, err)
+		} else {
+			require.True(t, errors.Is(err, ErrScope))
+		}
+	}
+}
diff --git a/internal/migrationintent/numbers.go b/internal/migrationintent/numbers.go
new file mode 100644
index 0000000..341de45
--- /dev/null
+++ b/internal/migrationintent/numbers.go
@@ -0,0 +1,56 @@
+package migrationintent
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"math/big"
+	"strconv"
+	"strings"
+)
+
+// ValidateNumbers refuses a JSON scalar whose decimal value would silently
+// change in the SDK's float64 anyenc representation. The source bytes still
+// remain separate; equivalent spellings such as 1e3 and 1000 are allowed.
+// Bounds precede rational parsing, including tiny underflowing exponents.
+func ValidateNumbers(raw []byte) error {
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	for {
+		token, err := decoder.Token()
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		number, ok := token.(json.Number)
+		if !ok {
+			continue
+		}
+		text := string(number)
+		if len(text) > 128 {
+			return fmt.Errorf("migration numeric scalar exceeds supported precision")
+		}
+		if i := strings.IndexAny(text, "eE"); i >= 0 {
+			exponent, err := strconv.Atoi(text[i+1:])
+			if err != nil || exponent < -1000 || exponent > 1000 {
+				return fmt.Errorf("migration numeric exponent is unsupported")
+			}
+		}
+		value, err := number.Float64()
+		if err != nil || math.IsNaN(value) || math.IsInf(value, 0) {
+			return fmt.Errorf("migration numeric scalar is not finite")
+		}
+		original, ok := new(big.Rat).SetString(text)
+		if !ok {
+			return fmt.Errorf("migration numeric scalar is invalid")
+		}
+		native, ok := new(big.Rat).SetString(strconv.FormatFloat(value, 'g', -1, 64))
+		if !ok || original.Cmp(native) != 0 {
+			return fmt.Errorf("migration numeric scalar would lose precision in native storage")
+		}
+	}
+}
diff --git a/internal/migrationintent/numbers_test.go b/internal/migrationintent/numbers_test.go
new file mode 100644
index 0000000..07c2e0d
--- /dev/null
+++ b/internal/migrationintent/numbers_test.go
@@ -0,0 +1,16 @@
+package migrationintent
+
+import "testing"
+
+func TestPreparedIntentRefusesLossyNativeNumbers(t *testing.T) {
+	for _, scalar := range []string{"9007199254740993", "1e999999999", "1e-999999999", "1e-400", "0.12345678901234567890123456789"} {
+		if ValidateNumbers([]byte(`{"nested":[`+scalar+`]}`)) == nil {
+			t.Fatalf("accepted lossy scalar %s", scalar)
+		}
+	}
+	for _, scalar := range []string{"9007199254740992", "1e3", "1000.00", "0.125", "1.3", "-0", "1e-100"} {
+		if err := ValidateNumbers([]byte(`{"nested":[` + scalar + `]}`)); err != nil {
+			t.Fatalf("rejected supported scalar %s: %v", scalar, err)
+		}
+	}
+}
diff --git a/internal/migrationintent/store.go b/internal/migrationintent/store.go
new file mode 100644
index 0000000..274b5f0
--- /dev/null
+++ b/internal/migrationintent/store.go
@@ -0,0 +1,390 @@
+// Package migrationintent is the private, destination-local write-ahead ledger
+// for the prepared migration route. It is deliberately not a CRDT dataset.
+// Every entry is immutable and committed before its signed bytes may enter a
+// native object tree. Native history, never a mutable receipt, determines the
+// outcome of an append whose acknowledgement was lost.
+package migrationintent
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-store/v2/anyenc"
+)
+
+const Contract = "pinkha-native-prepared-migration-v1"
+const collectionName = "_pinkha_native_migration_prepared_v1"
+const maxEntryBytes = 4 << 20
+
+var (
+	ErrScope     = errors.New("migration intent: destination store or scope differs")
+	ErrCollision = errors.New("migration intent: immutable intent fingerprint differs")
+	ErrCorrupt   = errors.New("migration intent: stored preparation is invalid")
+	ErrObsolete  = errors.New("migration intent: prepared envelope is obsolete")
+	ErrNotFound  = errors.New("migration intent: preparation not found")
+)
+
+// Binding is native-account and native-space scoped. StoreID is an opaque
+// generation in the projection database. Reset/replacement cannot adopt an old
+// caller plan: it yields a different StoreID and refuses before any append.
+type Binding struct {
+	StoreID    string `json:"storeId"`
+	AccountID  string `json:"accountId"`
+	SpaceID    string `json:"spaceId"`
+	PlanID     string `json:"planId"`
+	PlanSHA256 string `json:"planSHA256"`
+	IntentID   string `json:"intentId"`
+	SourceKey  string `json:"sourceKey"`
+}
+
+type Identity struct {
+	Contract  string `json:"contract"`
+	StoreID   string `json:"storeId"`
+	AccountID string `json:"accountId"`
+	SpaceID   string `json:"spaceId"`
+}
+
+// Prepared contains exactly one signed native root or change. The native SDK
+// retains both the user operation and the preparation-time fence. Raw is never
+// returned by HTTP and callers cannot choose it at commit.
+type Prepared struct {
+	Binding      Binding             `json:"binding"`
+	Fingerprint  string              `json:"fingerprint"`
+	Kind         string              `json:"kind"`
+	Stage        string              `json:"stage"`
+	ObjectID     string              `json:"objectId"`
+	ChangeID     string              `json:"changeId"`
+	Raw          []byte              `json:"raw"`
+	Spec         []byte              `json:"spec"`
+	SourceSpec   []byte              `json:"sourceSpec"`
+	SpecSHA256   string              `json:"specSHA256"`
+	Payload      []byte              `json:"payload,omitempty"`
+	Timestamp    int64               `json:"timestamp,omitempty"`
+	RecordIDs    []string            `json:"recordIds,omitempty"`
+	Dependencies map[string][]string `json:"dependencies,omitempty"`
+}
+
+type Store struct {
+	db       anystore.DB
+	coll     anystore.Collection
+	identity Identity
+}
+
+func validHex(value string) bool {
+	if len(value) != 64 {
+		return false
+	}
+	decoded, err := hex.DecodeString(value)
+	return err == nil && hex.EncodeToString(decoded) == value
+}
+
+func ValidID(value string) bool { return validHex(value) }
+
+func Open(ctx context.Context, db anystore.DB, accountID, spaceID string) (*Store, error) {
+	if db == nil || accountID == "" || spaceID == "" {
+		return nil, ErrScope
+	}
+	// The SDK projection DB is shared by its Spaces. A private ledger belongs
+	// to one native Space/account, just like the prefixed public projections.
+	coll, err := db.Collection(ctx, collectionName+"_"+Digest([]byte(spaceID)))
+	if err != nil {
+		return nil, err
+	}
+	s := &Store{db: db, coll: coll}
+	var identity Identity
+	err = s.read(ctx, "identity", &identity)
+	if errors.Is(err, ErrNotFound) {
+		var random [32]byte
+		if _, err = rand.Read(random[:]); err != nil {
+			return nil, err
+		}
+		identity = Identity{Contract: Contract, StoreID: hex.EncodeToString(random[:]), AccountID: accountID, SpaceID: spaceID}
+		err = s.insert(ctx, "identity", identity)
+		if errors.Is(err, anystore.ErrDocExists) {
+			err = s.read(ctx, "identity", &identity)
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	if identity.Contract != Contract || !validHex(identity.StoreID) || identity.AccountID != accountID || identity.SpaceID != spaceID {
+		return nil, ErrScope
+	}
+	s.identity = identity
+	return s, nil
+}
+
+func (s *Store) Identity() Identity { return s.identity }
+
+// Commit repeats the barrier even when prepare previously returned an I/O
+// error after its logical insert. Reading that row alone never admits append.
+func (s *Store) EnsureDurable(ctx context.Context) error {
+	return s.db.Flush(ctx, 0, anystore.FlushModeCheckpointFull)
+}
+
+func (s *Store) Check(binding Binding) error {
+	if binding.StoreID != s.identity.StoreID || binding.AccountID != s.identity.AccountID || binding.SpaceID != s.identity.SpaceID ||
+		!validHex(binding.PlanID) || !validHex(binding.PlanSHA256) || !validHex(binding.IntentID) || binding.SourceKey == "" || len(binding.SourceKey) > 4096 {
+		return ErrScope
+	}
+	return nil
+}
+
+// Fingerprint includes the complete normalized native operation, its immutable
+// source identity, and the destination generation. A client-provided hash is
+// only compared to this value; it never chooses native bytes.
+func (s *Store) Fingerprint(binding Binding, kind string, spec, sourceSpec []byte) (string, error) {
+	if err := s.Check(binding); err != nil {
+		return "", err
+	}
+	if kind != "object" && kind != "editorBlock" {
+		return "", ErrScope
+	}
+	if !json.Valid(spec) || len(spec) == 0 || len(spec) > maxEntryBytes/2 {
+		return "", ErrCorrupt
+	}
+	if !json.Valid(sourceSpec) || len(sourceSpec) == 0 || len(sourceSpec) > 1<<20 {
+		return "", ErrCorrupt
+	}
+	if ValidateNumbers(spec) != nil || ValidateNumbers(sourceSpec) != nil {
+		return "", ErrCorrupt
+	}
+	nativeHash, sourceHash := Digest(spec), Digest(sourceSpec)
+	h := sha256.New()
+	for _, value := range []string{Contract, binding.AccountID, binding.SpaceID, binding.StoreID, binding.PlanID, binding.PlanSHA256, binding.IntentID, binding.SourceKey, kind, nativeHash, sourceHash} {
+		var length [8]byte
+		binary.BigEndian.PutUint64(length[:], uint64(len(value)))
+		h.Write(length[:])
+		h.Write([]byte(value))
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func Digest(value []byte) string { sum := sha256.Sum256(value); return hex.EncodeToString(sum[:]) }
+
+func stageKey(intentID, stage string) (string, error) {
+	if !validHex(intentID) {
+		return "", ErrScope
+	}
+	if stage != "root" && stage != "bootstrap" && stage != "block" {
+		return "", ErrScope
+	}
+	// Intent IDs are unique within a physical account/Space store, across plans.
+	// Reusing one under another plan is a collision, never a second allocation.
+	return "intent/" + intentID + "/" + stage, nil
+}
+
+func (s *Store) Load(ctx context.Context, intentID, stage string) (*Prepared, error) {
+	key, err := stageKey(intentID, stage)
+	if err != nil {
+		return nil, err
+	}
+	var entry Prepared
+	if err = s.read(ctx, key, &entry); err != nil {
+		return nil, err
+	}
+	if err = s.validate(&entry); err != nil {
+		return nil, err
+	}
+	if entry.Binding.IntentID != intentID || entry.Stage != stage {
+		return nil, ErrCorrupt
+	}
+	if err = s.checkBindings(ctx, &entry); err != nil {
+		return nil, err
+	}
+	return &entry, nil
+}
+
+func (s *Store) validate(entry *Prepared) error {
+	if entry == nil || s.Check(entry.Binding) != nil || !validHex(entry.Fingerprint) || len(entry.Raw) == 0 ||
+		entry.ObjectID == "" || entry.ChangeID == "" || !json.Valid(entry.Spec) || entry.Timestamp < 0 {
+		return ErrCorrupt
+	}
+	if entry.Kind == "object" {
+		if entry.Stage != "root" && entry.Stage != "bootstrap" {
+			return ErrCorrupt
+		}
+	} else if entry.Kind != "editorBlock" || entry.Stage != "block" {
+		return ErrCorrupt
+	}
+	if entry.Stage == "root" && entry.ChangeID != entry.ObjectID {
+		return ErrCorrupt
+	}
+	fingerprint, err := s.Fingerprint(entry.Binding, entry.Kind, entry.Spec, entry.SourceSpec)
+	if err != nil || fingerprint != entry.Fingerprint || entry.SpecSHA256 != Digest(entry.SourceSpec) {
+		return ErrCorrupt
+	}
+	return nil
+}
+
+// Reserve wins by the database's unique primary key, across concurrent native
+// callers as well as process restart. A duplicate returns the FIRST exact
+// signed envelope, never the loser's newly generated signature/seed/time.
+// A returned error authorizes no native append, even when Insert may have
+// committed: the caller must re-open and Load to reconcile that uncertainty.
+func (s *Store) Reserve(ctx context.Context, proposed *Prepared) (*Prepared, error) {
+	if err := s.validate(proposed); err != nil {
+		return nil, err
+	}
+	// This transaction covers only the private projection-store ledger. It
+	// never encloses native DAG creation/publication or native tree callbacks.
+	// Plan/entity/intent identity and exact bytes become visible together.
+	tx, err := s.db.WriteTx(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	txCtx := tx.Context()
+	if err := s.bindPlan(txCtx, proposed.Binding); err != nil {
+		return nil, err
+	}
+	if err := s.bindIntent(txCtx, proposed); err != nil {
+		return nil, err
+	}
+	key, err := stageKey(proposed.Binding.IntentID, proposed.Stage)
+	if err != nil {
+		return nil, err
+	}
+	err = s.insert(txCtx, key, proposed)
+	if err != nil && !errors.Is(err, anystore.ErrDocExists) {
+		return nil, err
+	}
+	stored, err := s.Load(txCtx, proposed.Binding.IntentID, proposed.Stage)
+	if err != nil {
+		return nil, err
+	}
+	if stored.Binding != proposed.Binding || stored.Fingerprint != proposed.Fingerprint || stored.Kind != proposed.Kind || !bytes.Equal(stored.Spec, proposed.Spec) || !bytes.Equal(stored.SourceSpec, proposed.SourceSpec) {
+		return nil, ErrCollision
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	// Projection databases normally defer WAL fsync. A successful logical
+	// commit alone is therefore insufficient for a native write-ahead claim.
+	// Full checkpoint is a required durability barrier; a store without an
+	// enabled durability controller fails closed here and may append nothing.
+	if err := s.EnsureDurable(ctx); err != nil {
+		return nil, fmt.Errorf("migration prepared durability: %w", err)
+	}
+	return stored, nil
+}
+
+type planBinding struct {
+	StoreID    string `json:"storeId"`
+	AccountID  string `json:"accountId"`
+	SpaceID    string `json:"spaceId"`
+	PlanID     string `json:"planId"`
+	PlanSHA256 string `json:"planSHA256"`
+}
+
+type intentBinding struct {
+	Binding          Binding `json:"binding"`
+	Kind             string  `json:"kind"`
+	Fingerprint      string  `json:"fingerprint"`
+	SpecSHA256       string  `json:"specSHA256"`
+	NativeSpecSHA256 string  `json:"nativeSpecSHA256"`
+}
+
+func (s *Store) bindIntent(ctx context.Context, entry *Prepared) error {
+	want := intentBinding{entry.Binding, entry.Kind, entry.Fingerprint, entry.SpecSHA256, Digest(entry.Spec)}
+	for _, key := range []string{"intent/" + entry.Binding.IntentID + "/identity", entityKey(entry)} {
+		err := s.insert(ctx, key, want)
+		if err != nil && !errors.Is(err, anystore.ErrDocExists) {
+			return err
+		}
+		var got intentBinding
+		if err = s.read(ctx, key, &got); err != nil {
+			return err
+		}
+		if got != want {
+			return ErrCollision
+		}
+	}
+	return nil
+}
+
+func entityKey(entry *Prepared) string {
+	hash := sha256.New()
+	for _, value := range []string{Contract + "/entity", entry.Binding.PlanID, entry.Binding.SourceKey, entry.Kind} {
+		var length [8]byte
+		binary.BigEndian.PutUint64(length[:], uint64(len(value)))
+		hash.Write(length[:])
+		hash.Write([]byte(value))
+	}
+	return "entity/" + hex.EncodeToString(hash.Sum(nil))
+}
+
+func (s *Store) checkBindings(ctx context.Context, entry *Prepared) error {
+	binding := entry.Binding
+	wantPlan := planBinding{binding.StoreID, binding.AccountID, binding.SpaceID, binding.PlanID, binding.PlanSHA256}
+	var plan planBinding
+	if err := s.read(ctx, "plan/"+binding.PlanID, &plan); err != nil || plan != wantPlan {
+		return ErrCorrupt
+	}
+	wantIntent := intentBinding{binding, entry.Kind, entry.Fingerprint, entry.SpecSHA256, Digest(entry.Spec)}
+	for _, key := range []string{"intent/" + binding.IntentID + "/identity", entityKey(entry)} {
+		var intent intentBinding
+		if err := s.read(ctx, key, &intent); err != nil || intent != wantIntent {
+			return ErrCorrupt
+		}
+	}
+	return nil
+}
+
+// A logical plan keeps its identity when its archive changes. It can never
+// silently acquire additional or removed source entities under a new digest.
+// This unique insert commits BEFORE any entity preparation is admitted.
+func (s *Store) bindPlan(ctx context.Context, binding Binding) error {
+	want := planBinding{binding.StoreID, binding.AccountID, binding.SpaceID, binding.PlanID, binding.PlanSHA256}
+	key := "plan/" + binding.PlanID
+	err := s.insert(ctx, key, want)
+	if err != nil && !errors.Is(err, anystore.ErrDocExists) {
+		return err
+	}
+	var got planBinding
+	if err = s.read(ctx, key, &got); err != nil {
+		return err
+	}
+	if got != want {
+		return ErrCollision
+	}
+	return nil
+}
+
+func (s *Store) read(ctx context.Context, id string, target any) error {
+	doc, err := s.coll.FindId(ctx, id)
+	if errors.Is(err, anystore.ErrDocNotFound) {
+		return ErrNotFound
+	}
+	if err != nil {
+		return err
+	}
+	encoded := doc.Value().GetStringBytes("body")
+	if len(encoded) == 0 || len(encoded) > maxEntryBytes || json.Unmarshal(encoded, target) != nil {
+		return ErrCorrupt
+	}
+	return nil
+}
+
+func (s *Store) insert(ctx context.Context, id string, value any) error {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	if len(encoded) > maxEntryBytes {
+		return fmt.Errorf("%w: size", ErrCorrupt)
+	}
+	a := &anyenc.Arena{}
+	doc := a.NewObject()
+	doc.Set("id", a.NewString(id))
+	doc.Set("body", a.NewString(string(encoded)))
+	return s.coll.Insert(ctx, doc)
+}
