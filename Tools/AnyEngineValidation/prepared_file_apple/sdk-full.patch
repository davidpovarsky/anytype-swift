@@ -0,0 +1,40 @@
+package crdt
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/internal/schema"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNativeGuardLookupColdCollectionInsideReadTx(t *testing.T) {
+	ctx := context.Background()
+	db, err := anystore.Open(ctx, filepath.Join(t.TempDir(), "cold.db"), nil)
+	require.NoError(t, err)
+	defer db.Close()
+	coll, err := db.Collection(ctx, "target_editor_blocks")
+	require.NoError(t, err)
+	row := anyenc.MustParseJson(`{"id":"stable-block","text":"cold stored block"}`)
+	require.NoError(t, coll.Insert(ctx, row))
+	// A new controller has handlers but has not opened the existing per-object
+	// collection. Lookup's normal openForRead can initialize schema/indexes;
+	// this guarded path must only open/read it under the existing ReadTx.
+	controller, err := NewController(ctx, "target", db, HandlerReg{Name: "editor_blocks", Handler: DefaultHandler{}, Schema: schema.Dataset{Dynamic: true}})
+	require.NoError(t, err)
+	tx, err := db.ReadTx(ctx)
+	require.NoError(t, err)
+	defer tx.Commit()
+	got, err := controller.GuardLookup(tx.Context(), "editor_blocks", "stable-block")
+	require.NoError(t, err)
+	require.Equal(t, "cold stored block", string(got.GetStringBytes("text")))
+	missing, err := controller.GuardLookup(tx.Context(), "editor_blocks", "missing")
+	require.NoError(t, err)
+	require.Nil(t, missing)
+	unknown, err := controller.GuardLookup(tx.Context(), "unknown_dataset", "missing")
+	require.NoError(t, err)
+	require.Nil(t, unknown)
+}
diff --git a/internal/crdt/localguard.go b/internal/crdt/localguard.go
new file mode 100644
index 0000000..4286054
--- /dev/null
+++ b/internal/crdt/localguard.go
@@ -0,0 +1,165 @@
+package crdt
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-store/v2/query"
+	"github.com/anyproto/any-sync-sdk/internal/anyencx"
+)
+
+// LocalReadView exists only while the SDK holds the writer's tree and every
+// declared dependency tree. Reads are restricted to those objects, in this
+// Space. A read error is never treated as an absent record.
+type LocalReadView interface {
+	Lookup(objectId, dataset, id string) (*anyenc.Value, error)
+	Query(objectId, dataset string, filter any, limit int) ([]*anyenc.Value, error)
+}
+
+// NativeReadView adds read-only access to the Space's shared native object
+// projection. It is exposed only inside the current-ACL-fenced read transaction,
+// never as a cross-object write precondition.
+type NativeReadView interface {
+	LocalReadView
+	SpaceObjects(filter any, limit int) ([]*anyenc.Value, error)
+	CanWrite() bool
+	ReadStamp() NativeReadStamp
+}
+
+type NativeReadStamp struct {
+	ACLHeadID       string              `json:"aclHeadId"`
+	StoreGeneration string              `json:"storeGeneration"`
+	TreeHeads       map[string][]string `json:"treeHeads"`
+}
+
+var ErrNativeReadRequired = errors.New("native guarded data requires its current-authority snapshot API")
+
+// GuardedHandler is opt-in native domain behavior. Validation of signed remote
+// data MUST be intrinsic and arrival-order independent. Local validation may
+// inspect mutable target state because the SDK holds those targets' tree locks
+// until the durable append and local apply finish. The root seed restricts the
+// behavior to one canonical derived carrier per Space.
+type GuardedHandler interface {
+	GuardRootSeed() []byte
+	ValidateNative(ch *Change) error
+	LocalTargets(ch *Change) ([]string, error)
+	ValidateLocal(ch *Change, view LocalReadView) error
+}
+
+func (c *Controller) LocalGuard(dataset string) GuardedHandler {
+	if c == nil {
+		return nil
+	}
+	g, _ := c.handlers[dataset].(GuardedHandler)
+	return g
+}
+
+func (c *Controller) NativeGuards() map[string]GuardedHandler {
+	result := make(map[string]GuardedHandler)
+	for dataset, h := range c.handlers {
+		if g, ok := h.(GuardedHandler); ok {
+			result[dataset] = g
+		}
+	}
+	return result
+}
+
+// GuardQuery is bounded and object-scoped even for shared collections. It is
+// called under the object's tree lock; every local write, inbound apply, purge
+// and close takes that same lock.
+func (c *Controller) GuardQuery(ctx context.Context, dataset string, filter any, limit int) ([]*anyenc.Value, error) {
+	return c.guardQuery(ctx, dataset, filter, limit, false)
+}
+
+func (c *Controller) GuardSpaceObjects(ctx context.Context, filter any, limit int) ([]*anyenc.Value, error) {
+	if !c.IsShared("objects") {
+		return nil, ErrValidation
+	}
+	return c.guardQuery(ctx, "objects", filter, limit, true)
+}
+
+func (c *Controller) guardQuery(ctx context.Context, dataset string, filter any, limit int, spaceObjects bool) ([]*anyenc.Value, error) {
+	if limit < 1 || limit > 10001 {
+		return nil, fmt.Errorf("%w: guard query limit", ErrValidation)
+	}
+	f, err := query.ParseCondition(filter)
+	if err != nil {
+		return nil, err
+	}
+	if c.IsKeyed(dataset) {
+		f = query.And{f, KeyedRows(c.objectId)}
+	} else if c.IsShared(dataset) && !spaceObjects {
+		own, err := query.ParseCondition(map[string]any{"id": c.objectId})
+		if err != nil {
+			return nil, err
+		}
+		f = query.And{f, own}
+	}
+	coll, err := c.PeekCollection(ctx, dataset)
+	if err != nil {
+		return nil, err
+	}
+	if coll == nil {
+		return []*anyenc.Value{}, nil
+	}
+	it, err := coll.Find(f).Limit(uint(limit)).Iter(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer it.Close()
+	result := make([]*anyenc.Value, 0)
+	for it.Next() {
+		doc, err := it.Doc()
+		if err != nil {
+			return nil, err
+		}
+		result = append(result, anyencx.Clone(doc.Value()))
+	}
+	if err := it.Err(); err != nil {
+		return nil, errors.Join(ErrValidation, err)
+	}
+	return result, nil
+}
+
+// GuardLookup never initializes a collection or its indexes. Native snapshots
+// call it inside a ReadTx, including after a cold restart with an empty cache.
+func (c *Controller) GuardLookup(ctx context.Context, dataset, id string) (*anyenc.Value, error) {
+	coll, err := c.PeekCollection(ctx, dataset)
+	if err != nil {
+		return nil, err
+	}
+	if coll == nil {
+		return nil, nil
+	}
+	doc, err := coll.FindId(ctx, c.StoreId(dataset, id))
+	if errors.Is(err, anystore.ErrDocNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return anyencx.Clone(doc.Value()), nil
+}
+
+// NativeTypeDatasetRequirement is an in-process condition on the current or
+// proposed Type. It is checked under that definition's native tree lock.
+type NativeTypeDatasetRequirement struct {
+	Module    string
+	Dataset   string
+	Canonical bool
+}
+
+// NativeTypeDefinitionView is an optional read facet supplied by the native
+// store while dynamic owner trees are held. Static catalogs are immutable.
+type NativeTypeDefinitionView interface {
+	TypeDeclaresDataset(typeID, module, dataset string, canonicalOnly bool) (bool, error)
+}
+
+// NativeObjectPolicyView validates an SDK-created write against current
+// destination membership and definitions. It is never a replicated contract.
+type NativeObjectPolicyView interface {
+	ValidateNativeObjectChange(*Change) error
+}
