+package space
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+)
+
+const PreparedMigrationContract = "pinkha-native-prepared-migration-v1"
+
+// ValidatePreparedMigrationNumbers is the narrow HTTP adapter's preflight for
+// exact JSON numbers. Native reservation repeats it independently.
+func ValidatePreparedMigrationNumbers(raw []byte) error { return migrationintent.ValidateNumbers(raw) }
+
+var (
+	ErrMigrationScope     = migrationintent.ErrScope
+	ErrMigrationCollision = migrationintent.ErrCollision
+	ErrMigrationObsolete  = migrationintent.ErrObsolete
+	ErrMigrationNotFound  = migrationintent.ErrNotFound
+	ErrMigrationCorrupt   = migrationintent.ErrCorrupt
+)
+
+// PreparedMigrationService is an additive opt-in capability of Objects().
+// Existing create/modify and incoming replication interfaces are unchanged.
+// The source specification is ordinary JSON, never a caller-signed DAG change.
+type PreparedMigrationService interface {
+	MigrationCapabilities(context.Context) (MigrationCapabilities, error)
+	PrepareMigrationObject(context.Context, MigrationInput, CreateObjectOpts) (MigrationReceipt, error)
+	PrepareMigrationBlock(context.Context, MigrationInput, ModifyBatch) (MigrationReceipt, error)
+	CommitMigration(context.Context, MigrationCommit) (MigrationReceipt, error)
+	MigrationStatus(context.Context, string) (MigrationReceipt, error)
+}
+
+type MigrationCapabilities struct {
+	Contract        string `json:"contract"`
+	StoreID         string `json:"storeId"`
+	AccountID       string `json:"accountId"`
+	SpaceID         string `json:"spaceId"`
+	Object          int    `json:"object"`
+	EditorBlock     int    `json:"editorBlock"`
+	File            int    `json:"file"`
+	NetworkVerified bool   `json:"networkVerified"`
+}
+
+type MigrationInput struct {
+	Contract   string
+	StoreID    string
+	PlanID     string
+	PlanSHA256 string
+	IntentID   string
+	SourceKey  string
+	SpecSHA256 string
+	SourceSpec []byte
+}
+
+type MigrationCommit struct {
+	Contract    string `json:"contract"`
+	StoreID     string `json:"storeId"`
+	PlanID      string `json:"planId"`
+	PlanSHA256  string `json:"planSHA256"`
+	IntentID    string `json:"-"`
+	Fingerprint string `json:"fingerprint"`
+}
+
+type MigrationReceipt struct {
+	Contract    string   `json:"contract"`
+	IntentID    string   `json:"intentId"`
+	StoreID     string   `json:"storeId"`
+	AccountID   string   `json:"accountId"`
+	SpaceID     string   `json:"spaceId"`
+	PlanID      string   `json:"planId"`
+	PlanSHA256  string   `json:"planSHA256"`
+	SourceKey   string   `json:"sourceKey"`
+	Kind        string   `json:"kind"`
+	Fingerprint string   `json:"fingerprint"`
+	SpecSHA256  string   `json:"specSHA256"`
+	Stage       string   `json:"stage"`
+	Outcome     string   `json:"outcome"`
+	ObjectID    string   `json:"objectId,omitempty"`
+	ChangeID    string   `json:"changeId,omitempty"`
+	RecordIDs   []string `json:"recordIds"`
+}
