--- /dev/null
+++ b/internal/spaceobjects/create_current_writer.go
@@ -0,0 +1,58 @@
+package spaceobjects
+
+import (
+	"context"
+	"crypto/rand"
+	"fmt"
+	"time"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+)
+
+type CurrentRootCreate struct {
+	ObjectID         string
+	StorageAttempted bool
+	RootStored       bool
+}
+
+// CreateCurrentWriter is a distinct local-create route. Incoming PutTree and
+// ordinary Create retain historical/upstream semantics.
+func (s *Store) CreateCurrentWriter(ctx context.Context, opts CreateOpts) (*object.Object, CurrentRootCreate, error) {
+	state := CurrentRootCreate{}
+	if s.signKey == nil {
+		return nil, state, commitguard.ErrNativeCommitGuard
+	}
+	if err := s.CheckWrite(); err != nil {
+		return nil, state, err
+	}
+	if err := validateEncryptionClass(opts.ChangeType, opts.Unencrypted); err != nil {
+		return nil, state, err
+	}
+	handle, err := s.app.GetSpace(ctx, s.spaceId)
+	if err != nil {
+		return nil, state, err
+	}
+	seed := make([]byte, 32)
+	if _, err := rand.Read(seed); err != nil {
+		return nil, state, err
+	}
+	payload, err := handle.Inner().TreeBuilder().CreateTree(ctx, objecttree.ObjectTreeCreatePayload{PrivKey: s.signKey, ChangeType: opts.ChangeType, ChangePayload: opts.ChangePayload, SpaceId: s.spaceId, IsEncrypted: !opts.Unencrypted, Seed: seed, Timestamp: time.Now().Unix()})
+	if err != nil {
+		return nil, state, fmt.Errorf("native create root: %w", err)
+	}
+	state.ObjectID = payload.RootRawChange.Id
+	if s.signKey == nil {
+		return nil, state, commitguard.ErrNativeCommitGuard
+	}
+	_, state.StorageAttempted, err = commitguard.StoreCurrentRoot(ctx, handle.Inner().Storage(), handle.Inner().Acl(), s.signKey.GetPublic(), payload)
+	if err != nil {
+		return nil, state, err
+	}
+	state.RootStored = true
+	// The root is already stored under the ACL fence. Loading it through Get
+	// uses BuildTree, never a second unguarded PutTree creation.
+	obj, err := s.Get(ctx, state.ObjectID)
+	return obj, state, err
+}
