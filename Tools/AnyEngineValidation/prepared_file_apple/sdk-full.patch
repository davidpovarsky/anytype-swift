diff --git a/internal/spaceimpl/migration_file.go b/internal/spaceimpl/migration_file.go
new file mode 100644
index 0000000..bce10e4
--- /dev/null
+++ b/internal/spaceimpl/migration_file.go
@@ -0,0 +1,181 @@
+package spaceimpl
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"slices"
+
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+var _ space.PreparedFileService = (*filesAPI)(nil)
+
+func fullFileReceipt(e *migrationintent.File, stage, outcome string) space.MigrationFileReceipt {
+	return space.MigrationFileReceipt{MigrationReceipt: receipt(&e.Prepared, stage, outcome),
+		OwnerObjectID: e.OwnerObjectID, FileID: e.RecordIDs[0], ContentSHA256: e.ContentSHA256,
+		Size: e.Size, RootCID: e.Staged.RootCID, LocalFileComplete: stage == "complete" && outcome == "committed"}
+}
+
+func (f *filesAPI) preparedFileResult(ctx context.Context, e *migrationintent.File, stage, outcome string) (space.MigrationFileReceipt, error) {
+	if outcome == "committed" {
+		complete, err := f.s.parent.files.MigrationFileAdopted(ctx, f.s.id, e.RecordIDs[0], e.Staged)
+		if err != nil {
+			return fullFileReceipt(e, stage, outcome), err
+		}
+		if complete {
+			stage = "complete"
+		}
+	}
+	return fullFileReceipt(e, stage, outcome), nil
+}
+
+func (f *filesAPI) PrepareMigrationFile(ctx context.Context, input space.MigrationInput, requested space.MigrationFileSpec, body io.Reader) (space.MigrationFileReceipt, error) {
+	spec := migrationintent.FileSpec{OwnerObjectID: requested.OwnerObjectID, Name: requested.Name,
+		Mime: requested.Mime, Size: requested.Size, ContentSHA256: requested.ContentSHA256}
+	if err := spec.Validate(); err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	if input.Contract != migrationintent.Contract || input.SpecSHA256 != migrationintent.Digest(input.SourceSpec) {
+		return space.MigrationFileReceipt{}, migrationintent.ErrScope
+	}
+	files := f.s.parent.files
+	if files == nil {
+		return space.MigrationFileReceipt{}, errors.New("prepared file: files not configured")
+	}
+	// Refuse a foreign/stopped account, revoked writer or deleted owner before
+	// reading any caller bytes. Native preparation repeats the same fences.
+	if err := f.s.writeGate(ctx); err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	if err := f.s.store.CheckMigrationWriter(ctx); err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	owner, err := f.s.store.TreeEntry(ctx, spec.OwnerObjectID)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	if !owner.Present || owner.Deleted || owner.Derived {
+		return space.MigrationFileReceipt{}, migrationintent.ErrObsolete
+	}
+	unlock := f.s.store.LockMigration()
+	defer unlock()
+	journal, err := f.s.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	id := journal.Identity()
+	binding := migrationintent.Binding{StoreID: input.StoreID, AccountID: id.AccountID, SpaceID: id.SpaceID,
+		PlanID: input.PlanID, PlanSHA256: input.PlanSHA256, IntentID: input.IntentID, SourceKey: input.SourceKey}
+	nativeSpec, err := json.Marshal(spec)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	fp, err := journal.FileFingerprint(binding, nativeSpec, input.SourceSpec)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	if old, err := journal.LoadFile(ctx, input.IntentID); err == nil {
+		if old.Binding != binding || old.Fingerprint != fp {
+			return space.MigrationFileReceipt{}, migrationintent.ErrCollision
+		}
+		stage, outcome, err := f.s.store.MigrationFileState(ctx, old, false)
+		if err != nil {
+			return fullFileReceipt(old, stage, outcome), err
+		}
+		return f.preparedFileResult(ctx, old, stage, outcome)
+	} else if !errors.Is(err, migrationintent.ErrNotFound) {
+		return space.MigrationFileReceipt{}, err
+	}
+	draft, err := journal.ReserveFileDraft(ctx, migrationintent.Prepared{Binding: binding, Fingerprint: fp,
+		Spec: nativeSpec, SourceSpec: slices.Clone(input.SourceSpec), SpecSHA256: input.SpecSHA256})
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	staged, err := files.StageReservedMigrationFile(ctx, f.s.id, binding.IntentID, fp, spec.Size, spec.ContentSHA256, body, draft.Key)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	e := &migrationintent.File{Prepared: draft.Prepared, Staged: staged}
+	e.Stage = "file"
+	e, err = f.s.store.PrepareMigrationFile(ctx, journal, e, spec)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	stage, outcome, err := f.s.store.MigrationFileState(ctx, e, false)
+	if err != nil {
+		return fullFileReceipt(e, stage, outcome), err
+	}
+	return f.preparedFileResult(ctx, e, stage, outcome)
+}
+
+func (f *filesAPI) MigrationFileStatus(ctx context.Context, intentID string) (space.MigrationFileReceipt, error) {
+	if f.s.parent.files == nil {
+		return space.MigrationFileReceipt{}, errors.New("prepared file: files not configured")
+	}
+	unlock := f.s.store.LockMigration()
+	defer unlock()
+	journal, err := f.s.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	e, err := journal.LoadFile(ctx, intentID)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	stage, outcome, err := f.s.store.MigrationFileState(ctx, e, false)
+	if err != nil {
+		return fullFileReceipt(e, stage, outcome), err
+	}
+	return f.preparedFileResult(ctx, e, stage, outcome)
+}
+
+func (f *filesAPI) CommitMigrationFile(ctx context.Context, input space.MigrationCommit) (space.MigrationFileReceipt, error) {
+	files := f.s.parent.files
+	if files == nil {
+		return space.MigrationFileReceipt{}, errors.New("prepared file: files not configured")
+	}
+	unlock := f.s.store.LockMigration()
+	defer unlock()
+	journal, err := f.s.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	e, err := journal.LoadFile(ctx, input.IntentID)
+	if err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	if input.Contract != migrationintent.Contract || input.StoreID != e.Binding.StoreID || input.PlanID != e.Binding.PlanID || input.PlanSHA256 != e.Binding.PlanSHA256 || input.Fingerprint != e.Fingerprint {
+		return space.MigrationFileReceipt{}, migrationintent.ErrCollision
+	}
+	previousStage, previousOutcome, err := f.s.store.MigrationFileState(ctx, e, false)
+	if err != nil {
+		return fullFileReceipt(e, previousStage, previousOutcome), err
+	}
+	// A deleted/modified original row stays terminal even if its old bytes
+	// have been purged. Reconciliation must never recreate those bytes/rows.
+	if previousOutcome != "prepared" && previousOutcome != "committed" {
+		return fullFileReceipt(e, previousStage, previousOutcome), nil
+	}
+	if err = journal.EnsureDurable(ctx); err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	if err = files.VerifyMigrationFile(ctx, f.s.id, e.Staged); err != nil {
+		return space.MigrationFileReceipt{}, err
+	}
+	stage, outcome, err := f.s.store.MigrationFileState(ctx, e, true)
+	if err != nil {
+		return fullFileReceipt(e, stage, outcome), err
+	}
+	if outcome == "committed" {
+		err = f.s.store.AdoptMigrationFile(ctx, e, func() error {
+			return files.AdoptMigrationFile(ctx, f.s.id, e.OwnerObjectID, e.RecordIDs[0], e.Staged)
+		})
+		if err != nil {
+			return fullFileReceipt(e, stage, outcome), err
+		}
+	}
+	return f.preparedFileResult(ctx, e, stage, outcome)
+}
diff --git a/internal/spaceimpl/migration_inline_file.go b/internal/spaceimpl/migration_inline_file.go
new file mode 100644
index 0000000..35eb1a0
--- /dev/null
+++ b/internal/spaceimpl/migration_inline_file.go
@@ -0,0 +1,111 @@
+package spaceimpl
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+var _ space.PreparedInlineFileService = (*filesAPI)(nil)
+
+func inlineFileReceipt(e *migrationintent.InlineFile, stage, outcome string) space.MigrationInlineFileReceipt {
+	return space.MigrationInlineFileReceipt{MigrationReceipt: receipt(&e.Prepared, stage, outcome), OwnerObjectID: e.OwnerObjectID, FileID: e.RecordIDs[0], ContentSHA256: e.ContentSHA256, Size: e.Size}
+}
+
+func (f *filesAPI) PrepareMigrationInlineFile(ctx context.Context, input space.MigrationInput, requested space.MigrationInlineFileSpec) (space.MigrationInlineFileReceipt, error) {
+	// Size/hash/schema bounds precede native ledger open and DAG preparation.
+	spec := migrationintent.InlineFileSpec{OwnerObjectID: requested.OwnerObjectID, Name: requested.Name, Mime: requested.Mime, Content: slices.Clone(requested.Content), ContentSHA256: requested.ContentSHA256}
+	if err := spec.Validate(); err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	if input.Contract != migrationintent.Contract || input.SpecSHA256 != migrationintent.Digest(input.SourceSpec) {
+		return space.MigrationInlineFileReceipt{}, migrationintent.ErrScope
+	}
+	unlock := f.s.store.LockMigration()
+	defer unlock()
+	journal, err := f.s.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	id := journal.Identity()
+	binding := migrationintent.Binding{StoreID: input.StoreID, AccountID: id.AccountID, SpaceID: id.SpaceID, PlanID: input.PlanID, PlanSHA256: input.PlanSHA256, IntentID: input.IntentID, SourceKey: input.SourceKey}
+	nativeSpec, err := json.Marshal(spec)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	fp, err := journal.InlineFileFingerprint(binding, nativeSpec, input.SourceSpec)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	if old, err := journal.LoadInlineFile(ctx, input.IntentID); err == nil {
+		if old.Binding != binding || old.Fingerprint != fp {
+			return space.MigrationInlineFileReceipt{}, migrationintent.ErrCollision
+		}
+		stage, outcome, err := f.s.store.MigrationInlineFileState(ctx, old, false)
+		return inlineFileReceipt(old, stage, outcome), err
+	} else if !errors.Is(err, migrationintent.ErrNotFound) {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	e := &migrationintent.InlineFile{Prepared: migrationintent.Prepared{Binding: binding, Fingerprint: fp, Kind: migrationintent.InlineFileKind, Stage: "inline-file", Spec: nativeSpec, SourceSpec: slices.Clone(input.SourceSpec), SpecSHA256: input.SpecSHA256}}
+	e, err = f.s.store.PrepareMigrationInlineFile(ctx, journal, e, spec)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	stage, outcome, err := f.s.store.MigrationInlineFileState(ctx, e, false)
+	return inlineFileReceipt(e, stage, outcome), err
+}
+
+func (f *filesAPI) MigrationInlineFileStatus(ctx context.Context, intentID string) (space.MigrationInlineFileReceipt, error) {
+	unlock := f.s.store.LockMigration()
+	defer unlock()
+	journal, err := f.s.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	e, err := journal.LoadInlineFile(ctx, intentID)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	stage, outcome, err := f.s.store.MigrationInlineFileState(ctx, e, false)
+	return inlineFileReceipt(e, stage, outcome), err
+}
+
+func (f *filesAPI) CommitMigrationInlineFile(ctx context.Context, input space.MigrationCommit) (space.MigrationInlineFileReceipt, error) {
+	unlock := f.s.store.LockMigration()
+	var publication *space.FileStatus
+	defer func() {
+		unlock()
+		// Reentrant status readers must observe the committed row without the migration lock.
+		if publication != nil {
+			f.s.parent.fileStatusSubs.dispatch(f.s.id, *publication)
+		}
+	}()
+	journal, err := f.s.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	e, err := journal.LoadInlineFile(ctx, input.IntentID)
+	if err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	if input.Contract != migrationintent.Contract || input.StoreID != e.Binding.StoreID || input.PlanID != e.Binding.PlanID || input.PlanSHA256 != e.Binding.PlanSHA256 || input.Fingerprint != e.Fingerprint {
+		return space.MigrationInlineFileReceipt{}, migrationintent.ErrCollision
+	}
+	if err = journal.EnsureDurable(ctx); err != nil {
+		return space.MigrationInlineFileReceipt{}, err
+	}
+	previousStage, previousOutcome, err := f.s.store.MigrationInlineFileState(ctx, e, false)
+	if err != nil {
+		return inlineFileReceipt(e, previousStage, previousOutcome), err
+	}
+	stage, outcome, err := f.s.store.MigrationInlineFileState(ctx, e, true)
+	if err == nil && previousStage != "complete" && stage == "complete" && outcome == "committed" {
+		publication = &space.FileStatus{FileId: e.RecordIDs[0], ObjectId: e.OwnerObjectID,
+			State: space.FileStateDurable, Cached: true}
+	}
+	return inlineFileReceipt(e, stage, outcome), err
+}
diff --git a/internal/spaceimpl/migration_prepared.go b/internal/spaceimpl/migration_prepared.go
new file mode 100644
index 0000000..7a8ae9a
--- /dev/null
+++ b/internal/spaceimpl/migration_prepared.go
@@ -0,0 +1,326 @@
+package spaceimpl
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"slices"
+
+	"github.com/anyproto/any-sync-sdk/internal/commitguard"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"github.com/anyproto/any-sync-sdk/internal/properties"
+	"github.com/anyproto/any-sync-sdk/space"
+)
+
+var _ space.PreparedMigrationService = (*objectService)(nil)
+
+func decodeMigrationSpec(raw []byte, target any) error {
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	return decoder.Decode(target)
+}
+
+func (o *objectService) MigrationCapabilities(ctx context.Context) (space.MigrationCapabilities, error) {
+	journal, err := o.parent.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationCapabilities{}, err
+	}
+	id := journal.Identity()
+	return space.MigrationCapabilities{Contract: migrationintent.Contract, StoreID: id.StoreID, AccountID: id.AccountID, SpaceID: id.SpaceID, Object: 1, EditorBlock: 1, File: 0, NetworkVerified: false}, nil
+}
+
+func prepareEntry(journal *migrationintent.Store, input space.MigrationInput, kind, stage string, nativeSpec any) (*migrationintent.Prepared, error) {
+	if input.Contract != migrationintent.Contract || input.SpecSHA256 != migrationintent.Digest(input.SourceSpec) {
+		return nil, migrationintent.ErrScope
+	}
+	identity := journal.Identity()
+	binding := migrationintent.Binding{StoreID: input.StoreID, AccountID: identity.AccountID, SpaceID: identity.SpaceID, PlanID: input.PlanID, PlanSHA256: input.PlanSHA256, IntentID: input.IntentID, SourceKey: input.SourceKey}
+	encoded, err := json.Marshal(nativeSpec)
+	if err != nil {
+		return nil, err
+	}
+	fingerprint, err := journal.Fingerprint(binding, kind, encoded, input.SourceSpec)
+	if err != nil {
+		return nil, err
+	}
+	return &migrationintent.Prepared{Binding: binding, Fingerprint: fingerprint, Kind: kind, Stage: stage, Spec: encoded, SourceSpec: slices.Clone(input.SourceSpec), SpecSHA256: input.SpecSHA256}, nil
+}
+
+func receipt(entry *migrationintent.Prepared, stage, outcome string) space.MigrationReceipt {
+	b := entry.Binding
+	return space.MigrationReceipt{Contract: migrationintent.Contract, IntentID: b.IntentID, StoreID: b.StoreID, AccountID: b.AccountID, SpaceID: b.SpaceID, PlanID: b.PlanID, PlanSHA256: b.PlanSHA256, SourceKey: b.SourceKey, Kind: entry.Kind, Fingerprint: entry.Fingerprint, SpecSHA256: entry.SpecSHA256, Stage: stage, Outcome: outcome, ObjectID: entry.ObjectID, ChangeID: entry.ChangeID, RecordIDs: append([]string{}, entry.RecordIDs...)}
+}
+
+func (o *objectService) PrepareMigrationObject(ctx context.Context, input space.MigrationInput, opts space.CreateObjectOpts) (space.MigrationReceipt, error) {
+	unlock := o.parent.store.LockMigration()
+	defer unlock()
+	if opts.From != "" || opts.Type == "" || properties.IsMetaType(opts.Type) {
+		return space.MigrationReceipt{}, crdt.ErrValidation
+	}
+	journal, err := o.parent.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	entry, err := prepareEntry(journal, input, "object", "root", opts)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	err = o.parent.store.WithMigrationDefinitions(ctx, opts.Type, opts.Collections, uniqueOwners(opts), nil, func(heads map[string][]string) error {
+		entry.Dependencies = heads
+		var err error
+		entry, err = o.parent.store.PrepareMigrationRoot(ctx, journal, entry)
+		return err
+	})
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	return o.migrationStatus(ctx, journal, entry)
+}
+
+func validMigrationBlock(batch space.ModifyBatch) bool {
+	return batch.ObjectId != "" && batch.Dataset == "editor_blocks" && len(batch.Records) == 1 && batch.Records[0].Id == "" &&
+		batch.Records[0].Upsert && len(batch.Records[0].Ops) == 1 && batch.Records[0].Ops[0].Type == space.OpSet && batch.Records[0].Ops[0].Path == "" &&
+		len(batch.TraceIds) == 0 && batch.Scope == 0 && batch.IfUnchangedSince == nil && batch.IfObjectUnchangedSince == nil && !batch.RequireCurrentWriterFence
+}
+
+func (o *objectService) blockChange(ctx context.Context, batch space.ModifyBatch) (crdt.Change, error) {
+	if !validMigrationBlock(batch) {
+		return crdt.Change{}, crdt.ErrValidation
+	}
+	if err := checkRecordShapes(batch.Records); err != nil {
+		return crdt.Change{}, err
+	}
+	if err := o.parent.checkDatasetMembership(ctx, batch.ObjectId, batch.Dataset); err != nil {
+		return crdt.Change{}, err
+	}
+	version, err := o.parent.store.DataVersionFor(ctx, batch.Dataset)
+	if err != nil {
+		return crdt.Change{}, err
+	}
+	change, err := buildChange(batch, version)
+	if err != nil {
+		return crdt.Change{}, err
+	}
+	change.NativeObjectPolicy = true
+	return change, nil
+}
+
+func (o *objectService) PrepareMigrationBlock(ctx context.Context, input space.MigrationInput, batch space.ModifyBatch) (space.MigrationReceipt, error) {
+	unlock := o.parent.store.LockMigration()
+	defer unlock()
+	journal, err := o.parent.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	entry, err := prepareEntry(journal, input, "editorBlock", "block", batch)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	if old, readErr := journal.Load(ctx, input.IntentID, "block"); readErr == nil {
+		if old.Binding != entry.Binding || old.Fingerprint != entry.Fingerprint {
+			return space.MigrationReceipt{}, migrationintent.ErrCollision
+		}
+		return o.migrationStatus(ctx, journal, old)
+	} else if !errors.Is(readErr, migrationintent.ErrNotFound) {
+		return space.MigrationReceipt{}, readErr
+	}
+	change, err := o.blockChange(ctx, batch)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	o.parent.store.EnsureDatasetRegistered(ctx, batch.ObjectId, batch.Dataset)
+	obj, err := o.parent.store.Get(ctx, batch.ObjectId)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	entry, err = obj.PrepareMigration(ctx, change, entry, journal)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	return receipt(entry, "block-prepared", "prepared"), nil
+}
+
+func loadMigration(ctx context.Context, journal *migrationintent.Store, intentID string) (*migrationintent.Prepared, error) {
+	entry, err := journal.Load(ctx, intentID, "root")
+	if errors.Is(err, migrationintent.ErrNotFound) {
+		return journal.Load(ctx, intentID, "block")
+	}
+	return entry, err
+}
+
+func (o *objectService) MigrationStatus(ctx context.Context, intentID string) (space.MigrationReceipt, error) {
+	unlock := o.parent.store.LockMigration()
+	defer unlock()
+	journal, err := o.parent.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	entry, err := loadMigration(ctx, journal, intentID)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	return o.migrationStatus(ctx, journal, entry)
+}
+
+func (o *objectService) migrationStatus(ctx context.Context, journal *migrationintent.Store, entry *migrationintent.Prepared) (space.MigrationReceipt, error) {
+	stage := "block-prepared"
+	if entry.Kind == "object" {
+		state, err := o.parent.store.MigrationRootState(ctx, entry)
+		if err != nil {
+			return space.MigrationReceipt{}, err
+		}
+		if state == "obsolete" {
+			return receipt(entry, "root-prepared", "obsolete"), nil
+		}
+		if state == "prepared" {
+			if err := o.migrationRootDefinitionsCurrent(ctx, entry); err != nil {
+				if errors.Is(err, migrationintent.ErrObsolete) {
+					return receipt(entry, "root-prepared", "obsolete"), nil
+				}
+				return space.MigrationReceipt{}, err
+			}
+			return receipt(entry, "root-prepared", "prepared"), nil
+		}
+		if state == "deleted" {
+			return receipt(entry, "root-prepared", "obsolete"), nil
+		}
+		bootstrap, err := journal.Load(ctx, entry.Binding.IntentID, "bootstrap")
+		if errors.Is(err, migrationintent.ErrNotFound) {
+			if err := o.migrationRootDefinitionsCurrent(ctx, entry); err != nil {
+				if errors.Is(err, migrationintent.ErrObsolete) {
+					return receipt(entry, "root-committed", "obsolete"), nil
+				}
+				return space.MigrationReceipt{}, err
+			}
+			return receipt(entry, "root-committed", "prepared"), nil
+		}
+		if err != nil {
+			return space.MigrationReceipt{}, err
+		}
+		entry, stage = bootstrap, "bootstrap-prepared"
+	}
+	head, err := o.parent.store.TreeEntry(ctx, entry.ObjectID)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	if head.Deleted {
+		return receipt(entry, stage, "obsolete"), nil
+	}
+	obj, err := o.parent.store.Get(ctx, entry.ObjectID)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	_, outcome, err := obj.MigrationStatus(ctx, entry)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	if outcome == "committed" || outcome == "committed_deleted" || outcome == "committed_modified" {
+		stage = "complete"
+	}
+	return receipt(entry, stage, outcome), nil
+}
+
+func (o *objectService) migrationRootDefinitionsCurrent(ctx context.Context, entry *migrationintent.Prepared) error {
+	var opts space.CreateObjectOpts
+	if err := decodeMigrationSpec(entry.Spec, &opts); err != nil {
+		return migrationintent.ErrCorrupt
+	}
+	return o.parent.store.WithMigrationDefinitions(ctx, opts.Type, opts.Collections, uniqueOwners(opts), entry.Dependencies, func(map[string][]string) error { return nil })
+}
+
+func (o *objectService) CommitMigration(ctx context.Context, input space.MigrationCommit) (space.MigrationReceipt, error) {
+	unlock := o.parent.store.LockMigration()
+	defer unlock()
+	journal, err := o.parent.store.MigrationJournal(ctx)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	entry, err := loadMigration(ctx, journal, input.IntentID)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	if input.Contract != migrationintent.Contract || input.StoreID != entry.Binding.StoreID || input.PlanID != entry.Binding.PlanID || input.PlanSHA256 != entry.Binding.PlanSHA256 || input.Fingerprint != entry.Fingerprint {
+		return space.MigrationReceipt{}, migrationintent.ErrCollision
+	}
+	status, err := o.migrationStatus(ctx, journal, entry)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	if status.Outcome != "prepared" {
+		return status, nil
+	}
+	if err := journal.EnsureDurable(ctx); err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	var change crdt.Change
+	if entry.Kind == "object" {
+		var opts space.CreateObjectOpts
+		if err := decodeMigrationSpec(entry.Spec, &opts); err != nil {
+			return space.MigrationReceipt{}, migrationintent.ErrCorrupt
+		}
+		if status.Stage == "root-prepared" {
+			err := o.parent.store.WithMigrationDefinitions(ctx, opts.Type, opts.Collections, uniqueOwners(opts), entry.Dependencies, func(map[string][]string) error { return o.parent.store.CommitMigrationRoot(ctx, entry) })
+			if errors.Is(err, migrationintent.ErrObsolete) || errors.Is(err, commitguard.ErrNativeACLChanged) {
+				return receipt(entry, "root-prepared", "obsolete"), nil
+			}
+			if err != nil {
+				return space.MigrationReceipt{}, err
+			}
+			// One native durable stage per call. A lost reply is reconciled
+			// from the same signed root before bootstrap is even prepared.
+			return receipt(entry, "root-committed", "prepared"), nil
+		}
+		change, err = o.bootstrapChange(ctx, entry.ObjectID, opts, true)
+		if err != nil {
+			return space.MigrationReceipt{}, err
+		}
+		obj, err := o.parent.store.Get(ctx, entry.ObjectID)
+		if err != nil {
+			return space.MigrationReceipt{}, err
+		}
+		bootstrap, err := journal.Load(ctx, entry.Binding.IntentID, "bootstrap")
+		if errors.Is(err, migrationintent.ErrNotFound) && status.Stage == "root-committed" {
+			copy := *entry
+			copy.Stage, copy.ChangeID, copy.Raw = "bootstrap", "", nil
+			bootstrap, err = obj.PrepareMigration(ctx, change, &copy, journal)
+			if err != nil {
+				return space.MigrationReceipt{}, err
+			}
+			return receipt(bootstrap, "bootstrap-prepared", "prepared"), nil
+		}
+		if err != nil {
+			return space.MigrationReceipt{}, err
+		}
+		if status.Stage != "bootstrap-prepared" {
+			return space.MigrationReceipt{}, migrationintent.ErrCorrupt
+		}
+		entry = bootstrap
+	} else {
+		var batch space.ModifyBatch
+		if err := decodeMigrationSpec(entry.Spec, &batch); err != nil {
+			return space.MigrationReceipt{}, migrationintent.ErrCorrupt
+		}
+		change, err = o.blockChange(ctx, batch)
+		if err != nil {
+			return space.MigrationReceipt{}, err
+		}
+	}
+	obj, err := o.parent.store.Get(ctx, entry.ObjectID)
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	_, outcome, err := obj.CommitMigration(ctx, change, entry)
+	if errors.Is(err, migrationintent.ErrObsolete) || outcome == "obsolete" {
+		stage := "block-prepared"
+		if entry.Kind == "object" {
+			stage = "bootstrap-prepared"
+		}
+		return receipt(entry, stage, "obsolete"), nil
+	}
+	if err != nil {
+		return space.MigrationReceipt{}, err
+	}
+	return receipt(entry, "complete", outcome), nil
+}
diff --git a/internal/spaceimpl/migration_prepared_test.go b/internal/spaceimpl/migration_prepared_test.go
