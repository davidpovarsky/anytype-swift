+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	anystore "github.com/anyproto/any-store/v2"
+)
+
+func openTestStore(t *testing.T, path string) (anystore.DB, *Store) {
+	t.Helper()
+	db, err := anystore.Open(context.Background(), path, &anystore.Config{Durability: anystore.DurabilityConfig{Sentinel: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := Open(context.Background(), db, "native-account", "native-space")
+	if err != nil {
+		db.Close()
+		t.Fatal(err)
+	}
+	return db, s
+}
+
+func entryFor(t *testing.T, s *Store, raw string) *Prepared {
+	t.Helper()
+	b := Binding{StoreID: s.Identity().StoreID, AccountID: "native-account", SpaceID: "native-space", PlanID: strings.Repeat("a", 64), PlanSHA256: strings.Repeat("b", 64), IntentID: strings.Repeat("c", 64), SourceKey: "source/object/one"}
+	spec, source := []byte(`{"type":"page"}`), []byte(`{"type":"page"}`)
+	fp, err := s.Fingerprint(b, "object", spec, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &Prepared{Binding: b, Fingerprint: fp, Kind: "object", Stage: "root", ObjectID: "known-root", ChangeID: "known-root", Raw: []byte(raw), Spec: spec, SourceSpec: source, SpecSHA256: Digest(source)}
+}
+
+func TestPreparedIntentExactBytesSurviveLostAckAndRestart(t *testing.T) {
+	ctx := context.Background()
+	path := filepath.Join(t.TempDir(), "projection.db")
+	db, s := openTestStore(t, path)
+	entry := entryFor(t, s, "first signed native envelope")
+	first, err := s.Reserve(ctx, entry)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Drop the reply. The next process has only the logical intent identity.
+	if err = db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	db, reopened := openTestStore(t, path)
+	defer db.Close()
+	if reopened.Identity() != s.Identity() {
+		t.Fatal("store generation changed on restart")
+	}
+	retry := entryFor(t, reopened, "a different newly signed envelope must never win")
+	got, err := reopened.Reserve(ctx, retry)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got.Raw, first.Raw) || got.ChangeID != first.ChangeID || got.Fingerprint != first.Fingerprint {
+		t.Fatal("retry replaced preparation")
+	}
+}
+
+func TestPreparedIntentConcurrentReservationSelectsOneEnvelope(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+	defer db.Close()
+	const count = 12
+	results := make(chan *Prepared, count)
+	errorsCh := make(chan error, count)
+	var wg sync.WaitGroup
+	for i := 0; i < count; i++ {
+		proposed := entryFor(t, s, string(rune('a'+i)))
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			got, err := s.Reserve(context.Background(), proposed)
+			results <- got
+			errorsCh <- err
+		}()
+	}
+	wg.Wait()
+	close(results)
+	close(errorsCh)
+	for err := range errorsCh {
+		if err != nil && !errors.Is(err, anystore.ErrBusy) {
+			t.Fatal(err)
+		}
+	}
+	var first []byte
+	for got := range results {
+		if got == nil {
+			continue
+		}
+		if first == nil {
+			first = got.Raw
+		}
+		if !bytes.Equal(first, got.Raw) {
+			t.Fatal("multiple envelopes won")
+		}
+	}
+	// A concurrent full checkpoint may return busy and must admit no append.
+	// Once contenders release their DB reads, retry selects the same durable
+	// envelope. Database uniqueness, rather than a host mutex, picks the winner.
+	got, err := s.Reserve(context.Background(), entryFor(t, s, "last retry must not replace winner"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first != nil && !bytes.Equal(first, got.Raw) {
+		t.Fatal("post-contention retry changed selected envelope")
+	}
+}
+
+func TestPreparedIntentRejectsChangedPlanBeforeNewEntity(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+	defer db.Close()
+	original := entryFor(t, s, "first")
+	if _, err := s.Reserve(context.Background(), original); err != nil {
+		t.Fatal(err)
+	}
+	changed := entryFor(t, s, "second")
+	changed.Binding.PlanSHA256 = strings.Repeat("d", 64)
+	changed.Binding.IntentID = strings.Repeat("e", 64)
+	changed.Fingerprint, _ = s.Fingerprint(changed.Binding, changed.Kind, changed.Spec, changed.SourceSpec)
+	if _, err := s.Reserve(context.Background(), changed); !errors.Is(err, ErrCollision) {
+		t.Fatalf("changed plan: %v", err)
+	}
+	if _, err := s.Load(context.Background(), changed.Binding.IntentID, "root"); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("new entity was reserved: %v", err)
+	}
+}
+
+func TestPreparedIntentRejectsChangedSpecOrCrossKind(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+	defer db.Close()
+	original := entryFor(t, s, "first")
+	if _, err := s.Reserve(context.Background(), original); err != nil {
+		t.Fatal(err)
+	}
+	for _, kind := range []string{"object", "editorBlock"} {
+		changed := entryFor(t, s, "replacement")
+		changed.Kind = kind
+		if kind == "editorBlock" {
+			changed.Stage = "block"
+		}
+		changed.Spec = []byte(`{"type":"changed"}`)
+		changed.Fingerprint, _ = s.Fingerprint(changed.Binding, changed.Kind, changed.Spec, changed.SourceSpec)
+		if _, err := s.Reserve(context.Background(), changed); !errors.Is(err, ErrCollision) {
+			t.Fatalf("%s collision: %v", kind, err)
+		}
+	}
+}
+
+func TestPreparedIntentEntityCannotAcquireAnAlternateIntentID(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "projection.db"))
+	defer db.Close()
+	ctx := context.Background()
+	original := entryFor(t, s, "selected signed root")
+	if _, err := s.Reserve(ctx, original); err != nil {
+		t.Fatal(err)
+	}
+	alternate := entryFor(t, s, "must never allocate another entity")
+	alternate.Binding.IntentID = strings.Repeat("e", 64)
+	alternate.Fingerprint, _ = s.Fingerprint(alternate.Binding, alternate.Kind, alternate.Spec, alternate.SourceSpec)
+	if _, err := s.Reserve(ctx, alternate); !errors.Is(err, ErrCollision) {
+		t.Fatalf("alternate intent: %v", err)
+	}
+	if _, err := s.Load(ctx, alternate.Binding.IntentID, "root"); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("alternate native identity exists: %v", err)
+	}
+	// Refused metadata was rolled back with the entire private transaction;
+	// the caller's unused alternate ID can safely name a different entity.
+	alternate.Binding.SourceKey = "source/object/two"
+	alternate.Fingerprint, _ = s.Fingerprint(alternate.Binding, alternate.Kind, alternate.Spec, alternate.SourceSpec)
+	if _, err := s.Reserve(ctx, alternate); err != nil {
+		t.Fatalf("failed attempt poisoned unrelated entity: %v", err)
+	}
+}
+
+func TestPreparedIntentRejectsWrongOrReplacedStore(t *testing.T) {
+	db, s := openTestStore(t, filepath.Join(t.TempDir(), "one.db"))
+	defer db.Close()
+	db2, replacement := openTestStore(t, filepath.Join(t.TempDir(), "replacement.db"))
