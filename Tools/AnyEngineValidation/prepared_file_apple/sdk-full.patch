+package spaceimpl
+
+import (
+	"context"
+	"testing"
+
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCurrentWriterFenceRequiresConditionalSyncedRoute(t *testing.T) {
+	seq := uint64(7)
+	valid := func() space.ModifyBatch {
+		return space.ModifyBatch{ObjectId: "page", Dataset: "editor_blocks", Records: []space.RecordModify{{Id: "block", Ops: []space.Op{{Type: space.OpSet, Path: "text", Value: "x"}}}}, IfUnchangedSince: &seq, RequireCurrentWriterFence: true}
+	}
+	require.NoError(t, checkCurrentWriterBatch(valid()))
+	for _, mode := range []string{"no condition", "local", "objects", "two conditions", "empty batch"} {
+		t.Run(mode, func(t *testing.T) {
+			batch := valid()
+			switch mode {
+			case "no condition":
+				batch.IfUnchangedSince = nil
+			case "local":
+				batch.Scope = space.ScopeLocal
+			case "objects":
+				batch.Dataset = "objects"
+			case "two conditions":
+				batch.IfObjectUnchangedSince = &seq
+			case "empty batch":
+				batch.Records = nil
+			}
+			_, err := (&spaceImpl{}).Modify(context.Background(), batch)
+			require.ErrorIs(t, err, crdt.ErrValidation)
+		})
+	}
+	_, err := (&spaceImpl{}).ModifyMany(context.Background(), []space.ModifyBatch{valid()})
+	require.ErrorIs(t, err, crdt.ErrValidation)
+}
