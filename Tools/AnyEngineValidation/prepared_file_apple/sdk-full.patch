index 0000000..2e2e5d2
--- /dev/null
+++ b/internal/spaceimpl/migration_prepared_test.go
@@ -0,0 +1,18 @@
+package spaceimpl
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPreparedMigrationKeepsNumberTokensForSpecRecovery(t *testing.T) {
+	var options space.CreateObjectOpts
+	require.NoError(t, decodeMigrationSpec([]byte(`{"Type":"page","InitialProperties":{"any":{"counter":9007199254740992}}}`), &options))
+	require.Equal(t, json.Number("9007199254740992"), options.InitialProperties["any"]["counter"])
+	encoded, err := json.Marshal(options)
+	require.NoError(t, err)
+	require.Contains(t, string(encoded), `"counter":9007199254740992`)
+}
diff --git a/internal/spaceimpl/object_conditional_test.go b/internal/spaceimpl/object_conditional_test.go
new file mode 100644
index 0000000..59321d2
--- /dev/null
+++ b/internal/spaceimpl/object_conditional_test.go
@@ -0,0 +1,42 @@
+package spaceimpl
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestObjectConditionalModifyShapeGuards(t *testing.T) {
+	seq := uint64(7)
+	valid := func() space.ModifyBatch {
+		return space.ModifyBatch{ObjectId: "target", Dataset: "objects", Records: []space.RecordModify{{Id: "target", Ops: []space.Op{{Type: space.OpSet, Path: "any.name", Value: "x"}}}}, IfObjectUnchangedSince: &seq}
+	}
+	require.NoError(t, checkObjectConditionalBatch(valid()))
+	for _, mode := range []string{"local", "other dataset", "foreign row", "empty id", "upsert", "two records", "two conditions"} {
+		t.Run(mode, func(t *testing.T) {
+			b := valid()
+			switch mode {
+			case "local":
+				b.Scope = space.ScopeLocal
+			case "other dataset":
+				b.Dataset = "blocks"
+			case "foreign row":
+				b.Records[0].Id = "other"
+			case "empty id":
+				b.Records[0].Id = ""
+			case "upsert":
+				b.Records[0].Upsert = true
+			case "two records":
+				b.Records = append(b.Records, b.Records[0])
+			case "two conditions":
+				b.IfUnchangedSince = &seq
+			}
+			_, err := (&spaceImpl{}).Modify(context.Background(), b)
+			require.ErrorIs(t, err, crdt.ErrValidation)
+		})
+	}
+	_, err := (&spaceImpl{}).ModifyMany(context.Background(), []space.ModifyBatch{valid()})
+	require.ErrorIs(t, err, crdt.ErrValidation)
+}
diff --git a/internal/spaceimpl/object_create_current_writer.go b/internal/spaceimpl/object_create_current_writer.go
new file mode 100644
index 0000000..189aef4
--- /dev/null
+++ b/internal/spaceimpl/object_create_current_writer.go
@@ -0,0 +1,57 @@
+package spaceimpl
+
+import (
+	"context"
+	"fmt"
