@@ -0,0 +1,159 @@
+package commitguard
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"slices"
+
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/commonspace/spacestorage"
+	"github.com/anyproto/any-sync/util/crypto"
+)
+
+func CheckPreparedRoot(ctx context.Context, storage spacestorage.SpaceStorage, acl list.AclList, author crypto.PubKey, raw *treechangeproto.RawTreeChangeWithId) error {
+	if ctx == nil || storage == nil || acl == nil || author == nil || raw == nil {
+		return ErrNativeCommitGuard
+	}
+	root, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), raw).Unmarshall(raw, true)
+	if err != nil {
+		return err
+	}
+	envelope := &treechangeproto.RawTreeChange{}
+	if envelope.UnmarshalVT(raw.RawChange) != nil {
+		return ErrNativeCommitGuard
+	}
+	info := &treechangeproto.RootChange{}
+	if info.UnmarshalVT(envelope.Payload) != nil || info.SpaceId != storage.Id() || info.IsDerived || info.ParentId != "" || info.ChangeType != "object" || root.Identity == nil || !root.Identity.Equals(author) {
+		return ErrNativeCommitGuard
+	}
+	acl.RLock()
+	defer acl.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !acl.AclState().Permissions(author).CanWrite() {
+		return list.ErrInsufficientPermissions
+	}
+	if acl.Head() == nil || root.AclHeadId != acl.Head().Id {
+		return ErrNativeACLChanged
+	}
+	return nil
+}
+
+// PreparedContext is package-internal to the SDK, not an HTTP capability or a
+// marker a remote peer can supply. The caller must hold the native dependency
+// tree locks and must have durably reserved these exact bytes first.
+func PreparedContext(ctx context.Context, tree objecttree.ObjectTree, author crypto.PubKey, raw *treechangeproto.RawTreeChangeWithId) (context.Context, *Guard, error) {
+	appendCtx, guard, err := Context(ctx, tree, author)
+	if err != nil {
+		return nil, nil, err
+	}
+	if err := CheckCurrentWrite(ctx, tree, author); err != nil {
+		return nil, nil, err
+	}
+	if raw == nil || raw.Id == "" || len(raw.RawChange) == 0 {
+		return nil, nil, ErrNativeCommitGuard
+	}
+	change, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), tree.Header()).Unmarshall(raw, true)
+	if err != nil {
+		return nil, nil, err
+	}
+	if change.Identity == nil || !change.Identity.Equals(author) || change.IsSnapshot || change.IsDerived || change.ReadKeyId == "" ||
+		change.SnapshotId != tree.Header().Id || !sameHeads(change.PreviousIds, tree.Heads()) {
+		return nil, nil, ErrNativeCommitGuard
+	}
+	storage := guard.storage
+	storage.acl.RLock()
+	current := storage.acl.Head()
+	currentEnvelope := current != nil && change.AclHeadId == current.Id && change.ReadKeyId == storage.acl.AclState().CurrentReadKeyId()
+	storage.acl.RUnlock()
+	if !currentEnvelope {
+		return nil, nil, ErrNativeACLChanged
+	}
+	if err := CheckCurrentWrite(ctx, tree, author); err != nil {
+		return nil, nil, err
+	}
+	guard.preparedRaw = &treechangeproto.RawTreeChangeWithId{Id: raw.Id, RawChange: bytes.Clone(raw.RawChange)}
+	return appendCtx, guard, nil
+}
+
+func sameHeads(a, b []string) bool {
+	a, b = slices.Clone(a), slices.Clone(b)
+	slices.Sort(a)
+	slices.Sort(b)
+	return slices.Equal(a, b)
+}
+
+// CheckPreparedPayload binds a valid signed envelope to the exact operation
+// admitted by the SDK. CID/signature validity alone would also accept another
+// signed operation from the same heads. Use the native tree key derivation;
+// there is no caller plaintext, key, author or decryption policy override.
+// Current authority is required even while verifying already-committed bytes.
+func CheckPreparedPayload(ctx context.Context, tree objecttree.ObjectTree, author crypto.PubKey, raw *treechangeproto.RawTreeChangeWithId, expected []byte, dataset string, timestamp int64) error {
+	storage, err := boundNativeCommitStorage(tree)
+	if ctx == nil || err != nil || author == nil || raw == nil {
+		return ErrNativeCommitGuard
+	}
+	change, err := objecttree.NewChangeBuilder(crypto.NewKeyStorage(), tree.Header()).Unmarshall(raw, true)
+	if err != nil {
+		return err
+	}
+	if change.Identity == nil || !change.Identity.Equals(author) || change.IsDerived || change.IsSnapshot || change.ReadKeyId == "" || change.DataType != dataset || change.Timestamp != timestamp {
+		return ErrNativeCommitGuard
+	}
+	storage.acl.RLock()
+	defer storage.acl.RUnlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !storage.acl.AclState().Permissions(author).CanWrite() {
+		return list.ErrInsufficientPermissions
+	}
+	key, exists := storage.acl.AclState().Keys()[change.ReadKeyId]
+	if !exists || key.ReadKey == nil {
+		return list.ErrNoReadKey
+	}
+	keyBytes, err := key.ReadKey.Raw()
+	if err != nil {
+		return err
+	}
+	derived, err := crypto.NewKeyDeriver(fmt.Sprintf(crypto.AnysyncTreePath, tree.Id())).DeriveKey(keyBytes)
+	if err != nil {
+		return err
+	}
+	plain, err := derived.Decrypt(change.Data)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(plain, expected) {
+		return ErrNativeCommitGuard
+	}
+	return nil
+}
+
+// Track the actual production updater configuration on the wrapped native
+// tree. A prepared append refuses an unconfigured/test-double tree rather than
+// allowing a projection callback to observe bytes before storage commit.
+func (t *nativeCommitTree) SetDeferredUpdater(deferred bool) {
+	t.ObjectTree.SetDeferredUpdater(deferred)
+	t.deferred = deferred
+}
+
+func (t *nativeCommitTree) addPreparedRaw(ctx context.Context, payload objecttree.RawChangesPayload, updater objecttree.Updater) (objecttree.AddResult, error) {
+	guard := nativeGuard(ctx)
+	if guard == nil || guard.storage != t.storage || guard.preparedRaw == nil || guard.used || !t.deferred ||
+		len(payload.RawChanges) != 1 || payload.RawChanges[0] == nil || len(payload.NewHeads) != 1 || len(payload.SnapshotPath) != 0 ||
+		payload.NewHeads[0] != guard.preparedRaw.Id || payload.RawChanges[0].Id != guard.preparedRaw.Id ||
+		!bytes.Equal(payload.RawChanges[0].RawChange, guard.preparedRaw.RawChange) {
+		return objecttree.AddResult{}, ErrNativeCommitGuard
+	}
+	if err := ctx.Err(); err != nil {
+		return objecttree.AddResult{}, err
+	}
+	guard.used, guard.active = true, true
+	defer func() { guard.active = false }()
+	return t.ObjectTree.AddRawChangesWithUpdater(ctx, payload, updater)
+}
