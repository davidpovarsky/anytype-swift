+	"github.com/stretchr/testify/require"
+)
+
+func migrationFixtureEntry(t *testing.T, f *definitionFixture, source string) (*migrationintent.Store, *migrationintent.Prepared, crdt.Change) {
+	t.Helper()
+	journal, err := migrationintent.Open(context.Background(), f.store.db, f.target.Tree().Root().Identity.Account(), f.store.spaceId)
+	require.NoError(t, err)
+	binding := migrationintent.Binding{StoreID: journal.Identity().StoreID, AccountID: journal.Identity().AccountID, SpaceID: f.store.spaceId, PlanID: strings.Repeat("a", 64), PlanSHA256: strings.Repeat("b", 64), IntentID: migrationintent.Digest([]byte(source)), SourceKey: source}
+	spec := []byte(`{"type":"paragraph","text":"prepared migration","nav":{"parentId":"","pos":"m"}}`)
+	fingerprint, err := journal.Fingerprint(binding, "editorBlock", spec, spec)
+	require.NoError(t, err)
+	entry := &migrationintent.Prepared{Binding: binding, Fingerprint: fingerprint, Kind: "editorBlock", Stage: "block", Spec: spec, SourceSpec: spec, SpecSHA256: migrationintent.Digest(spec)}
+	change := crdt.Change{Dataset: "editor_blocks", DataVersion: "fixture-v1", NativeObjectPolicy: true,
+		Records: []crdt.RecordChange{{Id: "", Upsert: true, Ops: []crdt.Op{{Type: crdt.OpSet, Payload: anyenc.MustParseJson(string(spec))}}}}}
+	// Exercise the same helper used for EVERY production opened SyncTree.
+	deferIfSyncTree(f.target.Tree())
+	return journal, entry, change
+}
+
+type lostMigrationAckTree struct {
+	objecttree.ObjectTree
+	fail bool
+}
+
+func (t *lostMigrationAckTree) AddRawChanges(ctx context.Context, payload objecttree.RawChangesPayload) (objecttree.AddResult, error) {
+	result, err := t.ObjectTree.AddRawChanges(ctx, payload)
+	if err == nil && t.fail {
+		t.fail = false
+		return result, errors.New("injected response loss after native append")
+	}
+	return result, err
+}
+
+func TestPreparedMigrationRealBlockLostAckAndExactRetry(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	journal, proposed, change := migrationFixtureEntry(t, f, "source/block/one")
+	writes := 0
+	f.beforeStorage = func() { writes++ }
+	entry, err := f.target.PrepareMigration(ctx, change, proposed, journal)
+	require.NoError(t, err)
+	require.Zero(t, writes, "preparation must not append native history")
+	require.Len(t, entry.RecordIDs, 1)
+	has, err := f.target.Tree().Storage().Has(ctx, entry.ChangeID)
+	require.NoError(t, err)
+	require.False(t, has)
+	tracker := f.trackers[f.target.Id()]
+	tracker.ObjectTree = &lostMigrationAckTree{ObjectTree: tracker.ObjectTree, fail: true}
+	_, _, err = f.target.CommitMigration(ctx, change, entry)
+	require.ErrorContains(t, err, "response loss")
+	stored, err := f.target.Tree().Storage().Get(ctx, entry.ChangeID)
+	require.NoError(t, err)
+	require.True(t, bytes.Equal(stored.RawChange, entry.Raw))
+	beforeRetry := writes
+	// Reload only the durable native reservation; no response ID was retained.
+	recovered, err := journal.Load(ctx, entry.Binding.IntentID, "block")
+	require.NoError(t, err)
+	result, outcome, err := f.target.CommitMigration(ctx, change, recovered)
+	require.NoError(t, err)
+	require.Equal(t, "committed", outcome)
+	require.Equal(t, entry.ChangeID, result.ChangeId)
+	require.Equal(t, entry.RecordIDs, result.RecordIds)
+	require.Equal(t, beforeRetry, writes, "lost-ACK retry must append nothing")
+	row := f.target.Controller().Get(ctx, "editor_blocks", entry.RecordIDs[0])
+	require.Equal(t, "prepared migration", row.GetString("text"))
+}
+
+func TestPreparedMigrationConcurrentCommitUsesOneNativeChange(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	journal, proposed, change := migrationFixtureEntry(t, f, "source/block/concurrent")
+	entry, err := f.target.PrepareMigration(ctx, change, proposed, journal)
+	require.NoError(t, err)
+	writes := 0
+	f.beforeStorage = func() { writes++ }
+	var group sync.WaitGroup
+	errorsCh := make(chan error, 6)
+	outcomes := make(chan string, 6)
+	for range 6 {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			_, outcome, err := f.target.CommitMigration(ctx, change, entry)
+			errorsCh <- err
+			outcomes <- outcome
+		}()
+	}
+	group.Wait()
+	close(errorsCh)
+	close(outcomes)
+	for err := range errorsCh {
+		require.NoError(t, err)
+	}
+	for outcome := range outcomes {
+		require.Equal(t, "committed", outcome)
+	}
+	require.Equal(t, 2, writes, "observer fires before/after ONE real native AddAll")
+}
+
+func TestPreparedMigrationCommittedBlockMutationAndDeletionHalt(t *testing.T) {
+	for _, mode := range []string{"modified", "deleted"} {
+		t.Run(mode, func(t *testing.T) {
+			f := newDefinitionFixture(t)
+			ctx := context.Background()
+			journal, proposed, change := migrationFixtureEntry(t, f, "source/block/"+mode)
+			entry, err := f.target.PrepareMigration(ctx, change, proposed, journal)
+			require.NoError(t, err)
+			_, outcome, err := f.target.CommitMigration(ctx, change, entry)
+			require.NoError(t, err)
+			require.Equal(t, "committed", outcome)
+			op := crdt.Op{Type: crdt.OpSet, Path: []string{"text"}, Payload: anyenc.MustParseJson(`"edited after migration"`)}
+			if mode == "deleted" {
+				op = crdt.Op{Type: crdt.OpDelete}
+			}
+			_, err = f.target.LocalWriteCurrentWriter(ctx, crdt.Change{Dataset: "editor_blocks", DataVersion: "fixture-v1", NativeObjectPolicy: true, Records: []crdt.RecordChange{{Id: entry.RecordIDs[0], Ops: []crdt.Op{op}}}})
+			require.NoError(t, err)
+			before := append([]string(nil), f.target.Tree().Heads()...)
+			_, outcome, err = f.target.CommitMigration(ctx, change, entry)
+			require.NoError(t, err)
+			require.Equal(t, "committed_"+mode, outcome)
+			require.Equal(t, before, f.target.Tree().Heads(), "retry must not overwrite/resurrect")
+		})
+	}
+}
+
+func TestPreparedMigrationDefinitionAdvanceMakesEnvelopeObsolete(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	journal, proposed, change := migrationFixtureEntry(t, f, "source/block/schema")
+	entry, err := f.target.PrepareMigration(ctx, change, proposed, journal)
+	require.NoError(t, err)
+	_, err = f.owner.LocalWrite(ctx, crdt.Change{Dataset: "datasets", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: "canonical", Ops: []crdt.Op{{Type: crdt.OpSet, Path: []string{"shared"}, Payload: anyenc.MustParseJson(`false`)}}}}})
+	require.NoError(t, err)
+	_, outcome, err := f.target.MigrationStatus(ctx, entry)
+	require.NoError(t, err)
+	require.Equal(t, "obsolete", outcome)
+	_, outcome, err = f.target.CommitMigration(ctx, change, entry)
+	require.ErrorIs(t, err, migrationintent.ErrObsolete)
+	require.Equal(t, "obsolete", outcome)
+	has, err := f.target.Tree().Storage().Has(ctx, entry.ChangeID)
+	require.NoError(t, err)
+	require.False(t, has)
+}
+
+func TestPreparedMigrationRefusesAnotherValidSignedOperation(t *testing.T) {
+	f := newDefinitionFixture(t)
+	ctx := context.Background()
+	journal, proposed, change := migrationFixtureEntry(t, f, "source/block/intended")
+	first, err := f.target.PrepareMigration(ctx, change, proposed, journal)
+	require.NoError(t, err)
+	_, otherProposed, otherChange := migrationFixtureEntry(t, f, "source/block/other")
+	otherSpec := []byte(`{"type":"paragraph","text":"different signed operation","nav":{"parentId":"","pos":"m"}}`)
+	otherProposed.Spec, otherProposed.SourceSpec, otherProposed.SpecSHA256 = otherSpec, otherSpec, migrationintent.Digest(otherSpec)
+	otherProposed.Fingerprint, err = journal.Fingerprint(otherProposed.Binding, otherProposed.Kind, otherSpec, otherSpec)
+	require.NoError(t, err)
+	otherChange.Records[0].Ops[0].Payload = anyenc.MustParseJson(string(otherSpec))
+	other, err := f.target.PrepareMigration(ctx, otherChange, otherProposed, journal)
+	require.NoError(t, err)
+	// Both envelopes are genuinely signed by the current native writer from
+	// the same carrier heads. Substitution must fail before either is appended.
+	forged := *first
+	forged.ChangeID, forged.Raw, forged.RecordIDs = other.ChangeID, other.Raw, other.RecordIDs
+	writes := 0
+	f.beforeStorage = func() { writes++ }
+	_, _, err = f.target.CommitMigration(ctx, change, &forged)
+	require.ErrorIs(t, err, commitguard.ErrNativeCommitGuard)
+	require.Zero(t, writes)
+	for _, entry := range []*migrationintent.Prepared{first, other} {
+		has, err := f.target.Tree().Storage().Has(ctx, entry.ChangeID)
+		require.NoError(t, err)
+		require.False(t, has)
+	}
+}
diff --git a/internal/spaceobjects/native_conditional_noop_test.go b/internal/spaceobjects/native_conditional_noop_test.go
new file mode 100644
index 0000000..3d1b83c
--- /dev/null
+++ b/internal/spaceobjects/native_conditional_noop_test.go
@@ -0,0 +1,148 @@
+package spaceobjects
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/internal/properties"
+	"github.com/stretchr/testify/require"
+)
+
+func definitionNoop(f *definitionFixture, owner string) crdt.Change {
+	return crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", NativeObjectPolicy: true,
+		NativeConditionalNoop: true, NativeDefinitionOwners: []string{owner},
+		Records: []crdt.RecordChange{{Id: f.target.Id()}}}
+}
+func addNoopCollection(t *testing.T, f *definitionFixture, attach bool) *object.Object {
+	t.Helper()
+	c := f.makeObject("extra actual collection")
+	_, err := c.LocalWrite(context.Background(), crdt.Change{Dataset: "objects", DataVersion: "fixture-v1",
+		Records: []crdt.RecordChange{{Id: c.Id(), Upsert: true, Ops: []crdt.Op{{Type: crdt.OpSet,
+			Payload: anyenc.MustParseJson(fmt.Sprintf(`{"spaceId":%q,"any":{"type":"__collection__"}}`, f.store.spaceId))}}}}})
+	require.NoError(t, err)
+	if attach {
+		_, err = f.target.LocalWrite(context.Background(), crdt.Change{Dataset: "objects", DataVersion: "fixture-v1",
+			Records: []crdt.RecordChange{{Id: f.target.Id(), Ops: []crdt.Op{{Type: crdt.OpSet,
+				Payload: anyenc.MustParseJson(fmt.Sprintf(`{"any.collections":[%q]}`, c.Id()))}}}}})
+		require.NoError(t, err)
+	}
+	return c
+}
+
+func TestNativeConditionalPropertyNoopKeepsHistoryAndAllDefinitionLocks(t *testing.T) {
+	ctx := context.Background()
+	f := newDefinitionFixture(t)
+	collection := addNoopCollection(t, f, true)
+	row := f.target.Controller().Get(ctx, "objects", f.target.Id())
+	before := row.String()
+	seq := uint64(row.GetInt(crdt.ApplySeqField))
+	require.NotZero(t, seq)
+	heads := append([]string(nil), f.target.Tree().Heads()...)
+	storageWrites, callbacks := 0, 0
+	f.beforeStorage = func() { storageWrites++ }
+	ch := definitionNoop(f, collection.Id())
+	ch.NativeDefinitionValidation = func() error {
+		callbacks++
+		for _, tracker := range f.trackers {
+			require.EqualValues(t, 1, tracker.held.Load())
+		}
+		return nil
+	}
+	for range 2 {
+		result, err := f.target.LocalWriteIfObject(ctx, ch, seq)
+		require.NoError(t, err)
+		require.Empty(t, result.ChangeId)
+		require.Empty(t, result.VersionId)
+		require.Zero(t, result.ApplySeq)
+		require.Equal(t, []string{f.target.Id()}, result.RecordIds)
+		require.Equal(t, before, f.target.Controller().Get(ctx, "objects", f.target.Id()).String())
+		require.Equal(t, heads, f.target.Tree().Heads())
+	}
+	require.Equal(t, 2, callbacks)
+	require.Zero(t, storageWrites)
+	refused := errors.New("current locked descriptor refuses")
+	ch.NativeDefinitionValidation = func() error { return refused }
+	_, err := f.target.LocalWriteIfObject(ctx, ch, seq)
+	require.ErrorIs(t, err, refused)
+	require.Zero(t, storageWrites)
+	require.Equal(t, heads, f.target.Tree().Heads())
+	_, members, discover, err := nativeMembership(f.target.Controller().Get(ctx, "objects", f.target.Id()), &ch)
+	require.NoError(t, err)
+	require.True(t, discover)
+	require.Equal(t, []string{collection.Id()}, members)
+}
+
+func TestNativeConditionalPropertyNoopRejectsUnknownUnattachedAndRemovedDefinitions(t *testing.T) {
+	for _, mode := range []string{"unknown owner", "unattached owner", "removed collection", "retyped collection", "removed target", "removed type"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx := context.Background()
+			f := newDefinitionFixture(t)
+			collection := addNoopCollection(t, f, mode != "unattached owner")
+			row := f.target.Controller().Get(ctx, "objects", f.target.Id())
+			seq := uint64(row.GetInt(crdt.ApplySeqField))
+			owner := f.owner.Id()
+			switch mode {
+			case "unknown owner":
+				owner = "not-a-loaded-definition"
+			case "unattached owner":
+				owner = collection.Id()
+			case "removed collection":
+				collection.Tree().Lock()
+				err := collection.Tree().Delete()
+				collection.Tree().Unlock()
+				require.NoError(t, err)
+			case "retyped collection":
+				_, err := collection.LocalWrite(ctx, crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: collection.Id(), Ops: []crdt.Op{{Type: crdt.OpSet, Payload: anyenc.MustParseJson(fmt.Sprintf(`{"any.type":%q}`, f.owner.Id()))}}}}})
+				require.NoError(t, err)
+			case "removed target":
+				f.target.Tree().Lock()
+				err := f.target.Tree().Delete()
+				f.target.Tree().Unlock()
+				require.NoError(t, err)
+			case "removed type":
+				f.owner.Tree().Lock()
+				err := f.owner.Tree().Delete()
+				f.owner.Tree().Unlock()
+				require.NoError(t, err)
+			}
+			heads := append([]string(nil), f.target.Tree().Heads()...)
+			writes := 0
+			f.beforeStorage = func() { writes++ }
+			_, err := f.target.LocalWriteIfObject(ctx, definitionNoop(f, owner), seq)
+			require.Error(t, err)
+			if mode == "unattached owner" {
+				require.ErrorIs(t, err, properties.ErrWrongSlot)
+			}
+			require.Zero(t, writes)
+			require.Equal(t, heads, f.target.Tree().Heads())
+		})
+	}
+}
+
+func TestNativeConditionalPropertyNoopRejectsABAAndFutureSequence(t *testing.T) {
+	ctx := context.Background()
+	f := newDefinitionFixture(t)
+	_, err := f.target.LocalWrite(ctx, crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: f.target.Id(), Ops: []crdt.Op{{Type: crdt.OpSet, Payload: anyenc.MustParseJson(`{"any.name":"A"}`)}}}}})
+	require.NoError(t, err)
+	initial := uint64(f.target.Controller().Get(ctx, "objects", f.target.Id()).GetInt(crdt.ApplySeqField))
+	for _, name := range []string{"B", "A"} {
+		_, err := f.target.LocalWrite(ctx, crdt.Change{Dataset: "objects", DataVersion: "fixture-v1", Records: []crdt.RecordChange{{Id: f.target.Id(), Ops: []crdt.Op{{Type: crdt.OpSet, Payload: anyenc.MustParseJson(fmt.Sprintf(`{"any.name":%q}`, name))}}}}})
+		require.NoError(t, err)
+	}
+	current := uint64(f.target.Controller().Get(ctx, "objects", f.target.Id()).GetInt(crdt.ApplySeqField))
+	heads := append([]string(nil), f.target.Tree().Heads()...)
+	calls := 0
+	ch := definitionNoop(f, f.owner.Id())
+	ch.NativeDefinitionValidation = func() error { calls++; return nil }
+	for _, seq := range []uint64{initial, current + 1, 0} {
+		_, err := f.target.LocalWriteIfObject(ctx, ch, seq)
+		require.ErrorIs(t, err, crdt.ErrPreconditionFailed)
+		require.Equal(t, heads, f.target.Tree().Heads())
+	}
+	require.Zero(t, calls)
+}
diff --git a/internal/spaceobjects/native_definitions.go b/internal/spaceobjects/native_definitions.go
new file mode 100644
index 0000000..318c302
--- /dev/null
+++ b/internal/spaceobjects/native_definitions.go
@@ -0,0 +1,348 @@
+package spaceobjects
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/object"
+	"github.com/anyproto/any-sync-sdk/internal/properties"
+	"github.com/anyproto/any-sync-sdk/internal/types"
+	collectiontype "github.com/anyproto/any-sync-sdk/internal/types/collection"
+	typetype "github.com/anyproto/any-sync-sdk/internal/types/type"
+)
+
+func (s *Store) staticOwnerKind(id string) string {
+	if _, ok := ReservedTypeIds[id]; ok {
+		return "type"
+	}
+	for _, t := range s.extTypes {
+		if t.Id == id {
+			return "type"
+		}
+	}
+	for _, c := range s.extCollections {
+		if c.Id == id {
+			return "collection"
+		}
+	}
+	return ""
+}
+
+// Membership edits from the protected SDK routes are flat property patches,
+// not arbitrary record transformations. Read the proposed type/collections
+// without mutating the persisted row. Normal property validation still runs.
+func nativeMembership(row *anyenc.Value, ch *crdt.Change) (typeID string, collections []string, changedCollections bool, err error) {
+	if row != nil {
+		typeID = row.GetString("any", "type")
+	}
+	collections = []string{}
+	parseCollections := func(value *anyenc.Value) error {
+		collections = []string{}
+		if value == nil {
+			return nil
+		}
+		if value.Type() != anyenc.TypeArray {
+			return crdt.ErrValidation
+		}
+		for _, v := range value.GetArray() {
+			if v.Type() != anyenc.TypeString || v.GetString() == "" {
+				return crdt.ErrValidation
+			}
+			collections = append(collections, v.GetString())
+		}
+		return nil
+	}
+	if row != nil {
+		if err = parseCollections(row.Get("any", "collections")); err != nil {
+			return
+		}
+	}
+	if ch == nil || ch.Dataset != "objects" {
+		return
+	}
+	if len(ch.Records) != 1 {
+		return "", nil, false, crdt.ErrValidation
+	}
+	if ch.NativeConditionalNoop {
+		if len(ch.Records[0].Ops) != 0 || ch.Records[0].Upsert {
+			return "", nil, false, crdt.ErrValidation
+		}
+		// Empty patches retain the current collection-definition fence that
+		// an equal nonempty membership patch would acquire and validate.
+		changedCollections = true
+	}
+	for _, op := range ch.Records[0].Ops {
+		if op.Type != crdt.OpSet && op.Type != crdt.OpUnset {
+			return "", nil, false, crdt.ErrValidation
+		}
+		if len(op.Path) != 0 || op.Payload == nil || op.Payload.Type() != anyenc.TypeObject {
+			return "", nil, false, crdt.ErrValidation
+		}
+		if value := op.Payload.Get("any.type"); value != nil {
+			if op.Type != crdt.OpSet || value.Type() != anyenc.TypeString || value.GetString() == "" {
+				return "", nil, false, crdt.ErrValidation
+			}
+			typeID = value.GetString()
+		}
+		if value := op.Payload.Get("any.collections"); value != nil {
+			changedCollections = true
+			if op.Type == crdt.OpUnset {
+				collections = []string{}
+			} else if err = parseCollections(value); err != nil {
+				return
+			}
+		}
+	}
+	return
+}
+
+// Resolve dependencies before taking any multi-tree lock. Each target is read
+// under its own lock only to discover the type. Final reads validate the actual
+// type against the locked dependency set; a changed unseen type refuses.
+func (s *Store) preloadNativeDefinitions(ctx context.Context, objects map[string]*object.Object, carrier *object.Object, ch *crdt.Change) error {
+	owners := map[string]bool{}
+	original := make([]*object.Object, 0, len(objects))
+	for _, o := range objects {
+		original = append(original, o)
+	}
+	for _, o := range original {
+		o.Tree().Lock()
+		err := o.GuardReadyLocked(ctx)
+		var row *anyenc.Value
+		if err == nil {
+			row, err = o.Controller().GuardLookup(ctx, "objects", o.Id())
+		}
+		var typeID string
+		var collections []string
+		changedCollections := false
+		if err == nil {
+			var write *crdt.Change
+			if o == carrier && ch != nil && ch.NativeObjectPolicy {
+				write = ch
+			}
+			typeID, collections, changedCollections, err = nativeMembership(row, write)
+		}
+		o.Tree().Unlock()
+		if err != nil {
+			return err
+		}
+		if typeID != "" && typeID != typetype.MetaTypeMarker && typeID != collectiontype.MetaMarker {
+			owners[typeID] = true
+		}
+		if changedCollections {
+			for _, id := range collections {
+				owners[id] = true
+			}
+		}
+	}
+	if ch != nil {
+		for _, id := range ch.NativeDefinitionOwners {
+			if id == "" {
+				return crdt.ErrValidation
+			}
+			owners[id] = true
+		}
+	}
+	if len(owners) > 2048 {
+		return crdt.ErrValidation
+	}
+	ids := make([]string, 0, len(owners))
+	for id := range owners {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+	for _, id := range ids {
+		if s.staticOwnerKind(id) != "" || objects[id] != nil {
+			continue
+		}
+		definition, err := s.Get(ctx, id)
+		if err != nil {
+			return err
+		}
+		objects[id] = definition
+	}
+	return nil
+}
+
+func (v lockedReadView) definitionKind(id string) (string, error) {
+	if v.store == nil || id == "" {
+		return "", crdt.ErrValidation
+	}
+	if kind := v.store.staticOwnerKind(id); kind != "" {
+		return kind, nil
+	}
+	owner := v.objects[id]
+	if owner == nil {
+		return "", crdt.ErrPreconditionFailed
+	}
+	row, err := owner.Controller().GuardLookup(v.ctx, "objects", id)
+	if err != nil {
+		return "", err
+	}
+	if row == nil || row.Get("_deletedAt") != nil || row.GetString("id") != id || row.GetString("spaceId") != v.store.spaceId {
+		return "", crdt.ErrValidation
+	}
+	switch row.GetString("any", "type") {
+	case typetype.MetaTypeMarker:
+		return "type", nil
+	case collectiontype.MetaMarker:
+		return "collection", nil
+	default:
+		return "", crdt.ErrValidation
+	}
+}
+
+func (v lockedReadView) compiledType(id string) (*types.CompiledType, error) {
+	kind, err := v.definitionKind(id)
+	if err != nil {
+		return nil, err
+	}
+	if kind != "type" {
+		return nil, properties.ErrWrongSlot
+	}
+	for _, t := range v.store.extTypes {
+		if t.Id == id {
+			return StaticTypeParts(t, v.store.moduleInfos)
+		}
+	}
+	if _, ok := ReservedTypeIds[id]; ok {
+		return &types.CompiledType{}, nil
+	}
+	return v.store.TypeParts(v.ctx, id)
+}
+
+func (v lockedReadView) TypeDeclaresDataset(typeID, module, dataset string, canonicalOnly bool) (bool, error) {
+	compiled, err := v.compiledType(typeID)
+	if err != nil {
+		return false, err
+	}
+	if compiled == nil {
+		return false, nil
+	}
+	for _, d := range compiled.Datasets {
+		if !d.Invalid && d.Name == dataset && (module == "" || d.Module == module) && (!canonicalOnly || d.Canonical) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// ValidateNativeObjectChange is called after sequence checks, with every
+// discovered definition held. Unrelated/orphan property groups remain stored.
+func (v lockedReadView) ValidateNativeObjectChange(ch *crdt.Change) error {
+	if ch == nil || !ch.NativeObjectPolicy || v.store == nil {
+		return crdt.ErrValidation
+	}
+	carrier := v.objects[ch.ObjectId]
+	// ObjectId is native metadata and may not have been stamped yet on the
+	// ordinary route. The locker captures the actual carrier explicitly.
+	if carrier == nil {
+		carrier = v.carrier
+	}
+	if carrier == nil {
+		return crdt.ErrValidation
+	}
+	row, err := carrier.Controller().GuardLookup(v.ctx, "objects", carrier.Id())
+	if err != nil {
+		return err
+	}
+	typeID, collections, changedCollections, err := nativeMembership(row, ch)
+	if err != nil {
+		return err
+	}
+	if typeID == "" || properties.IsMetaType(typeID) {
+		return properties.ErrMetaType
+	}
+	kind, err := v.definitionKind(typeID)
+	if err != nil {
+		return err
+	}
+	if kind != "type" {
+		return properties.ErrWrongSlot
+	}
+	compiled, err := v.compiledType(typeID)
+	if err != nil {
+		return err
+	}
+	if compiled != nil && typeID != carrier.Id() {
+		for _, d := range compiled.Datasets {
+			if !d.Invalid && v.store.moduleInfos.Reserved(d.Module) {
+				return crdt.ErrValidation
+			}
+		}
+	}
+	for _, required := range ch.NativeTypeDatasets {
+		if required.Module == "" || required.Dataset == "" {
+			return crdt.ErrValidation
+		}
+		allowed, err := v.TypeDeclaresDataset(typeID, required.Module, required.Dataset, required.Canonical)
+		if err != nil {
+			return err
+		}
+		if !allowed {
+			return fmt.Errorf("%w: destination type no longer declares the required native dataset", crdt.ErrPreconditionFailed)
+		}
+	}
+	if changedCollections {
+		for _, id := range collections {
+			if properties.IsMetaType(id) {
+				return properties.ErrMetaType
+			}
+			kind, err := v.definitionKind(id)
+			if err != nil {
+				return err
+			}
+			if kind != "collection" {
+				return properties.ErrWrongSlot
+			}
+		}
+	}
+	for _, id := range ch.NativeDefinitionOwners {
+		if _, err := v.definitionKind(id); err != nil {
+			return err
+		}
+		// With no field op, the ordinary property validator has no owner
+		// path to check. Verify the requested owner against this locked row.
+		if ch.NativeConditionalNoop && id != "any" && id != typeID && !slices.Contains(collections, id) {
+			return properties.ErrWrongSlot
+		}
+	}
+	if ch.Dataset != "objects" {
+		if slices.Contains(collections, "bin") || slices.Contains(collections, "template") {
+			return fmt.Errorf("%w: inactive document", crdt.ErrValidation)
+		}
+		allowed, err := v.TypeDeclaresDataset(typeID, "", ch.Dataset, false)
+		if err != nil {
+			return err
+		}
+		if !allowed {
+			return fmt.Errorf("%w: current type no longer declares dataset %s", crdt.ErrValidation, ch.Dataset)
+		}
+	}
+	// Refuse forged membership paths hidden in a nested any object. The
+	// protected API uses patchOps/bootstrap's documented flat path map.
+	if ch.Dataset == "objects" {
+		for _, r := range ch.Records {
+			for _, op := range r.Ops {
+				obj, _ := op.Payload.Object()
+				if obj == nil {
+					continue
+				}
+				invalid := false
+				obj.Visit(func(key []byte, _ *anyenc.Value) {
+					if string(key) == "any" || strings.HasPrefix(string(key), "any.type.") || strings.HasPrefix(string(key), "any.collections.") {
+						invalid = true
+					}
+				})
+				if invalid {
+					return crdt.ErrValidation
+				}
+			}
+		}
+	}
+	return nil
+}
diff --git a/internal/spaceobjects/native_definitions_test.go b/internal/spaceobjects/native_definitions_test.go
