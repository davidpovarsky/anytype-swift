--- /dev/null
+++ b/internal/crdt/objectprecondition.go
@@ -0,0 +1,30 @@
+package crdt
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+)
+
+// ObjectApplySeqMatches is an exact, point-read precondition for this object's
+// own shared row. The caller holds the object's native tree lock through append
+// and apply. A different object's later writes never invalidate this row.
+// Missing, tombstoned, unstamped or mismatched rows fail closed.
+func (c *Controller) ObjectApplySeqMatches(ctx context.Context, expected uint64) (bool, error) {
+	if c.objectId == "" || !c.IsShared("objects") {
+		return false, fmt.Errorf("%w: object CAS requires shared native objects", ErrValidation)
+	}
+	row, err := c.Lookup(ctx, "objects", c.objectId)
+	if err != nil {
+		return false, err
+	}
+	if row == nil || row.GetString("id") != c.objectId || row.Get(DeletedAtField) != nil {
+		return false, nil
+	}
+	stamp := row.Get(ApplySeqField)
+	if stamp == nil || stamp.Type() != anyenc.TypeNumber || stamp.GetInt() <= 0 || expected == 0 {
+		return false, nil
+	}
+	return uint64(stamp.GetInt()) == expected, nil
+}
