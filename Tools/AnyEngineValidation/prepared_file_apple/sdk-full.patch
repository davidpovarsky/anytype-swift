+++ b/space/current_writer.go
@@ -0,0 +1,80 @@
+package space
+
+import (
+	"context"
+	"errors"
+)
+
+var ErrCurrentWriterUnavailable = errors.New("space: native current-writer route unavailable")
+
+// CurrentWriterCreateResult retains the native ID even when the result is
+// uncertain. A post-root failure is never described as a completed object.
+// Callers must persist ObjectID under the original intent before surfacing an
+// error. A lost HTTP response is independently uncertain.
+type CurrentWriterCreateResult struct {
+	ObjectID      string
+	CreationStage string
+	Cleanup       string
+	Outcome       string
+}
+
+type currentWriterCreator interface {
+	CreateCurrentWriter(context.Context, CreateObjectOpts) (CurrentWriterCreateResult, error)
+}
+type currentWriterModifier interface {
+	ModifyCurrentWriter(context.Context, ModifyBatch) (ModifyResult, error)
+}
+
+func CreateCurrentWriter(ctx context.Context, sp Space, opts CreateObjectOpts) (CurrentWriterCreateResult, error) {
+	if sp == nil {
+		return CurrentWriterCreateResult{}, ErrCurrentWriterUnavailable
+	}
+	implementation, ok := sp.Objects().(currentWriterCreator)
+	if !ok {
+		return CurrentWriterCreateResult{}, ErrCurrentWriterUnavailable
+	}
+	return implementation.CreateCurrentWriter(ctx, opts)
+}
+
+// ModifyCurrentWriter is synced-only and opt-in. It applies the same schema,
+// membership and target-tree checks as Modify, plus current ACL held through
+// native storage. It does not imply a read-version precondition.
+func ModifyCurrentWriter(ctx context.Context, sp Space, batch ModifyBatch) (ModifyResult, error) {
+	implementation, ok := sp.(currentWriterModifier)
+	if !ok {
+		return ModifyResult{}, ErrCurrentWriterUnavailable
+	}
+	return implementation.ModifyCurrentWriter(ctx, batch)
+}
+
+// TypeDatasetRequirement adds an opt-in current Type contract to a conditional
+// property write. It applies to the proposed destination of an any.type change,
+// or the current Type otherwise, while that definition's tree remains locked.
+type TypeDatasetRequirement struct {
+	Module    string
+	Dataset   string
+	Canonical bool
+}
+
+// SetConditionalValidated invokes a pure descriptor validator on current
+// decoded property definitions while the destination, property owner and
+// target trees are held. The callback is synchronous and must inspect only its
+// decoded inputs: no writes, tree loading, recursive SDK calls or other I/O.
+// Current ACL remains separately fenced at the actual durable append.
+// An empty patch is an explicit conditional no-op: it validates current target,
+// owner, all existing collection definitions, the captured object sequence and
+// current signer authority, but does not append history or advance row metadata.
+// The ordinary Properties.Set and unvalidated SetConditional reject empty maps.
+func SetConditionalValidated(ctx context.Context, sp Space, objectID, ownerID string, patch map[string]any, expectedApplySeq uint64, validate func([]PropertyDef) error, requiredTypeDatasets ...TypeDatasetRequirement) (ModifyResult, error) {
+	type implementation interface {
+		SetConditionalValidated(context.Context, string, string, map[string]any, uint64, func([]PropertyDef) error, ...TypeDatasetRequirement) (ModifyResult, error)
+	}
+	if sp == nil {
+		return ModifyResult{}, ErrCurrentWriterUnavailable
+	}
+	writer, ok := sp.Properties().(implementation)
+	if !ok {
+		return ModifyResult{}, ErrCurrentWriterUnavailable
+	}
+	return writer.SetConditionalValidated(ctx, objectID, ownerID, patch, expectedApplySeq, validate, requiredTypeDatasets...)
+}
