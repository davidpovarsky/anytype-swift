+    func performDestinationOperation<Value: Sendable>(
+        expectedAccountID: String, expectedSpaceID: String,
+        _ action: @escaping @Sendable (
+            AnyHTTPClient, AnyApplicationSession, AnyHostLease
+        ) async throws -> Value
+    ) async throws -> Value {
