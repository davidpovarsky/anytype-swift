+package anysyncx
+
+import (
+	"context"
+	"time"
+
+	"github.com/anyproto/any-sync/net/peer"
+)
+
+const (
+	// A discovered device must be reachable without waiting for an
+	// unavailable node's transport retry sequence. Node subscriptions
+	// retain a separate, longer budget to establish node connections.
+	nodeFallbackTimeout  = time.Second
+	nodeSubscribeTimeout = 10 * time.Second
+	nodeLookupWorkers    = 3
+)
+
+// nodeLookupContext bounds only the node leg when another device is
+// known for this space. The caller retains ctx for the LAN/global leg:
+// a node timeout is not a cancellation or a dial strike for that device.
+// No local/global candidates means the existing node-only budget stays
+// unchanged. These candidates still pass the usual secure peer, space
+// membership and signed tree/ACL validation when they exchange data.
+func (m *spacePeerManager) nodeLookupContext(ctx context.Context) (context.Context, context.CancelFunc) {
+	if (m.localPeers != nil && len(m.localPeers.LocalPeerIds(m.spaceId)) > 0) ||
+		(m.globalPeers != nil && len(m.globalPeers.GlobalPeerIds(m.spaceId)) > 0) {
+		return context.WithTimeout(ctx, nodeFallbackTimeout)
+	}
+	return ctx, func() {}
+}
+
+// getNodePeersConcurrent bounds concurrency and keeps nodeconf order.
+// A dead first node cannot consume the entire shared lookup deadline
+// before another node gets its first chance. GetNodePeers remains the
+// unchanged public nodes-only operation for its other callers.
+func (m *spacePeerManager) getNodePeersConcurrent(ctx context.Context) []peer.Peer {
+	ids := m.nodeConf.NodeIds(m.spaceId)
+	resolved := make([]peer.Peer, len(ids))
+	indices := make([]int, len(ids))
+	for i := range ids {
+		indices[i] = i
+	}
+	eachOf(indices, nodeLookupWorkers, func(i int) {
+		if ctx.Err() != nil {
+			return
+		}
+		p, err := m.pool.Get(ctx, ids[i])
+		if err == nil {
+			resolved[i] = p
+		}
+	})
+	peers := resolved[:0]
+	for _, p := range resolved {
+		if p != nil {
+			peers = append(peers, p)
+		}
+	}
+	return peers
+}
