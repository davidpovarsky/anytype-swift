+package api
+
+// Full-tier prepared files use a bounded binary body and separate immutable metadata.
+type MigrationFileCapabilities struct {
+	Contract        string `json:"contract"`
+	StoreID         string `json:"storeId"`
+	AccountID       string `json:"accountId"`
+	SpaceID         string `json:"spaceId"`
+	PreparedFile    int    `json:"preparedFile"`
+	MaximumBytes    int    `json:"maximumBytes"`
+	File            int    `json:"file"`
+	NetworkVerified bool   `json:"networkVerified"`
+}
+
+const MigrationFileMaximumBytes = 512 << 20
+
+// Pointer fields distinguish an explicit empty file/name/mime from omitted or null input.
+type MigrationFileSpec struct {
+	OwnerObjectID *string `json:"ownerObjectId"`
+	Name          *string `json:"name"`
+	Mime          *string `json:"mime"`
+	Size          *int64  `json:"size"`
+	ContentSHA256 *string `json:"contentSHA256"`
+}
+
+const MigrationFileMetadataHeader = "X-Pinkha-Migration"
+const MigrationFileMetadataMaximumBytes = 16 << 10
