+package server
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any/internal/api"
+	"github.com/labstack/echo/v4"
+	"github.com/stretchr/testify/require"
+)
+
+type fullHTTPBodyCounter struct{ reads int }
+
+func (b *fullHTTPBodyCounter) Read([]byte) (int, error) { b.reads++; return 0, io.EOF }
+
+func fullHTTPHeader(t *testing.T, cap api.MigrationInlineFileCapabilities, source string, spec space.MigrationFileSpec) (string, string) {
+	t.Helper()
+	raw, err := json.Marshal(spec)
+	require.NoError(t, err)
+	id, body := inlineHTTPRequest(t, cap, source, raw)
+	return id, base64.StdEncoding.EncodeToString([]byte(body))
+}
+
+func TestPreparedFullFileHTTPStrictMetadataBeforeBodyRead(t *testing.T) {
+	spec := space.MigrationFileSpec{OwnerObjectID: "owner", Name: "", Mime: "", Size: 4096, ContentSHA256: strings.Repeat("d", 64)}
+	cap := api.MigrationInlineFileCapabilities{Contract: space.PreparedMigrationContract, StoreID: "store"}
+	id, header := fullHTTPHeader(t, cap, "source", spec)
+	for _, bad := range []string{"none", "missing", "duplicate", "length", "media", "noncanonical", "unknown"} {
+		t.Run(bad, func(t *testing.T) {
+			body := &fullHTTPBodyCounter{}
+			r := httptest.NewRequest(http.MethodPut, "/", body)
+			r.ContentLength = spec.Size
+			r.Header.Set(echo.HeaderContentType, "application/octet-stream")
+			r.Header.Set(api.MigrationFileMetadataHeader, header)
+			switch bad {
+			case "missing":
+				r.Header.Del(api.MigrationFileMetadataHeader)
+			case "duplicate":
+				r.Header.Add(api.MigrationFileMetadataHeader, header)
+			case "length":
+				r.ContentLength++
+			case "media":
+				r.Header.Set(echo.HeaderContentType, "application/json")
+			case "noncanonical":
+				r.Header.Set(api.MigrationFileMetadataHeader, header+"\n")
+			case "unknown":
+				r.Header.Set(api.MigrationFileMetadataHeader, base64.StdEncoding.EncodeToString([]byte(`{"unknown":true}`)))
+			}
+			c := echo.New().NewContext(r, httptest.NewRecorder())
+			c.SetParamNames("intentId")
+			c.SetParamValues(id)
+			input, got, err := migrationFileInput(c)
+			if bad == "none" {
+				require.NoError(t, err)
+				require.Equal(t, spec, got)
+				require.Equal(t, id, input.IntentID)
+			} else {
+				require.Error(t, err)
+			}
+			require.Zero(t, body.reads)
+		})
+	}
+}
+
+func TestPreparedFullFileHTTPNativeStreamingBeyondJSONCap(t *testing.T) {
+	_, router, sp, owner, cap := inlineHTTPFixture(t)
+	base := "/v1/spaces/" + sp.Id() + "/pinkha/migration"
+	response := doJSON(t, router, http.MethodGet, base+"/file/capabilities", "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var capability api.MigrationFileCapabilities
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &capability))
+	require.Equal(t, 1, capability.PreparedFile)
+	body := inlineHTTPBytes(2 << 20)
+	spec := space.MigrationFileSpec{OwnerObjectID: owner, Name: "large-שלום.bin", Mime: "application/octet-stream", Size: int64(len(body)), ContentSHA256: inlineHTTPHash(body)}
+	id, header := fullHTTPHeader(t, cap, "source/full/http", spec)
+	prepare := func(content []byte) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(http.MethodPut, base+"/intents/"+id+"/file/prepare", bytes.NewReader(content))
+		r.Header.Set(echo.HeaderContentType, "application/octet-stream")
+		r.Header.Set(api.MigrationFileMetadataHeader, header)
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, r)
+		return w
+	}
+	bad := bytes.Clone(body)
+	bad[0] ^= 0xff
+	response = prepare(bad)
+	require.Equal(t, http.StatusBadRequest, response.Code, response.Body.String())
+	response = prepare(body)
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var prepared space.MigrationFileReceipt
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &prepared))
+	require.Equal(t, "file-prepared", prepared.Stage)
+	commitBytes, err := json.Marshal(space.MigrationCommit{Contract: prepared.Contract, StoreID: prepared.StoreID, PlanID: prepared.PlanID, PlanSHA256: prepared.PlanSHA256, Fingerprint: prepared.Fingerprint})
+	require.NoError(t, err)
+	var complete space.MigrationFileReceipt
+	for range 2 {
+		response = doJSON(t, router, http.MethodPost, base+"/intents/"+id+"/file/commit", string(commitBytes))
+		require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+		require.NoError(t, json.Unmarshal(response.Body.Bytes(), &complete))
+	}
+	require.Equal(t, "complete", complete.Stage)
+	require.True(t, complete.LocalFileComplete)
+	require.False(t, complete.NetworkVerified)
+	require.Equal(t, prepared.RootCID, complete.RootCID)
+	require.Equal(t, prepared.ChangeID, complete.ChangeID)
+	reader, err := sp.Files().Open(context.Background(), complete.FileID, space.VariantOriginal)
+	require.NoError(t, err)
+	actual, err := io.ReadAll(reader)
+	require.NoError(t, err)
+	require.NoError(t, reader.Close())
+	require.Equal(t, body, actual)
+	response = doJSON(t, router, http.MethodGet, base+"/intents/"+id+"/file", "")
+	require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+	var recovered space.MigrationFileReceipt
+	require.NoError(t, json.Unmarshal(response.Body.Bytes(), &recovered))
+	require.Equal(t, complete, recovered)
+	t.Log("full_file_http raw_stream_bytes=2097152 json_cap_bypassed_only_for_named_route=true bad_sha_refused=true exact_native_row_and_plaintext=true")
+}
