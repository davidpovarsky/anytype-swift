+package server
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/anyproto/any/internal/api"
+	"github.com/labstack/echo/v4"
+)
+
+func registerPinkhaMigrationFileRoutes(v1 *echo.Group, d *deps) {
+	v1.GET("/spaces/:spaceId/pinkha/migration/file/capabilities", d.pinkhaMigrationFileCapabilities)
+	v1.PUT("/spaces/:spaceId/pinkha/migration/intents/:intentId/file/prepare", d.pinkhaMigrationFilePrepare)
+	v1.GET("/spaces/:spaceId/pinkha/migration/intents/:intentId/file", d.pinkhaMigrationFileStatus)
+	v1.POST("/spaces/:spaceId/pinkha/migration/intents/:intentId/file/commit", d.pinkhaMigrationFileCommit)
+}
+
+func migrationFileService(sp space.Space) (space.PreparedFileService, error) {
+	native, ok := sp.Files().(space.PreparedFileService)
+	if !ok {
+		return nil, space.ErrCurrentWriterUnavailable
+	}
+	return native, nil
+}
+
+func (d *deps) pinkhaMigrationFileCapabilities(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	if _, err := migrationFileService(sp); err != nil {
+		return migrationError(c, err)
+	}
+	native, err := migrationService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	base, err := native.MigrationCapabilities(c.Request().Context())
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, api.MigrationFileCapabilities{
+		Contract: base.Contract, StoreID: base.StoreID, AccountID: base.AccountID, SpaceID: base.SpaceID,
+		PreparedFile: 1, MaximumBytes: api.MigrationFileMaximumBytes, File: 0, NetworkVerified: false,
+	})
+}
+
+// Only the small typed metadata uses JSON; the declared file bytes remain a
+// bounded stream. The header is canonical base64 and cannot contain duplicate
+// headers, duplicate JSON keys, omitted fields or a rewritten source digest.
+func migrationFileInput(c echo.Context) (space.MigrationInput, space.MigrationFileSpec, error) {
+	bad := func() (space.MigrationInput, space.MigrationFileSpec, error) {
+		return space.MigrationInput{}, space.MigrationFileSpec{}, fmt.Errorf("prepared file metadata, digest or body bounds differ")
+	}
+	values := c.Request().Header.Values(api.MigrationFileMetadataHeader)
+	if len(values) != 1 || len(values[0]) == 0 || len(values[0]) > api.MigrationFileMetadataMaximumBytes {
+		return bad()
+	}
+	raw, err := base64.StdEncoding.Strict().DecodeString(values[0])
+	if err != nil || base64.StdEncoding.EncodeToString(raw) != values[0] {
+		return bad()
+	}
+	var request api.MigrationPrepareRequest
+	if strictMigrationJSON(raw, &request) != nil {
+		return bad()
+	}
+	encoded, err := base64.StdEncoding.Strict().DecodeString(request.SpecBase64)
+	if err != nil || len(encoded) == 0 || len(encoded) > 8<<10 || base64.StdEncoding.EncodeToString(encoded) != request.SpecBase64 {
+		return bad()
+	}
+	hash := sha256.Sum256(encoded)
+	if request.Contract != space.PreparedMigrationContract || hex.EncodeToString(hash[:]) != request.SpecSHA256 {
+		return bad()
+	}
+	var wire api.MigrationFileSpec
+	if strictMigrationJSON(encoded, &wire) != nil || wire.OwnerObjectID == nil || wire.Name == nil || wire.Mime == nil || wire.Size == nil || wire.ContentSHA256 == nil {
+		return bad()
+	}
+	digest, err := hex.DecodeString(*wire.ContentSHA256)
+	if err != nil || len(digest) != 32 || hex.EncodeToString(digest) != *wire.ContentSHA256 ||
+		*wire.Size < 4096 || *wire.Size > api.MigrationFileMaximumBytes || c.Request().ContentLength != *wire.Size ||
+		bareType(c.Request().Header.Get(echo.HeaderContentType)) != "application/octet-stream" ||
+		*wire.OwnerObjectID == "" || len(*wire.OwnerObjectID) > 256 ||
+		!utf8.ValidString(*wire.Name) || !utf8.ValidString(*wire.Mime) || len(*wire.Name) > 1024 || len(*wire.Mime) > 255 ||
+		strings.ContainsRune(*wire.Name, 0) || strings.ContainsRune(*wire.Mime, 0) {
+		return bad()
+	}
+	input := space.MigrationInput{Contract: request.Contract, StoreID: request.StoreID, PlanID: request.PlanID, PlanSHA256: request.PlanSHA256, IntentID: c.Param("intentId"), SourceKey: request.SourceKey, SpecSHA256: request.SpecSHA256, SourceSpec: encoded}
+	spec := space.MigrationFileSpec{OwnerObjectID: *wire.OwnerObjectID, Name: *wire.Name, Mime: *wire.Mime, Size: *wire.Size, ContentSHA256: *wire.ContentSHA256}
+	return input, spec, nil
+}
+
+func (d *deps) pinkhaMigrationFilePrepare(c echo.Context) error {
+	input, spec, err := migrationFileInput(c)
+	if err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationFileService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.PrepareMigrationFile(c.Request().Context(), input, spec, c.Request().Body)
+	if err != nil {
+		if errors.Is(err, space.ErrMigrationFileContent) {
+			return writeError(c, http.StatusBadRequest, "request.invalid_field", "file content length or SHA-256 differs", nil)
+		}
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationFileStatus(c echo.Context) error {
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationFileService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.MigrationFileStatus(c.Request().Context(), c.Param("intentId"))
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
+
+func (d *deps) pinkhaMigrationFileCommit(c echo.Context) error {
+	var request space.MigrationCommit
+	if err := readMigrationJSON(c, &request); err != nil {
+		return writeError(c, http.StatusBadRequest, "request.invalid_field", err.Error(), nil)
+	}
+	request.IntentID = c.Param("intentId")
+	sp, response, done := d.resolveSpace(c)
+	if done {
+		return response
+	}
+	native, err := migrationFileService(sp)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	result, err := native.CommitMigrationFile(c.Request().Context(), request)
+	if err != nil {
+		return migrationError(c, err)
+	}
+	return c.JSON(http.StatusOK, result)
+}
