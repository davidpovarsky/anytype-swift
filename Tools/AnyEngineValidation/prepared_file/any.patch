+package migrationnative
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	anysyncsdk "github.com/anyproto/any-sync-sdk"
+	"github.com/anyproto/any-sync-sdk/space"
+	"github.com/stretchr/testify/require"
+)
+
+func fullFileSpec(owner string, content []byte) space.MigrationFileSpec {
+	h := sha256.Sum256(content)
+	return space.MigrationFileSpec{OwnerObjectID: owner, Name: "large-שלום.bin", Mime: "application/octet-stream", Size: int64(len(content)), ContentSHA256: hex.EncodeToString(h[:])}
+}
+
+func fullFileContent() []byte { return bytes.Repeat([]byte{0x00, 0x19, 0xfe, 0xa4}, 512<<10) }
+
+func readFullFile(t *testing.T, ctx context.Context, sp space.Space, receipt space.MigrationFileReceipt, spec space.MigrationFileSpec) {
+	t.Helper()
+	info, err := sp.Files().Get(ctx, receipt.FileID)
+	require.NoError(t, err)
+	require.False(t, info.Inline)
+	require.True(t, info.Cached)
+	require.Equal(t, spec.Name, info.Name)
+	require.Equal(t, spec.Mime, info.Mime)
+	require.Equal(t, spec.OwnerObjectID, info.ObjectId)
+	require.Equal(t, receipt.RootCID, info.RootCid)
+	require.Equal(t, spec.Size, info.Size)
+	f, err := sp.Files().Open(ctx, receipt.FileID, space.VariantOriginal)
+	require.NoError(t, err)
+	h := sha256.New()
+	n, err := io.Copy(h, f)
+	require.NoError(t, err)
+	require.NoError(t, f.Close())
+	require.Equal(t, spec.Size, n)
+	require.Equal(t, spec.ContentSHA256, hex.EncodeToString(h.Sum(nil)))
+}
+
+func TestPreparedFullFileNativeStageRestartConcurrentCommitAndReadback(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Minute)
+	defer cancel()
+	cfg, seeds := nativeConfig(t.TempDir(), localNetwork(t)), newSeeds(t)
+	var sdk *anysyncsdk.SDK
+	var sp space.Space
+	var native space.PreparedFileService
+	var spaceID string
+	open := func() {
+		var err error
+		sdk, err = anysyncsdk.Open(ctx, cfg, seeds)
+		require.NoError(t, err)
+		if spaceID == "" {
+			sp, err = sdk.Spaces().Create(ctx, space.CreateRequest{Name: "full file migration"})
+			if err == nil {
+				spaceID = sp.Id()
+			}
+		} else {
+			sp, err = sdk.Spaces().Get(ctx, spaceID)
+		}
+		require.NoError(t, err)
+		native = sp.Files().(space.PreparedFileService)
+	}
+	closeSDK := func() { require.NoError(t, sdk.Close()); sdk = nil }
+	t.Cleanup(func() {
+		if sdk != nil {
+			_ = sdk.Close()
+		}
+	})
+	open()
+	capabilities, err := sp.Objects().(space.PreparedMigrationService).MigrationCapabilities(ctx)
+	require.NoError(t, err)
+	owner, err := space.CreateCurrentWriter(ctx, sp, space.CreateObjectOpts{Type: "page"})
+	require.NoError(t, err)
+	content := fullFileContent()
+	spec := fullFileSpec(owner.ObjectID, content)
+	input := nativeInput(t, capabilities, "full-file/one", spec)
+	prepared, err := native.PrepareMigrationFile(ctx, input, spec, bytes.NewReader(content))
+	require.NoError(t, err)
+	require.Equal(t, "file-prepared", prepared.Stage)
+	require.False(t, prepared.LocalFileComplete)
+	_, err = sp.Files().Get(ctx, prepared.FileID)
+	require.Error(t, err)
+	closeSDK()
+	open()
+	recovered, err := native.PrepareMigrationFile(ctx, input, spec, nil)
+	require.NoError(t, err)
+	require.Equal(t, prepared, recovered, "known prepare must not re-read or reseal content")
+	commit := commitOf(input, prepared.MigrationReceipt)
+	root, err := native.CommitMigrationFile(ctx, commit)
+	require.NoError(t, err)
+	require.Equal(t, "file-root-committed", root.Stage)
+	closeSDK()
+	open()
+	var wg sync.WaitGroup
+	results := make(chan space.MigrationFileReceipt, 4)
+	errs := make(chan error, 4)
+	for range 4 {
+		wg.Add(1)
+		go func() { defer wg.Done(); r, e := native.CommitMigrationFile(ctx, commit); results <- r; errs <- e }()
+	}
+	wg.Wait()
+	close(results)
+	close(errs)
+	for e := range errs {
+		require.NoError(t, e)
+	}
+	var complete space.MigrationFileReceipt
+	for r := range results {
+		require.Equal(t, "complete", r.Stage)
+		require.Equal(t, "committed", r.Outcome)
+		require.Equal(t, prepared.ChangeID, r.ChangeID)
+		require.Equal(t, prepared.RootCID, r.RootCID)
+		require.Equal(t, prepared.FileID, r.FileID)
+		require.True(t, r.LocalFileComplete)
+		require.False(t, r.NetworkVerified)
+		complete = r
+	}
+	readFullFile(t, ctx, sp, complete, spec)
+	closeSDK()
+	open()
+	retry, err := native.CommitMigrationFile(ctx, commit)
+	require.NoError(t, err)
+	require.Equal(t, complete, retry)
+	readFullFile(t, ctx, sp, retry, spec)
+	stats, err := sp.Files().Stats(ctx)
+	require.NoError(t, err)
+	require.Equal(t, 1, stats.Total)
+	require.NoError(t, sp.Files().Delete(ctx, prepared.FileID))
+	deleted, err := native.CommitMigrationFile(ctx, commit)
+	require.NoError(t, err)
+	require.Equal(t, "committed_deleted", deleted.Outcome)
+	_, err = sp.Files().Get(ctx, prepared.FileID)
+	require.Error(t, err)
+	t.Log("full_file_native bytes=2097152 actual_sdk_reopens=3 concurrent_callers=4 exact_signed_row_and_car=true plaintext_sha256=true deleted_retry_resurrects=false network_verified=false")
+}
+
+type fullFileCountingReader struct {
+	n      int
+	reader io.Reader
+}
+
+func (r *fullFileCountingReader) Read(p []byte) (int, error) { r.n++; return r.reader.Read(p) }
+
+func TestPreparedFullFileNativeBadBodyCollisionAndOwnerFence(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	sdk, err := anysyncsdk.Open(ctx, nativeConfig(t.TempDir(), localNetwork(t)), newSeeds(t))
+	require.NoError(t, err)
+	defer sdk.Close()
+	sp, err := sdk.Spaces().Create(ctx, space.CreateRequest{Name: "full file refusal"})
+	require.NoError(t, err)
+	native := sp.Files().(space.PreparedFileService)
+	capabilities, err := sp.Objects().(space.PreparedMigrationService).MigrationCapabilities(ctx)
+	require.NoError(t, err)
+	owner, err := space.CreateCurrentWriter(ctx, sp, space.CreateObjectOpts{Type: "page"})
+	require.NoError(t, err)
+	content := fullFileContent()
+	spec := fullFileSpec(owner.ObjectID, content)
+	input := nativeInput(t, capabilities, "full-file/refusal", spec)
+	_, err = native.PrepareMigrationFile(ctx, input, spec, bytes.NewReader(content[:4096]))
+	require.Error(t, err)
+	_, err = native.MigrationFileStatus(ctx, input.IntentID)
+	require.ErrorIs(t, err, space.ErrMigrationNotFound)
+	changed := spec
+	changed.Name = "changed"
+	changedInput := nativeInput(t, capabilities, "full-file/refusal", changed)
+	counter := &fullFileCountingReader{reader: bytes.NewReader(content)}
+	_, err = native.PrepareMigrationFile(ctx, changedInput, changed, counter)
+	require.ErrorIs(t, err, space.ErrMigrationCollision)
+	require.Zero(t, counter.n)
+	prepared, err := native.PrepareMigrationFile(ctx, input, spec, bytes.NewReader(content))
+	require.NoError(t, err)
+	_, err = sp.Properties().Set(ctx, owner.ObjectID, "any", map[string]any{"name": "changed owner"})
+	require.NoError(t, err)
+	refused, err := native.CommitMigrationFile(ctx, commitOf(input, prepared.MigrationReceipt))
+	require.NoError(t, err)
+	require.Equal(t, "obsolete", refused.Outcome)
+	_, err = sp.Files().Get(ctx, prepared.FileID)
+	require.Error(t, err)
+	canceled, stop := context.WithCancel(ctx)
+	stop()
+	counter = &fullFileCountingReader{reader: bytes.NewReader(content)}
+	_, err = native.PrepareMigrationFile(canceled, input, spec, counter)
+	require.Error(t, err)
+	require.Zero(t, counter.n)
+}
+
+type fullFileCrashSetup struct {
+	Directory                string
+	Network, Account, Device []byte
+}
+type fullFileCrashReceipt struct {
+	SpaceID string
+	Input   space.MigrationInput
+	Spec    space.MigrationFileSpec
+	Receipt space.MigrationFileReceipt
+}
+
+func TestPreparedFullFileCrashChild(t *testing.T) {
+	dir := os.Getenv("PINKHA_PREPARED_FULLFILE_CHILD")
+	if dir == "" {
+		t.Skip("private child process only")
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, "setup.json"))
+	require.NoError(t, err)
+	var setup fullFileCrashSetup
+	require.NoError(t, json.Unmarshal(raw, &setup))
+	ctx := context.Background()
+	sdk, err := anysyncsdk.Open(ctx, nativeConfig(setup.Directory, setup.Network), &seedProvider{setup.Account, setup.Device})
+	require.NoError(t, err)
+	sp, err := sdk.Spaces().Create(ctx, space.CreateRequest{Name: "full file crash"})
+	require.NoError(t, err)
+	capabilities, err := sp.Objects().(space.PreparedMigrationService).MigrationCapabilities(ctx)
+	require.NoError(t, err)
+	owner, err := space.CreateCurrentWriter(ctx, sp, space.CreateObjectOpts{Type: "page"})
+	require.NoError(t, err)
+	content := fullFileContent()
+	spec := fullFileSpec(owner.ObjectID, content)
+	input := nativeInput(t, capabilities, "full-file/crash", spec)
+	prepared, err := sp.Files().(space.PreparedFileService).PrepareMigrationFile(ctx, input, spec, bytes.NewReader(content))
+	require.NoError(t, err)
+	raw, err = json.Marshal(fullFileCrashReceipt{sp.Id(), input, spec, prepared})
+	require.NoError(t, err)
+	f, err := os.OpenFile(filepath.Join(dir, "prepared.json"), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	require.NoError(t, err)
+	_, err = f.Write(raw)
+	require.NoError(t, err)
+	require.NoError(t, f.Sync())
+	require.NoError(t, f.Close())
+	select {} // Parent kills this process without SDK.Close or database teardown.
+}
+
+func TestPreparedFullFileActualProcessCrashKeepsCARAndOriginalIntent(t *testing.T) {
+	dir := t.TempDir()
+	seeds := newSeeds(t)
+	setup := fullFileCrashSetup{filepath.Join(dir, "sdk"), localNetwork(t), seeds.account, seeds.device}
+	raw, err := json.Marshal(setup)
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "setup.json"), raw, 0600))
+	exe, err := os.Executable()
+	require.NoError(t, err)
+	cmd := exec.Command(exe, "-test.run=^TestPreparedFullFileCrashChild$", "-test.count=1", "-test.timeout=120s")
+	cmd.Env = append(os.Environ(), "PINKHA_PREPARED_FULLFILE_CHILD="+dir)
+	log, err := os.OpenFile(filepath.Join(dir, "child.log"), os.O_CREATE|os.O_WRONLY, 0600)
+	require.NoError(t, err)
+	defer log.Close()
+	cmd.Stdout, cmd.Stderr = log, log
+	require.NoError(t, cmd.Start())
+	defer func() {
+		if cmd.Process != nil {
+			_ = cmd.Process.Kill()
+		}
+	}()
+	require.Eventually(t, func() bool {
+		raw, err := os.ReadFile(filepath.Join(dir, "prepared.json"))
+		return err == nil && json.Valid(raw)
+	}, 60*time.Second, 50*time.Millisecond)
+	require.NoError(t, cmd.Process.Kill())
+	require.Error(t, cmd.Wait())
+	require.False(t, cmd.ProcessState.Success())
+	raw, err = os.ReadFile(filepath.Join(dir, "prepared.json"))
+	require.NoError(t, err)
+	var saved fullFileCrashReceipt
+	require.NoError(t, json.Unmarshal(raw, &saved))
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	sdk, err := anysyncsdk.Open(ctx, nativeConfig(setup.Directory, setup.Network), seeds)
+	require.NoError(t, err)
+	defer sdk.Close()
+	sp, err := sdk.Spaces().Get(ctx, saved.SpaceID)
+	require.NoError(t, err)
+	native := sp.Files().(space.PreparedFileService)
+	status, err := native.MigrationFileStatus(ctx, saved.Input.IntentID)
+	require.NoError(t, err)
+	require.Equal(t, saved.Receipt, status)
+	commit := commitOf(saved.Input, saved.Receipt.MigrationReceipt)
+	_, err = native.CommitMigrationFile(ctx, commit)
+	require.NoError(t, err)
+	complete, err := native.CommitMigrationFile(ctx, commit)
+	require.NoError(t, err)
+	require.True(t, complete.LocalFileComplete)
+	require.Equal(t, saved.Receipt.RootCID, complete.RootCID)
+	require.Equal(t, saved.Receipt.ChangeID, complete.ChangeID)
+	readFullFile(t, ctx, sp, complete, saved.Spec)
+	t.Log("full_file_crash actual_process_killed=true graceful_sdk_close=false original_car_and_signed_intent_recovered=true bytes=2097152")
+}
