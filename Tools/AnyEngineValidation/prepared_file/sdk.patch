+package space
+
+import (
+	"context"
+	"github.com/anyproto/any-sync-sdk/internal/migrationintent"
+	"io"
+)
+
+var ErrMigrationFileContent = migrationintent.ErrFileContent
+
+// PreparedFileService is an experimental, native-only Files() surface.
+// It is separate from the original-inline-file contract. It stages bounded
+// encrypted CAR bytes and reserves exactly one signed full-tier payload row.
+// Completion proves local bytes; NetworkVerified remains separate.
+type PreparedFileService interface {
+	PrepareMigrationFile(context.Context, MigrationInput, MigrationFileSpec, io.Reader) (MigrationFileReceipt, error)
+	MigrationFileStatus(context.Context, string) (MigrationFileReceipt, error)
+	CommitMigrationFile(context.Context, MigrationCommit) (MigrationFileReceipt, error)
+}
+
+type MigrationFileSpec struct {
+	OwnerObjectID string `json:"ownerObjectId"`
+	Name          string `json:"name"`
+	Mime          string `json:"mime"`
+	Size          int64  `json:"size"`
+	ContentSHA256 string `json:"contentSHA256"`
+}
+
+// Both native identities are reserved before the first commit. ChangeID is
+// always the signed row CID; ObjectID is the deterministic payloads root.
+// One commit advances file-prepared -> file-root-committed, the second
+// advances to complete. Existing roots start at file-root-committed.
+type MigrationFileReceipt struct {
+	MigrationReceipt
+	OwnerObjectID     string `json:"ownerObjectId"`
+	FileID            string `json:"fileId"`
+	ContentSHA256     string `json:"contentSHA256"`
+	Size              int64  `json:"size"`
+	RootCID           string `json:"rootCid"`
+	LocalFileComplete bool   `json:"localFileComplete"`
+	NetworkVerified   bool   `json:"networkVerified"`
+}
