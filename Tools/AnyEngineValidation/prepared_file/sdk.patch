diff --git a/internal/commitguard/prepared_file.go b/internal/commitguard/prepared_file.go
new file mode 100644
index 0000000..b21a5a3
--- /dev/null
+++ b/internal/commitguard/prepared_file.go
@@ -0,0 +1,157 @@
+package commitguard
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"github.com/ipfs/go-cid"
+	"math"
+
+	"github.com/anyproto/any-store/v2/anyenc"
+	"github.com/anyproto/any-sync-sdk/internal/crdt"
+	"github.com/anyproto/any-sync-sdk/internal/payloads"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/commonspace/spacestorage"
+	"github.com/anyproto/any-sync/util/crypto"
+)
+
+// FileEnvelope is private SDK preparation metadata. It is never an
+// HTTP input. The exact payload bytes come from the native immutable ledger.
+type FileEnvelope struct {
+	InlineFileEnvelope
+	RootCID, ContentSHA256 string
+	Key                    []byte
+	Size                   int64
+}
+
+// This strict full-tier parser admits one original payload row with one
+// immutable staged content root and sealed key/hash. Inline/variant/network
+// fields cannot enter the initial prepared append through this boundary.
+// The caller holds the ACL lock through this check and the final native tx.
+func filePayloadLocked(acl list.AclList, proof FileEnvelope) (payloads.EncPayload, error) {
+	bad := func() (payloads.EncPayload, error) { return payloads.EncPayload{}, ErrNativeCommitGuard }
+	v, err := anyenc.Parse(proof.Payload)
+	if err != nil || !exactInlineFields(v, "d", "v", "r") || v.GetString("d") != payloads.Dataset || v.GetString("v") != payloads.HandlerVersion {
+		return bad()
+	}
+	records := v.GetArray("r")
+	if len(records) != 1 || !exactInlineFields(records[0], "u", "o") || !records[0].GetBool("u") {
+		return bad()
+	}
+	ops := records[0].GetArray("o")
+	if len(ops) != 1 || !exactInlineFields(ops[0], "t", "v") || ops[0].GetString("t") != string(crdt.OpSet) {
+		return bad()
+	}
+	row := ops[0].Get("v")
+	if !exactInlineFields(row, payloads.FieldSize, payloads.FieldObjectId, payloads.FieldEnc, payloads.FieldRootCid) || row.GetString(payloads.FieldObjectId) != proof.OwnerID {
+		return bad()
+	}
+	size := row.Get(payloads.FieldSize)
+	if size.Type() != anyenc.TypeNumber || size.GetFloat64() < payloads.InlineMaxSize || size.GetFloat64() > 512<<20 || int64(size.GetFloat64()) != proof.Size || math.Trunc(size.GetFloat64()) != size.GetFloat64() {
+		return bad()
+	}
+	root, rootErr := cid.Decode(row.GetString(payloads.FieldRootCid))
+	if rootErr != nil || !root.Defined() || root.String() != proof.RootCID || row.GetString(payloads.FieldRootCid) != proof.RootCID || len(proof.Key) != 32 {
+		return bad()
+	}
+	enc := row.Get(payloads.FieldEnc)
+	if !exactInlineFields(enc, payloads.EncKeyId, payloads.EncKeyCiphertext) || enc.GetString(payloads.EncKeyId) != proof.ReadKeyID || enc.Get(payloads.EncKeyCiphertext).Type() != anyenc.TypeBinary {
+		return bad()
+	}
+	keys, ok := acl.AclState().Keys()[proof.ReadKeyID]
+	if !ok || keys.ReadKey == nil {
+		return payloads.EncPayload{}, list.ErrNoReadKey
+	}
+	key, err := payloads.DeriveEncKey(keys.ReadKey)
+	if err != nil {
+		return payloads.EncPayload{}, err
+	}
+	plain, err := payloads.UnsealEnc(key, enc.GetBytes(payloads.EncKeyCiphertext))
+	if err != nil {
+		return payloads.EncPayload{}, err
+	}
+	if len(plain.Key) != 32 || !bytes.Equal(plain.Key, proof.Key) || plain.Variant != "" || plain.VariantOf != "" || len(plain.Inline) != 0 ||
+		len(plain.SHA256) != 32 || hex.EncodeToString(plain.SHA256) != proof.ContentSHA256 {
+		return bad()
+	}
+	return plain, nil
+}
+
+// CheckPreparedFile checks the signed envelope against reserved bytes
+// and the native sealed member-only content. Current authority is always
+// required. Only an already committed known CID may use a historical key.
+func CheckPreparedFile(ctx context.Context, acl list.AclList, author crypto.PubKey, root, raw *treechangeproto.RawTreeChangeWithId, proof FileEnvelope, current bool) (payloads.EncPayload, error) {
+	if ctx == nil || acl == nil {
+		return payloads.EncPayload{}, ErrNativeCommitGuard
+	}
+	ch, err := inlineEnvelope(root, raw, author, proof.InlineFileEnvelope)
+	if err != nil {
+		return payloads.EncPayload{}, err
+	}
+	acl.RLock()
+	defer acl.RUnlock()
+	if err = ctx.Err(); err != nil {
+		return payloads.EncPayload{}, err
+	}
+	if !acl.AclState().Permissions(author).CanWrite() {
+		return payloads.EncPayload{}, list.ErrInsufficientPermissions
+	}
+	if current && (acl.Head() == nil || ch.AclHeadId != acl.Head().Id || proof.ReadKeyID != acl.AclState().CurrentReadKeyId()) {
+		return payloads.EncPayload{}, ErrNativeACLChanged
+	}
+	return filePayloadLocked(acl, proof)
+}
+
+func PreparedFileContext(ctx context.Context, tree objecttree.ObjectTree, author crypto.PubKey, raw *treechangeproto.RawTreeChangeWithId, proof FileEnvelope) (context.Context, *Guard, error) {
+	appendCtx, guard, err := Context(ctx, tree, author)
+	if err != nil {
+		return nil, nil, err
+	}
+	if _, err = CheckPreparedFile(ctx, tree.AclList(), author, tree.Header(), raw, proof, true); err != nil {
+		return nil, nil, err
+	}
+	ch, err := inlineEnvelope(tree.Header(), raw, author, proof.InlineFileEnvelope)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !sameHeads(ch.PreviousIds, tree.Heads()) {
+		return nil, nil, ErrNativeCommitGuard
+	}
+	proof.Payload = bytes.Clone(proof.Payload)
+	proof.Key = bytes.Clone(proof.Key)
+	guard.file = &proof
+	guard.preparedRaw = &treechangeproto.RawTreeChangeWithId{Id: raw.Id, RawChange: bytes.Clone(raw.RawChange)}
+	return appendCtx, guard, nil
+}
+
+// StorePreparedFileRoot only registers the already reserved deterministic
+// payloads root. Its owner must be locked/live by the native Store caller.
+// ACL/key validity is held through the real root storage transaction.
+func StorePreparedFileRoot(ctx context.Context, storage spacestorage.SpaceStorage, acl list.AclList, author crypto.PubKey, root, raw *treechangeproto.RawTreeChangeWithId, proof FileEnvelope) error {
+	if ctx == nil || storage == nil || acl == nil || storage.Id() != proof.SpaceID {
+		return ErrNativeCommitGuard
+	}
+	ch, err := inlineEnvelope(root, raw, author, proof.InlineFileEnvelope)
+	if err != nil {
+		return err
+	}
+	acl.RLock()
+	defer acl.RUnlock()
+	if err = ctx.Err(); err != nil {
+		return err
+	}
+	if !acl.AclState().Permissions(author).CanWrite() {
+		return list.ErrInsufficientPermissions
+	}
+	if acl.Head() == nil || ch.AclHeadId != acl.Head().Id || proof.ReadKeyID != acl.AclState().CurrentReadKeyId() {
+		return ErrNativeACLChanged
+	}
+	if _, err = filePayloadLocked(acl, proof); err != nil {
+		return err
+	}
+	_, err = storage.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{RootRawChange: root, Changes: []*treechangeproto.RawTreeChangeWithId{root}, Heads: []string{root.Id}})
+	return err
+}
diff --git a/internal/files/store/migration_prepared_pin.go b/internal/files/store/migration_prepared_pin.go
new file mode 100644
index 0000000..0e71d95
--- /dev/null
+++ b/internal/files/store/migration_prepared_pin.go
@@ -0,0 +1,182 @@
+package store
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+
+	anystore "github.com/anyproto/any-store/v2"
+	"github.com/ipfs/go-cid"
+)
+
+// ErrPreparedPayloadPinned protects the only local copy of an uncommitted
+// migration payload. These pins have no age-based expiry: unlike ordinary
+// attach markers, a prepared operation may legitimately wait for a commit.
+var ErrPreparedPayloadPinned = errors.New("filestore: prepared migration payload is pinned")
+
+func preparedPinPrefix(spaceID string) string     { return "migration-prepared/" + spaceID + "/" }
+func preparedAdoptedPrefix(spaceID string) string { return "migration-adopted/" + spaceID + "/" }
+
+func preparedPinKey(spaceID string, root cid.Cid) string {
+	return preparedPinPrefix(spaceID) + root.String()
+}
+
+func (s *Store) PreparedPayloadAdopted(ctx context.Context, spaceID string, root cid.Cid, fileID, intentID, fingerprint string) (bool, error) {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil || fileID == "" {
+		return false, ErrPreparedPayloadPinned
+	}
+	got, found, err := s.GetKV(ctx, preparedAdoptedPrefix(spaceID)+root.String()+"/"+fileID)
+	if err != nil || !found {
+		return false, err
+	}
+	if got != want {
+		return false, ErrPreparedPayloadPinned
+	}
+	pinned, err := s.PreparedPayloadPinned(ctx, spaceID, root)
+	return !pinned, err
+}
+
+// All callers first establish refs, content metadata and the queue job in the
+// same local database. Checkpoint those writes before releasing the only-copy
+// pin, then checkpoint the release before acknowledging local completion.
+func (s *Store) CompletePreparedPayloadAdoption(ctx context.Context, spaceID string, root cid.Cid, fileID, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil || fileID == "" {
+		return ErrPreparedPayloadPinned
+	}
+	if err = s.SetKV(ctx, preparedAdoptedPrefix(spaceID)+root.String()+"/"+fileID, want); err != nil {
+		return err
+	}
+	if err = s.FlushPreparedPayload(ctx, spaceID, root, intentID, fingerprint); err != nil {
+		return err
+	}
+	if err = s.ReleasePreparedPayload(ctx, spaceID, root, intentID, fingerprint); err != nil {
+		return err
+	}
+	return s.db.Flush(ctx, 0, anystore.FlushModeCheckpointFull)
+}
+
+func preparedPinValue(intentID, fingerprint string) (string, error) {
+	for _, v := range []string{intentID, fingerprint} {
+		b, err := hex.DecodeString(v)
+		if err != nil || len(b) != 32 || hex.EncodeToString(b) != v {
+			return "", ErrPreparedPayloadPinned
+		}
+	}
+	return intentID + ":" + fingerprint, nil
+}
+
+// PinPreparedPayload is called before finalizing the new CAR. The same row
+// lock fences Offload/Delete, so neither GC nor an explicit cache eviction
+// can pass a no-pin check concurrently with preparation.
+func (s *Store) PinPreparedPayload(ctx context.Context, spaceID string, root cid.Cid, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil || !root.Defined() || spaceID == "" || spaceID == "." || spaceID == ".." || strings.ContainsAny(spaceID, "/\\\x00") {
+		return ErrPreparedPayloadPinned
+	}
+	return s.withRow(rowId(spaceID, root), func(_ *rowState) error {
+		tx, err := s.db.WriteTx(ctx)
+		if err != nil {
+			return err
+		}
+		defer tx.Rollback()
+		tc := tx.Context()
+		old, found, err := s.GetKV(tc, preparedPinKey(spaceID, root))
+		if err != nil {
+			return err
+		}
+		if found && old != want {
+			return ErrPreparedPayloadPinned
+		}
+		if err = s.SetKV(tc, preparedPinKey(spaceID, root), want); err != nil {
+			return err
+		}
+		return tx.Commit()
+	})
+}
+
+func (s *Store) PreparedPayloadPinned(ctx context.Context, spaceID string, root cid.Cid) (bool, error) {
+	_, found, err := s.GetKV(ctx, preparedPinKey(spaceID, root))
+	return found, err
+}
+
+// Release is scoped to the exact original intent and normalized fingerprint.
+// A caller cannot release another migration's reservation, even for one root.
+func (s *Store) ReleasePreparedPayload(ctx context.Context, spaceID string, root cid.Cid, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil {
+		return err
+	}
+	return s.withRow(rowId(spaceID, root), func(_ *rowState) error {
+		old, found, err := s.GetKV(ctx, preparedPinKey(spaceID, root))
+		if err != nil {
+			return err
+		}
+		if !found {
+			return nil
+		}
+		if old != want {
+			return ErrPreparedPayloadPinned
+		}
+		return s.DeleteKV(ctx, preparedPinKey(spaceID, root))
+	})
+}
+
+// FlushPreparedPayload persists the CAR, its directory chain and the pin/row
+// database before a prepared native row may acknowledge this payload.
+func (s *Store) FlushPreparedPayload(ctx context.Context, spaceID string, root cid.Cid, intentID, fingerprint string) error {
+	want, err := preparedPinValue(intentID, fingerprint)
+	if err != nil {
+		return err
+	}
+	return s.withRow(rowId(spaceID, root), func(_ *rowState) error {
+		old, found, err := s.GetKV(ctx, preparedPinKey(spaceID, root))
+		if err != nil {
+			return err
+		}
+		if !found || old != want {
+			return ErrPreparedPayloadPinned
+		}
+		if err = ctx.Err(); err != nil {
+			return err
+		}
+		path := s.carPath(spaceID, root)
+		f, err := os.OpenFile(path, os.O_RDWR, 0)
+		if err != nil {
+			return err
+		}
+		err = errors.Join(f.Sync(), f.Close())
+		if err != nil {
+			return err
+		}
+		stop, err := filepath.Abs(s.root)
+		if err != nil {
+			return err
+		}
+		for dir := filepath.Dir(path); ; dir = filepath.Dir(dir) {
+			absolute, err := filepath.Abs(dir)
+			if err != nil {
+				return err
+			}
+			if absolute != stop && !strings.HasPrefix(absolute, stop+string(os.PathSeparator)) {
+				return ErrPreparedPayloadPinned
+			}
+			d, err := os.Open(dir)
+			if err != nil {
+				return err
+			}
+			err = errors.Join(d.Sync(), d.Close())
+			if err != nil {
+				return err
+			}
+			if absolute == stop {
+				break
+			}
+		}
+		return s.db.Flush(ctx, 0, anystore.FlushModeCheckpointFull)
+	})
+}
