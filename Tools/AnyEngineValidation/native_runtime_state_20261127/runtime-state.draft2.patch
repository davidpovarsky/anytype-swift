+func TestRuntimeCoordinatorRejectsMalformedAndForeignCachedAnswers(t *testing.T) {
+	key := runtimeTestKey()
+	snapshot := runtimeCoordinatorSnapshot(&coordinatorproto.SpaceStatusPayload{
