diff --git a/core/application/owned_annotation_revision.go b/core/application/owned_annotation_revision.go
new file mode 100644
index 000000000..2565a8716
--- /dev/null
+++ b/core/application/owned_annotation_revision.go
@@ -0,0 +1,148 @@
+package application
+
+import (
+	"context"
+	"crypto/subtle"
+	"errors"
+
+	"github.com/anyproto/any-sync/app"
+	"github.com/gogo/protobuf/proto"
+
+	importer "github.com/anyproto/anytype-heart/core/block/import"
+	walletComp "github.com/anyproto/anytype-heart/core/wallet"
+	"github.com/anyproto/anytype-heart/pkg/lib/pb/model"
+)
+
+type ownedAccountAnnotationRevision struct {
+	app                *app.App
+	accountID, spaceID string
+	operation          *importer.OwnedAnnotationRevisionOperation
+	annotation         ownedAnnotationCancellationBinding
+}
+type OwnedAnnotationRevisionCompletion struct {
+	registered, done, observed, cancellationRequested bool
+	result                                            []byte
+	rootID                                            string
+	report                                            *model.ExportReport
+}
+
+func (c OwnedAnnotationRevisionCompletion) Registered() bool { return c.registered }
+func (c OwnedAnnotationRevisionCompletion) Done() bool       { return c.done }
+func (c OwnedAnnotationRevisionCompletion) Observed() bool   { return c.observed }
+func (c OwnedAnnotationRevisionCompletion) CancellationRequested() bool {
+	return c.cancellationRequested
+}
+func (c OwnedAnnotationRevisionCompletion) Result() []byte { return append([]byte(nil), c.result...) }
+func (c OwnedAnnotationRevisionCompletion) RootID() string { return c.rootID }
+func (c OwnedAnnotationRevisionCompletion) ExportReport() *model.ExportReport {
+	if c.report == nil {
+		return nil
+	}
+	return proto.Clone(c.report).(*model.ExportReport)
+}
+
+func (s *Service) prepareOwnedAccountAnnotationRevision(ctx context.Context, accountID string, raw []byte, digest [32]byte, sourceRootID, sourceSpaceID, targetSpaceID string, secret [32]byte) (*ownedAccountAnnotationRevision, error) {
+	if s == nil || ctx == nil || accountID == "" || secret == ([32]byte{}) {
+		return nil, importer.ErrAnnotationRevisionInvalid
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if !s.lock.TryRLock() {
+		return nil, ErrOwnedImportAdmissionUnavailable
+	}
+	defer s.lock.RUnlock()
+	if s.app == nil {
+		return nil, ErrOwnedImportAdmissionUnavailable
+	}
+	wallet, ok := s.app.Component(walletComp.CName).(walletComp.Wallet)
+	if !ok || wallet == nil || wallet.GetAccountPrivkey().GetPublic().Account() != accountID ||
+		s.accountLease == nil || !s.accountLease.Matches(wallet.RootPath(), accountID) || !s.accountLease.Usable() {
+		return nil, ErrOwnedImportAdmissionUnavailable
+	}
+	registry := &s.ownedImports
+	registry.mu.Lock()
+	defer registry.mu.Unlock()
+	registry.pruneDrainedLocked()
+	if registry.pending || registry.retirements != 0 {
+		return nil, ErrOwnedImportAdmissionUnavailable
+	}
+	for active := range registry.operations {
+		if active.annotation != nil && subtle.ConstantTimeCompare(active.annotation.secret[:], secret[:]) == 1 {
+			return nil, ErrOwnedAnnotationAttemptConflict
+		}
+	}
+	for active := range registry.revisions {
+		if subtle.ConstantTimeCompare(active.annotation.secret[:], secret[:]) == 1 {
+			return nil, ErrOwnedAnnotationAttemptConflict
+		}
+	}
+	operation, err := importer.PrepareOwnedAnnotationRevision(ctx, s.app, raw, digest, sourceRootID, sourceSpaceID, targetSpaceID)
+	if err != nil {
+		return nil, err
+	}
+	owned := &ownedAccountAnnotationRevision{app: s.app, accountID: accountID, spaceID: targetSpaceID, operation: operation,
+		annotation: ownedAnnotationCancellationBinding{secret: secret, sourceDigest: digest, sourceRootID: sourceRootID, sourceSpaceID: sourceSpaceID}}
+	if registry.revisions == nil {
+		registry.revisions = make(map[*ownedAccountAnnotationRevision]struct{})
+	}
+	registry.revisions[owned] = struct{}{}
+	return owned, nil
+}
+
+func (s *Service) ReviseOwnedAnnotation(ctx context.Context, accountID string, raw []byte, digest [32]byte, sourceRootID, sourceSpaceID, targetSpaceID string, secret [32]byte) (OwnedAnnotationRevisionCompletion, error) {
+	var completion OwnedAnnotationRevisionCompletion
+	owned, err := s.prepareOwnedAccountAnnotationRevision(ctx, accountID, raw, digest, sourceRootID, sourceSpaceID, targetSpaceID, secret)
+	if err != nil {
+		return completion, err
+	}
+	completion.registered = true
+	// Native work starts only after actual registration and both locks release.
+	owned.operation.Start()
+	select {
+	case <-owned.operation.Done():
+	case <-ctx.Done():
+		owned.operation.RequestCancel()
+		<-owned.operation.Done()
+	}
+	result, err, done := owned.operation.Result()
+	if !done {
+		return completion, errors.New("original revision did not drain")
+	}
+	completion.done, completion.result = true, result
+	completion.observed, completion.rootID, completion.report = owned.operation.Observation()
+	completion.cancellationRequested = owned.operation.CancellationRequested()
+	registry := &s.ownedImports
+	registry.mu.Lock()
+	delete(registry.revisions, owned)
+	registry.mu.Unlock()
+	return completion, err
+}
+func (s *Service) CancelOwnedAnnotationRevision(accountID, sourceRootID, sourceSpaceID, targetSpaceID string, digest, secret [32]byte) OwnedAnnotationCancelDisposition {
+	if s == nil || secret == ([32]byte{}) {
+		return OwnedAnnotationCancelNotObserved
+	}
+	registry := &s.ownedImports
+	registry.mu.Lock()
+	var operation *importer.OwnedAnnotationRevisionOperation
+	for owned := range registry.revisions {
+		binding := owned.annotation
+		if owned.app != nil && owned.accountID == accountID && owned.spaceID == targetSpaceID &&
+			binding.sourceRootID == sourceRootID && binding.sourceSpaceID == sourceSpaceID &&
+			subtle.ConstantTimeCompare(binding.sourceDigest[:], digest[:]) == 1 && subtle.ConstantTimeCompare(binding.secret[:], secret[:]) == 1 {
+			operation = owned.operation
+			break
+		}
+	}
+	registry.mu.Unlock()
+	if operation == nil {
+		return OwnedAnnotationCancelNotObserved
+	}
+	select {
+	case <-operation.Done():
+		return OwnedAnnotationCancelDoneObserved
+	default:
+	}
+	operation.RequestCancel()
+	return OwnedAnnotationCancelRequested
+}
