diff --git a/core/block/import/owned_annotation_revision.go b/core/block/import/owned_annotation_revision.go
new file mode 100644
index 000000000..d25a7896a
--- /dev/null
+++ b/core/block/import/owned_annotation_revision.go
@@ -0,0 +1,693 @@
+// A separate versioned original native revision operation. Import-v1 is unchanged.
+package importer
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"slices"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"unicode/utf8"
+
+	"github.com/anyproto/any-sync/app"
+	"github.com/gogo/protobuf/proto"
+	"github.com/google/uuid"
+
+	"github.com/anyproto/anytype-heart/core/anytype/account"
+	"github.com/anyproto/anytype-heart/core/block/cache"
+	"github.com/anyproto/anytype-heart/core/block/editor/smartblock"
+	"github.com/anyproto/anytype-heart/core/block/editor/state"
+	"github.com/anyproto/anytype-heart/core/block/export"
+	"github.com/anyproto/anytype-heart/core/converter/pbc"
+	"github.com/anyproto/anytype-heart/core/domain"
+	annotationschema "github.com/anyproto/anytype-heart/core/pinkha/annotationschema/definition"
+	"github.com/anyproto/anytype-heart/pb"
+	coresb "github.com/anyproto/anytype-heart/pkg/lib/core/smartblock"
+	"github.com/anyproto/anytype-heart/pkg/lib/pb/model"
+	"github.com/anyproto/anytype-heart/space"
+	"github.com/anyproto/anytype-heart/space/spacedomain"
+)
+
+const AnnotationRevisionProtocol = "pinkha.annotation.revision.v1"
+const AnnotationRevisionEnvelopeMaximum = 2 << 20
+const annotationRevisionResponseMaximum = (2 << 20) - (32 << 10)
+
+var ErrAnnotationRevisionInvalid = errors.New("invalid bounded annotation revision")
+var ErrAnnotationRevisionConflict = errors.New("native annotation revision conflict")
+var ErrAnnotationRevisionUnconfirmed = errors.New("native annotation write requires readback")
+var ErrAnnotationRevisionUnsupported = errors.New("annotation revision graph is not safely representable")
+
+type annotationRevisionRequest struct {
+	Schema               int      `json:"schema"`
+	Operation            string   `json:"operation"`
+	TargetRootID         string   `json:"target_root_id"`
+	AnnotationUUID       string   `json:"annotation_uuid"`
+	ExpectedHeads        []string `json:"expected_heads,omitempty"`
+	ExpectedRootSHA256   string   `json:"expected_root_sha256,omitempty"`
+	DesiredArchive       []byte   `json:"desired_archive,omitempty"`
+	DesiredArchiveSHA256 string   `json:"desired_archive_sha256,omitempty"`
+}
+
+type annotationRevisionMapping struct {
+	SourceSpaceID  string `json:"source_space_id"`
+	SourceObjectID string `json:"source_object_id"`
+	ObjectID       string `json:"object_id"`
+}
+type annotationRevisionResult struct {
+	Schema               int                         `json:"schema"`
+	Operation            string                      `json:"operation"`
+	Status               string                      `json:"status"`
+	AccountID            string                      `json:"account_id"`
+	SpaceID              string                      `json:"space_id"`
+	RootID               string                      `json:"root_id"`
+	AnnotationUUID       string                      `json:"annotation_uuid"`
+	BeforeHeads          []string                    `json:"before_heads,omitempty"`
+	Heads                []string                    `json:"heads,omitempty"`
+	RootSnapshotSHA256   string                      `json:"root_snapshot_sha256,omitempty"`
+	NativeArchive        []byte                      `json:"native_archive,omitempty"`
+	NativeArchiveSHA256  string                      `json:"native_archive_sha256,omitempty"`
+	SourceArchiveSHA256  string                      `json:"source_archive_sha256,omitempty"`
+	Mappings             []annotationRevisionMapping `json:"mappings,omitempty"`
+	NativeWriteObserved  bool                        `json:"native_write_observed"`
+	NativeApplyAttempted bool                        `json:"native_apply_attempted"`
+}
+
+// This operation cannot be constructed from caller completion functions or flags.
+// Only the original application components and original cache/state/Apply run it.
+type OwnedAnnotationRevisionOperation struct {
+	ctx                                      context.Context
+	cancel                                   context.CancelFunc
+	requested                                atomic.Bool
+	once                                     sync.Once
+	done                                     chan struct{}
+	owner                                    *ownedAnnotationGraph
+	getter                                   cache.ObjectGetter
+	request                                  annotationRevisionRequest
+	sourceRootID, sourceSpaceID, privateRoot string
+	result                                   []byte
+	observed                                 bool
+	exportReport                             *model.ExportReport
+	err                                      error
+}
+
+func revisionText(value string) bool {
+	return value != "" && len(value) <= 1<<14 && utf8.ValidString(value) && !strings.ContainsRune(value, 0)
+}
+func revisionHash(value string) bool {
+	if len(value) != 64 || strings.ToLower(value) != value {
+		return false
+	}
+	decoded, err := hex.DecodeString(value)
+	return err == nil && len(decoded) == 32
+}
+func revisionHeads(heads []string) bool {
+	if len(heads) == 0 || len(heads) > 64 {
+		return false
+	}
+	for i, head := range heads {
+		if !revisionText(head) || len(head) > 512 || (i > 0 && heads[i-1] >= head) {
+			return false
+		}
+	}
+	return true
+}
+
+// JSON duplicate keys are rejected before typed decoding, including nested input.
+func revisionJSONValue(dec *json.Decoder, depth int, fields *int) error {
+	if depth > 16 || *fields > 8192 {
+		return ErrAnnotationRevisionInvalid
+	}
+	tok, err := dec.Token()
+	if err != nil {
+		return err
+	}
+	delim, container := tok.(json.Delim)
+	if !container {
+		return nil
+	}
+	switch delim {
+	case '{':
+		seen := map[string]bool{}
+		for dec.More() {
+			key, err := dec.Token()
+			if err != nil {
+				return err
+			}
+			name, ok := key.(string)
+			if !ok || seen[name] {
+				return ErrAnnotationRevisionInvalid
+			}
+			// encoding/json otherwise accepts case-insensitive aliases for tagged
+			// struct fields. The versioned wire contract has exact field names.
+			if depth == 0 {
+				switch name {
+				case "schema", "operation", "target_root_id", "annotation_uuid", "expected_heads", "expected_root_sha256", "desired_archive", "desired_archive_sha256":
+				default:
+					return ErrAnnotationRevisionInvalid
+				}
+			}
+			seen[name] = true
+			*fields++
+			if err := revisionJSONValue(dec, depth+1, fields); err != nil {
+				return err
+			}
+		}
+		end, err := dec.Token()
+		if err != nil || end != json.Delim('}') {
+			return ErrAnnotationRevisionInvalid
+		}
+	case '[':
+		for dec.More() {
+			*fields++
+			if err := revisionJSONValue(dec, depth+1, fields); err != nil {
+				return err
+			}
+		}
+		end, err := dec.Token()
+		if err != nil || end != json.Delim(']') {
+			return ErrAnnotationRevisionInvalid
+		}
+	default:
+		return ErrAnnotationRevisionInvalid
+	}
+	return nil
+}
+
+func decodeAnnotationRevision(raw []byte, digest [32]byte) (annotationRevisionRequest, error) {
+	var result annotationRevisionRequest
+	if len(raw) == 0 || len(raw) > AnnotationRevisionEnvelopeMaximum || sha256.Sum256(raw) != digest {
+		return result, ErrAnnotationRevisionInvalid
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	dec.UseNumber()
+	count := 0
+	if err := revisionJSONValue(dec, 0, &count); err != nil {
+		return result, ErrAnnotationRevisionInvalid
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return result, ErrAnnotationRevisionInvalid
+	}
+	dec = json.NewDecoder(bytes.NewReader(raw))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&result); err != nil {
+		return result, ErrAnnotationRevisionInvalid
+	}
+	parsed, err := uuid.Parse(result.AnnotationUUID)
+	if result.Schema != 1 || err != nil || parsed == uuid.Nil || !revisionText(result.TargetRootID) {
+		return result, ErrAnnotationRevisionInvalid
+	}
+	switch result.Operation {
+	case "read":
+		if len(result.ExpectedHeads) != 0 || result.ExpectedRootSHA256 != "" || len(result.DesiredArchive) != 0 || result.DesiredArchiveSHA256 != "" {
+			return result, ErrAnnotationRevisionInvalid
+		}
+	case "replace":
+		if !revisionHeads(result.ExpectedHeads) || !revisionHash(result.ExpectedRootSHA256) || !revisionHash(result.DesiredArchiveSHA256) || len(result.DesiredArchive) < 22 || len(result.DesiredArchive) > ownedArchiveMaxBytes {
+			return result, ErrAnnotationRevisionInvalid
+		}
+		actual := sha256.Sum256(result.DesiredArchive)
+		if hex.EncodeToString(actual[:]) != result.DesiredArchiveSHA256 {
+			return result, ErrAnnotationRevisionInvalid
+		}
+	default:
+		return result, ErrAnnotationRevisionInvalid
+	}
+	return result, nil
+}
+
+// Preparation does no Space/object loading. Service registers this actual owner
+// before Start, without retaining Service or registry locks over native callbacks.
+func PrepareOwnedAnnotationRevision(ctx context.Context, a *app.App, raw []byte, digest [32]byte, sourceRootID, sourceSpaceID, targetSpaceID string) (*OwnedAnnotationRevisionOperation, error) {
+	if ctx == nil || a == nil || !revisionText(sourceRootID) || !revisionText(sourceSpaceID) || !revisionText(targetSpaceID) {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	request, err := decodeAnnotationRevision(raw, digest)
+	if err != nil {
+		return nil, err
+	}
+	if request.Operation == "read" && (sourceRootID != request.TargetRootID || sourceSpaceID != targetSpaceID) {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	ownedCtx, cancel := context.WithCancel(ctx)
+	var owner *ownedAnnotationGraph
+	if request.Operation == "replace" {
+		archiveDigest := sha256.Sum256(request.DesiredArchive)
+		owner, err = prepareOwnedAnnotationGraph(ownedCtx, a, request.DesiredArchive, archiveDigest, sourceRootID, sourceSpaceID, targetSpaceID)
+		if err != nil {
+			cancel()
+			return nil, err
+		}
+	} else {
+		accounts := app.MustComponent[account.Service](a)
+		spaces := app.MustComponent[space.Service](a)
+		if accounts == nil || accounts.Keys() == nil || accounts.Keys().SignKey == nil || spaces == nil {
+			cancel()
+			return nil, ErrAnnotationRevisionInvalid
+		}
+		owner = &ownedAnnotationGraph{ctx: ownedCtx, account: accounts, accountID: accounts.AccountID(), identity: accounts.Keys().SignKey.GetPublic(), spaces: spaces, spaceID: targetSpaceID, exporter: app.MustComponent[export.Export](a)}
+	}
+	root, err := os.MkdirTemp("", "anytype-annotation-revision-")
+	if err != nil {
+		if owner.stage != nil {
+			_ = owner.stage.Close()
+		}
+		cancel()
+		return nil, err
+	}
+	return &OwnedAnnotationRevisionOperation{ctx: ownedCtx, cancel: cancel, done: make(chan struct{}), owner: owner, getter: app.MustComponent[cache.ObjectGetter](a), request: request, sourceRootID: sourceRootID, sourceSpaceID: sourceSpaceID, privateRoot: root}, nil
+}
+func (o *OwnedAnnotationRevisionOperation) TargetSpaceID() string { return o.owner.spaceID }
+func (o *OwnedAnnotationRevisionOperation) Done() <-chan struct{} {
+	if o == nil {
+		return nil
+	}
+	return o.done
+}
+func (o *OwnedAnnotationRevisionOperation) RequestCancel() {
+	if o != nil && o.cancel != nil {
+		o.requested.Store(true)
+		o.cancel()
+	}
+}
+func (o *OwnedAnnotationRevisionOperation) CancellationRequested() bool {
+	return o != nil && o.requested.Load()
+}
+func (o *OwnedAnnotationRevisionOperation) Start() {
+	if o == nil || o.done == nil || o.owner == nil || o.getter == nil {
+		return
+	}
+	o.once.Do(func() {
+		go func() {
+			defer close(o.done)
+			defer o.cancel()
+			defer func() {
+				if o.owner.stage != nil {
+					o.err = errors.Join(o.err, o.owner.stage.Close())
+				}
+				o.err = errors.Join(o.err, os.RemoveAll(o.privateRoot))
+			}()
+			result, err := o.execute()
+			o.observed = len(result.Heads) > 0
+			raw, encodeErr := json.Marshal(result)
+			if encodeErr != nil || len(raw) > annotationRevisionResponseMaximum {
+				result.NativeArchive, result.Mappings = nil, nil
+				result.NativeArchiveSHA256 = ""
+				if result.NativeWriteObserved {
+					result.Status = "applied_unconfirmed"
+				} else {
+					result.Status = "refused"
+				}
+				raw, encodeErr = json.Marshal(result)
+				err = errors.Join(err, encodeErr, ErrAnnotationRevisionUnconfirmed)
+			}
+			o.result, o.err = raw, err
+		}()
+	})
+}
+func (o *OwnedAnnotationRevisionOperation) Result() ([]byte, error, bool) {
+	if o == nil || o.done == nil {
+		return nil, ErrAnnotationRevisionInvalid, false
+	}
+	select {
+	case <-o.done:
+		return bytes.Clone(o.result), o.err, true
+	default:
+		return nil, nil, false
+	}
+}
+
+func (o *OwnedAnnotationRevisionOperation) exportRoot(label string) (*ownedAnnotationArchive, error) {
+	if err := o.owner.requireCurrentWriter(o.ctx); err != nil {
+		return nil, err
+	}
+	directory := filepath.Join(o.privateRoot, label)
+	if err := os.Mkdir(directory, 0700); err != nil {
+		return nil, err
+	}
+	path, report, err := o.owner.exporter.Export(o.ctx, pb.RpcObjectListExportRequest{SpaceId: o.owner.spaceID, ObjectIds: []string{o.request.TargetRootID}, Path: directory, Format: model.Export_Protobuf, Zip: true, IncludeFiles: true, IncludeNested: true, IncludeArchived: true, NoProgress: true})
+	if err != nil || o.ctx.Err() != nil {
+		return nil, errors.Join(err, o.ctx.Err())
+	}
+	if report == nil || report.Status != model.ExportReport_SUCCESS || report.Succeed <= 0 || report.ObjectErrors != 0 || report.FileErrors != 0 || len(report.Issues) != 0 {
+		return nil, ErrAnnotationRevisionUnconfirmed
+	}
+	o.exportReport = proto.Clone(report).(*model.ExportReport)
+	raw, err := readOwnedAnnotationExport(o.ctx, directory, path)
+	if err != nil {
+		return nil, err
+	}
+	archive, err := inspectOwnedAnnotationArchive(o.ctx, raw, sha256.Sum256(raw), o.request.TargetRootID, o.owner.spaceID)
+	if err != nil {
+		return nil, err
+	}
+	if int(report.Succeed) != len(archive.snapshots) {
+		return nil, ErrAnnotationRevisionUnconfirmed
+	}
+	return archive, nil
+}
+
+func revisionSnapshot(b smartblock.SmartBlock) (*pb.SnapshotWithType, string, error) {
+	snapshot := &pb.SnapshotWithType{}
+	raw := pbc.NewConverter(b.NewState().Copy(), false).Convert(b.Type().ToProto())
+	if len(raw) == 0 || len(raw) > ownedArchiveMaxExpanded || proto.Unmarshal(raw, snapshot) != nil {
+		return nil, "", ErrAnnotationRevisionUnconfirmed
+	}
+	digest, err := revisionSnapshotDigest(snapshot)
+	return snapshot, digest, err
+}
+
+// Native Text.Diff calls marksEq, which sorts both mark arrays in place.
+// Mark inventory order therefore is not a persisted semantic ordering. Keep
+// every complete represented protobuf tuple (including multiplicity),
+// with exact range/type/parameter bytes, and sort only this inventory on a copy.
+// The original import-v1 comparator and child/text order remain unchanged.
+func canonicalRevisionSnapshot(snapshot *pb.SnapshotWithType) (*pb.SnapshotWithType, error) {
+	canonical, err := canonicalOwnedAnnotationSnapshot(snapshot)
+	if err != nil {
+		return nil, err
+	}
+	for _, block := range canonical.Snapshot.Data.Blocks {
+		marks := block.GetText().GetMarks()
+		if marks == nil {
+			continue
+		}
+		type tuple struct {
+			value *model.BlockContentTextMark
+			raw   []byte
+		}
+		ordered := make([]tuple, len(marks.Marks))
+		for i, mark := range marks.Marks {
+			if mark == nil {
+				return nil, ErrAnnotationRevisionInvalid
+			}
+			raw, err := proto.Marshal(mark)
+			if err != nil {
+				return nil, err
+			}
+			ordered[i] = tuple{mark, raw}
+		}
+		sort.SliceStable(ordered, func(i, j int) bool { return bytes.Compare(ordered[i].raw, ordered[j].raw) < 0 })
+		for i, item := range ordered {
+			marks.Marks[i] = item.value
+		}
+	}
+	return canonical, nil
+}
+
+func revisionSnapshotEqual(first, second *pb.SnapshotWithType) bool {
+	left, err := canonicalRevisionSnapshot(first)
+	if err != nil {
+		return false
+	}
+	right, err := canonicalRevisionSnapshot(second)
+	return err == nil && proto.Equal(left, right)
+}
+func revisionIdentity(snapshot *pb.SnapshotWithType, id, expectedUUID string) error {
+	if snapshot == nil || snapshot.Snapshot == nil || snapshot.Snapshot.Data == nil || snapshot.SbType != coresb.SmartBlockTypePage.ToProto() {
+		return ErrAnnotationRevisionInvalid
+	}
+	data := snapshot.Snapshot.Data
+	if len(data.ObjectTypes) != 1 || data.ObjectTypes[0] != annotationschema.TypeUniqueKey || data.Key != "" {
+		return ErrAnnotationRevisionInvalid
+	}
+	details := domain.NewDetailsFromProto(data.Details)
+	actual, err := uuid.Parse(details.GetString("pinkhaTorahAnnotationUUID"))
+	expected, parseErr := uuid.Parse(expectedUUID)
+	if err != nil || parseErr != nil || actual == uuid.Nil || actual != expected || details.GetString("pinkhaTorahAnnotationProtocol") != annotationschema.Protocol {
+		return ErrAnnotationRevisionInvalid
+	}
+	root := false
+	for _, block := range data.Blocks {
+		if block != nil && block.Id == id && block.GetSmartblock() != nil {
+			root = true
+		}
+	}
+	if !root {
+		return ErrAnnotationRevisionInvalid
+	}
+	return nil
+}
+func (o *OwnedAnnotationRevisionOperation) lockedObservation(b smartblock.SmartBlock) (*pb.SnapshotWithType, []string, string, error) {
+	if err := o.owner.requireCurrentWriter(o.ctx); err != nil {
+		return nil, nil, "", err
+	}
+	if b.Id() != o.request.TargetRootID || b.SpaceID() != o.owner.spaceID || b.IsDeleted() || b.Tree() == nil {
+		return nil, nil, "", ErrAnnotationRevisionInvalid
+	}
+	snapshot, digest, err := revisionSnapshot(b)
+	if err != nil {
+		return nil, nil, "", err
+	}
+	if err := revisionIdentity(snapshot, b.Id(), o.request.AnnotationUUID); err != nil {
+		return nil, nil, "", err
+	}
+	heads := slices.Clone(b.Tree().Heads())
+	sort.Strings(heads)
+	if !revisionHeads(heads) {
+		return nil, nil, "", ErrAnnotationRevisionUnconfirmed
+	}
+	return snapshot, heads, digest, nil
+}
+func (o *OwnedAnnotationRevisionOperation) execute() (annotationRevisionResult, error) {
+	result := annotationRevisionResult{Schema: 1, Operation: o.request.Operation, Status: "refused", AccountID: o.owner.accountID, SpaceID: o.owner.spaceID, RootID: o.request.TargetRootID, AnnotationUUID: o.request.AnnotationUUID, SourceArchiveSHA256: o.request.DesiredArchiveSHA256}
+	spc, err := o.owner.spaces.Get(o.ctx, o.owner.spaceID)
+	if err != nil {
+		return result, err
+	}
+	if spc == nil || spc.Id() != o.owner.spaceID || spc.SpaceType() != spacedomain.SpaceTypeRegular || spc.IsPersonal() {
+		return result, ErrAnnotationRevisionInvalid
+	}
+	o.owner.space = spc
+	if err := o.owner.requireCurrentWriter(o.ctx); err != nil {
+		return result, err
+	}
+	before, err := o.exportRoot("before")
+	if err != nil {
+		return result, err
+	}
+	if err := revisionIdentity(before.snapshots[o.request.TargetRootID], o.request.TargetRootID, o.request.AnnotationUUID); err != nil {
+		return result, err
+	}
+	if o.request.Operation == "read" {
+		ids := make([]string, 0, len(before.snapshots))
+		for id := range before.snapshots {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		for _, id := range ids {
+			result.Mappings = append(result.Mappings, annotationRevisionMapping{o.owner.spaceID, id, id})
+		}
+	}
+	var desired *state.State
+	if o.request.Operation == "replace" {
+		if err := o.owner.classifyCompleteGraph(o.ctx); err != nil {
+			return result, err
+		}
+		desired, result.Mappings, err = o.prepareReplacement(before)
+		if err != nil {
+			return result, err
+		}
+	}
+	var afterSnapshot *pb.SnapshotWithType
+	err = cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: o.request.TargetRootID}, func(b smartblock.SmartBlock) error {
+		current, heads, digest, err := o.lockedObservation(b)
+		if err != nil {
+			return err
+		}
+		result.BeforeHeads = slices.Clone(heads)
+		result.Heads, result.RootSnapshotSHA256 = slices.Clone(heads), digest
+		if !revisionSnapshotEqual(current, before.snapshots[b.Id()]) {
+			result.Status = "conflict"
+			return ErrAnnotationRevisionConflict
+		}
+		if o.request.Operation == "read" {
+			result.Status = "read"
+			return nil
+		}
+		if !slices.Equal(heads, o.request.ExpectedHeads) || digest != o.request.ExpectedRootSHA256 {
+			result.Status = "conflict"
+			return ErrAnnotationRevisionConflict
+		}
+		if err := b.Restrictions().Object.Check(model.Restrictions_Blocks, model.Restrictions_Details); err != nil {
+			return err
+		}
+		if err := o.bindReplacement(b, desired, current); err != nil {
+			return err
+		}
+		expected := &pb.SnapshotWithType{}
+		if err := proto.Unmarshal(pbc.NewConverter(desired, false).Convert(b.Type().ToProto()), expected); err != nil {
+			return err
+		}
+		if revisionSnapshotEqual(expected, current) {
+			result.Status = "unchanged"
+			return nil
+		}
+		// The SAME actual ObjectTree lock protects the precondition and Apply.
+		// Normal permissions, restrictions, hooks, undo and native push are retained.
+		result.Status, result.NativeApplyAttempted = "applied_unconfirmed", true
+		applyErr := b.Apply(desired)
+		result.NativeWriteObserved = !slices.Equal(heads, sortedRevisionHeads(b.Tree().Heads()))
+		if applyErr != nil {
+			return applyErr
+		}
+		observed, newHeads, hash, err := o.lockedObservation(b)
+		if err != nil {
+			result.Status = "applied_unconfirmed"
+			return err
+		}
+		result.NativeWriteObserved = !slices.Equal(heads, newHeads)
+		result.Heads, result.RootSnapshotSHA256 = newHeads, hash
+		result.Status = "applied_unconfirmed"
+		if !result.NativeWriteObserved {
+			return fmt.Errorf("%w: root Apply did not advance heads", ErrAnnotationRevisionUnconfirmed)
+		}
+		if !revisionSnapshotEqual(expected, observed) {
+			return revisionComparisonError("root_after_apply", expected, observed)
+		}
+		afterSnapshot = observed
+		return nil
+	})
+	if err != nil {
+		return result, err
+	}
+	selected := before
+	if result.NativeWriteObserved {
+		selected, err = o.exportRoot("after")
+		if err != nil {
+			return result, err
+		}
+		if !revisionSnapshotEqual(afterSnapshot, selected.snapshots[o.request.TargetRootID]) {
+			return result, revisionComparisonError("export_after_apply", afterSnapshot, selected.snapshots[o.request.TargetRootID])
+		}
+		err = cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: o.request.TargetRootID}, func(b smartblock.SmartBlock) error {
+			observed, heads, digest, err := o.lockedObservation(b)
+			if err != nil {
+				return err
+			}
+			if !slices.Equal(heads, result.Heads) || digest != result.RootSnapshotSHA256 || !revisionSnapshotEqual(observed, selected.snapshots[b.Id()]) {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+			return nil
+		})
+		if err != nil {
+			return result, err
+		}
+		if err := o.verifyRevisionGraph(before, selected, result.Mappings); err != nil {
+			return result, err
+		}
+		result.Status = "applied"
+	}
+	if err := o.owner.requireCurrentWriter(o.ctx); err != nil {
+		return result, err
+	}
+	result.NativeArchive = bytes.Clone(selected.raw)
+	digest := sha256.Sum256(selected.raw)
+	result.NativeArchiveSHA256 = hex.EncodeToString(digest[:])
+	return result, nil
+}
+
+func sortedRevisionHeads(heads []string) []string {
+	result := slices.Clone(heads)
+	sort.Strings(result)
+	return result
+}
+func (o *OwnedAnnotationRevisionOperation) Observation() (bool, string, *model.ExportReport) {
+	if o == nil || o.done == nil {
+		return false, "", nil
+	}
+	select {
+	case <-o.done:
+	default:
+		return false, "", nil
+	}
+	var report *model.ExportReport
+	if o.exportReport != nil {
+		report = proto.Clone(o.exportReport).(*model.ExportReport)
+	}
+	return o.observed, o.request.TargetRootID, report
+}
+
+func revisionSnapshotDigest(snapshot *pb.SnapshotWithType) (string, error) {
+	canonical, err := canonicalRevisionSnapshot(snapshot)
+	if err != nil {
+		return "", err
+	}
+	// The actual original gogo generator rejects deterministic protobuf marshal.
+	// encoding/json sorts every map key and retains the complete represented
+	// normalized protobuf model; no additional semantic projection is applied.
+	raw, err := json.Marshal(canonical)
+	if err != nil || len(raw) > ownedArchiveMaxExpanded {
+		return "", errors.Join(err, ErrAnnotationRevisionUnconfirmed)
+	}
+	framed := append([]byte("pinkha.annotation.revision.root-json.v1\x00"), raw...)
+	digest := sha256.Sum256(framed)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+// Report only bounded structural field paths, never annotation text or values.
+// This diagnostic does not change the strict native comparison predicate.
+func revisionComparisonError(stage string, expected, actual *pb.SnapshotWithType) error {
+	left, leftErr := canonicalRevisionSnapshot(expected)
+	right, rightErr := canonicalRevisionSnapshot(actual)
+	if leftErr != nil || rightErr != nil {
+		return errors.Join(ErrAnnotationRevisionUnconfirmed, leftErr, rightErr)
+	}
+	var a, b any
+	ar, ae := json.Marshal(left)
+	br, be := json.Marshal(right)
+	if ae != nil || be != nil || json.Unmarshal(ar, &a) != nil || json.Unmarshal(br, &b) != nil {
+		return ErrAnnotationRevisionUnconfirmed
+	}
+	var paths []string
+	var compare func(string, any, any)
+	compare = func(path string, first, second any) {
+		if len(paths) >= 24 || reflect.DeepEqual(first, second) {
+			return
+		}
+		if x, ok := first.(map[string]any); ok {
+			if y, ok := second.(map[string]any); ok {
+				keys := map[string]bool{}
+				for key := range x {
+					keys[key] = true
+				}
+				for key := range y {
+					keys[key] = true
+				}
+				order := make([]string, 0, len(keys))
+				for key := range keys {
+					order = append(order, key)
+				}
+				sort.Strings(order)
+				for _, key := range order {
+					compare(path+"."+key, x[key], y[key])
+				}
+				return
+			}
+		}
+		if x, ok := first.([]any); ok {
+			if y, ok := second.([]any); ok && len(x) == len(y) {
+				for i := range x {
+					compare(fmt.Sprintf("%s[%d]", path, i), x[i], y[i])
+				}
+				return
+			}
+		}
+		paths = append(paths, path)
+	}
+	compare("snapshot", a, b)
+	if len(paths) == 0 {
+		paths = []string{"protobuf_unknown_fields"}
+	}
+	return fmt.Errorf("%w: %s differs at %s", ErrAnnotationRevisionUnconfirmed, stage, strings.Join(paths, ","))
+}
