+func TestAnnotationRevisionNativeMarkInventory(t *testing.T) {
+	marks := []*model.BlockContentTextMark{
+		{Type: model.BlockContentTextMark_Link, Param: "https://example.org/native", Range: &model.Range{From: 1, To: 9}},
+		{Type: model.BlockContentTextMark_Bold, Range: &model.Range{From: 0, To: 6}},
+	}
+	value := &pb.SnapshotWithType{SbType: model.SmartBlockType_Page, Snapshot: &pb.ChangeSnapshot{Data: &model.SmartBlockSnapshotBase{
+		Blocks: []*model.Block{{Id: "native", Content: &model.BlockContentOfText{Text: &model.BlockContentText{Text: "Native rich text", Marks: &model.BlockContentTextMarks{Marks: marks}}}}},
+	}}}
+	reordered := proto.Clone(value).(*pb.SnapshotWithType)
+	inventory := reordered.Snapshot.Data.Blocks[0].GetText().Marks.Marks
+	inventory[0], inventory[1] = inventory[1], inventory[0]
+	t.Run("actual_original_Diff_reorders_both_copies", func(t *testing.T) {
+		old := text.NewText(proto.Clone(value.Snapshot.Data.Blocks[0]).(*model.Block))
+		incoming := text.NewText(proto.Clone(reordered.Snapshot.Data.Blocks[0]).(*model.Block))
+		if _, err := old.Diff("native-space", incoming); err != nil {
+			t.Fatal(err)
+		}
+		if !proto.Equal(old.Model().GetText().Marks, incoming.Model().GetText().Marks) {
+			t.Fatal("original native Diff did not normalize the same mark inventory")
+		}
+		if proto.Equal(value.Snapshot.Data.Blocks[0].GetText().Marks, old.Model().GetText().Marks) {
+			t.Fatal("fixture did not exercise original reorder")
+		}
+	})
+	expected, err := revisionSnapshotDigest(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Run("complete_tuple_reordering_only", func(t *testing.T) {
+		actual, err := revisionSnapshotDigest(reordered)
+		if err != nil || actual != expected || !revisionSnapshotEqual(value, reordered) {
+			t.Fatal("native mark inventory ordering changed semantic identity")
+		}
+		left, le := canonicalOwnedAnnotationSnapshot(value)
+		right, re := canonicalOwnedAnnotationSnapshot(reordered)
+		if le != nil || re != nil || proto.Equal(left, right) {
+			t.Fatal("historical import-v1 comparator was changed")
+		}
+		if value.Snapshot.Data.Blocks[0].GetText().Marks.Marks[0].Type != model.BlockContentTextMark_Link {
+			t.Fatal("canonicalization mutated input")
+		}
+	})
+	mutations := map[string]func(*model.BlockContentTextMarks){
+		"from":  func(m *model.BlockContentTextMarks) { m.Marks[0].Range.From++ },
+		"to":    func(m *model.BlockContentTextMarks) { m.Marks[0].Range.To-- },
+		"type":  func(m *model.BlockContentTextMarks) { m.Marks[0].Type = model.BlockContentTextMark_Bold },
+		"param": func(m *model.BlockContentTextMarks) { m.Marks[0].Param += "/different" },
+		"multiplicity": func(m *model.BlockContentTextMarks) {
+			m.Marks = append(m.Marks, proto.Clone(m.Marks[0]).(*model.BlockContentTextMark))
+		},
+		"range_presence": func(m *model.BlockContentTextMarks) { m.Marks[0].Range = nil },
+	}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			changed := proto.Clone(value).(*pb.SnapshotWithType)
+			mutate(changed.Snapshot.Data.Blocks[0].GetText().Marks)
+			actual, err := revisionSnapshotDigest(changed)
+			if err != nil || actual == expected || revisionSnapshotEqual(value, changed) {
+				t.Fatal("semantic mark mutation was accepted")
+			}
+		})
+	}
