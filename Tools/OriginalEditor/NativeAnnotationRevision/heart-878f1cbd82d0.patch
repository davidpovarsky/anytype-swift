+// No dependency is reset, created, installed, downloaded or uploaded by revision
+// preparation. Each desired member must correspond to the actual target graph
+// or an already persisted, semantically identical original schema/context.
+// Unsupported graph expansion is refused before the one root mutation.
+func (o *OwnedAnnotationRevisionOperation) prepareReplacement(target *ownedAnnotationArchive) (*state.State, []annotationRevisionMapping, error) {
+	g := o.owner
+	if err := g.admitOriginalImportMetadata(o.ctx); err != nil {
+		return nil, nil, err
+	}
+	if err := revisionIdentity(g.archive.snapshots[o.sourceRootID], o.sourceRootID, o.request.AnnotationUUID); err != nil {
+		return nil, nil, err
+	}
+	ids := make(map[string]string)
+	targets := make(map[string]string)
+	formats := make(map[domain.RelationKey]int32)
+	targetFiles := make(map[string]ownedAnnotationArchiveMember)
+	for _, member := range target.members {
+		if member.Kind == "file" {
+			targetFiles[member.Name] = member
+		}
+	}
+	for _, sourceID := range g.order {
+		plan := g.members[sourceID]
+		targetID := plan.expectedTarget
+		switch plan.role {
+		case ownedAnnotationFreshPage:
+			if sourceID == o.sourceRootID {
+				targetID = o.request.TargetRootID
+			} else {
+				sourceDetails := domain.NewDetailsFromProto(plan.snapshot.Snapshot.Data.Details)
+				sourceUUID, err := uuid.Parse(sourceDetails.GetString("pinkhaTorahAnnotationUUID"))
+				if err != nil || sourceUUID == uuid.Nil {
+					return nil, nil, ErrAnnotationRevisionUnsupported
+				}
+				for id, candidate := range target.snapshots {
+					if candidate.SbType != plan.snapshot.SbType {
+						continue
+					}
+					actual := domain.NewDetailsFromProto(candidate.Snapshot.Data.Details)
+					actualUUID, err := uuid.Parse(actual.GetString("pinkhaTorahAnnotationUUID"))
+					if err == nil && actualUUID == sourceUUID && actual.GetString("pinkhaTorahAnnotationNamespace") == sourceDetails.GetString("pinkhaTorahAnnotationNamespace") {
+						if targetID != "" {
+							return nil, nil, ErrAnnotationRevisionUnsupported
+						}
+						targetID = id
+					}
+				}
+			}
+		case ownedAnnotationFixedSchema, ownedAnnotationBundledSchema, ownedAnnotationParticipant:
+			if _, err := g.readOnlyContext(o.ctx, plan); err != nil {
+				return nil, nil, err
+			}
+			if plan.nativeKey != nil && plan.nativeKey.SmartblockType() == coresb.SmartBlockTypeRelation {
+				formats[domain.RelationKey(plan.nativeKey.InternalKey())] = int32(domain.NewDetailsFromProto(plan.snapshot.Snapshot.Data.Details).GetInt64(bundle.RelationKeyRelationFormat))
+			}
+		case ownedAnnotationFileObject:
+			for id, candidate := range target.snapshots {
+				if candidate.SbType != plan.snapshot.SbType {
+					continue
+				}
+				details := domain.NewDetailsFromProto(candidate.Snapshot.Data.Details)
+				binary, ok := targetFiles[details.GetString(bundle.RelationKeySource)]
+				if ok && binary.Bytes == plan.fileBytes && binary.SHA256 == plan.fileDigest {
+					if targetID != "" {
+						return nil, nil, ErrAnnotationRevisionUnsupported
+					}
+					targetID = id
+				}
+			}
+		default:
+			return nil, nil, ErrAnnotationRevisionUnsupported
+		}
+		if targetID == "" || targets[targetID] != "" {
+			return nil, nil, ErrAnnotationRevisionUnsupported
+		}
+		ids[sourceID], targets[targetID] = targetID, sourceID
+	}
+	// Existing fully observed target identities are self mappings; an absent
+	// arbitrary CID must never silently turn into _missing_object.
+	for id := range target.snapshots {
+		if ids[id] == "" {
+			ids[id] = id
+		}
+	}
+	var root *state.State
+	mappings := make([]annotationRevisionMapping, 0, len(g.order))
+	for _, sourceID := range g.order {
+		plan, targetID := g.members[sourceID], ids[sourceID]
+		mappings = append(mappings, annotationRevisionMapping{g.archive.spaceID, sourceID, targetID})
+		if plan.role == ownedAnnotationFixedSchema || plan.role == ownedAnnotationBundledSchema || plan.role == ownedAnnotationParticipant {
+			continue
+		}
+		mapped, err := revisionMapState(plan.snapshot, sourceID, targetID, ids, formats)
+		if err != nil {
+			return nil, nil, err
+		}
+		if sourceID == o.sourceRootID {
+			root = mapped
+			continue
+		}
+		observed := target.snapshots[targetID]
+		if observed == nil {
+			return nil, nil, ErrAnnotationRevisionUnsupported
+		}
+		expected := &pb.SnapshotWithType{}
+		if err := proto.Unmarshal(pbc.NewConverter(mapped, false).Convert(plan.snapshot.SbType), expected); err != nil {
+			return nil, nil, err
+		}
+		if plan.role == ownedAnnotationFileObject {
+			// File content was compared byte-for-byte by its full native export.
+			// Only original storage identity and the export-relative binary path
+			// differ when that same file was materialized into a local Space.
+			if expected.Snapshot.Data.FileInfo == nil || observed.Snapshot.Data.FileInfo == nil {
+				return nil, nil, ErrAnnotationRevisionUnsupported
+			}
+			if err := expectedOriginalFileMetadataBlocks(expected.Snapshot.Data, targetID); err != nil {
+				return nil, nil, err
+			}
+			expected.Snapshot.Data.FileInfo.FileId = observed.Snapshot.Data.FileInfo.FileId
+			ed, od := domain.NewDetailsFromProto(expected.Snapshot.Data.Details), domain.NewDetailsFromProto(observed.Snapshot.Data.Details)
+			ed.Set(bundle.RelationKeyFileId, od.Get(bundle.RelationKeyFileId))
+			ed.Set(bundle.RelationKeySource, od.Get(bundle.RelationKeySource))
+			expected.Snapshot.Data.Details = ed.ToProto()
+		}
+		if !revisionSnapshotEqual(expected, observed) {
+			return nil, nil, ErrAnnotationRevisionUnsupported
+		}
+	}
+	if root == nil {
+		return nil, nil, ErrAnnotationRevisionUnsupported
+	}
+	return root, mappings, g.requireCurrentWriter(o.ctx)
+}
+
+func revisionMapState(snapshot *pb.SnapshotWithType, sourceID, targetID string, ids map[string]string, formats map[domain.RelationKey]int32) (*state.State, error) {
+	raw := proto.Clone(snapshot).(*pb.SnapshotWithType)
+	// The original root is renamed; all non-root block identifiers and child
+	// ordering are retained, exactly as in the original importer.
+	found := false
+	for _, block := range raw.Snapshot.Data.Blocks {
+		if block == nil || block.Id == "" {
+			return nil, ErrAnnotationRevisionUnsupported
+		}
+		if block.Id == sourceID {
+			block.Id = targetID
+			found = true
+		}
+		for i, child := range block.ChildrenIds {
+			if child == sourceID {
+				block.ChildrenIds[i] = targetID
+			}
+		}
+	}
+	if !found {
+		return nil, ErrAnnotationRevisionUnsupported
+	}
+	st, err := state.NewDocFromSnapshot(targetID, raw.Snapshot)
+	if err != nil {
+		return nil, err
+	}
+	if err := revisionReferences(st, ids, formats); err != nil {
+		return nil, err
+	}
+	common.UpdateObjectIDsInRelations(st, ids, formats)
+	if err := common.UpdateLinksToObjects(st, ids); err != nil {
+		return nil, err
+	}
+	for key, value := range st.Details().Iterate() {
+		if mapped, ok := ids[string(key)]; ok && mapped != string(key) {
+			st.SetDetail(domain.RelationKey(mapped), value)
+			if format, exists := formats[key]; exists {
+				st.AddRelationLinks(&model.RelationLink{Key: mapped, Format: model.RelationFormat(format)})
+			}
+			st.RemoveRelation(key)
+		}
+	}
+	if mapped, ok := ids[st.ObjectTypeKey().String()]; ok {
+		st.SetObjectTypeKey(domain.TypeKey(mapped))
+	}
+	collection := st.GetStoreSlice(template.CollectionStoreKey)
+	for i, id := range collection {
+		if ids[id] == "" {
+			return nil, ErrAnnotationRevisionUnsupported
+		}
+		collection[i] = ids[id]
+	}
+	if len(collection) != 0 {
+		st.UpdateStoreSlice(template.CollectionStoreKey, collection)
+	}
+	if err := st.Validate(); err != nil {
+		return nil, err
+	}
+	return st, nil
+}
+
+// This deliberately closed inventory refuses unsupported embedded Dataview or
+// bookmark fetches. It never permits the generic importer's lossy missing-ID
+// fallback. Normal rich text, marks, lists, tables, links, and existing files use
+// the unchanged original typed remappers.
+func revisionReferences(st *state.State, ids map[string]string, formats map[domain.RelationKey]int32) error {
+	mapped := func(id string) bool { return id == "" || (id != addr.MissingObject && ids[id] != "") }
+	var failure error
+	err := st.Iterate(func(block simple.Block) bool {
+		value := block.Model()
+		if value.GetDataview() != nil {
+			failure = ErrAnnotationRevisionUnsupported
+			return false
+		}
+		if b := value.GetLink(); b != nil && !mapped(b.TargetBlockId) {
+			failure = ErrAnnotationRevisionUnsupported
+		}
+		if b := value.GetBookmark(); b != nil && (b.TargetObjectId == "" || !mapped(b.TargetObjectId)) {
+			failure = ErrAnnotationRevisionUnsupported
+		}
+		if b := value.GetFile(); b != nil && (b.TargetObjectId == "" || !mapped(b.TargetObjectId)) {
+			failure = ErrAnnotationRevisionUnsupported
+		}
+		if b := value.GetText(); b != nil {
+			if !mapped(b.IconImage) {
+				failure = ErrAnnotationRevisionUnsupported
+			}
+			for _, mark := range b.GetMarks().GetMarks() {
+				if mark == nil {
+					failure = ErrAnnotationRevisionUnsupported
+					break
+				}
+				if (mark.Type == model.BlockContentTextMark_Mention || mark.Type == model.BlockContentTextMark_Object) && !mapped(mark.Param) {
+					failure = ErrAnnotationRevisionUnsupported
+				}
+			}
+		}
+		return failure == nil
+	})
+	if err != nil || failure != nil {
+		return errors.Join(err, failure)
+	}
+	for key, value := range st.Details().Iterate() {
+		format, known := formats[key]
+		if !known {
+			if relation, err := bundle.GetRelation(key); err == nil {
+				format, known = int32(relation.Format), true
+			}
+		}
+		if !known {
+			return ErrAnnotationRevisionUnsupported
+		}
+		if !common.IsObjectRelation(key, format) {
+			continue
+		}
+		if scalar, ok := value.TryString(); ok {
+			if !mapped(scalar) {
+				return ErrAnnotationRevisionUnsupported
+			}
+		} else {
+			for _, id := range value.StringList() {
+				if !mapped(id) {
+					return ErrAnnotationRevisionUnsupported
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func (o *OwnedAnnotationRevisionOperation) bindReplacement(b smartblock.SmartBlock, desired *state.State, current *pb.SnapshotWithType) error {
+	if desired == nil || desired.RootId() != b.Id() || desired.ObjectTypeKey().String() != "pinkhatorahannotationv1" {
+		return ErrAnnotationRevisionUnsupported
+	}
+	prior := b.NewState()
+	// Creation identity is immutable. Preserve original bytes (UUID case too);
+	// the UUID itself is compared semantically before this point.
+	for key, value := range prior.Details().Iterate() {
+		name := string(key)
+		if strings.HasPrefix(name, "pinkhaTorahAnnotationCreation") || name == "pinkhaTorahAnnotationProtocol" || name == "pinkhaTorahAnnotationNamespace" {
+			if !desired.Details().Get(key).Equal(value) {
+				return ErrAnnotationRevisionUnsupported
+			}
+		}
+		if strings.HasPrefix(name, "pinkhaTorahAnnotationCreation") || name == "pinkhaTorahAnnotationProtocol" || name == "pinkhaTorahAnnotationNamespace" || name == "pinkhaTorahAnnotationUUID" {
+			desired.SetDetail(key, value)
+		}
+	}
+	// Preserve destination-native bookkeeping; user details remain those from
+	// the fully mapped saved source. Original Apply owns modification timestamps.
+	nativeKeys := append([]domain.RelationKey(nil), bundle.LocalAndDerivedRelationKeys...)
+	nativeKeys = append(nativeKeys, bundle.RelationKeyCreatedDate, bundle.RelationKeyCreator, bundle.RelationKeyOrigin, bundle.RelationKeyImportType, bundle.RelationKeyOldAnytypeID, bundle.RelationKeySourceFilePath)
+	for _, key := range nativeKeys {
+		if value := prior.Details().Get(key); value.Ok() {
+			desired.SetDetail(key, value)
+		} else {
+			desired.RemoveDetail(key)
+		}
+	}
+	desired.SetOriginalCreatedTimestamp(prior.OriginalCreatedTimestamp())
+	desired.SetMigrationVersion(prior.MigrationVersion())
+	desired.SetLocalDetails(prior.LocalDetails().Copy())
+	desired.AddRelationLinks(prior.PickRelationLinks()...)
+	for _, plan := range o.owner.members {
+		if plan.nativeKey != nil && plan.nativeKey.SmartblockType() == coresb.SmartBlockTypeRelation {
+			key := plan.nativeKey.InternalKey()
+			if desired.Details().Has(domain.RelationKey(key)) {
+				format := domain.NewDetailsFromProto(plan.snapshot.Snapshot.Data.Details).GetInt64(bundle.RelationKeyRelationFormat)
+				desired.AddRelationLinks(&model.RelationLink{Key: key, Format: model.RelationFormat(format)})
+			}
+		}
+	}
+	keys := desired.AllRelationKeys()
+	sort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })
+	desired.AddBundledRelationLinks(keys...)
+	// Refuse any change/removal of an actually restricted existing block,
+	// including blocks omitted from an incoming replacement.
+	for _, old := range prior.Blocks() {
+		rest := old.Restrictions
+		if rest == nil || (!rest.Edit && !rest.Remove && !rest.Drag && !rest.DropOn) {
+			continue
+		}
+		incoming := desired.Pick(old.Id)
+		if incoming == nil || !proto.Equal(old, incoming.Model()) {
+			return restriction.ErrRestricted
+		}
+	}
+	desired.SetParent(prior.ParentState())
+	if err := desired.CheckRestrictions(); err != nil {
+		return err
+	}
+	return desired.Validate()
+}
+
+func (o *OwnedAnnotationRevisionOperation) verifyRevisionGraph(before, after *ownedAnnotationArchive, mappings []annotationRevisionMapping) error {
+	ids := make(map[string]string, len(mappings))
+	expectedTargets := map[string]bool{}
+	for _, row := range mappings {
+		ids[row.SourceObjectID] = row.ObjectID
+		expectedTargets[row.ObjectID] = true
+	}
+	binaries := map[string]ownedAnnotationArchiveMember{}
+	for _, member := range after.members {
+		if member.Kind == "file" {
+			binaries[member.Name] = member
+		}
+	}
+	for _, sourceID := range o.owner.order {
+		plan, targetID := o.owner.members[sourceID], ids[sourceID]
+		observed := after.snapshots[targetID]
+		if observed == nil || observed.SbType != plan.snapshot.SbType {
+			return ErrAnnotationRevisionUnconfirmed
+		}
+		switch plan.role {
+		case ownedAnnotationFreshPage:
+			if sourceID != o.sourceRootID && !revisionSnapshotEqual(before.snapshots[targetID], observed) {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+		case ownedAnnotationFileObject:
+			if !revisionSnapshotEqual(before.snapshots[targetID], observed) {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+			binary, ok := binaries[domain.NewDetailsFromProto(observed.Snapshot.Data.Details).GetString(bundle.RelationKeySource)]
+			if !ok || binary.Bytes != plan.fileBytes || binary.SHA256 != plan.fileDigest {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+		case ownedAnnotationFixedSchema, ownedAnnotationBundledSchema, ownedAnnotationParticipant:
+			if _, err := o.owner.readOnlyContext(o.ctx, plan); err != nil {
+				return err
+			}
+			if plan.role != ownedAnnotationParticipant {
+				if err := o.owner.requireSchemaSnapshotCompatibility(o.ctx, plan, observed); err != nil {
+					return err
+				}
+				if err := o.owner.compareObservedSchemaExport(o.ctx, plan, observed); err != nil {
+					return err
+				}
+			}
+		default:
+			return ErrAnnotationRevisionUnsupported
+		}
+	}
+	for id, observed := range after.snapshots {
+		if expectedTargets[id] {
+			continue
+		}
+		plan := o.owner.additionalContext[id]
+		if plan == nil || !o.owner.isOriginalImportMetadata(plan) {
+			return ErrAnnotationRevisionUnconfirmed
+		}
+		if _, err := o.owner.readOnlyContext(o.ctx, plan); err != nil {
+			return err
+		}
+		if err := o.owner.compareObservedSchemaExport(o.ctx, plan, observed); err != nil {
+			return err
+		}
+	}
+	return o.owner.requireCurrentWriter(o.ctx)
+}
