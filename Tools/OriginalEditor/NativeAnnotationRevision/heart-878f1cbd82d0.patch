diff --git a/core/annotation_revision.go b/core/annotation_revision.go
new file mode 100644
index 000000000..a2734df4d
--- /dev/null
+++ b/core/annotation_revision.go
@@ -0,0 +1,91 @@
+package core
+
+import (
+	"context"
+	"crypto/sha256"
+
+	"github.com/anyproto/anytype-heart/core/application"
+	importer "github.com/anyproto/anytype-heart/core/block/import"
+	"github.com/anyproto/anytype-heart/pb"
+	"github.com/gogo/protobuf/proto"
+)
+
+// Revision-v1 uses the existing generated transport with an explicitly separate
+// protocol. Archive is strict request JSON; Readback.NativeArchive is complete
+// response JSON. Its nested native_archive is the actual original exported ZIP.
+// Import-v1's validators, archive semantics, stage3 body proof and limits remain
+// unchanged and must reject this protocol.
+func (mw *Middleware) annotationRevision(ctx context.Context, req *pb.RpcAnnotationImportRequest) *pb.RpcAnnotationImportResponse {
+	response := &pb.RpcAnnotationImportResponse{Error: &pb.RpcAnnotationImportResponseError{}, ImportProtocol: importer.AnnotationRevisionProtocol}
+	if ctx == nil || req == nil || req.ImportProtocol != importer.AnnotationRevisionProtocol ||
+		!annotationImportIdentityOK(req.ExpectedAccountId) || !annotationImportIdentityOK(req.SourceRootId) ||
+		!annotationImportIdentityOK(req.SourceSpaceId) || !annotationImportIdentityOK(req.TargetSpaceId) ||
+		len(req.Archive) == 0 || len(req.Archive) > importer.AnnotationRevisionEnvelopeMaximum ||
+		len(req.ArchiveSHA256) != 32 || !annotationImportSecretOK(req.AttemptSecret) {
+		response.Error.Code = pb.RpcAnnotationImportResponseError_BAD_INPUT
+		response.Error.Description = "invalid bounded original annotation revision request"
+		return response
+	}
+	if mw == nil || mw.applicationService == nil {
+		response.Error.Code = pb.RpcAnnotationImportResponseError_RUNTIME_UNAVAILABLE
+		response.Error.Description = "original annotation application is unavailable"
+		return response
+	}
+	var digest, secret [32]byte
+	copy(digest[:], req.ArchiveSHA256)
+	copy(secret[:], req.AttemptSecret)
+	completion, err := mw.applicationService.ReviseOwnedAnnotation(ctx, req.ExpectedAccountId, req.Archive, digest, req.SourceRootId, req.SourceSpaceId, req.TargetSpaceId, secret)
+	response.Registered, response.OperationDone = completion.Registered(), completion.Done()
+	response.CancellationRequested = completion.CancellationRequested()
+	response.NativeErrorPresent, response.NativeErrorCategory = err != nil, annotationImportNativeErrorCategory(err)
+	if err != nil {
+		response.Error.Code = annotationImportErrorCode(err)
+		response.Error.Description = annotationImportErrorDescription(response.Error.Code)
+	}
+	if !completion.Done() {
+		return response
+	}
+	raw := completion.Result()
+	if len(raw) == 0 || len(raw) > annotationImportResponseMaximum {
+		return refuseAnnotationImportCopy(response)
+	}
+	hash := sha256.Sum256(raw)
+	response.Readback = &pb.RpcAnnotationImportReadback{
+		Observed: completion.Observed(), Stage: 4, AccountId: req.ExpectedAccountId, SpaceId: req.TargetSpaceId, RootId: completion.RootID(),
+		SourceArchiveSHA256: append([]byte(nil), digest[:]...), NativeArchiveSHA256: append([]byte(nil), hash[:]...), NativeArchive: raw,
+		ExportReport: completion.ExportReport(),
+	}
+	response.CopyDisposition = pb.RpcAnnotationImportResponse_COMPLETE
+	if proto.Size(response) > annotationImportResponseMaximum {
+		return refuseAnnotationImportCopy(response)
+	}
+	return response
+}
+func (mw *Middleware) annotationRevisionCancel(ctx context.Context, req *pb.RpcAnnotationImportCancelRequest) *pb.RpcAnnotationImportCancelResponse {
+	response := &pb.RpcAnnotationImportCancelResponse{Error: &pb.RpcAnnotationImportCancelResponseError{}, ImportProtocol: importer.AnnotationRevisionProtocol}
+	if ctx == nil || req == nil || req.ImportProtocol != importer.AnnotationRevisionProtocol ||
+		!annotationImportIdentityOK(req.ExpectedAccountId) || !annotationImportIdentityOK(req.SourceRootId) ||
+		!annotationImportIdentityOK(req.SourceSpaceId) || !annotationImportIdentityOK(req.TargetSpaceId) ||
+		len(req.ArchiveSHA256) != 32 || !annotationImportSecretOK(req.AttemptSecret) {
+		response.Error.Code = pb.RpcAnnotationImportCancelResponseError_BAD_INPUT
+		response.Error.Description = "invalid original annotation revision cancellation comparison"
+		return response
+	}
+	if mw == nil || mw.applicationService == nil {
+		response.Error.Code = pb.RpcAnnotationImportCancelResponseError_RUNTIME_UNAVAILABLE
+		response.Error.Description = "original annotation application is unavailable"
+		return response
+	}
+	var digest, secret [32]byte
+	copy(digest[:], req.ArchiveSHA256)
+	copy(secret[:], req.AttemptSecret)
+	switch mw.applicationService.CancelOwnedAnnotationRevision(req.ExpectedAccountId, req.SourceRootId, req.SourceSpaceId, req.TargetSpaceId, digest, secret) {
+	case application.OwnedAnnotationCancelRequested:
+		response.Disposition = pb.RpcAnnotationImportCancelResponse_REQUESTED
+	case application.OwnedAnnotationCancelDoneObserved:
+		response.Disposition = pb.RpcAnnotationImportCancelResponse_DONE_OBSERVED
+	default:
+		response.Disposition = pb.RpcAnnotationImportCancelResponse_NOT_OBSERVED
+	}
+	return response
+}
