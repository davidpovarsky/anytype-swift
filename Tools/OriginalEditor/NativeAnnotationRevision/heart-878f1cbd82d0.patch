+func TestAnnotationRevisionCanonicalRootDigest(t *testing.T) {
+	details := domain.NewDetails()
+	details.SetString("name", "Native test")
+	details.SetString("pinkhaTorahAnnotationUUID", "d632fce3-dc28-4b2d-acf5-ce9b0343b83a")
+	value := &pb.SnapshotWithType{SbType: model.SmartBlockType_Page, Snapshot: &pb.ChangeSnapshot{Data: &model.SmartBlockSnapshotBase{
+		Details: details.ToProto(), ObjectTypes: []string{"ot-pinkhatorahannotationv1"},
+		Blocks: []*model.Block{
+			{Id: "root", ChildrenIds: []string{"first", "second"}, Content: &model.BlockContentOfSmartblock{Smartblock: &model.BlockContentSmartblock{}}},
+			{Id: "first", Content: &model.BlockContentOfText{Text: &model.BlockContentText{Text: "Native rich text"}}},
+			{Id: "second", Content: &model.BlockContentOfText{Text: &model.BlockContentText{Text: "Second"}}},
+		},
+	}}}
+	expected, err := revisionSnapshotDigest(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Run("map_and_block_inventory_stable", func(t *testing.T) {
+		for i := 0; i < 128; i++ {
+			copy := proto.Clone(value).(*pb.SnapshotWithType)
+			if i%2 == 0 {
+				copy.Snapshot.Data.Blocks[1], copy.Snapshot.Data.Blocks[2] = copy.Snapshot.Data.Blocks[2], copy.Snapshot.Data.Blocks[1]
+			}
+			actual, err := revisionSnapshotDigest(copy)
+			if err != nil || actual != expected {
+				t.Fatal("root digest changed without semantic mutation")
+			}
+		}
+	})
+	t.Run("rich_body_changes_hash", func(t *testing.T) {
+		copy := proto.Clone(value).(*pb.SnapshotWithType)
+		copy.Snapshot.Data.Blocks[1].GetText().Text = "Changed"
+		actual, err := revisionSnapshotDigest(copy)
+		if err != nil || actual == expected {
+			t.Fatal("body change was not bound")
+		}
+	})
+	t.Run("child_order_changes_hash", func(t *testing.T) {
+		copy := proto.Clone(value).(*pb.SnapshotWithType)
+		copy.Snapshot.Data.Blocks[0].ChildrenIds = []string{"second", "first"}
+		actual, err := revisionSnapshotDigest(copy)
+		if err != nil || actual == expected {
+			t.Fatal("child order was not bound")
+		}
+	})
+}
