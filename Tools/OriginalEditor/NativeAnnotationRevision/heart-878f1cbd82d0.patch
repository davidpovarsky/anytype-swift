+package application_test
+
+import (
+	"archive/zip"
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	importer "github.com/anyproto/anytype-heart/core/block/import"
+	"github.com/anyproto/anytype-heart/core/domain"
+	"github.com/anyproto/anytype-heart/pb"
+	"github.com/anyproto/anytype-heart/pkg/lib/pb/model"
+)
+
+type nativeRevisionWire struct {
+	Status               string   `json:"status"`
+	RootID               string   `json:"root_id"`
+	Heads                []string `json:"heads"`
+	BeforeHeads          []string `json:"before_heads"`
+	RootSHA              string   `json:"root_snapshot_sha256"`
+	NativeArchive        []byte   `json:"native_archive"`
+	NativeArchiveSHA     string   `json:"native_archive_sha256"`
+	NativeWriteObserved  bool     `json:"native_write_observed"`
+	NativeApplyAttempted bool     `json:"native_apply_attempted"`
+}
+
+func revisionNativeCall(t *testing.T, f *ownedClosedFixture, label, root, annotationUUID string, source *ownedClosedSpecimen, base nativeRevisionWire) (nativeRevisionWire, error) {
+	t.Helper()
+	request := map[string]any{"schema": 1, "operation": "read", "target_root_id": root, "annotation_uuid": strings.ToUpper(annotationUUID)}
+	sourceRoot, sourceSpace := root, f.spc.Id()
+	if source != nil {
+		request["operation"] = "replace"
+		request["expected_heads"] = base.Heads
+		request["expected_root_sha256"] = base.RootSHA
+		request["desired_archive"] = source.Raw
+		request["desired_archive_sha256"] = hex.EncodeToString(source.Digest[:])
+		sourceRoot, sourceSpace = source.RootID, source.SourceSpace
+	}
+	raw, err := json.Marshal(request)
+	ownedClosedNoError(t, err)
+	var secret [32]byte
+	_, err = rand.Read(secret[:])
+	ownedClosedNoError(t, err)
+	completion, operationErr := f.service.ReviseOwnedAnnotation(f.ctx, f.accountID, raw, sha256.Sum256(raw), sourceRoot, sourceSpace, f.spc.Id(), secret)
+	if !completion.Registered() || !completion.Done() {
+		t.Fatalf("actual revision registration/drain missing: %v", operationErr)
+	}
+	result := completion.Result()
+	ownedClosedNoError(t, ownedClosedWrite(f.evidence, label+"-revision.json", result))
+	var value nativeRevisionWire
+	ownedClosedNoError(t, json.Unmarshal(result, &value))
+	if operationErr == nil {
+		if !completion.Observed() || value.RootID != root || len(value.Heads) == 0 || len(value.RootSHA) != 64 || len(value.NativeArchive) == 0 {
+			t.Fatal("success lacks actual native readback")
+		}
+		report := completion.ExportReport()
+		if report == nil || report.Status != model.ExportReport_SUCCESS || report.Succeed <= 0 || report.ObjectErrors != 0 || report.FileErrors != 0 {
+			t.Fatal("success lacks original export report")
+		}
+		digest := sha256.Sum256(value.NativeArchive)
+		if hex.EncodeToString(digest[:]) != value.NativeArchiveSHA {
+			t.Fatal("native export hash differs")
+		}
+		ownedClosedNoError(t, ownedClosedWrite(f.evidence, label+"-native.zip", value.NativeArchive))
+	}
+	return value, operationErr
+}
+func revisionNativeRoot(t *testing.T, raw []byte, space, root string) *pb.SnapshotWithType {
+	t.Helper()
+	archive, err := zip.NewReader(bytes.NewReader(raw), int64(len(raw)))
+	ownedClosedNoError(t, err)
+	for _, entry := range archive.File {
+		if entry.Name != "objects/"+root+".pb" {
+			continue
+		}
+		reader, err := entry.Open()
+		ownedClosedNoError(t, err)
+		body, err := io.ReadAll(reader)
+		ownedClosedNoError(t, err)
+		ownedClosedNoError(t, reader.Close())
+		value := &pb.SnapshotWithType{}
+		ownedClosedNoError(t, value.Unmarshal(body))
+		return value
+	}
+	t.Fatal("actual exported root is absent")
+	return nil
+}
+func TestOtzariaNativeConditionalAnnotationRevision(t *testing.T) {
+	f := newOwnedClosedFixture(t)
+	source := f.produce(t, "format")
+	target := f.target(t, "revision", source)
+	operation, stage := target.prepare(t, source)
+	target.start(operation)
+	imported := target.wait(t, "revision-initial-import", operation)
+	target.stageRemoved(t, stage)
+	target.assertRoundTrip(t, source, imported)
+	mapping, ok := imported.NativeMappingObservation()
+	if !ok {
+		t.Fatal("actual initial import mapping absent")
+	}
+	root := ""
+	for _, row := range mapping.SourceAssignments() {
+		if row.SourceObjectID == source.RootID {
+			root = row.NativeID
+		}
+	}
+	if root == "" || root == source.RootID {
+		t.Fatal("actual destination root missing")
+	}
+	original := source.Snapshots[source.RootID]
+	annotationUUID := domain.NewDetailsFromProto(original.Snapshot.Data.Details).GetString("pinkhaTorahAnnotationUUID")
+	read, err := revisionNativeCall(t, target, "before", root, annotationUUID, nil, nativeRevisionWire{})
+	ownedClosedNoError(t, err)
+	if read.Status != "read" || read.NativeApplyAttempted || read.NativeWriteObserved {
+		t.Fatal("read falsely mutates")
+	}
+	readonlyBefore := target.readOnlyHeads(t, source)
+	desired := *source
+	desired.Kind = "revision-saved"
+	desired.Expected = make(map[string]*model.Block)
+	for id, value := range source.Expected {
+		desired.Expected[id] = value
+	}
+	added := f.text(t, &desired, source.RootID, "", "נשמר במנוע המקורי — saved native rich update", model.BlockContentText_Paragraph, &model.BlockContentTextMarks{Marks: []*model.BlockContentTextMark{{Range: &model.Range{From: 0, To: 4}, Type: model.BlockContentTextMark_Bold}}})
+	f.export(t, &desired)
+	applied, err := revisionNativeCall(t, target, "applied", root, annotationUUID, &desired, read)
+	ownedClosedNoError(t, err)
+	if applied.Status != "applied" || !applied.NativeApplyAttempted || !applied.NativeWriteObserved || slices.Equal(applied.Heads, read.Heads) {
+		t.Fatal("actual conditional write was not observed")
+	}
+	actual := revisionNativeRoot(t, applied.NativeArchive, target.spc.Id(), root)
+	actualDetails := domain.NewDetailsFromProto(actual.Snapshot.Data.Details)
+	if actualDetails.GetString("pinkhaTorahAnnotationUUID") != annotationUUID {
+		t.Fatal("stored UUID bytes changed")
+	}
+	blocks := map[string]*model.Block{}
+	for _, b := range actual.Snapshot.Data.Blocks {
+		blocks[b.Id] = b
+	}
+	if blocks[added] == nil || blocks[added].GetText() == nil || blocks[added].GetText().Text != desired.Expected[added].GetText().Text || !reflect.DeepEqual(blocks[added].GetText().Marks, desired.Expected[added].GetText().Marks) {
+		t.Fatal("saved native rich body differs")
+	}
+	for id := range source.Expected {
+		if blocks[id] == nil {
+			t.Fatal("preexisting child identity was lost")
+		}
+	}
+	if !reflect.DeepEqual(readonlyBefore, target.readOnlyHeads(t, source)) {
+		t.Fatal("readonly dependency was modified")
+	}
+	headsBeforeConflict := target.pageHeads(t, root)
+	stale, err := revisionNativeCall(t, target, "stale-conflict", root, annotationUUID, &desired, read)
+	if !errors.Is(err, importer.ErrAnnotationRevisionConflict) || stale.Status != "conflict" || stale.NativeApplyAttempted || stale.NativeWriteObserved {
+		t.Fatalf("stale token did not fail before mutation: %v", err)
+	}
+	if !slices.Equal(headsBeforeConflict, target.pageHeads(t, root)) {
+		t.Fatal("conflict changed native heads")
+	}
+	reopened, err := revisionNativeCall(t, target, "after-read", root, annotationUUID, nil, nativeRevisionWire{})
+	ownedClosedNoError(t, err)
+	if reopened.RootSHA != applied.RootSHA || !slices.Equal(reopened.Heads, applied.Heads) {
+		t.Fatal("subsequent native read differs")
+	}
+	unchanged, err := revisionNativeCall(t, target, "unchanged", root, annotationUUID, &desired, reopened)
+	ownedClosedNoError(t, err)
+	if unchanged.Status != "unchanged" || unchanged.NativeApplyAttempted || unchanged.NativeWriteObserved {
+		t.Fatal("identical saved body caused an unnecessary mutation")
+	}
+
+	raceA := desired
+	raceA.Kind = "revision-race-a"
+	raceA.Expected = make(map[string]*model.Block)
+	for id, v := range desired.Expected {
+		raceA.Expected[id] = v
+	}
+	f.text(t, &raceA, source.RootID, "", "Concurrent saved A", model.BlockContentText_Paragraph, nil)
+	f.export(t, &raceA)
+	raceB := raceA
+	raceB.Kind = "revision-race-b"
+	raceB.Expected = make(map[string]*model.Block)
+	for id, v := range raceA.Expected {
+		raceB.Expected[id] = v
+	}
+	f.text(t, &raceB, source.RootID, "", "Concurrent saved B", model.BlockContentText_Paragraph, nil)
+	f.export(t, &raceB)
+	type raced struct {
+		value nativeRevisionWire
+		err   error
+	}
+	results := make(chan raced, 2)
+	for i, candidate := range []*ownedClosedSpecimen{&raceA, &raceB} {
+		go func(i int, candidate *ownedClosedSpecimen) {
+			var result raced
+			defer func() { results <- result }()
+			result.value, result.err = revisionNativeCall(t, target, []string{"race-a", "race-b"}[i], root, annotationUUID, candidate, unchanged)
+		}(i, candidate)
+	}
+	appliedCount, conflictCount := 0, 0
+	for i := 0; i < 2; i++ {
+		r := <-results
+		if r.err == nil && r.value.Status == "applied" && r.value.NativeApplyAttempted && r.value.NativeWriteObserved {
+			appliedCount++
+		} else if errors.Is(r.err, importer.ErrAnnotationRevisionConflict) && r.value.Status == "conflict" && !r.value.NativeApplyAttempted && !r.value.NativeWriteObserved {
+			conflictCount++
+		} else {
+			t.Fatalf("unexpected concurrent native result: %s %v", r.value.Status, r.err)
+		}
+	}
+	if appliedCount != 1 || conflictCount != 1 {
+		t.Fatal("same revision allowed multiple native writers")
+	}
+
