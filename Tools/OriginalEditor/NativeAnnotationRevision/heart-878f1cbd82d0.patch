+func TestAnnotationRevisionStrictEnvelope(t *testing.T) {
+	valid := []byte(`{"schema":1,"operation":"read","target_root_id":"root","annotation_uuid":"D632FCE3-DC28-4B2D-ACF5-CE9B0343B83A"}`)
+	if got, err := decodeAnnotationRevision(valid, sha256.Sum256(valid)); err != nil || got.Operation != "read" {
+		t.Fatalf("valid read: %v", err)
+	}
+	cases := map[string][]byte{
+		"duplicate":           []byte(`{"schema":1,"schema":1,"operation":"read","target_root_id":"root","annotation_uuid":"d632fce3-dc28-4b2d-acf5-ce9b0343b83a"}`),
+		"unknown":             []byte(`{"schema":1,"operation":"read","target_root_id":"root","annotation_uuid":"d632fce3-dc28-4b2d-acf5-ce9b0343b83a","authority":true}`),
+		"empty_uuid":          []byte(`{"schema":1,"operation":"read","target_root_id":"root","annotation_uuid":"00000000-0000-0000-0000-000000000000"}`),
+		"unknown_operation":   []byte(`{"schema":1,"operation":"force","target_root_id":"root","annotation_uuid":"d632fce3-dc28-4b2d-acf5-ce9b0343b83a"}`),
+		"version":             []byte(`{"schema":2,"operation":"read","target_root_id":"root","annotation_uuid":"d632fce3-dc28-4b2d-acf5-ce9b0343b83a"}`),
+		"trailing":            append(append([]byte(nil), valid...), []byte("{}")...),
+		"oversized":           []byte(strings.Repeat(" ", AnnotationRevisionEnvelopeMaximum+1)),
+		"replace_empty_token": []byte(`{"schema":1,"operation":"replace","target_root_id":"root","annotation_uuid":"d632fce3-dc28-4b2d-acf5-ce9b0343b83a"}`),
+		"read_with_token":     []byte(`{"schema":1,"operation":"read","target_root_id":"root","annotation_uuid":"d632fce3-dc28-4b2d-acf5-ce9b0343b83a","expected_heads":["head"]}`),
+	}
+	cases["case_alias"] = []byte(strings.Replace(string(valid), `"schema"`, `"Schema"`, 1))
+	cases["case_duplicate"] = []byte(strings.Replace(string(valid), `"schema":1`, `"schema":1,"Schema":1`, 1))
+	for name, raw := range cases {
+		t.Run(name, func(t *testing.T) {
+			if _, err := decodeAnnotationRevision(raw, sha256.Sum256(raw)); err == nil {
+				t.Fatal("accepted invalid envelope")
+			}
+		})
+	}
+	t.Run("wrong_digest", func(t *testing.T) {
+		if _, err := decodeAnnotationRevision(valid, [32]byte{}); err == nil {
+			t.Fatal("accepted wrong digest")
+		}
+	})
+	for name, heads := range map[string][]string{"empty": nil, "duplicate": {"a", "a"}, "unsorted": {"b", "a"}, "empty_member": {""}, "too_many": make([]string, 65)} {
+		t.Run("heads_"+name, func(t *testing.T) {
+			if revisionHeads(heads) {
+				t.Fatal("accepted invalid native heads")
+			}
+		})
+	}
+	t.Run("bounded_success_JSON", func(t *testing.T) {
+		raw, err := json.Marshal(annotationRevisionResult{Schema: 1, Status: "conflict", BeforeHeads: []string{"old"}, Heads: []string{"new"}})
+		if err != nil || len(raw) == 0 {
+			t.Fatal(err)
+		}
+		var decoded map[string]any
+		if json.Unmarshal(raw, &decoded) != nil || decoded["native_write_observed"] != false || decoded["native_apply_attempted"] != false {
+			t.Fatal("conflict flags not explicit")
+		}
+	})
+}
