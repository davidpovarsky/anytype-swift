+type nativeLifecycleWire struct {
+	AnnotationTypeID    string   `json:"annotation_type_id"`
+	AnnotationTypeKey   string   `json:"annotation_type_unique_key"`
+	AnnotationTypeHeads []string `json:"annotation_type_heads"`
+	nativeRevisionWire
+	MutationID          string   `json:"mutation_object_id"`
+	BeforeMutationHeads []string `json:"before_mutation_heads"`
+	MutationHeads       []string `json:"mutation_heads"`
+	Classification      string   `json:"classification"`
+	DocumentRole        string   `json:"document_role"`
+	DocumentTypeID      string   `json:"document_type_id"`
+	DocumentTypeKey     string   `json:"document_type_unique_key"`
+	ManifestID          string   `json:"manifest_object_id"`
+	ManifestSHA         string   `json:"manifest_sha256"`
+	ManifestJSON        string   `json:"manifest_json"`
+	ManifestHeads       []string `json:"manifest_heads"`
+	PromotionRole       string   `json:"promotion_role"`
+	PromotionTypeID     string   `json:"promotion_type_id"`
+	PromotionTypeKey    string   `json:"promotion_type_unique_key"`
+	PromotionTypeHeads  []string `json:"promotion_type_heads"`
+}
