+)
+
+// This private context exists only inside the versioned revision operation.
+// The original import-v1 path has nil revision and keeps its fresh-only guards.
+// It binds retained identities to a genuine prior export; all new identities,
+// uploads, remapping and creation still run through the original processor.
+type ownedAnnotationRevisionGraph struct {
+	operation         *OwnedAnnotationRevisionOperation
+	graph             *ownedAnnotationGraph
+	existing          map[string]string
+	before            *ownedAnnotationArchive
+	processor         *importProcessor
+	execution         *ownedImportExecution
+	ids               map[string]string
+	attempted         atomic.Bool
+	observed          atomic.Bool
+	mu                sync.Mutex
+	preparedRoot      *state.State
+	rootAfterApply    *pb.SnapshotWithType
+	retainedFailure   error
+	retainedFileHeads map[string][]string
+}
+
+func (r *ownedAnnotationRevisionGraph) retained(plan *ownedAnnotationMemberPlan) string {
+	if r == nil || plan == nil || (plan.role != ownedAnnotationFreshPage && plan.role != ownedAnnotationFileObject) {
+		return ""
+	}
+	return r.existing[plan.sourceID]
+}
+func (r *ownedAnnotationRevisionGraph) observeRetained(ctx context.Context, plan *ownedAnnotationMemberPlan) (*domain.Details, error) {
+	id := r.retained(plan)
+	if id == "" || r.before.snapshots[id] == nil {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	var details *domain.Details
+	err := cache.DoContextFullID(r.operation.getter, ctx, domain.FullID{SpaceID: r.graph.spaceID, ObjectID: id}, func(b smartblock.SmartBlock) error {
+		if b.Id() != id || b.SpaceID() != r.graph.spaceID || b.IsDeleted() || b.Tree() == nil {
+			return ErrAnnotationRevisionConflict
+		}
+		expected := r.before.snapshots[id]
+		current, _, err := revisionSnapshot(b)
+		if err != nil {
+			return err
+		}
+		if plan.role == ownedAnnotationFileObject {
+			// resolveReplacementIDs already checked the exact prior archive
+			// binary. Reproduce the original export's archive filename in a
+			// copied state, while pinning the actual persisted file tree heads.
+			name := domain.NewDetailsFromProto(expected.Snapshot.Data.Details).GetString(bundle.RelationKeySource)
+			if name == "" || current.SbType != expected.SbType {
+				return ErrAnnotationRevisionInvalid
+			}
+			projection := b.NewState().Copy()
+			projection.SetDetailAndBundledRelation(bundle.RelationKeySource, domain.String(name))
+			projected := pbc.NewConverter(projection, false).Convert(b.Type().ToProto())
+			if len(projected) == 0 || len(projected) > ownedArchiveMaxExpanded {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+			current = &pb.SnapshotWithType{}
+			if err := proto.Unmarshal(projected, current); err != nil {
+				return err
+			}
+			heads := sortedRevisionHeads(b.Tree().Heads())
+			if !revisionHeads(heads) {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+			r.mu.Lock()
+			if r.retainedFileHeads == nil {
+				r.retainedFileHeads = make(map[string][]string)
+			}
+			previous, exists := r.retainedFileHeads[id]
+			if !exists {
+				r.retainedFileHeads[id] = heads
+			}
+			r.mu.Unlock()
+			if exists && !slices.Equal(previous, heads) {
+				return fmt.Errorf("%w: retained file tree heads changed", ErrAnnotationRevisionConflict)
+			}
+		}
+		if !revisionSnapshotEqual(current, expected) {
+			return errors.Join(ErrAnnotationRevisionConflict, revisionComparisonError("retained_original_dependency", expected, current))
+		}
+		if err = r.graph.requireCurrentWriter(ctx); err != nil {
+			return err
+		}
+		details = b.NewState().CombinedDetails().Copy()
+		return nil
+	})
+	if err != nil {
+		r.mu.Lock()
+		r.retainedFailure = errors.Join(r.retainedFailure, err)
+		r.mu.Unlock()
+	}
+	return details, err
+}
+
+// Existing identities are returned only after re-observing the exact real tree.
+// Every unbound member delegates to the original ID/key provider and uploader.
+type ownedRevisionIDProvider struct {
+	objectid.IdAndKeyProvider
+	graph *ownedAnnotationGraph
+}
+
+func (p ownedRevisionIDProvider) GetIDAndPayload(ctx context.Context, spaceID string, sn *common.Snapshot, created time.Time, existing bool, origin objectorigin.ObjectOrigin) (string, treestorage.TreeStorageCreatePayload, error) {
+	var empty treestorage.TreeStorageCreatePayload
+	if p.graph == nil || p.graph.revision == nil || sn == nil || spaceID != p.graph.spaceID {
+		return "", empty, ErrAnnotationRevisionInvalid
+	}
+	plan := p.graph.byConverter[sn.Id]
+	if id := p.graph.revision.retained(plan); id != "" {
+		_, err := p.graph.revision.observeRetained(ctx, plan)
+		return id, empty, err
+	}
+	return p.IdAndKeyProvider.GetIDAndPayload(ctx, spaceID, sn, created, existing, origin)
+}
+
+func (r *ownedAnnotationRevisionGraph) createRetained(data *creator.DataObject, sn *common.Snapshot, native creator.Service, plan *ownedAnnotationMemberPlan) (*domain.Details, string, error) {
+	id := r.retained(plan)
+	details, err := r.observeRetained(r.graph.ctx, plan)
+	if err != nil {
+		return nil, id, err
+	}
+	if plan.sourceID != r.operation.sourceRootID {
+		// The preflight compared every retained dependency's entire saved state.
+		// Never reset a dependency as a side effect of updating its parent.
+		return details, id, nil
+	}
+	preparer, ok := native.(interface {
+		PrepareOwnedAnnotationRevisionState(*creator.DataObject, *common.Snapshot) (*state.State, error)
+	})
+	if !ok {
+		return nil, id, ErrAnnotationRevisionUnsupported
+	}
+	prepared, err := preparer.PrepareOwnedAnnotationRevisionState(data, sn)
+	if err != nil {
+		return nil, id, err
+	}
+	if prepared == nil || prepared.RootId() != id {
+		return nil, id, ErrAnnotationRevisionInvalid
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.preparedRoot != nil {
+		return nil, id, ErrAnnotationRevisionInvalid
+	}
+	r.preparedRoot = prepared
+	return details, id, nil
+}
+
+// Preparation runs the REAL original converter, typed Torah remapper, native
+// provider, synchronous file upload and fresh creator. Only the selected root
+// is deferred until the same original root/Archive CAS can be checked again.
+func (o *OwnedAnnotationRevisionOperation) prepareReplacement(target *ownedAnnotationArchive, promotion *revisionPromotionContext, observed *annotationRevisionResult) (*state.State, []annotationRevisionMapping, error) {
+	g := o.owner
+	if o.nativeApp == nil || observed == nil {
+		return nil, nil, ErrAnnotationRevisionInvalid
+	}
+	if err := revisionIdentity(g.archive.snapshots[o.sourceRootID], o.sourceRootID, o.request.AnnotationUUID); err != nil {
+		return nil, nil, err
+	}
+	existing, formats, err := o.resolveReplacementIDs(target)
+	if err != nil {
+		return nil, nil, err
+	}
+	validationIDs := make(map[string]string, len(existing)+len(g.order)+len(target.snapshots))
+	for key, value := range existing {
+		validationIDs[key] = value
+	}
+	for id := range target.snapshots {
+		if validationIDs[id] == "" {
+			validationIDs[id] = id
+		}
+	}
+	for _, id := range g.order {
+		if validationIDs[id] == "" {
+			validationIDs[id] = id
+		}
+	}
+	for _, sourceID := range g.order {
+		plan := g.members[sourceID]
+		if plan.role != ownedAnnotationFreshPage && plan.role != ownedAnnotationFileObject {
+			continue
+		}
+		mapped, err := revisionMapState(plan.snapshot, sourceID, validationIDs[sourceID], validationIDs, formats)
+		if err != nil {
+			return nil, nil, err
+		}
+		if sourceID != o.sourceRootID && existing[sourceID] != "" {
+			if err = o.compareRetainedRevisionMember(plan, mapped, target.snapshots[existing[sourceID]], existing[sourceID]); err != nil {
+				return nil, nil, err
+			}
+		}
+	}
+	// A stale root/Archive or lost writer/restriction is refused BEFORE any
+	// original dependency upload/create is admitted.
+	err = o.withLifecycleLocks(promotion, func(archive smartblock.SmartBlock, collection blockcollection.Collection, b smartblock.SmartBlock) error {
+		current, err := o.observeLifecycleLocked(observed, archive, collection, b, promotion)
+		if err != nil {
+			return err
+		}
+		observed.BeforeHeads = slices.Clone(observed.Heads)
+		if expected := target.snapshots[b.Id()]; !revisionSnapshotEqual(current, expected) {
+			observed.Status = "conflict"
+			return errors.Join(ErrAnnotationRevisionConflict, revisionComparisonError("preparation_root_export", expected, current))
+		}
+		if !o.lifecyclePrecondition(*observed, promotion) {
+			observed.Status = "conflict"
+			return fmt.Errorf("%w: preparation root or Archive precondition changed", ErrAnnotationRevisionConflict)
+		}
+		if observed.IsArchived == nil || *observed.IsArchived {
+			return ErrAnnotationRevisionInvalid
+		}
+		return b.Restrictions().Object.Check(model.Restrictions_Blocks, model.Restrictions_Details)
+	})
+	if err != nil {
+		return nil, nil, err
+	}
+	native, err := prepareOwnedAnnotationGraph(o.ctx, o.nativeApp, o.request.DesiredArchive, sha256.Sum256(o.request.DesiredArchive), o.sourceRootID, o.sourceSpaceID, g.spaceID)
+	if err != nil {
+		return nil, nil, err
+	}
+	revision := &ownedAnnotationRevisionGraph{operation: o, graph: native, existing: existing, before: target}
+	native.revision = revision
+	o.expansion = revision // Keep real side-effect history and stage through completion.
+	owned := newOwnedImportExecution(o.ctx)
+	revision.execution = owned
+	processor, err := newOwnedAnnotationImportProcessor(o.nativeApp, owned, native)
+	if err != nil {
+		return nil, nil, err
+	}
+	revision.processor = processor
+	processor.deps.idProvider = ownedRevisionIDProvider{IdAndKeyProvider: processor.deps.idProvider, graph: native}
+	response := processor.Execute(o.ctx) // Includes original workers and file-slot drain.
+	if response == nil {
+		return nil, nil, ErrAnnotationRevisionUnconfirmed
+	}
+	if response.Err != nil {
+		// The original aggregate import error formats nested errors as text.
+		// Retain the exact typed native refusal observed by our private reader,
+		// without inferring authority from that text or hiding partial effects.
+		revision.mu.Lock()
+		retainedFailure := revision.retainedFailure
+		revision.mu.Unlock()
+		if errors.Is(retainedFailure, ErrAnnotationRevisionConflict) && !revision.attempted.Load() {
+			observed.Status = "conflict"
+		}
+		return nil, nil, errors.Join(response.Err, retainedFailure)
+	}
+	ids, err := native.actualMapping(processor, response)
+	if err != nil {
+		return nil, nil, err
+	}
+	if ids[o.sourceRootID] != o.request.TargetRootID {
+		return nil, nil, ErrAnnotationRevisionUnconfirmed
+	}
+	revision.ids = ids
+	revision.mu.Lock()
+	desired := revision.preparedRoot
+	revision.mu.Unlock()
+	if desired == nil || desired.RootId() != o.request.TargetRootID {
+		return nil, nil, ErrAnnotationRevisionUnconfirmed
+	}
+	mappings := make([]annotationRevisionMapping, 0, len(native.order))
+	for _, sourceID := range native.order {
+		mappings = append(mappings, annotationRevisionMapping{native.archive.spaceID, sourceID, ids[sourceID]})
+		// A promoted root need not retain every original Annotation schema as
+		// a live dependency. Explicitly export ALL actual mapped source objects
+		// through the original exporter so complete mapping remains witnessed.
+		if id := ids[sourceID]; id != o.request.TargetRootID && !slices.Contains(o.extraExportIDs, id) {
+			o.extraExportIDs = append(o.extraExportIDs, id)
+		}
+	}
+	slices.Sort(o.extraExportIDs)
+	return desired, mappings, native.requireCurrentWriter(o.ctx)
+}
+
+func (r *ownedAnnotationRevisionGraph) mergeOutcome(result *annotationRevisionResult, outcome *error) {
+	if r == nil || !r.attempted.Load() {
+		return
+	}
+	result.NativeApplyAttempted = true
+	result.NativeWriteObserved = result.NativeWriteObserved || r.observed.Load()
+	if *outcome != nil {
+		// Partial native dependency effects are not mislabeled conflict/no-effects.
+		result.Status = "applied_unconfirmed"
+		*outcome = errors.Join(ErrAnnotationRevisionUnconfirmed, *outcome)
+	}
+}
+func (r *ownedAnnotationRevisionGraph) compareRetainedExport(plan *ownedAnnotationMemberPlan, observed *pb.SnapshotWithType) error {
+	expected := r.before.snapshots[r.retained(plan)]
+	if plan.sourceID == r.operation.sourceRootID {
+		expected = r.rootAfterApply
+	}
+	if expected == nil || !revisionSnapshotEqual(expected, observed) {
+		return ErrAnnotationRevisionUnconfirmed
+	}
+	return nil
+}
+func (r *ownedAnnotationRevisionGraph) close() error {
+	if r == nil {
+		return nil
+	}
+	if r.execution != nil {
+		r.execution.cancel()
+	}
+	if r.graph != nil && r.graph.stage != nil {
+		return r.graph.stage.Close()
+	}
+	return nil
+}
+func (r *ownedAnnotationRevisionGraph) verifyFinal(actual *ownedAnnotationArchive, root *pb.SnapshotWithType) error {
+	if r == nil || r.processor == nil || len(r.ids) != len(r.graph.members) || root == nil {
+		return ErrAnnotationRevisionUnconfirmed
+	}
+	r.rootAfterApply = proto.Clone(root).(*pb.SnapshotWithType)
+	// This is the revision receipt's full graph check, not an import-v1 success.
+	return r.graph.compareNativeExport(r.operation.ctx, r.processor, r.ids, actual, &OwnedAnnotationReadbackObservation{})
+}
