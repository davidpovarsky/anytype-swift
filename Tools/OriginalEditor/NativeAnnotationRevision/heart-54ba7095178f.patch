diff --git a/core/block/import/owned_annotation_lifecycle.go b/core/block/import/owned_annotation_lifecycle.go
new file mode 100644
index 0000000000000000000000000000000000000000..fea349c7199ba1286db66b68fa6e4697558c1f1a
--- /dev/null
+++ b/core/block/import/owned_annotation_lifecycle.go
@@ -0,0 +1,481 @@
+package importer
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"slices"
+	"sort"
+	"time"
+
+	"github.com/anyproto/anytype-heart/core/block/cache"
+	"github.com/anyproto/anytype-heart/core/block/editor/basic"
+	"github.com/anyproto/anytype-heart/core/block/editor/blockcollection"
+	"github.com/anyproto/anytype-heart/core/block/editor/smartblock"
+	"github.com/anyproto/anytype-heart/core/converter/pbc"
+	"github.com/anyproto/anytype-heart/core/domain"
+	annotationschema "github.com/anyproto/anytype-heart/core/pinkha/annotationschema/definition"
+	"github.com/anyproto/anytype-heart/pb"
+	"github.com/anyproto/anytype-heart/pkg/lib/bundle"
+	coresb "github.com/anyproto/anytype-heart/pkg/lib/core/smartblock"
+	"github.com/anyproto/anytype-heart/pkg/lib/pb/model"
+	"github.com/gogo/protobuf/proto"
+	"github.com/google/uuid"
+)
+
+func revisionDocumentRole(role string) bool {
+	return role == "chiddush" || role == "article" || role == "research"
+}
+func hasAnnotationLifecycleFields(r annotationRevisionRequest) bool {
+	return r.DocumentRole != "" || r.PromotionRole != "" || r.ExpectedArchiveID != "" || len(r.ExpectedArchiveHeads) != 0 ||
+		r.ExpectedIsArchived != nil || hasRevisionPromotionWitness(r)
+}
+func hasRevisionPromotionWitness(r annotationRevisionRequest) bool {
+	return r.ExpectedManifestID != "" || r.ExpectedManifestSHA256 != "" || len(r.ExpectedManifestHeads) != 0 ||
+		r.ExpectedDestinationTypeID != "" || r.ExpectedDestinationTypeKey != "" || len(r.ExpectedDestinationTypeHeads) != 0 ||
+		r.ExpectedAnnotationTypeID != "" || r.ExpectedAnnotationTypeKey != "" || len(r.ExpectedAnnotationTypeHeads) != 0
+}
+func validRevisionPromotionWitness(r annotationRevisionRequest) bool {
+	return revisionText(r.ExpectedManifestID) && revisionHash(r.ExpectedManifestSHA256) && revisionHeads(r.ExpectedManifestHeads) &&
+		revisionText(r.ExpectedDestinationTypeID) && revisionText(r.ExpectedDestinationTypeKey) && revisionHeads(r.ExpectedDestinationTypeHeads) &&
+		revisionText(r.ExpectedAnnotationTypeID) && r.ExpectedAnnotationTypeKey == annotationschema.TypeUniqueKey && revisionHeads(r.ExpectedAnnotationTypeHeads)
+}
+func validateAnnotationLifecycleRequest(r annotationRevisionRequest) error {
+	if (r.DocumentRole != "" && !revisionDocumentRole(r.DocumentRole)) || (r.PromotionRole != "" && !revisionDocumentRole(r.PromotionRole)) ||
+		(r.DocumentRole != "" && r.PromotionRole != "") {
+		return ErrAnnotationRevisionInvalid
+	}
+	if r.Operation == "replace_promoted" {
+		if len(r.DesiredArchive) < 22 || len(r.DesiredArchive) > ownedArchiveMaxBytes || !revisionHash(r.DesiredArchiveSHA256) {
+			return ErrAnnotationRevisionInvalid
+		}
+		digest := sha256.Sum256(r.DesiredArchive)
+		if hex.EncodeToString(digest[:]) != r.DesiredArchiveSHA256 {
+			return ErrAnnotationRevisionInvalid
+		}
+	} else if len(r.DesiredArchive) != 0 || r.DesiredArchiveSHA256 != "" {
+		return ErrAnnotationRevisionInvalid
+	}
+	switch r.Operation {
+	case "read_lifecycle", "read_promoted":
+		if len(r.ExpectedHeads) != 0 || r.ExpectedRootSHA256 != "" || r.ExpectedArchiveID != "" ||
+			len(r.ExpectedArchiveHeads) != 0 || r.ExpectedIsArchived != nil || hasRevisionPromotionWitness(r) {
+			return ErrAnnotationRevisionInvalid
+		}
+		if r.Operation == "read_promoted" && (r.DocumentRole == "" || r.PromotionRole != "") {
+			return ErrAnnotationRevisionInvalid
+		}
+		if r.Operation == "read_lifecycle" && r.DocumentRole != "" {
+			return ErrAnnotationRevisionInvalid
+		}
+	case "archive", "restore", "promote", "revert_promotion", "replace_promoted":
+		if !revisionHeads(r.ExpectedHeads) || !revisionHash(r.ExpectedRootSHA256) || !revisionText(r.ExpectedArchiveID) ||
+			!revisionHeads(r.ExpectedArchiveHeads) || r.ExpectedIsArchived == nil {
+			return ErrAnnotationRevisionInvalid
+		}
+		switch r.Operation {
+		case "promote":
+			if r.DocumentRole != "" || !revisionDocumentRole(r.PromotionRole) || !validRevisionPromotionWitness(r) {
+				return ErrAnnotationRevisionInvalid
+			}
+		case "revert_promotion", "replace_promoted":
+			if !revisionDocumentRole(r.DocumentRole) || r.PromotionRole != "" || !validRevisionPromotionWitness(r) {
+				return ErrAnnotationRevisionInvalid
+			}
+		default:
+			if r.PromotionRole != "" || hasRevisionPromotionWitness(r) {
+				return ErrAnnotationRevisionInvalid
+			}
+		}
+	default:
+		return ErrAnnotationRevisionInvalid
+	}
+	return nil
+}
+
+func (o *OwnedAnnotationRevisionOperation) lifecycleIdentity(b smartblock.SmartBlock, snapshot *pb.SnapshotWithType, promotion *revisionPromotionContext) error {
+	if b.Id() != o.request.TargetRootID || b.SpaceID() != o.owner.spaceID || b.IsDeleted() || b.Tree() == nil {
+		return ErrAnnotationRevisionInvalid
+	}
+	if o.request.DocumentRole == "" {
+		return revisionIdentity(snapshot, b.Id(), o.request.AnnotationUUID)
+	}
+	return revisionPromotedIdentity(snapshot, b.Id(), o.request.AnnotationUUID, o.request.DocumentRole, promotion)
+}
+
+// Promotion is a separate verifier. It never expands the dedicated Annotation
+// verifier to accept arbitrary Document types or caller-provided type IDs.
+func revisionPromotedIdentity(snapshot *pb.SnapshotWithType, id, expectedUUID, role string, promotion *revisionPromotionContext) error {
+	if promotion == nil || promotion.role != role || !revisionDocumentRole(role) ||
+		snapshot == nil || snapshot.Snapshot == nil || snapshot.Snapshot.Data == nil || snapshot.SbType != coresb.SmartBlockTypePage.ToProto() {
+		return ErrAnnotationRevisionInvalid
+	}
+	d := snapshot.Snapshot.Data
+	if len(d.ObjectTypes) != 1 || d.ObjectTypes[0] != promotion.typeKey || d.Key != "" {
+		return ErrAnnotationRevisionInvalid
+	}
+	details := domain.NewDetailsFromProto(d.Details)
+	actual, ae := uuid.Parse(details.GetString("pinkhaTorahAnnotationUUID"))
+	expected, ee := uuid.Parse(expectedUUID)
+	if ae != nil || ee != nil || actual == uuid.Nil || actual != expected ||
+		details.GetString("pinkhaTorahAnnotationProtocol") != annotationschema.Protocol ||
+		details.GetString("pinkhaTorahAnnotationClassification") != role {
+		return ErrAnnotationRevisionInvalid
+	}
+	for _, block := range d.Blocks {
+		if block != nil && block.Id == id && block.GetSmartblock() != nil {
+			return nil
+		}
+	}
+	return ErrAnnotationRevisionInvalid
+}
+
+// Lock order matches the original archive path: Archive, optional native
+// manifest and destination type, then the Annotation/Document object tree.
+// Native Archive hooks schedule their original reconciliation asynchronously;
+// no original callback/hook is skipped and no mutex is re-entered here.
+func (o *OwnedAnnotationRevisionOperation) withLifecycleLocks(promotion *revisionPromotionContext, body func(smartblock.SmartBlock, blockcollection.Collection, smartblock.SmartBlock) error) error {
+	archiveID := o.owner.space.DerivedIDs().Archive
+	if archiveID == "" || archiveID == o.request.TargetRootID {
+		return ErrAnnotationRevisionInvalid
+	}
+	return cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: archiveID}, func(archive smartblock.SmartBlock) error {
+		collection, ok := archive.(blockcollection.Collection)
+		if !ok || archive.IsDeleted() || archive.Tree() == nil {
+			return ErrAnnotationRevisionInvalid
+		}
+		root := func() error {
+			return cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: o.request.TargetRootID}, func(b smartblock.SmartBlock) error {
+				return body(archive, collection, b)
+			})
+		}
+		if promotion == nil {
+			return root()
+		}
+		if found, _ := collection.HasObject(promotion.manifestID); found {
+			return ErrAnnotationRevisionInvalid
+		}
+		if found, _ := collection.HasObject(promotion.typeID); found {
+			return ErrAnnotationRevisionInvalid
+		}
+		if promotion.annotation == nil {
+			return ErrAnnotationRevisionInvalid
+		}
+		if found, _ := collection.HasObject(promotion.annotation.id); found {
+			return ErrAnnotationRevisionInvalid
+		}
+		return o.withRevisionPromotionLocks(promotion, root)
+	})
+}
+
+func (o *OwnedAnnotationRevisionOperation) observeLifecycleLocked(result *annotationRevisionResult, archive smartblock.SmartBlock, collection blockcollection.Collection, b smartblock.SmartBlock, promotion *revisionPromotionContext) (*pb.SnapshotWithType, error) {
+	if err := o.owner.requireCurrentWriter(o.ctx); err != nil {
+		return nil, err
+	}
+	snapshot, digest, err := revisionSnapshot(b)
+	if err != nil {
+		return nil, err
+	}
+	if err = o.lifecycleIdentity(b, snapshot, promotion); err != nil {
+		return nil, err
+	}
+	heads, archiveHeads := sortedRevisionHeads(b.Tree().Heads()), sortedRevisionHeads(archive.Tree().Heads())
+	if !revisionHeads(heads) || !revisionHeads(archiveHeads) {
+		return nil, ErrAnnotationRevisionUnconfirmed
+	}
+	archived, _ := collection.HasObject(b.Id())
+	result.Heads, result.RootSnapshotSHA256 = heads, digest
+	result.ArchiveObjectID, result.ArchiveHeads, result.IsArchived = archive.Id(), archiveHeads, &archived
+	result.Classification = "annotation"
+	if o.request.DocumentRole != "" {
+		result.Classification, result.DocumentRole = "promoted_document", o.request.DocumentRole
+		result.DocumentTypeID, result.DocumentTypeUniqueKey = promotion.typeID, promotion.typeKey
+	}
+	if promotion != nil {
+		promotion.applyReceipt(result)
+	}
+	return snapshot, nil
+}
+
+func (o *OwnedAnnotationRevisionOperation) lifecyclePrecondition(result annotationRevisionResult, promotion *revisionPromotionContext) bool {
+	r := o.request
+	if !slices.Equal(result.Heads, r.ExpectedHeads) || result.RootSnapshotSHA256 != r.ExpectedRootSHA256 ||
+		result.ArchiveObjectID != r.ExpectedArchiveID || !slices.Equal(result.ArchiveHeads, r.ExpectedArchiveHeads) ||
+		result.IsArchived == nil || r.ExpectedIsArchived == nil || *result.IsArchived != *r.ExpectedIsArchived {
+		return false
+	}
+	if r.Operation == "promote" || r.Operation == "revert_promotion" || r.Operation == "replace_promoted" {
+		return promotion != nil && promotion.manifestID == r.ExpectedManifestID && promotion.manifestSHA == r.ExpectedManifestSHA256 &&
+			slices.Equal(promotion.manifestHeads, r.ExpectedManifestHeads) && promotion.typeID == r.ExpectedDestinationTypeID &&
+			promotion.typeKey == r.ExpectedDestinationTypeKey && slices.Equal(promotion.typeHeads, r.ExpectedDestinationTypeHeads) && promotion.hasExpectedTypeWitness(r)
+	}
+	return true
+}
+
+func (o *OwnedAnnotationRevisionOperation) executeLifecycle(result annotationRevisionResult) (annotationRevisionResult, error) {
+	role := o.request.PromotionRole
+	if role == "" {
+		role = o.request.DocumentRole
+	}
+	var promotion *revisionPromotionContext
+	var err error
+	if role != "" {
+		promotion, err = o.discoverRevisionPromotion(role)
+		if err != nil {
+			return result, err
+		}
+
+		o.extraExportIDs = []string{promotion.annotation.id, promotion.typeID}
+	}
+	before, err := o.exportRoot("lifecycle-before")
+	if err != nil {
+		return result, err
+	}
+	var expected *pb.SnapshotWithType
+	completion := ""
+	err = o.withLifecycleLocks(promotion, func(archive smartblock.SmartBlock, collection blockcollection.Collection, b smartblock.SmartBlock) error {
+		current, err := o.observeLifecycleLocked(&result, archive, collection, b, promotion)
+		if err != nil {
+			return err
+		}
+		result.BeforeHeads = slices.Clone(result.Heads)
+		if !revisionSnapshotEqual(current, before.snapshots[b.Id()]) {
+			result.Status = "conflict"
+			return ErrAnnotationRevisionConflict
+		}
+		if o.request.Operation == "read_lifecycle" || o.request.Operation == "read_promoted" {
+			result.Status = o.request.Operation
+			expected = current
+			return nil
+		}
+		if !o.lifecyclePrecondition(result, promotion) {
+			result.Status = "conflict"
+			return ErrAnnotationRevisionConflict
+		}
+		switch o.request.Operation {
+		case "archive", "restore":
+			if o.request.Operation == "archive" {
+				if err = b.Restrictions().Object.Check(model.Restrictions_Delete); err != nil {
+					return err
+				}
+			}
+			target := o.request.Operation == "archive"
+			result.MutationObjectID, result.BeforeMutationHeads = archive.Id(), slices.Clone(result.ArchiveHeads)
+			if *result.IsArchived == target {
+				result.Status = "unchanged"
+				result.MutationHeads = slices.Clone(result.ArchiveHeads)
+				expected = current
+				return nil
+			}
+			result.Status, result.NativeApplyAttempted = "applied_unconfirmed", true
+			if target {
+				err = collection.AddObject(b.Id())
+			} else {
+				err = collection.RemoveObject(b.Id())
+			}
+			result.MutationHeads = sortedRevisionHeads(archive.Tree().Heads())
+			result.NativeWriteObserved = !slices.Equal(result.BeforeMutationHeads, result.MutationHeads)
+			if err != nil {
+				return err
+			}
+			observed, _, hash, observeErr := o.lockedObservationForLifecycle(b, promotion)
+			if observeErr != nil {
+				return observeErr
+			}
+			member, _ := collection.HasObject(b.Id())
+			if !result.NativeWriteObserved || member != target || !revisionSnapshotEqual(current, observed) {
+				return fmt.Errorf("%w: archive_apply write=%t membership=%t body=%t", ErrAnnotationRevisionUnconfirmed, result.NativeWriteObserved, member == target, revisionSnapshotEqual(current, observed))
+			}
+			result.Heads, result.RootSnapshotSHA256 = sortedRevisionHeads(b.Tree().Heads()), hash
+			result.ArchiveHeads, result.IsArchived = slices.Clone(result.MutationHeads), &member
+			expected = observed
+			if target {
+				completion = "archived"
+			} else {
+				completion = "restored"
+			}
+		case "promote", "revert_promotion":
+			if *result.IsArchived || promotion == nil {
+				return ErrAnnotationRevisionInvalid
+			}
+			native, ok := b.(basic.CommonOperations)
+			if !ok {
+				return ErrAnnotationRevisionUnsupported
+			}
+			targetKey, classification := promotion.typeKey, promotion.role
+			if o.request.Operation == "revert_promotion" {
+				targetKey, classification = promotion.annotation.key, "annotation"
+			}
+			key, err := domain.UnmarshalUniqueKey(targetKey)
+			if err != nil || key.SmartblockType() != coresb.SmartBlockTypeObjectType {
+				return ErrAnnotationRevisionInvalid
+			}
+			desired := b.NewState()
+			if err = native.SetObjectTypesInState(desired, []domain.TypeKey{domain.TypeKey(key.InternalKey())}, false); err != nil {
+				return err
+			}
+			desired.SetDetail(domain.RelationKey("pinkhaTorahAnnotationClassification"), domain.String(classification))
+			desired.AddRelationLinks(&model.RelationLink{Key: "pinkhaTorahAnnotationClassification", Format: model.RelationFormat_longtext})
+			expected = &pb.SnapshotWithType{}
+			if err = proto.Unmarshal(pbc.NewConverter(desired, false).Convert(b.Type().ToProto()), expected); err != nil {
+				return err
+			}
+			if !revisionPromotionPayloadEqual(current, expected) {
+				return ErrAnnotationRevisionUnsupported
+			}
+			result.MutationObjectID, result.BeforeMutationHeads = b.Id(), slices.Clone(result.Heads)
+			result.Status, result.NativeApplyAttempted = "applied_unconfirmed", true
+			applyErr := b.Apply(desired)
+			result.MutationHeads = sortedRevisionHeads(b.Tree().Heads())
+			result.NativeWriteObserved = !slices.Equal(result.BeforeMutationHeads, result.MutationHeads)
+			if applyErr != nil {
+				return applyErr
+			}
+			observed, hash, err := revisionSnapshot(b)
+			if err != nil {
+				return err
+			}
+			identityErr := revisionPromotedIdentity(observed, b.Id(), o.request.AnnotationUUID, promotion.role, promotion)
+			if o.request.Operation == "revert_promotion" {
+				identityErr = revisionIdentity(observed, b.Id(), o.request.AnnotationUUID)
+			}
+			if !result.NativeWriteObserved || identityErr != nil || !revisionSnapshotEqual(expected, observed) || !revisionPromotionPayloadEqual(current, observed) {
+				return ErrAnnotationRevisionUnconfirmed
+			}
+			result.Heads, result.RootSnapshotSHA256 = slices.Clone(result.MutationHeads), hash
+			result.Classification, result.DocumentRole = "promoted_document", promotion.role
+			result.DocumentTypeID, result.DocumentTypeUniqueKey = promotion.typeID, promotion.typeKey
+			expected = observed
+			completion = "promoted"
+			if o.request.Operation == "revert_promotion" {
+				result.Classification, result.DocumentRole = "annotation", ""
+				result.DocumentTypeID, result.DocumentTypeUniqueKey = "", ""
+				completion = "reverted"
+			}
+		default:
+			return ErrAnnotationRevisionInvalid
+		}
+		return nil
+	})
+	if err != nil {
+		return result, err
+	}
+	if result.IsArchived == nil || expected == nil {
+		return result, ErrAnnotationRevisionUnconfirmed
+	}
+	if err = o.waitLifecycleProjection(*result.IsArchived); err != nil {
+		return result, err
+	}
+	observed, err := o.exportRoot("lifecycle-after")
+	if err != nil {
+		return result, err
+	}
+	if !revisionSnapshotEqual(expected, observed.snapshots[o.request.TargetRootID]) {
+		return result, revisionComparisonError("lifecycle_export", expected, observed.snapshots[o.request.TargetRootID])
+	}
+	// Recheck all actual witnesses after the asynchronous original projection
+	// and full export. Another native change is never accepted as our receipt.
+	err = o.withLifecycleLocks(promotion, func(archive smartblock.SmartBlock, collection blockcollection.Collection, b smartblock.SmartBlock) error {
+		root, hash, err := revisionSnapshot(b)
+		if err != nil {
+			return err
+		}
+		if completion != "reverted" && (completion == "promoted" || o.request.DocumentRole != "") {
+			role := result.DocumentRole
+			if err = revisionPromotedIdentity(root, b.Id(), o.request.AnnotationUUID, role, promotion); err != nil {
+				return err
+			}
+		} else if err = revisionIdentity(root, b.Id(), o.request.AnnotationUUID); err != nil {
+			return err
+		}
+		member, _ := collection.HasObject(b.Id())
+		if !slices.Equal(sortedRevisionHeads(b.Tree().Heads()), result.Heads) || hash != result.RootSnapshotSHA256 ||
+			!slices.Equal(sortedRevisionHeads(archive.Tree().Heads()), result.ArchiveHeads) || member != *result.IsArchived ||
+			!revisionSnapshotEqual(root, expected) {
+			return fmt.Errorf("%w: lifecycle_after root_heads=%t root_hash=%t archive_heads=%t membership=%t root_body=%t", ErrAnnotationRevisionUnconfirmed, slices.Equal(sortedRevisionHeads(b.Tree().Heads()), result.Heads), hash == result.RootSnapshotSHA256, slices.Equal(sortedRevisionHeads(archive.Tree().Heads()), result.ArchiveHeads), member == *result.IsArchived, revisionSnapshotEqual(root, expected))
+		}
+		return o.owner.requireCurrentWriter(o.ctx)
+	})
+	if err != nil {
+		return result, err
+	}
+	ids := make([]string, 0, len(observed.snapshots))
+	for id := range observed.snapshots {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		result.Mappings = append(result.Mappings, annotationRevisionMapping{o.owner.spaceID, id, id})
+	}
+	result.NativeArchive = slices.Clone(observed.raw)
+	digest := sha256.Sum256(observed.raw)
+	result.NativeArchiveSHA256 = hex.EncodeToString(digest[:])
+	if completion != "" {
+		result.Status = completion
+	}
+	return result, nil
+}
+
+func (o *OwnedAnnotationRevisionOperation) lockedObservationForLifecycle(b smartblock.SmartBlock, promotion *revisionPromotionContext) (*pb.SnapshotWithType, []string, string, error) {
+	if err := o.owner.requireCurrentWriter(o.ctx); err != nil {
+		return nil, nil, "", err
+	}
+	snapshot, digest, err := revisionSnapshot(b)
+	if err != nil {
+		return nil, nil, "", err
+	}
+	if err = o.lifecycleIdentity(b, snapshot, promotion); err != nil {
+		return nil, nil, "", err
+	}
+	heads := sortedRevisionHeads(b.Tree().Heads())
+	if !revisionHeads(heads) {
+		return nil, nil, "", ErrAnnotationRevisionUnconfirmed
+	}
+	return snapshot, heads, digest, nil
+}
+func (o *OwnedAnnotationRevisionOperation) waitLifecycleProjection(expected bool) error {
+	if o.owner.store == nil {
+		return ErrAnnotationRevisionInvalid
+	}
+	timeout := time.NewTimer(10 * time.Second)
+	defer timeout.Stop()
+	tick := time.NewTicker(20 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		details, err := o.owner.store.SpaceIndex(o.owner.spaceID).GetDetails(o.request.TargetRootID)
+		if err == nil && details != nil && !details.GetBool(bundle.RelationKeyIsDeleted) && details.GetBool(bundle.RelationKeyIsArchived) == expected {
+			return nil
+		}
+		select {
+		case <-o.ctx.Done():
+			return o.ctx.Err()
+		case <-timeout.C:
+			return errors.Join(ErrAnnotationRevisionUnconfirmed, err)
+		case <-tick.C:
+		}
+	}
+}
+
+// Only normal type/layout bookkeeping and the explicit classification change
+// may differ. Every block, text/mark tuple, child, anchor, link, collection and
+// other detail remains compared completely.
+func revisionPromotionPayloadEqual(before, after *pb.SnapshotWithType) bool {
+	a, err := canonicalRevisionSnapshot(before)
+	if err != nil {
+		return false
+	}
+	b, err := canonicalRevisionSnapshot(after)
+	if err != nil {
+		return false
+	}
+	for _, x := range []*pb.SnapshotWithType{a, b} {
+		x.Snapshot.Data.ObjectTypes = nil
+		details := domain.NewDetailsFromProto(x.Snapshot.Data.Details)
+		for _, key := range []domain.RelationKey{bundle.RelationKeyType, bundle.RelationKeyLayout, bundle.RelationKeyLayoutAlign, bundle.RelationKeyFeaturedRelations, bundle.RelationKeyInternalFlags, "pinkhaTorahAnnotationClassification"} {
+			details.Delete(key)
+		}
+		x.Snapshot.Data.Details = details.ToProto()
+	}
+	return proto.Equal(a, b)
+}
