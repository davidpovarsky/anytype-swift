+package objectcreator
+
+import (
+	"github.com/anyproto/anytype-heart/core/block/editor/state"
+	"github.com/anyproto/anytype-heart/core/block/import/common"
+	"github.com/anyproto/anytype-heart/pkg/lib/bundle"
+	coresb "github.com/anyproto/anytype-heart/pkg/lib/core/smartblock"
+)
+
+// PrepareOwnedAnnotationRevisionState uses the original converter/provider's
+// DataObject and the ordinary creator's real state transformations. It performs
+// no create/reset/Apply, schema installation, fetch, favorite or archive write.
+// Only the revision operation may later Apply this state under its native CAS.
+func (oc *ObjectCreator) PrepareOwnedAnnotationRevisionState(data *DataObject, sn *common.Snapshot) (*state.State, error) {
+	if oc == nil || data == nil || data.ctx == nil || data.spaceID == "" || sn == nil ||
+		sn.Id == "" || sn.Snapshot == nil || sn.Snapshot.Data == nil || sn.Snapshot.Data.Details == nil ||
+		sn.Snapshot.SbType != coresb.SmartBlockTypePage || len(sn.Snapshot.FileKeys) != 0 ||
+		sn.Snapshot.Data.Key != "" || sn.Snapshot.Data.FileInfo != nil {
+		return nil, errOwnedAnnotationFreshPayload
+	}
+	if err := data.ctx.Err(); err != nil {
+		return nil, err
+	}
+	target := data.oldIDtoNew[sn.Id]
+	if target == "" || data.createPayloads[target].RootRawChange != nil ||
+		sn.Snapshot.Data.Details.GetString(bundle.RelationKeyUniqueKey) != "" ||
+		sn.Snapshot.Data.Details.GetBool(bundle.RelationKeyIsFavorite) ||
+		sn.Snapshot.Data.Details.GetBool(bundle.RelationKeyIsArchived) {
+		return nil, errOwnedAnnotationFreshPayload
+	}
+	if _, present := data.newIdsSet[target]; !present {
+		return nil, errOwnedAnnotationFreshPayload
+	}
+	st, err := oc.prepareImportedState(data, sn)
+	if err != nil {
+		return nil, err
+	}
+	if err = oc.remapImportedState(data, sn, st); err != nil {
+		return nil, err
+	}
+	oc.updateKeys(st, data.oldIDtoNew, data.relationKeysToFormat)
+	if st.Store() != nil {
+		oc.updateLinksInCollections(st, data.oldIDtoNew, false)
+	}
+	admitted := &ownedAnnotationCreate{data: data, targetID: target}
+	if err = admitted.validatePreparedState(st, oc.formatFetcher); err != nil {
+		return nil, err
+	}
+	if err = st.Validate(); err != nil {
+		return nil, err
+	}
+	return st, nil
+}
