+func lifecycleNativeCall(t *testing.T, f *ownedClosedFixture, label, operation, root, annotationUUID, role string, base nativeLifecycleWire) (nativeLifecycleWire, error) {
+	return lifecycleNativeCallSource(t, f, label, operation, root, annotationUUID, role, base, nil)
+}
+func lifecycleNativeCallSource(t *testing.T, f *ownedClosedFixture, label, operation, root, annotationUUID, role string, base nativeLifecycleWire, source *ownedClosedSpecimen) (nativeLifecycleWire, error) {
+	t.Helper()
+	request := map[string]any{"schema": 1, "operation": operation, "target_root_id": root, "annotation_uuid": strings.ToUpper(annotationUUID)}
+	switch operation {
+	case "read_lifecycle":
+		if role != "" {
+			request["promotion_role"] = role
+		}
+	case "read_promoted":
+		request["document_role"] = role
+	case "archive", "restore", "promote", "revert_promotion", "replace_promoted":
+		request["expected_heads"] = base.Heads
+		request["expected_root_sha256"] = base.RootSHA
+		request["expected_archive_id"] = base.ArchiveID
+		request["expected_archive_heads"] = base.ArchiveHeads
+		request["expected_is_archived"] = base.IsArchived
+		if operation == "promote" || operation == "revert_promotion" || operation == "replace_promoted" {
+			if operation == "promote" {
+				request["promotion_role"] = role
+			} else {
+				request["document_role"] = role
+			}
+			request["expected_annotation_type_id"] = base.AnnotationTypeID
+			request["expected_annotation_type_unique_key"] = base.AnnotationTypeKey
+			request["expected_annotation_type_heads"] = base.AnnotationTypeHeads
+			request["expected_manifest_id"] = base.ManifestID
+			request["expected_manifest_sha256"] = base.ManifestSHA
+			request["expected_manifest_heads"] = base.ManifestHeads
+			request["expected_destination_type_id"] = base.PromotionTypeID
+			request["expected_destination_type_unique_key"] = base.PromotionTypeKey
+			request["expected_destination_type_heads"] = base.PromotionTypeHeads
+		} else if role != "" {
+			request["document_role"] = role
+		}
+	default:
+		t.Fatal("invalid test operation")
+	}
+	sourceRoot, sourceSpace := root, f.spc.Id()
+	if source != nil {
+		if operation != "replace_promoted" {
+			t.Fatal("unexpected saved source")
+		}
+		request["desired_archive"] = source.Raw
+		request["desired_archive_sha256"] = hex.EncodeToString(source.Digest[:])
+		sourceRoot, sourceSpace = source.RootID, source.SourceSpace
+	}
+	raw, err := revisionNativeJSONCall(t, f, label, root, sourceRoot, sourceSpace, request)
+	var value nativeLifecycleWire
+	ownedClosedNoError(t, json.Unmarshal(raw, &value))
+	if err == nil {
+		if value.ArchiveID != f.spc.DerivedIDs().Archive || len(value.ArchiveHeads) == 0 || value.IsArchived == nil {
+			t.Fatal("actual Archive witness missing")
+		}
+		if role != "" {
+			digest := sha256.Sum256([]byte(value.ManifestJSON))
+			if value.ManifestID == "" || len(value.ManifestHeads) == 0 || hex.EncodeToString(digest[:]) != value.ManifestSHA ||
+				value.PromotionRole != role || value.PromotionTypeID == "" || value.PromotionTypeKey == "" || len(value.PromotionTypeHeads) == 0 || value.AnnotationTypeID == "" || value.AnnotationTypeKey != annotationschema.TypeUniqueKey || len(value.AnnotationTypeHeads) == 0 {
+				t.Fatal("actual original manifest/type observation missing")
+			}
+			lifecycleNativeSchema(t, value.NativeArchive, value.AnnotationTypeID, value.AnnotationTypeKey)
+			lifecycleNativeSchema(t, value.NativeArchive, value.PromotionTypeID, value.PromotionTypeKey)
+		}
+	}
+	return value, err
+}
+func lifecycleUUID(t *testing.T, s *ownedClosedSpecimen) string {
+	t.Helper()
+	return domain.NewDetailsFromProto(s.Snapshots[s.RootID].Snapshot.Data.Details).GetString("pinkhaTorahAnnotationUUID")
+}
+func lifecycleAssertNoEffects(t *testing.T, value nativeLifecycleWire, err error) {
+	t.Helper()
+	if !errors.Is(err, importer.ErrAnnotationRevisionConflict) || value.Status != "conflict" || value.NativeApplyAttempted || value.NativeWriteObserved {
+		t.Fatalf("lifecycle conflict was not an explicit no-effects refusal: %s %v", value.Status, err)
+	}
+}
+func TestOtzariaNativeAnnotationArchiveRestore(t *testing.T) {
+	f := newOwnedClosedFixture(t)
+	source := f.produce(t, "format")
+	root, annotationUUID := source.RootID, lifecycleUUID(t, source)
+	before, err := lifecycleNativeCall(t, f, "lifecycle-before", "read_lifecycle", root, annotationUUID, "", nativeLifecycleWire{})
+	ownedClosedNoError(t, err)
+	if before.Status != "read_lifecycle" || *before.IsArchived || before.NativeApplyAttempted || before.NativeWriteObserved {
+		t.Fatal("invalid initial actual read")
+	}
+	archived, err := lifecycleNativeCall(t, f, "archive", "archive", root, annotationUUID, "", before)
+	ownedClosedNoError(t, err)
+	if archived.Status != "archived" || !*archived.IsArchived || !archived.NativeApplyAttempted || !archived.NativeWriteObserved ||
+		archived.MutationID != before.ArchiveID || slices.Equal(archived.ArchiveHeads, before.ArchiveHeads) ||
+		!slices.Equal(archived.Heads, before.Heads) || archived.RootSHA != before.RootSHA {
+		t.Fatal("archive changed content or lacks actual collection mutation")
+	}
+	strict, strictErr := revisionNativeCall(t, f, "archived-strict-read", root, annotationUUID, nil, nativeRevisionWire{})
+	if strictErr == nil || strict.NativeApplyAttempted || strict.NativeWriteObserved {
+		t.Fatal("ordinary reader accepted archived Annotation")
+	}
+	staleReplace, replaceErr := revisionNativeCall(t, f, "archive-invalidates-saved-update", root, annotationUUID, source, before.nativeRevisionWire)
+	if !errors.Is(replaceErr, importer.ErrAnnotationRevisionConflict) || staleReplace.NativeApplyAttempted || staleReplace.NativeWriteObserved {
+		t.Fatal("Archive change was not part of root update CAS")
+	}
+	freshArchived, replaceErr := revisionNativeCall(t, f, "archived-fresh-update-refused", root, annotationUUID, source, archived.nativeRevisionWire)
+	if replaceErr == nil || freshArchived.NativeApplyAttempted || freshArchived.NativeWriteObserved {
+		t.Fatal("fresh archived token permitted ordinary body update")
+	}
+	observed, err := lifecycleNativeCall(t, f, "archived-read", "read_lifecycle", root, annotationUUID, "", nativeLifecycleWire{})
+	ownedClosedNoError(t, err)
+	if !*observed.IsArchived || observed.RootSHA != before.RootSHA {
+		t.Fatal("archived Annotation could not be read")
+	}
+	again, err := lifecycleNativeCall(t, f, "archive-idempotent", "archive", root, annotationUUID, "", observed)
+	ownedClosedNoError(t, err)
+	if again.Status != "unchanged" || again.NativeApplyAttempted || again.NativeWriteObserved {
+		t.Fatal("idempotent archive mutated")
+	}
+	stale, err := lifecycleNativeCall(t, f, "stale-root-archive", "restore", root, annotationUUID, "", before)
+	lifecycleAssertNoEffects(t, stale, err)
+	restored, err := lifecycleNativeCall(t, f, "restore", "restore", root, annotationUUID, "", again)
+	ownedClosedNoError(t, err)
+	if restored.Status != "restored" || *restored.IsArchived || !restored.NativeApplyAttempted || !restored.NativeWriteObserved ||
+		!slices.Equal(restored.Heads, before.Heads) || restored.RootSHA != before.RootSHA {
+		t.Fatal("restore did not preserve the original rich object")
+	}
+	stale, err = lifecycleNativeCall(t, f, "stale-after-cycle", "archive", root, annotationUUID, "", before)
+	lifecycleAssertNoEffects(t, stale, err)
+	// An unrelated original Archive mutation also invalidates a captured token.
+	second := f.annotation(t, "Another actual original Annotation")
+	secondRead, err := lifecycleNativeCall(t, f, "second-read", "read_lifecycle", second, f.detailsUUID(t, second), "", nativeLifecycleWire{})
+	ownedClosedNoError(t, err)
+	_, err = lifecycleNativeCall(t, f, "second-archive", "archive", second, f.detailsUUID(t, second), "", secondRead)
+	ownedClosedNoError(t, err)
+	stale, err = lifecycleNativeCall(t, f, "other-archive-change", "archive", root, annotationUUID, "", restored)
+	lifecycleAssertNoEffects(t, stale, err)
+	current, err := lifecycleNativeCall(t, f, "final-read", "read_lifecycle", root, annotationUUID, "", nativeLifecycleWire{})
+	ownedClosedNoError(t, err)
+	if current.RootSHA != before.RootSHA || *current.IsArchived || !slices.Equal(current.Heads, before.Heads) {
+		t.Fatal("refused lifecycle intent altered the root")
+	}
+	f.receipt(t, "native-archive-restore-acceptance.json", map[string]any{
+		"actual_native_archive_collection_apply": true, "root_and_complete_rich_content_unchanged": true,
+		"read_archived_annotation": true, "archive_restore_idempotence": true, "root_unchanged_archive_cas_conflict": true,
+		"unrelated_archive_change_conflicts": true, "original_projection_observed": true,
+		"remote_network_ack": false, "permanent_purge": false,
+	})
+}
