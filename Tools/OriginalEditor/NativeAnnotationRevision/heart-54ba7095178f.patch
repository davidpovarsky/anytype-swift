+package importer
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestAnnotationRevisionPartialDependencyEffectsRemainUnconfirmed(t *testing.T) {
+	for _, observed := range []bool{false, true} {
+		r := &ownedAnnotationRevisionGraph{}
+		r.attempted.Store(true)
+		r.observed.Store(observed)
+		result := annotationRevisionResult{Status: "conflict"}
+		err := error(ErrAnnotationRevisionConflict)
+		r.mergeOutcome(&result, &err)
+		if result.Status != "applied_unconfirmed" || !result.NativeApplyAttempted || result.NativeWriteObserved != observed ||
+			!errors.Is(err, ErrAnnotationRevisionUnconfirmed) || !errors.Is(err, ErrAnnotationRevisionConflict) {
+			t.Fatal("a possible/observed original dependency effect was mislabeled no-effects")
+		}
+	}
+}
+func TestAnnotationRevisionReadOnlyRolesNeverBecomeExistingPageAuthority(t *testing.T) {
+	r := &ownedAnnotationRevisionGraph{existing: map[string]string{"source": "target"}}
+	for _, role := range []ownedAnnotationMemberRole{ownedAnnotationFixedSchema, ownedAnnotationBundledSchema, ownedAnnotationParticipant} {
+		if r.retained(&ownedAnnotationMemberPlan{sourceID: "source", role: role}) != "" {
+			t.Fatal("read-only original schema admitted through revision page route")
+		}
+	}
+	var absent *ownedAnnotationRevisionGraph
+	if absent.retained(&ownedAnnotationMemberPlan{sourceID: "source", role: ownedAnnotationFreshPage}) != "" {
+		t.Fatal("legacy import acquired revision authority")
+	}
+}
+func TestAnnotationRevisionCannotMintImportV1BodyReceipt(t *testing.T) {
+	g := &ownedAnnotationGraph{revision: &ownedAnnotationRevisionGraph{}}
+	receipt, err := g.finishReadback(context.Background(), nil, nil)
+	if receipt != nil || err == nil {
+		t.Fatal("deferred root phase minted a legacy import success")
+	}
+}
