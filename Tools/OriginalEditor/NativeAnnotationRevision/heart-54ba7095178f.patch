+			delete(r, key)
+			raw, _ := json.Marshal(r)
+			if _, err := decodeAnnotationRevision(raw, sha256.Sum256(raw)); err == nil {
+				t.Fatal("ordinary replacement accepted no Archive CAS witness")
+			}
+		})
+	}
+}
+func TestAnnotationLifecycleRestrictionComparisonPreservesEveryFlag(t *testing.T) {
+	value := &pb.SnapshotWithType{SbType: model.SmartBlockType_Page, Snapshot: &pb.ChangeSnapshot{Data: &model.SmartBlockSnapshotBase{Blocks: []*model.Block{{Id: "root", Content: &model.BlockContentOfSmartblock{Smartblock: &model.BlockContentSmartblock{}}}}}}}
+	empty := proto.Clone(value).(*pb.SnapshotWithType)
+	empty.Snapshot.Data.Blocks[0].Restrictions = &model.BlockRestrictions{}
+	if !revisionSnapshotEqual(value, empty) {
+		t.Fatal("original nil/all-false restriction normalization rejected")
+	}
+	for name, restriction := range map[string]*model.BlockRestrictions{"edit": {Edit: true}, "remove": {Remove: true}, "drag": {Drag: true}, "drop": {DropOn: true}} {
+		t.Run(name, func(t *testing.T) {
+			changed := proto.Clone(empty).(*pb.SnapshotWithType)
+			changed.Snapshot.Data.Blocks[0].Restrictions = restriction
+			if revisionSnapshotEqual(value, changed) {
+				t.Fatal("nonempty original restriction disappeared")
+			}
+		})
+	}
+	if value.Snapshot.Data.Blocks[0].Restrictions != nil {
+		t.Fatal("comparison mutated input")
+	}
+}
diff --git a/core/block/import/owned_annotation_promotion.go b/core/block/import/owned_annotation_promotion.go
new file mode 100644
index 0000000000000000000000000000000000000000..b7d69f6ec1f8bd8436bffbf76e2f9976631e8ce9
--- /dev/null
+++ b/core/block/import/owned_annotation_promotion.go
@@ -0,0 +1,264 @@
+package importer
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"github.com/anyproto/anytype-heart/core/block/cache"
+	"github.com/anyproto/anytype-heart/core/block/editor/smartblock"
+	"github.com/anyproto/anytype-heart/core/domain"
+	torah "github.com/anyproto/anytype-heart/core/pinkha/torah"
+	"github.com/anyproto/anytype-heart/pkg/lib/bundle"
+	coresb "github.com/anyproto/anytype-heart/pkg/lib/core/smartblock"
+	"github.com/anyproto/anytype-heart/pkg/lib/database"
+	"github.com/anyproto/anytype-heart/pkg/lib/pb/model"
+	"io"
+	"slices"
+)
+
+type revisionPromotionContext struct {
+	annotation                                          *revisionAnnotationTypeContext
+	role, manifestID, manifestSHA, raw, typeID, typeKey string
+	manifestHeads, typeHeads                            []string
+}
+type revisionPromotionManifest struct {
+	SchemaVersion     int               `json:"schemaVersion"`
+	SpaceID           string            `json:"spaceId"`
+	ManifestID        string            `json:"manifestObjectId"`
+	ProvisioningState *string           `json:"provisioningState"`
+	CanonicalID       string            `json:"documentAssociationsPropertyId"`
+	CanonicalKey      string            `json:"documentAssociationsPropertyKey"`
+	Types             map[string]string `json:"registeredDocumentTypes"`
+}
+
+func (p *revisionPromotionContext) applyReceipt(r *annotationRevisionResult) {
+	if p.annotation != nil {
+		r.AnnotationTypeID, r.AnnotationTypeUniqueKey = p.annotation.id, p.annotation.key
+		r.AnnotationTypeHeads = slices.Clone(p.annotation.heads)
+	}
+	r.ManifestObjectID, r.ManifestSHA256, r.ManifestJSON = p.manifestID, p.manifestSHA, p.raw
+	r.ManifestHeads = slices.Clone(p.manifestHeads)
+	r.PromotionRole, r.PromotionTypeID, r.PromotionTypeUniqueKey = p.role, p.typeID, p.typeKey
+	r.PromotionTypeHeads = slices.Clone(p.typeHeads)
+}
+
+// The existing canonical Torah binding verifier consumes bytes and properties
+// read from actual persisted native objects, never a caller manifest or type ID.
+type revisionManifestSource struct {
+	owner                *OwnedAnnotationRevisionOperation
+	id, raw, canonicalID string
+}
+
+func (s revisionManifestSource) Manifests(ctx context.Context, space string) ([]torah.ManifestCandidate, error) {
+	if ctx.Err() != nil {
+		return nil, ctx.Err()
+	}
+	if space != s.owner.owner.spaceID {
+		return nil, torah.ErrBinding
+	}
+	return []torah.ManifestCandidate{{ObjectID: s.id, Raw: []byte(s.raw)}}, nil
+}
+func (s revisionManifestSource) CanonicalProperty(ctx context.Context, space, key string) (torah.PropertyDescriptor, error) {
+	var result torah.PropertyDescriptor
+	if space != s.owner.owner.spaceID || key == "" || s.canonicalID == "" || s.canonicalID == s.id {
+		return result, torah.ErrBinding
+	}
+	exists, err := s.owner.owner.space.Storage().HasTree(ctx, s.canonicalID)
+	if err != nil || !exists {
+		return result, torah.ErrBinding
+	}
+	err = cache.DoContextFullID(s.owner.getter, ctx, domain.FullID{SpaceID: space, ObjectID: s.canonicalID}, func(b smartblock.SmartBlock) error {
+		if b.IsDeleted() || b.SpaceID() != space || b.Type() != coresb.SmartBlockTypeRelation || b.Tree() == nil || !revisionHeads(sortedRevisionHeads(b.Tree().Heads())) {
+			return torah.ErrBinding
+		}
+		keyNative := b.UniqueKey()
+		d := b.CombinedDetails()
+		if keyNative == nil || keyNative.InternalKey() != key || d == nil || d.GetString(bundle.RelationKeyRelationKey) != key ||
+			!d.Has(bundle.RelationKeyRelationFormat) || d.GetInt64(bundle.RelationKeyRelationFormat) != int64(model.RelationFormat_longtext) ||
+			d.GetBool(bundle.RelationKeyIsArchived) || d.GetBool(bundle.RelationKeyIsDeleted) || d.GetBool(bundle.RelationKeyIsUninstalled) {
+			return torah.ErrBinding
+		}
+		result = torah.PropertyDescriptor{ID: b.Id(), Key: key, Format: int(model.RelationFormat_longtext)}
+		return nil
+	})
+	return result, err
+}
+func (o *OwnedAnnotationRevisionOperation) revisionManifestIDs() ([]string, error) {
+	if o.owner.store == nil {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	rows, err := o.owner.store.SpaceIndex(o.owner.spaceID).QueryRaw(&database.Filters{FilterObj: database.FiltersOr{
+		database.FilterEq{Key: bundle.RelationKeyName, Value: domain.String(torah.ManifestUniqueKey)},
+		database.FilterEq{Key: bundle.RelationKeyUniqueKey, Value: domain.String(torah.ManifestUniqueKey)},
+	}}, 257, 0)
+	if err != nil {
+		return nil, err
+	}
+	if len(rows) > 256 {
+		return nil, ErrAnnotationRevisionUnsupported
+	}
+	var ids []string
+	for _, row := range rows {
+		d := row.Details
+		if d == nil || d.GetBool(bundle.RelationKeyIsArchived) || d.GetBool(bundle.RelationKeyIsDeleted) {
+			continue
+		}
+		id := d.GetString(bundle.RelationKeyId)
+		if id == "" || d.GetString(bundle.RelationKeySpaceId) != o.owner.spaceID {
+			return nil, ErrAnnotationRevisionInvalid
+		}
+		ids = append(ids, id)
+	}
+	return ids, nil
+}
+func (o *OwnedAnnotationRevisionOperation) readRevisionManifestLocked(b smartblock.SmartBlock, role string) (revisionPromotionManifest, string, []string, error) {
+	var m revisionPromotionManifest
+	if b.Id() == o.request.TargetRootID || b.SpaceID() != o.owner.spaceID || b.IsDeleted() || b.Tree() == nil {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	d := b.CombinedDetails()
+	if d == nil || (d.GetString(bundle.RelationKeyName) != torah.ManifestUniqueKey && d.GetString(bundle.RelationKeyUniqueKey) != torah.ManifestUniqueKey) ||
+		d.GetBool(bundle.RelationKeyIsArchived) || d.GetBool(bundle.RelationKeyIsDeleted) {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	raw := d.GetString(bundle.RelationKeyDescription)
+	if len(raw) == 0 || len(raw) > 128<<10 {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	dec := json.NewDecoder(bytes.NewReader([]byte(raw)))
+	dec.UseNumber()
+	fields := 0
+	// Depth one keeps duplicate/depth/field bounds without the envelope key list.
+	if revisionJSONValue(dec, 1, &fields) != nil {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	if _, err := dec.Token(); err != io.EOF {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	if json.Unmarshal([]byte(raw), &m) != nil || m.SchemaVersion != 1 || m.SpaceID != o.owner.spaceID ||
+		(m.ManifestID != "" && m.ManifestID != b.Id()) || (m.ProvisioningState != nil && *m.ProvisioningState != "complete") {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	used := map[string]bool{}
+	for _, r := range []string{"chiddush", "article", "research"} {
+		id := m.Types[r]
+		if !revisionText(id) || id == b.Id() || id == o.request.TargetRootID || used[id] {
+			return m, "", nil, ErrAnnotationRevisionInvalid
+		}
+		used[id] = true
+	}
+	if !revisionDocumentRole(role) {
+		return m, "", nil, ErrAnnotationRevisionInvalid
+	}
+	s := revisionManifestSource{owner: o, id: b.Id(), raw: raw, canonicalID: m.CanonicalID}
+	if _, err := torah.ResolveBinding(o.ctx, s, o.owner.spaceID); err != nil {
+		return m, "", nil, err
+	}
+	heads := sortedRevisionHeads(b.Tree().Heads())
+	if !revisionHeads(heads) {
+		return m, "", nil, ErrAnnotationRevisionUnconfirmed
+	}
+	return m, raw, heads, nil
+}
+func (o *OwnedAnnotationRevisionOperation) readRevisionTypeLocked(b smartblock.SmartBlock) (string, []string, error) {
+	if b.SpaceID() != o.owner.spaceID || b.IsDeleted() || b.Type() != coresb.SmartBlockTypeObjectType || b.Tree() == nil {
+		return "", nil, ErrAnnotationRevisionInvalid
+	}
+	key := b.UniqueKey()
+	d := b.CombinedDetails()
+	if key == nil || key.SmartblockType() != coresb.SmartBlockTypeObjectType || d == nil ||
+		d.GetString(bundle.RelationKeyUniqueKey) != key.Marshal() || d.GetBool(bundle.RelationKeyIsArchived) ||
+		d.GetBool(bundle.RelationKeyIsDeleted) || d.GetBool(bundle.RelationKeyIsUninstalled) {
+		return "", nil, ErrAnnotationRevisionInvalid
+	}
+	layout := model.ObjectTypeLayout(d.GetInt64(bundle.RelationKeyRecommendedLayout))
+	if layout != model.ObjectType_basic && layout != model.ObjectType_note {
+		return "", nil, ErrAnnotationRevisionUnsupported
+	}
+	heads := sortedRevisionHeads(b.Tree().Heads())
+	if !revisionHeads(heads) {
+		return "", nil, ErrAnnotationRevisionUnconfirmed
+	}
+	return key.Marshal(), heads, nil
+}
+func (o *OwnedAnnotationRevisionOperation) discoverRevisionPromotion(role string) (*revisionPromotionContext, error) {
+	if !revisionDocumentRole(role) {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	ids, err := o.revisionManifestIDs()
+	if err != nil {
+		return nil, err
+	}
+	if len(ids) != 1 {
+		return nil, fmt.Errorf("%w: one complete original Torah manifest required", ErrAnnotationRevisionUnsupported)
+	}
+	exists, err := o.owner.space.Storage().HasTree(o.ctx, ids[0])
+	if err != nil || !exists {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	p := &revisionPromotionContext{role: role, manifestID: ids[0]}
+	err = cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: p.manifestID}, func(b smartblock.SmartBlock) error {
+		m, raw, heads, err := o.readRevisionManifestLocked(b, role)
+		if err != nil {
+			return err
+		}
+		digest := sha256.Sum256([]byte(raw))
+		p.raw, p.manifestSHA, p.manifestHeads = raw, hex.EncodeToString(digest[:]), heads
+		p.typeID = m.Types[role]
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	exists, err = o.owner.space.Storage().HasTree(o.ctx, p.typeID)
+	if err != nil || !exists {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	err = cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: p.typeID}, func(b smartblock.SmartBlock) error {
+		key, heads, err := o.readRevisionTypeLocked(b)
+		p.typeKey, p.typeHeads = key, heads
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	p.annotation, err = o.discoverRevisionAnnotationType()
+	if err != nil {
+		return nil, err
+	}
+	if p.typeID == p.annotation.id || p.typeKey == p.annotation.key {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	return p, nil
+}
+func (o *OwnedAnnotationRevisionOperation) withRevisionPromotionLocks(p *revisionPromotionContext, body func() error) error {
+	ids, err := o.revisionManifestIDs()
+	if err != nil {
+		return err
+	}
+	if len(ids) != 1 || ids[0] != p.manifestID {
+		return ErrAnnotationRevisionConflict
+	}
+	return cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: p.manifestID}, func(manifest smartblock.SmartBlock) error {
+		m, raw, heads, err := o.readRevisionManifestLocked(manifest, p.role)
+		if err != nil {
+			return err
+		}
+		if raw != p.raw || !slices.Equal(heads, p.manifestHeads) || m.Types[p.role] != p.typeID {
+			return ErrAnnotationRevisionConflict
+		}
+		return cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: p.typeID}, func(kind smartblock.SmartBlock) error {
+			key, heads, err := o.readRevisionTypeLocked(kind)
+			if err != nil {
+				return err
+			}
+			if key != p.typeKey || !slices.Equal(heads, p.typeHeads) {
+				return ErrAnnotationRevisionConflict
+			}
+			return o.withRevisionAnnotationTypeLock(p.annotation, body)
+		})
+	})
+}
