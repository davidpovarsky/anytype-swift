@@ -0,0 +1,75 @@
+package importer
+
+import (
+	"slices"
+
+	"github.com/anyproto/anytype-heart/core/block/cache"
+	"github.com/anyproto/anytype-heart/core/block/editor/smartblock"
+	"github.com/anyproto/anytype-heart/core/block/object/objectcreator"
+	"github.com/anyproto/anytype-heart/core/domain"
+	annotationschema "github.com/anyproto/anytype-heart/core/pinkha/annotationschema/definition"
+	"github.com/anyproto/anytype-heart/pb"
+	coresb "github.com/anyproto/anytype-heart/pkg/lib/core/smartblock"
+)
+
+// The destination type is the original registered fixed schema, observed by
+// its existing raw signed-tree observer. A caller cannot select a substitute.
+type revisionAnnotationTypeContext struct {
+	id, key  string
+	heads    []string
+	snapshot *pb.SnapshotWithType
+}
+
+func (o *OwnedAnnotationRevisionOperation) discoverRevisionAnnotationType() (*revisionAnnotationTypeContext, error) {
+	if o.owner.observer == nil {
+		return nil, ErrAnnotationRevisionInvalid
+	}
+	definitions, err := annotationschema.Definitions()
+	if err != nil {
+		return nil, err
+	}
+	for _, definition := range definitions {
+		if definition.Key.Marshal() != annotationschema.TypeUniqueKey {
+			continue
+		}
+		observed, err := o.owner.observer.ObserveOwnedAnnotationFixedSchema(o.ctx, o.owner.space, definition)
+		if err != nil {
+			return nil, err
+		}
+		snapshot := observed.CopySnapshot()
+		if observed.Disposition != objectcreator.FixedSchemaPersistedMatch || observed.AccountIdentity != o.owner.accountID ||
+			observed.SpaceID != o.owner.spaceID || observed.ObjectID == "" || snapshot == nil ||
+			!revisionHeads(sortedRevisionHeads(observed.PersistedHeads)) {
+			return nil, ErrAnnotationRevisionInvalid
+		}
+		return &revisionAnnotationTypeContext{id: observed.ObjectID, key: annotationschema.TypeUniqueKey,
+			heads: sortedRevisionHeads(observed.PersistedHeads), snapshot: snapshot}, nil
+	}
+	return nil, ErrAnnotationRevisionInvalid
+}
+func (o *OwnedAnnotationRevisionOperation) withRevisionAnnotationTypeLock(kind *revisionAnnotationTypeContext, body func() error) error {
+	if kind == nil || kind.id == o.request.TargetRootID || kind.key != annotationschema.TypeUniqueKey {
+		return ErrAnnotationRevisionInvalid
+	}
+	return cache.DoContextFullID(o.getter, o.ctx, domain.FullID{SpaceID: o.owner.spaceID, ObjectID: kind.id}, func(b smartblock.SmartBlock) error {
+		if b.IsDeleted() || b.SpaceID() != o.owner.spaceID || b.Type() != coresb.SmartBlockTypeObjectType || b.Tree() == nil ||
+			b.UniqueKey() == nil || b.UniqueKey().Marshal() != kind.key {
+			return ErrAnnotationRevisionInvalid
+		}
+		snapshot, _, err := revisionSnapshot(b)
+		if err != nil {
+			return err
+		}
+		if !slices.Equal(sortedRevisionHeads(b.Tree().Heads()), kind.heads) || !revisionSnapshotEqual(snapshot, kind.snapshot) {
+			return ErrAnnotationRevisionConflict
+		}
+		if err = o.owner.requireCurrentWriter(o.ctx); err != nil {
+			return err
+		}
+		return body()
+	})
+}
+func (p *revisionPromotionContext) hasExpectedTypeWitness(r annotationRevisionRequest) bool {
+	return p != nil && p.annotation != nil && p.annotation.id == r.ExpectedAnnotationTypeID &&
