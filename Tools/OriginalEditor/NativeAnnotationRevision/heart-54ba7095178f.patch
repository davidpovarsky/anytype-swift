+				{bundle.RelationKeyId: domain.String("unselected-archived"), bundle.RelationKeyName: domain.String("Unselected"), bundle.RelationKeyIsArchived: domain.Bool(true)},
+			})
+			exp := newExportContext(fx.export, pb.RpcObjectListExportRequest{SpaceId: spaceId, Format: model.Export_Protobuf, IncludeArchived: includeArchived})
+			rows, err := exp.queryObjectsByRelation(spaceId, []string{"selected-live", "selected-archived", "selected-deleted", "missing"}, bundle.RelationKeyId)
+			require.NoError(t, err)
+			ids := make([]string, 0, len(rows))
+			for _, row := range rows {
+				ids = append(ids, row.Details.GetString(bundle.RelationKeyId))
+			}
+			want := []string{"selected-live"}
+			if includeArchived {
+				want = append(want, "selected-archived")
+			}
+			assert.ElementsMatch(t, want, ids)
+		})
+	}
+}
