+func lifecycleCreate(t *testing.T, f *ownedClosedFixture, key domain.TypeKey, name string, values map[domain.RelationKey]domain.Value) (string, *domain.Details) {
+	t.Helper()
+	d := domain.NewDetails()
+	d.SetString(bundle.RelationKeyName, name)
+	for k, v := range values {
+		d.Set(k, v)
+	}
+	id, created, err := f.creator.CreateObject(f.ctx, f.spc.Id(), objectcreator.CreateObjectRequest{ObjectTypeKey: key, Details: d})
+	ownedClosedNoError(t, err)
+	if id == "" || created == nil {
+		t.Fatal("original native creator returned no object")
+	}
+	return id, created
+}
+func lifecycleOriginalManifest(t *testing.T, f *ownedClosedFixture) nativeLifecycleManifest {
+	t.Helper()
+	result := nativeLifecycleManifest{Types: map[string]string{}, Keys: map[string]string{}}
+	templates := map[string]string{}
+	for _, role := range []string{"chiddush", "article", "research"} {
+		id, d := lifecycleCreate(t, f, bundle.TypeKeyObjectType, "Native "+role, map[domain.RelationKey]domain.Value{bundle.RelationKeyRecommendedLayout: domain.Int64(model.ObjectType_basic)})
+		result.Types[role], result.Keys[role] = id, d.GetString(bundle.RelationKeyUniqueKey)
+		template, _ := lifecycleCreate(t, f, bundle.TypeKeyTemplate, "Default "+role, map[domain.RelationKey]domain.Value{bundle.RelationKeyTargetObjectType: domain.String(id)})
+		templates[role] = template
+	}
+	canonical, cd := lifecycleCreate(t, f, bundle.TypeKeyRelation, "Document associations", map[domain.RelationKey]domain.Value{bundle.RelationKeyRelationFormat: domain.Int64(model.RelationFormat_longtext)})
+	parent, pd := lifecycleCreate(t, f, bundle.TypeKeyRelation, "Parent", map[domain.RelationKey]domain.Value{bundle.RelationKeyRelationFormat: domain.Int64(model.RelationFormat_object)})
+	order, od := lifecycleCreate(t, f, bundle.TypeKeyRelation, "Order", map[domain.RelationKey]domain.Value{bundle.RelationKeyRelationFormat: domain.Int64(model.RelationFormat_longtext)})
+	folder, _ := lifecycleCreate(t, f, bundle.TypeKeyObjectType, "Folder", nil)
+	bookFolder, _ := lifecycleCreate(t, f, bundle.TypeKeyObjectType, "Book folder", nil)
+	raw, err := json.Marshal(map[string]any{
+		"schemaVersion": 1, "spaceId": f.spc.Id(), "provisioningState": "complete",
+		"documentAssociationsPropertyId": canonical, "documentAssociationsPropertyKey": cd.GetString(bundle.RelationKeyRelationKey),
+		"parentPropertyId": parent, "parentPropertyKey": pd.GetString(bundle.RelationKeyRelationKey),
+		"orderPropertyId": order, "orderPropertyKey": od.GetString(bundle.RelationKeyRelationKey),
+		"folderTypeId": folder, "bookFolderTypeId": bookFolder, "registeredDocumentTypes": result.Types, "defaultTemplateIds": templates,
+	})
+	ownedClosedNoError(t, err)
+	result.Raw = string(raw)
+	result.ID, _ = lifecycleCreate(t, f, bundle.TypeKeyPage, torah.ManifestUniqueKey, map[domain.RelationKey]domain.Value{bundle.RelationKeyDescription: domain.String(result.Raw)})
+	// Wait for the original indexing pipeline, never fabricate an index entry.
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		rows, err := f.store.SpaceIndex(f.spc.Id()).QueryRaw(&database.Filters{FilterObj: database.FilterEq{Key: bundle.RelationKeyName, Value: domain.String(torah.ManifestUniqueKey)}}, 2, 0)
+		ownedClosedNoError(t, err)
+		if len(rows) == 1 && rows[0].Details.GetString(bundle.RelationKeyId) == result.ID {
+			return result
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("actual manifest index did not converge")
+		}
+		select {
+		case <-f.ctx.Done():
+			t.Fatal(f.ctx.Err())
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
+func lifecycleQueryContains(t *testing.T, f *ownedClosedFixture, id string, condition model.BlockContentDataviewFilterCondition) bool {
+	t.Helper()
+	rows, err := f.store.SpaceIndex(f.spc.Id()).Query(database.Query{Filters: []database.FilterRequest{
+		{RelationKey: bundle.RelationKeyId, Condition: model.BlockContentDataviewFilter_Equal, Value: domain.String(id)},
+		{RelationKey: "type.uniqueKey", Condition: condition, Value: domain.String(annotationschema.TypeUniqueKey)},
+	}, Limit: 2})
+	ownedClosedNoError(t, err)
+	return len(rows) == 1 && rows[0].Details.GetString(bundle.RelationKeyId) == id
+}
+func lifecycleQueryExpect(t *testing.T, f *ownedClosedFixture, id string, include bool) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		hiddenDefault := lifecycleQueryContains(t, f, id, model.BlockContentDataviewFilter_NotEqual)
+		explicitAnnotation := lifecycleQueryContains(t, f, id, model.BlockContentDataviewFilter_Equal)
+		if hiddenDefault == !include && explicitAnnotation == include {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("actual nested type.uniqueKey index differs: default=%v explicit=%v expectedAnnotation=%v", hiddenDefault, explicitAnnotation, include)
+		}
+		select {
+		case <-f.ctx.Done():
+			t.Fatal(f.ctx.Err())
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
+func TestOtzariaNativeAnnotationPromotionAndVisibility(t *testing.T) {
+	f := newOwnedClosedFixture(t)
+	manifest := lifecycleOriginalManifest(t, f)
+	for _, role := range []string{"chiddush", "article", "research"} {
+		t.Run(role, func(t *testing.T) {
+			source := &ownedClosedSpecimen{Kind: "promotion-" + role, RootID: f.annotation(t, "Native promotion "+role), Expected: map[string]*model.Block{}}
+			f.text(t, source, source.RootID, "", "Native heading", model.BlockContentText_Header2, nil)
+			f.text(t, source, source.RootID, "", "Saved native rich source", model.BlockContentText_Paragraph, &model.BlockContentTextMarks{Marks: []*model.BlockContentTextMark{
+				{Type: model.BlockContentTextMark_Link, Param: "https://example.org/native-source", Range: &model.Range{From: 0, To: 5}},
+				{Type: model.BlockContentTextMark_Bold, Range: &model.Range{From: 6, To: 12}},
+			}})
+			f.export(t, source)
+			root, annotationUUID := source.RootID, lifecycleUUID(t, source)
+			// Actual original materialization into another Space supplies the saved
+			// local Annotation input; no protobuf archive is fabricated for the update.
+			local := f.target(t, "promoted-local-"+role, source)
+			localOp, stage := local.prepare(t, source)
+			local.start(localOp)
+			imported := local.wait(t, role+"-local-materialized", localOp)
+			local.stageRemoved(t, stage)
+			local.assertRoundTrip(t, source, imported)
+			mappings, ok := imported.NativeMappingObservation()
+			if !ok {
+				t.Fatal("local mapping missing")
+			}
+			localRoot := ""
+			for _, row := range mappings.SourceAssignments() {
+				if row.SourceObjectID == source.RootID {
+					localRoot = row.NativeID
+				}
+			}
+			if localRoot == "" || localRoot == source.RootID {
+				t.Fatal("local root not materialized")
+			}
+			saved := &ownedClosedSpecimen{Kind: role + "-saved-local-document-input", RootID: localRoot, Expected: map[string]*model.Block{}}
+			added := local.text(t, saved, localRoot, "", "Explicit saved Document replacement", model.BlockContentText_Paragraph, &model.BlockContentTextMarks{Marks: []*model.BlockContentTextMark{{Type: model.BlockContentTextMark_Bold, Range: &model.Range{From: 0, To: 8}}}})
+			local.export(t, saved)
+			lifecycleQueryExpect(t, f, root, true)
+			read, err := lifecycleNativeCall(t, f, role+"-promotion-read", "read_lifecycle", root, annotationUUID, role, nativeLifecycleWire{})
+			ownedClosedNoError(t, err)
+			if read.ManifestID != manifest.ID || read.ManifestJSON != manifest.Raw || read.PromotionTypeID != manifest.Types[role] || read.PromotionTypeKey != manifest.Keys[role] {
+				t.Fatal("promotion did not bind the actual original manifest role")
+			}
+			tampered := read
+			tampered.PromotionTypeID = manifest.Types[map[string]string{"chiddush": "article", "article": "research", "research": "chiddush"}[role]]
+			refused, err := lifecycleNativeCall(t, f, role+"-wrong-role-witness", "promote", root, annotationUUID, role, tampered)
+			lifecycleAssertNoEffects(t, refused, err)
+			promoted, err := lifecycleNativeCall(t, f, role+"-promoted", "promote", root, annotationUUID, role, read)
+			ownedClosedNoError(t, err)
+			if promoted.Status != "promoted" || !promoted.NativeApplyAttempted || !promoted.NativeWriteObserved || promoted.RootID != root ||
+				promoted.DocumentRole != role || promoted.DocumentTypeID != manifest.Types[role] || promoted.DocumentTypeKey != manifest.Keys[role] ||
+				promoted.Classification != "promoted_document" || slices.Equal(promoted.Heads, read.Heads) {
+				t.Fatal("missing actual same-object promotion")
+			}
+			oldRoot := revisionNativeRoot(t, read.NativeArchive, f.spc.Id(), root)
+			newRoot := revisionNativeRoot(t, promoted.NativeArchive, f.spc.Id(), root)
+			if !reflect.DeepEqual(lifecycleRichBlocks(t, oldRoot.Snapshot.Data.Blocks), lifecycleRichBlocks(t, newRoot.Snapshot.Data.Blocks)) {
+				t.Fatal("promotion changed rich block/mark/anchor inventory")
+			}
+			oldDetails, newDetails := domain.NewDetailsFromProto(oldRoot.Snapshot.Data.Details), domain.NewDetailsFromProto(newRoot.Snapshot.Data.Details)
+			for _, key := range []domain.RelationKey{"pinkhaTorahAnnotationUUID", "pinkhaTorahAnnotationNamespace", "pinkhaTorahAnnotationCreationDestination", "pinkhaTorahAnnotationCreationAccount", "pinkhaTorahAnnotationCreationSpace"} {
+				if !oldDetails.Get(key).Equal(newDetails.Get(key)) {
+					t.Fatalf("promotion changed identity %s", key)
+				}
+			}
+			if newDetails.GetString("pinkhaTorahAnnotationClassification") != role {
+				t.Fatal("original role classification missing")
+			}
+			if len(newRoot.Snapshot.Data.ObjectTypes) != 1 || newRoot.Snapshot.Data.ObjectTypes[0] != manifest.Keys[role] {
+				t.Fatal("original native Document type missing")
+			}
+			// A promoted Document never becomes acceptable to the strict Annotation reader.
+			strict, err := revisionNativeCall(t, f, role+"-strict-refusal", root, annotationUUID, nil, nativeRevisionWire{})
+			if err == nil || strict.NativeApplyAttempted || strict.NativeWriteObserved {
+				t.Fatal("promoted Document weakened Annotation verifier")
+			}
+			observed, err := lifecycleNativeCall(t, f, role+"-promoted-read", "read_promoted", root, annotationUUID, role, nativeLifecycleWire{})
+			ownedClosedNoError(t, err)
+			if observed.RootSHA != promoted.RootSHA || !slices.Equal(observed.Heads, promoted.Heads) {
+				t.Fatal("separate promoted Document read differs")
+			}
+			lifecycleQueryExpect(t, f, root, false)
+			updated, err := lifecycleNativeCallSource(t, f, role+"-saved-document-update", "replace_promoted", root, annotationUUID, role, observed, saved)
+			ownedClosedNoError(t, err)
+			if updated.Status != "applied" || !updated.NativeApplyAttempted || !updated.NativeWriteObserved || updated.RootID != root || updated.DocumentRole != role || updated.MutationID != root {
+				t.Fatal("actual promoted replacement missing")
+			}
+			updatedRoot := revisionNativeRoot(t, updated.NativeArchive, f.spc.Id(), root)
+			expectedBlocks := lifecycleRichBlocks(t, saved.Snapshots[saved.RootID].Snapshot.Data.Blocks)
+			for _, b := range expectedBlocks {
+				if b.Id == saved.RootID {
+					b.Id = root
+				}
+				for i, id := range b.ChildrenIds {
+					if id == saved.RootID {
+						b.ChildrenIds[i] = root
+					}
+				}
+			}
+			if !reflect.DeepEqual(lifecycleRichBlocks(t, expectedBlocks), lifecycleRichBlocks(t, updatedRoot.Snapshot.Data.Blocks)) {
+				t.Fatal("promoted replacement lost saved rich content or stable child IDs")
+			}
+			found := false
+			for _, b := range updatedRoot.Snapshot.Data.Blocks {
