+
+func lifecycleRichBlocks(t *testing.T, blocks []*model.Block) []*model.Block {
+	t.Helper()
+	out := make([]*model.Block, 0, len(blocks))
+	seen := map[string]bool{}
+	for _, block := range blocks {
+		if block == nil || block.Id == "" || seen[block.Id] {
+			t.Fatal("invalid native block inventory")
+		}
+		seen[block.Id] = true
+		value := proto.Clone(block).(*model.Block)
+		twin := proto.Clone(value).(*model.Block)
+		changes, err := base.NewBase(value).Diff("", base.NewBase(twin))
+		ownedClosedNoError(t, err)
+		if len(changes) != 0 {
+			t.Fatal("original self comparison changed content")
+		}
+		if text := value.GetText(); text != nil && text.Marks != nil {
+			sort.SliceStable(text.Marks.Marks, func(i, j int) bool {
+				a, err := proto.Marshal(text.Marks.Marks[i])
+				ownedClosedNoError(t, err)
+				b, err := proto.Marshal(text.Marks.Marks[j])
+				ownedClosedNoError(t, err)
+				return bytes.Compare(a, b) < 0
+			})
+		}
+		out = append(out, value)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Id < out[j].Id })
+	return out
+}
+
+// A receipt's type authority is also present in the genuine original ZIP.
+func lifecycleNativeSchema(t *testing.T, raw []byte, id, key string) {
+	t.Helper()
+	z, err := zip.NewReader(bytes.NewReader(raw), int64(len(raw)))
+	ownedClosedNoError(t, err)
+	count := 0
+	for _, entry := range z.File {
+		if entry.Name != "types/"+id+".pb" && entry.Name != "objects/"+id+".pb" {
+			continue
+		}
+		r, err := entry.Open()
+		ownedClosedNoError(t, err)
+		data, err := io.ReadAll(r)
+		ownedClosedNoError(t, err)
+		ownedClosedNoError(t, r.Close())
+		value := &pb.SnapshotWithType{}
+		ownedClosedNoError(t, value.Unmarshal(data))
+		expected, keyErr := domain.UnmarshalUniqueKey(key)
+		if keyErr != nil || expected.SmartblockType() != coresb.SmartBlockTypeObjectType ||
+			value.SbType != expected.SmartblockType().ToProto() || value.Snapshot == nil || value.Snapshot.Data == nil ||
+			value.Snapshot.Data.Key != expected.InternalKey() {
+			t.Fatal("exported native type authority differs")
+		}
+		count++
+	}
+	if count != 1 {
+		t.Fatalf("native type %s missing or repeated in genuine ZIP", id)
+	}
+}
