+		r["expected_destination_type_id"] = "native-type"
+		r["expected_destination_type_unique_key"] = "ot-native-type"
+		r["expected_destination_type_heads"] = []string{"type-head"}
+	}
+	if operation == "replace_promoted" {
+		body := []byte(strings.Repeat("genuine-archive-parser-is-a-later-gate", 2))
+		hash := sha256.Sum256(body)
+		r["desired_archive"] = body
+		r["desired_archive_sha256"] = hex.EncodeToString(hash[:])
+	}
+	return r
+}
