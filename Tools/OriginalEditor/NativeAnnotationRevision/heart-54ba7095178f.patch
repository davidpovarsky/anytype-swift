+func lifecycleEnvelope(operation string) map[string]any {
+	r := map[string]any{"schema": 1, "operation": operation, "target_root_id": "root", "annotation_uuid": "d632fce3-dc28-4b2d-acf5-ce9b0343b83a"}
+	if operation == "archive" || operation == "restore" || operation == "promote" || operation == "revert_promotion" || operation == "replace_promoted" {
+		r["expected_heads"] = []string{"root-head"}
+		r["expected_root_sha256"] = strings.Repeat("a", 64)
+		r["expected_archive_id"] = "archive"
+		r["expected_archive_heads"] = []string{"archive-head"}
+		r["expected_is_archived"] = false
+	}
+	if operation == "read_promoted" {
+		r["document_role"] = "article"
+	}
+	if operation == "promote" || operation == "revert_promotion" || operation == "replace_promoted" {
+		if operation == "promote" {
+			r["promotion_role"] = "chiddush"
+		} else {
+			r["document_role"] = "chiddush"
+		}
+		r["expected_annotation_type_id"] = "annotation-type"
+		r["expected_annotation_type_unique_key"] = "ot-pinkhatorahannotationv1"
+		r["expected_annotation_type_heads"] = []string{"annotation-type-head"}
+		r["expected_manifest_id"] = "manifest"
+		r["expected_manifest_sha256"] = strings.Repeat("b", 64)
