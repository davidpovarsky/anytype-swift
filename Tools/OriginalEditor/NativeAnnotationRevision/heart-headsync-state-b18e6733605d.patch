+func TestOtzariaOriginalInstalledAnnotationSchemaReadbackIsReadOnly(t *testing.T) {
+	f := newOwnedClosedFixture(t)
+	before, err := annotationschema.Observe(f.ctx, f.service, f.spc.Id())
+	ownedClosedNoError(t, err)
+	if before.Disposition != annotationschema.MatchingObserved {
+		t.Fatal("the original native schema was not ready")
+	}
+
+	actual, err := annotationschema.Register(f.ctx, f.service, f.accountID, f.spc.Id())
+	ownedClosedNoError(t, err)
+	if !actual.AppAdmitted || actual.Observation.Disposition != annotationschema.MatchingObserved ||
+		actual.TypeApplyInvoked || actual.TypeApplyReturned || len(actual.Creations) != 0 {
+		t.Fatal("observing the already installed original schema must not recreate or apply it")
+	}
+	if len(actual.Observation.Definitions) != len(before.Definitions) {
+		t.Fatal("readback did not retain every original definition")
+	}
+	for idx, expected := range before.Definitions {
+		got := actual.Observation.Definitions[idx]
+		if got.Native.ObjectID != expected.Native.ObjectID || got.Native.ACLID != expected.Native.ACLID ||
+			got.Native.ACLHead != expected.Native.ACLHead || got.Native.ArchiveID != expected.Native.ArchiveID ||
+			!slices.Equal(got.Native.ArchiveHeads, expected.Native.ArchiveHeads) ||
+			!slices.Equal(got.Native.PersistedHeads, expected.Native.PersistedHeads) ||
+			got.Index != annotationschema.IndexMatch {
+			t.Fatal("readback changed an original schema, archive, ACL or index")
+		}
+	}
+}
diff --git a/core/block/object/objectcreator/fixed_schema_heads_sync_test.go b/core/block/object/objectcreator/fixed_schema_heads_sync_test.go
new file mode 100644
