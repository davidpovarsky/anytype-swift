--- /dev/null
+++ b/core/block/object/objectcreator/fixed_schema_heads_sync_test.go
@@ -0,0 +1,56 @@
+package objectcreator
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	anystore "github.com/anyproto/any-store"
+	"github.com/anyproto/any-store/anyenc"
+	"github.com/anyproto/any-sync/commonspace/headsync/statestorage"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOriginalHeadsSyncHashCannotChangeFixedSchemaAuthority(t *testing.T) {
+	ctx := context.Background()
+	store, err := anystore.Open(ctx, filepath.Join(t.TempDir(), "space.db"), nil)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, store.Close()) })
+	input := statestorage.State{
+		SpaceId: "space", AclId: "acl", SettingsId: "settings", SpaceHeader: []byte("original-header"),
+	}
+	native, err := statestorage.Create(ctx, input, store)
+	require.NoError(t, err)
+	states, err := store.OpenCollection(ctx, "state")
+	require.NoError(t, err)
+	snapshot := func() fixedSchemaStoredSpace {
+		doc, err := states.FindId(ctx, input.SpaceId)
+		require.NoError(t, err)
+		return fixedSchemaStoredSpace{stateBytes: doc.Value().MarshalTo(nil), settingsRootBytes: []byte("retained-settings-root")}
+	}
+
+	before := snapshot()
+	require.NoError(t, native.SetHash(ctx, "original-sync-head-one"))
+	first := snapshot()
+	require.NotEqual(t, before.stateBytes, first.stateBytes)
+	require.True(t, before.same(first), "the real initial hash write changes only original headsync metadata")
+	require.NoError(t, native.SetHash(ctx, "original-sync-head-two"))
+	last := snapshot()
+	require.NotEqual(t, first.stateBytes, last.stateBytes)
+	require.True(t, first.same(last), "the real hash refresh preserves every scope and persisted document field")
+
+	for _, key := range []string{"a", "s", "id", "e", "h", "unexpected", "oh"} {
+		t.Run(key, func(t *testing.T) {
+			var parser anyenc.Parser
+			value, err := parser.Parse(last.stateBytes)
+			require.NoError(t, err)
+			var arena anyenc.Arena
+			value.Set(key, arena.NewString("changed"))
+			changed := last
+			changed.stateBytes = value.MarshalTo(nil)
+			require.False(t, first.same(changed))
+		})
+	}
+	last.settingsRootBytes = []byte("changed-settings-root")
+	require.False(t, first.same(last))
+}
