diff --git a/core/block/object/objectcreator/fixed_schema_snapshot.go b/core/block/object/objectcreator/fixed_schema_snapshot.go
index fc144b1..237ec79 100644
--- a/core/block/object/objectcreator/fixed_schema_snapshot.go
+++ b/core/block/object/objectcreator/fixed_schema_snapshot.go
@@ -73,8 +73,55 @@ type fixedSchemaStoredSpace struct {
 }
 
 func (s fixedSchemaStoredSpace) same(other fixedSchemaStoredSpace) bool {
-	return bytes.Equal(s.stateBytes, other.stateBytes) &&
-		bytes.Equal(s.settingsRootBytes, other.settingsRootBytes)
+	if !bytes.Equal(s.settingsRootBytes, other.settingsRootBytes) {
+		return false
+	}
+	return bytes.Equal(s.stateBytes, other.stateBytes) || sameSpaceStateAfterHeadSync(s.stateBytes, other.stateBytes)
+}
+
+// The original StateStorage.SetHash updates nh and its compatibility mirror oh
+// during headsync. These counters carry no Space, settings, ACL or schema
+// identity. Admit only that exact atomic update, retaining byte equality of
+// the entire remaining state row, including fields this reader does not know.
+func sameSpaceStateAfterHeadSync(before, after []byte) bool {
+	var beforeParser, afterParser anyenc.Parser
+	first, err := beforeParser.Parse(before)
+	if err != nil || first.Type() != anyenc.TypeObject {
+		return false
+	}
+	last, err := afterParser.Parse(after)
+	if err != nil || last.Type() != anyenc.TypeObject {
+		return false
+	}
+	previousHash, previousValid := mirroredHeadSyncHash(first)
+	currentHash, currentValid := mirroredHeadSyncHash(last)
+	if !previousValid || !currentValid || currentHash == "" || currentHash == previousHash {
+		return false
+	}
+	first.Del("nh")
+	first.Del("oh")
+	last.Del("nh")
+	last.Del("oh")
+	return bytes.Equal(first.MarshalTo(nil), last.MarshalTo(nil))
+}
+
+func mirroredHeadSyncHash(row *anyenc.Value) (string, bool) {
+	var fields int
+	row.GetObject().Visit(func(key []byte, _ *anyenc.Value) {
+		if string(key) == "nh" || string(key) == "oh" {
+			fields++
+		}
+	})
+	if fields == 0 {
+		// The original CreateTx initially writes neither hash key.
+		return "", true
+	}
+	current, mirror := row.Get("nh"), row.Get("oh")
+	if fields != 2 || current.Type() != anyenc.TypeString || mirror.Type() != anyenc.TypeString ||
+		row.GetString("nh") != row.GetString("oh") {
+		return "", false
+	}
+	return row.GetString("nh"), true
 }
 
