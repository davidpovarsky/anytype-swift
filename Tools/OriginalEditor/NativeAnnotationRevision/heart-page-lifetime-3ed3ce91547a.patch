diff --git a/core/block/cache/state_lifetime_test.go b/core/block/cache/state_lifetime_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..b97e01941022b56c7b751d43716d8642f6915867
--- /dev/null
+++ b/core/block/cache/state_lifetime_test.go
@@ -0,0 +1,103 @@
+package cache_test
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/anyproto/any-sync/app/ocache"
+	"github.com/stretchr/testify/require"
+
+	"github.com/anyproto/anytype-heart/core/block/cache"
+	"github.com/anyproto/anytype-heart/core/block/editor"
+	"github.com/anyproto/anytype-heart/core/block/editor/smartblock"
+	"github.com/anyproto/anytype-heart/core/block/editor/state"
+	"github.com/anyproto/anytype-heart/core/session"
+)
+
+type stateLifetimeObject struct {
+	smartblock.SmartBlock
+	mutex     sync.Mutex
+	closing   bool
+	mutations int
+}
+
+func (s *stateLifetimeObject) Lock()                                    { s.mutex.Lock() }
+func (s *stateLifetimeObject) Unlock()                                  { s.mutex.Unlock() }
+func (s *stateLifetimeObject) IsClosing() bool                          { return s.closing }
+func (s *stateLifetimeObject) NewStateCtx(session.Context) *state.State { return &state.State{} }
+func (s *stateLifetimeObject) Apply(*state.State, ...smartblock.ApplyFlag) error {
+	s.mutations++
+	return nil
+}
+
+type stateLifetimeGetter struct {
+	cache.ObjectGetter
+	objects  []smartblock.SmartBlock
+	getCalls int
+	missing  error
+}
+
+func (g *stateLifetimeGetter) GetObject(context.Context, string) (smartblock.SmartBlock, error) {
+	g.getCalls++
+	if len(g.objects) == 0 {
+		return nil, g.missing
+	}
+	obj := g.objects[0]
+	g.objects = g.objects[1:]
+	return obj, nil
+}
+
+func TestDoStateCtxSkipsClosingCacheInstanceBeforeApplyingEdit(t *testing.T) {
+	closing := &stateLifetimeObject{closing: true}
+	current := &stateLifetimeObject{}
+	closingPage := &editor.Page{SmartBlock: closing}
+	currentPage := &editor.Page{SmartBlock: current}
+	getter := &stateLifetimeGetter{objects: []smartblock.SmartBlock{closingPage, currentPage}}
+	callbackCalls := 0
+
+	err := cache.DoStateCtx(getter, nil, "original-annotation", func(_ *state.State, object *editor.Page) error {
+		callbackCalls++
+		require.Same(t, currentPage, object)
+		return nil
+	})
+
+	require.NoError(t, err)
+	require.Equal(t, 2, getter.getCalls)
+	require.Equal(t, 1, callbackCalls)
+	require.Zero(t, closing.mutations)
+	require.Equal(t, 1, current.mutations)
+	require.True(t, closing.mutex.TryLock(), "the retired instance must be released")
+	closing.mutex.Unlock()
+}
+
+func TestDoStateCtxDoesNotReplayEditAfterApplyCallbackFails(t *testing.T) {
+	current := &stateLifetimeObject{}
+	getter := &stateLifetimeGetter{objects: []smartblock.SmartBlock{current}}
+	failure := errors.New("write closure failed")
+
+	err := cache.DoStateCtx(getter, nil, "original-annotation", func(_ *state.State, _ *stateLifetimeObject) error {
+		return failure
+	})
+
+	require.ErrorIs(t, err, failure)
+	require.Equal(t, 1, getter.getCalls)
+	require.Zero(t, current.mutations)
+}
+
+func TestDoStateCtxStopsAfterSecondClosingInstance(t *testing.T) {
+	closing := &stateLifetimeObject{closing: true}
+	next := &stateLifetimeObject{closing: true}
+	getter := &stateLifetimeGetter{objects: []smartblock.SmartBlock{closing, next}}
+
+	err := cache.DoStateCtx(getter, nil, "original-annotation", func(_ *state.State, _ *stateLifetimeObject) error {
+		t.Fatal("closing instance reached the edit")
+		return nil
+	})
+
+	require.ErrorIs(t, err, ocache.ErrClosed)
+	require.Equal(t, 2, getter.getCalls)
+	require.Zero(t, closing.mutations)
+	require.Zero(t, next.mutations)
+}
