      "identity": "iosmath",
      "path": "iosMath/module.modulemap",
      "content": "// Explicit module map for iosMath.\n// Only the intended public headers are listed here. Internal headers\n// (MTConfig.h, MTLabel.h, MTUnicode.h, render/internal/*, category files)\n// are deliberately excluded and will not appear in the Swift module interface.\nmodule iosMath {\n    // Primary rendering API\n    header \"render/MTMathUILabel.h\"\n\n    // Font system\n    header \"render/MTFont.h\"\n    header \"render/MTFontManager.h\"\n\n    // Display tree (expert use)\n    header \"render/MTMathListDisplay.h\"\n\n    // Math model\n    header \"lib/MTMathList.h\"\n    header \"lib/MTMathAtomFactory.h\"\n    header \"lib/MTMathListBuilder.h\"\n    header \"lib/MTMathListIndex.h\"\n\n    export *\n}\n",
      "encoding": "utf-8",
      "sha": "2f415206b9133e649a0e5e1f16eebcb0d3aa191f",
