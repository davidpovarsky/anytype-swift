        {
          "after": "// expectedOriginalImportedAddedDate models smartBlock.injectCreationInfo on an\n// owned expected snapshot. The original source takes this timestamp, in seconds,\n// from its assigned tree header. Never derive an expectation from readback.\nfunc expectedOriginalImportedAddedDate(details *domain.Details, payload *treechangeproto.RawTreeChangeWithId, nativeID, spaceID string) error {\n\tif details == nil || payload == nil || payload.Id != nativeID || len(payload.RawChange) == 0 {\n\t\treturn ownedAnnotationRefused(\"expected_original_creation_header\")\n\t}\n\tid, err := cid.Decode(nativeID)\n\tif err != nil {\n\t\treturn ownedAnnotationRefused(\"expected_original_creation_header\")\n\t}\n\tactualID, err := id.Prefix().Sum(payload.RawChange)\n\tif err != nil || !actualID.Equals(id) {\n\t\treturn ownedAnnotationRefused(\"expected_original_creation_header\")\n\t}\n\tvar raw treechangeproto.RawTreeChange\n\tvar root treechangeproto.RootChange\n\tif raw.UnmarshalVT(payload.RawChange) != nil || root.UnmarshalVT(raw.Payload) != nil ||\n\t\troot.SpaceId != spaceID || root.Timestamp <= 0 || root.IsDerived {\n\t\treturn ownedAnnotationRefused(\"expected_original_creation_header\")\n\t}\n\t// The original creator only supplies AddedDate when the imported source\n\t// has none. Existing source metadata and the complete body stay compared.\n\tif details.GetInt64(bundle.RelationKeyAddedDate) == 0 {\n\t\tdetails.SetInt64(bundle.RelationKeyAddedDate, root.Timestamp)\n\t}\n\treturn nil\n}\n\nfunc (g *ownedAnnotationGraph) expectedCreatedPage(",
          "before": "func (g *ownedAnnotationGraph) expectedCreatedPage("
        },
