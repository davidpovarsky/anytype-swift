+func (e *exportContext) collectRelationTargetTypes(processedObjects map[string]struct{}) map[string]*Doc {
+	notProcessedTypes := make(map[string]*Doc)
+	for _, doc := range e.docs {
+		if doc == nil || isExcludedFromExport(doc.Details) {
+			continue
+		}
+		for _, objectID := range doc.Details.GetStringList(bundle.RelationKeyRelationFormatObjectTypes) {
+			e.objectTypes[objectID] = struct{}{}
+			e.fillNotProcessedTypes(processedObjects, objectID, notProcessedTypes)
+		}
+	}
+	return notProcessedTypes
 }
 
