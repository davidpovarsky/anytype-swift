+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if g == nil || g.account == nil || g.identity == nil || g.accountID == "" ||
+		g.account.AccountID() != g.accountID || g.identity.Account() != g.accountID {
+		return ownedAnnotationRefused("native_identity_changed")
