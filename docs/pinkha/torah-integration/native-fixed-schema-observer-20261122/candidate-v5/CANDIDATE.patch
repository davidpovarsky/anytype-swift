+// validateStrictStateChange runs before NewDocFromSnapshot can remove/normalize
+// metadata and before the original apply body can convert values. It does not
+// synthesize properties, infer numeric zero, or implement another replay engine.
+func validateStrictStateChange(change *pb.Change) error {
+	if change == nil {
+		return fmt.Errorf("strict replay: nil native change")
+	}
+	if snapshot := change.Snapshot; snapshot != nil {
+		if snapshot.Data == nil {
+			return fmt.Errorf("strict replay: nil snapshot data")
+		}
+		if err := pbtypes.ValidateStruct(snapshot.Data.Details); err != nil {
+			return fmt.Errorf("validate original snapshot details: %w", err)
+		}
+		if err := pbtypes.ValidateStruct(snapshot.Data.Collections); err != nil {
+			return fmt.Errorf("validate original snapshot collections: %w", err)
+		}
+		seen := make(map[string]struct{}, len(snapshot.Data.Blocks))
+		for _, block := range snapshot.Data.Blocks {
+			if err := validateStrictStateBlock(block); err != nil {
+				return err
+			}
+			if _, duplicate := seen[block.Id]; duplicate {
+				return fmt.Errorf("strict replay: duplicate snapshot block")
+			}
+			seen[block.Id] = struct{}{}
+		}
+		for _, key := range snapshot.FileKeys {
+			if key == nil {
+				return fmt.Errorf("strict replay: nil snapshot file key")
+			}
+		}
+		for _, relation := range snapshot.Data.RelationLinks {
+			if relation == nil {
+				return fmt.Errorf("strict replay: nil snapshot relation")
+			}
+		}
+	}
+	for _, content := range change.Content {
+		if content == nil || content.Value == nil {
+			return fmt.Errorf("strict replay: missing native change content")
+		}
+		if create := content.GetBlockCreate(); create != nil {
+			for _, block := range create.Blocks {
+				if err := validateStrictStateBlock(block); err != nil {
+					return err
+				}
+			}
+		}
+		if update := content.GetBlockUpdate(); update != nil {
+			for _, event := range update.Events {
+				if event == nil || event.Value == nil {
+					return fmt.Errorf("strict replay: missing original block event")
+				}
+				if fields := event.GetBlockSetFields(); fields != nil {
+					// nil Fields is an original empty/reset operation.
+					if err := pbtypes.ValidateStruct(fields.Fields); err != nil {
+						return fmt.Errorf("validate original block fields event: %w", err)
+					}
+				}
+			}
+		}
+		if set := content.GetDetailsSet(); set != nil {
+			if set.Key == "" || set.Value == nil {
+				return fmt.Errorf("strict replay: incomplete native details set")
+			}
+			if err := pbtypes.ValidateValue(set.Value); err != nil {
+				return fmt.Errorf("validate original details value: %w", err)
+			}
+		}
+		if set := content.GetStoreKeySet(); set != nil {
+			if len(set.Path) == 0 || set.Value == nil {
+				return fmt.Errorf("strict replay: incomplete native store value")
+			}
+			if err := pbtypes.ValidateValue(set.Value); err != nil {
+				return fmt.Errorf("validate original store value: %w", err)
+			}
+		}
+		if add := content.GetRelationAdd(); add != nil {
+			for _, relation := range add.RelationLinks {
+				if relation == nil {
+					return fmt.Errorf("strict replay: nil added relation")
+				}
+			}
+		}
+	}
+	return nil
+}
+
+// Validate before simple.New can synthesize an ID or state replay can retain
+// malformed Fields. Preserve original nil Fields semantics through ValidateStruct.
+func validateStrictStateBlock(block *model.Block) error {
+	if block == nil || block.Id == "" {
+		return fmt.Errorf("strict replay: invalid original block")
+	}
+	if err := pbtypes.ValidateStruct(block.Fields); err != nil {
+		return fmt.Errorf("validate original block fields: %w", err)
+	}
+	return nil
+}
