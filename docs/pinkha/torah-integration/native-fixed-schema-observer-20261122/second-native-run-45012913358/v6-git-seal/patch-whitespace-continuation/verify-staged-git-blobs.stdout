+			rawKey, err := keys.ReadKey.Raw()
+			if err != nil {
+				return fmt.Errorf("read original ACL key for tree: %w", err)
+			}
+			treeKey, err := deriver.DeriveKey(rawKey)
+			if err != nil {
+				return fmt.Errorf("derive original tree content key: %w", err)
+			}
+			data, err = treeKey.DecryptReuse(nil, data)
 			if err != nil {
 				return fmt.Errorf("decrypt original stored content: %w", err)
 			}
