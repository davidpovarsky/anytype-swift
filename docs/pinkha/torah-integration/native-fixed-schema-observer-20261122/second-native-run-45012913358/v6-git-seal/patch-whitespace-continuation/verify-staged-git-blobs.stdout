  b=(D/x["path"]).read_bytes();assert len(b)==x["bytes"] and sha(b)==x["sha256"],x["path"];paths.add(x["path"])
 assert len(paths)==73 and {p.relative_to(D).as_posix()for p in D.rglob("*")if p.is_file()}==paths|{"REVIEW_INDEX.json"}
