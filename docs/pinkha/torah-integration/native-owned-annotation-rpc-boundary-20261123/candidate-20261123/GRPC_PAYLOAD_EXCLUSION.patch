+
+// annotationImportPayloadsAllowed preserves the original payload policy for
+// every other full method identity. No prefix or caller-controlled mask is used.
+func annotationImportPayloadsAllowed(fullMethod string) bool {
+	switch fullMethod {
+	case "/anytype.ClientCommands/AnnotationImport", "/anytype.ClientCommands/AnnotationImportCancel":
+		return false
+	default:
+		return true
+	}
+}
+
+// annotationImportTraceBoundary retains the original tracer/span/error handling
+// for both routes. Only the exact two commands omit the LogPayloads option.
+func annotationImportTraceBoundary(withConfiguredPayloads, withoutPayloads grpc.UnaryServerInterceptor) grpc.UnaryServerInterceptor {
+	return func(ctx context.Context, req interface{}, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (interface{}, error) {
+		if !annotationImportPayloadsAllowed(info.FullMethod) {
+			return withoutPayloads(ctx, req, info, handler)
+		}
+		return withConfiguredPayloads(ctx, req, info, handler)
+	}
+}
