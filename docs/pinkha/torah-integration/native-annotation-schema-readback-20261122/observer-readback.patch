+// CopyPersistedSchemaState returns an owned copy of the original strict replay.
+// It is available only for a matching result published after both full native
+// snapshots and final scope validation. It is historical observation data, not
+// a writable SmartBlock, a creation capability, or an annotation/body receipt.
+func (o FixedSchemaObservation) CopyPersistedSchemaState() (*types.Struct, []*model.Block) {
+	if o.Disposition != FixedSchemaPersistedMatch || o.persistedDetails == nil {
+		return nil, nil
+	}
+	return proto.Clone(o.persistedDetails).(*types.Struct), copyFixedSchemaBlocks(o.persistedBlocks)
+}
+
+func copyFixedSchemaBlocks(blocks []*model.Block) []*model.Block {
+	result := make([]*model.Block, len(blocks))
+	for i, block := range blocks {
+		if block != nil {
+			result[i] = proto.Clone(block).(*model.Block)
+		}
+	}
+	return result
 }
 
