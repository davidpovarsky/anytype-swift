+                            'Debug-Anytype-iphonesimulator/AnytypeOriginalEditor.build')
+        self.graph_directory = self.target_build / 'DerivedSources/OriginalEditorSymbolGraphs'
+        self.graph_directory.mkdir(parents=True)
