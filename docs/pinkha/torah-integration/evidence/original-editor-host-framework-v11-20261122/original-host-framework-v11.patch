+    def write_graph(self, name, module, symbols):
+        path = self.graph_directory / name
+        path.write_text(json.dumps({'module': {'name': module}, 'symbols': symbols,
+                                    'relationships': [{'kind': 'memberOf', 'source': 'a', 'target': 'b'}]},
+                                   indent=3) + '\n')
+        return path
