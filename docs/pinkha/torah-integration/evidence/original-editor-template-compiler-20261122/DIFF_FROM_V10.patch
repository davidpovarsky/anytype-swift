diff --git a/Anytype/Sources/ServiceLayer/Object/DefaultObjectCreationService/DocumentOwnedDefaultObjectCreationService.swift b/Anytype/Sources/ServiceLayer/Object/DefaultObjectCreationService/DocumentOwnedDefaultObjectCreationService.swift
