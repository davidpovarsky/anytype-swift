+private func sourceDocumentsResult(_ id: String) -> AnyNativeSourceDocumentsRead {
+    .init(documents: [.init(id: id, spaceID: "source-space", objectID: id,
+                           title: id, sourceReference: "Genesis 1:1")],
+          title: "Source " + id, complete: true)
+}
