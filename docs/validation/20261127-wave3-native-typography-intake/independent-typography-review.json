  "semanticReview": [
    {
      "area": "Original font policy",
      "result": "Original TextContent+Font maps header/header2/header3/code/default text to title/heading/subheading/codeBlock/bodyRegular. The actual DesignKit configurations are Inter Bold28/22/17, IBM Plex Mono15 and Inter Regular17. The stale prose typography table is not used as authority."
    },
    {
      "area": "Scaling",
      "result": "Each render calls original nominal UIKitFontBuilder then UIFontMetrics.scaledFont for the current trait collection. No already-scaled font is passed to the scaling API. Inline overrides retain the already-scaled base point size."
    },
    {
      "area": "Body emphasis and inline code",
      "result": "The original nominal UIFont.bold/italic policy is applied before restoring scaled size, preserving body semibold and heading bold. The exact original four IBM Plex Mono faces are explicitly registered by FontConvertible before font creation. An unmarked run returns its original base font."
    },
    {
      "area": "Live refresh",
      "result": "An iOS17+ trait registration on the controller rerenders on preferred content size change; current package minimum iOS27 covers availability. The cache includes source, native style, native block type and content-size category; type/category clear on cell reuse and advance only after original renderer success."
    },
    {
      "area": "Composition and input preservation",
      "result": "Original controller render/configure marked-composition guards, attribute-only renderer, paragraph direction/alignment, source ranges, link/strike, selection, focus, undo and native mutation flows survive the exact inverse. Original normal composition completion rerenders after marked state clears. New font refresh does not write native data."
    },
    {
      "area": "Dependency and source boundary",
      "result": "Only downstream PinkhaAnyUI source/tests/manifest and evidence change. DesignKit is an explicit local iOS-conditional target/test dependency. No engine, Host, native, SDK pin or lock changes occur in this tranche; final root must retain the reviewed original font sources for matching acceptance."
    }
  ],
  "fontPolicy": [
    {
      "native": "heading level 1",
      "original": "AnytypeFont.title / Inter Bold28",
      "metrics": "title1"
    },
    {
      "native": "heading level 2, legacy or unknown level",
      "original": "AnytypeFont.heading / Inter Bold22",
      "metrics": "title2"
    },
    {
      "native": "heading level 3",
      "original": "AnytypeFont.subheading / Inter Bold17",
      "metrics": "headline"
    },
    {
      "native": "code",
      "original": "AnytypeFont.codeBlock / IBM Plex Mono Regular15",
      "metrics": "body"
    },
    {
      "native": "other rendered text",
      "original": "AnytypeFont.bodyRegular / Inter Regular17",
