{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qualified Apple inline-file observation attachment",
  "description": "Success qualification only. Incomplete failure attachments intentionally fail this schema. Root must also verify original actual XCTest, source/build lineage, byte size <=65536, deterministic fixtures, cross-field identities, and generation phase membership. Each ordered file must bind to the corresponding distinct actual native identity.ownerObjectIds entry; each owner has its own frozen carrier head. Payload object IDs must not be treated as a globally unique per-file namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "method",
    "sourceSHA",
    "runID",
    "runAttempt",
    "nonce",
    "expectedNativeManifestSHA256",
    "expectedRuntimeVersion",
    "processId",
    "runtimeVersions",
    "runtimeGenerations",
    "ownerGenerations",
    "identity",
    "capabilities",
    "files",
    "orderlyReopenCount",
    "journeyComplete",
    "completedCleanup",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "pinkha-prepared-inline-file-apple-v1"
    },
    "status": {
      "const": "OBSERVATIONS_ONLY_ORIGINAL_XCTEST_RESULT_REQUIRED"
    },
    "method": {
      "const": "AnyPreparedInlineFileRuntimeTests/testManagedInlineFilesSurviveOrderlyReopenWithExactNativeBytes"
    },
    "sourceSHA": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runID": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "runAttempt": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "expectedNativeManifestSHA256": {
      "const": "86598a7046ef135fa5dd2d0c2e559750f89ed8517fe4c1c753ce4457c13a009b"
    },
    "expectedRuntimeVersion": {
      "const": "v0.5.0-pinkha.prepared.inline.1"
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "runtimeVersions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^any v0[.]5[.]0-pinkha[.]prepared[.]inline[.]1 "
      }
    },
    "runtimeGenerations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "ownerGenerations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountId",
        "spaceId",
        "storeId",
        "ownerObjectIds",
        "planId",
        "planSHA256"
      ],
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "planId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "planSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ownerObjectIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "maximumInlineBytes",
        "networkVerified"
      ],
      "properties": {
        "contract": {
          "const": "pinkha-native-prepared-migration-v1"
        },
        "maximumInlineBytes": {
          "const": 4095
        },
        "networkVerified": {
          "const": false
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "properties": {
                "label": {
                  "const": "empty"
                },
                "expectedSize": {
                  "const": 0
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "properties": {
                "label": {
                  "const": "maximum"
                },
                "expectedSize": {
                  "const": 4095
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "orderlyReopenCount": {
      "const": 2
    },
    "journeyComplete": {
      "const": true
    },
    "completedCleanup": {
      "const": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "restartKind",
        "osProcessCrash",
        "lostHTTPAcknowledgement",
        "networkSynchronization",
        "SSEDelivery",
        "fullSpaceMigration"
      ],
      "properties": {
        "restartKind": {
          "const": "orderly-native-sdk-store-same-xctest-process"
        },
        "osProcessCrash": {
          "const": "NOT_RUN"
        },
        "lostHTTPAcknowledgement": {
          "const": "NOT_INJECTED"
        },
        "networkSynchronization": {
          "const": "NOT_RUN"
        },
        "SSEDelivery": {
          "const": "NOT_EVALUATED_TRANSIENT"
        },
        "fullSpaceMigration": {
          "const": "NOT_PROVEN"
        }
      }
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeGeneration",
        "ownerGeneration",
        "stage",
        "outcome",
        "fingerprint",
        "payloadObjectId",
        "changeId",
        "fileId",
        "recordIds"
      ],
      "properties": {
        "runtimeGeneration": {
          "type": "string",
          "format": "uuid"
        },
        "ownerGeneration": {
          "type": "string",
          "format": "uuid"
        },
        "stage": {
          "enum": [
            "file-prepared",
            "complete"
          ]
        },
        "outcome": {
          "enum": [
            "prepared",
            "committed"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payloadObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "changeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeGeneration",
        "ownerGeneration",
        "metadata",
        "status",
        "content"
      ],
      "properties": {
        "runtimeGeneration": {
          "type": "string",
          "format": "uuid"
        },
        "ownerGeneration": {
          "type": "string",
          "format": "uuid"
        },
        "metadata": {
          "type": "object",
          "required": [
            "fileId",
            "objectId",
            "size",
            "inline",
            "durable",
            "cached"
          ],
          "properties": {
            "fileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "objectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "inline": {
              "const": true
            },
            "durable": {
              "const": true
            },
            "cached": {
              "const": true
            },
            "name": {
              "type": "string",
              "maxLength": 1024
            },
            "mime": {
              "type": "string",
              "maxLength": 255
            },
            "variant": {
              "type": "string",
              "maxLength": 256
            },
            "variantOf": {
              "type": "string",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "object",
          "required": [
            "fileId",
            "objectId",
            "state",
            "cached"
          ],
          "properties": {
            "fileId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "objectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "state": {
              "const": "durable"
            },
            "cached": {
              "const": true
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "lastErr": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "httpStatus",
            "mediaType",
            "byteCount",
            "sha256",
            "base64"
          ],
          "properties": {
            "httpStatus": {
              "const": 200
            },
            "mediaType": {
              "const": "application/octet-stream"
            },
            "byteCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "base64": {
              "type": "string",
              "contentEncoding": "base64",
              "maxLength": 5460
            }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "sourceKey",
        "intentId",
        "ownerObjectId",
        "specBase64",
        "specSHA256",
        "expectedSize",
        "expectedContentSHA256",
        "nameUTF8Base64",
        "mime",
        "prepared",
        "afterPreparedReopen",
        "committed",
        "currentStatus",
        "retry",
        "currentRead",
        "afterCommittedReopenStatus",
        "afterCommittedReopenRetry",
        "reopenedRead"
      ],
      "properties": {
        "label": {
          "enum": [
            "empty",
            "maximum"
          ]
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "intentId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ownerObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "specBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 16384
        },
        "specSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedSize": {
          "type": "integer",
          "enum": [
            0,
            4095
          ]
        },
        "expectedContentSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nameUTF8Base64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 1368
        },
        "mime": {
          "type": "string",
          "maxLength": 255
        },
        "prepared": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "file-prepared"
                },
                "outcome": {
                  "const": "prepared"
                }
              }
            }
          ]
        },
        "afterPreparedReopen": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "file-prepared"
                },
                "outcome": {
                  "const": "prepared"
                }
              }
            }
          ]
        },
        "committed": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "complete"
                },
                "outcome": {
                  "const": "committed"
                }
              }
            }
          ]
        },
        "currentStatus": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "complete"
                },
                "outcome": {
                  "const": "committed"
                }
              }
            }
          ]
        },
        "retry": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "complete"
                },
                "outcome": {
                  "const": "committed"
                }
              }
            }
          ]
        },
        "currentRead": {
          "$ref": "#/$defs/readback"
        },
        "afterCommittedReopenStatus": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "complete"
                },
                "outcome": {
                  "const": "committed"
                }
              }
            }
          ]
        },
        "afterCommittedReopenRetry": {
          "allOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "properties": {
                "stage": {
                  "const": "complete"
                },
                "outcome": {
                  "const": "committed"
                }
              }
            }
          ]
        },
        "reopenedRead": {
          "$ref": "#/$defs/readback"
        }
      }
    }
  }
}
