+def register_owned_child(child,record):
+    require(type(child) is subprocess.Popen and record.get("pid")==child.pid and
+            record.get("pgid")==child.pid and child not in OWNED_CHILDREN,
+            "register_actual_owned_child")
+    OWNED_CHILDREN[child] = (child.pid,child.pid,id(record))
+
+def stop_owned(child,record):
+    require(type(child) is subprocess.Popen and
+            OWNED_CHILDREN.get(child)==(child.pid,child.pid,id(record)),
+            "privileged_cleanup_requires_registered_popen")
+    ordinary = {"uids":[1001,1001,0],"gids":[1001,1001,1001],"groups":ORDINARY_GROUPS}
+    proof = {"ordinary_before":process_credentials(),"restored":False}
+    record["cleanup_privilege"] = proof
+    require(ENTRY_CREDENTIALS is not None and proof["ordinary_before"]==ordinary,
+            "privileged_cleanup_entry_binding")
+    first_error = None
+    # Defer handled signals across the finite existing TERM/KILL cleanup.
+    # A pending signal is delivered only after ordinary identity is restored.
+    prior_mask = signal.pthread_sigmask(signal.SIG_BLOCK,{signal.SIGTERM,signal.SIGINT})
+    try:
+        os.seteuid(0)
+        proof["during_cleanup"] = process_credentials()
+        require(proof["during_cleanup"]=={"uids":[1001,0,0],"gids":[1001,1001,1001],"groups":ORDINARY_GROUPS},
+                "privileged_cleanup_identity")
+        _stop_owned_body(child,record)
+    except BaseException as error:
+        first_error = error
+        proof["first_error"] = {"type":type(error).__name__,"message":str(error)}
+    finally:
+        # No project/file/Git operation is performed with effective UID zero.
+        try:
+            os.seteuid(ORDINARY_UID)
+            proof["ordinary_after"] = process_credentials()
+            proof["restored"] = proof["ordinary_after"]==ordinary
+        except BaseException as error:
+            proof["restoration_error"] = {"type":type(error).__name__,"message":str(error)}
+        if not proof["restored"]:
+            # A failure to restore must never continue into project I/O.
+            os.write(2,(json.dumps({"fatal":"ordinary_identity_restore_failed","cleanup":proof})+"\n").encode())
+            os._exit(126)
+        try:
+            signal.pthread_sigmask(signal.SIG_SETMASK,prior_mask)
+        except BaseException as error:
+            proof["pending_signal_after_restoration"] = {"type":type(error).__name__,"message":str(error)}
+            if first_error is None:
+                first_error = error
+    if first_error is not None:
+        raise first_error
+    del OWNED_CHILDREN[child]
 
