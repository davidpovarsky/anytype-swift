diff --git a/core/pinkha_native_source_checkpoint.go b/core/pinkha_native_source_checkpoint.go
new file mode 100644
index 000000000..e430eb7e3
--- /dev/null
+++ b/core/pinkha_native_source_checkpoint.go
@@ -0,0 +1,47 @@
+//go:build pinkha_loaded_account_witness
+
+package core
+
+import (
+	"context"
+	"time"
+
+	"github.com/anyproto/anytype-heart/core/application"
+	"github.com/anyproto/anytype-heart/pkg/lib/pinkha/capturecontrol"
+)
+
+var pinkhaCapturedSources = capturecontrol.NewBindings[*application.LoadedAccountSourceCheckpoint](32, 2*time.Hour)
+
+// PinkhaValidateLoadedAccountSourceCapture reauthorizes the original native
+// capture using a fresh real session/ACL/checkpoint read. JSON cannot mint its
+// in-memory native binding; another boot requires a new actual capture.
+func (mw *Middleware) PinkhaValidateLoadedAccountSourceCapture(ctx context.Context, token, requestID, manifestSHA256 string) error {
+	if mw == nil || mw.applicationService == nil || ctx == nil {
+		return capturecontrol.ErrCaptureBinding
+	}
+	original, err := pinkhaCapturedSources.Get(token, requestID, manifestSHA256)
+	if err != nil {
+		return err
+	}
+	if err := mw.applicationService.RevalidateLoadedAccountSource(ctx, token, original); err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	current, err := pinkhaCapturedSources.Get(token, requestID, manifestSHA256)
+	if err != nil {
+		return err
+	}
+	if current != original {
+		return capturecontrol.ErrCaptureBinding
+	}
+	return nil
+}
+
+func (mw *Middleware) PinkhaReleaseLoadedAccountSourceCapture(token, requestID string) bool {
+	if mw == nil || mw.applicationService == nil {
+		return false
+	}
+	return pinkhaCapturedSources.Forget(token, requestID)
+}
