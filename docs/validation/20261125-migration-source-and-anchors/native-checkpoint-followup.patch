+package capturecontrol
+
+import (
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestCaptureBindingRequiresOriginalTokenIdentityAndDigest(t *testing.T) {
+	b := NewBindings[*int](2, time.Minute)
+	value := 17
+	digest := strings.Repeat("a", 64)
+	if err := b.Put("original-token", "capture-one", digest, &value); err != nil {
+		t.Fatal(err)
+	}
+	for _, input := range [][3]string{
+		{"wrong-token", "capture-one", digest}, {"original-token", "other-capture", digest},
+		{"original-token", "capture-one", strings.Repeat("b", 64)},
+		{"original-token", "capture-one", strings.Repeat("A", 64)},
+	} {
+		if _, err := b.Get(input[0], input[1], input[2]); !errors.Is(err, ErrCaptureBinding) {
+			t.Fatal("unbound proof accepted")
+		}
+	}
+	if b.Forget("wrong-token", "capture-one") {
+		t.Fatal("foreign token removed original")
+	}
+	got, err := b.Get("original-token", "capture-one", digest)
+	if err != nil || got != &value {
+		t.Fatal("original binding lost")
+	}
+	if err := b.Put("original-token", "capture-one", digest, new(int)); !errors.Is(err, ErrCaptureBinding) {
+		t.Fatal("original capture replaced")
+	}
+	if !b.Forget("original-token", "capture-one") {
+		t.Fatal("original was not released")
+	}
+	if _, err := b.Get("original-token", "capture-one", digest); !errors.Is(err, ErrCaptureBinding) {
+		t.Fatal("released proof remained usable")
+	}
+}
+
+func TestCaptureBindingExpiresBoundsAndNeverPersistsAcrossRegistryRestart(t *testing.T) {
+	now := time.Unix(100, 0)
+	b := NewBindings[int](1, time.Minute)
+	b.now = func() time.Time { return now }
+	digest := strings.Repeat("f", 64)
+	if err := b.Put("token", "old", digest, 1); err != nil {
+		t.Fatal(err)
+	}
+	if err := b.Put("token", "new", digest, 2); !errors.Is(err, ErrCaptureBinding) {
+		t.Fatal("capacity not bounded")
+	}
+	now = now.Add(time.Minute)
+	if _, err := b.Get("token", "old", digest); !errors.Is(err, ErrCaptureBinding) {
+		t.Fatal("expired proof accepted")
+	}
+	if err := b.Put("token", "new", digest, 2); err != nil {
+		t.Fatal("expired capacity not released")
+	}
+	restarted := NewBindings[int](1, time.Minute)
+	if _, err := restarted.Get("token", "new", digest); !errors.Is(err, ErrCaptureBinding) {
+		t.Fatal("synthetic restart retained proof")
+	}
+	for _, input := range [][3]string{{"", "id", digest}, {"token", "../id", digest}, {"token", "id", ""}} {
+		if err := b.Put(input[0], input[1], input[2], 0); !errors.Is(err, ErrCaptureBinding) {
+			t.Fatal("invalid binding accepted")
+		}
+	}
+}
+
+func TestCaptureBindingConcurrentAccessAndVerificationIdentity(t *testing.T) {
+	b := NewBindings[int](1, time.Minute)
+	digest := strings.Repeat("a", 64)
+	if err := b.Put("token", "capture", digest, 7); err != nil {
+		t.Fatal(err)
+	}
+	var group sync.WaitGroup
+	for n := 0; n < 32; n++ {
+		group.Add(1)
+		go func() {
+			defer group.Done()
+			for step := 0; step < 16; step++ {
+				value, err := b.Get("token", "capture", digest)
+				if err != nil || value != 7 {
+					t.Error("stable original binding changed")
+				}
+				if b.Forget("foreign", "capture") {
+					t.Error("foreign release")
+				}
+			}
+		}()
+	}
+	group.Wait()
+	for _, id := range []string{"capture", strings.Repeat("z", 128)} {
+		actual := VerificationRequestID(id)
+		capture := CaptureRequestID(id)
+		if !ValidRequestID(capture) || capture == actual || CaptureRequestID(actual) == actual {
+			t.Fatal("capture/verification namespaces alias")
+		}
+		if !ValidRequestID(actual) || actual == id || actual != VerificationRequestID(id) {
+			t.Fatal("invalid verification identity")
+		}
+	}
+	if VerificationRequestID("first") == VerificationRequestID("second") {
+		t.Fatal("aliased verification identity")
+	}
+}
