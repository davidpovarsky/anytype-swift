+//go:build pinkha_loaded_account_witness
+
+package application
+
+import (
+	"context"
+	"reflect"
+
+	"github.com/anyproto/anytype-heart/core/pinkha/localstorewitness"
+)
+
+// LoadedAccountSourceCheckpoint contains only immutable native receipt
+// metadata. Only a completed real capture can construct a usable checkpoint;
+// it is not deserialized from a caller's JSON or a retained source directory.
+type LoadedAccountSourceCheckpoint struct {
+	accountID string
+	spaceID   string
+	source    LoadedAccountWitnessReceipt
+	inventory localstorewitness.NativeTreeInventoryReceipt
+	complete  bool
+}
+
+// SourceCheckpoint drops all source rows, snapshots and file buffers. Keeping
+// this small value alive does not keep the captured Space in native memory.
+func (w *LoadedAccountSpaceWitness) SourceCheckpoint() (*LoadedAccountSourceCheckpoint, error) {
+	if w == nil || !w.complete || w.source == nil || w.inventory == nil {
+		return nil, ErrLoadedAccountSpaceWitness
+	}
+	receipt, err := w.Receipt()
+	if err != nil {
+		return nil, err
+	}
+	if !receipt.AccountSessionAuthorizedAtFinalCapture ||
+		!receipt.CapturedSnapshotsBoundToUnchangedCheckpoint ||
+		!receipt.AllNativeHeadRowsAccounted {
+		return nil, ErrLoadedAccountSpaceWitness
+	}
+	return &LoadedAccountSourceCheckpoint{
+		accountID: w.source.accountID, spaceID: w.inventory.SpaceID(),
+		source: receipt.Source, inventory: receipt.Inventory, complete: true,
+	}, nil
+}
+
+// RevalidateLoadedAccountSource performs a new real account/session/ACL/native
+// read. It compares the original receipt's exact owner, directory, generation,
+// opaque row witness and tree inventory. A detached checkpoint never supplies
+// authorization, and success here supplies no semantic or destination permit.
+// This is a point-in-time native read, not a lock held across another engine.
+func (s *Service) RevalidateLoadedAccountSource(ctx context.Context, token string, expected *LoadedAccountSourceCheckpoint) error {
+	if s == nil || ctx == nil || expected == nil || !expected.complete ||
+		expected.accountID == "" || expected.spaceID == "" {
+		return ErrLoadedAccountSpaceWitness
+	}
+	current, err := s.CaptureLoadedAccountWitness(ctx, token, LoadedAccountWitnessRequest{
+		AccountID: expected.accountID, SpaceID: expected.spaceID, Limits: localstorewitness.DefaultLimits(),
+	})
+	if err != nil {
+		return err
+	}
+	source, err := current.Receipt()
+	if err != nil {
+		return err
+	}
+	inventory, err := current.PrivateWitness().NativeTreeIdentities(ctx)
+	if err != nil {
+		return err
+	}
+	receipt, err := inventory.Receipt()
+	if err != nil {
+		return err
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !reflect.DeepEqual(expected.source, source) || !reflect.DeepEqual(expected.inventory, receipt) {
+		return loadedAccountSpaceWitnessCheckpointChangedError{}
+	}
+	return nil
+}
