+	"crypto/subtle"
+	"errors"
+	"sync"
+	"time"
+)
+
+var ErrCaptureBinding = errors.New("original native source capture binding required")
+
+// Bindings retains only the caller's small immutable native metadata. It never
+// accepts a source authorization claim from transported JSON. T is supplied by
+// the native owner; this registry merely binds its lifetime to token/id/digest.
+type Bindings[T any] struct {
+	mu       sync.Mutex
+	values   map[string]binding[T]
+	limit    int
+	lifetime time.Duration
+	now      func() time.Time
+}
+type binding[T any] struct {
+	token   [32]byte
+	digest  string
+	value   T
+	expires time.Time
+}
+
+func NewBindings[T any](limit int, lifetime time.Duration) *Bindings[T] {
+	if limit < 1 || limit > 64 || lifetime <= 0 || lifetime > 2*time.Hour {
+		panic("invalid source capture binding bounds")
+	}
+	return &Bindings[T]{values: make(map[string]binding[T]), limit: limit, lifetime: lifetime, now: time.Now}
+}
+
+func validBinding(token, requestID, digest string) bool {
+	if len(token) == 0 || len(token) > 16<<10 || !ValidRequestID(requestID) || len(digest) != 64 {
+		return false
+	}
+	for _, c := range []byte(digest) {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+
+func (b *Bindings[T]) prune(now time.Time) {
+	for id, value := range b.values {
+		if !now.Before(value.expires) {
+			delete(b.values, id)
+		}
+	}
+}
+
+// Put never replaces a live original, even with the same token and bytes.
+func (b *Bindings[T]) Put(token, requestID, digest string, value T) error {
+	if !validBinding(token, requestID, digest) {
+		return ErrCaptureBinding
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	now := b.now()
+	b.prune(now)
+	if _, exists := b.values[requestID]; exists || len(b.values) >= b.limit {
+		return ErrCaptureBinding
+	}
+	b.values[requestID] = binding[T]{token: sha256.Sum256([]byte(token)), digest: digest,
+		value: value, expires: now.Add(b.lifetime)}
+	return nil
+}
+
+func (b *Bindings[T]) Get(token, requestID, digest string) (T, error) {
+	var zero T
+	if !validBinding(token, requestID, digest) {
+		return zero, ErrCaptureBinding
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.prune(b.now())
+	value, found := b.values[requestID]
+	hash := sha256.Sum256([]byte(token))
+	if !found || subtle.ConstantTimeCompare(hash[:], value.token[:]) != 1 ||
+		subtle.ConstantTimeCompare([]byte(digest), []byte(value.digest)) != 1 {
+		return zero, ErrCaptureBinding
+	}
+	return value.value, nil
+}
+
+// Forget releases only metadata. Original private source files remain available
+// for the application's explicitly owned recovery/retention lifecycle.
+func (b *Bindings[T]) Forget(token, requestID string) bool {
+	if len(token) == 0 || len(token) > 16<<10 || !ValidRequestID(requestID) {
+		return false
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.prune(b.now())
+	value, found := b.values[requestID]
+	hash := sha256.Sum256([]byte(token))
+	if !found || subtle.ConstantTimeCompare(hash[:], value.token[:]) != 1 {
+		return false
+	}
+	delete(b.values, requestID)
+	return true
+}
+
+// Active operations use disjoint fixed namespaces. A caller-chosen capture
+// request ID cannot alias another capture's in-flight verification.
+func CaptureRequestID(requestID string) string {
+	return operationRequestID("capture-", requestID)
+}
+func VerificationRequestID(requestID string) string {
+	return operationRequestID("verify-", requestID)
+}
+func operationRequestID(prefix, requestID string) string {
+	hash := sha256.Sum256([]byte(requestID))
+	const alphabet = "0123456789abcdef"
+	out := make([]byte, len(prefix)+64)
+	copy(out, prefix)
+	for i, value := range hash {
+		out[len(prefix)+i*2], out[len(prefix)+i*2+1] = alphabet[value>>4], alphabet[value&15]
+	}
+	return string(out)
+}
