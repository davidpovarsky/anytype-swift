+
+// This is a current-state source observation, not a promise about future
+// clients or template-selected creation. Both creation paths use the real
+// object service and retain the exact native property definition.
+func TestLoadedAccountRelationDefaultCurrentState(t *testing.T) {
+	f := newLoadedAccountFixture(t)
+	creator := app.MustComponent[objectcreator.Service](f.service.GetApp())
+	picker := app.MustComponent[*block.Service](f.service.GetApp())
+	const nativeDefault = "native default a\u0301 — ברירת מחדל"
+	const explicitValue = "explicit value a\u0301 — ערך מפורש"
+	definition := domain.NewDetails()
+	definition.SetString(bundle.RelationKeyName, "Owned default metadata")
+	definition.SetInt64(bundle.RelationKeyRelationFormat, int64(model.RelationFormat_longtext))
+	definition.SetInt64(bundle.RelationKeyRelationMaxCount, 1)
+	definition.SetString(bundle.RelationKeyRelationDefaultValue, nativeDefault)
+	propertyID, propertyDetails, err := creator.CreateObject(f.ctx, f.space.Id(),
+		objectcreator.CreateObjectRequest{ObjectTypeKey: bundle.TypeKeyRelation, Details: definition})
+	require.NoError(t, err)
+	require.NotEmpty(t, propertyID)
+	require.True(t, propertyDetails.Has(bundle.RelationKeyRelationDefaultValue))
+	require.Equal(t, nativeDefault, propertyDetails.GetString(bundle.RelationKeyRelationDefaultValue))
+	propertyKey := domain.RelationKey(propertyDetails.GetString(bundle.RelationKeyRelationKey))
+	require.NotEmpty(t, propertyKey)
+	require.NotEqual(t, propertyID, propertyKey.String())
+
+	typeDetails := domain.NewDetails()
+	typeDetails.SetString(bundle.RelationKeyName, "Owned default observation type")
+	typeDetails.SetInt64(bundle.RelationKeyRecommendedLayout, int64(model.ObjectType_basic))
+	typeDetails.SetStringList(bundle.RelationKeyRecommendedRelations, []string{propertyID})
+	typeID, actualType, err := creator.CreateObject(f.ctx, f.space.Id(),
+		objectcreator.CreateObjectRequest{ObjectTypeKey: bundle.TypeKeyObjectType, Details: typeDetails})
+	require.NoError(t, err)
+	typeKey, err := domain.GetTypeKeyFromRawUniqueKey(actualType.GetString(bundle.RelationKeyUniqueKey))
+	require.NoError(t, err)
+
+	type observation struct {
+		Path, Case, ID, Value string
+		Present               bool
+	}
+	var observations []observation
+	assertDetails := func(t *testing.T, details *domain.Details, present bool, value string) {
+		t.Helper()
+		require.NotNil(t, details)
+		require.Equal(t, present, details.Has(propertyKey), "absence must not be replaced by definition metadata")
+		if present {
+			actual, ok := details.TryString(propertyKey)
+			require.True(t, ok)
+			require.Equal(t, value, actual)
+		}
+	}
+	for _, path := range []string{"ordinary-no-template", "from-state"} {
+		for _, valueCase := range []struct {
+			name, value string
+			present     bool
+		}{{"absent", "", false}, {"empty", "", true}, {"explicit", explicitValue, true}} {
+			t.Run(path+"/"+valueCase.name, func(t *testing.T) {
+				details := domain.NewDetails()
+				details.SetString(bundle.RelationKeyName, "Owned default "+path+" "+valueCase.name)
+				if valueCase.present {
+					details.SetString(propertyKey, valueCase.value)
+				}
+				var id string
+				var actual *domain.Details
+				var createErr error
+				if path == "ordinary-no-template" {
+					id, actual, createErr = creator.CreateObject(f.ctx, f.space.Id(),
+						objectcreator.CreateObjectRequest{ObjectTypeKey: typeKey, TemplateId: "", Details: details})
+				} else {
+					root := "owned-default-" + valueCase.name
+					st := state.NewDoc(root, map[string]simple.Block{
+						root: simple.New(&model.Block{Id: root,
+							Content: &model.BlockContentOfSmartblock{Smartblock: &model.BlockContentSmartblock{}}}),
+					}).(*state.State)
+					st.SetDetails(details)
+					id, actual, createErr = creator.CreateSmartBlockFromState(f.ctx, f.space.Id(), []domain.TypeKey{typeKey}, st)
+				}
+				require.NoError(t, createErr)
+				require.NotEmpty(t, id)
+				assertDetails(t, actual, valueCase.present, valueCase.value)
+				require.NoError(t, cache.DoContextFullID(picker, f.ctx,
+					domain.FullID{SpaceID: f.space.Id(), ObjectID: id}, func(object sb.SmartBlock) error {
+						assertDetails(t, object.NewState().CombinedDetails(), valueCase.present, valueCase.value)
+						return nil
+					}))
+				observations = append(observations, observation{Path: path, Case: valueCase.name,
+					ID: id, Present: valueCase.present, Value: valueCase.value})
+			})
+		}
+	}
+	require.Len(t, observations, 6, "all creation observations must complete before frozen capture")
+	loadedSpaceFixtureWarm(t, f)
+	captured, err := loadedCaptureFreshAttempts(f.ctx, func() (*LoadedAccountSpaceWitness, error) {
+		return f.service.CaptureLoadedAccountSpaceWitness(f.ctx, f.token, loadedSpaceRequest(f))
+	}, func(note loadedNativeCaptureAttempt) {
+		f.privateNote(t, fmt.Sprintf("native-default-capture-attempt-%d", note.Attempt), map[string]any{
+			"contract": "pinkha-native-source-capture-attempt-v1", "attemptLimit": loadedNativeCaptureAttemptLimit,
+			"stage": "relation-default-current-state", "attempt": note, "newCaptureRequiredAfterRefusal": true,
+		})
+	})
+	require.NoError(t, err)
+	receipt, err := captured.Receipt()
+	require.NoError(t, err)
+	require.True(t, receipt.AllNativeHeadRowsAccounted)
+	require.True(t, receipt.AllCurrentObjectsCaptured)
+	require.True(t, receipt.AccountSessionAuthorizedAtFinalCapture)
+	require.True(t, receipt.CapturedSnapshotsBoundToUnchangedCheckpoint)
+	require.True(t, receipt.IndexResolverSnapshotBound)
+	require.Zero(t, receipt.ClosedResolverUnmapped)
+	require.False(t, receipt.HasNativeSourceAdmission)
+	require.False(t, receipt.SemanticCompleteness)
+	require.False(t, receipt.HistorySemanticsValidated)
+	require.False(t, receipt.PermitsDestinationWrites)
+
+	originals := map[string]*nativeexport.NativeRawObject{}
+	for _, object := range captured.Objects() {
+		require.NotContains(t, originals, object.ObjectID())
+		originals[object.ObjectID()] = object
+	}
+	readFrozen := func(id string) (*model.SmartBlockSnapshotBase, map[string]json.RawMessage) {
+		t.Helper()
+		object := originals[id]
+		require.NotNil(t, object)
+		base := new(model.SmartBlockSnapshotBase)
+		require.NoError(t, proto.Unmarshal(object.SnapshotBase(), base))
+		raw, readErr := object.JSONView()
+		require.NoError(t, readErr)
+		var view struct {
+			Snapshot struct {
+				Details map[string]json.RawMessage `json:"details"`
+			}
+		}
+		require.NoError(t, json.Unmarshal(raw, &view))
+		require.NotNil(t, base.Details)
+		require.NotNil(t, view.Snapshot.Details)
+		return base, view.Snapshot.Details
+	}
+	propertyBase, propertyView := readFrozen(propertyID)
+	require.Equal(t, model.SmartBlockType_STRelation, originals[propertyID].Type())
+	require.True(t, proto.Equal(domain.String(nativeDefault).ToProto(),
+		propertyBase.Details.Fields[bundle.RelationKeyRelationDefaultValue.String()]))
+	var recoveredDefault string
+	require.NoError(t, json.Unmarshal(propertyView[bundle.RelationKeyRelationDefaultValue.String()], &recoveredDefault))
+	require.Equal(t, nativeDefault, recoveredDefault)
+	identities := map[string]bool{propertyID: true, typeID: true}
+	for _, item := range observations {
+		require.False(t, identities[item.ID])
+		identities[item.ID] = true
+		base, view := readFrozen(item.ID)
+		require.Equal(t, model.SmartBlockType_Page, originals[item.ID].Type())
+		require.Equal(t, []string{typeKey.URL()}, base.ObjectTypes)
+		actual, present := base.Details.Fields[propertyKey.String()]
+		require.Equal(t, item.Present, present, item.Path+"/"+item.Case)
+		jsonValue, jsonPresent := view[propertyKey.String()]
+		require.Equal(t, item.Present, jsonPresent, item.Path+"/"+item.Case)
+		if item.Present {
+			require.True(t, proto.Equal(domain.String(item.Value).ToProto(), actual))
+			var value string
+			require.NoError(t, json.Unmarshal(jsonValue, &value))
+			require.Equal(t, item.Value, value)
+		}
+	}
+	require.Len(t, identities, 8)
+	count := loadedSnapshotJSONViews(t, captured)
+	manifestRaw, err := os.ReadFile(filepath.Join(captured.PrivateBundleDirectory(), "manifest.json"))
+	require.NoError(t, err)
+	f.privateNote(t, "native-default-current-state", map[string]any{
+		"contract":        "pinkha-native-default-current-state-observation-v1",
+		"sourceAccountID": f.account.Id, "sourceSpaceID": f.space.Id(), "sourceReceipt": receipt,
+		"propertyObjectID": propertyID, "propertyKey": propertyKey.String(), "typeObjectID": typeID,
+		"observations": observations, "originalSourceManifestSHA256": loadedFixtureHash(manifestRaw),
+		"capturedObjects": count, "absenceAndExplicitEmptyRemainDistinct": true,
+		"nonNullDefinitionDefaultRetained": true, "templateSelectionValidated": false,
+		"futureClientCreationSemanticsValidated": false, "wholeSpaceSemanticMigrationComplete": false,
+	})
+	t.Logf("NATIVE_DEFAULT_CURRENT_STATE ordinary_without_template=3 from_state=3 absent_empty_value_distinct=true exact_definition_default_retained=true original_snapshots=%d future_client_and_template_behavior=false", count)
+}
