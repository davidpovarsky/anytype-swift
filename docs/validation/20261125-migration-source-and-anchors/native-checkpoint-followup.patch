+
+	"github.com/anyproto/anytype-heart/pb"
+)
+
+func TestLoadedAccountSourceCheckpointRequiresCurrentNativeSessionAndUnchangedRows(t *testing.T) {
+	f := newLoadedAccountFixture(t)
+	loadedObjectFixturePage(t, f, "Source checkpoint original — מקור", false)
+	loadedSpaceFixtureWarm(t, f)
+	captured, err := loadedCaptureFreshAttempts(f.ctx, func() (*LoadedAccountSpaceWitness, error) {
+		return f.service.CaptureLoadedAccountSpaceWitness(f.ctx, f.token, loadedSpaceRequest(f))
+	}, func(note loadedNativeCaptureAttempt) {
+		f.privateNote(t, fmt.Sprintf("checkpoint-capture-attempt-%d", note.Attempt), map[string]any{"attempt": note})
+	})
+	require.NoError(t, err)
+	checkpoint, err := captured.SourceCheckpoint()
+	require.NoError(t, err)
+	require.NoError(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, checkpoint))
+
+	require.Error(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, nil))
+	require.Error(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, new(LoadedAccountSourceCheckpoint)))
+	require.ErrorIs(t, f.service.RevalidateLoadedAccountSource(f.ctx, "unregistered-native-session", checkpoint), ErrLoadedAccountWitnessSession)
+	cancelled, cancel := context.WithCancel(f.ctx)
+	cancel()
+	require.ErrorIs(t, f.service.RevalidateLoadedAccountSource(cancelled, f.token, checkpoint), context.Canceled)
+
+	originalToken := f.token
+	require.NoError(t, f.service.CloseSession(&pb.RpcWalletCloseSessionRequest{Token: originalToken}))
+	require.ErrorIs(t, f.service.RevalidateLoadedAccountSource(f.ctx, originalToken, checkpoint), ErrLoadedAccountWitnessSession)
+	f.token = f.newFullSession(t)
+	require.NoError(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, checkpoint),
+		"Actual new native authorization must be checked; the detached checkpoint grants none")
+
+	loadedObjectFixturePage(t, f, "Source changed after capture — שינוי", false)
+	require.ErrorIs(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, checkpoint),
+		ErrLoadedAccountSpaceWitnessCheckpointChanged)
+	receipt, err := captured.Receipt()
+	require.NoError(t, err)
+	require.False(t, receipt.HasNativeSourceAdmission)
+	require.False(t, receipt.PermitsDestinationWrites)
+	f.privateNote(t, "current-source-checkpoint-result", map[string]any{
+		"contract":                    "pinkha-current-source-checkpoint-native-observation-v1",
+		"realUnchangedSourceAccepted": true, "nilAndZeroRefused": true,
+		"unregisteredAndNormallyRevokedSessionsRefused": true,
+		"cancelledReadRefused":                          true, "freshFullSessionActuallyRevalidated": true,
+		"nativeSourceChangeRefused": true, "permitsDestinationWrites": false,
+		"freshProcessRestoreValidated": false, "wholeSpaceMigrationComplete": false,
+	})
+	t.Log("NATIVE_SOURCE_REVALIDATION actual_unchanged_source=true native_session_revoke=true fresh_authorized_session=true changed_native_source_refused=true destination_admission=false")
+}
