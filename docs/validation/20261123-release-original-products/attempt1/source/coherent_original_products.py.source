"""Execute the unrun d254 Release scopes from exactly pinned original Products.

The App checkout and all compiled carriers retain run 45095838065's identity.
Only the controller has the current CI identity. No build command is available
in this opt-in route; the existing same-job route keeps its original contract.
"""
from dataclasses import dataclass, replace
from pathlib import Path
import argparse
import copy
import hashlib
import json
import os
import platform
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import zipfile

if __name__ == "__main__":
    sys.modules["coherent_original_products"] = sys.modules[__name__]

import wave15_batch as batch
import sdk06_enumeration_probe as products

