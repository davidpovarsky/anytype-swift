{
  "call_path": [
    {
      "end_line": 271,
      "function": "confirm_empty_container",
      "function_source_sha256": "4e65019c2853e36425f1de59f0c834bbf3e5a8d541e9bb539b990d24c8550268",
      "line": 267,
      "path": "Tools/PinkhaSimulatorGate/coherent_original_products.py",
      "source": "def confirm_empty_container(self, udid, evidence):\n        import coherent_fresh_construction as construction\n        require(self.device is not None and self.device[\"udid\"] == udid,\n                \"Original-Products construction destination differs\")\n        return construction.confirm(self.origin, self.device, evidence)",
      "source_sha256": "94bb6243460443c7f260e23bcfe1d15f4dfe862e8f2777b788b6b14e6e28023e"
    },
    {
      "end_line": 213,
      "function": "confirm",
      "function_source_sha256": "f7c85cb238e86f6c0f8c69dd671ee8d9a1632c23065d31ce9730888f02f6079d",
      "line": 190,
      "path": "Tools/PinkhaSimulatorGate/coherent_fresh_construction.py",
      "source": "def confirm(origin, device, directory):\n    intent = read(origin.evidence / \"batch-intent.json\", origin.evidence)\n    bound = verify_creation(origin, intent, device, directory)\n    state = origin._constructions.get(device[\"udid\"].lower())\n    commands = read(directory / \"construction/command-journal.json\", origin.evidence)\n    require(commands.get(\"commands\") == [\n                read(directory / \"construction/create.observation.json\", origin.evidence)],\n            \"Construction has an earlier owned operation\")\n    require(state and state[\"device\"] == device and state[\"directory\"] == directory\n            and not state[\"first_selection_consumed\"] and state[\"fresh_sha256\"] is None\n            and not (directory / \"construction/first-selection-attempt.json\").exists(),\n            \"Construction cannot be reset or admitted after a selection attempt\")\n    ready = batch.validate_coherent_readiness(directory, device)\n    require(ready[\"before\"][\"udid\"] == device[\"udid\"], \"Readiness belongs to another UUID\")\n    receipt = dict(**bound, status=\"OWNED_CONSTRUCTION_VERIFIED_BEFORE_FIRST_NATIVE_SELECTION\",\n        simulator_udid=device[\"udid\"], container_absence_proved=False,\n        lookup=\"NOT_PERFORMED_CONSTRUCTION_CONTRACT\",\n        created_proof_sha256=digest(directory / \"construction/created-proof.json\", origin.evidence),\n        readiness_receipt_sha256=digest(directory / \"owned-readiness/readiness.json\", origin.evidence),\n        selection_plan_sha256=digest(directory / \"selection-plan.json\", origin.evidence),\n        prior_owned_install_or_selection_attempts=0)\n    original(directory / \"fresh-container.json\", receipt)\n    state[\"fresh_sha256\"] = digest(directory / \"fresh-container.json\", origin.evidence)\n    return receipt",
      "source_sha256": "d1365997188a81d1ad6fa25f50feefb1f87dd8e60034a5957ac1c8e706a9df61"
    },
    {
      "end_line": 464,
      "function": "validate_coherent_readiness",
      "function_source_sha256": "c333627935037aa512a82e3d45471d0f6c01015e53aafe49477bdc8568ab6e3b",
      "line": 431,
      "path": "Tools/PinkhaSimulatorGate/wave15_batch.py",
      "source": "def validate_coherent_readiness(evidence, device):\n    \"\"\"Re-read successful exact preboot identity/bootstatus; no redundant live inventory.\"\"\"\n    import owned_simulator_readiness as simulator\n    import run_t5_apple_pair as pair\n    directory = evidence / \"owned-readiness\"\n    original = directory / \"readiness.json\"\n    require(original.is_file() and not original.is_symlink() and original.stat().st_size <= 65536,\n            \"Original bounded coherent readiness receipt is missing\")\n    ready = json.loads(original.read_bytes())\n    require(ready.get(\"status\") == \"OWNED_SIMULATOR_READY\"\n            and ready.get(\"destination\") == device[\"udid\"]\n            and ready.get(\"tests_executed\") == 0 and ready.get(\"boot_required\") is True\n            and ready.get(\"before\", {}).get(\"state\") == \"Shutdown\"\n            and ready.get(\"bootstatus_return_code\") == 0\n            and ready.get(\"postboot_inventory_performed\") is False\n            and ready.get(\"readiness_basis\") == \"VERIFIED_PREBOOT_IDENTITY_AND_SUCCESSFUL_OWNED_BOOTSTATUS\",\n            \"Coherent simulator readiness is incomplete\")\n    for name, key in ((\"before.json\", \"preboot_identity_sha256\"), (\"boot-status.log\", \"bootstatus_log_sha256\")):\n        path = directory / name\n        require(path.is_file() and not path.is_symlink() and digest(path) == ready.get(key),\n                \"Coherent original readiness evidence changed\")\n    observed = simulator.owned_identity(json.loads((directory / \"before.json\").read_bytes()),\n                                        device, device[\"name\"], pair)\n    require(observed == ready[\"before\"], \"Coherent preboot identity differs from its original inventory\")\n    for name, argv, bound in (\n            (\"boot\", [\"xcrun\", \"simctl\", \"boot\", device[\"udid\"]], 120),\n            (\"boot-status\", [\"xcrun\", \"simctl\", \"bootstatus\", device[\"udid\"], \"-b\"], 180)):\n        command = json.loads((directory / (name + \".command.json\")).read_bytes())\n        require(command.get(\"argv\") == argv and command.get(\"timeout_seconds\") == bound\n                and command.get(\"return_code\") == 0 and command.get(\"timed_out\", False) is False\n                and command.get(\"status\") == \"SUCCESS\"\n                and command.get(\"owned_group_quiescence\", {}).get(\"status\") == \"PASS\",\n                \"Coherent owned boot command lacks successful bounded completion\")\n    return ready",
      "source_sha256": "75e923d8c9718553d80c6aa3fd5338f06e2622e275ba10bc5537d03c4ba03193"
    },
    {
      "end_line": 30,
      "function": "owned_identity",
      "function_source_sha256": "af20ff14173a486ffd44a0334d806384a43d5de106a710c5dc86109760cb20cc",
      "line": 19,
      "path": "Tools/PinkhaSimulatorGate/owned_simulator_readiness.py",
      "source": "def owned_identity(value, selection, expected_name, pair):\n    udid = selection.get(\"udid\", \"\")\n    pair.require(re.fullmatch(r\"[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\", udid)\n                 and selection.get(\"name\") == expected_name and expected_name,\n                 \"Explicit owned simulator name and UUID required\")\n    matches = [(runtime, item) for runtime, devices in value.get(\"devices\", {}).items()\n               for item in devices if item.get(\"udid\", \"\").lower() == udid.lower()]\n    pair.require(len(matches) == 1, \"Owned simulator is missing or ambiguous\")\n    runtime, item = matches[0]\n    observed = {key: item.get(key) for key in (\"udid\", \"name\", \"deviceTypeIdentifier\", \"state\", \"isAvailable\")}\n    observed[\"runtime_identifier\"] = runtime\n    return validate_identity(observed, selection, expected_name, pair)",
      "source_sha256": "42be87c8f6e9cb4911b6f5e8a009d0e17aa8d43bf1c259f91534fda7e70d1d09"
    },
    {
      "end_line": 41,
      "function": "validate_identity",
      "function_source_sha256": "42b169433bcf004c76e9dc2ea71ede1b30ae4c929bac27eb800f12756dff34c9",
      "line": 33,
      "path": "Tools/PinkhaSimulatorGate/owned_simulator_readiness.py",
      "source": "def validate_identity(item, selection, expected_name, pair):\n    pair.require(selection.get(\"name\") == expected_name and expected_name\n                 and item.get(\"udid\", \"\").lower() == selection[\"udid\"].lower()\n                 and item.get(\"runtime_identifier\") == selection[\"runtime\"][\"identifier\"]\n                 and item.get(\"deviceTypeIdentifier\") == selection[\"device\"][\"identifier\"]\n                 and item.get(\"name\") == expected_name and item.get(\"isAvailable\") is True\n                 and item.get(\"state\") in {\"Shutdown\", \"Booted\"},\n                 \"Actual simulator type, runtime, name, availability or stable state differs\")\n    return item",
      "source_sha256": "42be87c8f6e9cb4911b6f5e8a009d0e17aa8d43bf1c259f91534fda7e70d1d09"
    },
    {
      "end_line": 60,
      "function": "require",
      "function_source_sha256": "07aea090f1e0ffe029e693d88420d601dd716fbf051fb282a0b180d358f98992",
      "line": 58,
      "path": "Tools/PinkhaSimulatorGate/run_t5_apple_pair.py",
      "source": "def require(condition, message):\n    if not condition:\n        raise RuntimeError(message)",
      "source_sha256": "11e11ec19eca11d506f56b37ad8ff76bcdbc40a28a4c233b4e57cb86432b1340"
    }
