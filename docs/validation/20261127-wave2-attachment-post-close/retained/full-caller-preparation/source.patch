+private actor ReceiptCarrierAuthority {
+    private var active = true
+    private var checks = 0
+    func check() throws {
+        checks += 1
+        guard active else { throw AnyEngineError.accountChanged }
+    }
+    func count() -> Int { checks }
+    func deny() { active = false }
+}
