+        let occupied = Set(recoveryReceipts.keys).union(originalCreators.keys)
+        guard occupied.count < Self.maximumRecoveryReceipts else {
+            throw AnyNativeAttachmentRecoveryError.capacityExceeded
+        }
+    }
