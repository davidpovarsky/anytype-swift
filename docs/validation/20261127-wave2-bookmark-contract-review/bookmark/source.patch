+        let plan = try await repository.prepareCreation(typeID: "page", title: "", kind: .writingDocument)
+        let observed = AsyncStream<Void>.makeStream(bufferingPolicy: .bufferingNewest(2))
+        defer { observed.continuation.finish() }
