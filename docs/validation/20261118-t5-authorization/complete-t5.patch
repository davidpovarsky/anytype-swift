diff --git a/.github/workflows/pinkha-t5-coverage-proof.yml b/.github/workflows/pinkha-t5-coverage-proof.yml
new file mode 100644
index 0000000000..73b07b09ca
--- /dev/null
+++ b/.github/workflows/pinkha-t5-coverage-proof.yml
@@ -0,0 +1,62 @@
+name: Pinkha bounded T5 native source proof
+
+on:
+  workflow_call:
+    inputs:
+      component:
+        type: string
+        default: native-index
+
+permissions:
+  contents: read
+
+jobs:
+  component:
+    runs-on: ubuntu-22.04
+    timeout-minutes: 60
+    steps:
+      - name: Checkout integration proof control
+        uses: actions/checkout@v4
+        with:
+          path: control
+      - name: Checkout exact reviewed T5 fixtures
+        uses: actions/checkout@v4
+        with:
+          ref: 947fbde24d5657d0e1229f45bb3993648884a8a1
+          path: source
+      - name: Checkout exact native Heart source
+        uses: actions/checkout@v4
+        with:
+          repository: anyproto/anytype-heart
+          ref: d98420b1113536afd08cde6de9a5816f6d27ffff
+          path: heart
+      - name: Install pinned Go toolchain
+        uses: actions/setup-go@v5
+        with:
+          go-version: '1.26.5'
+          cache: false
+      - name: Restore compiled dependencies only
+        uses: actions/cache@v4
+        with:
+          path: |
+            ~/go/pkg/mod
+            ~/.cache/go-build
+          key: t5-linux-go1.26.5-${{ hashFiles('heart/tantivity_sha256.txt', 'heart/go.sum', 'source/**/go.sum') }}-947fbde2-${{ inputs.component }}
+          restore-keys: |
+            t5-linux-go1.26.5-${{ hashFiles('heart/tantivity_sha256.txt', 'heart/go.sum', 'source/**/go.sum') }}-
+      - name: Execute one real native component with fresh evidence
+        env:
+          T5_COMPONENT: ${{ inputs.component }}
+        run: |
+          python3 control/Tools/PinkhaNativeDerived/test_run_t5_coverage_ci.py
+          python3 control/Tools/PinkhaNativeDerived/run_t5_coverage_ci.py \
+            --source source --heart heart --component "$T5_COMPONENT" \
+            --evidence "proof/$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT/$T5_COMPONENT"
+      - name: Upload attempt evidence including failures
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: Pinkha-T5-${{ inputs.component }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: proof/
+          if-no-files-found: warn
+          retention-days: 14
