+// GetTypeAndKeyFromRootForSpace binds a private root to its receiving Space.
+// Legacy object formats keep their existing resolution behavior.
+func GetTypeAndKeyFromRootForSpace(spaceID string, rawRoot *treechangeproto.RawTreeChangeWithId) (smartblock.SmartBlockType, string, error) {
+	tp, key, err := GetTypeAndKeyFromRoot(rawRoot)
+	if err != nil {
+		return 0, "", err
+	}
+	if tp == smartblock.SmartBlockTypePinkhaTorahOperations {
+		if err := torahopscontract.ValidateRoot(spaceID, rawRoot); err != nil {
+			return 0, "", err
+		}
+	}
+	return tp, key, nil
