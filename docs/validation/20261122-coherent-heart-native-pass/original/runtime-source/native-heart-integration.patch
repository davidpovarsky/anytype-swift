+type protocolStats struct {
+	Requests        atomic.Uint64
+	Responses       atomic.Uint64
+	Bytes           atomic.Uint64
+	Changes         atomic.Uint64
+	DroppedHeads    atomic.Uint64
+	CounterRequests atomic.Uint64
+}
+
+type nativeStats struct {
+	PID             int
