diff --git a/core/pinkha/torah/binding.go b/core/pinkha/torah/binding.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha/torah/binding.go
@@ -0,0 +1,86 @@
+package torahderived
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+)
+
+// ManifestSource must scope both calls to the supplied Space. Implementations
+// may only read: discovery must not invoke the app's duplicate cleanup/bootstrap.
+type ManifestSource interface {
+	Manifests(context.Context, string) ([]ManifestCandidate, error)
+	CanonicalProperty(context.Context, string, string) (PropertyDescriptor, error)
+}
+
+type ManifestCandidate struct {
+	ObjectID string
+	Raw      []byte
+}
+type PropertyDescriptor struct {
+	ID     string
+	Key    string
+	Format int
+}
+
+// ResolveBinding deliberately has no cache. Each manifest/property revision
+// changes Generation, forcing callers to invalidate/rebuild the local index.
+func ResolveBinding(ctx context.Context, source ManifestSource, space string) (Binding, error) {
+	candidates, err := source.Manifests(ctx, space)
+	if err != nil {
+		return Binding{}, err
+	}
+	// Fail closed on ambiguity. Never delete competing synced manifest objects.
+	if len(candidates) != 1 {
+		return Binding{}, ErrBinding
+	}
+	candidate := candidates[0]
+	var manifest struct {
+		SchemaVersion     int               `json:"schemaVersion"`
+		SpaceID           string            `json:"spaceId"`
+		ManifestObjectID  string            `json:"manifestObjectId"`
+		ProvisioningState *string           `json:"provisioningState"`
+		CanonicalID       string            `json:"documentAssociationsPropertyId"`
+		CanonicalKey      string            `json:"documentAssociationsPropertyKey"`
+		Types             map[string]string `json:"registeredDocumentTypes"`
+		Templates         map[string]string `json:"defaultTemplateIds"`
+		ParentID          string            `json:"parentPropertyId"`
+		ParentKey         string            `json:"parentPropertyKey"`
+		OrderID           string            `json:"orderPropertyId"`
+		OrderKey          string            `json:"orderPropertyKey"`
+		FolderTypeID      string            `json:"folderTypeId"`
+		BookFolderTypeID  string            `json:"bookFolderTypeId"`
+	}
+	if err := json.Unmarshal(candidate.Raw, &manifest); err != nil {
+		return Binding{}, ErrBinding
+	}
+	if manifest.SchemaVersion != 1 {
+		return Binding{}, ErrUnsupported
+	}
+	if candidate.ObjectID == "" || !exact(manifest.SpaceID, space) || (manifest.ManifestObjectID != "" && manifest.ManifestObjectID != candidate.ObjectID) || (manifest.ProvisioningState != nil && *manifest.ProvisioningState != "complete") {
+		return Binding{}, ErrBinding
+	}
+	if manifest.CanonicalID == "" || manifest.CanonicalKey == "" || manifest.ParentID == "" || manifest.ParentKey == "" || manifest.OrderID == "" || manifest.OrderKey == "" || manifest.FolderTypeID == "" || manifest.BookFolderTypeID == "" {
+		return Binding{}, ErrBinding
+	}
+	for _, role := range []string{"chiddush", "article", "research"} {
+		if manifest.Templates[role] == "" {
+			return Binding{}, ErrBinding
+		}
+	}
+	property, err := source.CanonicalProperty(ctx, space, manifest.CanonicalKey)
+	if err != nil {
+		return Binding{}, err
+	}
+	// Heart's existing RelationFormat_longtext is 0. No new wire format here.
+	if property.ID != manifest.CanonicalID || property.Key != manifest.CanonicalKey || property.Format != 0 {
+		return Binding{}, ErrBinding
+	}
+	hash := sha256.New()
+	hash.Write(candidate.Raw)
+	fmt.Fprintf(hash, "|%d:%s|%d:%s|%d", len(candidate.ObjectID), candidate.ObjectID, len(property.ID), property.ID, property.Format)
+	binding := Binding{SpaceID: space, CanonicalKey: manifest.CanonicalKey, Generation: hex.EncodeToString(hash.Sum(nil)), ManifestObjectID: candidate.ObjectID}
+	return binding, binding.Validate()
+}
diff --git a/core/pinkha/torah/projection.go b/core/pinkha/torah/projection.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha/torah/projection.go
@@ -0,0 +1,312 @@
+// Package torahderived implements the read-only canonical projection shared by
+// the native Heart indexer and its Swift/Go compatibility fixtures.
+package torahderived
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"golang.org/x/text/unicode/norm"
+)
+
+type Kind string
+
+const (
+	Ref   Kind = "ref"
+	Topic Kind = "topic"
+	Word  Kind = "word"
+)
+
+var ErrMalformed = errors.New("malformed canonical data")
+var ErrUnsupported = errors.New("unsupported canonical version")
+var ErrBinding = errors.New("invalid Space binding")
+var ErrIneligible = errors.New("ineligible document")
+
+// Binding contains validated native identifiers, never human display names.
+type Binding struct {
+	SpaceID          string
+	CanonicalKey     string
+	Generation       string
+	ManifestObjectID string
+}
+
+type Input struct {
+	SpaceID    string
+	ObjectID   string
+	TypeID     string
+	IsDocument bool
+	IsTemplate bool
+	IsDeleted  bool
+	IsArchived bool
+	Raw        []byte
+}
+
+type Projection struct {
+	Sources         []string                `json:"sources"`
+	Topics          []string                `json:"topics"`
+	Words           []string                `json:"words"`
+	CanonicalSHA256 string                  `json:"canonicalSHA256"`
+	Labels          map[string]DisplayLabel `json:"labels,omitempty"`
+	RelatedSources  []string                `json:"-"`
+	RelatedError    error                   `json:"-"`
+}
+
+// Display labels are a rebuildable local cache, never synced association data.
+type DisplayLabel struct {
+	Hebrew  string `json:"he"`
+	English string `json:"en,omitempty"`
+}
+
+// Identity matches Swift's NFC identity and length-prefixes UTF-8 bytes.
+// The version prefix allows a future local rebuild without rewriting user data.
+func Identity(kind Kind, provider, canonical, external string) string {
+	if canonical == "" {
+		canonical = external
+	}
+	parts := []string{string(kind), provider, canonical}
+	for i, part := range parts {
+		part = norm.NFC.String(part)
+		parts[i] = fmt.Sprintf("%d:%s", len(part), part)
+	}
+	return "torah1|" + strings.Join(parts, "|")
+}
+
+func (b Binding) Validate() error {
+	if b.SpaceID == "" || b.CanonicalKey == "" || b.Generation == "" || IsLocalKey(b.CanonicalKey) {
+		return ErrBinding
+	}
+	return nil
+}
+
+func Project(b Binding, in Input) (Projection, error) {
+	if err := b.Validate(); err != nil {
+		return Projection{}, err
+	}
+	if !exact(b.SpaceID, in.SpaceID) || in.ObjectID == "" || in.TypeID == "" || !in.IsDocument || in.IsTemplate || in.IsDeleted || in.IsArchived {
+		return Projection{}, ErrIneligible
+	}
+	hash := sha256.Sum256(in.Raw)
+	result := Projection{Sources: []string{}, Topics: []string{}, Words: []string{}, Labels: map[string]DisplayLabel{}, CanonicalSHA256: hex.EncodeToString(hash[:]), RelatedSources: []string{}}
+	// The current repository treats absent or empty native longText as no links.
+	if len(in.Raw) == 0 {
+		return result, nil
+	}
+	if !utf8.Valid(in.Raw) {
+		return Projection{}, ErrMalformed
+	}
+	envelope, err := object(in.Raw)
+	if err != nil {
+		return Projection{}, err
+	}
+	var version int
+	if err = required(envelope, "version", &version); err != nil {
+		return Projection{}, err
+	}
+	var records []record
+	switch version {
+	case 1:
+		var items []json.RawMessage
+		if err = required(envelope, "items", &items); err != nil {
+			return Projection{}, err
+		}
+		for _, item := range items {
+			records = append(records, record{SpaceID: in.SpaceID, ObjectID: in.ObjectID, Item: item})
+		}
+	case 2:
+		var rawRecords []json.RawMessage
+		if err = required(envelope, "records", &rawRecords); err != nil {
+			return Projection{}, err
+		}
+		for _, raw := range rawRecords {
+			fields, e := object(raw)
+			if e != nil {
+				return Projection{}, e
+			}
+			var r record
+			if e = required(fields, "spaceId", &r.SpaceID); e != nil {
+				return Projection{}, e
+			}
+			if e = required(fields, "objectId", &r.ObjectID); e != nil {
+				return Projection{}, e
+			}
+			if v := fields["blockId"]; v != nil && string(v) != "null" {
+				var block string
+				if e = json.Unmarshal(v, &block); e != nil {
+					return Projection{}, ErrMalformed
+				}
+				r.BlockID = &block
+			}
+			if e = required(fields, "item", &r.Item); e != nil {
+				return Projection{}, e
+			}
+			records = append(records, r)
+		}
+	default:
+		return Projection{}, fmt.Errorf("%w: %d", ErrUnsupported, version)
+	}
+	ids, identities := map[string]bool{}, map[string]bool{}
+	related := map[string]bool{}
+	for _, r := range records {
+		item, err := decodeItem(r.Item)
+		if err != nil {
+			return Projection{}, err
+		}
+		if exact(r.SpaceID, in.SpaceID) && exact(r.ObjectID, in.ObjectID) {
+			if r.BlockID != nil && *r.BlockID == "" {
+				result.RelatedError = ErrMalformed
+			}
+			canonical := item.CanonicalKey
+			if canonical == "" {
+				canonical = item.ExternalID
+			}
+			if item.Kind == Ref && !strings.HasPrefix(canonical, "anytype-note:") {
+				related[Identity(item.Kind, item.ProviderID, item.CanonicalKey, item.ExternalID)] = true
+			}
+		}
+		if !exact(r.SpaceID, in.SpaceID) || !exact(r.ObjectID, in.ObjectID) || r.BlockID != nil || item.Role != "context" || strings.HasPrefix(item.CanonicalKey, "anytype-note:") {
+			continue
+		}
+		identity := Identity(item.Kind, item.ProviderID, item.CanonicalKey, item.ExternalID)
+		id := norm.NFC.String(item.ID)
+		if ids[id] || identities[identity] {
+			continue
+		}
+		ids[id], identities[identity] = true, true
+		result.Labels[identity] = DisplayLabel{Hebrew: item.LabelHe, English: item.LabelEn}
+		switch item.Kind {
+		case Ref:
+			result.Sources = append(result.Sources, identity)
+		case Topic:
+			result.Topics = append(result.Topics, identity)
+		case Word:
+			result.Words = append(result.Words, identity)
+		}
+	}
+	sort.Strings(result.Sources)
+	sort.Strings(result.Topics)
+	sort.Strings(result.Words)
+	if result.RelatedError == nil {
+		for identity := range related {
+			result.RelatedSources = append(result.RelatedSources, identity)
+		}
+		sort.Strings(result.RelatedSources)
+	} else {
+		result.RelatedSources = nil
+	}
+	return result, nil
+}
+
+type record struct {
+	SpaceID  string
+	ObjectID string
+	BlockID  *string
+	Item     json.RawMessage
+}
+
+type item struct {
+	ID           string
+	Kind         Kind
+	Role         string
+	ProviderID   string
+	CanonicalKey string
+	ExternalID   string
+	LabelHe      string
+	LabelEn      string
+}
+
+func decodeItem(raw json.RawMessage) (item, error) {
+	fields, err := object(raw)
+	if err != nil {
+		return item{}, err
+	}
+	var value item
+	for _, f := range []struct {
+		name   string
+		target any
+	}{
+		{"id", &value.ID}, {"kind", &value.Kind}, {"role", &value.Role},
+		{"providerID", &value.ProviderID}, {"canonicalKey", &value.CanonicalKey},
+		{"externalID", &value.ExternalID}, {"labelHe", &value.LabelHe},
+	} {
+		if err := required(fields, f.name, f.target); err != nil {
+			return item{}, err
+		}
+	}
+	if value.Kind != Ref && value.Kind != Topic && value.Kind != Word {
+		return item{}, ErrMalformed
+	}
+	if value.Role == "source_quote" {
+		value.Role = "sourceQuote"
+	}
+	if value.Role != "context" && value.Role != "sourceQuote" {
+		return item{}, ErrMalformed
+	}
+	if value.ID == "" || value.ProviderID == "" || (value.CanonicalKey == "" && value.ExternalID == "") {
+		return item{}, ErrMalformed
+	}
+	// Validate the known optional fields as Swift's existing codec does. They
+	// never participate in identity, but invalid typed data must fail closed.
+	for _, key := range []string{"labelEn", "rawInput", "providerPayload"} {
+		if raw := fields[key]; raw != nil && string(raw) != "null" {
+			var text string
+			if json.Unmarshal(raw, &text) != nil {
+				return item{}, ErrMalformed
+			}
+			if key == "labelEn" {
+				value.LabelEn = text
+			}
+		}
+	}
+	for _, key := range []string{"createdAt", "updatedAt"} {
+		if raw := fields[key]; raw != nil && string(raw) != "null" {
+			var timestamp string
+			if json.Unmarshal(raw, &timestamp) != nil {
+				return item{}, ErrMalformed
+			}
+			if _, err := time.Parse(time.RFC3339Nano, timestamp); err != nil {
+				return item{}, ErrMalformed
+			}
+		}
+	}
+	if raw := fields["customMetadata"]; raw != nil && string(raw) != "null" {
+		var metadata map[string]json.RawMessage
+		if json.Unmarshal(raw, &metadata) != nil {
+			return item{}, ErrMalformed
+		}
+		for _, rawValue := range metadata {
+			var text string
+			if string(rawValue) == "null" || json.Unmarshal(rawValue, &text) != nil {
+				return item{}, ErrMalformed
+			}
+		}
+	}
+	return value, nil
+}
+
+func object(raw []byte) (map[string]json.RawMessage, error) {
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil || fields == nil {
+		return nil, ErrMalformed
+	}
+	return fields, nil
+}
+
+func required(fields map[string]json.RawMessage, key string, value any) error {
+	raw, exists := fields[key]
+	if !exists || string(raw) == "null" {
+		return ErrMalformed
+	}
+	if err := json.Unmarshal(raw, value); err != nil {
+		return ErrMalformed
+	}
+	return nil
+}
+
+func exact(a, b string) bool { return norm.NFC.String(a) == norm.NFC.String(b) }
diff --git a/core/pinkha/torah/properties.go b/core/pinkha/torah/properties.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha/torah/properties.go
@@ -0,0 +1,51 @@
+package torahderived
+
+const Version = 1
+const SourcesKey = "pinkhaTorahSources"
+const TopicsKey = "pinkhaTorahTopics"
+const WordsKey = "pinkhaTorahWords"
+const ReadyKey = "_pinkhaTorahReady"
+const LabelsKey = "_pinkhaTorahLabels"
+const VersionKey = "_pinkhaTorahProjectionVersion"
+const CanonicalHashKey = "_pinkhaTorahCanonicalHash"
+const StatusKey = "_pinkhaTorahState"
+const CanonicalKeyKey = "_pinkhaTorahCanonicalPropertyKey"
+const CacheIntegrityKey = "_pinkhaTorahCacheIntegrity"
+const AttachedPropertiesKey = "_pinkhaTorahAttachedProperties"
+const ManifestUniqueKey = "pinkha.space.manifest"
+const RelatedSourcesKey = "_pinkhaTorahRelatedSources"
+const RelatedVersionKey = "_pinkhaTorahRelatedVersion"
+const RelatedVersion = 1
+
+type PropertyDefinition struct {
+	Kind Kind
+	Key  string
+	Name string
+}
+
+var Definitions = []PropertyDefinition{
+	{Ref, SourcesKey, "מקור/ות"},
+	{Topic, TopicsKey, "נושא"},
+	{Word, WordsKey, "מילה / ערך"},
+}
+
+func IsProperty(key string) bool {
+	return key == SourcesKey || key == TopicsKey || key == WordsKey
+}
+
+func IsPrivateKey(key string) bool {
+	return IsLocalKey(key) && !IsProperty(key)
+}
+
+func LocalKeys() []string {
+	return []string{SourcesKey, TopicsKey, WordsKey, ReadyKey, LabelsKey, VersionKey, CanonicalHashKey, StatusKey, CanonicalKeyKey, CacheIntegrityKey, AttachedPropertiesKey, RelatedSourcesKey, RelatedVersionKey}
+}
+
+func IsLocalKey(key string) bool {
+	for _, candidate := range LocalKeys() {
+		if key == candidate {
+			return true
+		}
+	}
+	return false
+}
diff --git a/core/pinkha/torah/readiness.go b/core/pinkha/torah/readiness.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha/torah/readiness.go
@@ -0,0 +1,87 @@
+package torahderived
+
+import (
+	"errors"
+	"sync"
+)
+
+type State string
+
+const (
+	NotInitialized State = "NOT_INITIALIZED"
+	Discovering    State = "DISCOVERING"
+	Rebuilding     State = "REBUILDING"
+	Ready          State = "READY"
+	Outdated       State = "OUTDATED"
+	Error          State = "ERROR"
+	Unsupported    State = "UNSUPPORTED"
+)
+
+var ErrNotReady = errors.New("Space derived index is not ready")
+var ErrStaleGeneration = errors.New("stale rebuild generation")
+
+// Readiness is a guard for a caller-owned native index, not a second database.
+// A production integration must durably checkpoint its generation and recovery
+// status in the engine's own local store before using this guard.
+type Readiness struct {
+	mu       sync.RWMutex
+	spaces   map[string]readinessEntry
+	sequence uint64
+}
+
+type readinessEntry struct {
+	state State
+	epoch uint64
+}
+
+func (r *Readiness) Begin(space string) uint64 {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.spaces == nil {
+		r.spaces = map[string]readinessEntry{}
+	}
+	r.sequence++
+	r.spaces[space] = readinessEntry{state: Rebuilding, epoch: r.sequence}
+	return r.sequence
+}
+
+func (r *Readiness) Finish(space string, epoch uint64, success bool) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	entry, ok := r.spaces[space]
+	if !ok || entry.epoch != epoch || entry.state != Rebuilding {
+		return ErrStaleGeneration
+	}
+	entry.state = Error
+	if success {
+		entry.state = Ready
+	}
+	r.spaces[space] = entry
+	return nil
+}
+
+func (r *Readiness) Invalidate(space string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.spaces == nil {
+		r.spaces = map[string]readinessEntry{}
+	}
+	r.sequence++
+	r.spaces[space] = readinessEntry{state: Outdated, epoch: r.sequence}
+}
+
+func (r *Readiness) RequireReady(space string) error {
+	if r.Status(space) != Ready {
+		return ErrNotReady
+	}
+	return nil
+}
+
+func (r *Readiness) Status(space string) State {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	if entry, ok := r.spaces[space]; ok {
+		return entry.state
+	}
+	return NotInitialized
+}
diff --git a/core/pinkha/torah/related_binding_test.go b/core/pinkha/torah/related_binding_test.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha/torah/related_binding_test.go
@@ -0,0 +1,56 @@
+package torahderived
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"testing"
+)
+
+type relatedBindingSource struct{ candidates []ManifestCandidate }
+
+func (s relatedBindingSource) Manifests(context.Context, string) ([]ManifestCandidate, error) {
+	return s.candidates, nil
+}
+func (s relatedBindingSource) CanonicalProperty(context.Context, string, string) (PropertyDescriptor, error) {
+	return PropertyDescriptor{ID: "p", Key: "canonical", Format: 0}, nil
+}
+
+func TestRelatedBindingCarriesSelectedIdentityWithoutChangingPublicGeneration(t *testing.T) {
+	raw, _ := json.Marshal(map[string]any{
+		"schemaVersion": 1, "spaceId": "S", "manifestObjectId": "selected", "provisioningState": "complete",
+		"documentAssociationsPropertyId": "p", "documentAssociationsPropertyKey": "canonical",
+		"registeredDocumentTypes": map[string]string{"chiddush": "h", "article": "a", "research": "r"},
+		"defaultTemplateIds":      map[string]string{"chiddush": "th", "article": "ta", "research": "tr"},
+		"parentPropertyId":        "parent", "parentPropertyKey": "parentKey", "orderPropertyId": "o", "orderPropertyKey": "ok", "folderTypeId": "f", "bookFolderTypeId": "b",
+	})
+	source := relatedBindingSource{[]ManifestCandidate{{ObjectID: "selected", Raw: raw}}}
+	b, err := ResolveBinding(context.Background(), source, "S")
+	if err != nil || b.ManifestObjectID != "selected" || b.CanonicalKey != "canonical" {
+		t.Fatalf("selected binding lost: %#v %v", b, err)
+	}
+	h := sha256.New()
+	h.Write(raw)
+	fmt.Fprintf(h, "|%d:%s|%d:%s|%d", len("selected"), "selected", len("p"), "p", 0)
+	if b.Generation != hex.EncodeToString(h.Sum(nil)) {
+		t.Fatal("legacy public generation changed")
+	}
+	if err := (Binding{SpaceID: "S", CanonicalKey: "canonical", Generation: "legacy"}).Validate(); err != nil {
+		t.Fatal("old public Binding validation now requires private capability")
+	}
+	for _, candidates := range [][]ManifestCandidate{
+		{{ObjectID: "other", Raw: raw}},
+		{{ObjectID: "selected", Raw: raw}, {ObjectID: "selected", Raw: raw}},
+	} {
+		b, err = ResolveBinding(context.Background(), relatedBindingSource{candidates}, "S")
+		if err == nil || b.ManifestObjectID != "" {
+			t.Fatal("unvalidated/nonselected binding advertised manifest identity")
+		}
+	}
+	b, err = ResolveBinding(context.Background(), source, "foreign")
+	if err == nil || b.ManifestObjectID != "" {
+		t.Fatal("foreign manifest identity accepted")
+	}
+}
diff --git a/core/pinkha/torah/related_sources_test.go b/core/pinkha/torah/related_sources_test.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha/torah/related_sources_test.go
@@ -0,0 +1,162 @@
+package torahderived
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func relatedInput(raw string) (Binding, Input) {
+	b := Binding{SpaceID: "S", CanonicalKey: "canonical", Generation: "g"}
+	return b, Input{SpaceID: "S", ObjectID: "A", TypeID: "page", IsDocument: true, Raw: []byte(raw)}
+}
+
+func relatedRecord(id, block, role, provider, canonical string) map[string]any {
+	r := map[string]any{"spaceId": "S", "objectId": "A", "item": map[string]any{
+		"id": id, "kind": "ref", "role": role, "providerID": provider,
+		"canonicalKey": canonical, "externalID": canonical, "labelHe": "source",
+	}}
+	if block != "" {
+		r["blockId"] = block
+	}
+	return r
+}
+
+func relatedProject(t *testing.T, records ...map[string]any) Projection {
+	t.Helper()
+	raw, err := json.Marshal(map[string]any{"version": 2, "records": records})
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := bytes.Clone(raw)
+	b, in := relatedInput(string(raw))
+	p, err := Project(b, in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(raw, before) {
+		t.Fatal("canonical bytes changed")
+	}
+	return p
+}
+
+func TestRelatedUnionIndependentOfPublicLocationRoleAndIDDedup(t *testing.T) {
+	p := relatedProject(t,
+		relatedRecord("same-id", "K", "context", "sefaria", "Genesis 3:3"),
+		relatedRecord("same-id", "Q", "sourceQuote", "sefaria", "Genesis 3:4"),
+		relatedRecord("legacy", "Q", "source_quote", "sefaria", "Genesis 3:4"),
+		relatedRecord("doc-quote", "", "sourceQuote", "sefaria", "Genesis 3:5"),
+		relatedRecord("doc-context", "", "context", "sefaria", "Genesis 3:6"))
+	want := []string{}
+	for _, ref := range []string{"Genesis 3:3", "Genesis 3:4", "Genesis 3:5", "Genesis 3:6"} {
+		want = append(want, Identity(Ref, "sefaria", ref, ""))
+	}
+	if p.RelatedError != nil || !reflect.DeepEqual(p.RelatedSources, want) {
+		t.Fatalf("private union: %#v", p)
+	}
+	if !reflect.DeepEqual(p.Sources, want[3:]) || len(p.Labels) != 1 {
+		t.Fatalf("public semantics widened: %#v", p)
+	}
+}
+
+func TestRelatedExactIdentityAndForeignInternalExclusion(t *testing.T) {
+	foreign := relatedRecord("foreign", "K", "context", "sefaria", "foreign")
+	foreign["spaceId"] = "S2"
+	otherObject := relatedRecord("object", "K", "context", "sefaria", "other-object")
+	otherObject["objectId"] = "B"
+	fallback := relatedRecord("fallback", "K", "context", "sefaria", "")
+	fallback["item"].(map[string]any)["externalID"] = "Genesis 3:3"
+	internal := relatedRecord("internal", "K", "context", "sefaria", "")
+	internal["item"].(map[string]any)["externalID"] = "anytype-note:note-id"
+	topic := relatedRecord("topic", "K", "context", "sefaria", "topic")
+	topic["item"].(map[string]any)["kind"] = "topic"
+	p := relatedProject(t, foreign, otherObject, fallback, internal, topic,
+		relatedRecord("alias-a", "K", "context", "e\u0301", "Genesis 3:3"),
+		relatedRecord("alias-b", "K", "sourceQuote", "é", "Genesis 3:3"))
+	if len(p.RelatedSources) != 2 {
+		t.Fatalf("foreign/internal/kind/alias mismatch: %v", p.RelatedSources)
+	}
+	for _, id := range p.RelatedSources {
+		if strings.Contains(id, "anytype-note:") || strings.Contains(id, "foreign") {
+			t.Fatal(id)
+		}
+	}
+}
+
+func TestRelatedInvalidTargetWithholdsOnlyPrivateProjection(t *testing.T) {
+	invalid := relatedRecord("invalid", "K", "sourceQuote", "sefaria", "Genesis 3:3")
+	invalid["blockId"] = ""
+	p := relatedProject(t, relatedRecord("valid", "", "context", "sefaria", "Genesis 3:3"), invalid)
+	if !errors.Is(p.RelatedError, ErrMalformed) || p.RelatedSources != nil {
+		t.Fatalf("private target did not fail closed: %#v", p)
+	}
+	if len(p.Sources) != 1 || len(p.Labels) != 1 {
+		t.Fatalf("valid public projection was disabled: %#v", p)
+	}
+}
+
+func TestRelatedMalformedFutureAndEmptyPayload(t *testing.T) {
+	for _, raw := range []string{`{"version":999}`, `{"version":2,"records":[{}]}`, `{"version":2,"records":null}`, `invalid`} {
+		b, in := relatedInput(raw)
+		p, err := Project(b, in)
+		if err == nil || !reflect.DeepEqual(p, Projection{}) {
+			t.Fatalf("valid-looking malformed private projection: %q %#v %v", raw, p, err)
+		}
+	}
+	b, in := relatedInput("")
+	p, err := Project(b, in)
+	if err != nil || p.RelatedError != nil || len(p.RelatedSources) != 0 {
+		t.Fatalf("eligible empty: %#v %v", p, err)
+	}
+}
+
+func TestRelatedKeysRemainPrivateAndPublicVersionUnchanged(t *testing.T) {
+	if Version != 1 || RelatedVersion != 1 || len(Definitions) != 3 {
+		t.Fatal("public schema/version changed")
+	}
+	for _, key := range []string{RelatedSourcesKey, RelatedVersionKey} {
+		if IsProperty(key) || !IsLocalKey(key) || !IsPrivateKey(key) {
+			t.Fatalf("private key leaked into Properties: %s", key)
+		}
+	}
+	if IsPrivateKey(SourcesKey) || IsPrivateKey("ordinaryUserProperty") {
+		t.Fatal("private guard changed public/user Property classification")
+	}
+}
+
+func TestRelatedPreservesExistingSwiftPublicGoldenFixtures(t *testing.T) {
+	data, err := os.ReadFile("../../PinkhaKit/Tests/PinkhaKitTests/Torah/Fixtures/derived-query-golden.json")
+	if os.IsNotExist(err) {
+		data, err = os.ReadFile("testdata/derived-query-golden.json")
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixtures []struct {
+		Name, Space, Object, Raw, Error string
+		Expected                        *Projection
+	}
+	if err := json.Unmarshal(data, &fixtures); err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range fixtures {
+		t.Run(f.Name, func(t *testing.T) {
+			p, err := Project(Binding{SpaceID: "test-space", CanonicalKey: "key", Generation: "g"}, Input{
+				SpaceID: f.Space, ObjectID: f.Object, TypeID: "page", IsDocument: true, Raw: []byte(f.Raw),
+			})
+			if f.Error != "" {
+				if err == nil || !reflect.DeepEqual(p, Projection{}) {
+					t.Fatal("malformed golden became valid")
+				}
+				return
+			}
+			if err != nil || !reflect.DeepEqual(p.Sources, f.Expected.Sources) || !reflect.DeepEqual(p.Topics, f.Expected.Topics) || !reflect.DeepEqual(p.Words, f.Expected.Words) {
+				t.Fatalf("public golden changed: %#v %v", p, err)
+			}
+		})
+	}
+}
