+package torahops
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"path/filepath"
+	"testing"
+
+	anystore "github.com/anyproto/any-store"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/commonspace/object/acl/recordverifier"
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/synctree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treestorage"
+	"github.com/anyproto/any-sync/commonspace/spacestorage"
+	"github.com/anyproto/any-sync/net/peer"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNativeRemoteFetchKeepsSingleCommitGuard(t *testing.T) {
+	f, op := nativeFixtureWithPopulatedProjection(t)
+	ctx := context.Background()
+	db, err := anystore.Open(ctx, filepath.Join(t.TempDir(), "receiver-space.db"), &anystore.Config{ReadConnections: 1})
+	require.NoError(t, err)
+	var tree synctree.SyncTree
+	var projection anystore.DB
+	t.Cleanup(func() {
+		if tree != nil {
+			require.NoError(t, tree.Close())
+		}
+		if projection != nil {
+			require.NoError(t, projection.Close())
+		}
+		require.NoError(t, db.Close())
+	})
+	receiver, err := spacestorage.Create(ctx, db, f.config.Space)
+	require.NoError(t, err)
+	for _, target := range f.config.TargetRoots {
+		_, err = receiver.CreateTreeStorage(ctx, treestorage.TreeStorageCreatePayload{
+			RootRawChange: target, Heads: []string{target.Id},
+		})
+		require.NoError(t, err)
+	}
+	aclStorage, err := receiver.AclStorage()
+	require.NoError(t, err)
+	acl, err := list.BuildAclListWithIdentity(f.keys, aclStorage, recordverifier.NewValidateFull())
+	require.NoError(t, err)
+	client := &fixtureSyncClient{
+		RequestFactory: synctree.NewRequestFactory(receiver.Id()),
+		address:        f.listener.Addr().String(), spaceID: receiver.Id(), stats: &protocolStats{},
+	}
+	var fetchedStorage objecttree.Storage
+	validate := NativeTreeValidator(receiver.Id())
+	deps := synctree.BuildDeps{
+		SpaceId: receiver.Id(), SyncClient: client, AclList: acl, SpaceStorage: receiver,
+		OnClose: func(string) {}, SyncStatus: fixtureStatus{}, BuildObjectTree: NativeTreeBuilder(receiver.Id()),
+		ValidateObjectTree: func(payload treestorage.TreeStorageCreatePayload, creator objecttree.TreeStorageCreator, currentACL list.AclList) (objecttree.ObjectTree, error) {
+			validated, validateErr := validate(payload, creator, currentACL)
+			if validateErr == nil {
+				fetchedStorage = validated.Storage()
+			}
+			return validated, validateErr
+		},
+	}
+	tree, err = synctree.BuildSyncTreeOrGetRemote(peer.CtxWithPeerId(ctx, "loopback-fixture-peer"), f.tree.Id(), deps)
+	require.NoError(t, err)
+	require.NotNil(t, fetchedStorage)
+	require.Positive(t, client.stats.Requests.Load())
+	require.Positive(t, client.stats.Responses.Load())
+	require.Positive(t, client.stats.Bytes.Load())
+	tree.Lock()
+	_, directErr := tree.AddContent(ctx, objecttree.SignableChangeContent{
+		Key: f.keys.SignKey, ShouldBeEncrypted: true, Data: []byte("unguarded fetched-tree append"),
+	})
+	tree.Unlock()
+	require.ErrorIs(t, directErr, ErrNativeCommitGuard)
+	projection, err = anystore.Open(ctx, filepath.Join(t.TempDir(), "receiver-projection.db"), &anystore.Config{ReadConnections: 1})
+	require.NoError(t, err)
+	targets := &nativeFixture{config: f.config, space: receiver}
+	host, err := OpenNativeHost(ctx, projection, receiver.Id(), tree, f.keys.SignKey, targets.acquireTarget)
+	require.NoError(t, err)
+	before, err := host.ReadTarget(ctx, op.Target, 10)
+	require.NoError(t, err)
+	require.Len(t, before.Projection.Live, 1)
+	op.OperationID = fmt.Sprintf("%032x", 2)
+	created, err := host.Append(ctx, op)
+	require.NoError(t, err)
+	require.Same(t, fetchedStorage, tree.Storage())
+	require.Equal(t, Created, created.Disposition)
+	require.NotEmpty(t, created.ChangeID)
+	stored, err := tree.Storage().Has(ctx, created.ChangeID)
+	require.NoError(t, err)
+	require.True(t, stored)
+	after, err := host.ReadTarget(ctx, op.Target, 10)
+	require.NoError(t, err)
+	require.Len(t, after.Projection.Live, 2)
+	retry, err := host.Append(ctx, op)
+	require.NoError(t, err)
+	require.Equal(t, AlreadyExistsSamePayload, retry.Disposition)
+	require.Empty(t, retry.ChangeID)
+	afterRetry, err := host.ReadTarget(ctx, op.Target, 10)
+	require.NoError(t, err)
+	require.Equal(t, after, afterRetry)
+}
+
+func TestNativeRebuiltStorageRejectsForeignBinding(t *testing.T) {
+	for _, name := range []string{"different ACL instance", "different root header", "nested guard"} {
+		t.Run(name, func(t *testing.T) {
+			f, op := nativeFixtureWithPopulatedProjection(t)
+			ctx := context.Background()
+			before, err := f.host.ReadTarget(ctx, op.Target, 10)
+			require.NoError(t, err)
+			storage, err := boundNativeCommitStorage(f.tree)
+			require.NoError(t, err)
+			candidate := *storage
+			acl := f.acl
+			switch name {
+			case "different ACL instance":
+				aclStorage, err := f.space.AclStorage()
+				require.NoError(t, err)
+				acl, err = list.BuildAclListWithIdentity(f.keys, aclStorage, recordverifier.NewValidateFull())
+				require.NoError(t, err)
+				require.NotSame(t, f.acl, acl)
+			case "different root header":
+				header := *storage.header
+				header.RawChange = append(bytes.Clone(header.RawChange), 0)
+				candidate.header = &header
+			case "nested guard":
+				candidate.Storage = storage
+			}
+			tree, err := NativeTreeBuilder(f.space.Id())(&candidate, acl)
+			require.ErrorIs(t, err, ErrNativeCommitGuard)
+			require.Nil(t, tree)
+			after, err := f.host.ReadTarget(ctx, op.Target, 10)
+			require.NoError(t, err)
+			require.Equal(t, before, after)
+		})
+	}
+}
diff --git a/core/block/editor/torahops/native_target_lease_test.go b/core/block/editor/torahops/native_target_lease_test.go
new file mode 100644
--- /dev/null
+++ b/core/block/editor/torahops/native_target_lease_test.go
@@ -0,0 +1,115 @@
+package torahops
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/stretchr/testify/require"
+)
+
+func nativeMutexAvailable(mu *sync.Mutex) bool {
+	if !mu.TryLock() {
+		return false
+	}
+	mu.Unlock()
+	return true
+}
+
+func TestNativeTargetLeaseCoversDurableCommitAndReleasesBeforeHeadUpdate(t *testing.T) {
+	f, op := nativeFixtureWithPopulatedProjection(t)
+	var settings, target sync.Mutex
+	acquired, released := 0, 0
+	leaser := func(ctx context.Context, current Target) (func(), error) {
+		if err := f.validateTarget(ctx, current); err != nil {
+			return nil, err
+		}
+		// Acquiring settings/target from beneath the private tree would reverse
+		// the native deletion order. Make that inversion observable here.
+		privateAvailable := f.tree.TryLock()
+		if privateAvailable {
+			f.tree.Unlock()
+		}
+		require.True(t, privateAvailable)
+		settings.Lock()
+		target.Lock()
+		acquired++
+		return func() { released++; target.Unlock(); settings.Unlock() }, nil
+	}
+	host, err := OpenNativeHost(context.Background(), f.projectionDB, f.space.Id(), f.tree, f.keys.SignKey, leaser)
+	require.NoError(t, err)
+	storage, err := boundNativeCommitStorage(f.tree)
+	require.NoError(t, err)
+	originalStorage, originalFactory := storage.Storage, f.client.RequestFactory
+	t.Cleanup(func() { storage.Storage, f.client.RequestFactory = originalStorage, originalFactory })
+	checkHeld := func() {
+		require.False(t, nativeMutexAvailable(&settings))
+		require.False(t, nativeMutexAvailable(&target))
+		require.Zero(t, released)
+	}
+	storage.Storage = &nativeCommitStorageObserver{Storage: originalStorage, before: checkHeld, after: checkHeld}
+	postCommit := errors.New("head update failed after target lease released")
+	f.client.RequestFactory = &nativeFailingHeadUpdate{RequestFactory: originalFactory, failure: postCommit, observe: func() {
+		require.Equal(t, 1, acquired)
+		require.Equal(t, 1, released)
+		require.True(t, nativeMutexAvailable(&settings))
+		require.True(t, nativeMutexAvailable(&target))
+		require.True(t, nativeACLWriteLockAvailable(t, f.acl))
+	}}
+	op.OperationID = fmt.Sprintf("%032x", 2)
+	result, err := host.Append(context.Background(), op)
+	require.ErrorIs(t, err, postCommit)
+	require.Equal(t, Created, result.Disposition)
+	require.NotEmpty(t, result.ChangeID)
+	require.Equal(t, 1, released, "outer defers must not release the same lease twice")
+	stored, err := f.tree.Storage().Has(context.Background(), result.ChangeID)
+	require.NoError(t, err)
+	require.True(t, stored)
+	storage.Storage, f.client.RequestFactory = originalStorage, originalFactory
+	retry, err := host.Append(context.Background(), op)
+	require.NoError(t, err)
+	require.Equal(t, AlreadyExistsSamePayload, retry.Disposition)
+	require.Equal(t, 2, acquired)
+	require.Equal(t, 2, released)
+	op.Payload = []byte("collision must preserve the signed operation")
+	collision, err := host.Append(context.Background(), op)
+	require.NoError(t, err)
+	require.Equal(t, CollisionDifferentPayload, collision.Disposition)
+	require.Equal(t, 3, acquired)
+	require.Equal(t, 3, released)
+}
+
+func TestNativeTargetLeaseReleasesOnCancelledPreparedAppend(t *testing.T) {
+	f, op := nativeFixtureWithPopulatedProjection(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var settings, target sync.Mutex
+	released := 0
+	leaser := func(context.Context, Target) (func(), error) {
+		settings.Lock()
+		target.Lock()
+		return func() { released++; target.Unlock(); settings.Unlock() }, nil
+	}
+	var prepared string
+	wrapped := &nativePreparedBoundaryTree{SyncTree: f.tree, afterPrepared: func(change objecttree.StorageChange) error {
+		prepared = change.Id
+		cancel()
+		return nil
+	}}
+	host, err := OpenNativeHost(context.Background(), f.projectionDB, f.space.Id(), wrapped, f.keys.SignKey, leaser)
+	require.NoError(t, err)
+	op.OperationID = fmt.Sprintf("%032x", 2)
+	result, err := host.Append(ctx, op)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Equal(t, NativeAppendResult{}, result)
+	require.NotEmpty(t, prepared)
+	stored, err := f.tree.Storage().Has(context.Background(), prepared)
+	require.NoError(t, err)
+	require.False(t, stored)
+	require.Equal(t, 1, released)
+	require.True(t, nativeMutexAvailable(&settings))
+	require.True(t, nativeMutexAvailable(&target))
+}
