+	// Targets are already materialized in this explicitly bounded test adapter.
+	return s.Do(id, fn)
+}
+func (s *privateFactorySpace) Do(id string, fn func(smartblock.SmartBlock) error) error {
+	target := s.targets[id]
+	if target == nil {
+		return torahopsobject.ErrTargetUnavailable
+	}
+	target.Lock()
+	defer target.Unlock()
+	return fn(target)
+}
