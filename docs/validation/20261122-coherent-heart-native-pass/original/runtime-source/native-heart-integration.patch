diff --git a/pkg/lib/pinkha/torahopscontract/root.go b/pkg/lib/pinkha/torahopscontract/root.go
new file mode 100644
--- /dev/null
+++ b/pkg/lib/pinkha/torahopscontract/root.go
@@ -0,0 +1,73 @@
+// Package torahopscontract owns the private, versioned native host identity.
+// It has no application, projection, indexing or RPC dependencies.
+package torahopscontract
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/anyproto/any-sync/commonspace/object/tree/objecttree"
+	"github.com/anyproto/any-sync/commonspace/object/tree/treechangeproto"
+)
+
+const (
+	ChangeType       = "pinkha.torah.operations.v1"
+	Payload          = "store-change/immutable-claims-v1"
+	UniqueKeyPrefix  = "pinkhaTorahOps"
+	UniqueKeyVersion = "v1"
+)
+
+var ErrPrivateRoot = errors.New("invalid private Torah operations root")
+var ErrPrivateOperation = errors.New("private Torah operations host does not support generic object operations")
+
+// Root preserves the exact native identity exercised by the two-process proof.
+// This is one root per Space, with no parent object, account-signature variant,
+// random seed or dependency on T5's manifest.
+func Root(spaceID string) (*treechangeproto.RawTreeChangeWithId, error) {
+	if len(spaceID) == 0 || len(spaceID) > 1024 || !utf8.ValidString(spaceID) || strings.ContainsRune(spaceID, 0) {
+		return nil, ErrPrivateRoot
+	}
+	return objecttree.DeriveObjectTreeRoot(objecttree.ObjectTreeDerivePayload{
+		SpaceId: spaceID, ChangeType: ChangeType, ChangePayload: []byte(Payload), IsEncrypted: true,
+	}, nil)
+}
+
+// ValidateRoot requires the receiving Space as an independent input. Matching
+// only an enum or a root's self-declared Space would permit a foreign binding.
+func ValidateRoot(spaceID string, raw *treechangeproto.RawTreeChangeWithId) error {
+	expected, err := Root(spaceID)
+	if err != nil || raw == nil || raw.Id != expected.Id || !bytes.Equal(raw.RawChange, expected.RawChange) {
+		return errors.Join(ErrPrivateRoot, err)
+	}
+	return nil
+}
+
+// ValidateRootChange checks every decoded root field against the canonical
+// derived root. It does not replace ValidateRoot's CID/receiving-Space binding.
+func ValidateRootChange(root *treechangeproto.RootChange) error {
+	if root == nil || root.ChangeType != ChangeType {
+		return ErrPrivateRoot
+	}
+	expected, err := Root(root.SpaceId)
+	if err != nil {
+		return err
+	}
+	decoded, err := objecttree.UnmarshallRoot(expected)
+	if err != nil {
+		return err
+	}
+	actualBytes, err := root.MarshalVT()
+	if err != nil {
+		return err
+	}
+	expectedBytes, err := decoded.MarshalVT()
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(actualBytes, expectedBytes) {
+		return ErrPrivateRoot
+	}
+	return nil
+}
diff --git a/pkg/lib/pinkha/torahopscontract/root_creation.go b/pkg/lib/pinkha/torahopscontract/root_creation.go
new file mode 100644
--- /dev/null
+++ b/pkg/lib/pinkha/torahopscontract/root_creation.go
@@ -0,0 +1,36 @@
+package torahopscontract
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+type rootCreationKey struct{}
+type rootCreationGuard struct {
+	spaceID string
+	rootID  string
+	used    atomic.Bool
+	commit  func(func() error) error
+}
+
+// WithRootCreationGuard carries one account-scoped local installation authority.
+// No caller RPC field is used as a permit. Its callback owns current account,
+// target lease, and ACL checks immediately around the native storage operation.
+func WithRootCreationGuard(ctx context.Context, spaceID, rootID string, commit func(func() error) error) context.Context {
+	return context.WithValue(ctx, rootCreationKey{}, &rootCreationGuard{spaceID: spaceID, rootID: rootID, commit: commit})
+}
+
+func CreateRootWithGuard(ctx context.Context, spaceID, rootID string, create func() error) error {
+	if ctx == nil {
+		return ErrPrivateOperation
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	guard, _ := ctx.Value(rootCreationKey{}).(*rootCreationGuard)
+	if guard == nil || guard.spaceID != spaceID || guard.rootID != rootID || guard.commit == nil || create == nil ||
+		!guard.used.CompareAndSwap(false, true) {
+		return ErrPrivateOperation
+	}
+	return guard.commit(create)
+}
diff --git a/pkg/lib/pinkha/torahopscontract/root_creation_test.go b/pkg/lib/pinkha/torahopscontract/root_creation_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/lib/pinkha/torahopscontract/root_creation_test.go
@@ -0,0 +1,56 @@
+package torahopscontract
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestPinkhaRootCreationGuardRejectsMissingForeignUsedAndCancelled(t *testing.T) {
+	for _, scenario := range []string{"missing", "foreign_space", "foreign_root", "cancelled", "reused", "denied_at_storage_boundary"} {
+		t.Run(scenario, func(t *testing.T) {
+			calls, checks := 0, 0
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			denied := errors.New("authority changed before native root transaction")
+			guarded := WithRootCreationGuard(ctx, "space", "root", func(create func() error) error {
+				checks++
+				if scenario == "denied_at_storage_boundary" {
+					return denied
+				}
+				return create()
+			})
+			create := func() error { calls++; return nil }
+			space, root := "space", "root"
+			want := ErrPrivateOperation
+			switch scenario {
+			case "missing":
+				guarded = ctx
+			case "foreign_space":
+				space = "other"
+			case "foreign_root":
+				root = "other"
+			case "cancelled":
+				cancel()
+				want = context.Canceled
+			case "reused":
+				require.NoError(t, CreateRootWithGuard(guarded, space, root, create))
+			case "denied_at_storage_boundary":
+				want = denied
+			}
+			err := CreateRootWithGuard(guarded, space, root, create)
+			require.ErrorIs(t, err, want)
+			if scenario == "reused" {
+				require.Equal(t, 1, calls)
+				require.Equal(t, 1, checks)
+			} else {
+				require.Zero(t, calls, "rejected authority must not invoke native storage")
+				if scenario != "denied_at_storage_boundary" {
+					require.Zero(t, checks)
+				}
+			}
+		})
+	}
+}
