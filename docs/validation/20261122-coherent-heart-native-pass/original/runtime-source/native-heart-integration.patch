+func (g *pinkhaExportGetter) TryRemoveFromCache(ctx context.Context, id string) (bool, error) {
+	g.removeCalls++
+	g.lastContext, g.lastObjectID = ctx, id
+	return g.removeResult, g.removeErr
+}
