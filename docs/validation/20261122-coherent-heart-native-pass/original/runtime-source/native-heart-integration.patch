+package torahops
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestCanonicalEncodingGoldenVector(t *testing.T) {
+	// Independently calculated using Python struct.pack('>I', length) and SHA-256.
+	op := add(1, "א<>&\n")
+	id, wire, err := EncodeClaim(op)
+	require.NoError(t, err)
+	require.Equal(t, "89344c7ac74f7d5df8ef2a94f9592a7ed86a9dccc47084f8ce27d98080c29263/3652b732b88752a35184fcf1af80f8d3e499fb5e5e4132a8064e6236a54cd589", id)
+	canonical, err := op.CanonicalBytes()
+	require.NoError(t, err)
+	require.Len(t, canonical, 188)
+	claim, err := DecodeClaim(id, wire)
+	require.NoError(t, err)
+	require.Equal(t, []byte("א<>&\n"), claim.Operation.Payload)
+	op.Payload = []byte("א<>&")
+	require.NotEqual(t, id, claimID(t, op), "payload bytes are not trimmed or normalized")
+}
+
+func TestObservedSetCanonicalizationAndInputOwnership(t *testing.T) {
+	a, b := claimID(t, add(1, "A")), claimID(t, add(2, "B"))
+	op := add(3, "replacement")
+	op.Kind, op.Observed = Replace, []string{b, a, b}
+	id, wire, err := EncodeClaim(op)
+	require.NoError(t, err)
+	op.Observed = []string{a, b}
+	id2, wire2, err := EncodeClaim(op)
+	require.NoError(t, err)
+	require.Equal(t, id, id2)
+	require.Equal(t, wire, wire2)
+	claim, _, err := makeClaim(op)
+	require.NoError(t, err)
+	op.Payload[0] = 'X'
+	op.Observed[0] = "mutated"
+	require.Equal(t, "replacement", string(claim.Operation.Payload))
+	require.NotContains(t, claim.Operation.Observed, "mutated")
+}
+
+func TestEnvelopeBoundsAndVersionFailClosed(t *testing.T) {
+	cases := map[string]func(*Operation){
+		"future":              func(op *Operation) { op.Version = 2 },
+		"unknown-kind":        func(op *Operation) { op.Kind = "update" },
+		"empty-id":            func(op *Operation) { op.OperationID = "" },
+		"noncanonical-id":     func(op *Operation) { op.OperationID = strings.Repeat("A", 32) },
+		"payload-limit":       func(op *Operation) { op.Payload = bytes.Repeat([]byte{1}, MaxPayloadBytes+1) },
+		"invalid-utf8":        func(op *Operation) { op.Target.ObjectID = string([]byte{0xff}) },
+		"nul-space":           func(op *Operation) { op.SpaceID = "space\x00other" },
+		"empty-add":           func(op *Operation) { op.Payload = nil },
+		"invalid-observed":    func(op *Operation) { op.Kind = Replace; op.Observed = []string{"not-a-claim"} },
+		"remove-with-payload": func(op *Operation) { op.Kind = Remove; op.Observed = []string{claimID(t, add(2, "old"))} },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			op := add(1, "value")
+			mutate(&op)
+			_, _, err := EncodeClaim(op)
+			require.Error(t, err)
+		})
+	}
+	op := add(1, "")
+	op.Payload = bytes.Repeat([]byte{0xff}, MaxPayloadBytes)
+	id, wire, err := EncodeClaim(op)
+	require.NoError(t, err, "opaque payload bytes need not be UTF-8")
+	_, err = DecodeClaim(id, wire)
+	require.NoError(t, err)
+}
+
+func TestRemoveBeforeObservedClaimAndNoTombstoneErasure(t *testing.T) {
+	fx := openFixture(t, "")
+	old := add(1, "old")
+	remove := add(2, "")
+	remove.Kind, remove.Source, remove.Observed = Remove, Source{}, []string{claimID(t, old)}
+	require.NoError(t, fx.store.Replay(testContext, remove, native("remove-first")))
+	require.Equal(t, []string{claimID(t, old)}, projection(t, fx).PendingObserved)
+	require.NoError(t, fx.store.Replay(testContext, old, native("old-later")))
+	require.Empty(t, projection(t, fx).Live)
+	removeTombstone := add(3, "")
+	removeTombstone.Kind, removeTombstone.Source, removeTombstone.Observed = Remove, Source{}, []string{claimID(t, remove)}
+	require.NoError(t, fx.store.Replay(testContext, removeTombstone, native("remove-tombstone")))
+	require.Empty(t, projection(t, fx).Live, "referencing a tombstone must never resurrect old content")
+	counts(t, fx, 3, 3)
+	fx.reopen(t)
+	require.Empty(t, projection(t, fx).Live)
+}
diff --git a/core/block/editor/torahops/projection.go b/core/block/editor/torahops/projection.go
new file mode 100644
--- /dev/null
+++ b/core/block/editor/torahops/projection.go
@@ -0,0 +1,89 @@
+package torahops
+
+import (
+	"context"
+	"errors"
+	"sort"
+)
+
+type Projection struct {
+	Live            []Claim
+	Conflicts       []Resolution
+	PendingObserved []string
+}
+
+// ReadTarget folds a bounded, consistent native SQLite snapshot. There is no
+// pagination/watermark RPC yet: exceeding the bound is an explicit error, never a
+// truncated success. Conflicted logical operations have NO projection effect;
+// their complete variant set is returned separately and no winner is selected.
+// Removes and replacements suppress only explicitly observed physical claims.
+// Tombstones are never erased, including when another operation references one.
+func (s *Store) ReadTarget(ctx context.Context, target Target, limit uint) (projection Projection, err error) {
+	if !validText(target.ObjectID, true, 1024) || !validText(target.BlockID, false, 1024) || limit == 0 || limit > 10000 {
+		return Projection{}, ErrInvalid
+	}
+	tx, err := s.claims.ReadTx(ctx)
+	if err != nil {
+		return Projection{}, err
+	}
+	defer func() { err = errors.Join(err, tx.Commit()) }()
+	ctx = tx.Context()
+	candidates, err := readClaims(ctx, s.claims.Find(map[string]any{
+		"operation.target.objectId": target.ObjectID,
+		"operation.target.blockId":  target.BlockID,
+	}), limit)
+	if err != nil {
+		return Projection{}, err
+	}
+	seen := map[string]bool{}
+	claims := map[string]Claim{}
+	for _, candidate := range candidates {
+		opID := candidate.Operation.OperationID
+		if seen[opID] {
+			continue
+		}
+		seen[opID] = true
+		// A conflicting variant may name a different target. The target index
+		// must not hide that variant and accidentally turn the first into a winner.
+		resolution, readErr := s.ReadOperation(ctx, opID)
+		if readErr != nil {
+			return Projection{}, readErr
+		}
+		if resolution.Conflict {
+			projection.Conflicts = append(projection.Conflicts, resolution)
+			continue
+		}
+		claims[candidate.ID] = candidate
+	}
+	removed := map[string]bool{}
+	pending := map[string]bool{}
+	for _, claim := range claims {
+		for _, observed := range claim.Operation.Observed {
+			if observedClaim, ok := claims[observed]; ok && observedClaim.Operation.Target == target {
+				removed[observed] = true
+			} else {
+				pending[observed] = true
+			}
+		}
+	}
+	for _, claim := range claims {
+		if claim.Operation.Kind != Remove && !removed[claim.ID] {
+			projection.Live = append(projection.Live, claim)
+		}
+	}
+	for id := range pending {
+		projection.PendingObserved = append(projection.PendingObserved, id)
+	}
+	// This is the bytewise display tie-break, not a native causal clock. Claim
+	// identity starts with a hash and does not preserve OperationID order.
+	sort.Slice(projection.Live, func(i, j int) bool {
+		left, right := projection.Live[i], projection.Live[j]
+		if left.Operation.OperationID != right.Operation.OperationID {
+			return left.Operation.OperationID < right.Operation.OperationID
+		}
+		return left.ID < right.ID
+	})
+	sort.Slice(projection.Conflicts, func(i, j int) bool { return projection.Conflicts[i].OperationID < projection.Conflicts[j].OperationID })
+	sort.Strings(projection.PendingObserved)
+	return projection, nil
+}
diff --git a/core/block/editor/torahops/projection_order_test.go b/core/block/editor/torahops/projection_order_test.go
new file mode 100644
--- /dev/null
+++ b/core/block/editor/torahops/projection_order_test.go
@@ -0,0 +1,132 @@
+package torahops
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// These are disk-backed StoreState regressions using the existing component
+// fixture. Explicit Replay is not evidence of two syncing Native clients, and
+// OperationID order is not evidence of signed-event causal ordering.
+func projectionOrderClaims(t *testing.T, operations ...Operation) []Claim {
+	t.Helper()
+	claims := make([]Claim, 0, len(operations))
+	for _, operation := range operations {
+		claim, _, err := makeClaim(operation)
+		require.NoError(t, err)
+		claims = append(claims, claim)
+	}
+	return claims
+}
+
+func replayProjectionOrder(t *testing.T, fx *fixture, operations []Operation, order []int) {
+	t.Helper()
+	for _, index := range order {
+		require.NoError(t, fx.store.Replay(testContext, operations[index], native(fmt.Sprintf("display-order-%02d", index))))
+	}
+}
+
+type projectionOrderEvidence struct {
+	Operations map[string]Resolution
+	Receipts   map[string][]Receipt
+}
+
+func readProjectionOrderEvidence(t *testing.T, fx *fixture, operations []Operation) projectionOrderEvidence {
+	t.Helper()
+	evidence := projectionOrderEvidence{Operations: map[string]Resolution{}, Receipts: map[string][]Receipt{}}
+	for index, operation := range operations {
+		claim := projectionOrderClaims(t, operation)[0]
+		resolution, err := fx.store.ReadOperation(testContext, operation.OperationID)
+		require.NoError(t, err)
+		require.Contains(t, resolution.Claims, claim, "canonical identity and complete content must remain readable")
+		evidence.Operations[operation.OperationID] = resolution
+		receipts, err := fx.store.Receipts(testContext, claim.ID)
+		require.NoError(t, err)
+		require.Len(t, receipts, 1)
+		require.Equal(t, claim.ID, receipts[0].ClaimID)
+		require.Equal(t, fmt.Sprintf("display-order-%02d", index), receipts[0].ChangeID)
+		require.Equal(t, operation.AuthorID, receipts[0].Creator)
+		require.Equal(t, "verified-native-acl-head", receipts[0].ACLHeadID)
+		evidence.Receipts[claim.ID] = receipts
+	}
+	return evidence
+}
+
+func TestLiveOperationIDOrderAcrossReplayAndDiskReopen(t *testing.T) {
+	operations := []Operation{add(1, "first operation bytes"), add(2, "second operation bytes"), add(3, "third operation bytes")}
+	expected := projectionOrderClaims(t, operations...)
+	// This fixed Space/ID pair reverses physical-hash order. The old comparator
+	// therefore cannot accidentally pass the expected 01,02,03 display order.
+	require.Less(t, expected[1].ID, expected[0].ID)
+	require.Less(t, operations[0].OperationID, operations[1].OperationID)
+	for _, order := range [][]int{{0, 1, 2}, {0, 2, 1}, {1, 0, 2}, {1, 2, 0}, {2, 0, 1}, {2, 1, 0}} {
+		t.Run(fmt.Sprint(order), func(t *testing.T) {
+			fx := openFixture(t, "")
+			replayProjectionOrder(t, fx, operations, order)
+			before := readProjectionOrderEvidence(t, fx, operations)
+			view := projection(t, fx)
+			require.Equal(t, expected, view.Live)
+			require.Empty(t, view.Conflicts)
+			require.Empty(t, view.PendingObserved)
+			require.Equal(t, before, readProjectionOrderEvidence(t, fx, operations))
+			counts(t, fx, 3, 3)
+			fx.reopen(t)
+			require.Equal(t, view, projection(t, fx))
+			require.Equal(t, before, readProjectionOrderEvidence(t, fx, operations))
+			counts(t, fx, 3, 3)
+		})
+	}
+}
+
+func TestLiveOperationIDOrderRetainsConcurrentReplacements(t *testing.T) {
+	old, first, second, unrelated := add(9, "old predecessor"), add(1, "successor one"), add(2, "successor two"), add(3, "unrelated live claim")
+	first.Kind, second.Kind = Replace, Replace
+	first.Observed, second.Observed = []string{claimID(t, old)}, []string{claimID(t, old)}
+	operations := []Operation{old, first, second, unrelated}
+	expected := projectionOrderClaims(t, first, second, unrelated)
+	require.Less(t, expected[1].ID, expected[0].ID)
+	for _, order := range [][]int{{0, 1, 2, 3}, {2, 3, 0, 1}, {3, 1, 2, 0}} {
+		t.Run(fmt.Sprint(order), func(t *testing.T) {
+			fx := openFixture(t, "")
+			replayProjectionOrder(t, fx, operations, order)
+			before := readProjectionOrderEvidence(t, fx, operations)
+			view := projection(t, fx)
+			require.Equal(t, expected, view.Live, "both successors retain their full provenance and exact predecessor reference")
+			require.Empty(t, view.Conflicts)
+			require.Empty(t, view.PendingObserved)
+			counts(t, fx, 4, 4)
+			fx.reopen(t)
+			require.Equal(t, view, projection(t, fx))
+			require.Equal(t, before, readProjectionOrderEvidence(t, fx, operations))
+			counts(t, fx, 4, 4)
+		})
+	}
+}
+
+func TestLiveOperationIDOrderPreservesNonLiveProvenance(t *testing.T) {
+	first, second := add(1, "first live"), add(2, "second live")
+	variantA, variantB := add(4, "conflicting A"), add(4, "conflicting B")
+	missing := add(6, "predecessor not received")
+	remove := add(5, "")
+	remove.Kind, remove.Source, remove.Observed = Remove, Source{}, []string{claimID(t, missing)}
+	operations := []Operation{first, second, variantA, variantB, remove}
+	fx := openFixture(t, "")
+	replayProjectionOrder(t, fx, operations, []int{4, 3, 1, 2, 0})
+	before := readProjectionOrderEvidence(t, fx, operations)
+	conflict := before.Operations[variantA.OperationID]
+	require.True(t, conflict.Conflict)
+	require.Len(t, conflict.Claims, 2)
+	require.ElementsMatch(t, projectionOrderClaims(t, variantA, variantB), conflict.Claims)
+	view := projection(t, fx)
+	require.Equal(t, projectionOrderClaims(t, first, second), view.Live)
+	require.Equal(t, []Resolution{conflict}, view.Conflicts)
+	require.Equal(t, []string{claimID(t, missing)}, view.PendingObserved)
+	require.Equal(t, before, readProjectionOrderEvidence(t, fx, operations))
+	counts(t, fx, 5, 5)
+	fx.reopen(t)
+	require.Equal(t, view, projection(t, fx))
+	require.Equal(t, before, readProjectionOrderEvidence(t, fx, operations))
+	counts(t, fx, 5, 5)
+}
diff --git a/core/block/editor/torahops/store.go b/core/block/editor/torahops/store.go
new file mode 100644
--- /dev/null
+++ b/core/block/editor/torahops/store.go
@@ -0,0 +1,384 @@
+package torahops
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	anystore "github.com/anyproto/any-store"
+	"github.com/anyproto/any-store/anyenc"
+	"github.com/anyproto/any-store/query"
+
+	"github.com/anyproto/anytype-heart/core/block/editor/storestate"
+	"github.com/anyproto/anytype-heart/pb"
+)
+
+// NativeChange must come from a verified native change, not caller-supplied RPC
+// fields. This component checks author binding but does not verify ACL authority.
+type NativeChange struct {
+	ID        string
+	Order     string
+	Creator   string
+	ACLHeadID string
+}
+
+type Receipt struct {
+	ID        string `json:"id"`
+	ClaimID   string `json:"claimId"`
+	ChangeID  string `json:"changeId"`
+	Creator   string `json:"creator"`
+	ACLHeadID string `json:"aclHeadId"`
+}
+
+type Disposition string
+
+const (
+	Created                   Disposition = "created"
+	AlreadyExistsSamePayload  Disposition = "already_exists_same_payload"
+	CollisionDifferentPayload Disposition = "collision_different_payload"
+)
+
+// Resolution never contains a selected winner. All conflicting claims remain
+// available, sorted by their immutable physical IDs.
+type Resolution struct {
+	OperationID string
+	Conflict    bool
+	Claims      []Claim
+}
+
+type AppendResult struct {
+	Disposition Disposition
+	ClaimID     string
+	Resolution  Resolution
+}
+
+type Store struct {
+	state    *storestate.StoreState
+	claims   anystore.Collection
+	receipts anystore.Collection
+	spaceID  string
+}
+
+// New creates only a materialized StoreState namespace in an account-scoped DB.
+// It does NOT create the sanctioned hidden native host or a signed change tree.
+// Production writes must wait for that host's RPC/ACL/lifecycle implementation.
+func New(ctx context.Context, db anystore.DB, spaceID string) (*Store, error) {
+	if !validText(spaceID, true, 1024) {
+		return nil, ErrInvalid
+	}
+	h := &handler{spaceID: spaceID}
+	key := sha256.Sum256([]byte("pinkha-t2-projection-host-v1\x00" + spaceID))
+	state, err := storestate.New(ctx, "pinkha-t2-v1-"+hex.EncodeToString(key[:]), db, h)
+	if err != nil {
+		return nil, fmt.Errorf("open torah projection: %w", err)
+	}
+	return &Store{state: state, claims: h.claims, receipts: h.receipts, spaceID: spaceID}, nil
+}
+
+// AppendLocal atomically checks logical operation identity and applies one local
+// claim inside the real any-store write transaction. A mismatching ordered write
+// returns CollisionDifferentPayload without inserting a claim or a receipt.
+// A retry of existing bytes succeeds even if a remote conflict is now present;
+// its returned Resolution still exposes that conflict explicitly.
+func (s *Store) AppendLocal(ctx context.Context, op Operation, native NativeChange) (AppendResult, error) {
+	claim, wire, err := makeClaim(op)
+	if err != nil {
+		return AppendResult{}, err
+	}
+	if err = s.validateNative(op, native); err != nil {
+		return AppendResult{}, err
+	}
+	tx, err := s.state.NewTx(ctx)
+	if err != nil {
+		return AppendResult{}, fmt.Errorf("begin local append: %w", err)
+	}
+	defer func() { _ = tx.Rollback() }()
+	result, err := s.checkLocal(tx.Context(), claim)
+	if err != nil || result.Disposition != Created {
+		return result, err
+	}
+	if err = apply(tx, claim.ID, string(wire), native); err != nil {
+		return AppendResult{}, err
+	}
+	if err = tx.Commit(); err != nil {
+		return AppendResult{}, fmt.Errorf("commit local append: %w", err)
+	}
+	return result, nil
+}
+
+// checkLocal is shared by the projection component and the signed native host.
+// The caller must pass its real StoreState write transaction's context.
+func (s *Store) checkLocal(ctx context.Context, claim Claim) (AppendResult, error) {
+	op := claim.Operation
+	resolution, err := s.ReadOperation(ctx, op.OperationID)
+	if err != nil {
+		return AppendResult{}, err
+	}
+	for _, existing := range resolution.Claims {
+		if existing.ID == claim.ID {
+			left, _ := existing.Operation.CanonicalBytes()
+			right, _ := op.CanonicalBytes()
+			if !bytes.Equal(left, right) {
+				return AppendResult{}, fmt.Errorf("content digest collision: %w", storestate.ErrCritical)
+			}
+			return AppendResult{Disposition: AlreadyExistsSamePayload, ClaimID: claim.ID, Resolution: resolution}, nil
+		}
+	}
+	if len(resolution.Claims) != 0 {
+		return AppendResult{Disposition: CollisionDifferentPayload, ClaimID: claim.ID, Resolution: resolution}, nil
+	}
+	// A local caller may only remove/replace claims present in this transaction
+	// at the same target. Replay cannot impose this arrival-order prerequisite.
+	for _, observedID := range op.Observed {
+		observed, findErr := s.claims.FindId(ctx, observedID)
+		if errors.Is(findErr, anystore.ErrDocNotFound) {
+			return AppendResult{}, fmt.Errorf("unobserved predecessor: %w", ErrInvalid)
+		}
+		if findErr != nil {
+			return AppendResult{}, fmt.Errorf("lookup observed predecessor: %w", findErr)
+		}
+		predecessor, parseErr := claimFromValue(observed.Value())
+		if parseErr != nil {
+			return AppendResult{}, parseErr
+		}
+		if predecessor.Operation.Target != op.Target {
+			return AppendResult{}, fmt.Errorf("predecessor target mismatch: %w", ErrInvalid)
+		}
+	}
+	return AppendResult{Disposition: Created, ClaimID: claim.ID,
+		Resolution: Resolution{OperationID: op.OperationID, Claims: []Claim{claim}}}, nil
+}
+
+// Replay merges an already-authorized immutable native claim. Unlike a local
+// ordered append, offline variants must both be retained, independently of arrival
+// order. Calling this helper is a component replay test, not a transport test.
+func (s *Store) Replay(ctx context.Context, op Operation, native NativeChange) error {
+	claim, wire, err := makeClaim(op)
+	if err != nil {
+		return err
+	}
+	if err = s.validateNative(op, native); err != nil {
+		return err
+	}
+	tx, err := s.state.NewTx(ctx)
+	if err != nil {
+		return fmt.Errorf("begin native replay: %w", err)
+	}
+	defer func() { _ = tx.Rollback() }()
+	if err = apply(tx, claim.ID, string(wire), native); err != nil {
+		return err
+	}
+	if err = tx.Commit(); err != nil {
+		return fmt.Errorf("commit native replay: %w", err)
+	}
+	return nil
+}
+
+func (s *Store) validateNative(op Operation, native NativeChange) error {
+	if op.SpaceID != s.spaceID || op.AuthorID != native.Creator || !validNative(native) {
+		return ErrInvalid
+	}
+	return nil
+}
+
+func validNative(native NativeChange) bool {
+	return validText(native.ID, true, 1024) && validText(native.Order, true, 1024) &&
+		validText(native.Creator, true, 1024) && validText(native.ACLHeadID, true, 1024)
+}
+
+func apply(tx *storestate.StoreStateTx, id, wire string, native NativeChange) error {
+	build := &storestate.Builder{}
+	if err := build.Create(CollectionName, id, wire); err != nil {
+		return fmt.Errorf("build native claim: %w", err)
+	}
+	if err := tx.ApplyChangeSetReturnAllErrors(storestate.ChangeSet{Id: native.ID, Order: native.Order,
+		Creator: native.Creator, AclHeadId: native.ACLHeadID, Changes: build.ChangeSet}); err != nil {
+		return fmt.Errorf("apply native claim: %w", err)
+	}
+	return nil
+}
+
+func (s *Store) ReadOperation(ctx context.Context, operationID string) (Resolution, error) {
+	if !validHex(operationID, 16) {
+		return Resolution{}, ErrInvalid
+	}
+	claims, err := readClaims(ctx, s.claims.Find(map[string]any{"operation.operationId": operationID}), MaxVariants)
+	if err != nil {
+		return Resolution{}, err
+	}
+	return Resolution{OperationID: operationID, Conflict: len(claims) > 1, Claims: claims}, nil
+}
+
+func (s *Store) Receipts(ctx context.Context, claimID string) (result []Receipt, err error) {
+	if !validClaimID(claimID) {
+		return nil, ErrInvalid
+	}
+	iter, err := s.receipts.Find(map[string]any{"claimId": claimID}).Sort("id").Limit(MaxVariants + 1).Iter(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { err = errors.Join(err, iter.Close()) }()
+	for iter.Next() {
+		if len(result) == MaxVariants {
+			return nil, ErrReadLimit
+		}
+		doc, readErr := iter.Doc()
+		if readErr != nil {
+			return nil, readErr
+		}
+		var receipt Receipt
+		if readErr = json.Unmarshal([]byte(doc.Value().String()), &receipt); readErr != nil {
+			return nil, readErr
+		}
+		result = append(result, receipt)
+	}
+	return result, iter.Err()
+}
+
+func readClaims(ctx context.Context, q anystore.Query, limit uint) (result []Claim, err error) {
+	iter, err := q.Sort("id").Limit(limit + 1).Iter(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("query claims: %w", err)
+	}
+	defer func() { err = errors.Join(err, iter.Close()) }()
+	for iter.Next() {
+		if uint(len(result)) == limit {
+			return nil, ErrReadLimit
+		}
+		doc, readErr := iter.Doc()
+		if readErr != nil {
+			return nil, readErr
+		}
+		claim, readErr := claimFromValue(doc.Value())
+		if readErr != nil {
+			return nil, readErr
+		}
+		result = append(result, claim)
+	}
+	return result, iter.Err()
+}
+
+func claimFromValue(value *anyenc.Value) (Claim, error) {
+	var op Operation
+	operationValue := value.Get("operation")
+	if operationValue == nil {
+		return Claim{}, ErrInvalid
+	}
+	if err := json.Unmarshal([]byte(operationValue.String()), &op); err != nil {
+		return Claim{}, err
+	}
+	claim, _, err := makeClaim(op)
+	if err != nil {
+		return Claim{}, err
+	}
+	if value.GetString("id") != claim.ID || value.GetString("digest") != claim.Digest {
+		return Claim{}, ErrInvalid
+	}
+	return claim, nil
+}
+
+type handler struct {
+	spaceID  string
+	claims   anystore.Collection
+	receipts anystore.Collection
+}
+
+var _ storestate.Handler = (*handler)(nil)
+
+func (h *handler) CollectionName() string { return CollectionName }
+
+func (h *handler) Init(ctx context.Context, state *storestate.StoreState) (err error) {
+	if h.claims, err = state.Collection(ctx, CollectionName); err != nil {
+		return err
+	}
+	if h.receipts, err = state.Collection(ctx, receiptsCollection); err != nil {
+		return err
+	}
+	if err = h.claims.EnsureIndex(ctx,
+		anystore.IndexInfo{Name: "operation", Fields: []string{"operation.operationId"}},
+		anystore.IndexInfo{Name: "target", Fields: []string{"operation.target.objectId", "operation.target.blockId"}}); err != nil {
+		return err
+	}
+	return h.receipts.EnsureIndex(ctx, anystore.IndexInfo{Name: "claim", Fields: []string{"claimId"}})
+}
+
+func (h *handler) BeforeCreate(ctx context.Context, ch storestate.ChangeOp) error {
+	create := ch.Change.Change.GetCreate()
+	claim, err := DecodeClaim(create.DocumentId, create.Value)
+	if err != nil {
+		return errors.Join(storestate.ErrValidation, err)
+	}
+	native := NativeChange{ID: ch.Change.Id, Order: ch.Change.Order, Creator: ch.Change.Creator, ACLHeadID: ch.Change.AclHeadId}
+	if claim.Operation.SpaceID != h.spaceID || claim.Operation.AuthorID != native.Creator || !validNative(native) {
+		return errors.Join(storestate.ErrValidation, ErrInvalid)
+	}
+	existing, err := h.claims.FindId(ctx, claim.ID)
+	duplicate := err == nil
+	if err != nil && !errors.Is(err, anystore.ErrDocNotFound) {
+		return errors.Join(storestate.ErrCritical, err)
+	}
+	if duplicate {
+		old, parseErr := claimFromValue(existing.Value())
+		if parseErr != nil {
+			return errors.Join(storestate.ErrCritical, parseErr)
+		}
+		left, _ := old.Operation.CanonicalBytes()
+		right, _ := claim.Operation.CanonicalBytes()
+		if !bytes.Equal(left, right) {
+			return fmt.Errorf("content digest collision: %w", storestate.ErrCritical)
+		}
+	}
+	if err = h.insertReceipt(ctx, ch, claim.ID); err != nil {
+		return errors.Join(storestate.ErrCritical, err)
+	}
+	if duplicate {
+		return storestate.ErrIgnore
+	}
+	return nil
+}
+
+func (h *handler) insertReceipt(ctx context.Context, ch storestate.ChangeOp, claimID string) error {
+	buf := bytes.NewBufferString("pinkha-t2-receipt-v1\x00")
+	putBytes(buf, []byte(claimID))
+	putBytes(buf, []byte(ch.Change.Id))
+	digest := sha256.Sum256(buf.Bytes())
+	receipt := Receipt{ID: hex.EncodeToString(digest[:]), ClaimID: claimID, ChangeID: ch.Change.Id,
+		Creator: ch.Change.Creator, ACLHeadID: ch.Change.AclHeadId}
+	existing, err := h.receipts.FindId(ctx, receipt.ID)
+	if err == nil {
+		var old Receipt
+		if err = json.Unmarshal([]byte(existing.Value().String()), &old); err != nil {
+			return err
+		}
+		if old != receipt {
+			return fmt.Errorf("native change provenance mismatch: %w", ErrInvalid)
+		}
+		return nil
+	}
+	if !errors.Is(err, anystore.ErrDocNotFound) {
+		return err
+	}
+	v := ch.Arena.NewObject()
+	v.Set("id", ch.Arena.NewString(receipt.ID))
+	v.Set("claimId", ch.Arena.NewString(receipt.ClaimID))
+	v.Set("changeId", ch.Arena.NewString(receipt.ChangeID))
+	v.Set("creator", ch.Arena.NewString(receipt.Creator))
+	v.Set("aclHeadId", ch.Arena.NewString(receipt.ACLHeadID))
+	return h.receipts.Insert(ctx, v)
+}
+
+func (h *handler) BeforeModify(context.Context, storestate.ChangeOp) (storestate.ModifyMode, error) {
+	return storestate.ModifyModeUpdate, fmt.Errorf("immutable claim: %w", storestate.ErrValidation)
+}
+
+func (h *handler) BeforeDelete(context.Context, storestate.ChangeOp) (storestate.DeleteMode, error) {
+	return storestate.DeleteModeKeep, fmt.Errorf("append an observed remove: %w", storestate.ErrValidation)
+}
+
+func (h *handler) UpgradeKeyModifier(_ storestate.ChangeOp, _ *pb.KeyModify, mod query.Modifier) query.Modifier {
+	return mod
+}
