@@ -0,0 +1,146 @@
+package core
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"reflect"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/anytype-heart/core/block/editor/torahops"
+	"github.com/anyproto/anytype-heart/pb"
+	"github.com/stretchr/testify/require"
+)
+
+// Mapping fixture, not a native-signature or account proof. Signed history,
+// current ACL and target leases are exercised by the separate native slice.
+func authorizedRPCSnapshot(t *testing.T) torahops.AuthorizedOperationSnapshot {
+	t.Helper()
+	op := torahops.Operation{Version: 1, SpaceID: "fixture-space", OperationID: strings.Repeat("1", 32),
+		AuthorID: "native-author", Kind: torahops.Add, Target: torahops.Target{ObjectID: "live-document", BlockID: "old-block"},
+		Source: torahops.Source{ProviderID: "fixture", CanonicalRef: "fixture:1"}, Payload: []byte{0xff, 0x00, 'x'}}
+	canonical, err := op.CanonicalBytes()
+	require.NoError(t, err)
+	id, _, err := torahops.EncodeClaim(op)
+	require.NoError(t, err)
+	return torahops.AuthorizedOperationSnapshot{Contract: torahops.AuthorizedOperationReadContract,
+		AccountID: "native-reader", SpaceID: op.SpaceID, OperationID: op.OperationID, Outcome: torahops.OperationFound,
+		Complete: true, NativeSnapshotToken: strings.Repeat("a", 64), Variants: []torahops.AuthorizedOperationVariant{{
+			ClaimID: id, OperationID: op.OperationID, SpaceID: op.SpaceID, AuthorID: op.AuthorID, Target: op.Target,
+			CanonicalBytes: canonical, Reachability: torahops.OperationUnreachableBlock,
+			Provenance: []torahops.AuthorizedOperationProvenance{{Creator: op.AuthorID, NativeChangeID: "native-change", NativeACLHeadID: "native-acl-head"}},
+		}}}
+}
+
+func TestPinkhaAuthorizedOperationRPCSchemaAndExactOpaqueRoundTrip(t *testing.T) {
+	requestType := reflect.TypeOf(pb.PinkhaTorahAuthorizedOperationReadRequest{})
+	fields := []string{}
+	for i := 0; i < requestType.NumField(); i++ {
+		field := requestType.Field(i)
+		if field.Tag.Get("protobuf") != "" {
+			fields = append(fields, field.Name)
+		}
+	}
+	require.Equal(t, []string{"ProtocolVersion", "SpaceId", "OperationId"}, fields, "caller cannot assert author, targets, ACL or root")
+	value := authorizedRPCSnapshot(t)
+	reply := pinkhaAuthorizedOperationReadToWire(value, nil)
+	require.Equal(t, int32(0), int32(reply.Error.Code))
+	require.NotNil(t, reply.Snapshot)
+	raw, err := reply.Marshal()
+	require.NoError(t, err)
+	var decoded pb.PinkhaTorahAuthorizedOperationReadResponse
+	require.NoError(t, decoded.Unmarshal(raw))
+	require.Equal(t, reply, &decoded)
+	require.Equal(t, value.Variants[0].CanonicalBytes, decoded.Snapshot.Variants[0].CanonicalBytes)
+	require.Equal(t, pb.PinkhaTorahAuthorizedOperationRead_UNREACHABLE_BLOCK, decoded.Snapshot.Variants[0].Reachability)
+	require.True(t, decoded.Snapshot.Complete)
+	value.Variants = nil
+	value.Outcome = torahops.OperationAbsentInVerifiedLocalSnapshot
+	absent := pinkhaAuthorizedOperationReadToWire(value, nil)
+	require.Equal(t, int32(0), int32(absent.Error.Code))
+	require.Equal(t, pb.PinkhaTorahAuthorizedOperationRead_ABSENT_IN_VERIFIED_LOCAL_SNAPSHOT, absent.Snapshot.Outcome)
+	require.Empty(t, absent.Snapshot.Variants)
+}
+
+func TestPinkhaAuthorizedOperationRPCFailedFencesReleaseNoPayload(t *testing.T) {
+	for _, item := range []struct {
+		name string
+		err  error
+		code int32
+	}{
+		{"account-changed", ErrPinkhaTorahAccountChanged, 6},
+		{"denied", list.ErrInsufficientPermissions, 4},
+		{"missing-key", list.ErrNoReadKey, 4},
+		{"no-account", ErrNotLoggedIn, 5},
+		{"unsupported-version", torahops.ErrUnsupportedVersion, 3},
+		{"invalid", torahops.ErrInvalid, 2},
+		{"target-unavailable", torahops.ErrOperationTargetUnavailable, 7},
+		{"history-unavailable", ErrPinkhaTorahHistoryUnavailable, 8},
+		{"snapshot-changed", torahops.ErrOperationSnapshotChanged, 9},
+		{"projection-behind", torahops.ErrProjectionBehind, 10},
+		{"read-limit", torahops.ErrReadLimit, 11},
+		{"cancelled", context.Canceled, 12},
+		{"deadline", context.DeadlineExceeded, 13},
+	} {
+		t.Run(item.name, func(t *testing.T) {
+			value := authorizedRPCSnapshot(t)
+			reply := pinkhaAuthorizedOperationReadToWire(value, errors.Join(item.err, errors.New("private secret identifier")))
+			require.Equal(t, item.code, int32(reply.Error.Code))
+			require.Nil(t, reply.Snapshot)
+			raw, err := reply.Marshal()
+			require.NoError(t, err)
+			require.False(t, bytes.Contains(raw, []byte("private secret")))
+			require.False(t, bytes.Contains(raw, []byte(value.Variants[0].ClaimID)))
+		})
+	}
+}
+
+func TestPinkhaAuthorizedOperationRPCBoundsAndInvalidShape(t *testing.T) {
+	for _, scenario := range []string{"variant-count", "encoded-response", "incomplete", "wrong-outcome", "wrong-reachability", "duplicate-claim"} {
+		t.Run(scenario, func(t *testing.T) {
+			value := authorizedRPCSnapshot(t)
+			expected := int32(2)
+			switch scenario {
+			case "variant-count":
+				value.Variants = slices.Repeat(value.Variants, torahops.MaxVariants+1)
+				expected = 11
+			case "encoded-response":
+				value.Variants[0].CanonicalBytes = bytes.Repeat([]byte{0xff}, torahops.MaxAuthorizedOperationReadBytes)
+				expected = 11
+			case "incomplete":
+				value.Complete = false
+			case "wrong-outcome":
+				value.Outcome = torahops.OperationAbsentInVerifiedLocalSnapshot
+			case "wrong-reachability":
+				value.Variants[0].Reachability = torahops.OperationLiveDocument
+			case "duplicate-claim":
+				value.Variants = append(value.Variants, value.Variants[0])
+			}
+			reply := pinkhaAuthorizedOperationReadToWire(value, nil)
+			require.Equal(t, expected, int32(reply.Error.Code))
+			require.Nil(t, reply.Snapshot)
+			require.Less(t, reply.Size(), 1024)
+		})
+	}
+}
+
+func TestPinkhaAuthorizedOperationRPCRejectsBeforeAccount(t *testing.T) {
+	mw := New()
+	for _, version := range []uint32{0, 2} {
+		reply := mw.PinkhaTorahAuthorizedOperationRead(context.Background(), &pb.PinkhaTorahAuthorizedOperationReadRequest{ProtocolVersion: version})
+		require.Equal(t, int32(3), int32(reply.Error.Code))
+		require.Nil(t, reply.Snapshot)
+	}
+	invalid := mw.PinkhaTorahAuthorizedOperationRead(context.Background(), nil)
+	require.Equal(t, int32(2), int32(invalid.Error.Code))
+	require.Nil(t, invalid.Snapshot)
+	value := authorizedRPCSnapshot(t)
+	missing := mw.PinkhaTorahAuthorizedOperationRead(context.Background(), &pb.PinkhaTorahAuthorizedOperationReadRequest{
+		ProtocolVersion: 1, SpaceId: value.SpaceID, OperationId: value.OperationID,
+	})
+	require.Equal(t, int32(5), int32(missing.Error.Code))
+	require.Nil(t, missing.Snapshot)
+}
diff --git a/core/pinkha_coherent_operation_read.go b/core/pinkha_coherent_operation_read.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha_coherent_operation_read.go
@@ -0,0 +1,116 @@
+package core
+
+import (
+	"context"
+	"errors"
+
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/anytype-heart/core/block/editor/torahops"
+	"github.com/anyproto/anytype-heart/pb"
+)
+
+// The coherent candidate uses the same native publication fence as
+// ObjectSearch/ObjectShow. No owner, ACL verdict, or callback is caller supplied.
+type pinkhaOperationReadPublication interface {
+	acquirePublication(context.Context) (func(), error)
+}
+
+type pinkhaPreparedOperationRead struct {
+	value       torahops.AuthorizedOperationSnapshot
+	readOwner   *pinkhaTorahScope
+	publication pinkhaOperationReadPublication
+}
+
+// The existing App lease protects native target/private-history preparation.
+// It is released before this function returns, along with every object/settings
+// lease owned by the read. Final publication must never recursively acquire the
+// App RLock: an AccountStop/Select writer may already be waiting for it.
+func (mw *Middleware) preparePinkhaAuthorizedOperationRead(ctx context.Context, req PinkhaTorahAuthorizedOperationReadRequest) (pinkhaPreparedOperationRead, error) {
+	if err := validatePinkhaTorahOperationRead(ctx, req); err != nil {
+		return pinkhaPreparedOperationRead{}, err
+	}
+	owner, err := mw.pinkhaTorahScope(ctx)
+	if err != nil {
+		return pinkhaPreparedOperationRead{}, err
+	}
+	defer owner.close()
+	publication, err := mw.pinkhaBeginCurrentSpaceRead(ctx, owner.application, req.SpaceID, "")
+	if err != nil {
+		return pinkhaPreparedOperationRead{}, pinkhaOperationPublicationError(err)
+	}
+	host, err := owner.operationReadHost(ctx, req.SpaceID)
+	if err != nil {
+		return pinkhaPreparedOperationRead{}, err
+	}
+	result, err := host.ReadAuthorizedTorahOperation(ctx, req.OperationID)
+	if err = errors.Join(err, owner.current(ctx), ctx.Err()); err != nil {
+		return pinkhaPreparedOperationRead{}, err
+	}
+	if result.AccountID != owner.key.GetPublic().Account() || result.SpaceID != req.SpaceID || result.OperationID != req.OperationID {
+		return pinkhaPreparedOperationRead{}, torahops.ErrInvalid
+	}
+	return pinkhaPreparedOperationRead{value: result, readOwner: owner, publication: publication}, nil
+}
+
+// Only the native fence's exact typed errors gain the existing T2 wire meanings.
+// Transient errors and arbitrary descriptions never become authority denials.
+func pinkhaOperationPublicationError(err error) error {
+	switch {
+	case errors.Is(err, errPinkhaCurrentReadDenied):
+		return errors.Join(list.ErrInsufficientPermissions, err)
+	case errors.Is(err, errPinkhaCurrentReadInvalidated):
+		return errors.Join(torahops.ErrOperationSnapshotChanged, err)
+	default:
+		return err
+	}
+}
+
+func (p pinkhaPreparedOperationRead) acquirePublication(ctx context.Context) (func(), error) {
+	if ctx == nil {
+		return nil, torahops.ErrInvalid
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	// This explicit ownership barrier also fails closed if a future caller moves
+	// finalization inside the old read lease. It cannot hang on a nested RLock.
+	if p.readOwner == nil || p.readOwner.leaseActive.Load() || p.publication == nil {
+		return nil, torahops.ErrOperationSnapshotChanged
+	}
+	release, err := p.publication.acquirePublication(ctx)
+	if err != nil {
+		return nil, pinkhaOperationPublicationError(err)
+	}
+	if release == nil {
+		return nil, torahops.ErrOperationSnapshotChanged
+	}
+	if err := ctx.Err(); err != nil {
+		release()
+		return nil, err
+	}
+	return release, nil
+}
+
+func (p pinkhaPreparedOperationRead) snapshot(ctx context.Context) (torahops.AuthorizedOperationSnapshot, error) {
+	release, err := p.acquirePublication(ctx)
+	if err != nil {
+		return torahops.AuthorizedOperationSnapshot{}, err
+	}
+	defer release()
+	return p.value, nil
+}
+
+func (p pinkhaPreparedOperationRead) wire(ctx context.Context) *pb.PinkhaTorahAuthorizedOperationReadResponse {
+	// Complete copying, validation, and size checks before acquiring final
+	// App->Space-publication->ACL leases. No native service is called while held.
+	response := pinkhaAuthorizedOperationReadToWire(p.value, nil)
+	if response.Error.Code != pb.PinkhaTorahAuthorizedOperationReadResponseError_NULL {
+		return response
+	}
+	release, err := p.acquirePublication(ctx)
+	if err != nil {
+		return pinkhaAuthorizedOperationReadToWire(torahops.AuthorizedOperationSnapshot{}, err)
+	}
+	defer release()
+	return response
+}
diff --git a/core/pinkha_coherent_operation_read_test.go b/core/pinkha_coherent_operation_read_test.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha_coherent_operation_read_test.go
@@ -0,0 +1,160 @@
+package core
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/anytype-heart/core/block/editor/torahops"
+	"github.com/anyproto/anytype-heart/pb"
+	"github.com/stretchr/testify/require"
+)
+
+// These are finalization component checks. The publisher double supplies an
+// outcome; it does not prove native ACL or Space retirement. Those are bound to
+// the unchanged native publication-lock proof and the separate real account run.
+type coherentReadPublication struct {
+	acquire func(context.Context) (func(), error)
+	calls   int
+}
+
+func (p *coherentReadPublication) acquirePublication(ctx context.Context) (func(), error) {
+	p.calls++
+	return p.acquire(ctx)
+}
+
+func coherentPreparedRead(t *testing.T, publication pinkhaOperationReadPublication) pinkhaPreparedOperationRead {
+	t.Helper()
+	return pinkhaPreparedOperationRead{value: authorizedRPCSnapshot(t), readOwner: &pinkhaTorahScope{}, publication: publication}
+}
+
+func TestCoherentAuthorizedReadFinalizationReleasesNoRetiredPayload(t *testing.T) {
+	for _, entry := range []string{"native", "wire"} {
+		for _, outcome := range []string{"denied", "retired", "cancelled-after-wait"} {
+			t.Run(entry+"-"+outcome, func(t *testing.T) {
+				ctx, cancel := context.WithCancel(context.Background())
+				defer cancel()
+				released := 0
+				publication := &coherentReadPublication{acquire: func(context.Context) (func(), error) {
+					switch outcome {
+					case "denied":
+						return nil, errPinkhaCurrentReadDenied
+					case "retired":
+						return nil, errPinkhaCurrentReadInvalidated
+					default:
+						cancel()
+						return func() { released++ }, nil
+					}
+				}}
+				prepared := coherentPreparedRead(t, publication)
+				code, expected := int32(4), error(list.ErrInsufficientPermissions)
+				if outcome == "retired" {
+					code, expected = 9, torahops.ErrOperationSnapshotChanged
+				} else if outcome == "cancelled-after-wait" {
+					code, expected = 12, context.Canceled
+				}
+				if entry == "native" {
+					value, err := prepared.snapshot(ctx)
+					require.ErrorIs(t, err, expected)
+					require.Equal(t, torahops.AuthorizedOperationSnapshot{}, value)
+				} else {
+					response := prepared.wire(ctx)
+					require.Equal(t, code, int32(response.Error.Code))
+					require.Nil(t, response.Snapshot)
+					raw, err := response.Marshal()
+					require.NoError(t, err)
+					require.False(t, bytes.Contains(raw, prepared.value.Variants[0].CanonicalBytes))
+					require.False(t, bytes.Contains(raw, []byte(prepared.value.Variants[0].ClaimID)))
+				}
+				require.Equal(t, 1, publication.calls)
+				if outcome == "cancelled-after-wait" {
+					require.Equal(t, 1, released)
+				} else {
+					require.Zero(t, released)
+				}
+			})
+		}
+	}
+}
+
+func TestCoherentAuthorizedReadBuildsWireBeforePublication(t *testing.T) {
+	publication := &coherentReadPublication{}
+	prepared := coherentPreparedRead(t, publication)
+	expected := append([]byte{}, prepared.value.Variants[0].CanonicalBytes...)
+	released := 0
+	publication.acquire = func(context.Context) (func(), error) {
+		// The response must already own its copy before the publication lock is
+		// requested. This changes the prepared source only, never wire output.
+		prepared.value.Variants[0].CanonicalBytes[0] ^= 0xff
+		return func() { released++ }, nil
+	}
+	response := prepared.wire(context.Background())
+	require.Equal(t, pb.PinkhaTorahAuthorizedOperationReadResponseError_NULL, response.Error.Code)
+	require.Equal(t, expected, response.Snapshot.Variants[0].CanonicalBytes)
+	require.NotEqual(t, expected, prepared.value.Variants[0].CanonicalBytes)
+	require.Equal(t, 1, publication.calls)
+	require.Equal(t, 1, released)
+}
+
+func TestCoherentAuthorizedReadRejectsActiveReadLeaseBeforePublication(t *testing.T) {
+	appReleased, finalReleased := 0, 0
+	owner := &pinkhaTorahScope{releaseApp: func() { appReleased++ }}
+	owner.leaseActive.Store(true)
+	publication := &coherentReadPublication{acquire: func(context.Context) (func(), error) {
+		require.False(t, owner.leaseActive.Load(), "never recursively acquire App while the old lease is active")
+		require.Equal(t, 1, appReleased)
+		return func() { finalReleased++ }, nil
+	}}
+	prepared := coherentPreparedRead(t, publication)
+	prepared.readOwner = owner
+	denied := prepared.wire(context.Background())
+	require.Equal(t, int32(9), int32(denied.Error.Code))
+	require.Nil(t, denied.Snapshot)
+	require.Zero(t, publication.calls)
+	owner.close()
+	response := prepared.wire(context.Background())
+	require.Equal(t, int32(0), int32(response.Error.Code))
+	require.NotNil(t, response.Snapshot)
+	require.Equal(t, 1, publication.calls)
+	require.Equal(t, 1, finalReleased)
+}
+
+func TestCoherentAuthorizedReadMissingOwnershipFailsClosed(t *testing.T) {
+	for _, scenario := range []string{"missing-read-owner", "missing-publication", "missing-release"} {
+		t.Run(scenario, func(t *testing.T) {
+			publication := &coherentReadPublication{acquire: func(context.Context) (func(), error) { return nil, nil }}
+			prepared := coherentPreparedRead(t, publication)
+			if scenario == "missing-read-owner" {
+				prepared.readOwner = nil
+			} else if scenario == "missing-publication" {
+				prepared.publication = nil
+			}
+			response := prepared.wire(context.Background())
+			require.Equal(t, int32(9), int32(response.Error.Code))
+			require.Nil(t, response.Snapshot)
+			if scenario == "missing-release" {
+				require.Equal(t, 1, publication.calls)
+			} else {
+				require.Zero(t, publication.calls)
+			}
+		})
+	}
+}
+
+func TestCoherentAuthorizedReadNativeSuccessReleasesPublication(t *testing.T) {
+	released := 0
+	publication := &coherentReadPublication{acquire: func(context.Context) (func(), error) {
+		return func() { released++ }, nil
+	}}
+	prepared := coherentPreparedRead(t, publication)
+	value, err := prepared.snapshot(context.Background())
+	require.NoError(t, err)
+	require.Equal(t, prepared.value, value)
+	require.Equal(t, 1, publication.calls)
+	require.Equal(t, 1, released)
+	transient := errors.New("PINKHA_CURRENT_SPACE_READ_DENIED_V1")
+	require.Same(t, transient, pinkhaOperationPublicationError(transient), "description alone must not become permission evidence")
+	require.False(t, errors.Is(pinkhaOperationPublicationError(transient), list.ErrInsufficientPermissions))
+}
diff --git a/core/pinkha_current_read.go b/core/pinkha_current_read.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha_current_read.go
@@ -0,0 +1,173 @@
+package core
+
+import (
+	"context"
+	"errors"
+	"sync"
+
+	"github.com/anyproto/any-sync/app"
+	"github.com/anyproto/any-sync/commonspace/object/acl/list"
+	"github.com/anyproto/any-sync/util/crypto"
+
+	"github.com/anyproto/anytype-heart/core/block/object/idresolver"
+	"github.com/anyproto/anytype-heart/pkg/lib/localstore/addr"
+	"github.com/anyproto/anytype-heart/space"
+	"github.com/anyproto/anytype-heart/space/clientspace"
+)
+
+// These exact descriptions accompany the existing BAD_INPUT wire code. They
+// identify native current authority, not a client-side access flag. Keep them
+// distinct from an ordinary unavailable provider/query error.
+var (
+	errPinkhaCurrentReadDenied      = errors.New("PINKHA_CURRENT_SPACE_READ_DENIED_V1")
+	errPinkhaCurrentReadInvalidated = errors.New("PINKHA_CURRENT_SPACE_READ_INVALIDATED_V1")
+)
+
+type pinkhaCurrentReadScope struct {
+	middleware  *Middleware
+	application *app.App
+	spaces      space.Service
+	space       clientspace.Space
+	spaceID     string
+	acl         list.AclList
+	identity    crypto.PubKey
+	head        string
+	marketplace bool
+}
+
+func (mw *Middleware) pinkhaBeginCurrentSpaceRead(ctx context.Context, application *app.App, spaceID, objectID string) (*pinkhaCurrentReadScope, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if application == nil {
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	spaces, err := app.GetComponent[space.Service](application)
+	if err != nil {
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	// ObjectShow historically permits an omitted Space ID. Resolve it with the
+	// existing native resolver; never infer authority from an arbitrary ID.
+	if spaceID == "" {
+		if objectID == "" {
+			return nil, errPinkhaCurrentReadInvalidated
+		}
+		resolver, resolveErr := app.GetComponent[idresolver.Resolver](application)
+		if resolveErr != nil {
+			return nil, errPinkhaCurrentReadInvalidated
+		}
+		spaceID, err = resolver.ResolveSpaceID(objectID)
+		if err != nil || spaceID == "" {
+			return nil, errPinkhaCurrentReadInvalidated
+		}
+	}
+	spc, err := spaces.Get(ctx, spaceID)
+	if err != nil || spc == nil || spc.Id() != spaceID || spc.CommonSpace() == nil {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	scope := &pinkhaCurrentReadScope{middleware: mw, application: application, spaces: spaces, space: spc, spaceID: spaceID}
+	// The registered native marketplace is an explicitly public, immutable
+	// virtual Space. This concrete native type/ID exception is not a generic
+	// nil-ACL bypass for a private or partially loaded Space.
+	if _, virtual := spc.(*clientspace.VirtualSpace); virtual && spaceID == addr.AnytypeMarketplaceWorkspace && spc.CommonSpace().Acl() == nil {
+		scope.marketplace = true
+		return scope, nil
+	}
+	scope.acl, scope.identity = spc.CommonSpace().Acl(), spc.GetAclIdentity()
+	if scope.acl == nil || scope.identity == nil {
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	scope.acl.RLock()
+	defer scope.acl.RUnlock()
+	if scope.acl.AclState() == nil || scope.acl.Head() == nil || scope.acl.Head().Id == "" {
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	if !pinkhaCurrentReadPermission(scope.acl.AclState().Permissions(scope.identity)) {
+		return nil, errPinkhaCurrentReadDenied
+	}
+	scope.head = scope.acl.Head().Id
+	return scope, nil
+}
+
+// The predicate is identical to the retained current-read rule used by native
+// Torah operations. Historical membership/decryption keys never grant access.
+func pinkhaCurrentReadPermission(permission list.AclPermissions) bool {
+	switch permission {
+	case list.AclPermissionsReader, list.AclPermissionsGuest, list.AclPermissionsWriter,
+		list.AclPermissionsAdmin, list.AclPermissionsOwner:
+		return true
+	default:
+		return false
+	}
+}
+
+// acquirePublication runs only after the query/ShowBlock has finished and its
+// result is ready. No object/index/Space wait occurs under the ACL lock. Thus
+// existing object->ACL write ordering is preserved. The unchanged signed head
+// bridges the unlocked read phase; any intervening ACL change invalidates it.
+// The returned lease holds app-lifecycle->Space-publication->ACL locks until the
+// response is constructed. Callers must not invoke native services while held.
+func (s *pinkhaCurrentReadScope) acquirePublication(ctx context.Context) (func(), error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	current, err := s.spaces.Get(ctx, s.spaceID)
+	if err != nil || current == nil || current != s.space || current.Id() != s.spaceID || current.CommonSpace() == nil {
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	releaseApp, currentApp := s.middleware.applicationService.AcquireCurrentAppRead(s.application)
+	if !currentApp {
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	publicationOwner, nativeOwner := current.(interface {
+		AcquireCurrentReadPublication() (func(), bool)
+	})
+	if !nativeOwner {
+		releaseApp()
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	releaseSpace, currentSpace := publicationOwner.AcquireCurrentReadPublication()
+	if !currentSpace {
+		releaseApp()
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	releaseOwners := func() { releaseSpace(); releaseApp() }
+	if err := ctx.Err(); err != nil {
+		releaseOwners()
+		return nil, err
+	}
+	if s.marketplace {
+		if _, virtual := current.(*clientspace.VirtualSpace); !virtual || current.CommonSpace().Acl() != nil || s.spaceID != addr.AnytypeMarketplaceWorkspace {
+			releaseOwners()
+			return nil, errPinkhaCurrentReadInvalidated
+		}
+		return releaseOwners, nil
+	}
+	if current.CommonSpace().Acl() != s.acl || current.GetAclIdentity() == nil || !current.GetAclIdentity().Equals(s.identity) {
+		releaseOwners()
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	s.acl.RLock()
+	release := func() { s.acl.RUnlock(); releaseOwners() }
+	if s.acl.AclState() == nil || s.acl.Head() == nil {
+		release()
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	if !pinkhaCurrentReadPermission(s.acl.AclState().Permissions(s.identity)) {
+		release()
+		return nil, errPinkhaCurrentReadDenied
+	}
+	if s.acl.Head().Id != s.head {
+		release()
+		return nil, errPinkhaCurrentReadInvalidated
+	}
+	if err := ctx.Err(); err != nil {
+		release()
+		return nil, err
+	}
+	var once sync.Once
+	return func() { once.Do(release) }, nil
+}
diff --git a/core/pinkha_torah_operation_read.go b/core/pinkha_torah_operation_read.go
new file mode 100644
--- /dev/null
+++ b/core/pinkha_torah_operation_read.go
@@ -0,0 +1,84 @@
+package core
+
+import (
+	"context"
+	"encoding/hex"
+	"strings"
+
+	"github.com/anyproto/anytype-heart/core/block/editor/torahops"
+	"github.com/anyproto/anytype-heart/core/block/editor/torahopsobject"
+	coresb "github.com/anyproto/anytype-heart/pkg/lib/core/smartblock"
+	"github.com/anyproto/anytype-heart/pkg/lib/pinkha/torahopscontract"
+)
+
+// Target, author, private root, signing keys and authorization are not request
+// fields. The current owned account derives them from verified native history.
+type PinkhaTorahAuthorizedOperationReadRequest struct {
+	Version     uint32
+	SpaceID     string
+	OperationID string
+}
+
+func validatePinkhaTorahOperationRead(ctx context.Context, req PinkhaTorahAuthorizedOperationReadRequest) error {
+	if req.Version != torahops.AuthorizedOperationReadVersion {
+		return torahops.ErrUnsupportedVersion
+	}
+	if ctx == nil || !pinkhaTorahText(req.SpaceID, true) || len(req.OperationID) != 32 || req.OperationID != strings.ToLower(req.OperationID) {
+		return torahops.ErrInvalid
+	}
+	if _, err := hex.DecodeString(req.OperationID); err != nil {
+		return torahops.ErrInvalid
+	}
+	return ctx.Err()
+}
+
+// operationReadHost is existing-only and does not reuse host's live-target or
+// root-creation path. Candidate targets are discovered under the private tree's
+// current ACL first, then authorized together by the native object adapter.
+func (s *pinkhaTorahScope) operationReadHost(ctx context.Context, spaceID string) (torahopsobject.AuthorizedOperationStoreObject, error) {
+	if err := s.current(ctx); err != nil {
+		return nil, err
+	}
+	spc, err := s.spaces.Get(ctx, spaceID)
+	if err != nil {
+		return nil, err
+	}
+	if spc == nil || spc.Id() != spaceID || spc.CommonSpace() == nil {
+		return nil, torahopscontract.ErrPrivateRoot
+	}
+	if err = torahops.AuthorizeCurrentACL(spc.CommonSpace().Acl(), s.key, false); err != nil {
+		return nil, err
+	}
+	root, err := torahopscontract.Root(spaceID)
+	if err != nil {
+		return nil, err
+	}
+	exists, err := spc.Storage().HasTree(ctx, root.Id)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return nil, ErrPinkhaTorahHistoryUnavailable
+	}
+	// Never derive a missing root or turn missing local history into absence.
+	object, err := spc.GetObject(ctx, root.Id)
+	if err != nil {
+		return nil, err
+	}
+	host, ok := object.(torahopsobject.AuthorizedOperationStoreObject)
+	if !ok || host.Id() != root.Id || host.SpaceID() != spaceID || host.Type() != coresb.SmartBlockTypePinkhaTorahOperations {
+		return nil, torahopscontract.ErrPrivateRoot
+	}
+	if err = s.current(ctx); err != nil {
+		return nil, err
+	}
+	return host, nil
+}
+
+func (mw *Middleware) NativeTorahAuthorizedOperationRead(ctx context.Context, req PinkhaTorahAuthorizedOperationReadRequest) (torahops.AuthorizedOperationSnapshot, error) {
+	prepared, err := mw.preparePinkhaAuthorizedOperationRead(ctx, req)
+	if err != nil {
+		return torahops.AuthorizedOperationSnapshot{}, err
+	}
+	return prepared.snapshot(ctx)
+}
diff --git a/core/pinkha_torah_operation_read_test.go b/core/pinkha_torah_operation_read_test.go
