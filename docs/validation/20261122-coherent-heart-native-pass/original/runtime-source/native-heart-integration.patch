+        string spaceId = 3;
+        string authorId = 4;
+        Target target = 5;
+        bytes canonicalBytes = 6;
+        repeated Provenance provenance = 7;
+        Reachability reachability = 8;
+    }
+    message Snapshot {
+        string contract = 1;
+        string accountId = 2;
+        string spaceId = 3;
+        string operationId = 4;
+        Outcome outcome = 5;
+        bool complete = 6;
