+def parse_package_log(raw, package, expected_names):
+    """Join only this exact test's ordered Go Output fragments before JSON decode."""
+    events = []
+    measurement_output = []
+    for line in raw.splitlines():
+        event = json.loads(line)
+        assert isinstance(event, dict) and event.get('Package') == package
+        if event.get('Action') == 'output' and event.get('Test') == MEASUREMENT_METHOD:
+            assert package == UNIT_PACKAGE and isinstance(event['Output'], str)
+            measurement_output.append(event['Output'])
+        if event.get('Action') in ('run', 'pass', 'fail', 'skip'):
+            events.append({key:event[key] for key in ('Action','Package','Test','Elapsed') if key in event})
+    wanted = Counter({(package,name):1 for name in expected_names})
+    for action in ('run', 'pass'):
+        observed = Counter((event['Package'],event['Test']) for event in events if event['Action']==action and 'Test' in event)
+        assert observed == wanted, 'only the fixed package methods/subcases may run and pass'
+    assert not any(event['Action'] in ('fail','skip') for event in events)
+    assert Counter(event['Package'] for event in events if event['Action']=='pass' and 'Test' not in event)==Counter({package:1})
+    joined = ''.join(measurement_output)
+    assert len(joined.encode()) <= 65536, 'bounded same-test output reconstruction'
+    marker = 'READGUARD_CACHED_MEASUREMENT '
+    measurements = []
+    if package == UNIT_PACKAGE:
+        assert joined.endswith('\n') and joined.count(marker)==1, 'one complete original measurement line'
+        lines = [line for line in joined.splitlines() if marker in line]
+        assert len(lines)==1
+        measurements.append(json.loads(lines[0].split(marker,1)[1]))
+    else:
+        assert not measurement_output, 'fresh package cannot supply a reused measurement'
+    return events, measurements, [len(value.encode()) for value in measurement_output]
+
