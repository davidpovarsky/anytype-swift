  "findings": [
    {
      "basis": [
        "workflow-current-build",
        "workflow-cache-save",
        "workflow-unit-execution",
        "helper-context",
        "helper-products-seal-admit"
      ],
      "claim": "Current original workflow builds once with build-for-testing, seals actual generated original unit descriptor/products, then admits test-without-building within the same exact run/context."
    },
    {
      "basis": [
        "helper-context",
        "helper-receipt-equality"
      ],
      "claim": "A new run or a two-selector continuation cannot pass the unchanged original receipt gate: selectors, source, run_id, run_attempt, toolchain and tracked input context must equal the sealed receipt."
    },
    {
      "basis": [
        "workflow-artifact-retention",
        "helper-products-seal-admit"
      ],
      "claim": "The original final artifact list retains simulator-logs, build/acceptance and build/chat-motion-ui-evidence, not the current Build/Products directory or a full immutable app/test product archive. The generated descriptor and product hashes are retained evidence, not retained executable payloads."
    },
    {
      "basis": [
        "workflow-cache-restore",
        "workflow-cache-save"
      ],
      "claim": "DerivedData Build may be cached but is not guaranteed current-product retention: save is skipped on an exact key hit. The key includes AI_HLY app Swift, project, package manifests and locks, but does not hash all package Swift or AI_HLYTests Swift. An exact cache hit does not independently bind the current 4cb test binaries."
    },
    {
      "basis": [
        "root decision and existing original method inventory; no new runtime inference"
      ],
      "claim": "No qualifying exact prior runtime receipt for the two appended original AutoFollow methods was at hand; search expansion was stopped on root instruction. Source compilation/inclusion alone is not claimed as their runtime execution."
    }
  ],
