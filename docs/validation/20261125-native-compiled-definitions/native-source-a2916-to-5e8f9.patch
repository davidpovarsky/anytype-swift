+func TestCapturedBundledDefinitionFallbackRetainsCensusAndCapturedOverridePriority(t *testing.T) {
+	page := compiledControlRow("component-page", model.SmartBlockType_Page, "page", nil)
+	page.Snapshot.ObjectTypes = []string{domain.TypeKey("page").URL()}
+	page.Snapshot.RelationLinks = []*model.RelationLink{{Key: "name", Format: model.RelationFormat_shorttext}}
+	resolver, err := NewCaptured("component-space", []CapturedRow{page})
+	require.NoError(t, err)
+	captured, err := resolver.BundledDefinitions()
+	require.NoError(t, err)
+	require.Equal(t, []string{"property:name", "type:page"}, resolver.BundledDefinitionsUsed())
+	require.Len(t, captured, 2)
+	require.Equal(t, "name", captured[0].Key())
+	captured[0].raw[0] ^= 1
+	fresh, err := resolver.BundledDefinitions()
+	require.NoError(t, err)
+	require.NotEqual(t, captured[0].Protobuf(), fresh[0].Protobuf())
+
+	actual, err := bundle.GetRelation(bundle.RelationKeyName)
+	require.NoError(t, err)
+	actual.Name = "changed native descriptor"
+	require.ErrorIs(t, resolver.bundledDefinition("property", "name", actual), ErrCapturedResolver)
+	unchanged, err := resolver.BundledDefinitions()
+	require.NoError(t, err)
+	require.Equal(t, fresh[0].Receipt(), unchanged[0].Receipt())
+
+	page.Snapshot.ObjectTypes = nil
+	override := compiledControlRow("captured-name", model.SmartBlockType_STRelation, "rel-name",
+		map[domain.RelationKey]domain.Value{bundle.RelationKeyRelationKey: domain.String("name"),
+			bundle.RelationKeyRelationFormat: domain.Int64(int64(model.RelationFormat_longtext)),
+			bundle.RelationKeyName:           domain.String("captured override")})
+	resolver, err = NewCaptured("component-space", []CapturedRow{page, override})
+	require.NoError(t, err)
+	relation, err := resolver.propertyByKey("name")
+	require.NoError(t, err)
+	require.Equal(t, "captured override", relation.Name)
+	require.Equal(t, model.RelationFormat_longtext, relation.Format)
+	require.Empty(t, resolver.BundledDefinitionsUsed())
+	duplicate := override
+	duplicate.ID = "second-captured-name"
+	resolver, err = NewCaptured("component-space", []CapturedRow{page, override, duplicate})
+	require.NoError(t, err)
+	_, err = resolver.propertyByKey("name")
+	require.ErrorIs(t, err, ErrCapturedResolver)
+	require.Empty(t, resolver.BundledDefinitionsUsed(), "ambiguous captured identity must not use the compiled fallback")
+	require.NotEmpty(t, resolver.Unmapped())
+}
