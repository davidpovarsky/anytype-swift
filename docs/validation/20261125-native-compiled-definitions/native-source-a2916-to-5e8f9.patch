diff --git a/pkg/lib/anyblockjson/storeresolver/captured_bundled_definitions.go b/pkg/lib/anyblockjson/storeresolver/captured_bundled_definitions.go
new file mode 100644
index 000000000..56ba6a3ad
--- /dev/null
+++ b/pkg/lib/anyblockjson/storeresolver/captured_bundled_definitions.go
@@ -0,0 +1,271 @@
+//go:build pinkha_loaded_account_witness
+
+package storeresolver
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"sort"
+
+	"github.com/gogo/protobuf/jsonpb"
+	"github.com/gogo/protobuf/proto"
+
+	"github.com/anyproto/anytype-heart/core/domain"
+	"github.com/anyproto/anytype-heart/pkg/lib/bundle"
+	"github.com/anyproto/anytype-heart/pkg/lib/pb/model"
+)
+
+const (
+	bundledDefinitionProtoLimit  = 1 << 20
+	bundledDefinitionJSONLimit   = 4 << 20
+	bundledDefinitionsTotalLimit = 16 << 20
+	bundledDefinitionsCountLimit = 1024
+)
+
+// CapturedBundledDefinition is an immutable copy of the actual compiled native
+// definition used for one fallback. It is not a captured tree or account
+// authority. Original protobuf fields and the generated JSON view are retained.
+type CapturedBundledDefinition struct {
+	kind, key, message string
+	raw, view          []byte
+	definition         proto.Message
+}
+
+type BundledDefinitionReceipt struct {
+	Kind, Key, ProtobufMessage, ProtobufSHA256, JSONViewSHA256 string
+	ProtobufBytes, JSONViewBytes                               int
+	// Private original buffers bind the scalar receipt to actual captured
+	// native wire data. They are never serialized as public receipt fields.
+	raw, view []byte
+}
+
+func (d *CapturedBundledDefinition) Kind() string            { return d.kind }
+func (d *CapturedBundledDefinition) Key() string             { return d.key }
+func (d *CapturedBundledDefinition) ProtobufMessage() string { return d.message }
+func (d *CapturedBundledDefinition) Protobuf() []byte        { return append([]byte(nil), d.raw...) }
+func (d *CapturedBundledDefinition) JSONView() []byte        { return append([]byte(nil), d.view...) }
+func (d *CapturedBundledDefinition) Receipt() BundledDefinitionReceipt {
+	return BundledDefinitionReceipt{Kind: d.kind, Key: d.key, ProtobufMessage: d.message,
+		ProtobufSHA256: bundledDefinitionHash(d.raw), JSONViewSHA256: bundledDefinitionHash(d.view),
+		ProtobufBytes: len(d.raw), JSONViewBytes: len(d.view),
+		raw: append([]byte(nil), d.raw...), view: append([]byte(nil), d.view...)}
+}
+
+func bundledDefinitionHash(raw []byte) string {
+	digest := sha256.Sum256(raw)
+	return hex.EncodeToString(digest[:])
+}
+
+type bundledDefinitionJSONBuffer struct{ buffer bytes.Buffer }
+
+func (b *bundledDefinitionJSONBuffer) Write(p []byte) (int, error) {
+	if len(p) > bundledDefinitionJSONLimit-b.buffer.Len() {
+		return 0, ErrCapturedResolver
+	}
+	return b.buffer.Write(p)
+}
+
+func captureBundledDefinition(kind, key string, value proto.Message) (*CapturedBundledDefinition, error) {
+	if value == nil || key == "" || len(key) > 4096 {
+		return nil, ErrCapturedResolver
+	}
+	switch kind {
+	case "property":
+		v, ok := value.(*model.Relation)
+		if !ok || v == nil || v.Key != key {
+			return nil, ErrCapturedResolver
+		}
+	case "type":
+		v, ok := value.(*model.ObjectType)
+		if !ok || v == nil || v.Key != key {
+			return nil, ErrCapturedResolver
+		}
+	default:
+		return nil, ErrCapturedResolver
+	}
+	if size := proto.Size(value); size <= 0 || size > bundledDefinitionProtoLimit {
+		return nil, ErrCapturedResolver
+	}
+	detached := proto.Clone(value)
+	// The original pinned generated gogo Marshal implementation is the native
+	// protocol authority. Its Buffer deliberately rejects deterministic mode.
+	// Retain its exact wire bytes; checkpoint identity compares full decoded
+	// messages after independently verifying those original bytes and JSON.
+	raw, err := proto.Marshal(detached)
+	if err != nil {
+		return nil, errors.Join(ErrCapturedResolver, err)
+	}
+	return describeBundledDefinition(kind, key, detached, raw)
+}
+
+func describeBundledDefinition(kind, key string, detached proto.Message, raw []byte) (*CapturedBundledDefinition, error) {
+	if key == "" || len(key) > 4096 {
+		return nil, ErrCapturedResolver
+	}
+	switch kind {
+	case "property":
+		definition, ok := detached.(*model.Relation)
+		if !ok || definition == nil || definition.Key != key {
+			return nil, ErrCapturedResolver
+		}
+	case "type":
+		definition, ok := detached.(*model.ObjectType)
+		if !ok || definition == nil || definition.Key != key {
+			return nil, ErrCapturedResolver
+		}
+	default:
+		return nil, ErrCapturedResolver
+	}
+	raw = append([]byte(nil), raw...)
+	if len(raw) == 0 || len(raw) > bundledDefinitionProtoLimit {
+		return nil, ErrCapturedResolver
+	}
+	var output bundledDefinitionJSONBuffer
+	// Omit absent protobuf fields. Emitting a nil google.protobuf.Value as
+	// JSON null turns absence into an explicit NullValue on native decode.
+	// This serializer setting preserves that original presence distinction.
+	marshaler := jsonpb.Marshaler{OrigName: true, EmitDefaults: false, EnumsAsInts: true}
+	if err := marshaler.Marshal(&output, detached); err != nil {
+		return nil, errors.Join(ErrCapturedResolver, err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(output.buffer.Bytes()))
+	decoder.UseNumber()
+	var definition any
+	if err := decoder.Decode(&definition); err != nil {
+		return nil, err
+	}
+	view, err := json.Marshal(struct {
+		Contract, Kind, Key, ProtobufMessage, ProtobufSHA256 string
+		ProtobufBytes                                        int
+		Definition                                           any
+	}{Contract: "pinkha-native-bundled-definition-json-v1", Kind: kind, Key: key,
+		ProtobufMessage: proto.MessageName(detached), ProtobufSHA256: bundledDefinitionHash(raw),
+		ProtobufBytes: len(raw), Definition: definition})
+	if err != nil || len(view) > bundledDefinitionJSONLimit {
+		return nil, errors.Join(ErrCapturedResolver, err)
+	}
+	return &CapturedBundledDefinition{kind: kind, key: key, message: proto.MessageName(detached), raw: raw, view: view, definition: detached}, nil
+}
+
+func currentBundledDefinition(kind, key string) (*CapturedBundledDefinition, error) {
+	switch kind {
+	case "property":
+		value, err := bundle.GetRelation(domain.RelationKey(key))
+		if err != nil {
+			return nil, errors.Join(ErrCapturedResolver, err)
+		}
+		return captureBundledDefinition(kind, key, value)
+	case "type":
+		value, err := bundle.GetType(domain.TypeKey(key))
+		if err != nil {
+			return nil, errors.Join(ErrCapturedResolver, err)
+		}
+		return captureBundledDefinition(kind, key, value)
+	default:
+		return nil, ErrCapturedResolver
+	}
+}
+
+// This is a pure registry comparison, not an authority check. Only the completed
+// native application checkpoint may use it after a fresh account/ACL read.
+func ValidateBundledDefinitionReceipts(expected []BundledDefinitionReceipt) error {
+	if len(expected) > bundledDefinitionsCountLimit {
+		return ErrCapturedResolver
+	}
+	previous, total := "", 0
+	for _, entry := range expected {
+		identity := entry.Kind + ":" + entry.Key
+		if identity <= previous || len(entry.raw) == 0 || len(entry.raw) > bundledDefinitionProtoLimit ||
+			len(entry.view) == 0 || len(entry.view) > bundledDefinitionJSONLimit {
+			return ErrCapturedResolver
+		}
+		previous = identity
+		total += len(entry.raw) + len(entry.view)
+		if total > bundledDefinitionsTotalLimit {
+			return ErrCapturedResolver
+		}
+		var original proto.Message
+		switch entry.Kind {
+		case "property":
+			original = new(model.Relation)
+		case "type":
+			original = new(model.ObjectType)
+		default:
+			return ErrCapturedResolver
+		}
+		if err := proto.Unmarshal(entry.raw, original); err != nil {
+			return errors.Join(ErrCapturedResolver, err)
+		}
+		rebuilt, err := describeBundledDefinition(entry.Kind, entry.Key, original, entry.raw)
+		if err != nil {
+			return err
+		}
+		actual := rebuilt.Receipt()
+		if actual.Kind != entry.Kind || actual.Key != entry.Key || actual.ProtobufMessage != entry.ProtobufMessage ||
+			actual.ProtobufSHA256 != entry.ProtobufSHA256 || actual.JSONViewSHA256 != entry.JSONViewSHA256 ||
+			actual.ProtobufBytes != entry.ProtobufBytes || actual.JSONViewBytes != entry.JSONViewBytes ||
+			!bytes.Equal(rebuilt.view, entry.view) {
+			return ErrCapturedResolver
+		}
+		current, err := currentBundledDefinition(entry.Kind, entry.Key)
+		if err != nil || !proto.Equal(original, current.definition) {
+			return errors.Join(ErrCapturedResolver, err)
+		}
+	}
+	return nil
+}
+
+func (c *CapturedResolver) bundledDefinition(kind, key string, value proto.Message) error {
+	captured, err := captureBundledDefinition(kind, key, value)
+	if err != nil {
+		return err
+	}
+	identity := kind + ":" + key
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if existing := c.bundled[identity]; existing != nil {
+		if !proto.Equal(existing.definition, captured.definition) {
+			return ErrCapturedResolver
+		}
+		return nil
+	}
+	count := c.bundledBytes + len(captured.raw) + len(captured.view)
+	if len(c.bundled) >= bundledDefinitionsCountLimit || count > bundledDefinitionsTotalLimit {
+		return ErrCapturedResolver
+	}
+	c.bundled[identity] = captured
+	c.bundledBytes = count
+	return nil
+}
+
+// BundledDefinitions returns a deterministic, detached census paired exactly
+// with BundledDefinitionsUsed. A missing or changed native registry entry fails.
+func (c *CapturedResolver) BundledDefinitions() ([]*CapturedBundledDefinition, error) {
+	if c == nil {
+		return nil, ErrCapturedResolver
+	}
+	c.mu.Lock()
+	keys := make([]string, 0, len(c.bundled))
+	for key := range c.bundled {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	result := make([]*CapturedBundledDefinition, 0, len(keys))
+	receipts := make([]BundledDefinitionReceipt, 0, len(keys))
+	for _, key := range keys {
+		original := c.bundled[key]
+		copy := &CapturedBundledDefinition{kind: original.kind, key: original.key, message: original.message,
+			raw: append([]byte(nil), original.raw...), view: append([]byte(nil), original.view...),
+			definition: proto.Clone(original.definition)}
+		result = append(result, copy)
+		receipts = append(receipts, copy.Receipt())
+	}
+	c.mu.Unlock()
+	if err := ValidateBundledDefinitionReceipts(receipts); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
