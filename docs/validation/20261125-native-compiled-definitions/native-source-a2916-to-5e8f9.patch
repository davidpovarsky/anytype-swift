+func TestCapturedBundledDefinitionRetainsActualNativeDescriptorBytes(t *testing.T) {
+	for _, key := range []string{"analyticsSpaceId", "apiObjectKey", "headerRelationsLayout", "homepage",
+		"migrationObjectContext", "orderId", "relationFormatIncludeTime"} {
+		t.Run(key, func(t *testing.T) {
+			original, err := bundle.GetRelation(domain.RelationKey(key))
+			require.NoError(t, err)
+			captured, err := currentBundledDefinition("property", key)
+			require.NoError(t, err)
+			roundTrip := new(model.Relation)
+			require.NoError(t, proto.Unmarshal(captured.Protobuf(), roundTrip))
+			require.True(t, proto.Equal(original, roundTrip), "actual compiled protobuf fields changed")
+			require.Equal(t, "anytype.model.Relation", captured.ProtobufMessage())
+			require.Equal(t, "_br"+key, roundTrip.Id)
+			verifyCompiledJSONRoundTrip(t, captured, new(model.Relation), original)
+			again, err := currentBundledDefinition("property", key)
+			require.NoError(t, err)
+			require.Equal(t, captured.Receipt(), again.Receipt())
+			raw, view := captured.Protobuf(), captured.JSONView()
+			raw[0] ^= 1
+			view[0] ^= 1
+			require.NotEqual(t, raw, captured.Protobuf())
+			require.NotEqual(t, view, captured.JSONView())
+		})
+	}
+	original, err := bundle.GetType(domain.TypeKey("page"))
+	require.NoError(t, err)
+	captured, err := currentBundledDefinition("type", "page")
+	require.NoError(t, err)
+	roundTrip := new(model.ObjectType)
+	require.NoError(t, proto.Unmarshal(captured.Protobuf(), roundTrip))
+	require.True(t, proto.Equal(original, roundTrip))
+	require.Equal(t, "anytype.model.ObjectType", captured.ProtobufMessage())
+	verifyCompiledJSONRoundTrip(t, captured, new(model.ObjectType), original)
+
+	t.Run("absent-explicit-null-and-empty-default-presence", func(t *testing.T) {
+		for _, defaultValue := range []*types.Value{
+			nil,
+			{Kind: &types.Value_NullValue{NullValue: types.NullValue_NULL_VALUE}},
+			{Kind: &types.Value_StringValue{StringValue: ""}},
+		} {
+			value, err := bundle.GetRelation(bundle.RelationKeyName)
+			require.NoError(t, err)
+			value.DefaultValue = defaultValue
+			captured, err := captureBundledDefinition("property", "name", value)
+			require.NoError(t, err)
+			verifyCompiledJSONRoundTrip(t, captured, new(model.Relation), value)
+			var view struct{ Definition map[string]json.RawMessage }
+			require.NoError(t, json.Unmarshal(captured.JSONView(), &view))
+			_, present := view.Definition["defaultValue"]
+			require.Equal(t, defaultValue != nil, present, "native unset and explicit null/default must remain distinct")
+		}
+	})
+
+	t.Run("original-generated-structured-default-keeps-first-wire-and-full-values", func(t *testing.T) {
+		value, err := bundle.GetRelation(bundle.RelationKeyName)
+		require.NoError(t, err)
+		value.DefaultValue = &types.Value{Kind: &types.Value_StructValue{StructValue: &types.Struct{Fields: map[string]*types.Value{
+			"z": {Kind: &types.Value_StringValue{StringValue: "é — עברית"}},
+			"a": {Kind: &types.Value_BoolValue{BoolValue: true}},
+			"nested": {Kind: &types.Value_StructValue{StructValue: &types.Struct{Fields: map[string]*types.Value{
+				"last":  {Kind: &types.Value_NumberValue{NumberValue: 7}},
+				"first": {Kind: &types.Value_StringValue{StringValue: ""}},
+			}}}},
+		}}}}
+		page := compiledControlRow("component-page", model.SmartBlockType_Page, "page", nil)
+		resolver, err := NewCaptured("component-space", []CapturedRow{page})
+		require.NoError(t, err)
+		require.NoError(t, resolver.bundledDefinition("property", "name", value))
+		originalWire := resolver.bundled["property:name"].Protobuf()
+		for i := 0; i < 24; i++ {
+			next, err := captureBundledDefinition("property", "name", value)
+			require.NoError(t, err)
+			verifyCompiledJSONRoundTrip(t, next, new(model.Relation), value)
+			require.NoError(t, resolver.bundledDefinition("property", "name", value))
+			require.Equal(t, originalWire, resolver.bundled["property:name"].Protobuf())
+		}
+		_, err = resolver.BundledDefinitions()
+		require.ErrorIs(t, err, ErrCapturedResolver, "synthetic changed descriptor must not be admitted as the real compiled registry")
+	})
+}
+
+func verifyCompiledJSONRoundTrip(t *testing.T, captured *CapturedBundledDefinition, output, original proto.Message) {
+	t.Helper()
+	var envelope struct {
+		Contract, Kind, Key, ProtobufMessage, ProtobufSHA256 string
+		ProtobufBytes                                        int
+		Definition                                           json.RawMessage
+	}
+	require.NoError(t, json.Unmarshal(captured.JSONView(), &envelope))
+	require.Equal(t, "pinkha-native-bundled-definition-json-v1", envelope.Contract)
+	require.Equal(t, captured.Kind(), envelope.Kind)
+	require.Equal(t, captured.Key(), envelope.Key)
+	require.Equal(t, captured.ProtobufMessage(), envelope.ProtobufMessage)
+	require.Equal(t, bundledDefinitionHash(captured.Protobuf()), envelope.ProtobufSHA256)
+	require.Equal(t, len(captured.Protobuf()), envelope.ProtobufBytes)
+	require.NoError(t, jsonpb.Unmarshal(bytes.NewReader(envelope.Definition), output))
+	require.True(t, proto.Equal(original, output), "generated JSON did not preserve the actual native definition")
+}
+
+func TestCapturedBundledDefinitionReceiptsRefuseChangedOrAmbiguousIdentity(t *testing.T) {
+	original, err := currentBundledDefinition("property", "name")
+	require.NoError(t, err)
+	good := original.Receipt()
+	require.NoError(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{good}))
+	for _, modify := range []func(*BundledDefinitionReceipt){
+		func(r *BundledDefinitionReceipt) { r.Kind = "object" },
+		func(r *BundledDefinitionReceipt) { r.Key = "not-a-native-bundled-definition" },
+		func(r *BundledDefinitionReceipt) { r.ProtobufMessage = "anytype.model.ObjectType" },
+		func(r *BundledDefinitionReceipt) { r.ProtobufSHA256 = "" },
+		func(r *BundledDefinitionReceipt) { r.JSONViewSHA256 = "" },
+		func(r *BundledDefinitionReceipt) { r.ProtobufBytes++ },
+		func(r *BundledDefinitionReceipt) { r.JSONViewBytes++ },
+	} {
+		changed := good
+		modify(&changed)
+		require.ErrorIs(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{changed}), ErrCapturedResolver)
+	}
+	require.ErrorIs(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{good, good}), ErrCapturedResolver)
+	second, err := currentBundledDefinition("property", "description")
+	require.NoError(t, err)
+	require.ErrorIs(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{good, second.Receipt()}), ErrCapturedResolver)
+	require.NoError(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{second.Receipt(), good}))
+	changedWire := good
+	changedWire.raw = append([]byte(nil), good.raw...)
+	changedWire.raw[0] ^= 1
+	require.ErrorIs(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{changedWire}), ErrCapturedResolver)
+	changedView := good
+	changedView.view = append([]byte(nil), good.view...)
+	changedView.view[0] ^= 1
+	require.ErrorIs(t, ValidateBundledDefinitionReceipts([]BundledDefinitionReceipt{changedView}), ErrCapturedResolver)
+}
+
+func compiledControlRow(id string, kind model.SmartBlockType, key string, values map[domain.RelationKey]domain.Value) CapturedRow {
+	details := domain.NewDetails()
+	for field, value := range values {
+		details.Set(field, value)
+	}
+	return CapturedRow{ID: id, Type: kind, UniqueKey: key, Snapshot: &model.SmartBlockSnapshotBase{Details: details.ToProto()}}
+}
