@@ -0,0 +1,72 @@
+//go:build pinkha_loaded_account_witness && pinkha_loaded_account_witness_acceptance
+
+package application
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/anyproto/anytype-heart/pkg/lib/anyblockjson/storeresolver"
+	"github.com/stretchr/testify/require"
+)
+
+// Reads the real produced private bundle and its original protobuf/JSON members.
+// A forged descriptor receipt must still be refused after a fresh native read.
+func loadedCheckpointCompiledDefinitionControl(t *testing.T, f *loadedAccountFixture,
+	captured *LoadedAccountSpaceWitness, checkpoint *LoadedAccountSourceCheckpoint) {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(captured.PrivateBundleDirectory(), "manifest.json"))
+	require.NoError(t, err)
+	var manifest NativeSourceBundleManifest
+	require.NoError(t, json.Unmarshal(data, &manifest))
+	definitions, err := captured.resolver.BundledDefinitions()
+	require.NoError(t, err)
+	require.NotEmpty(t, definitions, "actual native fixture must exercise compiled resolver dependencies")
+	require.Len(t, manifest.BundledDefinitions, len(definitions))
+	require.Len(t, manifest.BundledDefinitionsUsed, len(definitions))
+	require.Len(t, checkpoint.bundledDefinitions, len(definitions))
+	for i, definition := range definitions {
+		member := manifest.BundledDefinitions[i]
+		identity := definition.Kind() + ":" + definition.Key()
+		require.Equal(t, identity, manifest.BundledDefinitionsUsed[i])
+		require.Equal(t, definition.Kind(), member.Kind)
+		require.Equal(t, definition.Key(), member.Key)
+		require.Equal(t, definition.ProtobufMessage(), member.ProtobufMessage)
+		require.Equal(t, definition.Receipt(), checkpoint.bundledDefinitions[i])
+		for suffix, entry := range map[string]NativeSourceMember{"pb": member.Protobuf, "json": member.JSONView} {
+			require.Equal(t, "compiled-definition-"+loadedAccountWitnessHash(identity)+"."+suffix, entry.Path)
+			path := filepath.Join(captured.PrivateBundleDirectory(), entry.Path)
+			actual, err := os.ReadFile(path)
+			require.NoError(t, err)
+			require.Equal(t, int64(len(actual)), entry.Bytes)
+			require.Equal(t, loadedFixtureHash(actual), entry.SHA256)
+			if suffix == "pb" {
+				require.Equal(t, definition.Protobuf(), actual)
+			} else {
+				require.Equal(t, definition.JSONView(), actual)
+			}
+			stat, err := os.Stat(path)
+			require.NoError(t, err)
+			require.Equal(t, os.FileMode(0400), stat.Mode().Perm())
+		}
+	}
+	changed := *checkpoint
+	changed.bundledDefinitions = append([]storeresolver.BundledDefinitionReceipt(nil), checkpoint.bundledDefinitions...)
+	changed.bundledDefinitions[0].ProtobufSHA256 = strings.Repeat("0", 64)
+	require.ErrorIs(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, &changed),
+		ErrLoadedAccountSpaceWitnessCheckpointChanged)
+	require.NoError(t, f.service.RevalidateLoadedAccountSource(f.ctx, f.token, checkpoint))
+	f.privateNote(t, "compiled-definition-checkpoint-result", map[string]any{
+		"contract":    "pinkha-real-compiled-native-definition-observation-v1",
+		"definitions": len(definitions), "memberCount": len(definitions) * 2,
+		"originalManifestSHA256":             loadedFixtureHash(data),
+		"changedDefinitionCheckpointRefused": true, "originalCheckpointStillValid": true,
+		"accountAuthorityRechecked": true, "permitsDestinationWrites": false,
+		"wholeSpaceMigrationComplete": false,
+	})
+	t.Logf("NATIVE_COMPILED_DEFINITIONS descriptors=%d members=%d original_bytes=PASS checkpoint_change_refused=PASS destination_admission=false",
+		len(definitions), len(definitions)*2)
+}
