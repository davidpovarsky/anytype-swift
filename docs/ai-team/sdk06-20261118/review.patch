+    func waitUntil(_ condition: @MainActor () -> Bool) async throws {
+        let limit = ContinuousClock.now + .seconds(1)
+        while !condition(), ContinuousClock.now < limit { try await Task.sleep(for: .milliseconds(5)) }
+    }
