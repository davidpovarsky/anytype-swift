+{
+  "repository": "https://github.com/davidpovarsky/hanlin-ai.git",
+  "revision": "e195ef50fbf741d339f4bf515869a1ee6a038fc2",
+  "packages": [
+    "Packages/HanlinAgentSDK",
+    "Packages/HanlinPlatform",
