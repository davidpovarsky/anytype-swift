+import Foundation
+import HanlinHostContracts
+
+/// The application owns journal opening, presentation revocation and explicit account erasure.
+/// Keeping journal actors across ordinary dismissals preserves late original-scope receipts and
+/// prevents competing windows from opening separate writers for the same account/Space.
+@MainActor
+final class PinkhaHanlinAccountOwner {
+    static let shared = PinkhaHanlinAccountOwner()
+
+    private struct Presentation {
+        weak var value: PinkhaHanlinChatPresentation?
+        let account: Data
+    }
+    private struct Opening {
+        let account: Data
+        let task: Task<PinkhaHanlinWriteJournal, Error>
+    }
+    private var presentations: [UUID: Presentation] = [:]
+    private var journals: [String: Opening] = [:]
+    private var closedAccounts = Set<Data>()
+    private var removingAccounts = Set<Data>()
+
+    func isAvailable(account: String) -> Bool {
+        !closedAccounts.contains(Data(account.utf8))
+    }
+
+    func register(_ presentation: PinkhaHanlinChatPresentation) throws {
+        let account = presentation.session.context.namespace.account
+        guard isAvailable(account: account) else { throw HanlinHostError.staleContext }
+        presentations = presentations.filter { $0.value.value != nil }
+        presentations[presentation.session.id] = .init(value: presentation, account: Data(account.utf8))
+    }
+
+    func unregister(_ id: UUID) { presentations[id] = nil }
+
+    func owns(_ presentation: PinkhaHanlinChatPresentation) -> Bool {
+        presentations[presentation.session.id]?.value === presentation
+    }
+
+    func journal(for namespace: HanlinConversationNamespace) async throws -> PinkhaHanlinWriteJournal {
+        guard isAvailable(account: namespace.account) else { throw HanlinHostError.staleContext }
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+        let key = PinkhaHanlinCreatePagePlan.digest(try encoder.encode(namespace))
+        let opening: Opening
+        if let existing = journals[key] {
+            opening = existing
+        } else {
+            let task = Task { try await PinkhaHanlinWriteJournal.open(namespace: namespace) }
+            opening = .init(account: Data(namespace.account.utf8), task: task)
+            journals[key] = opening
+        }
+        let journal = try await opening.task.value
+        guard isAvailable(account: namespace.account) else { throw HanlinHostError.staleContext }
+        return journal
+    }
+
+    func accountDidOpen(_ account: String) throws {
+        let key = Data(account.utf8)
+        guard !removingAccounts.contains(key) else { throw HanlinHostError.staleContext }
+        closedAccounts.remove(key)
+    }
+
+    /// A native logout/delete operation calls this BEFORE its first suspension. Ordinary logout
+    /// preserves metadata; removeData explicitly poisons every opening/loaded writer before erasure.
+    func closeAccount(_ account: String, removeData: Bool) async throws {
+        guard !account.isEmpty else { return }
+        let key = Data(account.utf8)
+        closedAccounts.insert(key)
+        let owned = presentations.values.filter { $0.account == key }.compactMap(\.value)
+        for presentation in owned { presentation.invalidate() }
+        guard removeData else { return }
+        guard removingAccounts.insert(key).inserted else { throw HanlinHostError.staleContext }
+        defer { removingAccounts.remove(key) }
+        let openings = journals.filter { $0.value.account == key }
+        // Do not cancel opening tasks: a suspended open must finish and be poisoned before unlink.
+        for (_, opening) in openings {
+            if let journal = try? await opening.task.value { await journal.revokeForDataRemoval() }
+        }
+        try await PinkhaHanlinWriteJournal.removeAccountData(account)
+        for (id, _) in openings { journals[id] = nil }
+    }
+}
diff --git a/Anytype/Sources/Pinkha/AI/PinkhaHanlinAuthService.swift b/Anytype/Sources/Pinkha/AI/PinkhaHanlinAuthService.swift
new file mode 100644
--- /dev/null
+++ b/Anytype/Sources/Pinkha/AI/PinkhaHanlinAuthService.swift
@@ -0,0 +1,70 @@
+import Foundation
+import Factory
+import Services
+import HanlinHostContracts
+
+/// Thin downstream decorator: native authentication remains the single authentication owner.
+/// The existing remove-data choice is also the sole authority to erase Hanlin host metadata.
+actor PinkhaHanlinAuthService: AuthServiceProtocol {
+    private let base: any AuthServiceProtocol
+    private let accounts = Container.shared.accountManager()
+    private var changingAccount = false
+
+    init(base: any AuthServiceProtocol) { self.base = base }
+
+    func createWallet() async throws -> String {
+        try beginAccountChange(); defer { changingAccount = false }
+        return try await base.createWallet()
+    }
+    func walletRecovery(mnemonic: String) async throws {
+        try beginAccountChange(); defer { changingAccount = false }
+        try await base.walletRecovery(mnemonic: mnemonic)
+    }
+    func accountRecover() async throws {
+        try beginAccountChange(); defer { changingAccount = false }
+        try await base.accountRecover()
+    }
+    func mnemonicByEntropy(_ entropy: String) async throws -> String { try await base.mnemonicByEntropy(entropy) }
+
+    func createAccount(name: String, iconOption: Int, imagePath: String) async throws -> AccountData {
+        try beginAccountChange(); defer { changingAccount = false }
+        try await PinkhaHanlinAccountOwner.shared.closeAccount(accounts.account.id, removeData: false)
+        let account = try await base.createAccount(name: name, iconOption: iconOption, imagePath: imagePath)
+        try await PinkhaHanlinAccountOwner.shared.accountDidOpen(account.id)
+        return account
+    }
+
+    func selectAccount(id: String, preferredSpaceId: String) async throws -> AccountData {
+        try beginAccountChange(); defer { changingAccount = false }
+        try await PinkhaHanlinAccountOwner.shared.closeAccount(accounts.account.id, removeData: false)
+        let account = try await base.selectAccount(id: id, preferredSpaceId: preferredSpaceId)
+        try await PinkhaHanlinAccountOwner.shared.accountDidOpen(account.id)
+        return account
+    }
+
+    func logout(removeData: Bool) async throws {
+        try beginAccountChange(); defer { changingAccount = false }
+        try await PinkhaHanlinAccountOwner.shared.closeAccount(accounts.account.id, removeData: removeData)
+        try await base.logout(removeData: removeData)
+    }
+
+    func deleteAccount() async throws -> AccountStatus {
+        try beginAccountChange(); defer { changingAccount = false }
+        try await PinkhaHanlinAccountOwner.shared.closeAccount(accounts.account.id, removeData: false)
+        return try await base.deleteAccount()
+    }
+
+    func restoreAccount() async throws -> AccountStatus {
+        try beginAccountChange(); defer { changingAccount = false }
+        let status = try await base.restoreAccount()
+        try await PinkhaHanlinAccountOwner.shared.accountDidOpen(accounts.account.id)
+        return status
+    }
+
+    private func beginAccountChange() throws {
+        // Actor reentrancy must not select another account while removal awaits journal flushing,
+        // then let the original logout act on that newly selected account.
+        guard !changingAccount else { throw HanlinHostError.staleContext }
+        changingAccount = true
+    }
+}
diff --git a/Anytype/Sources/Pinkha/AI/PinkhaHanlinChatPresentation.swift b/Anytype/Sources/Pinkha/AI/PinkhaHanlinChatPresentation.swift
new file mode 100644
--- /dev/null
+++ b/Anytype/Sources/Pinkha/AI/PinkhaHanlinChatPresentation.swift
@@ -0,0 +1,188 @@
+import Foundation
+import Observation
+import UIKit
+import HanlinAgentCore
+import HanlinChatCore
+import HanlinHostContracts
+import HanlinPersistenceAdapters
+
+/// Application lifetime and UI state around ONE canonical Hanlin session/engine.
+/// The SDK owns model execution; Anytype owns source authority, native prompts and write receipts.
+@MainActor
+@Observable
+final class PinkhaHanlinChatPresentation {
+    let session: HanlinHostSession
+    var draft = ""
+    private(set) var messages: [HanlinChatMessage] = []
+    private(set) var receiptMessages: [String] = []
+    private(set) var isStreaming = false
+    private(set) var isConfigured = false
+    private(set) var readAllowed = false
+    private(set) var errorMessage: String?
+
+    @ObservationIgnored private let host: PinkhaHanlinReadWriteHost
+    @ObservationIgnored private weak var controller: PinkhaHanlinChatController?
+    @ObservationIgnored private weak var scene: UIWindowScene?
+    @ObservationIgnored private var agent: HanlinAgentSession?
+    @ObservationIgnored private var modelReference: HanlinModelReference?
+    @ObservationIgnored private var running: Task<Void, Never>?
+    @ObservationIgnored private var closed = false
+    @ObservationIgnored private var receiptIDs = Set<UUID>()
+
+    var canSend: Bool {
+        isConfigured && !closed && !isStreaming && !draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+            && draft.utf8.count <= 32_768 && messages.count < 256
+    }
+    var hasSource: Bool { session.context.objectReference != nil }
+
+    init(presenter: UIViewController, routeOwner: SpaceHubCoordinatorViewModel,
+         conversationID: UUID, locale: Locale) throws {
+        let host = try PinkhaHanlinReadWriteHost.make(presenter: presenter, routeOwner: routeOwner,
+            conversationID: conversationID, locale: locale)
+        self.host = host
+        self.session = host.session
+        self.scene = presenter.viewIfLoaded?.window?.windowScene
+        try PinkhaHanlinAccountOwner.shared.register(self)
+        host.observeInvalidation { [weak self] in self?.invalidate() }
+    }
+
+    func didMount(_ controller: PinkhaHanlinChatController) {
+        guard !closed else { controller.dismiss(animated: false); return }
+        self.controller = controller
+        do { try host.install(self, controller: controller) }
+        catch { invalidate() }
+    }
+
+    func validateInstallation(for session: HanlinHostSession) throws {
+        guard !closed, self.session == session,
+              PinkhaHanlinAccountOwner.shared.owns(self),
+              PinkhaHanlinAccountOwner.shared.isAvailable(account: session.context.namespace.account),
+              let scene, let controller, controller.presentation === self,
+              controller.presentingViewController != nil,
+              controller.viewIfLoaded?.window?.windowScene === scene,
+              scene.activationState == .foregroundActive,
+              !controller.isBeingDismissed else { throw HanlinHostError.staleContext }
+    }
+
+    /// Credentials are supplied explicitly by the user and live only inside this presentation's
+    /// canonical engine. No Keychain/AppGroup discovery, request logging or cross-app credential read.
+    func configure(endpoint: String, model: String, credential: String) {
+        guard !closed, !isConfigured, !isStreaming else { return }
+        do {
+            try validateInstallation(for: session)
+            let configuration = try PinkhaHanlinModelConfiguration.make(endpoint: endpoint, model: model, credential: credential)
+            let engine = try HanlinAISDKAgentEngine(configuration: configuration,
+                fetch: HanlinAISDKProviderFactory.makeFetch(sessionConfiguration: .ephemeral))
+            let agent = HanlinAgentSession(identity: session, host: host, engine: engine,
+                store: HanlinInMemoryConversationStore())
+            agent.onHostResult = { [weak self] event in self?.receive(event) }
+            agent.onSessionInvalidated = { [weak self] _ in self?.invalidate() }
+            self.agent = agent
+            modelReference = .init(provider: HanlinAISDKProviderFactory.descriptor(for: configuration).kind.rawValue,
+                                   modelID: configuration.baseModelID)
+            isConfigured = true
+            errorMessage = nil
+        } catch {
+            errorMessage = PinkhaHanlinStrings.configurationFailed
+        }
+    }
+
+    func requestContextReadConsent() {
+        guard !closed, !isStreaming, hasSource else { return }
+        Task { @MainActor [weak self] in
+            guard let self else { return }
+            do {
+                try await self.host.requestContextReadConsent()
+                try self.validateInstallation(for: self.session)
+                self.readAllowed = true
+                self.errorMessage = nil
+            } catch {
+                if !self.closed { self.errorMessage = PinkhaHanlinStrings.contextNotShared }
+            }
+        }
+    }
+
+    func send() {
+        guard canSend, let agent, let modelReference else { return }
+        let prompt = draft
+        draft = ""
+        messages.append(.user(prompt))
+        let history = messages.map { HanlinAISDKMessage(role: $0.role == "user" ? .user : .assistant, text: $0.content) }
+        let answerID = UUID()
+        messages.append(.init(id: answerID, role: "assistant", content: ""))
+        isStreaming = true
+        errorMessage = nil
+        running = Task { @MainActor [weak self] in
+            guard let self else { return }
+            defer { self.isStreaming = false; self.running = nil }
+            do {
+                try self.validateInstallation(for: self.session)
+                let stream = try await agent.stream(messages: history, modelReference: modelReference,
+                    maxSteps: 8, presentationReference: "anytype.hanlin@1")
+                for try await event in stream {
+                    try Task.checkCancellation()
+                    try self.validateInstallation(for: event.session)
+                    if case .textDelta(let delta) = event.event,
+                       let index = self.messages.firstIndex(where: { $0.id == answerID }) {
+                        guard self.messages[index].content.utf8.count + delta.utf8.count <= 262_144 else {
+                            throw HanlinHostError.outputLimitExceeded
+                        }
+                        self.messages[index].content += delta
+                    }
+                }
+            } catch {
+                // Provider errors may contain request details. Never log or expose them verbatim.
+                if !self.closed { self.errorMessage = PinkhaHanlinStrings.requestFailed }
+            }
+        }
+    }
+
+    private func receive(_ event: HanlinHostResultEvent) {
+        guard !closed, event.call.session == session, receiptIDs.count < 256,
+              receiptIDs.insert(event.resultID).inserted else { return }
+        // The presentation owns only safe outcome labels; payloads never enter a receipt log.
+        switch event.result.effectState {
+        case .confirmedCommitted: receiptMessages.append(PinkhaHanlinStrings.pageCreated)
+        case .uncertain: receiptMessages.append(PinkhaHanlinStrings.uncertain)
+        case .notDispatched: receiptMessages.append(PinkhaHanlinStrings.notDispatched)
+        case .confirmedNoEffect:
+            if case .completed = event.result.result.outcome { receiptMessages.append(PinkhaHanlinStrings.contextRead) }
+            else { receiptMessages.append(PinkhaHanlinStrings.requestFailed) }
+        }
+    }
+
+    func invalidate() {
+        guard !closed else { return }
+        closed = true
+        host.revokePresentation()
+        running?.cancel()
+        let agent = agent
+        self.agent = nil
+        modelReference = nil
+        draft = ""
+        messages.removeAll()
+        receiptMessages.removeAll()
+        receiptIDs.removeAll()
+        isConfigured = false
+        PinkhaHanlinAccountOwner.shared.unregister(session.id)
+        controller?.dismiss(animated: true)
+        Task { [host] in
+            await agent?.invalidate()
+            await host.invalidate()
+        }
+    }
+}
+
+enum PinkhaHanlinModelConfiguration {
+    static func make(endpoint: String, model: String, credential: String) throws -> HanlinChatModelConfiguration {
+        let model = model.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let url = URL(string: endpoint.trimmingCharacters(in: .whitespacesAndNewlines)),
+              url.scheme == "https", let hostname = url.host, !hostname.isEmpty,
+              url.user == nil, url.password == nil, url.query == nil, url.fragment == nil,
+              !model.isEmpty, model.utf8.count <= 128, !credential.isEmpty, credential.utf8.count <= 4_096 else {
+            throw HanlinHostError.invalidArguments
+        }
+        return .init(modelID: model, company: "OPENAI", apiType: "OpenAI", endpoint: url,
+                     apiKey: credential, supportsToolUse: true)
+    }
+}
diff --git a/Anytype/Sources/Pinkha/AI/PinkhaHanlinChatView.swift b/Anytype/Sources/Pinkha/AI/PinkhaHanlinChatView.swift
