@@ -0,0 +1,398 @@
+//go:build pinkha_cutover_acceptance
+
+package core
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
