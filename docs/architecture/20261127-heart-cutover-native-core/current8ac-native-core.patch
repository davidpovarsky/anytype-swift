+func newCutoverSignedFixture(t *testing.T) *cutoverSignedFixture {
+	t.Helper()
+	config, _, _ := makeNativeConfigs(t)
+	root := os.Getenv("PINKHA_CUTOVER_NATIVE_WORK")
+	require.True(t, filepath.IsAbs(root))
