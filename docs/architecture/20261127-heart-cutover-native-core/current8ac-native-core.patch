+func (f *cutoverSignedFixture) importOperation(t *testing.T, key crypto.PrivKey, index int) (string, Operation) {
+	t.Helper()
+	fact := f.plan.Facts[index]
+	factID, err := fact.ID(f.plan.SpaceID, f.plan.ObjectID)
