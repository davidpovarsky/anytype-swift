+		Kind: Add, Target: Target{ObjectID: f.plan.ObjectID, BlockID: fact.BlockID}, Source: Source{ProviderID: fact.ProviderID, CanonicalRef: fact.CanonicalRef},
+		Payload: bytes.Clone(fact.Payload)}
