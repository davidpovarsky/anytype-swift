+	require.NoError(t, err)
+	account, err := service.AccountCreate(ctx, &pb.RpcAccountCreateRequest{
+		Name: "Actual cutover registry", StorePath: dir,
+		DisableLocalNetworkSync: true, NetworkMode: pb.RpcAccount_LocalOnly,
