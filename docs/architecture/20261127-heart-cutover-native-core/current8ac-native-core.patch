+func TestSourceCoverageExactNumbersDuplicateKeysAndUnicodeRefuse(t *testing.T) {
+	for _, name := range []string{"rounded-number", "escaped-duplicate", "unpaired-surrogate", "date-precision"} {
+		t.Run(name, func(t *testing.T) {
