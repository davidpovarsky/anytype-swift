+func (f *cutoverSignedFixture) close() error {
+	var err error
+	if f.tree != nil {
+		err = f.tree.Close()
+		f.tree = nil
+	}
+	if f.native != nil {
+		err = errors.Join(err, f.native.Close())
+		f.native = nil
+	}
+	return err
+}
