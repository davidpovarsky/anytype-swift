          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצירה"
          }
        }
      }
    },
    "pinkha.hanlin.stopping": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוצר…"
          }
        }
      }
    },
    "pinkha.hanlin.returnToSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to document"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרה למסמך"
          }
        }
      }
    },
    "pinkha.hanlin.returnFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to return to this document."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לחזור למסמך הזה."
          }
        }
      }
    },
    "pinkha.hanlin.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Hanlin…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל את Hanlin…"
          }
        }
      }
    },
    "pinkha.hanlin.shareContext": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to this document or selection"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה למסמך או לבחירה הנוכחיים"
          }
        }
      }
    },
    "pinkha.hanlin.contextShared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current source access allowed"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למקור הנוכחי אושרה"
          }
        }
      }
    },
    "pinkha.hanlin.contextNotShared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the current source was not allowed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למקור הנוכחי לא אושרה."
          }
        }
      }
    },
    "pinkha.hanlin.connectionDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an OpenAI-compatible model to Hanlin for this conversation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבר מודל תואם OpenAI ל־Hanlin עבור שיחה זו."
          }
        }
      }
    },
    "pinkha.hanlin.endpoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPS API endpoint"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת API מסוג HTTPS"
          }
        }
      }
    },
    "pinkha.hanlin.model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model identifier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזהה המודל"
          }
        }
      }
    },
    "pinkha.hanlin.credential": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח API"
          }
        }
      }
    },
    "pinkha.hanlin.connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיבור"
          }
        }
      }
    },
    "pinkha.hanlin.sessionPrivacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key and conversation stay in this session only. Closing clears them. Page creation always needs confirmation. Minimal operation receipts are retained to prevent uncertain writes from being repeated; Remove data at logout also removes these receipts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח והשיחה נשארים בזיכרון בשיחה זו בלבד ונמחקים בסגירה. יצירת דף מחייבת אישור בכל פעם. נשמרות קבלות פעולה מצומצמות כדי למנוע חזרה על כתיבה שתוצאתה אינה ידועה; האפשרות למחיקת נתונים ביציאה מוחקת גם אותן."
          }
        }
      }
    },
    "pinkha.hanlin.configurationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the HTTPS endpoint, model identifier and API key."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את כתובת ה־HTTPS, מזהה המודל ומפתח ה־API."
          }
        }
      }
    },
    "pinkha.hanlin.requestFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanlin could not complete this request. Any pending page creation must be checked before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanlin לא הצליח להשלים את הבקשה. יש לבדוק כל יצירת דף שתלויה ועומדת לפני ניסיון נוסף."
          }
        }
      }
    },
    "pinkha.hanlin.pageCreated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Page creation confirmed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת הדף אושרה."
          }
        }
      }
    },
    "pinkha.hanlin.uncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page may have been created. Check the original Space before retrying."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהדף נוצר. בדוק במרחב המקורי לפני ניסיון נוסף."
          }
        }
      }
    },
    "pinkha.hanlin.notDispatched": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested operation was not dispatched."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה המבוקשת לא נשלחה לביצוע."
          }
        }
      }
    },
    "pinkha.hanlin.contextRead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The authorized source text was read."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט המקור שאושר נקרא."
          }
        }
      }
    },
    "pinkha.hanlin.openFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a Space or document and try Hanlin again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח מרחב או מסמך ונסה שוב לפתוח את Hanlin."
          }
        }
      }
    },
    "pinkha.hanlin.continuePrompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue the previous response."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך את התשובה הקודמת."
          }
        }
      }
    },
    "pinkha.hanlin.thinking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking"
          }
        },
        "he": {
          "stringUnit": {
