{
  "sourceLanguage": "en",
  "strings": {
    "Cancel": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול"
          }
        }
      }
    },
    "Choose a shorter, complete selection without existing links.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו קטע טקסט קצר ושלם ללא קישורים קיימים."
          }
        }
      }
    },
    "Copy anchor link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy anchor link"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העתקת קישור לעוגן"
          }
        }
      }
    },
    "Create an anchor for this text?": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ליצור עוגן לטקסט הזה?"
          }
        }
      }
    },
    "Create text anchor": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת עוגן טקסט"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיום"
          }
        }
      }
    },
    "Go to anchored text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to anchored text"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעבר לטקסט המעוגן"
          }
        }
      }
    },
    "Link to anchored text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link to anchored text"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישור לטקסט המעוגן"
          }
        }
      }
    },
    "Sources for anchored text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources for anchored text"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקורות לטקסט המעוגן"
          }
        }
      }
    },
    "Text anchor": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוגן טקסט"
          }
        }
      }
    },
    "Text anchors are unavailable right now.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוגני טקסט אינם זמינים כרגע."
          }
        }
      }
    },
    "The page changed. Wait for it to save, then select the text again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדף השתנה. המתינו לסיום השמירה ובחרו שוב את הטקסט."
          }
        }
      }
    },
    "The result could not be confirmed. Reopen this page before trying again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את התוצאה. פתחו מחדש את הדף לפני ניסיון נוסף."
          }
        }
      }
    },
    "The selected text now has an anchor.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוסף עוגן לטקסט שנבחר."
          }
        }
      }
    },
    "The source was saved, but its text anchor could not be confirmed. Reopen this page before linking again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source was saved, but its text anchor could not be confirmed. Reopen this page before linking again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקור נשמר, אך לא ניתן היה לאמת את עוגן הטקסט שלו. יש לפתוח את הדף מחדש לפני קישור נוסף."
          }
        }
      }
    },
    "This adds an anchor to the selected text.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוסיפה עוגן לטקסט שנבחר."
          }
        }
      }
    },
    "This page is no longer available for editing.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדף הזה אינו זמין עוד לעריכה."
          }
        }
      }
    },
    "This selection already contains a link or an anchor.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטע שנבחר כבר מכיל קישור או עוגן."
          }
        }
      }
    },
    "This text anchor appears more than once. Choose the intended text again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text anchor appears more than once. Choose the intended text again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוגן הטקסט הזה מופיע יותר מפעם אחת. בחר שוב את הטקסט הרצוי."
          }
        }
      }
    },
    "This text anchor belongs to a different page or space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text anchor belongs to a different page or space."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוגן הטקסט הזה שייך לדף או למרחב אחר."
          }
        }
      }
    },
    "This text anchor no longer exists in the current page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text anchor no longer exists in the current page."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוגן הטקסט הזה כבר אינו קיים בדף הנוכחי."
          }
        }
      }
    }
  },
  "version": "1.0"
}
