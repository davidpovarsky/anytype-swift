        }
      }
    },
    "The import is saved. Open Imported documents to review the result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import is saved. Open Imported documents to review the result."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייבוא נשמר. פתח את ״מסמכים שיובאו״ כדי לבדוק את התוצאה."
          }
        }
      }
    },
    "The import did not finish. Saved progress and the original source are retained. Review Imported documents before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import did not finish. Saved progress and the original source are retained. Review Imported documents before trying again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייבוא לא הסתיים. ההתקדמות שנשמרה והמקור המקורי נשמרים. בדוק את ״מסמכים שיובאו״ לפני ניסיון נוסף."
          }
        }
      }
    },
    "Open the destination Space in Any to review its imported documents.": {
      "extractionState": "manual",
      "localizations": {
