    "Open a Space in your Heart account before reviewing a migration source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a Space in your Heart account before reviewing a migration source."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח מרחב בחשבון Heart לפני בדיקת המקור להעברה."
          }
        }
      }
    },
    "Open in this window": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in this window"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחה בחלון הזה"
          }
        }
      }
    },
    "Reading the source data and its original permissions. No destination data is being written.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading the source data and its original permissions. No destination data is being written."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקראים נתוני המקור וההרשאות המקוריות. לא מתבצעת כתיבה ליעד."
          }
        }
      }
    },
    "Review Heart source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
