    "The engine switch could not be completed. Wait for the operation to finish and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine switch could not be completed. Wait for the operation to finish and try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשלים את המעבר כעת. המתן לסיום הפעולה ונסה שוב."
          }
        }
      }
    },
    "The source review cannot be opened right now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source review cannot be opened right now."
