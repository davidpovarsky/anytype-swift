          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקת מקור Heart"
          }
        }
      }
    },
    "Review migration source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review migration source"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקירת מקור להעברה"
          }
        }
      }
    },
    "The engine switch could not be completed. Wait for the operation to finish and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine switch could not be completed. Wait for the operation to finish and try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשלים את המעבר כעת. המתן לסיום הפעולה ונסה שוב."
          }
        }
      }
    },
    "The source review cannot be opened right now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source review cannot be opened right now."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפתוח את בדיקת המקור כעת."
          }
        }
      }
    },
    "The source review could not be completed. Your original data is retained. Close the review and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source review could not be completed. Your original data is retained. Close the review and try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשלים את בדיקת המקור. הנתונים המקוריים נשמרו. סגור את הבדיקה ונסה שוב."
          }
        }
      }
    },
    "The source session could not be closed. It is retained for another close attempt; the engine switch did not complete.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source session could not be closed. It is retained for another close attempt; the engine switch did not complete."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לסגור כעת את הרשאת המקור. הפעולה נשמרה לסגירה חוזרת; לא בוצעה העברה למנוע האחר."
          }
        }
      }
    },
    "This Space is open in another window": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Space is open in another window"
          }
